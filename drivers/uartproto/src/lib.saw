//! The /dev/uart0 protocol.
//!
//! A UART driver that serves its device over a pipe needs a wire: one op byte,
//! then payload. Nothing here is kernel surface. A device protocol belongs to
//! the device's driver and its clients; the kernel supplies the connection, the
//! message and the one-shot reply pair, equally to every protocol.
//!
//! This is a package, not a comment, because three programs compile against
//! these numbers (the driver, the client child, and each root launcher acting
//! as a client) and they must agree. A copy per program can drift, and drift
//! shows up as a wrong byte rather than a compile error. It lives in
//! `drivers/`, not in `sosrt`, which is arch-free and role-free code every
//! image links.
//!
//! # The wire
//!
//! ```text
//! byte 0      the op                    (UartOp, a raw-backed enum)
//! bytes 1..   the payload               (`len - 1` of them)
//! ```
//!
//! The four ops, each with its own kernel-level shape:
//!
//!   - `Read`  - a call. The reply carries the next input byte, and the
//!               reply's own `len` says how many. If no input is pending the
//!               driver holds the obligation and answers when its IRQ delivers
//!               one; a fused `send` parks meanwhile, so a blocking read is
//!               composed entirely out of shipped parts.
//!   - `Write` - a tell: post, drop the claim, never look back. The driver
//!               writes the payload out its window.
//!   - `Sync`  - a call with an empty reply. A connection's ring is FIFO, so an
//!               answered `Sync` proves every message posted before it has been
//!               served; that is how a client that only tells learns when its
//!               writes reached the device.
//!   - `Mark`  - a call with an empty reply, and pure instrumentation: it tells
//!               the driver to take a trap reading, so the serve loop's cost
//!               can be measured over a window the case controls. It carries no
//!               authority and reads no device.
//!
//! # Cancellation is not an op
//!
//! There is no `Cancel` byte. A client that gives up a `Read` drops its claim
//! (§2.1), and the driver learns of it through the request's abandoned level,
//! which it already watches because it holds the obligation. A cancel on the
//! wire would make the driver correlate two messages and would race the reply
//! it is trying to cancel; the reference count does not.

import sos.{PipeMsg, PIPE_BODY_BYTES}
import sosrt.{ascii_byte}

/// The op byte. Raw-backed because it crosses a wire: the values are ABI
/// between the driver and its clients, so each is stated explicitly and a
/// reorder cannot renumber them.
public enum UartOp: UInt8 {
    case Read = 1,
    case Write = 2,
    case Sync = 3,
    case Mark = 4,
}

extension UartOp {
    /// What a transcript should call this op.
    public func describe(&self) -> String {
        match self {
            case Read -> "read",
            case Write -> "write",
            case Sync -> "sync",
            case Mark -> "mark",
        }
    }
}

/// Where the op byte sits, and where the payload starts.
public static OP_BYTE: Int = 0
public static PAYLOAD_BYTE: Int = 1

/// The most payload one message can carry: the body minus the op byte.
public static MAX_PAYLOAD: Int = PIPE_BODY_BYTES - 1

static_assert(MAX_PAYLOAD > 0, "a message must have room for an op and a byte")

/// The request buffer. The body every send takes is a
/// `&[UInt8; PIPE_BODY_BYTES]`; a builder fills the array through a `&var`
/// struct field, and `&buf.bytes` is what goes to the wire.
public struct UartBody {
    public bytes: [UInt8; PIPE_BODY_BYTES],
}

extension UartBody {
    /// A zeroed body.
    public static func empty() -> UartBody {
        UartBody(bytes: [0; PIPE_BODY_BYTES])
    }

    /// An op and nothing else. Answers the message's `len`.
    public func bare(&var self, op: UartOp) -> UInt {
        self.bytes[OP_BYTE] = op as UInt8
        1
    }

    /// An op and one payload byte. Answers the message's `len`.
    public func one(&var self, op: UartOp, b: UInt8) -> UInt {
        self.bytes[OP_BYTE] = op as UInt8
        self.bytes[PAYLOAD_BYTE] = b
        2
    }

    /// A reply carrying one byte. Answers the reply's `len`.
    ///
    /// A reply has no op byte: it answers exactly one request, so the
    /// request's op says how to read it, and the reply's own `len` is the
    /// length prefix §2.1 gives every message.
    public func answer(&var self, b: UInt8) -> UInt {
        self.bytes[0] = b
        1
    }

    /// A reply carrying nothing. Answers `0`, which §2.1 allows and which
    /// reads no buffer: the acknowledgement `Sync` and `Mark` want.
    public func nothing(&self) -> UInt { 0 }

    /// An op and a line of ASCII. Answers the message's `len`.
    ///
    /// A scalar that is not ASCII becomes `?` (`ascii_byte`'s rule, shared with
    /// the kernel console), so a line written through a driver's window reads
    /// the same as one written through a System op. Text longer than
    /// `MAX_PAYLOAD` is cut, not wrapped: a silently split message would be two
    /// requests where the caller wrote one.
    public func text(&var self, op: UartOp, s: String) -> UInt {
        self.bytes[OP_BYTE] = op as UInt8
        var n: Int = 0
        for scalar in s.scalars() {
            if n < MAX_PAYLOAD {
                self.bytes[PAYLOAD_BYTE + n] = ascii_byte(scalar)
                n = n + 1
            }
        }
        (n + 1) as UInt
    }
}

/// The op a received message names, or `None` for a byte that names no op.
///
/// The Optional is a real domain value: a request arrives from a process the
/// driver does not trust, so "this byte is not one of my ops" is data at a
/// protocol boundary, never a trap. This is a decode, not an operation that can
/// fail, so there is no error channel.
///
/// A message with no bytes (`len == 0`, which §2.1 allows) names no op either,
/// and the same `None` says so.
public func op_of(msg: &PipeMsg) -> UartOp? {
    if msg.len == 0 { return None }
    UartOp.from(raw: msg.bytes[OP_BYTE])
}

/// How many payload bytes a received message carries.
public func payload_len(msg: &PipeMsg) -> UInt {
    if msg.len == 0 { return 0 }
    msg.len - 1
}

/// Payload byte `i` of a received message. Out of range answers zero rather
/// than panicking: the sender chose the length and the receiver is a server,
/// which a client's arithmetic must not be able to end.
public func payload_byte(msg: &PipeMsg, i: Int) -> UInt8 {
    if i < 0 || (i as UInt) >= payload_len(&msg) { return 0 }
    msg.bytes[PAYLOAD_BYTE + i]
}
