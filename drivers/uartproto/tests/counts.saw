// `count_up`, the saturating count a driver keeps of what a client's traffic
// drives: it goes up by what it is given and stays at the type's top rather
// than wrapping or trapping.

import uartproto.{count_up}

func main() {
    assert(count_up(0, 1) == 1, "a count goes up by one")
    assert(count_up(5, 7) == 12, "and by more")
    assert(count_up(0xFFFF_FFFE, 1) == 0xFFFF_FFFF, "to its top")
    assert(count_up(0xFFFF_FFFF, 1) == 0xFFFF_FFFF, "and stays there")
    assert(count_up(0xFFFF_FFF0, 0x20) == 0xFFFF_FFFF, "a step past the top stops at it")
    assert(count_up(0xFFFF_FFFF, 0) == 0xFFFF_FFFF, "nothing added changes nothing")
}
