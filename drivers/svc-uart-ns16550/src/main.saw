// The UART as a service: the NS16550A board's console driver, interrupt-driven
// both ways.
//
// This is a driver with a server face. The device half is a plain MMIO driver:
// a register block, two interrupt enables, an `IoMemory` that arrives by
// `give` and is mapped into this process by this process. The bytes are
// answered to whoever asked, over a pipe, through a protocol its clients
// compile against (`uartproto`).
//
// Every decision a UART driver makes is `uartcore`'s (`Core`): the receive
// ring and its one gap mark, the transmit ring, the held `Write` and the held
// `Sync`s, the held `Read`s, and when the driver may take another message.
// This file is the rest: the 16550's registers as `uartcore`'s device
// (`Ns16550`), the claim, the Waiter, and the obligations a reply is made
// through. The PL011 driver beside this one is the same program over another
// datasheet.
//
// # The device
//
// The 16550 says of its transmitter only whether the holding register (or,
// with the FIFOs on, the whole transmit FIFO) is empty (LSR bit 5), so the
// device is one byte deep to the core: a byte is stored only when that bit is
// set, and a `Sync` is answered only when it reads set with every byte before
// the `Sync` stored. That is every byte out of the holding register, not off
// the wire: the last one may still be in the shift register (LSR bit 6, which
// the driver does not read). The transmit cause is IER bit 1, raised while the
// holding register is empty and cleared by a store to it; the driver reads
// IIR nowhere, which would clear it too. Receive is IER bit 0, raised while a
// byte waits and lowered by reading it, and IER bit 2 raises the line while
// LSR holds an error (bits 1 to 4). Those bits clear when LSR is read, so
// every read of LSR keeps what it saw until the core clears it. The driver
// writes nothing else: the line control register and the FIFO control
// register stay as the kernel left them.
//
// # The loop
//
// The outlet is attached by the borrowing attach (`Waiter.add`), as a level,
// and messages are taken with `take`: intake must be able to pause, and the
// consuming attach owns the outlet, whose removal would close the connection.
// Each wake is one of:
//
//   Readable     a message is staged: it is taken and decided by the core.
//                One answered at once is answered by `reply_wait`, which
//                parks for the next wake in the same trap; one the core holds
//                is kept under the core's name for it (a held `Read` watched
//                for abandonment with a one-shot attach), and the driver waits.
//   Interrupt    `Core.service` makes every register access (the receive
//                drain, the transmit top-up), then the line is acknowledged,
//                then each answer that is ready is made: a held `Write` that
//                is now wholly queued, each `Sync` whose bytes have left the
//                holding register, a held `Read` for each byte or mark.
//   Abandoned    a client dropped its claim on a `Read` this driver holds: the
//                obligation is discarded and the loop goes on, so one dead
//                read cannot wedge the driver (`uart-cancel` checks this).
//   PeerGone     every inlet is gone and the ring is dry, so no request can
//                ever arrive again and the loop ends.
//
// While a `Write` is held, or `MAX_SYNCS` are, the core takes no message: the
// outlet's attachment is removed, so the connection's own ring fills and its
// writers park, and every message is answered in the order it was posted. It
// is attached again when intake opens. Nothing spins: a store is made only
// when the device says it has room, and otherwise the driver is parked in
// `wait`.
//
// A reply that does not land is not an error. A `Write` told rather than
// called has no claim behind it; a `Read` whose client is gone has its byte
// put back at the front (`Core.undeliver`), so the next reader gets it.
//
// # The console
//
// The driver claims the console once the line and the outlet are attached and
// the receiver is listening, and releases it when it has served its last
// client and every byte it queued has left the holding register; while it
// holds the claim the
// kernel writes nothing to the console but a stop's lines, so nothing
// interleaves with what it writes. A driver that dies holding the claim has it
// ended by its teardown, and the kernel prints its end itself. Its own lines
// go through the debug print after the release.
//
// # The threads
//
// The main thread starts at `Normal`. It maps the window, makes the Waiter,
// attaches the line and the outlet, lets the device listen, claims the
// console, starts the serving thread at `Rt0` and joins it; then it releases
// the console and prints the report. The serving thread does everything else:
// one thread owns the one Interrupt, and the device has one line for both
// directions. Its process asks for the full band map (`bands = "full"`), so
// `Rt0` is level 4, above every band a simple-map client runs at: a client's
// post readies the driver above the poster, and only root's console watchdog
// runs above it. A launcher that sets no map leaves the simple one, where
// `Rt0` is `High`'s level.
//
// It is written with `main`: `sosmain`'s start-up adopts its System, derives
// its Process and drains its boot set, from which `main` takes the window, the
// server end and the line by tag.
//
// Nothing is printed until the console is released. The report's trap count
// covers a measured window, and a line inside it would make the number depend
// on its own prose.

import sos.{BootSet, IoMemory, Interrupt, Waiter, WaitResult, WaitPayload, Priority,
            PipeOutlet, PipeRequest, AttachMode, OutletLevel, ReplyWaitError,
            PipeMsg, SosStatus, PIPE_BODY_BYTES, PIPE_MSG_HANDLES}
import uartproto.{BODY_BYTES, Frame, UartBody, UartOp, count_up}
import uartcore.{Answered, Config, Core, Input, Served, TxConfig, UartDevice,
                 EV_BREAK, EV_FRAME, EV_OVERRUN, EV_PARITY, EV_RX, EV_TX,
                 KIND_READ, KIND_SYNC, KIND_WRITE, MAX_HELD_READS, MAX_SYNCS}
import uartconfig
import sosmain

static_assert(BODY_BYTES == PIPE_BODY_BYTES, "the wire's body is the kernel's")

// The configuration is held to its ranges here, so a build input out of range
// is a build that fails, not a driver that does.
static_assert(uartconfig.TX_RING_BYTES >= 1, "the transmit ring holds a byte")
static_assert(uartconfig.RX_RING_BYTES >= 1, "the receive ring holds a byte")
static_assert(uartconfig.MAX_HELD_READS >= 1 && uartconfig.MAX_HELD_READS <= MAX_HELD_READS,
              "the held Reads are 1 to uartcore's MAX_HELD_READS")
static_assert(uartconfig.MAX_SYNCS >= 1 && uartconfig.MAX_SYNCS <= MAX_SYNCS,
              "the held Syncs are 1 to uartcore's MAX_SYNCS")
static_assert(uartconfig.PANIC_AFTER >= 0, "PANIC_AFTER is a count, 0 for never")

// =============================================================================
// The board
// =============================================================================

/// The console UART's register page: the window this driver is handed. SOS does
/// not translate (spec §5.5), so a mapped window is where the hardware is,
/// whoever handed it over.
static UART_BASE: UInt = 0x1000_0000

// =============================================================================
// The NS16550A, through the granted window
// =============================================================================

/// The register block. Registers are byte-spaced; declaration order is the
/// layout, so each field sits at its hardware offset.
struct UartRegs {
    thr: UInt8,             // +0  transmit holding / receive buffer
    ier: UInt8,             // +1  interrupt enable
    iir: UInt8,             // +2  interrupt id / FIFO control
    lcr: UInt8,             // +3  line control
    mcr: UInt8,             // +4  modem control
    lsr: ReadOnly<UInt8>,   // +5  line status
    msr: ReadOnly<UInt8>,   // +6  modem status
    scr: UInt8,             // +7  scratch
}

static_assert(sizeof<UartRegs>() == 8,
              "the 16550 register block is eight byte-wide registers")

/// IER bit 0: interrupt while the receiver holds a byte. IER bit 1: interrupt
/// while the transmit holding register is empty. IER bit 2: interrupt while
/// LSR holds an error (bits 1 to 4), until LSR is read.
static IER_RX_READY: UInt8 = 0x01
static IER_TX_EMPTY: UInt8 = 0x02
static IER_LINE_STATUS: UInt8 = 0x04

/// LSR bit 0: a byte is waiting. Bits 1 to 4: an overrun, a parity error, a
/// framing error, a break; each clears when LSR is read. Bit 5: the
/// transmitter will take a byte.
static LSR_DATA_READY: UInt8 = 0x01
static LSR_OVERRUN: UInt8 = 0x02
static LSR_PARITY: UInt8 = 0x04
static LSR_FRAME: UInt8 = 0x08
static LSR_BREAK: UInt8 = 0x10
static LSR_ERRORS: UInt8 = 0x1E
static LSR_TX_EMPTY: UInt8 = 0x20

/// The device as `uartcore` sees it. A safe type (unsafety is not transitive):
/// only the methods reaching through `regs` carry the `unsafe` effect.
struct Ns16550 {
    regs: UnsafeMemory<UartRegs, Device>,
    /// What IER holds: this driver is its only writer.
    ier: UInt8,
    /// The LSR error bits read and not yet cleared by the core.
    errors: UInt8,
}

extension Ns16550 {
    init(at: UInt) unsafe -> Ns16550 {
        Ns16550(regs: UnsafeMemory<UartRegs, Device>(at), ier: 0, errors: 0)
    }

    /// LSR, keeping the error bits a read clears.
    func lsr(&var self) unsafe -> UInt8 {
        let v = self.regs.lsr.read()
        self.errors = self.errors | (v & LSR_ERRORS)
        v
    }

    func set_ier(&var self, v: UInt8) unsafe {
        self.ier = v
        self.regs.ier.write(v)
    }

    /// Let the device raise its line when a byte arrives or the receiver
    /// sees an error.
    func listen(&var self) {
        self.set_ier(IER_RX_READY | IER_LINE_STATUS)
    }

    /// Raise nothing: the driver will not serve.
    func quiet(&var self) {
        self.set_ier(0)
    }

    func take_byte(&var self) unsafe -> UInt8 {
        self.regs.thr.read()
    }

    func put_byte(&var self, b: UInt8) unsafe {
        self.regs.thr.write(b)
    }
}

extension Ns16550: UartDevice {
    func rx_count(&var self) -> Int {
        if (self.lsr() & LSR_DATA_READY) != 0 { 1 } else { 0 }
    }

    /// Reading the receive buffer also lowers the receive cause once it is
    /// empty.
    func rx_pop(&var self) -> UInt8 {
        self.take_byte()
    }

    /// The holding register is empty, or it holds a byte: the device says no
    /// more.
    func tx_count(&var self) -> Int {
        if (self.lsr() & LSR_TX_EMPTY) != 0 { 0 } else { 1 }
    }

    func tx_capacity(&var self) -> Int { 1 }

    func tx_push(&var self, b: UInt8) {
        self.put_byte(b)
    }

    /// The receive cause is a byte waiting, the transmit cause the holding
    /// register empty while IER enables it, and the errors what LSR reads
    /// have kept, while IER enables them.
    func events(&var self) -> UInt32 {
        let lsr = self.lsr()
        var ev: UInt32 = 0
        if (lsr & LSR_DATA_READY) != 0 { ev = ev | EV_RX }
        if (self.ier & IER_TX_EMPTY) != 0 && (lsr & LSR_TX_EMPTY) != 0 {
            ev = ev | EV_TX
        }
        if (self.ier & IER_LINE_STATUS) == 0 { return ev }
        if (self.errors & LSR_OVERRUN) != 0 { ev = ev | EV_OVERRUN }
        if (self.errors & LSR_PARITY) != 0 { ev = ev | EV_PARITY }
        if (self.errors & LSR_FRAME) != 0 { ev = ev | EV_FRAME }
        if (self.errors & LSR_BREAK) != 0 { ev = ev | EV_BREAK }
        ev
    }

    /// The errors are this driver's own latch. The receive cause lowers as the
    /// buffer is read and the transmit cause as the holding register is
    /// stored to, so neither is cleared here.
    func clear_events(&var self, bits: UInt32) {
        var keep = self.errors
        if (bits & EV_OVERRUN) != 0 { keep = keep & (0xFF ^ LSR_OVERRUN) }
        if (bits & EV_PARITY) != 0 { keep = keep & (0xFF ^ LSR_PARITY) }
        if (bits & EV_FRAME) != 0 { keep = keep & (0xFF ^ LSR_FRAME) }
        if (bits & EV_BREAK) != 0 { keep = keep & (0xFF ^ LSR_BREAK) }
        self.errors = keep
    }

    /// Enabling the transmit cause with the holding register already empty
    /// raises it at once.
    func tx_interrupt(&var self, on: Bool) {
        if on {
            self.set_ier(self.ier | IER_TX_EMPTY)
        } else {
            self.set_ier(self.ier & (0xFF ^ IER_TX_EMPTY))
        }
    }

    /// The cause has one level, the holding register empty, which is the only
    /// one a one-byte device is asked for.
    func set_tx_threshold(&var self, level: Int) { }
}

// =============================================================================
// The service's own state
// =============================================================================

/// The rings' sizes, the core's two parameters.
static TX_RING: Int = uartconfig.TX_RING_BYTES
static RX_RING: Int = uartconfig.RX_RING_BYTES

/// The tuning `uartconfig` gives. The transmit level is one byte and a fill
/// is one byte, the device's depth.
func core_config() -> Config {
    Config(tx: TxConfig(tx_empty: 1, fill_cap: 1, max_syncs: uartconfig.MAX_SYNCS),
           held_reads: uartconfig.MAX_HELD_READS)
}

/// The serving thread's stack, in words. It holds the core, whose rings are
/// `uartconfig`'s sizes, and the message and reply bodies.
static SERVE_STACK_WORDS: Int = (2048 + (uartconfig.TX_RING_BYTES +
                                         uartconfig.RX_RING_BYTES) / 4)
unsafe static var SERVE_STACK: [UInt; SERVE_STACK_WORDS] = [0; SERVE_STACK_WORDS]

/// The tags its declaration gives its records (`process.toml`).
static TAG_WINDOW: UInt = 22
static TAG_OUTLET: UInt = 23
static TAG_LINE: UInt = 24

/// The Waiter's keys. The held band is a base plus the slot, so an abandoned
/// delivery says which held `Read` it is about without a second table.
static KEY_OUTLET: UInt = 11
static KEY_IRQ: UInt = 12
static KEY_HELD: UInt = 100

/// A status this driver can never legitimately produce, so meeting it in the
/// error channel means an assertion in this file failed rather than a call did.
static BUG: SosStatus = SosStatus.BadImage

static EXIT_OK: Int = 0
static EXIT_FAILED: Int = 1
/// The console was claimed by another process when this one asked.
static EXIT_NOT_CLAIMED: Int = 2

/// The obligations the driver holds: the `Read`s, the `Write`, the `Sync`s,
/// each under the slot the core named.
struct Held {
    reads: [PipeRequest?; MAX_HELD_READS],
    write: PipeRequest?,
    syncs: [PipeRequest?; MAX_SYNCS],
}

extension Held: NoCopy {}

extension Held {
    static func empty() -> Held {
        Held(reads: [None, None, None, None], write: None,
             syncs: [None, None, None, None])
    }

    /// Keeps `request` under the core's name for it.
    func put(&var self, kind: Int, slot: Int, request: PipeRequest) {
        if kind == KIND_READ {
            self.reads[slot] = move request
        } else if kind == KIND_WRITE {
            self.write = move request
        } else {
            self.syncs[slot] = move request
        }
    }

    /// The obligation the core named, taken out.
    func take(&var self, kind: Int, slot: Int) -> PipeRequest? {
        if kind == KIND_READ {
            return self.reads[slot].take()
        }
        if kind == KIND_WRITE {
            return self.write.take()
        }
        if kind == KIND_SYNC {
            return self.syncs[slot].take()
        }
        None
    }
}

/// The measured window: open from the first `Mark` to the loop's end, and what
/// the driver did inside it, each kind of act counted so the window's traps
/// can be accounted for one by one (`Report.law_holds`).
///
/// The counts are `UInt64`s, as the kernel's trap count is, and no run comes
/// near their top: a client's traffic cannot overflow them, and the law sums
/// them without wrapping.
struct Window {
    marked: Bool,
    syscalls: UInt64,
    /// Messages answered at their take whose reply landed, and whose did not.
    answered: UInt64,
    discarded: UInt64,
    /// Messages the core held at their take.
    held: UInt64,
    /// Interrupts, and the answers made after them, landed or not.
    interrupts: UInt64,
    later: UInt64,
    /// Attachments made or removed: a held `Read`'s watch, the outlet's pause
    /// and resume.
    attaches: UInt64,
    /// Held `Read`s whose client gave up.
    abandons: UInt64,
    /// Handles released: those a message carried, and a given-up `Read`'s
    /// obligation.
    releases: UInt64,
}

extension Window {
    static func closed() -> Window {
        Window(marked: false, syscalls: 0, answered: 0, discarded: 0, held: 0,
               interrupts: 0, later: 0, attaches: 0, abandons: 0, releases: 0)
    }
}

/// What one serving run answers with.
struct Report {
    served: UInt32,
    abandoned: UInt32,
    dropped: UInt32,
    returned: UInt32,
    queued: UInt64,
    sent: UInt64,
    writes_held: UInt32,
    window: Window,
    window_traps: UInt64,
}

extension Report {
    static func empty() -> Report {
        Report(served: 0, abandoned: 0, dropped: 0, returned: 0, queued: 0,
               sent: 0, writes_held: 0, window: Window.closed(), window_traps: 0)
    }

    /// Whether the window's traps are exactly the acts it counted. Every act is
    /// one trap: a take, a reply (fused with the next wait when it is made at
    /// the take), a wait, an acknowledgement, an attach. So an answered
    /// message costs two (its take and its `reply_wait`), a discarded one
    /// three (the `reply_wait` returns without parking and the driver waits
    /// afresh), a held one two (its take and the wait after it), an interrupt
    /// two (its acknowledgement and the wait after it), and an answer made
    /// after an interrupt, an attach, an abandonment and a handle released
    /// one each. The `Mark`
    /// that opens the window is counted answered, and its take is outside the
    /// window while the closing `stats()` read, charged at trap entry before
    /// it answers, is inside: the two cancel.
    func law_holds(&self) -> Bool {
        let w = self.window
        let want = (2 * w.answered + 3 * w.discarded + 2 * w.held
                    + 2 * w.interrupts + w.later + w.attaches + w.abandons
                    + w.releases)
        self.window_traps == want
    }
}

/// The handles `msg` carries, each released when it is dropped.
func carried_handles(msg: &PipeMsg) -> Int {
    var n = 0
    var i = 0
    while i < PIPE_MSG_HANDLES {
        if msg.handles[i].is_some() { n = n + 1 }
        i = i + 1
    }
    n
}

/// What a wake is, decided by borrowing the record: look through the place,
/// and open the record only to spend it.
static WAKE_READABLE: Int = 0
static WAKE_GONE: Int = 1
static WAKE_IRQ: Int = 2
static WAKE_ABANDONED: Int = 3
static WAKE_OTHER: Int = 4

func wake_of(r: &WaitResult) -> Int {
    match r.what {
        case Readable(state) -> if state == OutletLevel.PeerGone { WAKE_GONE } else { WAKE_READABLE },
        case Interrupt(_) -> WAKE_IRQ,
        case Abandoned -> WAKE_ABANDONED,
        case _ -> WAKE_OTHER,
    }
}

/// The serving loop's state: the core, the obligations it names, the reply
/// body, and the counts.
struct Server {
    core: Core<TX_RING, RX_RING>,
    held: Held,
    body: UartBody,
    /// Whether the outlet is attached to the Waiter.
    attached: Bool,
    /// Messages taken, `Read`s given up, bytes put back: each held at the
    /// type's top (`count_up`), since a client's traffic drives them.
    served: UInt32,
    abandoned: UInt32,
    returned: UInt32,
    window: Window,
}

extension Server: NoCopy {}

extension Server {
    static func new() -> Server {
        Server(core: Core<TX_RING, RX_RING>.new(core_config()), held: Held.empty(),
               body: UartBody.empty(), attached: true, served: 0, abandoned: 0,
               returned: 0, window: Window.closed())
    }

    /// A reply that did not land: what a `Read` took goes back at the front.
    func undeliver(&var self, a: &Answered) {
        match a.input {
            case Byte(_) -> { self.returned = count_up(self.returned, 1) },
            case _ -> {},
        }
        self.core.undeliver(&a)
    }

    /// Answers `request` with the reply in the body and waits for the next
    /// wake, in one trap when the reply lands. A reply that does not land has
    /// discharged the obligation all the same, and the driver waits afresh:
    /// one client cannot end the driver.
    func answer_wait(&var self, request: PipeRequest, a: &Answered,
                     waiter: &Waiter) -> Result<WaitResult, SosStatus> {
        var r = move request
        let next = try (move r).reply_wait(body: &self.body.bytes, len: a.len,
                                           waiter: &waiter) catch {
            match error {
                case Reply(_) -> {
                    self.undeliver(&a)
                    if self.window.marked {
                        self.window.discarded = self.window.discarded + 1
                    }
                    return waiter.wait()
                },
                case Wait(s) -> { return s },
            }
        }
        if self.window.marked {
            self.window.answered = self.window.answered + 1
        }
        return move next
    }

    /// Takes the staged message, has the core decide it, and answers it or
    /// keeps it. Answers the next wake.
    func take_one(&var self, dev: &var Ns16550, waiter: &Waiter,
                  outlet: &PipeOutlet) -> Result<WaitResult, SosStatus> {
        let taken = try outlet.take()
        let (msg, request) = move taken
        // The bytes are copied out and the message dropped, so whatever
        // handles it carried are released before anything else is done.
        let frame = Frame(len: msg.len, bytes: msg.bytes)
        let carried = carried_handles(&msg)
        let _ = move msg
        self.served = count_up(self.served, 1)
        if self.window.marked {
            self.window.releases = self.window.releases + (carried as UInt64)
        }
        // The window opens at the first `Mark`, before its answer: the opening
        // read is charged at its own trap entry, so it counts nothing before
        // itself.
        if not self.window.marked {
            if let op = frame.request() {
                if op == UartOp.Mark {
                    let now = try sosmain.context().process().stats()
                    self.window.marked = true
                    self.window.syscalls = now.syscalls
                }
            }
        }
        match self.core.request(&var dev, &frame, &var self.body) {
            case Now(a) -> {
                self.panic_if_due()
                return self.answer_wait(move request, &a, &waiter)
            },
            case Held(kind, slot) -> {
                var obligation = move request
                if kind == KIND_READ {
                    // Watched for abandonment, so a client that gives up frees
                    // its slot.
                    try waiter.add(request: &obligation,
                                   key: KEY_HELD + (slot as UInt),
                                   mode: AttachMode.OneShot)
                    self.count_attach()
                }
                self.held.put(kind, slot, move obligation)
                if self.window.marked {
                    self.window.held = self.window.held + 1
                }
                try self.settle_outlet(&waiter, &outlet)
                self.panic_if_due()
                return waiter.wait()
            },
        }
    }

    /// The test-only end: a driver built with `uartconfig.PANIC_AFTER` dies
    /// once it has served that many messages, holding the claim, with what
    /// the last of them queued still going out.
    func panic_if_due(&self) {
        let after = uartconfig.PANIC_AFTER
        if after != 0 && self.served >= (after as UInt32) {
            panic("the driver was built to die after {} messages", after)
        }
    }

    func count_attach(&var self) {
        if self.window.marked {
            self.window.attaches = self.window.attaches + 1
        }
    }

    /// The interrupt: every register access, the acknowledgement, then every
    /// answer that is ready. Answers the next wake.
    func interrupt(&var self, dev: &var Ns16550, irq: &Interrupt, waiter: &Waiter,
                   outlet: &PipeOutlet) -> Result<WaitResult, SosStatus> {
        if self.window.marked {
            self.window.interrupts = self.window.interrupts + 1
        }
        // Every device read happens before the ack (spec §9's release rule).
        // After the ack the line is live again, so a register access moved
        // below it would race the next assertion.
        self.core.service(&var dev)
        try irq.ack()
        try self.deliver()
        try self.settle_outlet(&waiter, &outlet)
        return waiter.wait()
    }

    /// Makes every answer the core has ready, in the order it gives them. A
    /// `Read` whose reply does not land has its input put back before the
    /// core is used again.
    func deliver(&var self) -> Result<Void, SosStatus> {
        while let a = self.core.next_answer(&var self.body) {
            guard let request = self.held.take(a.kind, a.slot) else { return BUG }
            if self.window.marked {
                self.window.later = self.window.later + 1
            }
            var r = move request
            try (move r).reply(body: &self.body.bytes, len: a.len) catch {
                self.undeliver(&a)
            }
        }
        return
    }

    /// Attaches the outlet while the core may take, and removes it while it
    /// may not, so a staged message wakes the driver only when it would take
    /// one.
    func settle_outlet(&var self, waiter: &Waiter,
                       outlet: &PipeOutlet) -> Result<Void, SosStatus> {
        let want = self.core.intake_open()
        if want && not self.attached {
            try waiter.add(outlet: &outlet, key: KEY_OUTLET)
            self.attached = true
            self.count_attach()
        } else if not want && self.attached {
            try waiter.remove(KEY_OUTLET)
            self.attached = false
            self.count_attach()
        }
        return
    }

    /// A client gave up the `Read` held under `key`.
    func abandon(&var self, key: UInt) {
        if key >= KEY_HELD && key < KEY_HELD + (MAX_HELD_READS as UInt) {
            let slot = (key - KEY_HELD) as Int
            let _ = self.held.reads[slot].take()
            self.core.abandon(slot)
            self.abandoned = count_up(self.abandoned, 1)
            if self.window.marked {
                self.window.abandons = self.window.abandons + 1
                self.window.releases = self.window.releases + 1
            }
        }
    }
}

// =============================================================================
// The serve loop
// =============================================================================

func main() -> Int {
    var set = sosmain.take_boot_set()
    // A record is a record: whether the kernel or a launcher queued it is not
    // something the receiver can tell or needs to.
    guard let window = take_window(&var set) else {
        print("SOS uartsvc drv: no IoMemory under tag {}\n", TAG_WINDOW)
        return EXIT_FAILED
    }
    // The server end arrives the same way the window does, a capability under
    // a launcher's tag, and this driver can no more name its clients than it
    // could name its device's previous owner.
    guard let outlet = take_outlet(&var set) else {
        print("SOS uartsvc drv: no PipeOutlet under tag {}\n", TAG_OUTLET)
        return EXIT_FAILED
    }
    // The line arrives the same way, an Interrupt its launcher bound and gave
    // under a tag. The object is waitable, and this handle is its one name.
    guard let irq = take_line(&var set) else {
        print("SOS uartsvc drv: no Interrupt under tag {}\n", TAG_LINE)
        return EXIT_FAILED
    }

    let done = try run(move window, move outlet, move irq) catch {
        if error == SosStatus.Claimed {
            print("SOS uartsvc drv: the console is claimed by another process\n")
            return EXIT_NOT_CLAIMED
        }
        print("SOS uartsvc drv: failed: {}\n", error)
        return EXIT_FAILED
    }

    // Every line below is after the release, and outside the measured window,
    // which the closing `stats()` inside `serve` closed.
    print("SOS uartsvc drv: served={} abandoned={} dropped={}\n",
          done.served, done.abandoned, done.dropped)
    print("SOS uartsvc drv: bytes put back={}\n", done.returned)
    print("SOS uartsvc drv: queued={} sent={} writes held={}\n",
          done.queued, done.sent, done.writes_held)
    if done.sent == done.queued && done.writes_held >= 1 {
        print("SOS uartsvc drv: every write that did not fit was held, every byte sent\n")
    }
    let w = done.window
    // The acts a client's script decides, then the interrupts, whose number
    // is the device's, and the traps they all came to.
    print("SOS uartsvc drv: after the mark answered={} discarded={} held={} later={} attaches={} abandons={} releases={}\n",
          w.answered, w.discarded, w.held, w.later, w.attaches, w.abandons,
          w.releases)
    print("SOS uartsvc drv: after the mark interrupts={} traps={}\n",
          w.interrupts, done.window_traps)
    if w.marked && done.law_holds() {
        print("SOS uartsvc drv: every trap after the mark accounted for: two per answered message, three per discarded, two per held and per interrupt, one per other act\n")
    }
    EXIT_OK
}

/// The device's window, under `TAG_WINDOW`.
func take_window(set: &var BootSet) -> IoMemory? {
    guard var record = set.take(TAG_WINDOW) else { return None }
    record.take_iomemory()
}

/// The connection's server end, under `TAG_OUTLET`.
func take_outlet(set: &var BootSet) -> PipeOutlet? {
    guard var record = set.take(TAG_OUTLET) else { return None }
    record.take_outlet()
}

/// The device's interrupt line, under `TAG_LINE`.
func take_line(set: &var BootSet) -> Interrupt? {
    guard var record = set.take(TAG_LINE) else { return None }
    record.take_interrupt()
}

/// What the main thread hands the serving thread, by its address: the device,
/// the Waiter the line and the outlet are attached to, the outlet and the
/// line. It lives in `run`'s frame, which outlives the thread, since `run`
/// joins it before it returns; and the main thread touches none of it until
/// then.
struct Shared {
    dev: Ns16550,
    waiter: Waiter,
    outlet: PipeOutlet,
    irq: Interrupt,
    report: Report,
    /// Why the serving thread stopped, when it failed.
    failed: SosStatus?,
}

extension Shared: NoCopy {}

/// The serving thread: `at` is `run`'s `Shared`.
func serving(at: UInt) unsafe sync -> UInt {
    let s = at as UnsafePointer<Shared>
    let done = try serve(&var s[0]) catch {
        s[0].failed = error
        return 1
    }
    s[0].report = done
    0
}

/// Maps the device, wires the Waiter, claims the console, and serves on the
/// serving thread until every client is gone and every byte has left the
/// holding register; the console is released before this returns.
func run(window: IoMemory, outlet: PipeOutlet,
         irq: Interrupt) unsafe -> Result<Report, SosStatus> {
    let _mapping = try sosmain.context().process().map(iomemory: &window)
    let waiter = try sosmain.context().process().waiter_create()
    var shared = Shared(dev: Ns16550(at: UART_BASE), waiter: move waiter,
                        outlet: move outlet, irq: move irq,
                        report: Report.empty(), failed: None)
    try shared.waiter.add(&shared.irq, KEY_IRQ)
    try shared.waiter.add(outlet: &shared.outlet, key: KEY_OUTLET)
    shared.dev.listen()

    // The claim comes once the line is attached and the receiver listens, so
    // every byte this driver stores comes after the kernel's last line. A
    // driver that does not serve leaves the device raising nothing.
    try sosmain.context().system().console_claim() catch {
        shared.dev.quiet()
        return error
    }

    let top = ((&var SERVE_STACK) as UnsafePointer<UInt>) as UInt +
              (SERVE_STACK_WORDS as UInt) * (sizeof<UInt>() as UInt)
    let entry: FuncPointer<(UInt) sync -> UInt> = serving
    let at = ((&var shared) as UnsafePointer<Shared>) as UInt
    let thread = try sosmain.context().process().thread_create(run: entry, arg: at,
                                                              stack_top: top) catch {
        let _ = sosmain.context().system().console_release()
        return error
    }
    try thread.start(band: Priority.Rt0) catch {
        let _ = sosmain.context().system().console_release()
        return error
    }
    let _ = try thread.join() catch {
        let _ = sosmain.context().system().console_release()
        return error
    }
    try sosmain.context().system().console_release()
    if let why = shared.failed {
        return why
    }
    let _ = move window
    return shared.report
}

/// The serving loop, until every inlet is gone and every byte has left the
/// holding register.
func serve(sh: &var Shared) -> Result<Report, SosStatus> {
    var s = Server.new()
    var wake = try sh.waiter.wait()
    while {
        let kind = wake_of(&wake)
        if kind == WAKE_GONE {
            break
        }
        if kind == WAKE_READABLE {
            wake = try s.take_one(&var sh.dev, &sh.waiter, &sh.outlet)
        } else if kind == WAKE_IRQ {
            wake = try s.interrupt(&var sh.dev, &sh.irq, &sh.waiter, &sh.outlet)
        } else if kind == WAKE_ABANDONED {
            s.abandon(wake.key)
            wake = try sh.waiter.wait()
        } else {
            return BUG
        }
    }

    let after = try sosmain.context().process().stats()
    var traps: UInt64 = 0
    if s.window.marked && after.syscalls >= s.window.syscalls {
        traps = after.syscalls - s.window.syscalls
    }
    let window = s.window
    // Every client is gone: what is queued, a held `Write`'s remainder
    // included, goes out before the driver returns. The outlet's level is
    // terminal, so it is detached first, or every wait would report it. A
    // `Sync` still held is answered once its bytes have left, whether an
    // interrupt said so or the drain's own read of the device did, so its
    // answer is made after each of the drain's calls, on any wake.
    if s.attached {
        try sh.waiter.remove(KEY_OUTLET)
        s.attached = false
    }
    var drained = s.core.begin_drain(&var sh.dev)
    try s.deliver()
    while not drained {
        let next = try sh.waiter.wait()
        let what = wake_of(&next)
        let _ = move next
        if what == WAKE_IRQ {
            s.core.service(&var sh.dev)
            try sh.irq.ack()
        }
        drained = s.core.drained(&var sh.dev)
        try s.deliver()
    }
    let tx = s.core.tx.totals
    return Report(served: s.served, abandoned: s.abandoned,
                  dropped: s.core.rx.totals.dropped, returned: s.returned,
                  queued: tx.queued, sent: tx.pushed, writes_held: tx.writes_held,
                  window: window, window_traps: traps)
}
