//! `svc-uart-ns16550`'s shipping configuration, and every key the driver
//! reads: a file another build names for `uartconfig` gives each of these.

/// The transmit ring, in bytes: what a `Write` is copied into before the
/// transmitter takes it.
public static TX_RING_BYTES: Int = 1024

/// The receive ring, in bytes: what the interrupt drains the receiver into
/// until a `Read` takes it.
public static RX_RING_BYTES: Int = 256

/// The `Read`s held at once, 1 to 4; past it a `Read` is answered `Busy`.
public static MAX_HELD_READS: Int = 4

/// The `Sync`s held at once, 1 to 4; with that many held the driver takes no
/// message.
public static MAX_SYNCS: Int = 4

/// For tests only: the messages the driver takes before it panics, with the
/// transmitter busy; 0 is never.
public static PANIC_AFTER: Int = 0
