// Receive loss: a byte the ring has no room for is dropped and counted, the
// mark that reports it sits where the first drop was (after the last byte
// accepted before it), and nothing is unaccounted for: every byte the device
// delivered is either handed to a reader, still buffered, or counted lost.

import uartcore.bench.{Bench}

func check(ok: Bool, what: String) {
    if not ok {
        print("failed: {what}")
    }
    assert(ok, what)
}

/// One `Read`, answered at once or not.
func read<const R: Int>(b: &var Bench<64, R>) -> Int {
    let id = b.post_read()
    b.pump()
    id
}

func loss_counted() {
    // Eight fit; the other four are dropped, and the mark is after the eighth.
    var b = Bench<64, 8>.standard()
    b.uart.feed_run(0, 12)
    b.interrupt()
    check(b.core.rx.buffered() == 8, "the ring holds what fits")
    check(b.core.rx.has_mark(), "the first drop made a mark")
    let t = b.core.rx.totals
    check(t.received == 12, "every byte taken from the device is counted")
    check(t.lost == 4 && t.dropped == 4, "every byte dropped is counted")

    var i = 0
    while i < 8 {
        let id = read(&var b)
        check(b.answered(id), "a buffered byte answers a Read at once")
        check(b.reply_len(id) == 2 && b.reply_byte(id, 0) == 0, "an Ok and a byte")
        check(b.reply_byte(id, 1) == i as UInt8, "the bytes come in order")
        i = i + 1
    }
    let m = read(&var b)
    check(b.answered(m), "then the mark answers the next Read")
    check(b.reply_len(m) == 17, "a mark is a status and four counters")
    check(b.reply_byte(m, 0) == 4, "the mark is Lost")
    check(b.reply_word(m, 1) == 4, "four bytes lost")
    check(b.reply_word(m, 5) == 0 && b.reply_word(m, 9) == 0
              && b.reply_word(m, 13) == 0, "no errors")
    check(not b.core.rx.has_mark(), "the mark is spent once reported")
    let u = b.core.rx.totals
    check(u.received == u.delivered + (b.core.rx.buffered() as UInt32) + u.dropped,
          "received = delivered + buffered + lost")

    // The next bytes arrive after the mark, whole.
    b.uart.feed_run(100, 3)
    b.interrupt()
    var k = 0
    while k < 3 {
        let id = read(&var b)
        check(b.reply_byte(id, 0) == 0 && b.reply_byte(id, 1) == (100 + k) as UInt8,
              "the bytes after the mark are delivered in order")
        k = k + 1
    }
}

/// The mark is where the first drop was, not after bytes that arrived later,
/// even when the drop and the later bytes come in different interrupts.
func mark_position() {
    var b = Bench<64, 4>.standard()
    b.uart.feed_run(0, 2)
    b.interrupt()
    b.uart.feed_run(2, 5)
    b.interrupt()
    check(b.core.rx.buffered() == 4, "four kept")
    let r = read(&var b)
    let r1 = read(&var b)
    let r2 = read(&var b)
    let r3 = read(&var b)
    check(b.reply_byte(r, 1) == 0 && b.reply_byte(r1, 1) == 1
              && b.reply_byte(r2, 1) == 2 && b.reply_byte(r3, 1) == 3,
          "the bytes before the loss come first")
    let m = read(&var b)
    check(b.reply_byte(m, 0) == 4 && b.reply_word(m, 1) == 3,
          "then the mark, with the three bytes dropped")
}

func main() {
    loss_counted()
    mark_position()
}
