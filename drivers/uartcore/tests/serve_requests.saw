// The request decisions: the status each request is answered, in the
// protocol's order (BadOp first), what Pending counts, and the counters a
// Stats carries, field by field.

import uartcore.{Config, MAX_HELD_READS, MAX_SYNCS, TxConfig}
import uartcore.bench.{Bench}
import uartcore.fake.{FakeUart}
import uartproto.{BODY_BYTES, Frame}

func check(ok: Bool, what: String) {
    if not ok {
        print("failed: {what}")
    }
    assert(ok, what)
}

/// A request of `len` bytes whose op byte is `op`.
func message(len: UInt, op: UInt8) -> Frame {
    var f = Frame(len: len, bytes: [0; BODY_BYTES])
    f.bytes[0] = op
    f
}

/// Whether `id` was answered with the status byte alone.
func status_only<const T: Int, const R: Int>(b: &Bench<T, R>, id: Int,
                                              status: UInt8) -> Bool {
    b.answered(id) && b.reply_len(id) == 1 && b.reply_byte(id, 0) == status
}

func refusals() {
    var b = Bench<64, 16>.standard()
    let none = b.post(message(0, 1))
    let zero = b.post(message(1, 0))
    let big = b.post(message(1, 255))
    let seven = b.post(message(1, 7))
    let read_payload = b.post(message(2, 1))
    let sync_payload = b.post(message(2, 3))
    let mark_payload = b.post(message(2, 4))
    let pending_payload = b.post(message(2, 5))
    let stats_payload = b.post(message(2, 6))
    b.pump()
    check(status_only(&b, none, 1), "no bytes is BadOp")
    check(status_only(&b, zero, 1), "op 0 is BadOp")
    check(status_only(&b, big, 1), "op 255 is BadOp")
    check(status_only(&b, seven, 1), "an op that is none is BadOp")
    check(status_only(&b, read_payload, 1), "a Read with a payload is BadOp")
    check(status_only(&b, sync_payload, 1), "a Sync with a payload is BadOp")
    check(status_only(&b, mark_payload, 1), "a Mark with a payload is BadOp")
    check(status_only(&b, pending_payload, 1),
          "a Pending with a payload is BadOp")
    check(status_only(&b, stats_payload, 1), "a Stats with a payload is BadOp")
    check(b.core.reads_held() == 0, "a refused Read holds nothing")

    // What is not refused.
    let mark = b.post_mark()
    let empty = b.post(message(1, 2))
    b.pump()
    check(status_only(&b, mark, 0), "Mark is Ok")
    check(status_only(&b, empty, 0), "a Write of no bytes is Ok")
    check(b.core.tx.totals.queued == 0, "and queues nothing")
}

/// Pending is what a Read would answer at once: the bytes, and the mark.
func pending() {
    var b = Bench<64, 4>.standard()
    let p0 = b.post_pending()
    b.pump()
    check(b.answered(p0) && b.reply_len(p0) == 2 && b.reply_byte(p0, 1) == 0,
          "nothing is pending at first")
    b.uart.feed_run(0, 3)
    b.interrupt()
    let p1 = b.post_pending()
    b.pump()
    check(b.reply_byte(p1, 0) == 0 && b.reply_byte(p1, 1) == 3, "three bytes")
    b.uart.feed_run(3, 3)
    b.interrupt()
    let p2 = b.post_pending()
    b.pump()
    check(b.reply_byte(p2, 1) == 5, "four bytes and the mark")
    var i = 0
    while i < 4 {
        let _ = b.post_read()
        b.pump()
        i = i + 1
    }
    let p3 = b.post_pending()
    b.pump()
    check(b.reply_byte(p3, 1) == 1, "only the mark is left")
    let _ = b.post_read()
    b.pump()
    let p4 = b.post_pending()
    b.pump()
    check(b.reply_byte(p4, 1) == 0, "the mark is spent")
}

/// Pending's reply is one byte, so it holds at the byte's top.
func pending_saturates() {
    var b = Bench<64, 512>.standard()
    b.uart.feed_run(0, 128)
    b.interrupt()
    b.uart.feed_run(0, 128)
    b.interrupt()
    b.uart.feed_run(0, 10)
    b.interrupt()
    check(b.core.rx.buffered() == 266, "266 bytes are buffered")
    let p = b.post_pending()
    b.pump()
    check(b.reply_byte(p, 1) == 255, "Pending reports at most 255")
}

/// Every counter of a Stats, in its place. The values differ from one
/// another, so a swapped pair shows.
func stats() {
    // A fill cap of two leaves queued bytes in the ring behind the FIFO.
    let cfg = Config(tx: TxConfig(tx_empty: 32, fill_cap: 2, max_syncs: MAX_SYNCS),
                     held_reads: MAX_HELD_READS)
    var b = Bench<8, 4>.over(cfg, FakeUart.hardware())
    b.uart.feed_run(0, 6)
    b.uart.inject_frame()
    b.uart.inject_parity()
    b.uart.inject_break()
    b.interrupt()
    b.uart.inject_frame()
    b.uart.inject_break()
    b.interrupt()
    b.uart.inject_break()
    b.interrupt()
    let _ = b.post_write(5)
    b.pump()
    let s0 = b.post_stats()
    b.pump()
    check(b.answered(s0) && b.reply_len(s0) == 33 && b.reply_byte(s0, 0) == 0,
          "an Ok and eight counters")
    check(b.reply_word(s0, 1) == 6, "bytes received")
    check(b.reply_word(s0, 5) == 2, "bytes lost")
    check(b.reply_word(s0, 9) == 2, "frame errors")
    check(b.reply_word(s0, 13) == 1, "parity errors")
    check(b.reply_word(s0, 17) == 3, "breaks")
    check(b.reply_word(s0, 21) == 5, "bytes queued")
    check(b.reply_word(s0, 25) == 2, "bytes sent")
    check(b.reply_word(s0, 29) == 0, "writes held")

    // A Write that does not fit is held, and counted.
    let w = b.post_write(10)
    b.pump()
    check(not b.answered(w), "the Write does not fit the ring: held")
    var rounds = 0
    while not b.answered(w) && rounds < 100 {
        b.uart.drain(3)
        b.interrupt()
        rounds = rounds + 1
    }
    let s1 = b.post_stats()
    b.pump()
    check(b.reply_word(s1, 29) == 1, "writes held")
    check(b.reply_word(s1, 21) == 15, "bytes queued, all of them")
}

func main() {
    refusals()
    pending()
    pending_saturates()
    stats()
}
