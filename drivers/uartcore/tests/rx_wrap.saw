// The receive ring with its head away from zero: bytes wrap around the end
// and come out in order, and a byte put back from the slot the head just
// wrapped to goes to the end of the ring, in front of the rest.

import uartcore.bench.{Bench}

func check(ok: Bool, what: String) {
    if not ok {
        print("failed: {what}")
    }
    assert(ok, what)
}

func read<const R: Int>(b: &var Bench<64, R>) -> Int {
    let id = b.post_read()
    b.pump()
    id
}

func wraps() {
    var b = Bench<64, 4>.standard()
    b.uart.feed_run(0, 3)
    b.interrupt()
    var i = 0
    while i < 3 {
        let id = read(&var b)
        check(b.reply_byte(id, 1) == i as UInt8, "the first three")
        i = i + 1
    }
    b.uart.feed_run(3, 3)
    b.interrupt()
    check(b.core.rx.buffered() == 3, "three more, across the end of the ring")
    var k = 3
    while k < 6 {
        let id = read(&var b)
        check(b.reply_byte(id, 1) == k as UInt8, "in order across the wrap")
        k = k + 1
    }
}

func put_back_across_the_wrap() {
    var b = Bench<64, 4>.standard()
    b.uart.feed_run(0, 3)
    b.interrupt()
    var i = 0
    while i < 3 {
        let _ = read(&var b)
        i = i + 1
    }
    // The head is at 3. A held Read takes the byte there, which moves the
    // head to 0, and its reply does not land.
    let held = read(&var b)
    b.lands = false
    b.uart.feed_run(9, 1)
    b.interrupt()
    check(b.answered(held), "the held Read was answered, and not delivered")
    check(b.core.rx.buffered() == 1, "the byte went back")
    b.lands = true
    let again = read(&var b)
    check(b.reply_byte(again, 1) == 9, "to the front, from before the head")
}

func main() {
    wraps()
    put_back_across_the_wrap()
}
