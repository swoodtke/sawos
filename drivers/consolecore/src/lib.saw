//! The console driver's decisions: the status each `uartproto` request is
//! answered, and the counts the driver reports when it ends.
//!
//! The kernel console has no input for a process, so every `Read` and
//! `Pending` is answered `Unsupported` at once; a `Write`'s payload goes to
//! the console and is answered `Ok`, as are `Sync`, `Mark` and `Stats`;
//! anything the protocol refuses is answered `BadOp`. `Stats` counts the
//! printed bytes as queued and sent, and has nothing else to count.

import uartproto.{Frame, UartOp, UartStats, UartStatus, count_up}

/// The status the console driver answers `frame` with.
public func console_status(frame: &Frame) -> UartStatus {
    guard let op = frame.request() else { return UartStatus.BadOp }
    match op {
        case Read -> UartStatus.Unsupported,
        case Pending -> UartStatus.Unsupported,
        case _ -> UartStatus.Ok,
    }
}

/// Whether the driver writes `frame`'s payload to the console: a `Write` it
/// answers `Ok`.
public func writes(frame: &Frame) -> Bool {
    if let op = frame.request() { op == UartOp.Write } else { false }
}

/// Whether `frame` is a `Stats` the driver answers with its counters.
public func asks_stats(frame: &Frame) -> Bool {
    if let op = frame.request() { op == UartOp.Stats } else { false }
}

/// What the driver has served.
public struct Tally {
    /// Requests, every one.
    public served: UInt32,
    /// Requests answered `BadOp`.
    public refused: UInt32,
    /// Requests answered `Unsupported`.
    public unsupported: UInt32,
    /// Payload bytes written to the console.
    public printed: UInt32,
}

extension Tally {
    /// Nothing served.
    public static func zero() -> Tally {
        Tally(served: 0, refused: 0, unsupported: 0, printed: 0)
    }

    /// Counts one request, answered `status`, that wrote `bytes` bytes.
    public func count(&var self, status: UartStatus, bytes: UInt32) {
        self.served = count_up(self.served, 1)
        match status {
            case BadOp -> { self.refused = count_up(self.refused, 1) },
            case Unsupported -> { self.unsupported = count_up(self.unsupported, 1) },
            case Ok -> {},
            case Busy -> {},
            // The console has no input to lose or damage, and never answers
            // either.
            case Lost -> {},
            case Garbled -> {},
        }
        self.printed = count_up(self.printed, bytes)
    }

    /// What a `Stats` answers: every printed byte is queued and sent at
    /// once, and the console receives, loses and holds nothing.
    public func stats(&self) -> UartStats {
        var s = UartStats.zero()
        s.queued = self.printed
        s.sent = self.printed
        s
    }
}
