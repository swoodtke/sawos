// The console driver's answers and counts, each at its ends.

import uartproto.{BODY_BYTES, Frame, UartStats, UartStatus, count_up}
import consolecore.{Tally, asks_stats, console_status, writes}

/// Holds `ok`, naming what failed when it does not.
func check(ok: Bool, what: String) {
    if not ok {
        print("failed: {what}")
    }
    assert(ok, what)
}

/// A message of `len` bytes whose op byte is `op`.
func message(len: UInt, op: UInt8) -> Frame {
    var f = Frame(len: len, bytes: [0; BODY_BYTES])
    f.bytes[0] = op
    f
}

func main() {
    // Every op, and what is refused before an op is looked at.
    check(console_status(&message(1, 1)) == UartStatus.Unsupported,
          "Read is Unsupported")
    check(console_status(&message(1, 2)) == UartStatus.Ok, "an empty Write is Ok")
    check(console_status(&message(BODY_BYTES as UInt, 2)) == UartStatus.Ok,
          "a full Write is Ok")
    check(console_status(&message(1, 3)) == UartStatus.Ok, "Sync is Ok")
    check(console_status(&message(1, 4)) == UartStatus.Ok, "Mark is Ok")
    check(console_status(&message(0, 1)) == UartStatus.BadOp, "no bytes")
    check(console_status(&message(1, 0)) == UartStatus.BadOp, "op 0")
    check(console_status(&message(1, 5)) == UartStatus.Unsupported,
          "Pending is Unsupported")
    check(console_status(&message(1, 6)) == UartStatus.Ok, "Stats is Ok")
    check(console_status(&message(1, 7)) == UartStatus.BadOp, "op 7")
    check(console_status(&message(1, 255)) == UartStatus.BadOp, "op 255")
    check(console_status(&message(2, 1)) == UartStatus.BadOp,
          "a Read with a byte is BadOp, not Unsupported")
    check(console_status(&message(2, 3)) == UartStatus.BadOp, "a Sync with a byte")
    check(console_status(&message(2, 6)) == UartStatus.BadOp, "a Stats with a byte")

    // Only an accepted Stats is answered with the counters.
    check(asks_stats(&message(1, 6)), "a Stats asks for the counters")
    check(not asks_stats(&message(2, 6)), "a Stats with a byte does not")
    check(not asks_stats(&message(0, 6)), "no bytes does not")
    check(not asks_stats(&message(1, 5)), "a Pending does not")
    check(not asks_stats(&message(1, 3)), "a Sync does not")

    // Only an accepted Write is written.
    check(writes(&message(1, 2)), "an empty Write is written")
    check(writes(&message(BODY_BYTES as UInt, 2)), "a full Write is written")
    check(not writes(&message(1, 1)), "a Read is not")
    check(not writes(&message(1, 3)), "a Sync is not")
    check(not writes(&message(0, 2)), "no bytes is not")

    // The count saturates at its top and nowhere below it.
    check(count_up(0, 1) == 1, "0 + 1")
    check(count_up(0, 0) == 0, "0 + 0")
    check(count_up(0xFFFF_FFFD, 1) == 0xFFFF_FFFE, "two below the top + 1")
    check(count_up(0xFFFF_FFFE, 1) == 0xFFFF_FFFF, "one below the top + 1")
    check(count_up(0xFFFF_FFFF, 1) == 0xFFFF_FFFF, "the top + 1 holds")
    check(count_up(0xFFFF_FF80, 127) == 0xFFFF_FFFF, "up to the top exactly")
    check(count_up(0xFFFF_FF81, 127) == 0xFFFF_FFFF, "past the top holds")
    check(count_up(0xFFFF_FFFF, 0xFFFF_FFFF) == 0xFFFF_FFFF, "the top + the top")

    // A tally counts each request once, by its answer.
    var t = Tally.zero()
    t.count(UartStatus.Ok, 127)
    t.count(UartStatus.BadOp, 0)
    t.count(UartStatus.Unsupported, 0)
    t.count(UartStatus.Ok, 0)
    t.count(UartStatus.Busy, 0)
    check(t.served == 5 && t.refused == 1 && t.unsupported == 1 && t.printed == 127,
          "a tally, Busy counted as served alone")
    check(t.stats() == UartStats(received: 0, lost: 0, frame_errors: 0,
          parity_errors: 0, breaks: 0, queued: 127, sent: 127, writes_held: 0),
          "Stats counts the printed bytes as queued and sent, and nothing else")
    t.count(UartStatus.Lost, 0)
    t.count(UartStatus.Garbled, 0)
    check(t.served == 7 && t.refused == 1 && t.unsupported == 1,
          "a mark counts as served alone")
    var top = Tally(served: 0xFFFF_FFFF, refused: 0xFFFF_FFFF,
                    unsupported: 0xFFFF_FFFF, printed: 0xFFFF_FFFF)
    top.count(UartStatus.BadOp, 127)
    top.count(UartStatus.Unsupported, 1)
    check(top.stats() == UartStats(received: 0, lost: 0, frame_errors: 0,
          parity_errors: 0, breaks: 0, queued: 0xFFFF_FFFF, sent: 0xFFFF_FFFF,
          writes_held: 0), "a full tally's counters hold at the top")
    check(top.served == 0xFFFF_FFFF && top.refused == 0xFFFF_FFFF
          && top.unsupported == 0xFFFF_FFFF && top.printed == 0xFFFF_FFFF,
          "every count holds at its top")
}
