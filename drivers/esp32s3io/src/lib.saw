//! The ESP32-S3's GPIO, IO MUX and LEDC as the GPIO and PWM drivers use
//! them, and UART0 as its driver does.
//!
//! Every number here is the part's, with its source in
//! `hal/xtensa-esp32s3/ABI.md` §9: the blocks' bases, the registers' offsets,
//! the signals, and the words the drivers write. Beside them are the checks a
//! driver runs on its configuration before it maps anything, and the orders
//! the GPIO start, the PWM start, `Set`, `Stop` and the GPIO interrupt service
//! follow, each written once over a port (`RegisterPort`, `GpioPort`) so a
//! driver writes its registers through it and a hosted test records them.
//!
//! A driver holds its blocks as mapped windows, whose bases are its own; a
//! `Register` names a register by its block and its offset in it, and its
//! `address` is the part's, which is what a driver's log and the tests show.
//! UART0's registers are a `UartRegister` and its orders go through a
//! `UartPort`, which reads as well as writes, because an interrupt service
//! reads the status it acts on.

/// The GPIO block: pad levels, output enables, interrupts and the output
/// matrix.
public static GPIO_BASE: UInt32 = 0x6000_4000
/// The IO MUX: each pad's function, pulls, input enable and drive.
public static IO_MUX_BASE: UInt32 = 0x6000_9000
/// LEDC, the PWM block.
public static LEDC_BASE: UInt32 = 0x6001_9000

/// The block a register is in.
public enum Block {
    case Gpio,
    case IoMux,
    case Ledc
}

@synthesize
extension Block: Equatable {}

/// A register: its block, and its offset in the block.
public struct Register {
    block: Block
    offset: UInt32
}

@synthesize
extension Register: Equatable {}

extension Register {
    /// The register's address on the part.
    public func address(&self) -> UInt32 {
        let base = match self.block {
            case Gpio -> GPIO_BASE,
            case IoMux -> IO_MUX_BASE,
            case Ledc -> LEDC_BASE
        }
        base + self.offset
    }
}

// GPIO's registers. Pins 0 to 31 are bank 0, `OUT`, `ENABLE`, `STATUS` and
// `IN`; pins 32 to 53 are bank 1, the `1` forms; a pin's bit is its number
// modulo 32. The W1TS and W1TC forms set and clear the bits written.
static OUT_W1TS: UInt32 = 0x008
static OUT_W1TC: UInt32 = 0x00C
static OUT1_W1TS: UInt32 = 0x014
static OUT1_W1TC: UInt32 = 0x018
static ENABLE_W1TS: UInt32 = 0x024
static ENABLE_W1TC: UInt32 = 0x028
static ENABLE1_W1TS: UInt32 = 0x030
static ENABLE1_W1TC: UInt32 = 0x034
static STATUS_W1TC: UInt32 = 0x04C
static STATUS1_W1TC: UInt32 = 0x058
/// Output levels, pins 0 to 31: what each pad is driven to when its output
/// is enabled.
public static OUT: UInt32 = 0x004
/// The same for 32 to 53.
public static OUT1: UInt32 = 0x010
/// Pad input levels, pins 0 to 31 (read-only).
public static IN: UInt32 = 0x03C
/// Pad input levels, pins 32 to 53 (read-only).
public static IN1: UInt32 = 0x040
/// Interrupt status of the pins enabled for the CPU, 0 to 31 (read-only).
public static PCPU_INT: UInt32 = 0x05C
/// The same for 32 to 53.
public static PCPU_INT1: UInt32 = 0x068
// `PINn`, pin n's interrupt configuration, at 0x074 + 4n.
static PIN0: UInt32 = 0x074
// `FUNCn_OUT_SEL_CFG`, pad n's output signal, at 0x554 + 4n.
static FUNC0_OUT_SEL: UInt32 = 0x554
// IO MUX pad n's word at 0x004 + 4n.
static PAD0: UInt32 = 0x004

/// Pin `pin`'s bit in its bank's registers.
public func pin_bit(pin: UInt8) -> UInt32 {
    1u32 << ((pin % 32) as UInt32)
}

func banked(pin: UInt8, low: UInt32, high: UInt32) -> Register {
    Register(block: Block.Gpio, offset: if pin < 32 { low } else { high })
}

/// The register that sets `pin`'s output level to 1 (`OUT_W1TS`/`OUT1_W1TS`).
public func out_set(pin: UInt8) -> Register { banked(pin, OUT_W1TS, OUT1_W1TS) }
/// The register that sets it to 0.
public func out_clear(pin: UInt8) -> Register { banked(pin, OUT_W1TC, OUT1_W1TC) }
/// The register that enables `pin`'s output.
public func enable_set(pin: UInt8) -> Register { banked(pin, ENABLE_W1TS, ENABLE1_W1TS) }
/// The register that disables it.
public func enable_clear(pin: UInt8) -> Register { banked(pin, ENABLE_W1TC, ENABLE1_W1TC) }
/// The register that clears `pin`'s interrupt status.
public func status_clear(pin: UInt8) -> Register { banked(pin, STATUS_W1TC, STATUS1_W1TC) }

/// The register whose `pin` bit is the level of a pin in `mode`: the pad's
/// input for a pin whose input is on, and the output register for a plain
/// output, whose input is off and so reads 0 whatever it drives.
public func level_register(pin: UInt8, mode: PinMode) -> Register {
    if mode == PinMode.Output {
        Register(block: Block.Gpio, offset: if pin < 32 { OUT } else { OUT1 })
    } else {
        Register(block: Block.Gpio, offset: if pin < 32 { IN } else { IN1 })
    }
}

/// `PINn`: pin `pin`'s interrupt configuration.
public func pin_register(pin: UInt8) -> Register {
    Register(block: Block.Gpio, offset: PIN0 + 4 * (pin as UInt32))
}

/// `FUNCn_OUT_SEL_CFG`: pad `pin`'s output signal.
public func out_sel_register(pin: UInt8) -> Register {
    Register(block: Block.Gpio, offset: FUNC0_OUT_SEL + 4 * (pin as UInt32))
}

/// Pad `pin`'s IO MUX word.
public func pad_register(pin: UInt8) -> Register {
    Register(block: Block.IoMux, offset: PAD0 + 4 * (pin as UInt32))
}

// The IO MUX word's fields.
static MCU_SEL_GPIO: UInt32 = 1 << 12     // function 1, GPIO, on every pad
static FUN_DRV_20MA: UInt32 = 2 << 10
// Pads 17 and 18 have the two `FUN_DRV` bits the other way round, so their
// ~20 mA is the field's 1 (ABI.md §9c).
static FUN_DRV_20MA_SWAPPED: UInt32 = 1 << 10
static FUN_IE: UInt32 = 1 << 9
static FUN_PU: UInt32 = 1 << 8
static FUN_PD: UInt32 = 1 << 7

/// How a GPIO pin is configured.
public enum PinMode {
    /// An input with the pad's pull-up.
    case InputPullUp,
    /// An input with the pad's pull-down.
    case InputPullDown,
    /// An input with neither pull.
    case InputFloating,
    /// An output, driven from its configured level at start.
    case Output,
    /// An output with its input enabled and an any-edge interrupt, so its
    /// input follows the driven level and a change raises the line.
    case OutputLoopback
}

@synthesize
extension PinMode: Equatable {}

/// Whether a pin of `mode` is an output.
public func is_output(mode: PinMode) -> Bool {
    mode == PinMode.Output || mode == PinMode.OutputLoopback
}

/// The `FUN_DRV` bits that drive pad `pin` at ~20 mA.
func drive_20ma(pin: UInt8) -> UInt32 {
    if pin == 17 || pin == 18 { FUN_DRV_20MA_SWAPPED } else { FUN_DRV_20MA }
}

/// The IO MUX word of pad `pin` in `mode`: function 1 (GPIO), ~20 mA, the
/// input enable and the pull the mode wants.
public func pad_word(pin: UInt8, mode: PinMode) -> UInt32 {
    let base = MCU_SEL_GPIO | drive_20ma(pin)
    match mode {
        case InputPullUp -> base | FUN_IE | FUN_PU,
        case InputPullDown -> base | FUN_IE | FUN_PD,
        case InputFloating -> base | FUN_IE,
        case Output -> base,
        case OutputLoopback -> base | FUN_IE
    }
}

/// Servo pad `pin`'s IO MUX word: function 1 (GPIO), ~20 mA, its input
/// enabled so its level can be read back.
public func servo_pad_word(pin: UInt8) -> UInt32 {
    MCU_SEL_GPIO | drive_20ma(pin) | FUN_IE
}

// `PINn`'s fields: `INT_TYPE` (bits 9:7) 3 is any edge; `INT_ENA` bit 13 is
// the CPU's interrupt.
static INT_ANY_EDGE: UInt32 = 3 << 7
static INT_ENA_CPU: UInt32 = 1 << 13

/// `PINn` for a pin of `mode`: an any-edge interrupt to the CPU for a pin
/// that is read, none for a plain output.
public func pin_cfg(mode: PinMode) -> UInt32 {
    if mode == PinMode.Output { 0 } else { INT_ANY_EDGE | INT_ENA_CPU }
}

// `FUNCn_OUT_SEL_CFG`'s fields: `OUT_SEL` (bits 8:0) the signal, and
// `OEN_SEL` (bit 10), whose 1 takes the output enable from `ENABLE[n]`.
static SIG_GPIO_OUT: UInt32 = 256
static LEDC_LS_SIG_OUT0: UInt32 = 73
static OEN_SEL: UInt32 = 1 << 10

/// The output select's reset word: the plain GPIO signal, with the
/// peripheral's own output enable.
public static OUT_SEL_RESET: UInt32 = 0x100

/// The output select of a plain GPIO output: the GPIO signal, enabled by
/// `ENABLE[n]`.
public static OUT_SEL_GPIO: UInt32 = (256 | (1 << 10))

/// The output select of LEDC channel `channel`'s signal, enabled by
/// `ENABLE[n]`.
public func out_sel_ledc(channel: UInt8) -> UInt32 {
    (LEDC_LS_SIG_OUT0 + (channel as UInt32)) | OEN_SEL
}

static_assert(OUT_SEL_GPIO == (SIG_GPIO_OUT | OEN_SEL), "the plain output's select")

/// What a driver writes its registers through, one whole word each.
public trait RegisterPort {
    func write(&var self, reg: Register, word: UInt32)
}

/// One GPIO pin a driver serves, as its configuration states it.
public struct GpioPin {
    pin: UInt8
    mode: PinMode
    /// An output's level at start, 0 or 1; an input's is 0, and any other is
    /// refused.
    level: UInt8
}

/// Configures `pin` through `port`, whole words in an order that never drives
/// a level nobody wrote, never a read-modify-write.
///
/// An output's enable is cleared first and set last, after its level, its
/// output select and its function, so the pad drives nothing until it drives
/// the written level, whatever function it had: the output select comes
/// before the IO MUX word, the order that cannot glitch the pad. A pin that is
/// read has its interrupt enabled last, after its input enable and its pull
/// are set and its status is cleared, so no stale edge is left pending.
public func start_gpio_pin<P: RegisterPort>(port: &var P, pin: &GpioPin) {
    let n = pin.pin
    let bit = pin_bit(n)
    port.write(enable_clear(n), bit)
    if is_output(pin.mode) {
        port.write(if pin.level == 1 { out_set(n) } else { out_clear(n) }, bit)
        port.write(out_sel_register(n), OUT_SEL_GPIO)
        port.write(pad_register(n), pad_word(n, pin.mode))
        port.write(enable_set(n), bit)
    } else {
        port.write(out_sel_register(n), OUT_SEL_RESET)
        port.write(pad_register(n), pad_word(n, pin.mode))
    }
    if pin.mode != PinMode.Output {
        port.write(status_clear(n), bit)
    }
    port.write(pin_register(n), pin_cfg(pin.mode))
}

/// Configures every pin of `pins`, in their order (`start_gpio_pin`).
public func start_gpio<P: RegisterPort, const N: Int>(port: &var P, pins: &[GpioPin; N]) {
    var i = 0
    while i < N {
        start_gpio_pin(&var port, &pins[i])
        i = i + 1
    }
}

/// Why a configuration is refused.
public enum ConfigError {
    /// Not a GPIO of the part: above 48, or 22 to 25.
    case NotAGpio(pin: UInt8),
    /// One of 26 to 32, the SPI bus the code runs from.
    case FlashPin(pin: UInt8),
    /// One of 33 to 37, the octal PSRAM's D4 to D7 and DQS.
    case PsramPin(pin: UInt8),
    /// 43 or 44, UART0's pads: the kernel's console.
    case ConsolePin(pin: UInt8),
    /// 19 or 20, the USB-Serial-JTAG's D- and D+.
    case UsbPin(pin: UInt8),
    /// A pin named twice.
    case PinTwice(pin: UInt8),
    /// An output's level other than 0 or 1.
    case BadLevel(pin: UInt8, level: UInt8),
    /// An input's level other than 0.
    case InputLevel(pin: UInt8, level: UInt8),
    /// A frame outside `FRAME_MIN_US` to `FRAME_MAX_US`.
    case FrameOutOfRange(frame_us: UInt32),
    /// A frame that is not a multiple of 8 microseconds, which would cut the
    /// divider short.
    case FrameNotMultipleOf8(frame_us: UInt32),
    /// A channel above 7.
    case ChannelOutOfRange(channel: UInt8),
    /// A channel named twice.
    case ChannelTwice(channel: UInt8),
    /// A servo whose least pulse is above its greatest.
    case PulseRangeInverted(channel: UInt8),
    /// A servo whose greatest pulse is not shorter than the frame.
    case PulseNotBelowFrame(channel: UInt8),
    /// A servo whose least pulse rounds to no counts: no pulse.
    case MinPulseNoCounts(channel: UInt8),
    /// A servo whose greatest pulse rounds to the whole frame, a duty the
    /// timer cannot make at its full resolution.
    case MaxPulseWholeFrame(channel: UInt8),
    /// Servo pins that are not consecutive from the lowest.
    case PinsNotConsecutive(pin: UInt8),
    /// A servo count that is not a power of two, which no one window holds.
    case PinCountNotPowerOfTwo(count: Int),
    /// Servo pins whose registers are not one naturally aligned window in
    /// the output selects and the IO MUX.
    case PinsNotAligned(pin: UInt8),
    /// A UART receive threshold of 0 or past `RX_FULL_MAX`.
    case RxFullThreshold(value: UInt32),
    /// A UART transmit threshold of 0 or past `TX_EMPTY_MAX`.
    case TxEmptyThreshold(value: UInt32),
    /// A UART receive timeout of 0 bit times, which turns it off, or past
    /// `RX_TIMEOUT_MAX`.
    case RxTimeout(bits: UInt32)
}

@synthesize
extension ConfigError: Equatable {}

extension ConfigError {
    /// What a driver prints, after `config refused: `.
    public func describe(&self) -> String {
        match self {
            case NotAGpio(pin) -> "pin {pin} is not a GPIO of the part",
            case FlashPin(pin) -> "pin {pin} is held by the chip (the SPI flash bus)",
            case PsramPin(pin) -> "pin {pin} is held by the chip (the octal PSRAM's bus)",
            case ConsolePin(pin) -> "pin {pin} is held by the chip (the console)",
            case UsbPin(pin) -> "pin {pin} is held by the chip (the USB-Serial-JTAG)",
            case PinTwice(pin) -> "pin {pin} is named twice",
            case BadLevel(pin, level) -> "pin {pin}'s level is {level}, not 0 or 1",
            case InputLevel(pin, level) -> "pin {pin} is an input, and its level is {level}, not 0",
            case FrameOutOfRange(frame_us) -> "frame {frame_us} us is outside {FRAME_MIN_US}..{FRAME_MAX_US}",
            case FrameNotMultipleOf8(frame_us) -> "frame {frame_us} us is not a multiple of 8",
            case ChannelOutOfRange(channel) -> "channel {channel} is above 7",
            case ChannelTwice(channel) -> "channel {channel} is named twice",
            case PulseRangeInverted(channel) -> "channel {channel}'s least pulse is above its greatest",
            case PulseNotBelowFrame(channel) -> "channel {channel}'s greatest pulse is not shorter than the frame",
            case MinPulseNoCounts(channel) -> "channel {channel}'s least pulse is no counts",
            case MaxPulseWholeFrame(channel) -> "channel {channel}'s greatest pulse is the whole frame",
            case PinsNotConsecutive(pin) -> "pin {pin} is not consecutive with the other servos'",
            case PinCountNotPowerOfTwo(count) -> "{count} servos are not a power of two",
            case PinsNotAligned(pin) -> "the servo pins from {pin} are not one aligned window",
            case RxFullThreshold(value) -> "the receive threshold {value} is not 1..{RX_FULL_MAX}",
            case TxEmptyThreshold(value) -> "the transmit threshold {value} is not 1..{TX_EMPTY_MAX}",
            case RxTimeout(bits) -> "the receive timeout {bits} is not 1..{RX_TIMEOUT_MAX} bit times"
        }
    }
}

/// Refuses `pin` unless it is a GPIO of the part that no S3 image holds for
/// the chip: the SPI flash bus (26 to 32), the octal PSRAM's own pads (33 to
/// 37), the console's pads (43, 44) and the USB-Serial-JTAG's (19, 20),
/// whose pad enable a driver here does not write. Every GPIO of the part can
/// drive.
///
/// 33 to 37 are refused on every board. A part with octal PSRAM in its
/// package, as the N8R8 every board here runs on, wires them to the RAM chip
/// whether or not a board brings it up, and the `esp32s3-r8` board's
/// `memory_init` takes them for it (hal/xtensa-esp32s3/ABI.md §16c, S1); a
/// driver that set one would re-mux a PSRAM data pad under the cache.
public func check_pin(pin: UInt8) -> Result<Void, ConfigError> {
    if pin > 48 || (pin >= 22 && pin <= 25) {
        return ConfigError.NotAGpio(pin: pin)
    }
    if pin >= 26 && pin <= 32 {
        return ConfigError.FlashPin(pin: pin)
    }
    if pin >= 33 && pin <= 37 {
        return ConfigError.PsramPin(pin: pin)
    }
    if pin == 43 || pin == 44 {
        return ConfigError.ConsolePin(pin: pin)
    }
    if pin == 19 || pin == 20 {
        return ConfigError.UsbPin(pin: pin)
    }
}

/// Checks a GPIO driver's configuration, pin by pin in order: each a pin
/// `check_pin` takes, none named twice, an output's level 0 or 1 and an
/// input's 0.
public func check_gpio_config<const N: Int>(pins: &[GpioPin; N]) -> Result<Void, ConfigError> {
    var i = 0
    while i < N {
        let p = pins[i]
        try check_pin(p.pin)
        var j = 0
        while j < i {
            if pins[j].pin == p.pin {
                return ConfigError.PinTwice(pin: p.pin)
            }
            j = j + 1
        }
        if is_output(p.mode) && p.level > 1 {
            return ConfigError.BadLevel(pin: p.pin, level: p.level)
        }
        if not is_output(p.mode) && p.level != 0 {
            return ConfigError.InputLevel(pin: p.pin, level: p.level)
        }
        i = i + 1
    }
}

/// `count` plus one, held at the greatest value rather than wrapping: a count
/// a client's traffic can drive must not end the driver that keeps it.
public func count_up(count: UInt32) -> UInt32 {
    if count == 0xFFFF_FFFF { count } else { count + 1 }
}

/// `count_up` for a 16-bit count.
public func count_up_16(count: UInt16) -> UInt16 {
    if count == 0xFFFF { count } else { count + 1 }
}

/// The interrupt status, the levels or the enables of every pin: bank 0's
/// word and bank 1's.
public struct PinSet {
    low: UInt32
    high: UInt32
}

@synthesize
extension PinSet: Equatable {}

extension PinSet {
    /// No pin.
    public static func empty() -> PinSet {
        PinSet(low: 0, high: 0)
    }

    /// `pin`'s bit, 0 or 1.
    public func level(&self, pin: UInt8) -> UInt8 {
        let word = if pin < 32 { self.low } else { self.high }
        if (word & pin_bit(pin)) != 0 { 1 } else { 0 }
    }

    /// Whether no pin's bit is set.
    public func is_empty(&self) -> Bool {
        self.low == 0 && self.high == 0
    }
}

/// What the GPIO interrupt service reads and writes, and its acknowledgement.
public trait GpioPort {
    /// `PCPU_INT` and `PCPU_INT1`: the pins whose interrupt fired.
    func pcpu_int(&var self) -> PinSet
    /// Writes exactly `fired`'s bits to `STATUS_W1TC` and `STATUS1_W1TC`.
    func clear_status(&var self, fired: PinSet)
    /// `IN` and `IN1`: every pad's level.
    func levels(&var self) -> PinSet
    /// Acknowledges the interrupt, which rearms its line; false when the
    /// acknowledgement was refused.
    func ack(&var self) -> Bool
}

/// The GPIO block as a driver reaches it: whole words by register, and the
/// line's acknowledgement.
public trait Pads {
    /// The word of `reg`, read from the device now.
    func read_word(&self, reg: Register) -> UInt32
    /// Writes `word` to `reg`.
    func write_word(&var self, reg: Register, word: UInt32)
    /// Acknowledges the line; false when it was refused.
    func acknowledge(&var self) -> Bool
}

/// `PCPU_INT` and `PCPU_INT1` through `pads`.
public func pads_pcpu_int<D: Pads>(pads: &D) -> PinSet {
    PinSet(low: pads.read_word(Register(block: Block.Gpio, offset: PCPU_INT)),
           high: pads.read_word(Register(block: Block.Gpio, offset: PCPU_INT1)))
}

/// Writes exactly `fired`'s bits to `STATUS_W1TC` and `STATUS1_W1TC` through
/// `pads`, and no word that has no bit to clear.
public func pads_clear_status<D: Pads>(pads: &var D, fired: PinSet) {
    if fired.low != 0 {
        pads.write_word(status_clear(0), fired.low)
    }
    if fired.high != 0 {
        pads.write_word(status_clear(32), fired.high)
    }
}

/// `IN` and `IN1` through `pads`.
public func pads_levels<D: Pads>(pads: &D) -> PinSet {
    PinSet(low: pads.read_word(Register(block: Block.Gpio, offset: IN)),
           high: pads.read_word(Register(block: Block.Gpio, offset: IN1)))
}

/// A level a client waits for on a pin.
public struct PinWait {
    pin: UInt8
    level: UInt8
}

/// How many waits a GPIO driver holds at once.
public static MAX_HELD: Int = 4

/// What one interrupt service found.
public struct Serviced {
    /// Whether any pin's status was set.
    fired: Bool
    /// For each held wait, by its slot, whether its pin now reads its level.
    answered: [Bool; MAX_HELD]
    /// The levels read.
    levels: PinSet
    /// Whether the acknowledgement was accepted.
    acknowledged: Bool
}

/// Services the GPIO interrupt through `port`, for the waits `held`, in an
/// order that loses no edge: reads which pins fired, clears exactly those,
/// reads the levels, then acknowledges, and answers each held wait whose pin
/// reads its level.
///
/// The clear comes before the levels are read, so an edge after the clear
/// sets the status again and fires again after the acknowledgement: the
/// levels read are never stale without a fire still to come. Every device
/// access comes before the acknowledgement (spec §9).
public func service_interrupt<P: GpioPort>(port: &var P, held: &[PinWait?; MAX_HELD]) -> Serviced {
    let fired = port.pcpu_int()
    port.clear_status(fired)
    let levels = port.levels()
    let acknowledged = port.ack()
    var answered = [false; MAX_HELD]
    var i = 0
    while i < MAX_HELD {
        if let w = held[i] {
            answered[i] = levels.level(w.pin) == w.level
        }
        i = i + 1
    }
    Serviced(fired: not fired.is_empty(), answered: answered, levels: levels,
             acknowledged: acknowledged)
}

/// `fires` after a service: one more when any pin fired.
public func fires_after(serviced: &Serviced, fires: UInt32) -> UInt32 {
    if serviced.fired { count_up(fires) } else { fires }
}

/// The held wait in `slot` when the service found its pin at its level, taken
/// out of `held` so its record is cleared; `None` for a wait still to come or
/// no wait.
public func take_answered(serviced: &Serviced, held: &var [PinWait?; MAX_HELD],
                          slot: Int) -> PinWait? {
    if serviced.answered[slot] { held[slot].take() } else { None }
}

/// The least frame, in microseconds: the divider's least, 1.0, gives
/// 409.6 us at 40 MHz and 14 bits, and a frame is a multiple of 8.
public static FRAME_MIN_US: UInt32 = 416
/// The greatest frame. It keeps a pulse's count arithmetic inside 32 bits
/// (`pulse_counts`), since a 64-bit divide is a call no call0 library has.
public static FRAME_MAX_US: UInt32 = 200_000
/// The timer's counts per frame: 14 bits.
public static FRAME_COUNTS: UInt32 = 1 << 14
static DUTY_RES_BITS: UInt32 = 14

/// The LEDC timer's divider field for a frame of `frame_us`: 10.8 fixed
/// point, `40 * frame_us * 256 / 16384` cycles of the 40 MHz crystal per
/// count.
public func divider(frame_us: UInt32) -> UInt32 {
    frame_us * 5 / 8
}

/// The counts of a pulse of `pulse_us` in a frame of `frame_us`, rounded to
/// the nearest. With `pulse_us` below `frame_us` and `frame_us` at most
/// `FRAME_MAX_US`, the product stays inside 32 bits.
public func pulse_counts(pulse_us: UInt32, frame_us: UInt32) -> UInt32 {
    (pulse_us * FRAME_COUNTS + frame_us / 2) / frame_us
}

/// The LEDC channels: 0 to 7.
public static CHANNELS: UInt8 = 8

/// One servo a PWM driver drives: its LEDC channel, its pad, and the pulse
/// range it may be commanded to.
public struct Servo {
    channel: UInt8
    pin: UInt8
    min_us: UInt32
    max_us: UInt32
}

/// Checks a PWM driver's configuration: the frame, then each servo in order
/// (its channel, its pulse range in microseconds and in counts, its pin),
/// then the servos' pins as one window: consecutive from the lowest, a power
/// of two of them, and the lowest pin's output select and IO MUX word aligned
/// to the window's length, so one part of each block holds them.
public func check_pwm_config<const N: Int>(frame_us: UInt32, servos: &[Servo; N]) -> Result<Void, ConfigError> {
    if frame_us < FRAME_MIN_US || frame_us > FRAME_MAX_US {
        return ConfigError.FrameOutOfRange(frame_us: frame_us)
    }
    if frame_us % 8 != 0 {
        return ConfigError.FrameNotMultipleOf8(frame_us: frame_us)
    }
    var lowest: UInt8 = 255
    var i = 0
    while i < N {
        let s = servos[i]
        if s.channel >= CHANNELS {
            return ConfigError.ChannelOutOfRange(channel: s.channel)
        }
        var j = 0
        while j < i {
            if servos[j].channel == s.channel {
                return ConfigError.ChannelTwice(channel: s.channel)
            }
            if servos[j].pin == s.pin {
                return ConfigError.PinTwice(pin: s.pin)
            }
            j = j + 1
        }
        if s.min_us > s.max_us {
            return ConfigError.PulseRangeInverted(channel: s.channel)
        }
        if s.max_us >= frame_us {
            return ConfigError.PulseNotBelowFrame(channel: s.channel)
        }
        if pulse_counts(s.min_us, frame_us) == 0 {
            return ConfigError.MinPulseNoCounts(channel: s.channel)
        }
        if pulse_counts(s.max_us, frame_us) >= FRAME_COUNTS {
            return ConfigError.MaxPulseWholeFrame(channel: s.channel)
        }
        try check_pin(s.pin)
        if s.pin < lowest {
            lowest = s.pin
        }
        i = i + 1
    }
    if N == 0 || (N & (N - 1)) != 0 {
        return ConfigError.PinCountNotPowerOfTwo(count: N)
    }
    i = 0
    while i < N {
        if (servos[i].pin - lowest) as Int >= N {
            return ConfigError.PinsNotConsecutive(pin: servos[i].pin)
        }
        i = i + 1
    }
    let window = 4 * (N as UInt32)
    if out_sel_register(lowest).offset % window != 0 || pad_register(lowest).offset % window != 0 {
        return ConfigError.PinsNotAligned(pin: lowest)
    }
}

// LEDC's registers: channel c's five words at 0x14 c, timer t's two at
// 0xA0 + 8 t, and `CONF`.
static CHANNEL_STRIDE: UInt32 = 0x14
static CH_CONF0: UInt32 = 0x00
static CH_HPOINT: UInt32 = 0x04
static CH_DUTY: UInt32 = 0x08
static CH_CONF1: UInt32 = 0x0C
/// Channel c's duty in force, at 0x10 from the channel's first word
/// (read-only).
public static CH_DUTY_R: UInt32 = 0x10
static TIMER0_CONF: UInt32 = 0xA0
/// Timer 0's counter (read-only).
public static TIMER0_VALUE: UInt32 = 0xA4
static LEDC_CONF: UInt32 = 0xD0

/// Channel `channel`'s register at `offset` from its first.
public func channel_register(channel: UInt8, offset: UInt32) -> Register {
    Register(block: Block.Ledc, offset: CHANNEL_STRIDE * (channel as UInt32) + offset)
}

// `CONF`'s `APB_CLK_SEL` 3: every timer counts XTAL_CLK, the 40 MHz crystal,
// which reaches the peripherals undivided under every clock key.
static CONF_XTAL: UInt32 = 3
// `TIMERt_CONF`: `DUTY_RES` (3:0), `CLK_DIV` (21:4), `RST` (23, which resets
// to 1), `PARA_UP` (25, write-only).
static TIMER_RST: UInt32 = 1 << 23
static TIMER_PARA_UP: UInt32 = 1 << 25
// `CHc_CONF0`: `SIG_OUT_EN` (2), `IDLE_LV` (3, left 0) and `PARA_UP` (4);
// `TIMER_SEL` 0 is timer 0.
static CONF0_SIG_OUT_EN: UInt32 = 1 << 2
static CONF0_PARA_UP: UInt32 = 1 << 4
// `CHc_CONF1` for a fixed duty: `DUTY_START` (31), `DUTY_INC` (30),
// `DUTY_NUM` 1 (29:20), `DUTY_CYCLE` 1 (19:10), `DUTY_SCALE` 0.
static CONF1_DUTY_START: UInt32 = 1 << 31
static CONF1_FIXED: UInt32 = (1 << 30) | (1 << 20) | (1 << 10)
// `CHc_DUTY`'s low four bits are a fraction.
static DUTY_FRACTION_BITS: UInt32 = 4

/// `TIMERt_CONF` for a frame of `frame_us`, `RST` and `PARA_UP` clear.
public func timer_word(frame_us: UInt32) -> UInt32 {
    DUTY_RES_BITS | (divider(frame_us) << 4)
}

/// Starts the PWM through `port` for `servos` in a frame of `frame_us`:
/// timer 0 counts the crystal in 14 bits; every channel is idle, its output
/// `IDLE_LV`, low; and only then is each servo's pad routed, function first:
/// its output select to the plain GPIO signal, its IO MUX word, then its
/// output select to its channel.
///
/// The timer's fields are loaded with `RST` held, latched, then released, so
/// the counter starts at the new divider. A pad that becomes GPIO drives
/// root's written 0 until its select names its channel, which drives the idle
/// channel's 0, so no step drives a level nobody wrote.
public func start_pwm<P: RegisterPort, const N: Int>(port: &var P, frame_us: UInt32,
                                                      servos: &[Servo; N]) {
    let conf = Register(block: Block.Ledc, offset: TIMER0_CONF)
    port.write(Register(block: Block.Ledc, offset: LEDC_CONF), CONF_XTAL)
    port.write(conf, timer_word(frame_us) | TIMER_RST)
    port.write(conf, timer_word(frame_us) | TIMER_RST | TIMER_PARA_UP)
    port.write(conf, timer_word(frame_us))
    var i = 0
    while i < N {
        let channel = servos[i].channel
        port.write(channel_register(channel, CH_HPOINT), 0)
        port.write(channel_register(channel, CH_CONF0), CONF0_PARA_UP)
        i = i + 1
    }
    i = 0
    while i < N {
        let pin = servos[i].pin
        port.write(out_sel_register(pin), OUT_SEL_RESET)
        port.write(pad_register(pin), servo_pad_word(pin))
        port.write(out_sel_register(pin), out_sel_ledc(servos[i].channel))
        i = i + 1
    }
}

/// Sets `channel` to a fixed duty of `counts` through `port`: the duty, then
/// a duty update with `DUTY_START`, then the output enabled, latched at the
/// next frame boundary, so the frame in progress finishes at its old width.
public func set_pwm<P: RegisterPort>(port: &var P, channel: UInt8, counts: UInt32) {
    port.write(channel_register(channel, CH_DUTY), counts << DUTY_FRACTION_BITS)
    port.write(channel_register(channel, CH_CONF1), CONF1_DUTY_START | CONF1_FIXED)
    port.write(channel_register(channel, CH_CONF0), CONF0_SIG_OUT_EN | CONF0_PARA_UP)
}

/// Stops `channel` through `port`: no duty update, and its output idle,
/// low, from the next frame boundary.
public func stop_pwm<P: RegisterPort>(port: &var P, channel: UInt8) {
    port.write(channel_register(channel, CH_CONF1), CONF1_FIXED)
    port.write(channel_register(channel, CH_CONF0), CONF0_PARA_UP)
}

// The PWM driver's commands look their channel up and check their pulse before
// they write anything (`set_servo`, `stop_servo`), and `place_pwm` says which
// of that driver's windows holds a register.

/// Why a PWM driver refuses a command.
public enum PwmRefusal {
    /// A channel the configuration does not name.
    case BadChannel,
    /// A pulse outside the channel's configured range.
    case OutOfRange
}

@synthesize
extension PwmRefusal: Equatable {}

/// The servo `servos` puts on `channel`, or `BadChannel`. Every command that
/// names a channel looks it up here before it forms a register's address: an
/// unchecked channel 8's `CONF0` would be `TIMER0_CONF`, the timer every
/// channel runs on.
public func servo_of<const N: Int>(servos: &[Servo; N], channel: UInt8) -> Result<Servo, PwmRefusal> {
    var i = 0
    while i < N {
        if servos[i].channel == channel {
            return servos[i]
        }
        i = i + 1
    }
    return PwmRefusal.BadChannel
}

/// Sets the servo on `channel` to pulses `pulse_us` wide through `port`, from
/// the next frame boundary (`set_pwm`), and answers the counts the pulse came
/// to. A channel `servos` does not name is `BadChannel` and a pulse outside
/// the servo's `min_us` to `max_us` is `OutOfRange`, and either writes
/// nothing: a command is refused, never clamped. The range is checked before
/// the counts are computed, so their arithmetic stays inside 32 bits.
public func set_servo<P: RegisterPort, const N: Int>(port: &var P, frame_us: UInt32,
                                                     servos: &[Servo; N], channel: UInt8,
                                                     pulse_us: UInt32) -> Result<UInt32, PwmRefusal> {
    let servo = try servo_of(&servos, channel)
    if pulse_us < servo.min_us || pulse_us > servo.max_us {
        return PwmRefusal.OutOfRange
    }
    let counts = pulse_counts(pulse_us, frame_us)
    set_pwm(&var port, servo.channel, counts)
    return counts
}

/// Stops the servo on `channel` through `port` (`stop_pwm`): its line low from
/// the next frame boundary, so the servo goes limp, until a later
/// `set_servo`. A channel `servos` does not name is `BadChannel`, and writes
/// nothing.
public func stop_servo<P: RegisterPort, const N: Int>(port: &var P, servos: &[Servo; N],
                                                      channel: UInt8) -> Result<Void, PwmRefusal> {
    let servo = try servo_of(&servos, channel)
    stop_pwm(&var port, servo.channel)
    return
}

/// The registers a PWM driver's `Inspect` reads for one servo.
public struct Inspected {
    /// Its channel's duty in force.
    duty_r: Register
    /// Timer 0's counter.
    timer: Register
    /// Its channel's `CONF0`.
    conf0: Register
    /// Its pad's output select.
    out_sel: Register
    /// Its pad's IO MUX word.
    pad: Register
}

/// The registers `Inspect` reads for `servo`.
public func inspected(servo: &Servo) -> Inspected {
    Inspected(duty_r: channel_register(servo.channel, CH_DUTY_R),
              timer: Register(block: Block.Ledc, offset: TIMER0_VALUE),
              conf0: channel_register(servo.channel, CH_CONF0),
              out_sel: out_sel_register(servo.pin),
              pad: pad_register(servo.pin))
}

/// The lowest of the servos' pins, which begins both of a PWM driver's
/// parts; 255 for no servo.
public func lowest_pin<const N: Int>(servos: &[Servo; N]) -> UInt8 {
    var lowest: UInt8 = 255
    var i = 0
    while i < N {
        if servos[i].pin < lowest {
            lowest = servos[i].pin
        }
        i = i + 1
    }
    lowest
}

/// Which of a PWM driver's windows holds a register.
public enum PwmWindow {
    /// LEDC, whole.
    case Ledc,
    /// The part of GPIO holding its pads' output selects.
    case OutSel,
    /// The part of the IO MUX holding its pads' words.
    case Pads
}

@synthesize
extension PwmWindow: Equatable {}

/// A register as a PWM driver reaches it: its window, and its offset there.
public struct Placed {
    window: PwmWindow
    offset: UInt32
}

@synthesize
extension Placed: Equatable {}

/// The offset of `offset` in a part of `count` words beginning at `first`, or
/// `None` when the part does not hold it.
func in_part(offset: UInt32, first: UInt32, count: Int) -> UInt32? {
    if offset < first || offset - first >= 4 * (count as UInt32) {
        return None
    }
    offset - first
}

/// Where a PWM driver whose servos' pins are the `count` from `lowest` reaches
/// `reg`: in LEDC at its own offset, and a pad's output select and IO MUX word
/// in the part that begins at pad `lowest`'s register. `None` for a register
/// none of its windows holds, which a driver has no address for.
public func place_pwm(reg: Register, lowest: UInt8, count: Int) -> Placed? {
    match reg.block {
        case Ledc -> Placed(window: PwmWindow.Ledc, offset: reg.offset),
        case Gpio -> {
            guard let at = in_part(reg.offset, out_sel_register(lowest).offset, count) else {
                return None
            }
            Placed(window: PwmWindow.OutSel, offset: at)
        },
        case IoMux -> {
            guard let at = in_part(reg.offset, pad_register(lowest).offset, count) else {
                return None
            }
            Placed(window: PwmWindow.Pads, offset: at)
        }
    }
}

// =============================================================================
// UART0
// =============================================================================
//
// UART0 as a driver that serves it uses it: the registers a receive and a
// transmit interrupt touch, the words that bring it up, and the order each
// service follows (hal/xtensa-esp32s3/ABI.md §4b). The ROM left its divisor
// and clock alone, and so does everything here.

/// UART0's block, the console's.
public static UART0_BASE: UInt32 = 0x6000_0000

/// The interrupt matrix source UART0 raises.
public static UART0_SOURCE: UInt32 = 27

/// The depth of each of UART0's two FIFOs.
public static UART_FIFO_BYTES: UInt32 = 128

/// A UART0 register: its offset in the block. `Register` names the GPIO, IO
/// MUX and LEDC blocks, which a GPIO or PWM driver matches over; UART0 has a
/// type of its own so that match does not grow an arm it can never take.
public struct UartRegister {
    offset: UInt32
}

@synthesize
extension UartRegister: Equatable {}

extension UartRegister {
    /// The register's address on the part.
    public func address(&self) -> UInt32 {
        UART0_BASE + self.offset
    }
}

// The registers a driver touches. Reading `UART_FIFO` pops the receiver, and
// storing to it queues a byte to transmit, so each is only ever used as its
// own half.
static UART_FIFO_OFFSET: UInt32 = 0x00
static UART_INT_ST_OFFSET: UInt32 = 0x08
static UART_INT_ENA_OFFSET: UInt32 = 0x0C
static UART_INT_CLR_OFFSET: UInt32 = 0x10
static UART_STATUS_OFFSET: UInt32 = 0x1C
static UART_CONF0_OFFSET: UInt32 = 0x20
static UART_CONF1_OFFSET: UInt32 = 0x24
static UART_MEM_CONF_OFFSET: UInt32 = 0x60

/// `FIFO`: a read pops one received byte, a store queues one to transmit.
public func uart_fifo() -> UartRegister { UartRegister(offset: UART_FIFO_OFFSET) }
/// `INT_ST`: the interrupts raised and enabled (read-only).
public func uart_int_st() -> UartRegister { UartRegister(offset: UART_INT_ST_OFFSET) }
/// `INT_ENA`: which interrupts reach the line.
public func uart_int_ena() -> UartRegister { UartRegister(offset: UART_INT_ENA_OFFSET) }
/// `INT_CLR`: a bit stored here clears that interrupt's raw bit.
public func uart_int_clr() -> UartRegister { UartRegister(offset: UART_INT_CLR_OFFSET) }
/// `STATUS`: the two FIFOs' counts (read-only).
public func uart_status() -> UartRegister { UartRegister(offset: UART_STATUS_OFFSET) }
/// `CONF0`: the frame's format, and whether a damaged byte is stored.
public func uart_conf0() -> UartRegister { UartRegister(offset: UART_CONF0_OFFSET) }
/// `CONF1`: the FIFO thresholds and the receive timeout's enable.
public func uart_conf1() -> UartRegister { UartRegister(offset: UART_CONF1_OFFSET) }
/// `MEM_CONF`: the receive timeout's length.
public func uart_mem_conf() -> UartRegister { UartRegister(offset: UART_MEM_CONF_OFFSET) }

// The interrupt bits, the same in `INT_ST`, `INT_ENA` and `INT_CLR`.
/// The receive FIFO holds more than `RXFIFO_FULL_THRHD` bytes.
public static INT_RXFIFO_FULL: UInt32 = 1 << 0
/// The transmit FIFO holds fewer than `TXFIFO_EMPTY_THRHD` bytes.
public static INT_TXFIFO_EMPTY: UInt32 = 1 << 1
/// A received byte's parity was wrong.
public static INT_PARITY_ERR: UInt32 = 1 << 2
/// A received byte's stop bit was wrong.
public static INT_FRM_ERR: UInt32 = 1 << 3
/// The receive FIFO overflowed: bytes were dropped, and the hardware does not
/// say how many.
public static INT_RXFIFO_OVF: UInt32 = 1 << 4
/// A break: the line was low for longer than a byte.
public static INT_BRK_DET: UInt32 = 1 << 7
/// The receiver has been idle for `RX_TOUT_THRHD` bit times. It can rise with
/// the FIFO empty, so a service takes it as "look".
public static INT_RXFIFO_TOUT: UInt32 = 1 << 8

/// The interrupts a driver takes for the receiver: the data's two and the
/// errors'.
public static INT_RX: UInt32 = (INT_RXFIFO_FULL | INT_RXFIFO_TOUT | INT_PARITY_ERR |
                                INT_FRM_ERR | INT_RXFIFO_OVF | INT_BRK_DET)

// `STATUS`'s counts: the receive FIFO's in bits 9:0, the transmit FIFO's in
// bits 25:16.
static STATUS_COUNT_MASK: UInt32 = 0x3FF
static STATUS_TXFIFO_SHIFT: UInt32 = 16

/// The bytes in the receive FIFO, from a `STATUS` word.
public func uart_rxfifo_cnt(status: UInt32) -> UInt32 {
    status & STATUS_COUNT_MASK
}

/// The bytes in the transmit FIFO, from a `STATUS` word.
public func uart_txfifo_cnt(status: UInt32) -> UInt32 {
    (status >> STATUS_TXFIFO_SHIFT) & STATUS_COUNT_MASK
}

// `CONF1`'s fields: the receive threshold in bits 9:0, the transmit threshold
// in bits 19:10 and the receive timeout's enable at bit 23.
static CONF1_RX_FULL_MASK: UInt32 = 0x3FF
static CONF1_TX_EMPTY_SHIFT: UInt32 = 10
static CONF1_TX_EMPTY_MASK: UInt32 = 0x3FF << 10
static CONF1_RX_TOUT_EN: UInt32 = 1 << 23
// `CONF1` bits 20 to 22, which the driver clears: `DIS_RX_DAT_OVF` (set, the
// receiver's overflow is not detected), `RX_TOUT_FLOW_DIS` (set, the timeout's
// idle count stops while flow control holds the line) and `RX_FLOW_EN`
// (hardware flow control). All three are 0 at reset.
static CONF1_RX_FLOW_BITS: UInt32 = (1 << 20) | (1 << 21) | (1 << 22)

// `CONF0`'s `ERR_WR_MASK`, bit 26: set, the receiver drops a byte with a
// parity or frame error instead of storing it. The driver clears it, so a
// damaged byte is delivered and its error reported at a mark. 0 at reset.
static CONF0_ERR_WR_MASK: UInt32 = 1 << 26

// `MEM_CONF`'s receive timeout, in bit times, in bits 26:17.
static MEM_CONF_RX_TOUT_SHIFT: UInt32 = 17
static MEM_CONF_RX_TOUT_MASK: UInt32 = 0x3FF << 17

// `MEM_CONF`'s FIFO sizes, `RX_SIZE` in bits 3:1 and `TX_SIZE` in bits 6:4,
// in blocks of 128 bytes: the driver writes one block each, which is the
// reset value and the depth `UART_FIFO_BYTES` names.
static MEM_CONF_SIZE_MASK: UInt32 = (0x7 << 1) | (0x7 << 4)
static MEM_CONF_SIZES: UInt32 = (1 << 1) | (1 << 4)

/// The greatest receive threshold: the interrupt rises above it, so a full
/// FIFO's worth never would.
public static RX_FULL_MAX: UInt32 = UART_FIFO_BYTES - 1
/// The greatest transmit threshold: the interrupt rises below it.
public static TX_EMPTY_MAX: UInt32 = UART_FIFO_BYTES
/// The greatest receive timeout, the field's width, in bit times.
public static RX_TIMEOUT_MAX: UInt32 = 0x3FF

// Each word builder masks its value to its field, so a value past the field
// never spills into a neighbour (`CONF1`'s `DIS_RX_DAT_OVF` at bit 20,
// `MEM_CONF`'s `MEM_FORCE_PD` at bit 27). The checks below refuse such a
// value where it enters; the mask is what holds if one gets through.

/// `CONF0` with `ERR_WR_MASK` clear, every other bit of `old` kept.
public func uart_conf0_word(old: UInt32) -> UInt32 {
    old & ~CONF0_ERR_WR_MASK
}

/// `CONF1` with the receive threshold `rx_full`, the transmit threshold
/// `tx_empty`, the receive timeout enabled, and the overflow detection and
/// flow-control bits (20 to 22) clear, every other bit of `old` kept.
public func uart_conf1_word(old: UInt32, rx_full: UInt32, tx_empty: UInt32) -> UInt32 {
    let kept = old & ~(CONF1_RX_FULL_MASK | CONF1_TX_EMPTY_MASK | CONF1_RX_FLOW_BITS)
    kept | (rx_full & CONF1_RX_FULL_MASK) |
        ((tx_empty << CONF1_TX_EMPTY_SHIFT) & CONF1_TX_EMPTY_MASK) | CONF1_RX_TOUT_EN
}

/// `CONF1` with the transmit threshold `tx_empty`, every other bit of `old`
/// kept.
public func uart_conf1_tx_empty(old: UInt32, tx_empty: UInt32) -> UInt32 {
    (old & ~CONF1_TX_EMPTY_MASK) |
        ((tx_empty << CONF1_TX_EMPTY_SHIFT) & CONF1_TX_EMPTY_MASK)
}

/// `MEM_CONF` with the receive timeout `bits` bit times long and each FIFO
/// one block of 128 bytes, every other bit of `old` kept.
public func uart_mem_conf_word(old: UInt32, bits: UInt32) -> UInt32 {
    (old & ~(MEM_CONF_RX_TOUT_MASK | MEM_CONF_SIZE_MASK)) | MEM_CONF_SIZES |
        ((bits << MEM_CONF_RX_TOUT_SHIFT) & MEM_CONF_RX_TOUT_MASK)
}

/// `INT_ENA` for a driver that always takes the receiver's interrupts, and
/// takes the transmitter's while it has bytes to send.
public func uart_int_ena_word(transmitting: Bool) -> UInt32 {
    if transmitting { INT_RX | INT_TXFIFO_EMPTY } else { INT_RX }
}

/// Refuses a receive threshold the driver cannot use: 0, which raises the
/// interrupt at any count above 0, so no byte waits to be batched; or past
/// `RX_FULL_MAX`, above which the interrupt never rises.
public func check_rx_full(rx_full: UInt32) -> Result<Void, ConfigError> {
    if rx_full == 0 || rx_full > RX_FULL_MAX {
        return ConfigError.RxFullThreshold(value: rx_full)
    }
    return
}

/// Refuses a transmit threshold of 0, below which the interrupt never rises,
/// or past `TX_EMPTY_MAX`, a count the FIFO cannot hold.
public func check_tx_empty(tx_empty: UInt32) -> Result<Void, ConfigError> {
    if tx_empty == 0 || tx_empty > TX_EMPTY_MAX {
        return ConfigError.TxEmptyThreshold(value: tx_empty)
    }
    return
}

/// Refuses a receive timeout of 0 bit times, which would raise the timeout
/// interrupt with no idle time to wait for (`RX_TOUT_EN`, not a length of 0,
/// is what turns it off), or past `RX_TIMEOUT_MAX`, the field's width.
public func check_rx_timeout(rx_timeout_bits: UInt32) -> Result<Void, ConfigError> {
    if rx_timeout_bits == 0 || rx_timeout_bits > RX_TIMEOUT_MAX {
        return ConfigError.RxTimeout(bits: rx_timeout_bits)
    }
    return
}

/// Checks the three, in the order of the receive threshold, the transmit
/// threshold and the timeout.
public func check_uart_thresholds(rx_full: UInt32, tx_empty: UInt32,
                                  rx_timeout_bits: UInt32) -> Result<Void, ConfigError> {
    try check_rx_full(rx_full)
    try check_tx_empty(tx_empty)
    try check_rx_timeout(rx_timeout_bits)
    return
}

/// What a driver reaches UART0 through: whole words by register, and the
/// line's acknowledgement.
public trait UartPort {
    /// The word of `reg`, read from the device now. A read of `FIFO` pops
    /// the receiver, so a read is not a `&self` operation.
    func read_word(&var self, reg: UartRegister) -> UInt32
    /// Writes `word` to `reg`.
    func write_word(&var self, reg: UartRegister, word: UInt32)
    /// Acknowledges the line; false when it was refused.
    func acknowledge(&var self) -> Bool
}

/// Brings the receiver up through `port`, after `check_uart_thresholds` has
/// passed the three values, and writes nothing if it refuses them. The
/// receive interrupts' raw bits are cleared first; then `CONF0`'s
/// `ERR_WR_MASK` is cleared, so a damaged byte is stored; then the timeout's
/// length and the FIFOs' sizes (`MEM_CONF`), and the thresholds with the
/// timeout's enable and the overflow and flow-control bits clear (`CONF1`),
/// are set; then those interrupts are enabled, so a bit that bytes left in
/// the FIFO raise while it is configured is not erased. The divisor and the
/// clock are not touched, and neither is the transmit interrupt, which
/// `uart_set_tx_interrupt` turns on.
///
/// `CONF0`, `MEM_CONF` and `CONF1` are read-modify-write, so every bit of
/// each that the driver does not rely on is kept as the part left it (the
/// frame's format in `CONF0` among them); every bit it relies on is written,
/// whatever its reset value. `INT_ENA` is the driver's whole, written as
/// `uart_int_ena_word` says. The FIFOs are not reset, so bytes the console
/// stored or the terminal sent before the driver started are delivered.
public func start_uart<P: UartPort>(port: &var P, rx_full: UInt32, tx_empty: UInt32,
                                    rx_timeout_bits: UInt32) -> Result<Void, ConfigError> {
    try check_uart_thresholds(rx_full, tx_empty, rx_timeout_bits)
    port.write_word(uart_int_clr(), INT_RX)
    let conf0 = port.read_word(uart_conf0())
    port.write_word(uart_conf0(), uart_conf0_word(conf0))
    let mem = port.read_word(uart_mem_conf())
    port.write_word(uart_mem_conf(), uart_mem_conf_word(mem, rx_timeout_bits))
    let conf1 = port.read_word(uart_conf1())
    port.write_word(uart_conf1(), uart_conf1_word(conf1, rx_full, tx_empty))
    port.write_word(uart_int_ena(), uart_int_ena_word(false))
    return
}

/// Where a service puts the bytes it pops from the receiver.
public trait RxSink {
    func put(&var self, b: UInt8)
}

/// What one receive service found: the interrupts it saw (`INT_ST`'s
/// receive bits) and how many bytes it popped.
public struct RxServiced {
    status: UInt32
    popped: UInt32
}

extension RxServiced {
    /// Whether the service saw any receive interrupt.
    public func any(&self) -> Bool { self.status != 0 }
    /// Whether the receive FIFO overflowed.
    public func overflowed(&self) -> Bool { (self.status & INT_RXFIFO_OVF) != 0 }
    /// Whether a parity error was seen.
    public func parity(&self) -> Bool { (self.status & INT_PARITY_ERR) != 0 }
    /// Whether a frame error was seen.
    public func frame(&self) -> Bool { (self.status & INT_FRM_ERR) != 0 }
    /// Whether a break was seen.
    public func broke(&self) -> Bool { (self.status & INT_BRK_DET) != 0 }
}

/// The interrupts that are events, raised once for each thing that
/// happened: a byte's damage and an overflow. A level (`INT_RXFIFO_FULL`,
/// `INT_RXFIFO_TOUT`) is raised by a condition and is only ever "look".
static INT_RX_EVENTS: UInt32 = INT_PARITY_ERR | INT_FRM_ERR | INT_RXFIFO_OVF | INT_BRK_DET

/// Pops `STATUS`'s receive count of bytes into `sink`, and reads the count
/// again until it is 0, so a byte that arrives meanwhile is taken too.
/// Answers how many.
func drain_rx<P: UartPort, S: RxSink>(port: &var P, sink: &var S) -> UInt32 {
    var popped: UInt32 = 0
    var left = uart_rxfifo_cnt(port.read_word(uart_status()))
    while left > 0 {
        var i: UInt32 = 0
        while i < left {
            sink.put((port.read_word(uart_fifo()) & 0xFF) as UInt8)
            i = i + 1
        }
        popped = popped + left
        left = uart_rxfifo_cnt(port.read_word(uart_status()))
    }
    popped
}

/// The receive half of the interrupt service, through `port`: read `INT_ST`;
/// for any receive interrupt, in this order:
///
///   - store to `INT_CLR` the events it showed, before any byte is popped,
///     so an event that rises while draining stays raised and fires again,
///     and is never erased by a clear that came after it;
///   - drain the receiver to 0 (`drain_rx`);
///   - store to `INT_CLR` the levels it showed (`FULL`, `TOUT`), now that
///     the FIFO is below them, and drain once more into the same batch, for
///     the byte that arrived before the clear and that no later level would
///     report.
///
/// No bit it did not see is stored, and a clear whose set is empty is not
/// stored. A bit that rises after the `INT_ST` read is left for the next
/// service.
///
/// A timeout may be seen with the FIFO empty, which pops nothing. A service
/// that sees no receive interrupt touches no register but `INT_ST`. The
/// acknowledgement is the caller's, after every register access of the whole
/// service.
public func service_rx<P: UartPort, S: RxSink>(port: &var P, sink: &var S) -> RxServiced {
    let status = port.read_word(uart_int_st()) & INT_RX
    if status == 0 {
        return RxServiced(status: 0, popped: 0)
    }
    let events = status & INT_RX_EVENTS
    if events != 0 {
        port.write_word(uart_int_clr(), events)
    }
    var popped = drain_rx(&var port, &var sink)
    let levels = status & ~INT_RX_EVENTS
    if levels != 0 {
        port.write_word(uart_int_clr(), levels)
        popped = popped + drain_rx(&var port, &var sink)
    }
    RxServiced(status: status, popped: popped)
}

/// Where a fill takes the bytes it stores to the transmitter.
public trait TxSource {
    /// How many bytes are waiting.
    func available(&self) -> UInt32
    /// The next byte; the caller asks `available` first.
    func take(&var self) -> UInt8
}

/// Stores bytes from `source` to the transmit FIFO through `port`: as many as
/// the FIFO has room for by one read of `STATUS`, at most `cap`, at most
/// what `source` has. Answers how many it stored.
///
/// Each store is a whole-word write, and nothing reads `FIFO`, which would pop
/// the receiver. With the count read once the fill cannot overfill, because
/// nothing else stores to the FIFO while a driver serves it.
///
/// `INT_TXFIFO_EMPTY`'s raw bit sets itself again for as long as the FIFO
/// holds fewer bytes than the threshold, so a clear holds only once the FIFO
/// is above it. A driver over `uartcore` clears it before each top-up and
/// fills after, the order that loses no wakeup on a device that latches the
/// cause instead (`uartcore.device`). Here that costs one more interrupt per
/// top-up: the bit sets itself again between the clear and the fill, and the
/// interrupt it raises finds the FIFO above the threshold.
public func fill_tx<P: UartPort, S: TxSource>(port: &var P, source: &var S,
                                              cap: UInt32) -> UInt32 {
    let held = uart_txfifo_cnt(port.read_word(uart_status()))
    var room: UInt32 = 0
    if held < UART_FIFO_BYTES {
        room = UART_FIFO_BYTES - held
    }
    var n = source.available()
    if n > room { n = room }
    if n > cap { n = cap }
    var i: UInt32 = 0
    while i < n {
        port.write_word(uart_fifo(), source.take() as UInt32)
        i = i + 1
    }
    n
}

/// Turns the transmit interrupt on or off through `port`. On: its raw bit
/// cleared first, so the line rises only for the FIFO's level from now, then
/// enabled. Off: dropped from `INT_ENA` alone.
public func uart_set_tx_interrupt<P: UartPort>(port: &var P, on: Bool) {
    if on {
        port.write_word(uart_int_clr(), INT_TXFIFO_EMPTY)
    }
    port.write_word(uart_int_ena(), uart_int_ena_word(on))
}

/// Sets the transmit threshold through `port`, every other bit of `CONF1`
/// kept, and writes nothing if `check_tx_empty` refuses the value.
public func uart_set_tx_threshold<P: UartPort>(port: &var P,
                                               tx_empty: UInt32) -> Result<Void, ConfigError> {
    try check_tx_empty(tx_empty)
    let conf1 = port.read_word(uart_conf1())
    port.write_word(uart_conf1(), uart_conf1_tx_empty(conf1, tx_empty))
    return
}
