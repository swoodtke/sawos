// The counts a driver keeps hold at their greatest value, and the register
// each mode's level is read from.

import esp32s3io.{Block, PinMode, Register, count_up, count_up_16, level_register,
                  IN, IN1, OUT, OUT1}

func main() {
    assert(count_up(0) == 1, "a count goes up")
    assert(count_up(0xFFFF_FFFE) == 0xFFFF_FFFF, "to its greatest")
    assert(count_up(0xFFFF_FFFF) == 0xFFFF_FFFF, "and stays there")
    assert(count_up_16(0) == 1, "a 16-bit count goes up")
    assert(count_up_16(0xFFFE) == 0xFFFF, "to its greatest")
    assert(count_up_16(0xFFFF) == 0xFFFF, "and stays there")

    // A pin whose input is on is read at the pad; a plain output, whose input
    // is off, at the register it is driven from. Each bank has its own.
    assert(level_register(21, PinMode.InputPullUp) == Register(block: Block.Gpio, offset: IN),
           "an input reads IN")
    assert(level_register(14, PinMode.OutputLoopback) == Register(block: Block.Gpio, offset: IN),
           "a loopback reads IN")
    assert(level_register(2, PinMode.Output) == Register(block: Block.Gpio, offset: OUT),
           "a plain output reads OUT")
    assert(level_register(47, PinMode.Output) == Register(block: Block.Gpio, offset: OUT1),
           "in bank 1 too")
    assert(level_register(47, PinMode.OutputLoopback) == Register(block: Block.Gpio, offset: IN1),
           "a loopback in bank 1 reads IN1")
    assert(level_register(32, PinMode.InputFloating) == Register(block: Block.Gpio, offset: IN1),
           "pin 32 is bank 1")

    // The registers' addresses on the part, written out, each bank's own and
    // the boundary between them: pin 31 is the first bank's last, 32 the
    // second's first.
    assert(level_register(31, PinMode.Output).address() == 0x6000_4004, "pin 31 is OUT")
    assert(level_register(32, PinMode.Output).address() == 0x6000_4010, "pin 32 is OUT1")
    assert(level_register(31, PinMode.InputPullUp).address() == 0x6000_403C, "pin 31 is IN")
    assert(level_register(32, PinMode.InputPullUp).address() == 0x6000_4040, "pin 32 is IN1")
    assert(level_register(2, PinMode.Output).address() == 0x6000_4004, "OUT is at 0x004")
    assert(level_register(47, PinMode.OutputLoopback).address() == 0x6000_4040, "IN1 is at 0x040")
}
