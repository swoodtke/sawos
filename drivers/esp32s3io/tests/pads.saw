// What the GPIO interrupt service reads and writes through a driver's block:
// the interrupt status of each bank, a clear of exactly the fired bits and of
// no word without one, and the levels of each bank.

import esp32s3io.{Block, PinSet, Register, Pads, pads_clear_status, pads_levels,
                  pads_pcpu_int, IN, IN1, PCPU_INT, PCPU_INT1}

// Registers by offset with fixed words, and a record of each write.
struct Fake {
    pcpu_int: UInt32
    pcpu_int1: UInt32
    in0: UInt32
    in1: UInt32
    writes: Vector<String>
}

extension Fake: NoCopy {}

extension Fake: Pads {
    func read_word(&self, reg: Register) -> UInt32 {
        if reg.block != Block.Gpio { return 0xDEAD }
        if reg.offset == PCPU_INT { return self.pcpu_int }
        if reg.offset == PCPU_INT1 { return self.pcpu_int1 }
        if reg.offset == IN { return self.in0 }
        if reg.offset == IN1 { return self.in1 }
        0xBAD
    }

    func write_word(&var self, reg: Register, word: UInt32) {
        try! self.writes.push("{reg.address()} {word}")
    }

    func acknowledge(&var self) -> Bool { true }
}

func main() {
    var f = Fake(pcpu_int: 1 << 21, pcpu_int1: 1 << 15, in0: 1 << 3, in1: 1 << 4,
                 writes: Vector<String>())
    assert(pads_pcpu_int(&f) == PinSet(low: 1 << 21, high: 1 << 15),
           "each bank's status is its own register")
    assert(pads_levels(&f) == PinSet(low: 1 << 3, high: 1 << 4),
           "each bank's levels are its own register")

    // Both banks fired: each bank's clear goes to its own register, with
    // exactly the fired bits.
    pads_clear_status(&var f, PinSet(low: 1 << 21, high: 1 << 15))
    let both = f.writes.join(", ")
    if not both.equals("1610629196 2097152, 1610629208 32768") {
        print("writes: {both}")
    }
    assert(both.equals("1610629196 2097152, 1610629208 32768"),
           "STATUS_W1TC then STATUS1_W1TC, the fired bits")

    // A bank with nothing fired is not written.
    var low = Fake(pcpu_int: 0, pcpu_int1: 0, in0: 0, in1: 0, writes: Vector<String>())
    pads_clear_status(&var low, PinSet(low: 1 << 2, high: 0))
    assert(low.writes.len() == 1, "bank 0 alone: one write")
    var high = Fake(pcpu_int: 0, pcpu_int1: 0, in0: 0, in1: 0, writes: Vector<String>())
    pads_clear_status(&var high, PinSet(low: 0, high: 1 << 2))
    assert(high.writes.len() == 1, "bank 1 alone: one write")
    var none = Fake(pcpu_int: 0, pcpu_int1: 0, in0: 0, in1: 0, writes: Vector<String>())
    pads_clear_status(&var none, PinSet.empty())
    assert(none.writes.len() == 0, "nothing fired: no write")
}
