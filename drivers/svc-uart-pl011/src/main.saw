// The UART as a service, on the board whose console is a PL011.
//
// This is `child-echo-pl011` with a server face; the device half is the same
// register block, enable bit and drain, with the `IoMemory` arriving by `give`
// and mapped by this process. What differs is who the bytes are for: this
// driver answers them to whoever asked, over a pipe, through a protocol its
// clients compile against (`uartproto`).
//
// The loop is a completion-queue server: the outlet is given to the Waiter (a
// consuming, persistent attach), so this process holds no endpoint handle and
// every request arrives through `wait`, with the obligation to answer it minted
// at the delivery. There is no `take` in this file.
//
// A delivery is one of four things, each an arm of one dispatch:
//
//   Message      a request. `Read` is answered from the input buffer, or held,
//                or answered `Busy` while `MAX_HELD` are held; `Write` goes
//                out the transmitter and is answered `Ok`; `Sync` and `Mark`
//                are answered `Ok`; `Pending` is answered with the count of
//                buffered bytes; a request `uartproto` refuses is answered
//                `BadOp`.
//   Interrupt    the device has bytes. Drain, ack, then answer as many held
//                reads as there are bytes for.
//   Abandoned    a client dropped its claim on a read this driver is holding.
//                The obligation is discarded and the loop goes on, so one dead
//                read cannot wedge the driver (`uart-cancel` checks this).
//   Readable     the terminal level: every inlet is gone, so no request can
//                arrive again and the loop ends.
//
// A held read is why this is a driver and not an echo program. A client that
// reads a UART wants to block until a byte exists, and no kernel op knows what
// a UART is. The client spends a fused `Call` and parks; this driver keeps the
// obligation, watching it for abandonment (spec §2.1's opt-in early notice)
// with a one-shot attach; the IRQ is what eventually makes an answer possible.
//
// It is written with `main`: `sosmain`'s start-up adopts its System, derives
// its Process and drains its boot set, from which `main` takes the window, the
// server end and the line by tag. When it serves an image's console it has no
// console record, so its own lines go through the debug print.
//
// Nothing is printed until the loop is over. Every printed byte is one syscall
// through the debug seam and this file reports an exact trap count, so a line
// inside the measured window would change the number it measures.

import sos.{BootSet, IoMemory, Interrupt, Waiter, WaitResult, WaitPayload,
            PipeOutlet, PipeRequest, PipeMsg, AttachMode, ReplyWaitError,
            SosStatus, PIPE_BODY_BYTES}
import uartproto.{UartOp, UartStatus, UartBody, Frame, BODY_BYTES, InBuf}
import sosmain

static_assert(BODY_BYTES == PIPE_BODY_BYTES, "the wire's body is the kernel's")

// =============================================================================
// The board
// =============================================================================

/// The console UART's register page, the window this driver is handed. SOS does
/// not translate (spec §5.5), so a mapped window is where the hardware is,
/// whoever handed it over.
static UART_BASE: UInt = 0x0900_0000

// =============================================================================
// The PL011, through the granted window
// =============================================================================

/// The register block. Declaration order is the layout, so the holes between
/// registers are spelled out as fields rather than computed.
struct Pl011Regs {
    dr: UInt32,              // +0x00  data
    rsr: UInt32,             // +0x04  receive status / error clear
    reserved0: UInt32,       // +0x08
    reserved1: UInt32,       // +0x0C
    reserved2: UInt32,       // +0x10
    reserved3: UInt32,       // +0x14
    fr: ReadOnly<UInt32>,    // +0x18  flags
    reserved4: UInt32,       // +0x1C
    ilpr: UInt32,            // +0x20  IrDA low-power counter
    ibrd: UInt32,            // +0x24  integer baud rate
    fbrd: UInt32,            // +0x28  fractional baud rate
    lcr_h: UInt32,           // +0x2C  line control
    cr: UInt32,              // +0x30  control
    ifls: UInt32,            // +0x34  interrupt FIFO level select
    imsc: UInt32,            // +0x38  interrupt mask set/clear
    ris: ReadOnly<UInt32>,   // +0x3C  raw interrupt status
    mis: ReadOnly<UInt32>,   // +0x40  masked interrupt status
    icr: WriteOnly<UInt32>,  // +0x44  interrupt clear
}

static_assert(sizeof<Pl011Regs>() == 0x48,
              "the PL011 register block runs to the interrupt-clear register")

/// FR bit 4: the receive FIFO is empty, so data is waiting when it is clear
/// (the opposite sense to the other profile's data-ready bit).
static FR_RX_EMPTY: UInt32 = 0x10
/// FR bit 5: the transmit FIFO is full.
static FR_TX_FULL: UInt32 = 0x20

/// IMSC bit 4: the receive interrupt.
static INT_RX: UInt32 = 0x10

/// CR: enable the device, its transmitter and its receiver.
static CR_ENABLE_RX_TX: UInt32 = 0x301

/// The driver. A safe type: only the methods reaching through `regs` carry the
/// `unsafe` effect.
struct Uart {
    regs: UnsafeMemory<Pl011Regs, Device>,
}

extension Uart {
    init(at: UInt) unsafe -> Uart {
        Uart(regs: UnsafeMemory<Pl011Regs, Device>(at))
    }

    /// Turn the device on and let it raise its line when a byte arrives.
    ///
    /// Nothing is cleared first: this chip's receive interrupt is a latch set
    /// when the FIFO level crosses the trigger, so clearing it destroys the
    /// only edge a byte that arrived before the driver existed will ever
    /// produce. This driver owns the device from reset, so there is nothing
    /// stale to clear anyway.
    func listen(&self) unsafe {
        self.regs.cr.write(CR_ENABLE_RX_TX)
        self.regs.imsc.write(INT_RX)
    }

    func has_byte(&self) unsafe -> Bool {
        (self.regs.fr.read() & FR_RX_EMPTY) == 0
    }

    /// Take the waiting byte. Reading the data register is also what lowers the
    /// device's assertion once the receiver is empty, which is why nothing
    /// writes the clear register here — a clear on the way out would race a
    /// byte that arrived since the last look.
    func take_byte(&self) unsafe -> UInt8 {
        UInt8.from(truncating: self.regs.dr.read())
    }

    func put_byte(&self, b: UInt8) unsafe {
        while (self.regs.fr.read() & FR_TX_FULL) != 0 { }
        self.regs.dr.write(b as UInt32)
    }
}

// =============================================================================
// The service's own state
// =============================================================================

/// How many reads this driver will hold at once: one per client plus slack.
static MAX_HELD: Int = 4

static_assert(MAX_HELD == 4, "the slot array below is written out at this width")

/// The pending set: the obligations this driver is holding.
///
/// A held obligation is transferable state (§2.1): the driver owns a capability
/// to answer one exchange, exactly one client is parked on it, and dropping it
/// tells that client the answer will never come. Order is by `seq` rather than
/// by position, because a slot frees in the middle whenever a client abandons,
/// and FIFO is what makes two outstanding reads answer in the order they were
/// asked.
struct Pending {
    slots: [PipeRequest?; MAX_HELD],
    seq: [UInt; MAX_HELD],
}

extension Pending: NoCopy {}

extension Pending {
    static func empty() -> Pending {
        Pending(slots: [None, None, None, None], seq: [0; MAX_HELD])
    }

    /// A slot nothing is held in, or `-1`.
    func free_slot(&self) -> Int {
        var i: Int = 0
        while i < MAX_HELD {
            if self.slots[i].is_none() { return i }
            i = i + 1
        }
        -1
    }

    /// The slot holding the oldest obligation, or `-1` when none is held.
    func oldest(&self) -> Int {
        var best: Int = -1
        var best_seq: UInt = 0
        var i: Int = 0
        while i < MAX_HELD {
            if self.slots[i].is_some() {
                if best < 0 || self.seq[i] < best_seq {
                    best = i
                    best_seq = self.seq[i]
                }
            }
            i = i + 1
        }
        best
    }

    func put(&var self, at: Int, request: PipeRequest, order: UInt) {
        self.slots[at] = move request
        self.seq[at] = order
    }

    func take(&var self, at: Int) -> PipeRequest? {
        self.slots[at].take()
    }
}

// =============================================================================
// The serve loop
// =============================================================================

/// The tags its declaration gives its records (`process.toml`).
static TAG_WINDOW: UInt = 22
static TAG_OUTLET: UInt = 23
static TAG_LINE: UInt = 24

/// The keys. Distinct words, and the pending band is a base plus the slot, so
/// an abandoned delivery says which held obligation it is about without a
/// second table.
static KEY_OUTLET: UInt = 11
static KEY_IRQ: UInt = 12
static KEY_HELD: UInt = 100

/// A status this driver can never legitimately produce, so meeting it in the
/// error channel means an assertion in this file failed rather than a call did.
static BUG: SosStatus = SosStatus.BadImage

static EXIT_OK: Int = 0
static EXIT_FAILED: Int = 1

/// What one serving run answers with.
///
/// The window splits by what the server did, not by what the client sent: an
/// answered message costs one trap and a discarded one costs two (see the check
/// in `main`).
struct Report {
    messages: Int,
    abandoned: Int,
    dropped: Int,
    returned: Int,
    window_answered: Int,
    window_discarded: Int,
    window_traps: UInt64,
}

/// What a delivery is, decided by borrowing the record: look through the place,
/// and open the record only to spend it.
static KIND_STOP: Int = 0
static KIND_MESSAGE: Int = 1
static KIND_IRQ: Int = 2
static KIND_ABANDONED: Int = 3

func kind_of(r: &WaitResult) -> Int {
    match r.what {
        case Message(_, _) -> KIND_MESSAGE,
        case Interrupt(_) -> KIND_IRQ,
        case Abandoned -> KIND_ABANDONED,
        case _ -> KIND_STOP,
    }
}

func main() -> Int {
    var set = sosmain.take_boot_set()
    // A record is a record: whether the kernel or a launcher queued it is not
    // something the receiver can tell or needs to.
    guard let window = take_window(&var set) else {
        print("SOS uartsvc drv: no IoMemory under tag {}\n", TAG_WINDOW)
        return EXIT_FAILED
    }
    // The server end arrives the same way the window does, a capability under
    // a launcher's tag, and this driver can no more name its clients than it
    // could name its device's previous owner.
    guard let outlet = take_outlet(&var set) else {
        print("SOS uartsvc drv: no PipeOutlet under tag {}\n", TAG_OUTLET)
        return EXIT_FAILED
    }
    // The line arrives the same way, an Interrupt its launcher bound and gave
    // under a tag. The object is waitable, and this handle is its one name.
    guard let irq = take_line(&var set) else {
        print("SOS uartsvc drv: no Interrupt under tag {}\n", TAG_LINE)
        return EXIT_FAILED
    }

    let done = try run(move window, move outlet, move irq) catch {
        print("SOS uartsvc drv: failed: {}\n", error)
        return EXIT_FAILED
    }

    // Every line below is outside the measured window, which `serve`'s closing
    // `stats()` closed.
    print("SOS uartsvc drv: served={} abandoned={} dropped={}\n",
          done.messages, done.abandoned, done.dropped)
    print("SOS uartsvc drv: bytes put back={}\n", done.returned)
    print("SOS uartsvc drv: after the mark answered={} discarded={} traps={}\n",
          done.window_answered, done.window_discarded, done.window_traps)
    // A wrapped binary expression is two statements in Saw, so the arithmetic
    // is parenthesised as one.
    let want = ((done.window_answered as UInt64)
                + 2 * (done.window_discarded as UInt64)
                + 1)
    if done.window_traps == want {
        // The completion-queue server costs one trap per message this driver
        // answers: `reply_wait` discharges the obligation and parks for the
        // next in one op.
        //
        // A tell costs two. `Write` is post-then-drop at the client, so the
        // `Ok` it is answered does not land: `reply_wait` on an abandoned
        // claim answers `Err(Reply(...))` without parking, and the loop then
        // waits afresh. The obligation is discharged either way, and there is
        // no cheaper spelling: releasing it unanswered is a syscall too.
        //
        // The `+ 1` is the closing `stats()` read, charged at trap entry before
        // it answers.
        print("SOS uartsvc drv: one trap per answered message, two per discarded\n")
    }
    EXIT_OK
}

/// The device's window, under `TAG_WINDOW`.
func take_window(set: &var BootSet) -> IoMemory? {
    guard var record = set.take(TAG_WINDOW) else { return None }
    record.take_iomemory()
}

/// The connection's server end, under `TAG_OUTLET`.
func take_outlet(set: &var BootSet) -> PipeOutlet? {
    guard var record = set.take(TAG_OUTLET) else { return None }
    record.take_outlet()
}

/// The device's interrupt line, under `TAG_LINE`.
func take_line(set: &var BootSet) -> Interrupt? {
    guard var record = set.take(TAG_LINE) else { return None }
    record.take_interrupt()
}

/// Map the device, wire the Waiter, and serve until every client is gone.
///
/// One phase per function, to keep each frame small.
func run(window: IoMemory, outlet: PipeOutlet,
         irq: Interrupt) -> Result<Report, SosStatus> {
    let _mapping = try sosmain.context().process().map(iomemory: &window)
    let waiter = try sosmain.context().process().waiter_create()
    try waiter.add(&irq, KEY_IRQ)

    // The consuming, persistent attach: `give` rather than `add`, so the
    // wrapper goes in by move and the attachment owns the server end from here
    // on. This process holds no outlet handle to call `take` through.
    // Persistent, because this subscription serves every message on the
    // connection and one terminal delivery after them.
    try waiter.give(outlet: move outlet, key: KEY_OUTLET,
                    mode: AttachMode.Persistent) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }

    let uart = Uart(at: UART_BASE)
    uart.listen()

    let done = try serve(&waiter, &uart, &irq)
    let _ = move window
    return move done
}

/// The measured window: open from the first `Mark` to the loop's end, and what
/// the server did inside it.
struct Window {
    marked: Bool,
    syscalls: UInt64,
    answered: Int,
    discarded: Int,
}

extension Window {
    static func closed() -> Window {
        Window(marked: false, syscalls: 0, answered: 0, discarded: 0)
    }

    /// Opens the window at `syscalls`, the trap count the first `Mark` read.
    func open(&var self, syscalls: UInt64) {
        self.marked = true
        self.syscalls = syscalls
    }

    func answered_one(&var self) {
        if self.marked { self.answered += 1 }
    }

    func discarded_one(&var self) {
        if self.marked { self.discarded += 1 }
    }
}

/// Answers `request` with `n` bytes of `body` and waits for the next delivery,
/// in one trap when the reply lands.
///
/// A reply that does not land (the client dropped its claim, as a client
/// that tells a `Write` rather than calling it has) has discharged the
/// obligation all the same, and the loop waits afresh: one client cannot end
/// the driver.
func answer(request: PipeRequest, body: &UartBody, n: UInt, waiter: &Waiter,
            window: &var Window) -> Result<WaitResult, SosStatus> {
    var r = move request
    let next = try (move r).reply_wait(body: &body.bytes, len: n,
                                       waiter: &waiter) catch {
        match error {
            case Reply(_) -> {
                window.discarded_one()
                return waiter.wait()
            },
            case Wait(s) -> { return s },
        }
    }
    window.answered_one()
    return move next
}

/// Answers a `Read` from the buffer with `b`, as `answer` answers. A reply
/// that does not land puts `b` back at the front of the buffer, so the next
/// reader gets it, as `answer_held` does: a byte goes to a reader or is
/// counted dropped, never lost.
func answer_read(request: PipeRequest, b: UInt8, input: &var InBuf,
                 body: &var UartBody, waiter: &Waiter,
                 window: &var Window) -> Result<WaitResult, SosStatus> {
    let n = body.ok_byte(b)
    var r = move request
    let next = try (move r).reply_wait(body: &body.bytes, len: n,
                                       waiter: &waiter) catch {
        match error {
            case Reply(_) -> {
                input.unpush(b)
                window.discarded_one()
                return waiter.wait()
            },
            case Wait(s) -> { return s },
        }
    }
    window.answered_one()
    return move next
}

/// The measured loop. One `wait` opens it, then one op per delivery.
func serve(waiter: &Waiter, uart: &Uart,
           irq: &Interrupt) -> Result<Report, SosStatus> {
    var held = Pending.empty()
    var input = InBuf.empty()
    var body = UartBody.empty()

    var messages: Int = 0
    var abandoned: Int = 0
    var order: UInt = 0
    var window = Window.closed()

    var wake = try waiter.wait()
    var serving = true
    while serving {
        let kind = kind_of(&wake)
        let key = wake.key
        if kind == KIND_STOP {
            serving = false
        } else if kind == KIND_IRQ {
            // Every device read happens before the ack (spec §9's release
            // rule). After the ack the line is live again, so a register read
            // moved below it would race the next byte.
            drain_device(&uart, &var input)
            try irq.ack()
            // Then answer as many held reads as there are bytes for. These are
            // ordinary `reply` ops on obligations this driver has been keeping;
            // the clients behind them have been parked since they asked.
            try answer_held(&var held, &var input, &var body)
            wake = try waiter.wait()
        } else if kind == KIND_ABANDONED {
            // The cancellation arrives as a level (§2.1's opt-in early notice).
            // A client dropped its claim, so the read it was owed is discarded
            // and the loop goes on to the next request, which is what
            // `uart-cancel` shows. The one-shot attachment detached at this
            // delivery, so nothing has to be removed.
            if key >= KEY_HELD {
                let slot = (key - KEY_HELD) as Int
                if slot < MAX_HELD {
                    let _ = held.take(slot)
                    abandoned = abandoned + 1
                }
            }
            wake = try waiter.wait()
        } else {
            messages = messages + 1
            // Open the record, then match the owned payload. `open` consumes
            // the wake and hands back its key and payload by value, which is
            // the form an arm may move out of.
            let (_, what) = (move wake).open()
            match what {
                case Message(m, r) -> {
                    // The bytes are copied out and the message dropped, so
                    // whatever handles it carried are released first.
                    let frame = Frame(len: m.len, bytes: m.bytes)
                    let _ = move m
                    var obligation = move r
                    guard let op = frame.request() else {
                        // A request the protocol refuses is answered `BadOp`
                        // and the loop goes on: a server a client can end by
                        // sending nonsense is not a server.
                        let n = body.refuse(UartStatus.BadOp)
                        wake = try answer(move obligation, &body, n, &waiter,
                                          &var window)
                        continue
                    }
                    match op {
                        case Read -> {
                            if input.has() {
                                let b = input.pop()
                                wake = try answer_read(move obligation, b,
                                                       &var input, &var body,
                                                       &waiter, &var window)
                            } else {
                                // Hold it. The client is parked in its own
                                // `Call`; this driver owns the obligation until
                                // a byte exists or the client gives up, and the
                                // one-shot attach makes the second of those a
                                // delivery rather than a discovery.
                                let slot = held.free_slot()
                                if slot < 0 {
                                    // More outstanding reads than this driver
                                    // will hold: answered `Busy`, and the
                                    // client may ask again.
                                    let n = body.refuse(UartStatus.Busy)
                                    wake = try answer(move obligation, &body, n,
                                                      &waiter, &var window)
                                } else {
                                    try waiter.add(request: &obligation,
                                                   key: KEY_HELD + (slot as UInt),
                                                   mode: AttachMode.OneShot)
                                    held.put(at: slot, request: move obligation,
                                             order: order)
                                    order = order + 1
                                    wake = try waiter.wait()
                                }
                            }
                        },
                        case Write -> {
                            write_out(&uart, &frame)
                            let n = body.ok()
                            wake = try answer(move obligation, &body, n,
                                              &waiter, &var window)
                        },
                        case Pending -> {
                            let n = body.ok_byte(input.count as UInt8)
                            wake = try answer(move obligation, &body, n,
                                              &waiter, &var window)
                        },
                        case Sync -> {
                            let n = body.ok()
                            wake = try answer(move obligation, &body, n,
                                              &waiter, &var window)
                        },
                        case Mark -> {
                            // The mark is the window's first answered
                            // message: `answer` discharges it and parks for
                            // the next.
                            if not window.marked {
                                let now = try sosmain.context().process().stats()
                                window.open(now.syscalls)
                            }
                            let n = body.ok()
                            wake = try answer(move obligation, &body, n,
                                              &waiter, &var window)
                        },
                    }
                },
                // Unreachable: `kind_of` established the tag one branch up and
                // nothing runs between the two.
                case _ -> { return BUG },
            }
        }
    }

    let after = try sosmain.context().process().stats()
    var traps: UInt64 = 0
    if window.marked && after.syscalls >= window.syscalls {
        traps = after.syscalls - window.syscalls
    }
    return Report(messages: messages, abandoned: abandoned,
                  dropped: input.dropped, returned: input.returned,
                  window_answered: window.answered,
                  window_discarded: window.discarded, window_traps: traps)
}

/// Empty the receiver into the buffer. This is the only device read in the
/// loop.
func drain_device(uart: &Uart, into: &var InBuf) {
    while uart.has_byte() {
        into.push(uart.take_byte())
    }
}

/// Put a `Write` request's payload out the transmitter.
func write_out(uart: &Uart, frame: &Frame) {
    var i: Int = 0
    let n = frame.payload_len() as Int
    while i < n {
        uart.put_byte(frame.payload_byte(i))
        i = i + 1
    }
}

/// Answer as many held reads as there are buffered bytes for, oldest first.
///
/// The order is the routing proof. Two clients with reads outstanding are two
/// obligations in this set, and each `reply` names one of them, so the answer
/// lands at the claim that asked for it with no correlation the protocol has to
/// carry.
///
/// A reply that answers `PeerClosed` is not a failure here. A client may drop
/// its claim between the level that would have told this driver and this line;
/// the obligation is discharged either way (§2.1) and the byte goes back on the
/// front of the buffer so the next reader gets it. A driver that died of that
/// would be a driver one client could end.
func answer_held(held: &var Pending, input: &var InBuf,
                 body: &var UartBody) -> Result<Void, SosStatus> {
    var going = true
    while going {
        if not input.has() {
            going = false
        } else {
            let slot = held.oldest()
            if slot < 0 {
                going = false
            } else {
                guard let request = held.take(slot) else { return BUG }
                let b = input.pop()
                let n = body.ok_byte(b)
                match (move request).reply(body: &body.bytes, len: n) {
                    case Ok(_) -> {},
                    case Err(_) -> { input.unpush(b) },
                }
            }
        }
    }
    return
}
