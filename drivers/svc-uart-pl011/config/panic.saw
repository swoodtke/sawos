//! `svc-uart-pl011` built to die holding the console claim: it panics once
//! it has served three messages, with the transmitter busy. Every key of
//! `default.saw`.

public static TX_RING_BYTES: Int = 1024
public static RX_RING_BYTES: Int = 256
public static MAX_HELD_READS: Int = 4
public static MAX_SYNCS: Int = 4
public static PANIC_AFTER: Int = 3
