//! `svc-uart-pl011` with a transmit ring of 16 bytes, for the cases that
//! hold a `Write` larger than the ring: every key of `default.saw`.

public static TX_RING_BYTES: Int = 16
public static RX_RING_BYTES: Int = 256
public static MAX_HELD_READS: Int = 4
public static MAX_SYNCS: Int = 4
public static PANIC_AFTER: Int = 0
