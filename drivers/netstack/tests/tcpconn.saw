// TCP's connection state machine, one table driven segment by segment: each
// transition of RFC 9293's state diagram, with the segment in, the segment
// out against golden bytes and the state after; the resets, sent and
// accepted; every refusal of a segment and of a call by its reason; TIME-WAIT
// ending on the caller's clock; sequence numbers across zero; and two tables
// talking to each other through the simultaneous open and close.
//
// A is the table under test at 10.0.0.1, its connections on port 80 and its
// initial sequence number 1000. B is the peer at 10.0.0.2, port 5000, its
// initial sequence number 9000. B's segments offer a window of 8192.

import netstack.addr.{Ipv4Addr, SocketAddr}
import netstack.tcp
import netstack.tcp.{ACK, FIN, Header, RST, SYN, TcpDrop}
import netstack.tcpconn.{
    CONNECTIONS, CallError, ConnId, IsnSource, OpenError, RECEIVE_BUFFER, SegmentError,
    SegmentSink,
    State, TIME_WAIT_MS, Table, seq_le, seq_lt,
}

/// Holds `ok`, naming what failed when it does not.
func check(ok: Bool, what: String) {
    if not ok {
        print("failed: {what}")
    }
    assert(ok, what)
}

func same(a: &[UInt8], b: &[UInt8]) -> Bool {
    if a.len() != b.len() {
        return false
    }
    var i = 0
    while i < a.len() {
        if a[i] != b[i] {
            return false
        }
        i = i + 1
    }
    true
}

func ip_a() -> Ipv4Addr { Ipv4Addr(a: 10, b: 0, c: 0, d: 1) }
func ip_b() -> Ipv4Addr { Ipv4Addr(a: 10, b: 0, c: 0, d: 2) }
func end_a() -> SocketAddr { SocketAddr(addr: ip_a(), port: 80) }
func end_b() -> SocketAddr { SocketAddr(addr: ip_b(), port: 5000) }

// -----------------------------------------------------------------------------
// Golden bytes: what A sends B
// -----------------------------------------------------------------------------

/// A's SYN: seq 1000, window 4096, MSS 1460. Checksum 0x5C64.
static A_SYN: [UInt8; 24] = [
    0x00, 0x50, 0x13, 0x88, 0x00, 0x00, 0x03, 0xE8, 0x00, 0x00, 0x00, 0x00,
    0x60, 0x02, 0x10, 0x00, 0x5C, 0x64, 0x00, 0x00, 0x02, 0x04, 0x05, 0xB4,
]

