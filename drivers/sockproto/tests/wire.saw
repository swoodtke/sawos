// The sockets wire: each op and status value written out; each builder's
// bytes; every request and reply built, decoded and compared with what was
// built; each malformed message refused by name, with the status a stack
// answers it; and a datagram's header in its slot, across the ring.

import sockproto.{ADDR_BYTES, Accepted, BODY_BYTES, DATAGRAM_HEADER_BYTES, Datagram, Frame,
                  InterfaceStatus, MAC_BYTES, MAX_NAME_BYTES, MAX_SOCKETS, Name, Opened,
                  RingCounts, SLOT_BYTES, SockBody, SockError, SockOp, SockRequest,
                  SockStatus, WireError, accepted_reply, attach_reply, datagram, empty_reply,
                  if_status_reply, layout, listening_reply, opened_reply,
                  put_datagram_header, received_reply, resolved_reply}
import pktring.{Endpoint, Ring, SharedWindow, SlotRange}

/// Holds `ok`, naming what failed when it does not.
func check(ok: Bool, what: String) {
    if not ok {
        print("failed: {what}")
    }
    assert(ok, what)
}

func frame(body: &SockBody, len: UInt) -> Frame {
    try! Frame(len: len, body: body.bytes)
}

func message(len: UInt, first: UInt8, fill: UInt8) -> Frame {
    var b: [UInt8; BODY_BYTES] = [fill; BODY_BYTES]
    b[0] = first
    try! Frame(len: len, body: b)
}

/// `f` with byte `at` set to `b`.
func with(f: &Frame, at: Int, b: UInt8) -> Frame {
    var body = f.bytes()
    body[at] = b
    try! Frame(len: f.len(), body: body)
}

func request_is(f: &Frame, want: SockRequest) -> Bool {
    match f.request() {
        case Ok(got) -> got == want,
        case Err(_) -> false,
    }
}

func refused(f: &Frame, want: WireError) -> Bool {
    match f.request() {
        case Ok(_) -> false,
        case Err(e) -> e == want,
    }
}

func is_err<V>(r: Result<V, SockError>, want: SockError) -> Bool {
    match r {
        case Ok(_) -> false,
        case Err(e) -> e == want,
    }
}

func malformed(why: WireError) -> SockError {
    SockError.Malformed(why)
}

func ip(a: UInt8, b: UInt8, c: UInt8, d: UInt8) -> [UInt8; 4] {
    [a, b, c, d]
}

func name(text: String) -> Name {
    try! Name(text: text)
}

func repeat(c: String, n: Int) -> String {
    var s = ""
    var i = 0
    while i < n {
        s = "{s}{c}"
        i = i + 1
    }
    s
}

func numbers() {
    check(SockOp.Attach as UInt8 == 1 && SockOp.UdpOpen as UInt8 == 2 &&
          SockOp.TcpConnect as UInt8 == 3 && SockOp.TcpListen as UInt8 == 4 &&
          SockOp.Accept as UInt8 == 5 && SockOp.Send as UInt8 == 6 &&
          SockOp.Recv as UInt8 == 7 && SockOp.Close as UInt8 == 8 &&
          SockOp.Resolve as UInt8 == 9 && SockOp.IfStatus as UInt8 == 10, "the op numbers")
    check(SockStatus.Ok as UInt8 == 0 && SockStatus.BadOp as UInt8 == 1 &&
          SockStatus.BadArg as UInt8 == 2 && SockStatus.NotAttached as UInt8 == 3 &&
          SockStatus.Attached as UInt8 == 4 && SockStatus.NoSocket as UInt8 == 5 &&
          SockStatus.WrongKind as UInt8 == 6 && SockStatus.InUse as UInt8 == 7 &&
          SockStatus.NoRoom as UInt8 == 8 && SockStatus.Refused as UInt8 == 9 &&
          SockStatus.Unreachable as UInt8 == 10 && SockStatus.TimedOut as UInt8 == 11 &&
          SockStatus.Ended as UInt8 == 12 && SockStatus.NotFound as UInt8 == 13 &&
          SockStatus.Busy as UInt8 == 14 && SockStatus.Down as UInt8 == 15,
          "the status numbers")
    check(SockStatus.from(raw: 16).is_none() && SockOp.from(raw: 11).is_none() &&
          SockOp.from(raw: 0).is_none(), "no status 16, no op 0 or 11")
    check(BODY_BYTES == 128 && SLOT_BYTES == 2048 && MAX_SOCKETS == 16 && ADDR_BYTES == 4 &&
          MAC_BYTES == 6 && MAX_NAME_BYTES == 126 && DATAGRAM_HEADER_BYTES == 6, "the sizes")
    check(SockOp.TcpConnect.describe().equals("tcp_connect") &&
          SockOp.IfStatus.describe().equals("if_status") &&
          SockStatus.Ended.describe().equals("Ended") &&
          SockStatus.WrongKind.describe().equals("WrongKind"), "names")
    let l = try! layout(4, 8)
    check(l.slot_bytes() == 2048 && l.slots(Ring.ToServer) == 4 && l.slots(Ring.ToClient) == 8,
          "a sockets ring")

    // Request bytes.
    var b = SockBody.empty()
    check(b.attach(2, 0x0102) == 5 && b.bytes[0] == 1 && b.bytes[1] == 2 && b.bytes[3] == 2 &&
          b.bytes[4] == 1, "Attach")
    check(b.udp_open(0x1234) == 3 && b.bytes[0] == 2 && b.bytes[1] == 0x34 &&
          b.bytes[2] == 0x12, "UdpOpen")
    check(b.tcp_connect(&ip(10, 0, 2, 2), 80) == 7 && b.bytes[0] == 3 && b.bytes[1] == 10 &&
          b.bytes[4] == 2 && b.bytes[5] == 80 && b.bytes[6] == 0, "TcpConnect")
    check(b.tcp_listen(7) == 3 && b.bytes[0] == 4 && b.bytes[1] == 7, "TcpListen")
    check(b.accept(3) == 2 && b.bytes[0] == 5 && b.bytes[1] == 3, "Accept")
    check(b.send(4, SlotRange(first: 0x0102, count: 3)) == 6 && b.bytes[0] == 6 &&
          b.bytes[1] == 4 && b.bytes[2] == 2 && b.bytes[3] == 1 && b.bytes[4] == 3, "Send")
    check(b.recv(5) == 2 && b.bytes[0] == 7 && b.bytes[1] == 5, "Recv")
    check(b.close(6) == 2 && b.bytes[0] == 8 && b.bytes[1] == 6, "Close")
    check(b.resolve(&name("a.b")) == 5 && b.bytes[0] == 9 && b.bytes[1] == 3 &&
          b.bytes[2] == 0x61 && b.bytes[4] == 0x62, "Resolve")
    check(b.if_status() == 1 && b.bytes[0] == 10, "IfStatus")
    check(b.raw(0x77, 0) == 1 && b.bytes[0] == 0x77, "a raw request")
}

func requests() {
    var b = SockBody.empty()
    var n = b.attach(1, 256)
    check(request_is(&frame(&b, n), SockRequest.Attach(1, 256)), "Attach round trip")
    n = b.udp_open(0)
    check(request_is(&frame(&b, n), SockRequest.UdpOpen(0)), "UdpOpen of any port")
    n = b.tcp_connect(&ip(192, 168, 1, 1), 443)
    check(request_is(&frame(&b, n), SockRequest.TcpConnect([192, 168, 1, 1], 443)),
          "TcpConnect round trip")
    n = b.tcp_connect(&ip(0, 0, 0, 1), 1)
    check(request_is(&frame(&b, n), SockRequest.TcpConnect([0, 0, 0, 1], 1)),
          "TcpConnect at the low ends")
    n = b.tcp_listen(0xFFFF)
    check(request_is(&frame(&b, n), SockRequest.TcpListen(0xFFFF)), "TcpListen round trip")
    n = b.accept(15)
    check(request_is(&frame(&b, n), SockRequest.Accept(15)), "Accept of the last id")
    n = b.send(0, SlotRange(first: 255, count: 256))
    check(request_is(&frame(&b, n), SockRequest.Send(0, SlotRange(first: 255, count: 256))),
          "Send round trip")
    n = b.recv(1)
    check(request_is(&frame(&b, n), SockRequest.Recv(1)), "Recv round trip")
    n = b.close(2)
    check(request_is(&frame(&b, n), SockRequest.Close(2)), "Close round trip")
    let host = name("example.com")
    n = b.resolve(&host)
    check(request_is(&frame(&b, n), SockRequest.Resolve(host)), "Resolve round trip")
    let longest = name(repeat("n", MAX_NAME_BYTES))
    n = b.resolve(&longest)
    check(n == 128 && request_is(&frame(&b, n), SockRequest.Resolve(longest)),
          "the longest name fills the body")
    n = b.if_status()
    check(request_is(&frame(&b, n), SockRequest.IfStatus), "IfStatus round trip")

    // Each malformed request, by name.
    check(refused(&message(0, 1, 0), WireError.NoBytes), "no bytes")
    check(refused(&message(1, 0, 0), WireError.UnknownOp(0)), "op 0")
    check(refused(&message(1, 11, 0), WireError.UnknownOp(11)), "op 11")
    check(refused(&message(4, 1, 1), WireError.Length(4)), "Attach short")
    check(refused(&message(4, 2, 1), WireError.Length(4)), "UdpOpen long")
    check(refused(&message(6, 3, 1), WireError.Length(6)), "TcpConnect short")
    check(refused(&message(2, 4, 1), WireError.Length(2)), "TcpListen short")
    check(refused(&message(1, 5, 1), WireError.Length(1)), "Accept with no id")
    check(refused(&message(7, 6, 1), WireError.Length(7)), "Send long")
    check(refused(&message(3, 7, 1), WireError.Length(3)), "Recv long")
    check(refused(&message(3, 8, 1), WireError.Length(3)), "Close long")
    check(refused(&message(2, 10, 1), WireError.Length(2)), "IfStatus with a byte")
    check(refused(&message(1, 9, 0), WireError.Length(1)), "Resolve with no length")
    n = b.resolve(&host)
    check(refused(&frame(&b, n - 1), WireError.Length(n - 1)), "Resolve cut inside its name")
    check(refused(&frame(&b, n + 1), WireError.Length(n + 1)), "Resolve past its name")
    check(refused(&message(2, 9, 0), WireError.NameLength(0)), "a name of no bytes")
    var long = message(128, 9, 0x6E)
    long = with(&long, 1, 127)
    check(refused(&long, WireError.Length(128)), "a name past the body")
    n = b.attach(0, 1)
    check(refused(&frame(&b, n), WireError.SlotCount(0)), "no ToServer slots")
    n = b.attach(1, 257)
    check(refused(&frame(&b, n), WireError.SlotCount(257)), "too many ToClient slots")
    n = b.tcp_connect(&ip(0, 0, 0, 0), 80)
    check(refused(&frame(&b, n), WireError.Addr), "a connect to no address")
    n = b.tcp_connect(&ip(1, 0, 0, 0), 80)
    check(request_is(&frame(&b, n), SockRequest.TcpConnect(ip(1, 0, 0, 0), 80)),
          "an address of its first byte")
    n = b.tcp_connect(&ip(0, 1, 0, 0), 80)
    check(request_is(&frame(&b, n), SockRequest.TcpConnect(ip(0, 1, 0, 0), 80)),
          "an address of its second byte")
    n = b.tcp_connect(&ip(0, 0, 1, 0), 80)
    check(request_is(&frame(&b, n), SockRequest.TcpConnect(ip(0, 0, 1, 0), 80)),
          "an address of its third byte")
    n = b.tcp_connect(&ip(10, 0, 0, 1), 0)
    check(refused(&frame(&b, n), WireError.Port(0)), "a connect to no port")
    n = b.tcp_listen(0)
    check(refused(&frame(&b, n), WireError.Port(0)), "a listener on no port")
    n = b.accept(16)
    check(refused(&frame(&b, n), WireError.SocketId(16)), "an Accept id past the most")
    n = b.send(16, SlotRange(first: 0, count: 1))
    check(refused(&frame(&b, n), WireError.SocketId(16)), "a Send id past the most")
    n = b.send(1, SlotRange(first: 0, count: 0))
    check(refused(&frame(&b, n), WireError.Range(0, 0)), "a Send of no slots")
    n = b.send(1, SlotRange(first: 256, count: 1))
    check(refused(&frame(&b, n), WireError.Range(256, 1)), "a Send past any ring")
    n = b.recv(255)
    check(refused(&frame(&b, n), WireError.SocketId(255)), "a Recv id past the most")
    n = b.close(16)
    check(refused(&frame(&b, n), WireError.SocketId(16)), "a Close id past the most")

    check(WireError.NoBytes.status() == SockStatus.BadOp &&
          WireError.UnknownOp(0).status() == SockStatus.BadOp &&
          WireError.Length(1).status() == SockStatus.BadOp, "a shape is BadOp")
    check(WireError.SocketId(16).status() == SockStatus.BadArg &&
          WireError.Port(0).status() == SockStatus.BadArg &&
          WireError.Addr.status() == SockStatus.BadArg &&
          WireError.NameLength(0).status() == SockStatus.BadArg &&
          WireError.Range(0, 0).status() == SockStatus.BadArg &&
          WireError.SlotCount(0).status() == SockStatus.BadArg, "a value is BadArg")
}

func replies() {
    var r = SockBody.empty()
    var n = r.ok_attach(&RingCounts(to_server: 4, to_client: 8))
    check(match attach_reply(&frame(&r, n)) {
              case Ok(got) -> got == RingCounts(to_server: 4, to_client: 8),
              case Err(_) -> false }, "an Attach answer round trip")
    n = r.ok_attach(&RingCounts(to_server: 0, to_client: 8))
    check(is_err(attach_reply(&frame(&r, n)), malformed(WireError.SlotCount(0))),
          "an Attach answer of no slots")
    n = r.ok_attach(&RingCounts(to_server: 4, to_client: 300))
    check(is_err(attach_reply(&frame(&r, n)), malformed(WireError.SlotCount(300))),
          "an Attach answer of too many slots")

    let opened = Opened(id: 15, port: 49152)
    n = r.ok_opened(&opened)
    check(match opened_reply(&frame(&r, n)) { case Ok(got) -> got == opened,
                                              case Err(_) -> false },
          "an opened answer round trip")
    n = r.ok_opened(&Opened(id: 16, port: 1))
    check(is_err(opened_reply(&frame(&r, n)), malformed(WireError.SocketId(16))),
          "an opened id past the most")
    n = r.ok_opened(&Opened(id: 1, port: 0))
    check(is_err(opened_reply(&frame(&r, n)), malformed(WireError.Port(0))),
          "an opened socket of no port")
    n = r.ok_opened(&opened)
    check(is_err(opened_reply(&frame(&r, n - 1)), malformed(WireError.Length(3))),
          "an opened answer cut short")
    n = r.refuse(SockStatus.Refused)
    check(is_err(opened_reply(&frame(&r, n)), SockError.Refused(SockStatus.Refused)),
          "a connection refused")
    n = r.refuse(SockStatus.TimedOut)
    check(is_err(opened_reply(&frame(&r, n)), SockError.Refused(SockStatus.TimedOut)),
          "a connection timed out")

    n = r.ok_listening(3)
    check(match listening_reply(&frame(&r, n)) { case Ok(id) -> id == 3, case Err(_) -> false },
          "a listening answer round trip")
    n = r.ok_listening(16)
    check(is_err(listening_reply(&frame(&r, n)), malformed(WireError.SocketId(16))),
          "a listener id past the most")
    n = r.refuse(SockStatus.InUse)
    check(is_err(listening_reply(&frame(&r, n)), SockError.Refused(SockStatus.InUse)),
          "a port in use")

    let accepted = Accepted(id: 4, addr: [10, 0, 2, 15], port: 5555)
    n = r.ok_accepted(&accepted)
    check(match accepted_reply(&frame(&r, n)) { case Ok(got) -> got == accepted,
                                                case Err(_) -> false },
          "an accepted answer round trip")
    n = r.ok_accepted(&Accepted(id: 200, addr: [1, 2, 3, 4], port: 1))
    check(is_err(accepted_reply(&frame(&r, n)), malformed(WireError.SocketId(200))),
          "an accepted id past the most")
    check(is_err(accepted_reply(&frame(&r, 9)), malformed(WireError.Length(9))),
          "an accepted answer too long")

    n = r.ok_received(SlotRange(first: 7, count: 2))
    check(match received_reply(&frame(&r, n)) {
              case Ok(got) -> got == SlotRange(first: 7, count: 2),
              case Err(_) -> false }, "a received answer round trip")
    n = r.ok_received(SlotRange(first: 0, count: 0))
    check(is_err(received_reply(&frame(&r, n)), malformed(WireError.Range(0, 0))),
          "a received answer of no slots")
    n = r.refuse(SockStatus.Ended)
    check(is_err(received_reply(&frame(&r, n)), SockError.Refused(SockStatus.Ended)),
          "a stream that ended")

    n = r.ok_resolved(&ip(93, 184, 216, 34))
    check(match resolved_reply(&frame(&r, n)) {
              case Ok(got) -> got[0] == 93 && got[1] == 184 && got[2] == 216 && got[3] == 34,
              case Err(_) -> false }, "a resolved answer round trip")
    check(is_err(resolved_reply(&frame(&r, 4)), malformed(WireError.Length(4))),
          "a resolved answer cut short")
    n = r.refuse(SockStatus.NotFound)
    check(is_err(resolved_reply(&frame(&r, n)), SockError.Refused(SockStatus.NotFound)),
          "a name not found")

    let up = InterfaceStatus(up: true, addr: [10, 0, 2, 15], netmask: [255, 255, 255, 0],
                             gateway: [10, 0, 2, 2], dns: [10, 0, 2, 3], mtu: 1500,
                             mac: [0x52, 0x54, 0, 0x12, 0x34, 0x56])
    n = r.ok_if_status(&up)
    check(n == 26 && r.bytes[1] == 1 && r.bytes[18] == 0xDC && r.bytes[19] == 0x05 &&
          r.bytes[25] == 0x56, "an IfStatus answer's bytes")
    check(match if_status_reply(&frame(&r, n)) { case Ok(got) -> got == up,
                                                 case Err(_) -> false },
          "an up IfStatus round trip")
    let down = InterfaceStatus(up: false, addr: [0; 4], netmask: [0; 4], gateway: [0; 4],
                               dns: [0; 4], mtu: 0, mac: [0; 6])
    n = r.ok_if_status(&down)
    check(match if_status_reply(&frame(&r, n)) { case Ok(got) -> got == down,
                                                 case Err(_) -> false },
          "a down IfStatus round trip")
    var flag = frame(&r, n)
    flag = with(&flag, 1, 2)
    check(is_err(if_status_reply(&flag), malformed(WireError.Flag(2))), "an up flag of 2")

    n = r.ok()
    check(match empty_reply(&frame(&r, n)) { case Ok(_) -> true, case Err(_) -> false },
          "Ok alone")
    check(is_err(empty_reply(&frame(&r, 2)), malformed(WireError.Length(2))), "Ok and a byte")
    n = r.refuse(SockStatus.NoSocket)
    check(is_err(empty_reply(&frame(&r, n)), SockError.Refused(SockStatus.NoSocket)),
          "a Close of no socket")
    check(is_err(empty_reply(&message(2, 5, 0)), malformed(WireError.Length(2))),
          "a refusal with a byte")
    check(is_err(empty_reply(&message(1, 16, 0)), malformed(WireError.UnknownStatus(16))),
          "status 16")
    check(is_err(empty_reply(&message(0, 0, 0)), malformed(WireError.NoBytes)), "no bytes")
    check("{SockError.Refused(SockStatus.Down)}".equals("refused: Down"),
          "a refusal prints its status")
    check("{malformed(WireError.Addr)}".equals("malformed: no address"),
          "a malformed reply prints why")
}

static WORDS: Int = 2048

func window(mem: &var [UInt32; WORDS], bytes: UInt) unsafe -> SharedWindow {
    SharedWindow(at: (&var mem) as UnsafePointer<UInt32>, bytes: bytes)
}

func datagrams() unsafe {
    // A datagram crosses to the stack and its header parses from the copy.
    var mem: [UInt32; WORDS] = [0; WORDS]
    let l = try! layout(1, 1)
    var app = Endpoint.client(window(&var mem, l.bytes()), l)
    var stack = Endpoint.server(window(&var mem, l.bytes()), l)
    var out: [UInt8; 2048] = [0; 2048]
    let at = put_datagram_header(&var out, &ip(10, 0, 2, 2), 53)
    check(at == 6 && out[0] == 10 && out[3] == 2 && out[4] == 53 && out[5] == 0,
          "a datagram header's bytes")
    out[6] = 0xAB
    let _ = try! app.send(&out, 7)
    let _ = try! app.publish()
    let _ = try! stack.poll()
    var got: [UInt8; 2048] = [0; 2048]
    let n = try! stack.receive(&var got)
    check(match datagram(&got, n) {
              case Ok(d) -> d == Datagram(addr: [10, 0, 2, 2], port: 53, payload_at: 6,
                                          payload_len: 1),
              case Err(_) -> false }, "a datagram crosses the ring")
    check(match datagram(&got, 6) {
              case Ok(d) -> d.payload_len == 0, case Err(_) -> false }, "an empty datagram")
    check(match datagram(&got, 5) {
              case Ok(_) -> false, case Err(e) -> e == WireError.Datagram(5) },
          "a slot shorter than a datagram's header")
    check(match datagram(&got, 0) {
              case Ok(_) -> false, case Err(e) -> e == WireError.Datagram(0) },
          "an empty slot")
    check(match datagram(&got, 2048) {
              case Ok(d) -> d.payload_len == 2042, case Err(_) -> false },
          "a datagram filling the copy")
    check(match datagram(&got, 2049) {
              case Ok(_) -> false, case Err(e) -> e == WireError.Length(2049) },
          "a length past the copy")
}

func frames() {
    // A frame is at most a body.
    let body: [UInt8; BODY_BYTES] = [7; BODY_BYTES]
    check(match Frame(len: 128, body: body) { case Ok(f) -> f.len() == 128 && f.bytes()[127] == 7,
                                              case Err(_) -> false }, "a whole body")
    check(match Frame(len: 129, body: body) { case Ok(_) -> false,
                                              case Err(e) -> e == WireError.Length(129) },
          "a frame past the body")
}

func names() {
    // A name is one byte to MAX_NAME_BYTES.
    check(match Name(text: "") { case Ok(_) -> false,
                                 case Err(e) -> e == WireError.NameLength(0) }, "no name")
    check(match Name(text: repeat("n", MAX_NAME_BYTES + 1)) {
              case Ok(_) -> false, case Err(e) -> e == WireError.NameLength(127) },
          "a name past the most")
    let one = name("n")
    check(one.len() == 1 && one.bytes()[0] == 0x6E && one.bytes()[1] == 0, "a name of one")
}

func main() {
    frames()
    names()
    numbers()
    requests()
    replies()
    datagrams()
}
