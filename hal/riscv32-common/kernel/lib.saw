//! `rv32core`: the architectural half of the riscv32 kernel HAL, shared by
//! every riscv32 board.
//!
//! Everything here is true of the ISA, not of a board: the trap frame's shape,
//! the cause decoding, the syscall accessors, the PMP staging apparatus, the
//! payload/region linker seams, and the protection budget those imply.
//!
//! This module is not `hal`. `kernel/core` imports the module named `hal`, and
//! the runner maps `hal=<board>/kernel` per build; a board's `hal` module
//! `public import`s from here and re-exports what `kcore` consumes. See
//! `../README.md` for the file map and the rule that decides which side a
//! declaration belongs on.
//!
//! The board side keeps the console device and the two runtime hooks over it,
//! how the machine stops, the timer, the interrupt controller, the memory map
//! (`RAM_BASE`/`RAM_TOP`, root's region, the device window), and the
//! interrupt-class shadow (`irq_class_enable` writes a different register on
//! each board).
//!
//! Addresses and machine words are `UInt` throughout, never `Int`. On this
//! target `Int` is 32-bit signed, so a RAM address like 0x8020_0000 lands in
//! its negative half.

// The image-format registry, for this profile's arch tag. Only the arch tag is
// imported: this profile installs a segment's permission mask untranslated
// (the format numbers its bits to match a PMP config), so unlike the arm64 HAL
// there is no `SegFlag` case to name in code.
import imgformat.{SosimgArch}

// =============================================================================
// Privilege, protection and payload seams (boot.S / sink.c)
// =============================================================================

// The native seams this module calls: the first entry into user mode
// (`sos_resume_frame`, in `trap.S`), two CSR writers and two linker-symbol
// pairs (in `sink.c`). What a PMP region means is staged in Saw below; C only
// places a word in a numbered register, because a `csrw` names its CSR in the
// instruction. `sink.c` says at each of its leaves why it is native.
//
// The block is split by caller. An `extern` declaration carries no visibility
// and cannot be re-exported, so the seams this module calls are declared here
// and the leaves a board calls (`sos_mie_write`, and on virt
// `sos_wait_for_irq`) are declared in that board's own file. Within one build
// each C symbol has exactly one declaring module.
extern "C" {
    func sos_resume_frame(frame_addr: UInt)
    func sos_pmpaddr_write(index: UInt, value: UInt)
    func sos_pmpcfg_write(w0: UInt, w1: UInt, w2: UInt, w3: UInt)
    func sos_payload_start() -> UInt
    func sos_payload_end() -> UInt
    func sos_region_table_start() -> UInt
    func sos_region_table_end() -> UInt
}

// =============================================================================
// Identity
// =============================================================================

/// This profile's `sosimg` arch tag. A process image built for the other
/// profile is refused by the loader rather than jumped into.
///
/// It reads the tag out of `imgformat`'s registry rather than repeating the
/// number, so the two cannot drift — a HAL claiming a tag the format does not
/// define is not expressible.
///
/// Architectural, not per board: the tag names the ISA an image was built for,
/// and every riscv32 board shares it.
public func arch_tag() -> UInt8 {
    SosimgArch.Riscv32.tag()
}

// =============================================================================
// The trap frame
// =============================================================================

/// The context `trap.S` saves on a trap from U-mode: 32 words, where word `i`
/// holds register `x<i>` and word 0 (the slot `x0` would occupy) holds `mepc`.
/// Declaration order is the layout, so the field offsets here and the
/// `sw x<i>, i*4(sp)` stores in `trap.S` are one description.
struct TrapFrame {
    mepc: UInt,             // word 0  (x0 never needs saving)
    ra: UInt,               // x1
    sp: UInt,               // x2
    gp: UInt,               // x3
    tp: UInt,               // x4
    t0: UInt,               // x5
    t1: UInt,               // x6
    t2: UInt,               // x7
    s0: UInt,               // x8
    s1: UInt,               // x9
    a0: UInt,               // x10  syscall handle / status out
    a1: UInt,               // x11  syscall arg 0 / value out
    a2: UInt,               // x12  syscall arg 1
    a3: UInt,               // x13  syscall arg 2
    a4: UInt,               // x14
    a5: UInt,               // x15
    a6: UInt,               // x16
    a7: UInt,               // x17  syscall op
    s2: UInt,               // x18
    s3: UInt,               // x19
    s4: UInt,               // x20
    s5: UInt,               // x21
    s6: UInt,               // x22
    s7: UInt,               // x23
    s8: UInt,               // x24
    s9: UInt,               // x25
    s10: UInt,              // x26
    s11: UInt,              // x27
    t3: UInt,               // x28
    t4: UInt,               // x29
    t5: UInt,               // x30
    t6: UInt,               // x31
}

/// Bytes in one saved context.
///
/// Public because the kernel reserves a slot per thread and has to know this
/// fits: a trap frame is a thread's context, so the kernel owns the storage and
/// the HAL owns the layout. The assert below keeps the number honest on this
/// side; the kernel's own assert keeps its stride honest on that side.
public static FRAME_BYTES: Int = 128

/// Words in a frame, for `frame_init`'s zeroing loop.
static FRAME_WORDS: UInt = 32

// The frame `trap.S` writes must be the frame this file describes. A field
// added on one side and not the other would misread every register after it.
// (The arm64 HAL pins its own the same way.)
static_assert(sizeof<TrapFrame>() == FRAME_BYTES, "the riscv32 trap frame is 32 words")

// =============================================================================
// The linear-map seam
// =============================================================================
//
// Addresses held as data stay physical everywhere in the kernel (grant rows,
// sosimg records, boot-handle records, region tables, Memory and IoMemory
// capabilities, fault report words); only the moment of kernel dereference
// converts. On this tier the two are the same number: the machine has no MMU,
// so a physical address is the address the kernel loads and stores through,
// and both bodies below are the identity.
//
// `kernel/core` spells one sequence for both tiers, `phys_to_virt` at every
// site where a stored physical address becomes a dereference. Here every such
// call folds away to its argument. The arm64 HAL's bodies are an OR and an AND.
//
// An Sv32 kernel on the virt board would not change this: its RAM sits at
// 0x8000_0000, already in the upper 2 GiB of the 32-bit address space, so the
// seam would stay the identity.

/// A physical address as the kernel must spell it to dereference it. Identity
/// here: this machine translates nothing.
public func phys_to_virt(pa: UInt) -> UInt {
    pa
}

/// The inverse: a kernel dereference address back to the physical address that
/// names it everywhere else. Identity here, for the same reason.
public func virt_to_phys(va: UInt) -> UInt {
    va
}

// =============================================================================
// Placement: identity is the tier-2 answer
// =============================================================================
//
// An address is the same number in every process on this tier, and the bodies
// below are the identity because that is the answer, not because they are
// stubs.
//
// Each process therefore links at its own base, since two images at one
// address cannot both be resident. A board on this tier keeps one linker script
// per resident image (`child.ld`, `child2.ld`, `child3.ld`), while the arm64
// board uses one script whatever the process count.

/// The virtual base an image loading at physical `dest_base` is linked at.
///
/// `dest_base` itself. There is no translation on this machine, so an image's
/// link base and its destination frames are one number; a linker script that
/// said otherwise would produce a program that runs nowhere.
public func image_link_base(dest_base: UInt) -> UInt {
    dest_base
}

/// Where a `map` of physical `pa` lands in a process whose map cursor stands at
/// `cursor`.
///
/// At `pa`. The cursor is the translating tier's instrument and is ignored
/// here; the kernel keeps one per process on both tiers because it is arch-free
/// bookkeeping. `map` takes no VA hint on this tier either.
public func map_place(cursor: UInt, pa: UInt, device: Bool) -> UInt {
    pa
}

// =============================================================================
// The protection budget
// =============================================================================

/// This target's protection granularity. PMP stores its bounds shifted right by
/// two, so a region bound is rounded to four bytes.
public static PROT_GRAIN: UInt = 4

/// How many segments a root image may ask for. One PMP region per segment plus
/// one for the stack, out of the `PMP_REGIONS` this HAL programs (below in this
/// file; `sink.c` only places words in numbered registers).
///
/// Whatever an image does not spend is headroom that `map()` draws on for rows
/// installed at run time.
public static MAX_ROOT_SEGMENTS: UInt = 7

/// How many protection rows one process's domain may hold on this profile: the
/// number `MemoryOp.Map` checks a target's `grant_count` against.
///
/// On this profile it is the physical wall. A row is a numbered hardware region
/// and there are exactly this many, so a map that meets it is a map the machine
/// cannot install (`NoResource`, which the caller could not have known). The
/// other profile's budget is a policy number of the same name and meaning to
/// the caller, which is why the kernel reads the HAL's number rather than a
/// shared constant.
///
/// The quota is the policy cap layered above this one. A `map()` meeting the
/// physical wall with quota headroom left is a kernel bug to assert against:
/// every process's mapping row is clamped to the rows it may actually install
/// (root's included), so a caller runs out of quota first and `install_row`'s
/// `fatal` never fires. The `quota_vs_wall` case holds the two numbers against
/// each other.
public static GRANT_ROW_BUDGET: UInt = 8

/// May `[base, base + len)` be installed as a device row? This profile's
/// granularity rule, checked on caller-chosen numbers.
///
/// A device window costs one naturally-aligned power-of-two entry rather than a
/// TOR pair, so a carved sub-window must have the same shape the board's static
/// asserts pin for the board's own window. A violation is a `BadArg` fault at
/// the carve: the caller chose the offset and the length.
///
/// Architectural: it is PMP's NAPOT rule, so the predicate is the same on every
/// riscv32 board. Where the board's own window is, and how big, is the board's.
public func device_window_ok(base: UInt, len: UInt) -> Bool {
    if len < PROT_GRAIN {
        return false
    }
    // A power of two, tested without a loop: exactly one bit set.
    if (len & (len - 1)) != 0 {
        return false
    }
    (base % len) == 0
}

// =============================================================================
// PMP: the Profile A isolation primitive
// =============================================================================
//
// Spec §5.5: on Profile A an AddressSpace is a PMP region set. RISC-V denies by
// default ("if no PMP entry matches a U-mode access, and at least one entry is
// implemented, the access fails"), so kernel memory and the devices the kernel
// keeps are locked away from a process by saying nothing about them. The kernel
// grants root exactly its own ranges. M-mode is unconstrained because SOS never
// sets an entry's L (lock) bit. The flat profile replaces all of this with one
// range over the whole address space (`prot_open_all`).
//
// A region is a TOR pair: entry 2*idx holds the lower bound with A=OFF (a bound
// only, never matched), entry 2*idx+1 holds the upper bound with A=TOR plus the
// R/W/X bits. Bounds are stored shifted right by two (PMP's 4-byte grain). The
// budget is `PMP_REGIONS` regions out of the sixteen entries `sink.c`'s switch
// covers; each board's linker script records how its own map divides.
//
// Eight regions use all sixteen entries the part implements, so the budget is
// the hardware's own. A driver-shaped root spends two regions on its segments,
// one on its stack and one on its device window; the rest are for `map()`.
//
// The region arithmetic is Saw. What stays native is placing a word in a
// numbered CSR, because `csrw pmpaddr3, x` names the register in the
// instruction, so an indexed write has to be a switch in assembly. Profile B
// makes the same split: descriptors in Saw, activation instructions in C.

/// Regions the board budget programs, as TOR pairs out of the sixteen entries
/// `sink.c` can reach. It is `GRANT_ROW_BUDGET` (one installed protection row
/// is one numbered region here); the arch-free kernel reads that name, since
/// `pmp` may not appear in `kernel/core`.
static PMP_REGIONS: UInt = GRANT_ROW_BUDGET
static PMP_A_TOR: UInt = 0x8              // cfg bits 4:3 = 1 (top-of-range)
static PMP_A_NAPOT: UInt = 0x18           // cfg bits 4:3 = 3 (naturally aligned)
static PMP_PERM_MASK: UInt = 0x7          // cfg bits 2:0 — R, W, X
static PMP_PERM_RW: UInt = 0x3            // R | W, with X deliberately clear
static PMP_GRAIN_SHIFT: Int = 2           // bounds are stored >> 2
static PMP_CFGS_PER_WORD: UInt = 4
static BITS_PER_PMP_CFG: Int = 8

// The region budget has to cover a root image's segments, its stack and its
// device window. `MAX_ROOT_SEGMENTS` is one less than the budget because a
// device window arrives as a segment record and the stack is the kernel's own
// grant on top.
static_assert(MAX_ROOT_SEGMENTS + 1 <= PMP_REGIONS,
              "a root image's segments plus its stack must fit the region budget")

/// The four `pmpcfg` shadow words: entries 0-3, 4-7, 8-11 and 12-15. Four
/// entries' config bytes fit one RV32 word.
///
/// Compound global state, staged across several `prot_region` calls and
/// published by one `prot_commit`, with no cheap way to read the hardware back.
/// The serialization argument is spec §7's: uniprocessor, and the whole staged
/// sequence runs with no preemption point in it (see `prot_reset`).
unsafe static var PMPCFG0: UInt = 0
unsafe static var PMPCFG1: UInt = 0
unsafe static var PMPCFG2: UInt = 0
unsafe static var PMPCFG3: UInt = 0

/// Revoke every grant. User mode then reaches nothing at all, the default-deny
/// the grants below carve out of.
///
/// No preemption point: twenty register writes, and a half-rewritten grant
/// table is an in-flight invariant. The whole staged `prot_*` sequence is one
/// edit, published by `prot_commit`.
public func prot_reset() unsafe {
    PMPCFG0 = 0
    PMPCFG1 = 0
    PMPCFG2 = 0
    PMPCFG3 = 0
    sos_pmpcfg_write(0, 0, 0, 0)
    var i: UInt = 0
    while i < PMP_REGIONS * 2 {
        sos_pmpaddr_write(i, 0)
        i = i + 1
    }
}

/// Stage grant `idx` as [base, top) with `perms`, a mask in the `SegFlag`
/// vocabulary. On this target those bits are a PMP config's low three bits
/// (`imgformat` says why), so the mask installs untranslated.
///
/// An out-of-budget index is ignored here and rejected by the caller, which
/// owns the diagnostic.
public func prot_region(idx: UInt, base: UInt, top: UInt, perms: UInt8) unsafe {
    if idx >= PMP_REGIONS {
        return
    }
    let lo = idx * 2
    let hi = lo + 1
    sos_pmpaddr_write(lo, base >> PMP_GRAIN_SHIFT)
    sos_pmpaddr_write(hi, top >> PMP_GRAIN_SHIFT)
    stage_cfg(hi, ((perms as UInt) & PMP_PERM_MASK) | PMP_A_TOR)
}

/// Put one entry's config byte into the shadow word that holds it.
///
/// Shared by the TOR and NAPOT stagers so one place knows which shadow word an
/// entry's byte lives in; getting it wrong in one of two copies would install a
/// grant at the wrong index.
///
/// It is a four-way chain rather than an indexed store because a `static` is
/// not an array element: Saw cannot name "the nth of these four".
func stage_cfg(entry: UInt, cfg: UInt) unsafe {
    let word = entry / PMP_CFGS_PER_WORD
    let shift = BITS_PER_PMP_CFG * ((entry % PMP_CFGS_PER_WORD) as Int)
    if word == 0 {
        PMPCFG0 = PMPCFG0 | (cfg << shift)
    } else if word == 1 {
        PMPCFG1 = PMPCFG1 | (cfg << shift)
    } else if word == 2 {
        PMPCFG2 = PMPCFG2 | (cfg << shift)
    } else {
        PMPCFG3 = PMPCFG3 | (cfg << shift)
    }
}

/// The NAPOT encoding of `[base, base + len)`: the base with the low bits of
/// the size set, shifted into a PMP address.
///
/// A NAPOT entry encodes a naturally aligned power-of-two region as one address
/// word (the trailing ones say how big it is), so a device window costs one
/// entry where a TOR region costs two. `len` is a power of two and `base` is
/// aligned to it; the loader's own asserts pin both, so nothing is validated
/// here.
func napot_bound(base: UInt, len: UInt) -> UInt {
    (base | (len / 2 - 1)) >> PMP_GRAIN_SHIFT
}

/// Stage grant `idx` as a device window over `[base, base + len)`.
///
/// One entry, not a pair, and read/write with execute deliberately clear:
/// registers are not instructions. Otherwise a device window is an ordinary
/// grant on this profile: PMP has no memory-type field, and a riscv32 board's
/// device space is uncached because of where it is. (Profile B has to say so in
/// the descriptor, which is why the seam carries a device call at all.)
///
/// It spends the same numbered region slot a segment would. The entry it
/// programs is the pair's high one, where `prot_region` puts a TOR region's
/// permissions, and the pair's low entry stays disabled.
public func prot_device(idx: UInt, base: UInt, len: UInt) unsafe {
    if idx >= PMP_REGIONS {
        return
    }
    let entry = idx * 2 + 1
    sos_pmpaddr_write(entry, napot_bound(base, len))
    stage_cfg(entry, PMP_PERM_RW | PMP_A_NAPOT)
}

/// Publish the staged grant set. Separate from `prot_region` so a partially
/// programmed set is never live.
public func prot_commit() unsafe {
    sos_pmpcfg_write(PMPCFG0, PMPCFG1, PMPCFG2, PMPCFG3)
}

/// Permit everything: one TOR entry over the whole address space, RWX.
/// `prot_reset`'s opposite.
///
/// The flat build profile's one hardware act. It lives here because PMP is an
/// architectural fact, and because the flat profile cannot reach these
/// registers itself: `sos_pmpaddr_write` and `sos_pmpcfg_write` are
/// `extern "C"`, an extern carries no visibility and cannot be re-exported, and
/// two modules declaring one C symbol collide across the compilation unit.
///
/// Opening is an act, not an omission. At reset every `pmpcfg` byte is zero, so
/// a profile that merely emptied its `prot_*` bodies would deny root its own
/// first instruction.
///
/// Entry 0 is the range's lower bound with its config byte left at zero (A=OFF,
/// matching nothing on its own); entry 1 is the upper bound with
/// `A=TOR | R | W | X`. Bounds are stored `>> 2`, so `0xFFFF_FFFF` is the top
/// of the 32-bit space and the pair covers every address U-mode can name. The
/// other fourteen entries stay at zero and need no clearing, since an A=OFF
/// byte matches nothing. M-mode is unaffected: SOS never sets an entry's L bit,
/// so a matching entry constrains U-mode only.
///
/// It writes the CSRs directly rather than through the `PMPCFG*` shadow words,
/// which exist to accumulate a replay this profile does not do.
public func prot_open_all() unsafe {
    sos_pmpaddr_write(0, 0)
    sos_pmpaddr_write(1, PMP_OPEN_TOP)
    sos_pmpcfg_write((PMP_PERM_MASK | PMP_A_TOR) << BITS_PER_PMP_CFG, 0, 0, 0)
}

/// The top of the address space in PMP's shifted-by-two encoding, the upper
/// bound of `prot_open_all`'s one TOR range.
///
/// Written as a literal rather than derived from a shift: a const shift folds
/// in the signed platform domain, so anything reaching bit 31 refuses to fit a
/// `UInt` on a 32-bit target.
static PMP_OPEN_TOP: UInt = 0xFFFF_FFFF

// =============================================================================
// The persistent-domain seam: no-ops here
// =============================================================================
//
// Profile B gives every process a persistent translation-table set, edits it
// when the grant record is edited, and makes a switch one register write. This
// profile does none of that, and the bodies below are empty because PMP has no
// per-process standing image to edit. There are sixteen numbered registers
// describing the machine's current view, and the only way to make them describe
// a different process is to rewrite them, which `load_domain`'s replay already
// does through `prot_reset` / `prot_region` / `prot_device` / `prot_commit`.
//
// The kernel's record stays authoritative and the hardware learns at switch
// time; each isolated board's `prot_replay_at_switch()` answers true so the
// kernel can read that (the flat profile answers false, having nothing to
// replay). The kernel calls `prot_switch`, `prot_update` and `prot_clear` on
// every profile, and each profile implements the half it means.

// The two tier facts, `prot_replay_at_switch()` and `prot_isolated()`, are the
// board's, not the arch's. The flat build profile is riscv32 with PMP opened,
// and it disagrees with `hal/riscv32` about both while sharing every line of
// this file, so neither is an architectural fact.
//
// They are functions, not statics, and should stay so: a module-level `static`
// does not carry module identity the way a free function does, so two modules
// in one compilation unit cannot both declare `PROT_ISOLATED`; they collide at
// the kernel entry. Both may declare `prot_isolated()` and each caller gets its
// own, as with `prot_reset` and its six siblings, which `rv32core` and the flat
// profile both declare.

/// How many process domains this profile can serve.
///
/// Not a storage limit here. On Profile B the matching constant sizes a static
/// pool of persistent table sets; this profile stores no per-process image and
/// reprograms sixteen registers from the kernel's record at every switch, so
/// the only bound is how many process bodies the kernel has. The value is
/// chosen to never bind, and `kernel/core/limits.saw`'s assert against it holds
/// for any `MAX_PROCESSES` this kernel will hold.
public static PROT_DOMAIN_SLOTS: Int = 256

/// Make `p`'s domain live. Nothing to do: the replay `load_domain` just
/// performed is this profile's switch, and it published it with `prot_commit`.
public func prot_switch(p: UInt) unsafe {
}

/// Make `[base, top)` in `p`'s standing image say `perms`, where `perms == 0`
/// means revoke (a grant of nothing is the absence of a grant). There is no
/// standing image here: the row is in the kernel's record, and the next
/// `load_domain(p)` replays whatever the record then says. Both directions are
/// therefore a no-op, apart from one assertion.
///
/// On this tier a row's user range and its physical backing must be the same
/// number: PMP filters physical addresses and user mode issues them unchanged,
/// so a row whose `pa` drifted from its `base` would program a range nobody
/// asked for. `image_link_base` and `map_place` both answer the physical
/// address, and this checks that those answers reached the record.
///
/// It is here rather than in `prot_region` because every row passes through
/// this funnel at the moment it is recorded (the replay reads the record
/// afterwards, so a bad row would already be stored by then).
public func prot_update(p: UInt, base: UInt, top: UInt, pa: UInt, perms: UInt8,
                        device: Bool) unsafe {
    assert(pa == base,
           "a user address on the MPU tier IS its physical address")
}

/// Retire `p`'s domain. `clear_domain` has already emptied the record and
/// invalidated `LAST_PROT_PROCESS`, which forces the next switch to reprogram
/// the hardware from scratch.
public func prot_clear(p: UInt) unsafe {
}

/// Build a fresh user context in `frame_addr`: `entry` as the resume address,
/// `stack_top` as the stack pointer, `arg0` in the first argument register.
///
/// Every other word is zeroed: nothing of the kernel's, and nothing of another
/// thread's, crosses into a context this builds. The return-address register is
/// zeroed on purpose, so a thread entry that returns jumps to zero and takes an
/// instruction-access fault, which spec §8 turns into the death of its process.
///
/// No preemption point: 32 word stores, and a half-built context is an
/// in-flight invariant the trap path can reach.
public func frame_init(frame_addr: UInt, entry: UInt, stack_top: UInt,
                       arg0: UInt) unsafe {
    var w: UInt = 0
    while w < FRAME_WORDS {
        UnsafeMemory<UInt, Normal>(frame_addr + w * WORD_BYTES).write(0)
        w = w + 1
    }
    let frame = frame_at(frame_addr)
    frame.mepc.write(entry)
    frame.sp.write(stack_top)
    frame.a0.write(arg0)
}

static WORD_BYTES: UInt = 4

/// Resume the context saved in `frame_addr`, in user mode. Never returns.
///
/// This is the first entry to user mode, and the only one that is not `ktrap`
/// handing a frame back to the trap entry. The assembly behind it is a
/// privilege-mode select and a branch into the trap entry's own restore path,
/// not a second copy of it.
public func resume_frame(frame_addr: UInt) -> Never {
    sos_resume_frame(frame_addr)
    while { }
}

/// First byte of the appended payload — the `.payload` section the board's
/// linker script bounds. Saw cannot name a linker symbol, so the bounds arrive
/// through C.
public func payload_start() -> UInt {
    sos_payload_start()
}

/// One past the last byte of the appended payload. Equal to `payload_start()`
/// in an image built without one.
public func payload_end() -> UInt {
    sos_payload_end()
}

/// First byte of the boot region table, the `.regions` section the board's
/// linker script bounds. Saw cannot name a linker symbol, so the bounds arrive
/// through C, as the payload's do.
///
/// This is the second fixed symbol pair in the system. The table's rows point
/// at blob sections whose bases the linker resolves, so those need no symbol
/// the kernel can name, however many child images a build appends.
public func region_table_start() -> UInt {
    sos_region_table_start()
}

/// One past the last byte of the region table. Equal to
/// `region_table_start()` in an image built without one, which is zero regions
/// and not an error.
public func region_table_end() -> UInt {
    sos_region_table_end()
}

// =============================================================================
// Traps
// =============================================================================

/// The `mcause` exception codes the kernel can take (interrupt bit clear).
///
/// Backed by `UInt`, the width of the CSR the value arrives in. The numbers are
/// RISC-V's, so they are pinned per case: a reorder here must never renumber
/// them.
enum TrapCause: UInt {
    case InsnMisaligned = 0,
    case InsnAccessFault = 1,
    case IllegalInsn = 2,
    case Breakpoint = 3,
    case LoadMisaligned = 4,
    case LoadAccessFault = 5,
    case StoreMisaligned = 6,
    case StoreAccessFault = 7,
    case EcallFromU = 8,
}

extension TrapCause {
    /// The short symbolic name a fault line reports.
    func describe(&self) -> String {
        match self {
            case InsnMisaligned -> "instruction-address-misaligned",
            case InsnAccessFault -> "instruction-access-fault",
            case IllegalInsn -> "illegal-instruction",
            case Breakpoint -> "breakpoint",
            case LoadMisaligned -> "load-address-misaligned",
            case LoadAccessFault -> "load-access-fault",
            case StoreMisaligned -> "store-address-misaligned",
            case StoreAccessFault -> "store-access-fault",
            case EcallFromU -> "ecall-from-u-mode",
        }
    }
}

/// `ecall` is a 4-byte instruction — `mepc` points AT it, so a returning
/// syscall must step past it or the trap repeats forever. (Profile B's `svc`
/// leaves `ELR` already past, which is why advancing belongs to the HAL.)
static SYSCALL_INSN_LEN: UInt = 4

/// Did this trap come from a syscall instruction, or is it a fault?
public func is_syscall(cause: UInt) -> Bool {
    cause == (TrapCause.EcallFromU as UInt)
}

/// The high bit of a cause word says "this is an interrupt, not an exception",
/// and the rest of the word is then an interrupt code with its own numbering; a
/// 7 with the flag set has nothing to do with a 7 without it.
///
/// Public for the board, not for `kcore`: each board's `irq_claim` strips this
/// flag before decoding what its own controller put in the rest of the word.
public static INTERRUPT_FLAG: UInt = 0x8000_0000

/// The interrupt codes this kernel can take. Numbered by the architecture, so
/// each is pinned per case; the flag above is stripped before the decode.
///
/// Public for the board, on the same terms as `INTERRUPT_FLAG`: a board decides
/// which of its own sources arrives as which of these codes, and one of them
/// pins that choice with a `static_assert`.
public enum InterruptCause: UInt {
    case MachineTimer = 7,
    case MachineExternal = 11,
}

/// Is this trap an interrupt rather than a syscall or a fault?
///
/// Interrupts only ever arrive from user mode: this hart takes them in kernel
/// mode only with the global enable set, which SOS never sets, and a trap taken
/// in kernel mode goes to `trap.S`'s kernel-bug path anyway.
public func is_interrupt(cause: UInt) -> Bool {
    (cause & INTERRUPT_FLAG) != 0
}

/// A short symbolic name for a raw trap cause.
///
/// The decode is where an unknown code stops being a number: `from(raw:)` is
/// total, and the hardware may raise a cause this kernel does not model, so the
/// miss has its own name rather than an arm. Everything it does model is an
/// exhaustive `match` in `describe`, so a cause added to the enum fails to
/// compile until it is given a name.
public func cause_tag(cause: UInt) -> String {
    guard let decoded = TrapCause.from(raw: cause) else {
        return "unexpected-trap"
    }
    decoded.describe()
}

/// Overlay the saved context. One view construction, then ordinary field names.
func frame_at(frame_addr: UInt) unsafe -> UnsafeMemory<TrapFrame, Normal> {
    UnsafeMemory<TrapFrame, Normal>(frame_addr)
}

/// Where the trapped context resumes: the faulting instruction on a fault, the
/// interrupted one on an interrupt.
public func trap_pc(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).mepc.read()
}

/// §5.7: a0 = handle, a7 = op, args a1-a3.
public func syscall_handle(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).a0.read()
}

public func syscall_op(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).a7.read()
}

public func syscall_arg0(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).a1.read()
}

public func syscall_arg1(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).a2.read()
}

public func syscall_arg2(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).a3.read()
}

/// Place a syscall's (status, value) pair where the caller will find it and
/// step the saved PC past the trapping instruction. Resuming is the assembly's
/// job; deciding what "past" means is this file's.
public func syscall_return(frame_addr: UInt, status: UInt, value: UInt) unsafe {
    let frame = frame_at(frame_addr)
    frame.a0.write(status)
    frame.a1.write(value)
    frame.mepc.write(frame.mepc.read() + SYSCALL_INSN_LEN)
}

// =============================================================================
// The interrupt-line vocabulary
// =============================================================================
//
// The two numbers the arch-free kernel reads about lines. Which lines a board
// wires, and how one is claimed, masked and completed, is the board's; these
// two are contract rather than hardware, and both riscv32 boards (and Profile
// B) answer with the same numbers.

/// The controller had nothing to give. Both profiles report a spurious
/// interrupt as this value, and neither ever uses it as a real line.
public static IRQ_NONE: UInt = 0

/// The line the periodic timer arrives on.
///
/// The timer is not one of a riscv32 board's controller sources (it is a class
/// of its own at the hart), so the seam needs a number the controller can never
/// produce; one past its last source is that number. Each board asserts that
/// against its own source count, which cannot live here.
public static IRQ_TIMER: UInt = 1024

/// Bits in a machine word on this target, for the boards' split 64-bit timer
/// registers.
public static WORD_BITS: Int = 32
