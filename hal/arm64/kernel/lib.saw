//! The arm64 kernel HAL, Saw half (design 162) — QEMU `virt`, EL1.
//!
//! Everything the SOS kernel needs from THIS machine, and nothing more. The
//! kernel core above it (`kernel/core/`) names no architecture at all: it
//! reaches the board, the privilege transition and the memory-protection
//! hardware only through the surface below, which `hal/riscv32/kernel/`
//! implements the same way for Profile A. `ABI.md` beside this file is the
//! contract; `boot.S` and `sink.c` are the parts of it that cannot be Saw.
//!
//! Addresses and machine words are `UInt` throughout, never `Int`. On this
//! target `Int` is 64-bit SIGNED, so the addresses here fit either way — which
//! is exactly why the discipline has to be written down rather than tested: the
//! same code on Profile A puts 0x8020_0000 in `Int`'s negative half (DF-140a).

// The image-format registry, for this profile's arch tag. The format is shared
// with everyone who touches an image; the tag a HAL claims comes out of it
// rather than being spelled again here.
import imgformat.{SosimgArch, SegFlag}

// Arch-free, role-free formatting, shared with the kernel core and every SOS
// process build. This HAL formats its OWN diagnostics — the kernel core is
// ABOVE it and cannot be imported from here — so it reaches for the same
// helpers the kernel console does, and the two agree on what a non-ASCII scalar
// becomes and on how wide a machine word is.
// The last three are the arch-free half of the console and the stop: the sink
// trait this file's UART conforms to, the one write loop over it, and the
// exit-status promotion both HALs used to spell out (design 172 review round).
import sosrt.{ascii_byte, hex_digit_of, hex_digits_per_word,
              ConsoleSink, console_write, abort_status}

// =============================================================================
// PL011 UART (design 112's blessed MMIO idiom: register block + driver)
// =============================================================================

/// The PL011 register block, as far as a polled transmitter needs it.
/// Declaration order IS the layout (design 58), so the reserved words between
/// the data register and the flag register are spelled out rather than
/// computed — a hole in a register block is a field like any other.
struct Pl011Regs {
    dr: UInt32,             // +0x00  data
    rsr: UInt32,            // +0x04  receive status / error clear
    reserved0: UInt32,      // +0x08
    reserved1: UInt32,      // +0x0C
    reserved2: UInt32,      // +0x10
    reserved3: UInt32,      // +0x14
    fr: ReadOnly<UInt32>,   // +0x18  flag register
}

/// The console driver. A SAFE type (unsafety is not transitive — design 130):
/// only the methods reaching through `regs` carry the `unsafe` effect.
struct Pl011 {
    regs: UnsafeMemory<Pl011Regs, Device>,
}

extension Pl011 {
    /// `at` is the PHYSICAL base — the number the board publishes and the number
    /// a device grant carries. The linear map is where the kernel reaches it
    /// (sawos design 29): the conversion is here, at the one construction, so
    /// every caller keeps naming the register block by its real address.
    init(at: UInt) unsafe -> Pl011 {
        Pl011(regs: UnsafeMemory<Pl011Regs, Device>(phys_to_virt(at)))
    }
}

/// The two register touches, and nothing else — no interrupts in M1, so the
/// transmitter is polled. QEMU's PL011 comes up transmitting, so there is no
/// baud-rate or line-control programming to do; a real board would need it and
/// it would go in `init`.
///
/// `write_byte` and the panic path's write LOOP are `sosrt`'s, once, generic
/// over this conformance and monomorphized here (design 172 review round). What
/// makes a PL011 a PL011 is the pair below, and note that it is the OPPOSITE
/// sense to the 16550's: readiness is FR bit 5 CLEAR (the transmit FIFO is not
/// full), and the byte goes to DR. Having each HAL answer `can_write` in its
/// own terms is what lets one loop serve both.
extension Pl011: ConsoleSink {
    func can_write(&self) unsafe -> Bool {
        (self.regs.fr.read() & FR_TX_FULL) == 0
    }

    func put(&self, b: UInt8) unsafe {
        self.regs.dr.write(b as UInt32)
    }
}

// =============================================================================
// The trap frame
// =============================================================================

/// The context `boot.S` saves on a trap from EL0: 34 doublewords. Declaration
/// order IS the layout (design 58), so the field names here and the
/// `stp x<n>, x<n+1>, [sp, #...]` stores in boot.S are one description.
///
/// The three system registers come FIRST because they are what the resume path
/// reads back — and because x31 is not a register: `sp` at EL0 is `SP_EL0`, a
/// separate register the kernel saves explicitly, so there is no "slot x0 would
/// have occupied" to reuse the way Profile A does for its PC.
struct TrapFrame {
    elr: UInt,              // the PC to resume at — already PAST the `svc`
    spsr: UInt,             // saved processor state
    sp: UInt,               // SP_EL0, the user stack pointer
    x0: UInt,               // syscall handle / status out
    x1: UInt,               // syscall arg 0 / value out
    x2: UInt,
    x3: UInt,
    x4: UInt,
    x5: UInt,               // syscall arg 4 (the last, per §5.7)
    x6: UInt,
    x7: UInt,
    x8: UInt,               // syscall op
    x9: UInt,
    x10: UInt,
    x11: UInt,
    x12: UInt,
    x13: UInt,
    x14: UInt,
    x15: UInt,
    x16: UInt,
    x17: UInt,
    x18: UInt,
    x19: UInt,
    x20: UInt,
    x21: UInt,
    x22: UInt,
    x23: UInt,
    x24: UInt,
    x25: UInt,
    x26: UInt,
    x27: UInt,
    x28: UInt,
    x29: UInt,
    x30: UInt,
}

/// Bytes in one saved context.
///
/// Public because the KERNEL reserves a slot per thread and has to know this
/// fits (design 178 M2 unit 2): a trap frame is a thread's context, so the
/// kernel owns the storage and the HAL owns the layout. The assert below is
/// what keeps the number honest on this side; the kernel's own assert is what
/// keeps its stride honest on that side.
public static FRAME_BYTES: Int = 272

/// Doublewords in a frame, for `frame_init`'s zeroing loop.
static FRAME_WORDS: UInt = 34

// The frame boot.S builds must be the frame this file describes. A field added
// on one side and not the other would misread every register after it.
static_assert(sizeof<TrapFrame>() == FRAME_BYTES, "the arm64 trap frame is 34 doublewords")

// =============================================================================
// Board constants
// =============================================================================

static UART_BASE: UInt = 0x0900_0000
static FR_TX_FULL: UInt32 = 0x20         // FR bit 5 — transmit FIFO full

/// The interrupt controller: a distributor shared by the machine and a
/// per-core interface. This board wires the v2 layout, which is what
/// `tools/sos_runner.py` pins on the command line so a newer emulator's default
/// cannot quietly become a controller this HAL does not program.
static GIC_DIST_BASE: UInt = 0x0800_0000
static GIC_CPU_BASE: UInt = 0x0801_0000

/// The line the core's physical timer arrives on: a per-core interrupt, so it
/// is the same number on every core and needs no distributor target.
static TIMER_IRQ: UInt = 30

// =============================================================================
// The linear-map seam (sawos design 29, M5 unit 1.5)
// =============================================================================
//
// **ADDRESSES-AS-DATA STAY PHYSICAL; ONLY A DEREFERENCE CONVERTS.** That is the
// whole discipline of this unit, and these two functions are the whole of its
// machinery. A `GrantRow`, a sosimg record, a boot-handle record, a region
// table row, a `Memory`/`IoMemory` capability and a fault report word all carry
// the SAME number they carried before the kernel moved: a physical address is
// the one name for a location that crosses any API. What changed is that the
// kernel no longer runs at those addresses, so the moment it DEREFERENCES one
// it says so.
//
// On this HAL the pair is an OR and an AND with a fixed offset — no table walk,
// no lookup, three instructions between them. On both riscv32 HALs it is the
// identity and compiles to nothing. `kernel/core` names only these two and
// carries no tier conditional.
//
// **WHY PURE OR/AND IS SAFE, AND WHY IT IS ASSERTED RATHER THAN ASSUMED.** The
// offset's low `VA_BITS` bits are zero and every address this board can name
// fits under that, so `pa | LINMAP_OFFSET` never carries into a set bit and
// `va & LINMAP_PHYS_MASK` never clears one. The `static_assert`s below (and the
// RAM one beside `RAM_BASE`, where that constant is declared) are what hold the
// board's map to it: widen RAM past 512 GiB or move a device above it and the
// BUILD stops, rather than a kernel quietly folding an address onto another.
//
// A pleasant consequence worth knowing when reading the sweep: `virt_to_phys`
// is IDEMPOTENT on an address that is already physical, because masking off
// bits that are not set changes nothing. That is what lets it normalize a value
// whose provenance is mixed — a region-table row base, which the linker fills
// in from a section symbol (a LINK address, high) in one row and from a literal
// (already physical) in the next.

/// The virtual-address size TCR selects for BOTH halves — `T0SZ` = `T1SZ` =
/// `64 - VA_BITS`. 39 bits at the 4 KiB granule puts level 1 first, with 512
/// entries of 1 GiB each; `sink.c` writes the register and this is the number
/// it writes.
static VA_BITS: Int = 39

/// The low half of a 64-bit address at `VA_BITS`: the bits a physical address
/// may occupy, and exactly the mask `virt_to_phys` applies.
static LINMAP_PHYS_MASK: UInt = (1 << VA_BITS) - 1

/// **WHERE THE KERNEL LIVES** — the canonical TTBR1 base for a `VA_BITS`-bit
/// virtual address, `2^64 - 2^39`. Every kernel address in the running system
/// is `physical | LINMAP_OFFSET`, which is what makes the conversion arithmetic
/// rather than a lookup, and the kernel's own image is LINKED at these
/// addresses (`virt.ld` adds it to the load address and takes it back off with
/// `AT`, so the ELF's physical addresses are unchanged and QEMU loads the image
/// exactly where it always did).
///
/// Written as a literal because a const fold runs in the SIGNED platform-`Int`
/// domain (design 185), where this value is negative — the language's own
/// advice for a constant with the top bit set is to write it out. The asserts
/// below are what check it against `VA_BITS` anyway, so the literal cannot
/// drift from the register.
public static LINMAP_OFFSET: UInt = 0xFFFF_FF80_0000_0000

static_assert((LINMAP_OFFSET & LINMAP_PHYS_MASK) == 0,
              "the linear-map offset must not overlap the physical half, or `|` would carry")
static_assert((LINMAP_OFFSET | LINMAP_PHYS_MASK) == UInt.max,
              "the offset and the mask must partition the 64-bit address")

// The BOARD'S MMIO, held to the same bound as RAM. Both device blocks live in
// the first GiB, so these are never close — which is the point of asserting
// them: a board file that moved a controller would have to notice.
static_assert(UART_BASE <= LINMAP_PHYS_MASK,
              "the console UART must fit under the linear-map offset")
static_assert(GIC_DIST_BASE <= LINMAP_PHYS_MASK,
              "the GIC distributor must fit under the linear-map offset")
static_assert(GIC_CPU_BASE <= LINMAP_PHYS_MASK,
              "the GIC CPU interface must fit under the linear-map offset")

/// **A PHYSICAL ADDRESS AS THE KERNEL MUST SPELL IT TO DEREFERENCE IT.**
///
/// Every kernel-side `UnsafeMemory`/`UnsafePointer` built out of a STORED
/// physical address goes through here — the sosimg overlays, the region-table
/// overlays, the copy doors, the descriptor writes, and this file's own MMIO
/// views. What does NOT go through here is an address that was already a kernel
/// one: a pointer taken from a Saw reference (`(&var THREAD_FRAMES) as ...`) is
/// a link-time address and is high already.
public func phys_to_virt(pa: UInt) -> UInt {
    pa | LINMAP_OFFSET
}

/// The inverse: a kernel dereference address back to the physical address that
/// is its name everywhere else.
///
/// Its callers are the places a kernel address has to become HARDWARE's or
/// DATA's: the translation-table pool's base (a descriptor and a TTBR hold
/// physical addresses), the payload and region-table linker bounds, and the
/// region rows the linker resolved. Idempotent on an address that is already
/// physical — see the section header.
public func virt_to_phys(va: UInt) -> UInt {
    va & LINMAP_PHYS_MASK
}

// =============================================================================
// Identity (design 162)
// =============================================================================

/// What this kernel says it is booting on, for the banner.
public func arch_name() -> String {
    "arm64 (QEMU virt)"
}

/// This profile's `sosimg` arch tag. A process image built for the other
/// profile is refused by the loader rather than jumped into.
///
/// It reads the tag out of `imgformat`'s registry rather than repeating the
/// number, so the two cannot drift — a HAL claiming a tag the format does not
/// define is not expressible.
public func arch_tag() -> UInt8 {
    SosimgArch.Arm64.tag()
}

// =============================================================================
// Console
// =============================================================================

/// Write one byte to the kernel's console.
///
/// The kernel owns the machine, so this is the UART directly. Byte-at-a-time is
/// what the seam needs: the arch-free half above formats, this half places.
///
/// THE HANDOVER PROTOCOL, DEVICE HALF (design 178's finale constraint 4; the
/// protocol itself is stated on `kcore`'s `Console`). This board has ONE UART
/// and a driver process may be granted its page, so after the handover marker
/// there can be a second writer on this device. The cost is bounded: both
/// writers use the data register and the transmit-full flag beside it, each
/// write being one 32-bit store behind its own poll, so a kernel byte lands
/// BETWEEN two of the process's rather than inside one. What the kernel never
/// touches is the receive side, the interrupt-mask register or the control
/// register — a driver that owns receive owns it alone.
///
/// A DRIVER ON THIS BOARD MUST ENABLE THE UART ITSELF. The kernel's transmitter
/// works out of reset here without programming the control register, so a
/// process that wants RECEIVE has to set it — which is the honest division:
/// the kernel programs nothing it does not need, and the owner configures.
public func console_byte(b: UInt8) unsafe {
    Pl011(at: UART_BASE).write_byte(b)
}

// =============================================================================
// Stopping the machine
// =============================================================================

// `hlt #0xf000` is not expressible in Saw and neither is the register pinning
// the semihosting call needs, so both exits go through the C half. See
// `sink.c` for why semihosting rather than PSCI.
extern "C" {
    func sos_platform_exit(code: UInt)
    func sos_wait_for_irq()
}

/// Stop the machine with status 0. Never returns.
public func exit_pass() {
    sos_platform_exit(0)
    while true { }
}

/// Stop the machine with a NON-ZERO status.
///
/// WHAT status is `sosrt.abort_status`'s call — a zero code would report
/// success, and the rule that a failing exit never reads as a passing one is
/// decided once, for both profiles. HOW to stop is this file's: a semihosting
/// exit through the C leaf.
public func exit_fail(code: UInt) {
    sos_platform_exit(abort_status(code))
    while true { }
}

// =============================================================================
// The runtime's two hooks (design 172 unit 4)
// =============================================================================
//
// `sosrt` (rt/common/src/lib.saw) implements the frozen `__saw_rt_*` seams
// over exactly two per-side hooks: where a byte goes, and how the machine
// stops. The kernel HAL answers "the UART" and "the platform's exit". Both
// hooks were C; both are Saw now, and since design 172 part 2 so is everything
// above them.

/// Stop the machine with a non-zero status, for the common runtime.
///
/// The promote-zero rule lives in `exit_fail`, so this is the seam name and
/// nothing else — there is one place that decides a failing exit never reads as
/// a passing one.
///
/// `-> Never` states in the type what the C spelled `__attribute__((noreturn))`
/// and what `sosrt` declares this hook to be. `exit_fail` diverges on its own
/// (it spins if the semihosting exit is somehow ignored) but is typed `Void`,
/// so the trailing loop is what carries the promise up to this signature.
@export("sos_rt_abort")
public func rt_abort(code: UInt32) -> Never {
    exit_fail(code as UInt)
    while { }
}

/// Write `len` bytes at `ptr` to the console. THE PANIC PATH'S WRITER.
///
/// The loop itself is `sosrt.console_write`, once for both profiles, and its
/// CHECK-FREEDOM contract (DF-172b) is stated there — this file supplies the
/// device it walks. What is per-arch is the sink; what is per-arch about the
/// sink is two register touches.
///
/// Verified rather than asserted, on THIS instantiation: `--emit-ir` shows the
/// generic loop, the trait's default `write_byte` and both accessor bodies
/// fully inlined, leaving `ptrtoint`, a plain `load i8`, the volatile FR load,
/// an `and`, an `icmp`, the volatile DR store and `add`/`add -1`. No
/// `llvm.uadd.with.overflow`, no bounds check, no trap block, no call to
/// `__saw_rt_panic`. A panic inside the panic reporter is not unlikely here; it
/// is unreachable.
@export("sos_rt_write")
public func rt_write(ptr: UnsafePointer<Int8>, len: UInt) unsafe {
    let sink = Pl011(at: UART_BASE)
    console_write(&sink, ptr, len)
}

// =============================================================================
// Privilege, protection and payload seams (boot.S / sink.c)
// =============================================================================

// The native half of this HAL, and now the whole of it: an `eret`, a barrier
// pair with a TLB flush, and two linker symbols. The protection primitive's
// DESCRIPTORS are built below in Saw (design 172 unit 1) — only publishing them
// needs instructions. See `sink.c`'s header for the reason each survivor
// carries.
extern "C" {
    func sos_resume_frame(frame_addr: UInt)
    func sos_prot_commit()
    // The domain switch and its TLB maintenance (sawos design 27). Both name a
    // system register or a maintenance instruction at assembly time, so both
    // are C leaves for the same reason `sos_prot_commit` is.
    func sos_ttbr0_write(value: UInt)
    func sos_tlbi_asid(asid: UInt)
    func sos_payload_start() -> UInt
    func sos_payload_end() -> UInt
    func sos_region_table_start() -> UInt
    func sos_region_table_end() -> UInt
}

/// This target's protection granularity: a translation-table page. Profile A
/// grants at four-byte granularity, which is why a root image built for this
/// profile has to place its segments on page boundaries and the loader checks
/// that it did.
public static PROT_GRAIN: UInt = 4096

/// How many segments a root image may ask for. A page-table profile has no
/// small fixed region budget the way PMP does, so this is a sanity bound on a
/// hostile header rather than a hardware limit.
public static MAX_ROOT_SEGMENTS: UInt = 8

/// Root's region on this board. The base is 2 MiB into RAM — the same offset
/// Profile A uses, and here it is also a level-2 boundary, so root's pages come
/// out of the grant window whole. Mirrored by the root linker script.
///
/// **`ROOT_LOAD_BASE` IS NOW THE PHYSICAL DESTINATION AND NOTHING ELSE** (sawos
/// design 33). It used to be both — where root's bytes go AND the address root
/// sees them at — because the two were the same number. Under placement the
/// second half is `USER_IMAGE_BASE` below, and root is the one process for which
/// the two still coincide.
public static ROOT_LOAD_BASE: UInt = 0x4020_0000
public static ROOT_REGION_TOP: UInt = 0x4024_0000
public static ROOT_STACK_LEN: UInt = 0x4000

// =============================================================================
// PLACEMENT: the two seams that decide a user address (sawos design 33)
// =============================================================================
//
// **ON THIS TIER A USER ADDRESS IS THE KERNEL'S ANSWER.** Every process image
// links at ONE canonical base and loads wherever the allocator put its frames;
// a `map` lands where a per-process cursor says. Both facts are expressed as
// FUNCTIONS rather than as a tier flag the kernel branches on, because the
// other tier's answer is the IDENTITY — an image links where it loads, a
// mapping lands at its own physical address — and an identity body compiles to
// nothing. That is design 19's doctrine at the one place M5 unit 2 needed it:
// the difference is ADVERTISED by each HAL stating its own answer, never faked,
// and `kernel/core` spells one sequence for both tiers (design 29's
// `phys_to_virt` pair is the same shape and the same argument).
//
// SO §5.5's IDENTITY LAW RE-SCOPES HERE, and this is the file that says so
// first: "an address is the same number in every process" is the TIER-2 answer,
// which `hal/riscv32-common` still gives verbatim. Unit 8 owns the spec prose.

/// **THE ONE VIRTUAL BASE EVERY USER IMAGE ON THIS BOARD IS LINKED AT** (sawos
/// design 33).
///
/// Root, a child and a grandchild all see their own image here, because each
/// runs under its own translation-table set and the low half belongs entirely to
/// whichever process is current (design 29 freed it). What differs between them
/// is the PHYSICAL frames the identical virtual range resolves to, and that is
/// the allocator's answer rather than the linker's.
///
/// It is `ROOT_LOAD_BASE`'s value on purpose: root's image is placed at a HAL
/// constant by the boot door, so keeping the canonical link base equal to it
/// leaves root's own numbers exactly where every earlier milestone put them —
/// which is what keeps the boot transcript's `entry=` row from moving.
///
/// Mirrored by `hal/arm64/user/user.ld`, the ONE user linker script this board
/// now has. Nothing at build time can compare the two (a Saw static's value is
/// not a linker symbol — design 29 finding 5), so the loader's own
/// `check_segment` is what catches a script that disagrees, and it catches it
/// with a named diagnostic rather than a silent misplacement.
public static USER_IMAGE_BASE: UInt = 0x4020_0000

/// **THE VIRTUAL BASE AN IMAGE LOADING AT PHYSICAL `dest_base` IS LINKED AT.**
///
/// The canonical base, whatever the frames are: that is the whole of placement's
/// image half. `dest_base` is ignored HERE and is the ANSWER on the MPU tier,
/// which is why the seam takes it — an identity body needs the argument, and a
/// constant that ignored it would have forced a tier conditional upstairs.
public func image_link_base(dest_base: UInt) -> UInt {
    USER_IMAGE_BASE
}

/// **WHERE A `map` OF PHYSICAL `pa` LANDS IN A PROCESS WHOSE MAP CURSOR STANDS
/// AT `cursor`.**
///
/// RAM takes the cursor — the address is the kernel's answer, and the caller
/// held no opinion (design 25 ruling 1: `map` takes no VA hint on any tier).
///
/// **A DEVICE WINDOW TAKES ITS OWN ADDRESS, AND THAT IS A STATEMENT ABOUT THIS
/// BOARD RATHER THAN A LIMITATION OF THE SEAM.** MMIO lives in a level-3 window
/// of its own here (`DEVICE_WINDOW_BASE`, one 2 MiB span), indexed by the
/// hardware address, and the addresses in it are the ones the board's region
/// table publishes — so placing a register block somewhere else in that window
/// would buy a driver nothing and cost the window a second cursor. Recorded as a
/// deliberate v1 limit: a translating tier COULD place MMIO, and this one does
/// not.
public func map_place(cursor: UInt, pa: UInt, device: Bool) -> UInt {
    if device {
        return pa
    }
    cursor
}

/// **MAY `[base, top)` BE HANDED TO A USER DOMAIN AS PHYSICAL BACKING?** — the
/// other half of `map_target_ok`, which since design 33 asks only about the
/// VIRTUAL range.
///
/// The two questions came apart when the two addresses did. A descriptor's
/// output address may be any frame the linear map covers, so the physical bound
/// is RAM; the INPUT range is what has to fit the 4 MiB grant window, because
/// that is the level-3 table's own span. Before placement one predicate answered
/// both because there was one address.
///
/// On the MPU tier the two predicates have the same body, and that is the tier
/// split visible in one file: where a user address IS its physical address, the
/// virtual question and the physical question are one question asked twice.
public func map_source_ok(base: UInt, top: UInt) -> Bool {
    base < top && base >= RAM_BASE && top <= RAM_BASE + RAM_LEN
}

/// The ONE device window this board offers a process (design 178's finale
/// constraint 3, ruled Aug 16, user): the console UART's page.
///
/// A PAGE because that is this profile's protection granularity — there is no
/// finer grant to make — and one page is what the register block needs.
public static DEVICE_GRANT_BASE: UInt = UART_BASE
public static DEVICE_GRANT_LEN: UInt = 0x1000

static_assert(DEVICE_GRANT_LEN >= PROT_GRAIN,
              "a device window cannot be finer than the protection grain")
static_assert((DEVICE_GRANT_BASE % PROT_GRAIN) == 0,
              "a device window must start on a page boundary")

/// **HOW MANY PROTECTION ROWS ONE PROCESS'S DOMAIN MAY HOLD ON THIS PROFILE**
/// — the number `MemoryOp.Map` checks a target's `grant_count` against (sawos
/// design 6 D-3/D-4).
///
/// **ON THIS PROFILE IT IS A POLICY NUMBER, NOT A HARDWARE ONE**, and the
/// asymmetry with Profile A is the thing to read here. There are no numbered
/// regions to run out of: a grant is a walk of page descriptors, so the
/// hardware's only limit is the window's own size. What bounds a domain instead
/// is the kernel's grant RECORD — a fixed array per process slot — and this is
/// that array's length (`kcore.limits.MAX_GRANT_ROWS`), restated as a HAL fact
/// so that one number serves both profiles at the map check and neither has to
/// know which kind of wall the other has.
///
/// It is deliberately NOT widened past the array. Raising it means raising the
/// storage every process slot carries, which is a decision for whoever needs
/// the rows rather than a free consequence of this profile being page-granular.
public static GRANT_ROW_BUDGET: UInt = 9

/// **MAY `[base, top)` BE INSTALLED AS A RAM ROW IN A USER DOMAIN?** (sawos
/// design 6 D-4.)
///
/// **THE 4 MiB GRANT WINDOW IS THE ANSWER, AND THIS IS WHERE A `map()` MEETS
/// IT.** `prot_region` already enforces the same bound and enforces it by
/// STOPPING THE MACHINE (`grant_outside_window`) — correct for the loader path,
/// where a memory map that outgrew the window is a kernel bug, and wrong for a
/// map, where the range came from a region a PROCESS chose. So the predicate
/// exists to move that refusal to the op, as a caller-visible `BadArg`, and
/// `grant_outside_window` stays exactly as it was for the path it was written
/// for.
///
/// Page alignment is NOT required of `base`: `prot_region` rounds down to the
/// page it starts in, exactly as it does for a segment, so a map of a region
/// that begins mid-page grants the whole page. What is required is that every
/// page the walk would touch is inside the window — which is what the top bound
/// tests, since the walk stops at `top`.
///
/// **SINCE PLACEMENT IT ASKS ABOUT THE VIRTUAL RANGE ONLY** (sawos design 33),
/// and that is not a widening of the question but a splitting of it: the window
/// is a level-3 TABLE, so what has to fit inside it is what INDEXES it, which is
/// the input address. The physical half moved to `map_source_ok` above. The body
/// did not change; what changed is which number `install_row` hands it.
public func map_target_ok(base: UInt, top: UInt) -> Bool {
    base < top && base >= RAM_BASE && top <= RAM_BASE + (GRANT_PAGES << PAGE_SHIFT)
}

/// **MAY `[base, base + len)` BE INSTALLED AS A DEVICE ROW?** — this profile's
/// granularity rule, checked on caller-chosen numbers (sawos design 6 D-2).
///
/// A page is the finest thing this profile can grant, so a window is judged by
/// pages: both ends on a page boundary, and inside the one device window the
/// board publishes a level-3 table for. Profile A's rule is different in FORM
/// (a naturally-aligned power of two, because a window there is one protection
/// entry) and identical in PURPOSE, which is why the predicate is per-HAL
/// rather than a shared check with two branches.
public func device_window_ok(base: UInt, len: UInt) -> Bool {
    if len < PROT_GRAIN || (len % PROT_GRAIN) != 0 {
        return false
    }
    if (base % PROT_GRAIN) != 0 {
        return false
    }
    base >= DEVICE_WINDOW_BASE && len <= DEVICE_WINDOW_BASE + DEVICE_WINDOW_LEN - base
}

/// An address the KERNEL itself cannot reach on this target. The level-1 entry
/// covering it is invalid, so a read is a translation fault taken at EL1. It is
/// NOT a low address: with the MMU on, low addresses are the device window and
/// reading one would simply succeed.
public static UNMAPPED_PROBE: UInt = 0x8000_0000

/// Publish the staged grant set: order the descriptor writes and flush the TLB.
/// Separate from `prot_region` so a partially programmed set is never live.
///
/// The barriers are the only part of this that is not Saw — see `sink.c`.
public func prot_commit() {
    sos_prot_commit()
}

/// The processor state a user context resumes in: EL0t, with D/A/F masked and I
/// NOT — interrupts are on in user mode and nowhere else (design 178 D2).
///
/// It is written into the frame rather than into the register at the transition,
/// which is what makes a context switch a frame swap: every thread carries the
/// state it resumes in, and the assembly reads it back like any other word.
static SPSR_EL0T: UInt = 0x340

/// Build a fresh user context in `frame_addr`: `entry` as the resume address,
/// `stack_top` as the user stack pointer, `arg0` in the first argument
/// register, and the saved processor state that selects EL0.
///
/// EVERY OTHER WORD IS ZEROED, which is the same promise the register-clearing
/// `sos_enter_user` used to make in assembly and is now made by a loop the
/// compiler can see: nothing of the kernel's, and nothing of another thread's,
/// crosses into a context this builds. The link register is among the zeroed
/// ones on purpose — a thread entry that RETURNS branches to zero and takes an
/// instruction abort, which spec §8 turns into the death of its process. That is
/// a diagnosed stop rather than a run into whatever follows.
///
/// AUDIT (design 1): NO PREEMPTION POINT. 36 word stores, and a half-built
/// context is an in-flight invariant the trap path can reach.
public func frame_init(frame_addr: UInt, entry: UInt, stack_top: UInt,
                       arg0: UInt) unsafe {
    var w: UInt = 0
    while w < FRAME_WORDS {
        UnsafeMemory<UInt, Normal>(frame_addr + w * WORD_BYTES).write(0)
        w = w + 1
    }
    let frame = frame_at(frame_addr)
    frame.elr.write(entry)
    frame.spsr.write(SPSR_EL0T)
    frame.sp.write(stack_top)
    frame.x0.write(arg0)
}

static WORD_BYTES: UInt = 8

/// Resume the context saved in `frame_addr`, in user mode. Never returns.
///
/// The FIRST entry to user mode, and the only one that is not `ktrap` handing a
/// frame back to the trap entry — which is why the assembly behind it is a
/// single branch into that entry's own restore path rather than a second copy
/// of it.
public func resume_frame(frame_addr: UInt) -> Never {
    sos_resume_frame(frame_addr)
    while { }
}

/// First byte of the appended payload — the `.payload` section `virt.ld`
/// bounds. Saw cannot name a linker symbol, so the bounds arrive through C.
///
/// **PHYSICAL, AND THE CONVERSION IS IN `sink.c`** (sawos design 29). A linker
/// symbol's address is a LINK address, and this kernel now links high — but a
/// payload's bounds are granted to EL0 and read by the loader as an image base,
/// which are both physical readings. So the C accessors mask, and every caller
/// keeps the number it always had.
public func payload_start() -> UInt {
    sos_payload_start()
}

/// One past the last byte of the appended payload. Equal to `payload_start()`
/// in an image built without one.
public func payload_end() -> UInt {
    sos_payload_end()
}

/// First byte of the BOOT REGION TABLE — the `.regions` section `virt.ld`
/// bounds (sawos design 2 D-2). Saw cannot name a linker symbol, so the bounds
/// arrive through C, exactly as the payload's do.
///
/// THE SECOND FIXED SYMBOL PAIR IN THE SYSTEM, and the only one this unit adds.
/// The table's own rows point at blob sections whose bases the LINKER resolves,
/// so those need no symbol the kernel can name — which is what keeps "one new
/// pair" true however many child images a build appends.
public func region_table_start() -> UInt {
    sos_region_table_start()
}

/// One past the last byte of the region table. Equal to
/// `region_table_start()` in an image built without one, which is ZERO REGIONS
/// and not an error — the ordinary state of every image that appends no
/// children.
public func region_table_end() -> UInt {
    sos_region_table_end()
}

// =============================================================================
// Traps
// =============================================================================

/// The `ESR_EL1` exception classes M1 can take from EL0 or take itself.
///
/// Backed by `UInt` — the width of the register the value arrives in. The
/// numbers are the architecture's, not ours, which is exactly why they are
/// pinned per case: a reorder here must never renumber them.
enum ExceptionClass: UInt {
    case Unknown = 0,
    case SimdFpTrap = 7,
    case IllegalState = 14,
    case Svc64 = 21,
    case InsnAbortLower = 32,
    case InsnAbortSame = 33,
    case PcAlignment = 34,
    case DataAbortLower = 36,
    case DataAbortSame = 37,
    case SpAlignment = 38,
    case Breakpoint = 60,
}

extension ExceptionClass {
    /// The short symbolic name a fault line reports.
    ///
    /// The vocabulary is deliberately the SAME on both profiles — a store that
    /// user mode was not granted is a `store-access-fault` whether the hardware
    /// called it a PMP violation or a data abort — so the harness asserts one
    /// string against two architectures and a reader who knows one profile can
    /// read the other's diagnostics.
    func describe(&self, iss: UInt) -> String {
        match self {
            case Unknown -> "unknown-reason",
            case SimdFpTrap -> "fp-access-trap",
            case IllegalState -> "illegal-instruction",
            case Svc64 -> "svc-from-user",
            case InsnAbortLower -> "instruction-access-fault",
            case InsnAbortSame -> "instruction-access-fault",
            case PcAlignment -> "instruction-address-misaligned",
            // A data abort says which direction it was in ISS bit 6, which is
            // the whole difference between the two Profile A causes.
            case DataAbortLower -> abort_direction(iss),
            case DataAbortSame -> abort_direction(iss),
            case SpAlignment -> "stack-address-misaligned",
            case Breakpoint -> "breakpoint",
        }
    }
}

/// ISS bit 6 (WnR) on a data abort: set means the access was a write.
///
/// **THE FAULT CLASS IS NORMALIZED HERE BY BEING IGNORED, AND THAT IS NOW A
/// DECISION RATHER THAN AN OMISSION** (sawos design 29). The ISS also carries a
/// `DFSC` field saying WHICH KIND of abort this was — translation, permission,
/// access flag, address size — and this decode reads none of it. §5.7 reports
/// what a process may act on: WHETHER it was refused and in WHICH DIRECTION.
/// Which table level noticed is the kernel's business.
///
/// It became load-bearing with this unit. Under design 27 a stray EL0 access to
/// a page its process was not granted hit a descriptor that was PRESENT and
/// EL0-denied, so it was a PERMISSION fault; the same access now finds an
/// INVALID descriptor and is a TRANSLATION fault. Both are `EC` 0x24, both come
/// through here, and both render `store-access-fault` / `load-access-fault`.
/// The vocabulary is also Profile A's, where a PMP violation has no class at
/// all — which is the deeper reason not to publish one.
///
/// **THE GATE CANNOT WITNESS THIS** (design 27 finding 3): the console
/// transcript holds pass/fail rows and build sizes, and every fault assertion in
/// the runner is the bare prefix `"SOS: fault "`. So the class change was checked
/// by PROBE — a case made to fault on a non-granted page, with the raw `ESR`
/// `fault_trap` prints read by hand — and design 29's As-built records the two
/// syndromes side by side.
func abort_direction(iss: UInt) -> String {
    if (iss & ISS_WNR) != 0 {
        "store-access-fault"
    } else {
        "load-access-fault"
    }
}

static ESR_EC_SHIFT: Int = 26
static ESR_EC_MASK: UInt = 0x3F
static ESR_ISS_MASK: UInt = 0x1FF_FFFF
static ISS_WNR: UInt = 0x40

/// Did this trap come from a syscall instruction, or is it a fault?
public func is_syscall(cause: UInt) -> Bool {
    ((cause >> ESR_EC_SHIFT) & ESR_EC_MASK) == (ExceptionClass.Svc64 as UInt)
}

/// The cause `boot.S`'s interrupt entry calls the kernel with.
///
/// An interrupt arrives on a VECTOR of its own here — there is no syndrome
/// register for it and nothing to decode — but the kernel's trap handler takes
/// one cause word for every trap, so the entry passes a value the syndrome
/// register cannot hold: this architecture's syndrome is 32 bits wide, so any
/// bit above that is impossible. `boot.S` builds the same value (`.equ
/// IRQ_CAUSE_HI`); the two are one description and must move together.
static IRQ_CAUSE: UInt = 1 << 32

/// Is this trap an interrupt rather than a syscall or a fault?
///
/// Interrupts only ever arrive from USER mode (design 178 D2): they are masked
/// at this exception level throughout, and the vector table sends an interrupt
/// taken at kernel level to the kernel-bug path rather than to the kernel.
public func is_interrupt(cause: UInt) -> Bool {
    cause == IRQ_CAUSE
}

/// A short symbolic name for a raw `ESR_EL1` value.
///
/// The decode is where an unknown class stops being a number: `from(raw:)` is
/// total, and the hardware may raise a class this kernel does not model, so the
/// miss has its own name rather than an arm. Everything it DOES model is an
/// exhaustive `match` in `describe`, so a class added to the enum fails to
/// compile until it is given a name.
public func cause_tag(cause: UInt) -> String {
    let ec = (cause >> ESR_EC_SHIFT) & ESR_EC_MASK
    guard let decoded = ExceptionClass.from(raw: ec) else {
        return "unexpected-trap"
    }
    decoded.describe(cause & ESR_ISS_MASK)
}

/// Overlay the saved context. One view construction, then ordinary field names.
func frame_at(frame_addr: UInt) unsafe -> UnsafeMemory<TrapFrame, Normal> {
    UnsafeMemory<TrapFrame, Normal>(frame_addr)
}

/// Where the trapped context resumes — the faulting instruction on a fault, the
/// interrupted one on an interrupt. (It was `fault_pc` until interrupts had a
/// use for it too; the value never was fault-specific.)
public func trap_pc(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).elr.read()
}

/// §5.7: x0 = handle, x8 = op, args x1-x5.
public func syscall_handle(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).x0.read()
}

public func syscall_op(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).x8.read()
}

public func syscall_arg0(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).x1.read()
}

public func syscall_arg1(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).x2.read()
}

public func syscall_arg2(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).x3.read()
}

/// Place a syscall's (status, value) pair where the caller will find it.
///
/// Nothing advances the saved PC here, and that is the interesting difference
/// from Profile A: `svc` traps with `ELR_EL1` already pointing at the following
/// instruction, so a kernel that "stepped past the syscall" would skip a real
/// one. Which is precisely why advancing is the HAL's decision and not the
/// kernel's.
public func syscall_return(frame_addr: UInt, status: UInt, value: UInt) unsafe {
    let frame = frame_at(frame_addr)
    frame.x0.write(status)
    frame.x1.write(value)
}

// =============================================================================
// Diagnostics (design 172 unit 3)
// =============================================================================
//
// The kernel-bug path formats its own report. It used to be C — a `put_str` and
// a `put_hex` beside the fault handler — which was a second copy of what
// `rt/common/` already does in Saw, and which printed a fixed sixteen hex
// digits whether or not that was the word width.
//
// This is NOT the panic seam. `__saw_rt_write` below has a stricter contract
// and shares none of this: these two use `String` and the ordinary runtime,
// which is fine on a path the kernel reaches having already decided to stop.

/// Write an ASCII string to the console, byte by byte.
func report_str(msg: String) {
    for scalar in msg.chars() {
        console_byte(ascii_byte(scalar))
    }
}

/// Write a machine word as `0x` + one hex digit per nibble, at THIS target's
/// width — sixteen here, eight on Profile A.
func report_hex(v: UInt) {
    report_str("0x")
    let digits = hex_digits_per_word()
    var n = 0
    while n < digits {
        console_byte(hex_digit_of(v, n))
        n = n + 1
    }
}

// =============================================================================
// The kernel-bug path (design 172 unit 3)
// =============================================================================

/// Set once a kernel fault is being reported, so a SECOND fault taken while
/// reporting exits immediately instead of looping on the console.
///
/// Compound global state resting on a serialization argument the compiler
/// cannot see, which is design 149's `unsafe static var` rather than an
/// `Atomic`: SOS v1 is a uniprocessor kernel that enables no interrupt sources
/// (spec §7), and this flag is only ever touched with the machine already
/// failing.
unsafe static var IN_KERNEL_FAULT: UInt8 = 0

/// A trap the KERNEL itself took, i.e. a kernel bug. Reports the exception
/// class and stops the machine with it as the status — the arm64 spelling of
/// Profile A's "cause in the finisher's code bits". Never returns, and never
/// hangs (M0's discipline, kept).
///
/// `boot.S` reads the three system registers, because `mrs` names a register at
/// assembly time and Saw cannot spell one. Everything after that is formatting.
@export("sos_kernel_fault")
public func kernel_fault(esr: UInt, elr: UInt, far: UInt) unsafe {
    let ec = (esr >> ESR_EC_SHIFT) & ESR_EC_MASK
    if IN_KERNEL_FAULT != 0 {
        exit_fail(ec)
    }
    IN_KERNEL_FAULT = 1
    report_str("SOS: kernel fault ec=")
    report_hex(ec)
    report_str(" elr=")
    report_hex(elr)
    report_str(" far=")
    report_hex(far)
    report_str("\n")
    exit_fail(ec)
}

// =============================================================================
// The static identity map: this profile's isolation primitive
// =============================================================================
//
// Spec §5b: on Profile B an AddressSpace is a page-table root. M1b implements
// the STATIC parity of Profile A's PMP and nothing more (design 162 decision
// 2): one identity map, built once at boot, whose only mutable part is the EL0
// permission bits of the pages a root image was granted. No dynamic mapping, no
// ASIDs, no address-space switch — Mapping objects are M2.
//
// The shape:
//
//   level 1 (1 GiB entries, 39-bit VA out of the low translation base)
//     [0]  0x0000_0000  -> the DEVICE level 2
//     [1]  0x4000_0000  -> level 2
//     rest             INVALID, which is what makes UNMAPPED_PROBE fault
//   level 2 (2 MiB entries over RAM)
//     [0], [1]         -> level 3 tables: the GRANT WINDOW, page-granular
//     rest             2 MiB blocks, EL1 RW, no EL0
//   level 3 (4 KiB pages over the first 4 MiB of RAM)
//     reset state      EL1 read/write/EXECUTE, no EL0 access at all
//     granted pages    EL0 RO or RW, never EL0-writable-and-executable
//   device level 2 (2 MiB entries below RAM)
//     all              Device blocks, EL1 RW, never executable at either level
//     except the one   containing the console UART -> the device level 3
//   device level 3 (4 KiB device pages over that one 2 MiB block)
//     reset state      Device, EL1 RW, no EL0 access at all
//     granted pages    Device-nGnRE, EL0 RW, never executable
//
// The grant window covers the kernel image AND the root region, because BOTH
// need page granularity: the root region obviously, and the kernel image
// because the harness's unit-A cases grant a payload that executes in place
// inside it. Everything outside the window is EL1-only, so EL0 default-deny is
// the same property PMP gives Profile A for free — a page EL0 was never granted
// is a translation fault, not a permitted access.
//
// THE DEVICE HALF IS THE SAME SHAPE ONE LEVEL SHALLOWER (design 178's finale
// constraint 3). The whole device space was one 1 GiB block until a process
// could be granted a register page, and a block is not a grant unit: granting
// EL0 the block that holds the console would have handed over every peripheral
// beside it. So the block became a table, and the ONE 2 MiB block that holds
// the console became a table too — which is the minimum that makes a single
// page grantable, and costs two more page-sized tables.
//
// The kernel's own pages stay EL1-RWX: that is the arm64 spelling of "M-mode is
// unconstrained", not a claim about kernel W^X, which neither profile has yet.
//
// DESIGN 172 UNIT 1: all of the above is arithmetic and 64-bit stores, so it is
// Saw. What stays native is the ACTIVATION — four `msr`s, a barrier pair and a
// TLB flush — because a system register is named at assembly time. `sink.c` is
// that leaf and nothing else: it asks this file for a finished table and turns
// the MMU on.

/// The five translation tables, back to back: 512 level-1 descriptors, 512
/// level-2, 1024 level-3 covering the RAM grant window, then 512 device level-2
/// and 512 device level-3 covering the console's 2 MiB of device space.
///
/// ONE region with a page of slack rather than five arrays, because the
/// hardware requires each table to be page-aligned and Saw has no alignment
/// attribute on a static. Rounding the base up at run time costs three
/// instructions at boot and asks nothing of the linker script — which matters,
/// because the linker script is per-profile and the shape of this is not.
///
/// THE SLACK IS EXACTLY ENOUGH, and the arithmetic is worth writing down
/// because a future edit to `GRANT_PAGES` has to redo it. ONE SET needs
/// 512 + 512 + 1024 + 512 + 512 = 3072 descriptors (24 KiB). A `[UInt64; N]`
/// static is 8-aligned, so rounding its address up to 4096 advances the base by
/// at most 4096 - 8 = 4088 bytes, which is 511 descriptors. Add a table and the
/// trailing 512 has to grow with it.
///
/// All-zero, so it costs no image bytes (design 149). An unwritten descriptor
/// is INVALID, which is the state a default-deny map wants anyway.
/// Level 1, level 2, the two RAM level-3 tables, the device level 2 and the
/// device level 3 — written once so the length and the initializer cannot
/// disagree.
static PT_SET_DESCRIPTORS: Int = 512 + 512 + 1024 + 512 + 512

/// Bytes in one set. The same number as `PT_SET_DESCRIPTORS * DESC_BYTES`,
/// spelled in `UInt` because it is address arithmetic; the assert below is what
/// keeps the two spellings from drifting.
static PT_SET_BYTES: UInt = (512 + 512 + 1024 + 512 + 512) * 8

/// **HOW MANY PERSISTENT TABLE SETS THE POOL HOLDS — one per process slot**
/// (sawos design 27, M5 unit 1; design 25 D-3's static per-process pools).
///
/// It is `MAX_PROCESSES`, and it is declared HERE rather than read from the
/// kernel because a HAL that had to import the kernel to size its own page
/// tables would be the wrong way round — the same reason `align_up` is
/// duplicated below. `kernel/core/limits.saw` static_asserts that the kernel's
/// `MAX_PROCESSES` fits this, exactly as it already does for
/// `GRANT_ROW_BUDGET`, so the two cannot disagree without the build saying so.
public static PROT_DOMAIN_SLOTS: Int = 3

/// **THE KERNEL'S OWN TABLES — the LINEAR MAP, and it exists ONCE** (sawos
/// design 29). Three tables: a level 1, a level 2 over the device gigabyte, and
/// a level 2 over RAM's gigabyte. No level 3 anywhere, because nothing in the
/// kernel's own map is granted a page at a time — page granularity is a
/// property of the USER windows, which live in TTBR0 and in the per-process
/// sets above.
///
/// **THIS IS WHAT THE PER-PROCESS SETS STOPPED CARRYING.** Before this unit
/// every set repeated the whole EL1 half — 2 MiB identity blocks over all of
/// RAM and over the device space — because `TCR_EL1.EPD1` was set and the high
/// half was not walked at all, so kernel mappings had nowhere else to live.
/// TTBR1 is open now and they live here, once.
static LINMAP_DESCRIPTORS: Int = 512 + 512 + 512

/// Bytes in the linear map, the `UInt` spelling for address arithmetic.
static LINMAP_BYTES: UInt = (512 + 512 + 512) * 8

/// The pool: one set per process slot, back to back, then the LINEAR MAP, plus
/// one table's worth of alignment slack for the run-time round-up.
///
/// The slack argument is unchanged and is stated at `PT_SET_DESCRIPTORS`: a
/// `[UInt64; N]` static is 8-aligned, so rounding its base up to a page costs at
/// most 511 descriptors, and one spare table covers that however many sets and
/// kernel tables sit behind it.
static PT_DESCRIPTORS: Int = (PT_SET_DESCRIPTORS * PROT_DOMAIN_SLOTS
                              + LINMAP_DESCRIPTORS + 512)

unsafe static var PAGE_TABLES: [UInt64; PT_DESCRIPTORS] = [0; PT_DESCRIPTORS]

/// **WHICH SET IS LIVE IN `TTBR0_EL1`.** Written only by `prot_switch`.
///
/// It is what makes `prot_reset` / `prot_region` / `prot_device` mean "edit the
/// CURRENTLY LOADED set", which is the contract the six legacy harness kernels
/// in `tests/` rely on: they program the protection surface directly, hold no
/// grant record and never switch a domain, so they must keep reaching the set
/// the machine is actually running on.
///
/// `unsafe static var` by design 149's rule — one word of compound global state
/// resting on spec §7's serialization argument (uniprocessor, and every writer
/// runs with no preemption point in it).
unsafe static var CURRENT_SET: UInt = 0

/// Descriptors per table at the 4 KiB granule: a table is one page of 8-byte
/// entries.
static PT_ENTRIES: UInt = 512
/// Pages the level-3 tables cover — 4 MiB reachable at page granularity.
static GRANT_PAGES: UInt = 1024
static PAGE_SIZE: UInt = 4096
static DESC_BYTES: UInt = 8
/// Byte offsets of the later tables within `PAGE_TABLES`.
static LEVEL2_OFFSET: UInt = 4096
static LEVEL3_OFFSET: UInt = 8192
static DEVICE_LEVEL2_OFFSET: UInt = 16_384
static DEVICE_LEVEL3_OFFSET: UInt = 20_480

static RAM_BASE: UInt = 0x4000_0000

/// How much RAM this board wires — `virt.ld`'s `MEMORY` LENGTH, restated here
/// because the LINEAR MAP has to know where to stop. Mapping exactly the RAM
/// that exists (rather than the whole gigabyte the level-1 entry covers) is what
/// makes a kernel dereference past the end of memory a translation fault instead
/// of a read of nothing.
static RAM_LEN: UInt = 128 * 1024 * 1024

// The linear map's own bound, and the last of design 29's build-time checks:
// every byte of RAM must fit under the offset for `pa | LINMAP_OFFSET` to be a
// pure OR. The device asserts sit with the seam, beside the board's MMIO bases.
static_assert(RAM_BASE + RAM_LEN - 1 <= LINMAP_PHYS_MASK,
              "RAM must fit under the linear-map offset for the OR/AND pair to be exact")

static PAGE_SHIFT: Int = 12
/// Where the ASID sits in `TTBR0_EL1` — bits 63:48, of which `TCR_EL1.AS` = 0
/// makes bits 55:48 significant. Three process slots use three of those 256.
static TTBR_ASID_SHIFT: Int = 48
static BLOCK_SHIFT: Int = 21              // a level-2 block is 2 MiB
static MAIR_INDEX_SHIFT: Int = 2          // descriptor bits 4:2

/// The 2 MiB block the console UART sits in, and its base. The device level-3
/// table covers exactly this block, so a page grantable to EL0 is a page inside
/// it — which is the whole of what M2 needs and is checked rather than assumed
/// (`prot_device` diagnoses anything else).
static DEVICE_WINDOW_BASE: UInt = (UART_BASE >> BLOCK_SHIFT) << BLOCK_SHIFT
static DEVICE_WINDOW_LEN: UInt = 1 << BLOCK_SHIFT

// Descriptor bits (ARMv8-A VMSA, 4 KiB granule). Each is a lone architectural
// bit position — a standalone quantity, which is what a `static` is for. The
// two descriptor fields that are genuinely a CLOSED SET of alternatives are the
// enums below, where an exhaustive `match` and a pinned value are worth having.
static DESC_VALID: UInt64 = 0x1
static DESC_BLOCK: UInt64 = 0x0           // bit 1 clear at levels 1-2
static DESC_TABLE: UInt64 = 0x2           // bit 1 set at levels 1-2
static DESC_PAGE: UInt64 = 0x2            // at level 3 the same bit means "page"
static ATTR_SH_INNER: UInt64 = 0x300      // bits 9:8 — inner shareable
static ATTR_AF: UInt64 = 0x400            // bit 10 — access flag
/// Bit 11 — NOT GLOBAL: this translation belongs to the ASID that installed it.
///
/// **IT IS WHAT MAKES A PER-PROCESS SET SAFE TO CACHE** (sawos design 27). The
/// same VA is mapped in every set — root's stack page is EL0-RW in root's
/// tables and EL1-only in a child's — so a GLOBAL entry for that VA would let
/// one process's cached translation answer another's access. Every descriptor
/// the two grant windows hold carries this bit; the 2 MiB EL1 blocks outside
/// the windows stay global on purpose, because they are identical in every set
/// and sharing one TLB entry for them across processes is free and correct.
static ATTR_NG: UInt64 = 0x800
static ATTR_PXN: UInt64 = 0x20_0000_0000_0000   // bit 53 — no execute at EL1
static ATTR_UXN: UInt64 = 0x40_0000_0000_0000   // bit 54 — no execute at EL0

/// The access-permission field, descriptor bits 7:6. Exactly one of the four is
/// in a descriptor, which is what makes this an enum rather than four constants
/// that could be OR-ed together by accident.
enum AccessPerm: UInt64 {
    case El1Rw = 0,          // EL1 read/write, EL0 no access
    case El0Rw = 64,         // EL1 + EL0 read/write
    case El1Ro = 128,        // EL1 read-only, EL0 no access
    case El0Ro = 192,        // EL1 + EL0 read-only
}

/// Which memory-attribute index a descriptor selects. The case VALUE is the
/// index, and `mair_value()` below builds the register those indices describe
/// out of the same cases — so a type added here cannot leave its attribute byte
/// behind.
///
/// TWO DEVICE TYPES, AND THE DIFFERENCE IS RULED (design 178's finale
/// constraint 3). `Device` is the strictest the architecture has —
/// non-Gathering, non-Reordering, no Early write acknowledgement — and is what
/// the kernel maps its own MMIO with, because a kernel that touches a
/// controller register wants nothing between the store and the device.
/// `DeviceNGnRE` relaxes exactly one of those: a write may be acknowledged
/// before it reaches the peripheral, which is the ordinary attribute for a
/// driver's register block and what a granted device page carries. What NEITHER
/// may be is Normal-cacheable: a cached PL011 mapping would let a register read
/// come out of a line filled minutes ago, which is a correctness bug and not a
/// performance one.
enum MemoryType: UInt64 {
    case Device = 0,         // Device-nGnRnE
    case Normal = 1,         // Normal, write-back, read/write-allocate
    case DeviceNGnRE = 2,    // Device, early write acknowledgement permitted
}

extension MemoryType {
    /// This type as the attribute-index bits of a descriptor.
    func attr_index(&self) -> UInt64 {
        (self as UInt64) << MAIR_INDEX_SHIFT
    }
}

static MAIR_ATTR_DEVICE: UInt = 0x00
static MAIR_ATTR_NORMAL: UInt = 0xFF
static MAIR_ATTR_DEVICE_NGNRE: UInt = 0x04
static BITS_PER_MAIR_ATTR: Int = 8

/// The memory-attribute register the `MemoryType` indices describe: one byte
/// per index, low index first.
///
/// It crosses to the C activation leaf with the table address, rather than
/// being spelled again there, because it is the OTHER HALF of the descriptor
/// encoding this file owns — a memory type added above would otherwise need a
/// matching edit in C with nothing to catch a missed one.
@export("sos_mair_value")
func mair_value() -> UInt {
    ((MAIR_ATTR_DEVICE << (BITS_PER_MAIR_ATTR * ((MemoryType.Device as UInt64) as Int)))
     | (MAIR_ATTR_NORMAL << (BITS_PER_MAIR_ATTR * ((MemoryType.Normal as UInt64) as Int)))
     | (MAIR_ATTR_DEVICE_NGNRE
        << (BITS_PER_MAIR_ATTR * ((MemoryType.DeviceNGnRE as UInt64) as Int))))
}

/// This HAL's own failure code, distinct from anything the kernel or root
/// chooses. A grant the window cannot express is a kernel bug, not an image
/// problem, so it does not travel through the loader's `fatal_image`.
static ABORT_GRANT_OUTSIDE_WINDOW: UInt = 66

/// Round `v` up to the next multiple of `align` (a power of two).
///
/// The kernel core has one of these too and they are deliberately not shared:
/// a HAL that had to import the kernel to build its own page tables would be
/// the wrong way round.
func align_up(v: UInt, align: UInt) -> UInt {
    let rem = v & (align - 1)
    if rem == 0 {
        v
    } else {
        v + (align - rem)
    }
}

/// The page-aligned PHYSICAL base of the whole pool — set 0's level-1 table.
///
/// **PHYSICAL, AND THAT IS THE WHOLE OF WHY THE CONVERSION IS HERE** (sawos
/// design 29). Everything downstream of this number is hardware's reading of it:
/// a `TTBR` holds a physical table base, and so does every table descriptor that
/// points at a next level. The pointer arrives as a KERNEL address — a Saw
/// reference to a static, which the linker placed in the high half — so this is
/// one of the seam's few `virt_to_phys` sites, and `put_desc` converts back at
/// the store.
///
/// Alignment survives the conversion in either order: the offset's low
/// `VA_BITS` bits are zero and `PAGE_SIZE` divides `2^VA_BITS`, so masking never
/// disturbs a page boundary.
func pool_base() unsafe -> UInt {
    align_up(virt_to_phys(((&var PAGE_TABLES) as UnsafePointer<UInt64>) as UInt),
             PAGE_SIZE)
}

/// The page-aligned base of `set`'s five tables.
///
/// Sets are `PT_SET_BYTES` apart and the pool base is page-aligned, so every
/// set's level-1 table is page-aligned too — which is what the hardware
/// requires and what makes one round-up serve the whole pool.
func set_base(set: UInt) unsafe -> UInt {
    pool_base() + set * PT_SET_BYTES
}

/// The page-aligned base of the LIVE set's tables.
///
/// The name is unchanged from the single-set era on purpose: every existing
/// caller means "the set the machine is running on", and that is still exactly
/// what this answers.
func tables_base() unsafe -> UInt {
    set_base(CURRENT_SET)
}

/// Write descriptor `index` of the table at PHYSICAL address `table`.
///
/// **THE ONE DEREFERENCE OF A TABLE ADDRESS IN THIS FILE** (sawos design 29).
/// Table addresses travel as physical throughout — they are what a descriptor
/// and a `TTBR` hold — so the linear-map conversion belongs at the store rather
/// than at each of the dozen places a table base is computed. Every window
/// walk, every set build and every grant edit reaches memory through this line.
func put_desc(table: UInt, index: UInt, desc: UInt64) unsafe {
    UnsafeMemory<UInt64, Normal>(phys_to_virt(table + index * DESC_BYTES)).write(desc)
}

/// **AN UNGRANTED PAGE — AND IT IS NOW GENUINELY ABSENT** (sawos design 29).
///
/// A zero descriptor is INVALID, which is the whole encoding: no output
/// address, no permissions, no attributes to get wrong. Nothing else is needed
/// to say "this process was not given these bytes".
///
/// **THE UNIT-1 REASON IT COULD NOT BE ZERO HAS DISSOLVED.** Design 27 had to
/// leave every window page PRESENT and EL1-only, because the kernel's own
/// `.text`, its stack and its table pool all sit inside the 4 MiB window and the
/// per-process set was the ONLY map — so an absent page there would have
/// unmapped the kernel from itself, and `place_image`/`copy_in`/`copy_out`
/// reached a peer's RAM through whatever set happened to be live. Both of those
/// now go through TTBR1's linear map, which no process switch touches, so
/// TTBR0 owes the kernel nothing at all and a set holds ONLY its process's
/// grants.
///
/// What that buys, beyond the low half becoming purely the user's: isolation
/// here is now the absence of a TRANSLATION rather than the absence of a
/// permission — which is what design 27's own As-built said it could not yet
/// claim at the descriptor level, even while it held at the table level.
///
/// The `va` parameter is gone with the body: an invalid descriptor names no
/// address. Both windows share this one spelling, RAM and device alike, because
/// "not granted" has no per-window flavour once it stops carrying attributes.
static DESC_ABSENT: UInt64 = 0

/// Every page of the window back to ungranted.
func reset_window(level3: UInt) unsafe {
    var i: UInt = 0
    while i < GRANT_PAGES {
        put_desc(level3, i, DESC_ABSENT)
        i = i + 1
    }
}

/// Every page of the DEVICE window back to ungranted.
func reset_device_window(level3: UInt) unsafe {
    var i: UInt = 0
    while i < PT_ENTRIES {
        put_desc(level3, i, DESC_ABSENT)
        i = i + 1
    }
}

/// The physical base of the LINEAR MAP's level-1 table — the value `TTBR1_EL1`
/// holds for the life of the machine.
///
/// It sits after every process set in the same pool, which is what lets one
/// run-time round-up serve the whole thing.
func linmap_base() unsafe -> UInt {
    pool_base() + (PROT_DOMAIN_SLOTS as UInt) * PT_SET_BYTES
}

/// Which 2 MiB block of RAM the kernel image occupies — the one block the
/// linear map leaves executable. Zero, and `virt.ld`'s `_bss_end` assert is what
/// keeps it so; see `linmap_build`.
static KERNEL_IMAGE_BLOCK: UInt = 0

/// This HAL's second failure code: the linker script and this file disagree
/// about where the kernel lives. Distinct from `ABORT_GRANT_OUTSIDE_WINDOW` and
/// from anything the kernel or root chooses.
static ABORT_LINMAP_OFFSET: UInt = 67

/// **DO THE LINKER SCRIPT AND THIS FILE AGREE ABOUT WHERE THE KERNEL LIVES?**
///
/// `LINMAP_OFFSET` is written twice — here, and in `virt.ld`, which adds it to
/// the load address and takes it back off with `AT`. Nothing at build time can
/// compare the two (a Saw `static`'s VALUE is not a linker symbol, so neither
/// side can assert against the other), so they are compared at BOOT instead,
/// against the address the linker actually gave a static this file owns. One
/// `and` and two compares, once, on a path that runs before anything can depend
/// on being wrong.
///
/// It runs FIRST in `linmap_build`, while the boot tables are still live and the
/// console still answers — which is what makes the report reachable rather than
/// a silent stop.
func linmap_offset_probe() unsafe {
    let here = ((&var PAGE_TABLES) as UnsafePointer<UInt64>) as UInt
    if (here & LINMAP_OFFSET) != LINMAP_OFFSET {
        report_str("SOS: kernel is not linked in the high half: ")
        report_hex(here)
        report_str("\n")
        exit_fail(ABORT_LINMAP_OFFSET)
    }
    let pa = virt_to_phys(here)
    if pa < RAM_BASE || pa >= RAM_BASE + RAM_LEN {
        report_str("SOS: kernel physical address is outside RAM: ")
        report_hex(pa)
        report_str("\n")
        exit_fail(ABORT_LINMAP_OFFSET)
    }
}

/// **BUILD THE KERNEL'S OWN MAP AND HAND BACK ITS LEVEL-1 BASE** (sawos design
/// 29). `boot.S` installs it in `TTBR1_EL1` from the identity map and never
/// writes that register again.
///
/// Two level-2 tables and nothing finer: 2 MiB Device blocks over the device
/// gigabyte, 2 MiB Normal blocks over the RAM this board actually wires. A
/// kernel dereference past `RAM_LEN` finds an invalid descriptor rather than a
/// mapping of nothing, which is why the walk stops at the real length instead of
/// filling the level-1 entry's whole gigabyte.
///
/// **PXN EVERYWHERE THE KERNEL'S OWN TEXT IS NOT** — the W^X improvement this
/// unit gets for free. Before it, every set carried EL1 blocks over ALL of RAM
/// with PXN clear, so all 128 MiB was kernel-executable; here exactly one 2 MiB
/// block is, and it is the one the image occupies. The device half is PXN and
/// UXN throughout: registers are not instructions.
///
/// **WHAT MAKES "EXACTLY ONE BLOCK" TRUE IS AN ASSERT THAT ALREADY EXISTED.**
/// `virt.ld` requires the whole kernel image to end below `ROOT_LOAD_BASE`
/// (0x4020_0000) so that `.bss` cannot overrun root's load address — and that
/// bound IS the top of RAM's first 2 MiB block. So the linker script's ceiling
/// and this carve-out are one number, and an image that outgrew the block would
/// stop the BUILD rather than silently run non-executable. Said at both ends.
///
/// **NOT TAKEN, AND RECORDED AS A LIMIT:** per-section W^X inside that block —
/// `.text` RX, `.rodata` RO, `.data`/`.bss` RW — which wants a level-3 table and
/// page-aligned section bounds the linker script does not publish today. The
/// block is EL1 RWX, so the kernel's own data is executable to the kernel. That
/// is strictly better than the 128 MiB it was and strictly short of the page
/// granularity this machinery could express; whoever wants it adds three linker
/// symbols and a level 3 here.
///
/// AUDIT (design 1): NO PREEMPTION POINT — 578 descriptor stores, before
/// `kmain`, with no interrupt controller yet. Pre-IRQ by construction.
@export("sos_linmap_build")
func linmap_build() unsafe -> UInt {
    linmap_offset_probe()

    let level1 = linmap_base()
    let dev_level2 = level1 + LEVEL2_OFFSET
    let ram_level2 = level1 + LEVEL3_OFFSET

    put_desc(level1, 0, (dev_level2 as UInt64) | DESC_VALID | DESC_TABLE)
    put_desc(level1, 1, (ram_level2 as UInt64) | DESC_VALID | DESC_TABLE)

    // The device gigabyte: everything below RAM, EL1 read/write, never
    // executable at either level, strictest device attribute. The kernel's UART
    // and its interrupt controller are both in here.
    var d: UInt = 0
    while d < PT_ENTRIES {
        put_desc(dev_level2, d,
                 ((d << BLOCK_SHIFT) as UInt64)
                 | DESC_VALID | DESC_BLOCK | MemoryType.Device.attr_index()
                 | ATTR_AF | (AccessPerm.El1Rw as UInt64) | ATTR_PXN | ATTR_UXN)
        d = d + 1
    }

    // RAM: Normal cacheable, inner shareable, EL1 read/write, never executable
    // at EL0. GLOBAL on purpose — these translations belong to the kernel rather
    // than to an address space, so `ATTR_NG` would be wrong here and would cost
    // a TLB entry per process for a mapping every process shares.
    var i: UInt = 0
    while i < (RAM_LEN >> BLOCK_SHIFT) {
        var block = (((RAM_BASE + (i << BLOCK_SHIFT)) as UInt64)
                     | DESC_VALID | DESC_BLOCK | MemoryType.Normal.attr_index()
                     | ATTR_AF | ATTR_SH_INNER | (AccessPerm.El1Rw as UInt64)
                     | ATTR_UXN)
        if i != KERNEL_IMAGE_BLOCK {
            block = block | ATTR_PXN
        }
        put_desc(ram_level2, i, block)
        i = i + 1
    }
    level1
}

/// Build the per-process table sets and hand back set 0's base, which is what
/// `TTBR0_EL1` starts on.
///
/// **IT RUNS WITH THE MMU ALREADY ON** (sawos design 29), from `boot.S` after
/// the jump into the high half and through the boot tables that jump installed.
/// That is the reversal this unit makes: it used to run with translation OFF,
/// where physical and virtual coincided and nothing had to convert. Now
/// `put_desc` converts, and the addresses in every descriptor stay physical.
///
/// AUDIT (design 1): NO PREEMPTION POINT in any of the walks below (~2560
/// descriptor stores per set, so ~7680 at `PROT_DOMAIN_SLOTS` 3 — sawos design
/// 27 multiplied the count and changed nothing else about the argument). This
/// runs before `kmain`, with no interrupt controller yet — pre-IRQ by
/// construction, so there is nothing a point could deliver.
@export("sos_page_tables_build")
func page_tables_build() unsafe -> UInt {
    var set: UInt = 0
    while set < (PROT_DOMAIN_SLOTS as UInt) {
        build_set(set_base(set))
        set = set + 1
    }
    // Set 0 is `ROOT_PROCESS`'s (`kernel/core/limits.saw`: `ROOT_PROCESS = 0`),
    // and the boot door's `load_domain(ROOT_PROCESS)` switches to it explicitly
    // — so the ASID the machine starts on and the one root runs under are the
    // same number, and nothing runs on a set that is not its own.
    set_base(0)
}

/// Build ONE complete set at `level1`: the two USER WINDOWS, empty, and the
/// tables that reach them.
///
/// **A SET IS NOW THE PROCESS'S WINDOWS AND NOTHING ELSE** (sawos design 29).
/// `TTBR0_EL1` is purely the user's register: a set maps the 4 MiB RAM grant
/// window and the console's device block at page granularity, both starting
/// ungranted, and every other address in the low half is INVALID — no EL1
/// blocks over RAM, no EL1 device blocks, no kernel anything.
///
/// **WHAT PAID FOR THAT IS TTBR1.** Design 27 had to repeat the whole EL1 half
/// in every set, and its own As-built gives the two reasons: `TCR_EL1.EPD1` was
/// set so the high half was not walked at all, and the cross-process copy
/// funnels (`place_image`, `copy_in`, `copy_out`) reached a peer's RAM through
/// whatever set `TTBR0_EL1` happened to hold. Both are gone. EPD1 is clear and
/// the LINEAR MAP is in TTBR1, which no switch touches; the copy funnels convert
/// the physical address they already resolve and dereference through it. So the
/// kernel is reachable from itself no matter which set is live — including no
/// set at all — and the low half owes it nothing.
///
/// **AND THE FAULT CLASS CHANGES, DELIBERATELY.** A stray EL0 access to a
/// non-granted window page used to be a PERMISSION fault (the page was present
/// and EL0-denied); it is a TRANSLATION fault now. §5.7's reported reason does
/// not move, because `cause_tag` decodes the ESR's `EC` field and the direction
/// bit and never the `DFSC` class — both are `EC` 0x24 and both render through
/// `abort_direction`. That is stated at the decode, and design 29's As-built
/// records the probe that checked it rather than the transcript, which cannot
/// see a fault class at all (design 27 finding 2).
///
/// The level-2 and device level-2 tables stay full-size even though one entry
/// each is now live: a translation table is a PAGE, so an entry that goes away
/// frees a descriptor and never a table. That is why removing the kernel blocks
/// made the sets no smaller — recorded in design 29's As-built, where the brief
/// expected otherwise.
func build_set(level1: UInt) unsafe {
    let level2 = level1 + LEVEL2_OFFSET
    let level3 = level1 + LEVEL3_OFFSET
    let dev_level2 = level1 + DEVICE_LEVEL2_OFFSET
    let dev_level3 = level1 + DEVICE_LEVEL3_OFFSET

    // Level 1: a table over the device space below RAM, a table over RAM, and
    // nothing else — every other entry stays zero, i.e. INVALID.
    put_desc(level1, 0, (dev_level2 as UInt64) | DESC_VALID | DESC_TABLE)
    put_desc(level1, 1, (level2 as UInt64) | DESC_VALID | DESC_TABLE)

    // The device level 2: ONE live entry, the block holding the console, which
    // points at a level-3 table so a single register page can be granted to EL0.
    // Every other entry stays zero — the kernel reaches its own MMIO through the
    // linear map now, so a user set has no reason to name it.
    put_desc(dev_level2, DEVICE_WINDOW_BASE >> BLOCK_SHIFT,
             (dev_level3 as UInt64) | DESC_VALID | DESC_TABLE)
    reset_device_window(dev_level3)

    // Level 2 over RAM: the grant window's entries point at the level-3 tables,
    // where permissions are editable a page at a time. Every other entry stays
    // zero, which is what makes RAM outside the window unreachable from this
    // process at all rather than merely EL0-denied.
    var t: UInt = 0
    while t < GRANT_PAGES / PT_ENTRIES {
        put_desc(level2, t,
                 ((level3 + t * PT_ENTRIES * DESC_BYTES) as UInt64)
                 | DESC_VALID | DESC_TABLE)
        t = t + 1
    }

    reset_window(level3)
}

/// A grant the window cannot express. Never returns.
///
/// Skipping the page would be safe in the deny direction — EL0 simply would not
/// reach it — but it would mean the kernel silently granted LESS than it was
/// asked for, and the symptom would be a user-mode fault at some unrelated
/// later address. The only way to get here is a memory map that outgrew the
/// window, which is a kernel bug and reads as one.
func grant_outside_window(va: UInt) {
    report_str("SOS: grant outside the page-granular window: ")
    report_hex(va)
    report_str("\n")
    exit_fail(ABORT_GRANT_OUTSIDE_WINDOW)
}

/// Revoke every grant. User mode then reaches nothing at all — the default-deny
/// the grants below carve out of.
///
/// BOTH windows, because a device grant is as revocable as a RAM one: a new
/// process must not inherit the last one's registers.
///
/// AUDIT (design 1): NO PREEMPTION POINT here or in the `prot_region` /
/// `prot_device` walks below (at most 1536 RAM stores between them). They are
/// bounded and RAM-speed, microseconds; and a HALF-REWRITTEN descriptor table is
/// exactly an in-flight invariant — the staged `prot_*` sequence is one edit,
/// published by `prot_commit`.
public func prot_reset() unsafe {
    reset_window(tables_base() + LEVEL3_OFFSET)
    reset_device_window(tables_base() + DEVICE_LEVEL3_OFFSET)
}

/// Stage grant `idx` as [base, top) with `perms`, a mask in the `SegFlag`
/// vocabulary.
///
/// `idx` is unused here: PMP has a fixed number of NUMBERED regions and this
/// profile has pages, so the index is a Profile-A budget concept the seam
/// carries for both.
///
/// A grant installs exactly the permissions the image asked for — the same
/// contract Profile A's PMP has, so the two profiles cannot disagree about what
/// an image means. (W^X is the linker script's property and the loader's
/// `has_sane_perms` validation; silently dropping a bit the image asked for
/// would be the kind of quiet no-op that hides a bad image rather than refusing
/// it.) `PXN` is the one thing added unconditionally: the kernel must not
/// execute user memory even by accident, which is a guarantee Profile A's
/// unconstrained M-mode cannot make.
/// **THE LEGACY REPLAY ENTRY GRANTS IDENTITY, and that is what its callers
/// mean** (sawos design 33). The six harness kernels in `tests/` program this
/// surface directly with ranges that are addresses-as-they-are — they hold no
/// grant record and no image was placed for them — so the physical output is the
/// input. `prot_update` below is the door placement actually goes through.
public func prot_region(idx: UInt, base: UInt, top: UInt, perms: UInt8) unsafe {
    install_region(tables_base() + LEVEL3_OFFSET, base, top, base, perms)
}

/// Grant the pages of `[base, top)` with `perms` in the level-3 window at
/// `level3`, translating to physical `pa`.
///
/// The walk `prot_region` and `prot_update` share: one takes the LIVE set's
/// window, the other any process's, and neither wants a second copy of the
/// bounds checks or the attribute assembly.
///
/// **`base`..`top` IS THE INPUT RANGE AND `pa` IS THE OUTPUT BASE** (sawos
/// design 33) — the two halves a translation descriptor has always had, now
/// carrying two different numbers. Both ends round DOWN to their own page for
/// the same reason the input always did, which keeps the offset between them
/// exact: the two are page-aligned together or misaligned together, because
/// every placement in this kernel is affine at page granularity.
func install_region(level3: UInt, base: UInt, top: UInt, pa: UInt,
                    perms: UInt8) unsafe {
    var attrs = (DESC_VALID | DESC_PAGE | MemoryType.Normal.attr_index() | ATTR_AF
                 | ATTR_SH_INNER | ATTR_NG | ATTR_PXN)
    if (perms & (SegFlag.Write as UInt8)) != 0 {
        attrs = attrs | (AccessPerm.El0Rw as UInt64)
    } else {
        attrs = attrs | (AccessPerm.El0Ro as UInt64)
    }
    if (perms & (SegFlag.Execute as UInt8)) == 0 {
        attrs = attrs | ATTR_UXN
    }
    // The bound is tested BEFORE the subtraction that would compute the page
    // index: `va - RAM_BASE` underflows below the base, and overflow checks are
    // always on, so the order is what turns a bad map into a diagnostic rather
    // than into a panic from inside the protection primitive.
    let va_start = base - (base & (PAGE_SIZE - 1))
    let pa_start = pa - (pa & (PAGE_SIZE - 1))
    var va = va_start
    while va < top {
        if va < RAM_BASE {
            grant_outside_window(va)
        }
        let page = (va - RAM_BASE) >> PAGE_SHIFT
        if page >= GRANT_PAGES {
            grant_outside_window(va)
        }
        put_desc(level3, page, ((pa_start + (va - va_start)) as UInt64) | attrs)
        va = va + PAGE_SIZE
    }
}

/// Stage grant `idx` as a DEVICE WINDOW over `[base, base + len)` (design 178's
/// finale constraint 3).
///
/// THE ATTRIBUTE IS THE POINT ON THIS PROFILE. A page is device memory because
/// its descriptor says so, not because of where it is, so a window mapped with
/// the Normal attribute would be cached, speculatively read and merged — and a
/// register block under that is not slow, it is WRONG. `DeviceNGnRE` is the
/// ordinary driver attribute (see `MemoryType`), and both no-execute bits go in
/// unconditionally because registers are not instructions.
///
/// ACCESS-SIZE DISCIPLINE IS THE DRIVER'S HALF and cannot be expressed in a
/// descriptor: device memory permits no unaligned and no multi-register access,
/// so a driver reads and writes each register at ITS OWN WIDTH — 32 bits on
/// this board's console — and never memcpy's a register block. What the
/// attribute guarantees is that the hardware will not merge or split the
/// accesses the driver does make.
///
/// `idx` is unused, as it is in `prot_region`: a numbered region is a Profile-A
/// budget concept the seam carries for both.
public func prot_device(idx: UInt, base: UInt, len: UInt) unsafe {
    install_device(tables_base() + DEVICE_LEVEL3_OFFSET, base, len)
}

/// Grant the device pages of `[base, base + len)` in the device window at
/// `dev_level3` — `install_region`'s twin, split for the same reason.
func install_device(dev_level3: UInt, base: UInt, len: UInt) unsafe {
    let attrs = (DESC_VALID | DESC_PAGE | MemoryType.DeviceNGnRE.attr_index()
                 | ATTR_AF | ATTR_NG | (AccessPerm.El0Rw as UInt64)
                 | ATTR_PXN | ATTR_UXN)
    // Tested BEFORE the subtraction that computes the page index, for the
    // reason `prot_region` gives: overflow checks are always on, so the order
    // is what turns a bad map into a diagnostic rather than a panic from inside
    // the protection primitive.
    var va = base - (base & (PAGE_SIZE - 1))
    while va < base + len {
        if va < DEVICE_WINDOW_BASE || va >= DEVICE_WINDOW_BASE + DEVICE_WINDOW_LEN {
            grant_outside_window(va)
        }
        put_desc(dev_level3, (va - DEVICE_WINDOW_BASE) >> PAGE_SHIFT,
                 (va as UInt64) | attrs)
        va = va + PAGE_SIZE
    }
}

// =============================================================================
// Persistent per-process domains (sawos design 27, M5 unit 1)
// =============================================================================
//
// The seam above is REPLAY-SHAPED: the kernel's grant record is authoritative
// and the hardware image is rebuilt from it at every switch. That is the MPU
// tier's shape and it stays exactly that on Profile A. Here it is retired: each
// process owns a persistent table set, edited when its RECORD is edited, and a
// switch is one register write.
//
// The three calls below are the whole of the difference, and every one of them
// has a no-op twin on the riscv32 HAL — which is what lets `kernel/core` spell
// one sequence for both profiles.

/// **DOES THIS PROFILE REBUILD ITS PROTECTION IMAGE AT EVERY SWITCH?** No.
///
/// The one tier fact `load_domain` reads. Design 25 D-2 ruled that
/// replay-at-switch stays MPU-only — "an ASID means nothing if tables are
/// rebuilt under it" — so this is not a preference the kernel may second-guess
/// but the ruled shape of the two tiers, advertised by the HAL that knows which
/// one it is. Design 19's doctrine is that a tier difference is ADVERTISED,
/// never faked; this is that sentence as a compile-time constant, so the replay
/// loop folds away here and stays whole on Profile A.
public static PROT_REPLAY_AT_SWITCH: Bool = false

/// **THE SWITCH.** Make `p`'s tables the live ones.
///
/// One `msr` and an `isb` — no descriptor stores and no TLB flush, which is the
/// whole point of the unit. The ASID is the process slot index: three slots, a
/// field the architecture gives at least 8 bits for (`TCR_EL1.AS` is 0 here, so
/// 8), so no allocator is needed and the number is stable for a process's whole
/// life. `TCR_EL1.A1` is 0, so TTBR0 is what defines the ASID.
///
/// Entries stay valid across the switch because every window descriptor carries
/// `ATTR_NG` and is therefore tagged with the ASID that installed it — the
/// switch changes which tag matches, it does not invalidate anything.
public func prot_switch(p: UInt) unsafe {
    CURRENT_SET = p
    sos_ttbr0_write(set_base(p) | (p << TTBR_ASID_SHIFT))
}

/// **THE RANGE EDIT.** Make `[base, top)` in `p`'s OWN tables say exactly
/// `perms`, whether or not `p` is the process currently running.
///
/// **`perms == 0` IS A REVOCATION, and it is a real domain value rather than a
/// mode flag** (user ruling, Sep 3). A grant of nothing IS the absence of a
/// grant, and sawos design 29 made that literally true of the descriptor: a
/// non-granted window page is now INVALID rather than present-and-EL0-denied, so
/// removal writes the same zero `reset_window` writes and the two directions
/// were never two operations. Nothing is overloaded to make that true — the
/// kernel
/// REFUSES to record a permitting-nothing row at both of its doors, so the
/// encoding cannot collide with a live grant:
///
///   - an image segment must be readable or executable
///     (`imgformat.has_sane_perms`), so `flags == 0` never reaches the loader's
///     `record_grant`;
///   - `map_access` refuses NO ACCESS AT ALL by name — "a row that permits
///     nothing spends a protection slot to say what default-deny already says"
///     — as a caller-visible `BadArg`.
///
/// So zero is a value the grant vocabulary already had no use for, which is
/// what makes it free to mean the one thing it should.
///
/// Reached from BOTH record funnels: `record_grant` passes the row's real
/// permissions, `remove_grant` passes zero. Those are the only two places a
/// grant record changes shape, so the record and the tables move together by
/// construction rather than by call sites agreeing to stay in step.
///
/// THE DEVICE WINDOW takes the same path, `device` picking which window rather
/// than which operation. Its GRANT direction ignores `perms` exactly as
/// `prot_device` always has — a device page is read/write to EL0 and never
/// executable, which is a property of registers and not of the image's flag
/// bits — and its REVOKE direction writes `DESC_ABSENT`, the same nothing the
/// window resets to. So `perms` is read here only to answer grant-or-revoke,
/// never to shade a device grant, and the two windows' revoke arms differ only
/// in which table and which index the zero lands in.
///
/// **`base`..`top` IS THE USER'S VIRTUAL RANGE AND `pa` IS WHAT IT TRANSLATES
/// TO** (sawos design 33). Until placement the seam carried one number twice
/// over; now the input range selects the descriptors and `pa` is the output
/// address written into them. The REVOKE arm reads only the virtual half, which
/// is right: removing a translation is a statement about which addresses stop
/// resolving, and what they used to resolve to has stopped mattering.
///
/// The DEVICE arm ignores `pa` because `map_place` answered `pa` for it — a
/// register block is mapped at the address the board publishes, so its two
/// halves are still one number here. Said at `map_place`, where the choice is.
public func prot_update(p: UInt, base: UInt, top: UInt, pa: UInt, perms: UInt8,
                        device: Bool) unsafe {
    let level1 = set_base(p)
    if perms == 0 {
        var va = base - (base & (PAGE_SIZE - 1))
        while va < top {
            if device {
                put_desc(level1 + DEVICE_LEVEL3_OFFSET,
                         (va - DEVICE_WINDOW_BASE) >> PAGE_SHIFT,
                         DESC_ABSENT)
            } else {
                put_desc(level1 + LEVEL3_OFFSET, (va - RAM_BASE) >> PAGE_SHIFT,
                         DESC_ABSENT)
            }
            va = va + PAGE_SIZE
        }
    } else if device {
        install_device(level1 + DEVICE_LEVEL3_OFFSET, base, top - base)
    } else {
        install_region(level1 + LEVEL3_OFFSET, base, top, pa, perms)
    }
    invalidate_domain(p)
}

/// Retire `p`'s domain: both its windows back to kernel-only, wholesale.
///
/// **IT STAYS A SEPARATE NAME DELIBERATELY** (user ruling, Sep 3), and the
/// reason is that this is not a range edit with wide bounds — it is domain
/// RETIREMENT, a different event with two properties `prot_update` cannot
/// carry:
///
///   - **IT IS THE FAIL-CLOSED MASK.** It resets the whole set rather than the
///     ranges the record happens to list, so it is correct even if the record
///     and the hardware have skewed — which is exactly the moment you cannot
///     trust the record to enumerate what is live. Spelling teardown as a walk
///     of the rows would make the cleanup depend on the very bookkeeping whose
///     failure it is there to contain.
///   - **IT ANCHORS THE ASID-REUSE INVALIDATION TO ONE NAMED LIFECYCLE EVENT.**
///     A process slot — and therefore an address-space identifier — becomes
///     reusable here and nowhere else, so the invalidation that stops a new
///     process inheriting a dead one's cached translations has exactly one
///     site. That is the slot-reuse hazard design 27 D-2 names, and a range
///     edit is the wrong shape to hang it on.
///
/// Reached from `clear_domain` at teardown.
public func prot_clear(p: UInt) unsafe {
    let level1 = set_base(p)
    reset_window(level1 + LEVEL3_OFFSET)
    reset_device_window(level1 + DEVICE_LEVEL3_OFFSET)
    invalidate_domain(p)
}

/// Drop every cached translation belonging to `p`'s ASID.
///
/// **BY ASID RATHER THAN BY VA, DELIBERATELY.** By-VA is the narrower
/// instruction, but a grant row spans a whole region — root's is 64 pages and a
/// mapped Memory can be more — so the by-VA form is one `tlbi` per page against
/// this one, and it buys nothing: the edit is confined to a single process's
/// set, every descriptor in that set's windows is `ATTR_NG` and so carries the
/// ASID, and no other domain's entries can match the tag. So by-ASID is both
/// provably sufficient and strictly cheaper here.
///
/// It runs on EVERY edit, live domain or not. An edit to a NON-current domain
/// needs no maintenance in principle, but `p`'s stale entries may still sit in
/// the TLB from the last time it ran, and one instruction is far less than the
/// cost of being wrong about which of the two cases we are in. REMOVAL must
/// invalidate eagerly in any case — an unmap that waited would be a revocation
/// that did not revoke, which is the sentence `domain_changed` has always
/// carried.
func invalidate_domain(p: UInt) unsafe {
    sos_tlbi_asid(p)
}

// =============================================================================
// The interrupt controller (design 178 M2 unit 1, D6)
// =============================================================================
//
// Every interrupt on this board arrives through one controller, in two halves:
// a DISTRIBUTOR that decides which line wins, shared by the machine, and a
// per-core INTERFACE the winner is delivered through. Both are ordinary MMIO,
// so all of this is Saw.
//
// The cycle is claim-then-complete: reading the acknowledge register both says
// which line won and marks it active, and writing the same value back ends it.
// Between the two the line cannot win again, which makes the handler
// non-reentrant for free.
//
// Unlike Profile A, the TIMER IS ONE OF THESE LINES (a per-core one), so the
// tick path exercises this claim/complete cycle on every tick and the seam's
// `IRQ_TIMER` is a real line number rather than a stand-in.

/// The per-core interface: what may be delivered, what won, and what is done.
struct GicCpuRegs {
    ctlr: UInt32,               // +0x00  deliver to this core at all
    pmr: UInt32,                // +0x04  the priority a line must beat
    bpr: UInt32,                // +0x08  preemption grouping (unused: no nesting)
    iar: ReadOnly<UInt32>,      // +0x0C  acknowledge: claims the winning line
    eoir: WriteOnly<UInt32>,    // +0x10  end of interrupt
}

/// The distributor's own two registers. Everything else it has is an ARRAY
/// indexed by line — enables, priorities, targets — reached by address below,
/// because a register block struct cannot describe a 1024-entry table this
/// kernel touches four entries of.
struct GicDistRegs {
    ctlr: UInt32,               // +0x000  forward anything at all
    typer: ReadOnly<UInt32>,    // +0x004  how many lines this board wired
}

struct Gic {
    dist: UnsafeMemory<GicDistRegs, Device>,
    cpu: UnsafeMemory<GicCpuRegs, Device>,
}

/// Distributor array offsets, and the one write-only command register.
static GICD_ISENABLER: UInt = 0x100
static GICD_ICENABLER: UInt = 0x180
static GICD_IPRIORITYR: UInt = 0x400
static GICD_ITARGETSR: UInt = 0x800
static GICD_SGIR: UInt = 0xF00

static GIC_ENABLE: UInt32 = 1
/// The priority floor: a line is delivered only if its priority is NUMERICALLY
/// BELOW this (lower means more urgent here), so one floor plus one shared
/// active level is the whole policy — SOS prioritizes in software (spec §7).
static GIC_PRIORITY_FLOOR: UInt32 = 0xF0
static GIC_PRIORITY_ACTIVE: UInt8 = 0x80
static GIC_CPU0: UInt8 = 0x01

/// Lines below this are per-core and have no target register: the software
/// -generated ones and the per-core peripheral ones, the timer among them.
static GIC_PERCORE_LINES: UInt = 32
static GIC_LINES_PER_WORD: UInt = 32
static GIC_LINES_PER_TYPER_STEP: UInt = 32
static GIC_TYPER_LINES_MASK: UInt32 = 0x1F
/// What the acknowledge register reads as when nothing is deliverable.
static GIC_SPURIOUS: UInt = 1023
/// Send to the requesting core only — the software-trigger register's target
/// filter, in bits 25:24.
static GIC_SGIR_TO_SELF: UInt32 = 0x200_0000
static REGISTER_BYTES: UInt = 4

extension Gic {
    init() unsafe -> Gic {
        // The two controller halves by their PHYSICAL bases, reached through
        // the linear map (sawos design 29) — the same conversion the console's
        // driver makes, at the same one place per view.
        Gic(dist: UnsafeMemory<GicDistRegs, Device>(phys_to_virt(GIC_DIST_BASE)),
            cpu: UnsafeMemory<GicCpuRegs, Device>(phys_to_virt(GIC_CPU_BASE)))
    }

    /// How many lines this board wired, out of the field that counts them in
    /// blocks of 32.
    func line_count(&self) unsafe -> UInt {
        let blocks = ((self.dist.typer.read() & GIC_TYPER_LINES_MASK) as UInt) + 1
        blocks * GIC_LINES_PER_TYPER_STEP
    }

    func word_at(&self, base: UInt, line: UInt) unsafe -> UnsafeMemory<UInt32, Device> {
        UnsafeMemory<UInt32, Device>(phys_to_virt(
            GIC_DIST_BASE + base + (line / GIC_LINES_PER_WORD) * REGISTER_BYTES))
    }

    /// A per-line BYTE register — priorities and targets are one byte each,
    /// which is why these are not the word view above.
    func byte_at(&self, base: UInt, line: UInt) unsafe -> UnsafeMemory<UInt8, Device> {
        UnsafeMemory<UInt8, Device>(phys_to_virt(GIC_DIST_BASE + base + line))
    }

    /// Every line masked, then both halves on. Nothing is deliverable until
    /// `irq_unmask` opens a line.
    ///
    /// AUDIT (design 1): NO PREEMPTION POINT. The distributor is OFF for the
    /// whole loop, so a half-disabled controller is IRQ-shared state in flight —
    /// and there is nothing to deliver anyway, since this is what brings the
    /// controller up. At most 32 word writes.
    func reset(&self) unsafe {
        self.dist.ctlr.write(0)
        let lines = self.line_count()
        var word: UInt = 0
        while word * GIC_LINES_PER_WORD < lines {
            let disable = UnsafeMemory<UInt32, Device>(phys_to_virt(
                GIC_DIST_BASE + GICD_ICENABLER + word * REGISTER_BYTES))
            disable.write(0xFFFF_FFFF)
            word = word + 1
        }
        self.dist.ctlr.write(GIC_ENABLE)
        self.cpu.pmr.write(GIC_PRIORITY_FLOOR)
        self.cpu.ctlr.write(GIC_ENABLE)
    }

    func unmask(&self, line: UInt) unsafe {
        self.byte_at(GICD_IPRIORITYR, line).write(GIC_PRIORITY_ACTIVE)
        // A per-core line is delivered to the core it belongs to and its target
        // register is read-only; a shared one has to be pointed at a core, and
        // this kernel is uniprocessor.
        if line >= GIC_PERCORE_LINES {
            self.byte_at(GICD_ITARGETSR, line).write(GIC_CPU0)
        }
        let enable = self.word_at(GICD_ISENABLER, line)
        enable.write(1 << ((line % GIC_LINES_PER_WORD) as Int))
    }

    /// Masking is a WRITE-ONE-TO-CLEAR register, so this touches one line and
    /// needs no read-modify-write of the word around it.
    func mask(&self, line: UInt) unsafe {
        let disable = self.word_at(GICD_ICENABLER, line)
        disable.write(1 << ((line % GIC_LINES_PER_WORD) as Int))
    }

    func claim(&self) unsafe -> UInt {
        self.cpu.iar.read() as UInt
    }

    func complete(&self, line: UInt) unsafe {
        self.cpu.eoir.write(line as UInt32)
    }

    /// Raise a software-generated line on this core.
    func raise_to_self(&self, line: UInt) unsafe {
        let trigger = UnsafeMemory<UInt32, Device>(
            phys_to_virt(GIC_DIST_BASE + GICD_SGIR))
        trigger.write(GIC_SGIR_TO_SELF | (line as UInt32))
    }
}

/// The controller had nothing to give. Both profiles report a spurious
/// interrupt as this value; here the hardware says 1023 and the seam maps it,
/// and line 0 is a software-generated line SOS never raises.
public static IRQ_NONE: UInt = 0

/// The line the periodic timer arrives on.
public static IRQ_TIMER: UInt = TIMER_IRQ

/// The line `irq_raise_selftest_line` raises: a software-generated one, which
/// is this controller's own way to make an interrupt happen.
static SELFTEST_IRQ: UInt = 5

/// Bring the interrupt controller up with every line masked.
public func intc_init() unsafe {
    Gic().reset()
}

/// Let `line` interrupt the kernel.
public func irq_unmask(line: UInt) unsafe {
    Gic().unmask(line)
}

/// Stop `line` interrupting the kernel — spec §9's mask-on-fire, which the
/// Interrupt object's `ack` will undo when there is one.
public func irq_mask(line: UInt) unsafe {
    Gic().mask(line)
}

/// Which line is being serviced, or `IRQ_NONE`.
///
/// The cause is unused on this profile: an interrupt has its own vector, so the
/// controller is the only thing that knows which line it was. (Profile A
/// answers the timer half out of the cause word, which is why the seam passes
/// it at all.)
///
/// The acknowledge value is returned WHOLE rather than masked to its line
/// number, because on a multi-core machine it also carries which core sent a
/// software-generated line and the completion has to give that back. This
/// kernel is uniprocessor, so the field is always zero and the value IS the
/// line; an SMP port is where that stops being true.
public func irq_claim(cause: UInt) unsafe -> UInt {
    let acknowledged = Gic().claim()
    if acknowledged == GIC_SPURIOUS {
        return IRQ_NONE
    }
    acknowledged
}

/// End of service for `line`.
public func irq_complete(line: UInt) unsafe {
    Gic().complete(line)
}

/// Is `line` one THIS BOARD wires?
///
/// The distributor reports how many it has, so the bound is read from the
/// hardware rather than written here. Line 0 is a software-generated line SOS
/// never raises and is what the seam reports for "nothing", so it is excluded
/// at the same time. The timer's line IS in this range on this profile — it is
/// an ordinary controller line here — and the kernel excludes it arch-free,
/// because "the tick is not for rent" is a policy rather than a fact about the
/// board.
public func irq_line_valid(line: UInt) unsafe -> Bool {
    line != IRQ_NONE && line < Gic().line_count()
}

/// Ask for a pending line WITHOUT a trap having delivered one — the idle path's
/// half of the seam.
///
/// It is `irq_claim` under a second name here, and that is not an oversight:
/// this controller answers "which line won" out of one register whether or not
/// a vector ran, so the cause word `irq_claim` takes was already unused. Profile
/// A's timer is not a controller source, which is why the two names exist.
public func irq_poll() unsafe -> UInt {
    irq_claim(IRQ_CAUSE)
}

/// Park this core until an interrupt is pending.
///
/// It wakes on a pending physical interrupt whether or not this exception level
/// would take one — which is exactly the property the idle path needs, since
/// design 178's D2 keeps them masked at EL1 forever. So the core sleeps, the
/// line arrives, execution continues at the next instruction, and `irq_poll`
/// finds it.
public func wait_for_irq() {
    sos_wait_for_irq()
}

/// Raise a line from software, for interrupt bring-up. Returns the line raised.
///
/// This controller HAS a software trigger, so unlike Profile A no device is
/// involved: the line is one of the software-generated ones, raised at this
/// core. It is edge-like — one raise is one delivery — so nothing re-fires
/// after the handler completes.
///
/// IT WAS EXPECTED TO RETIRE WITH THE INTERRUPT OBJECT AND DOES NOT (design 178
/// M2 unit 4), for the reason the other profile's copy states: a driver now
/// takes a real line round the whole cycle, but a line raised IN KERNEL MODE
/// (D2 for a device line) and a line bound to NO Interrupt object (the report
/// -and-leave-masked path) are reachable only through this.
public func irq_raise_selftest_line() unsafe -> UInt {
    let gic = Gic()
    gic.unmask(SELFTEST_IRQ)
    gic.raise_to_self(SELFTEST_IRQ)
    SELFTEST_IRQ
}

// =============================================================================
// The core's physical timer (design 178 M2 unit 1)
// =============================================================================
//
// The periodic tick comes from the core's own timer, which is SYSTEM REGISTERS
// rather than MMIO — so unlike Profile A's memory-mapped comparator, the three
// touches below are C leaves. What they are worth is one instruction each; the
// arithmetic, the period and the policy are here.
//
// The counter is free-running and the compare register is an ABSOLUTE deadline
// on the same scale; the line asserts while the counter is at or past it — a
// level condition, so servicing a fire means PROGRAMMING THE NEXT DEADLINE
// rather than acknowledging one. The controller still needs its
// end-of-interrupt afterwards, which is the one asymmetry with Profile A worth
// knowing: there, the timer is not a controller line at all.
//
// ONE COMPARE REGISTER, TWO CUSTOMERS (design 232 unit 1). The scheduler tick
// (spec §7) and the Timer objects (§2) share this single piece of hardware, and
// the seam takes an absolute deadline precisely so that sharing is the KERNEL's
// arithmetic: it programs the earliest of the two and this file never learns
// there were two. That is what replaced M2's `timer_start`/`timer_rearm` pair,
// which could only express one periodic customer.

extern "C" {
    // The timer's frequency in ticks per second — a property of the machine,
    // readable only through a system register.
    func sos_timer_freq() -> UInt
    // The control register: enabled, masked, and whether the timer has fired.
    func sos_timer_ctl_read() -> UInt
    func sos_timer_ctl_write(value: UInt)
    // The free-running counter, and the deadline it is compared against.
    func sos_timer_count() -> UInt
    func sos_timer_set_compare(value: UInt)
}

static TIMER_CTL_ENABLE: UInt = 1         // bit 0
static TIMER_CTL_FIRED: UInt = 4          // bit 2 — the condition is met
static NS_PER_SECOND: UInt64 = 1_000_000_000

/// Counter units to nanoseconds, exactly and without overflowing.
///
/// THE SPLIT IS WHAT MAKES IT EXACT AT BOTH ENDS. A plain `units * 1e9 / freq`
/// overflows a 64-bit product after about five minutes of uptime at this
/// machine's 62.5 MHz; a plain `units / (freq / 1e9)` is a division by zero,
/// since no sane timer runs at a gigahertz. Splitting into whole seconds plus a
/// remainder keeps every intermediate inside the word and loses nothing: the
/// remainder is below `freq`, so its product with 1e9 cannot overflow either.
func units_to_ns(units: UInt64) unsafe -> UInt64 {
    let freq = sos_timer_freq() as UInt64
    (units / freq) * NS_PER_SECOND + ((units % freq) * NS_PER_SECOND) / freq
}

/// Nanoseconds to counter units, the same split run backwards, rounding UP.
///
/// UP rather than nearest, because the seam's contract is that a deadline never
/// fires EARLY: the kernel's composition treats an interrupt as "something may
/// be due" and reprograms if nothing is, so an early fire costs a round trip
/// while a late one costs nothing. The saturating guard is what keeps the
/// kernel's "never" deadline representable — the seconds product would
/// otherwise overflow, and Saw's overflow checks are on in a kernel.
func ns_to_units(ns: UInt64) unsafe -> UInt64 {
    let freq = sos_timer_freq() as UInt64
    let secs = ns / NS_PER_SECOND
    if secs > UInt64.max / freq {
        return UInt64.max
    }
    let rem = ns % NS_PER_SECOND
    secs * freq + ((rem * freq) + NS_PER_SECOND - 1) / NS_PER_SECOND
}

/// This machine's monotonic time in NANOSECONDS since the counter started
/// (design 232 unit 1; spec §2's Clock row).
///
/// THE COUNTER IS THE CLOCK. There is no second time source and no software
/// accumulator — the free-running counter is what a `Clock.now()` reads and
/// what every Timer deadline is measured against, so the two can never disagree
/// about what "now" is. Its epoch is the machine's power-on, which is exactly
/// the Monotonic domain's contract: it never steps and never goes backwards.
public func timer_now_ns() unsafe -> UInt64 {
    units_to_ns(sos_timer_count() as UInt64)
}

/// Program the ONE compare register to interrupt at `at_ns`.
///
/// A deadline already past fires as soon as interrupts are deliverable. A
/// deadline of `UInt64.max` is the kernel's "never", and saturates to a counter
/// value this machine reaches in some nine thousand years.
///
/// THE ORDER IS DELIBERATE: the deadline is written BEFORE the timer is
/// enabled, so a stale compare value left over from an earlier schedule can
/// never assert in the gap. Enabling and unmasking every time is idempotent and
/// is what lets a kernel that armed no tick at boot — the real one — still
/// serve a Timer a process armed later.
public func timer_set_deadline_ns(at_ns: UInt64) unsafe {
    sos_timer_set_compare(ns_to_units(at_ns) as UInt)
    sos_timer_ctl_write(TIMER_CTL_ENABLE)
    irq_unmask(IRQ_TIMER)
}

/// Has the timer fired without a tick having been taken for it?
public func timer_pending() -> Bool {
    (sos_timer_ctl_read() & TIMER_CTL_FIRED) != 0
}
