//! The arm64 kernel HAL, Saw half: QEMU `virt`, EL1.
//!
//! Everything the kernel needs from this machine. The kernel core above it
//! (`kernel/core/`) names no architecture: it reaches the board, the privilege
//! transition and the memory-protection hardware only through the surface
//! below, which `hal/riscv32/kernel/` implements the same way for Profile A.
//! `ABI.md` beside this file is the contract; `boot.S` and `sink.c` are the
//! parts of it that cannot be Saw.
//!
//! Addresses and machine words are `UInt` throughout, never `Int`. On this
//! target `Int` is 64-bit signed, so the addresses here fit either way; the
//! discipline has to be written down because the same code on Profile A puts
//! 0x8020_0000 in `Int`'s negative half.

// The image-format registry: the arch tag a HAL claims comes out of it.
import imgformat.{SosimgArch, SegFlag}

// Arch-free, role-free formatting, shared with the kernel core and every SOS
// process build. The kernel core is above this HAL and cannot be imported
// here, so the HAL formats its own diagnostics with the same helpers. The last
// three are the arch-free half of the console and the stop: the sink trait
// this file's UART conforms to, the one write loop over it, and the exit-status
// promotion.
import sosrt.{ascii_byte, hex_digit_of, hex_digits_per_word,
              ConsoleSink, console_write, abort_status}

// =============================================================================
// PL011 UART
// =============================================================================

/// The PL011 register block, as far as a polled transmitter needs it.
/// Declaration order is the layout, so the reserved words between the data
/// register and the flag register are spelled out.
struct Pl011Regs {
    dr: UInt32,             // +0x00  data
    rsr: UInt32,            // +0x04  receive status / error clear
    reserved0: UInt32,      // +0x08
    reserved1: UInt32,      // +0x0C
    reserved2: UInt32,      // +0x10
    reserved3: UInt32,      // +0x14
    fr: ReadOnly<UInt32>,   // +0x18  flag register
}

/// The console driver. A safe type (unsafety is not transitive): only the
/// methods reaching through `regs` carry the `unsafe` effect.
struct Pl011 {
    regs: UnsafeMemory<Pl011Regs, Device>,
}

extension Pl011 {
    /// `at` is the physical base: the number the board publishes and a device
    /// grant carries. The conversion to the linear map is here, at the one
    /// construction, so every caller names the register block by its real
    /// address.
    init(at: UInt) unsafe -> Pl011 {
        Pl011(regs: UnsafeMemory<Pl011Regs, Device>(phys_to_virt(at)))
    }
}

/// The two register touches, and nothing else. The transmitter is polled, and
/// QEMU's PL011 comes up transmitting, so there is no baud-rate or line-control
/// programming; a real board would need it and it would go in `init`.
///
/// `write_byte` and the panic path's write loop are `sosrt`'s, generic over
/// this conformance and monomorphized here. Readiness is the opposite sense to
/// the 16550's: FR bit 5 clear (the transmit FIFO is not full), and the byte
/// goes to DR. Each HAL answers `can_write` in its own terms so one loop serves
/// both.
extension Pl011: ConsoleSink {
    func can_write(&self) unsafe -> Bool {
        (self.regs.fr.read() & FR_TX_FULL) == 0
    }

    func put(&self, b: UInt8) unsafe {
        self.regs.dr.write(b as UInt32)
    }
}

// =============================================================================
// The trap frame
// =============================================================================

/// The context `boot.S` saves on a trap from EL0: 34 doublewords. Declaration
/// order is the layout, so the field names here and the
/// `stp x<n>, x<n+1>, [sp, #...]` stores in boot.S are one description.
///
/// The three system registers come first because the resume path reads them
/// back. There is no x31 slot: `sp` at EL0 is `SP_EL0`, a separate register,
/// so the kernel saves it as one of those three.
struct TrapFrame {
    elr: UInt,              // the PC to resume at — already PAST the `svc`
    spsr: UInt,             // saved processor state
    sp: UInt,               // SP_EL0, the user stack pointer
    x0: UInt,               // syscall handle / status out
    x1: UInt,               // syscall arg 0 / value out
    x2: UInt,               // syscall arg 1
    x3: UInt,               // syscall arg 2
    x4: UInt,
    x5: UInt,
    x6: UInt,
    x7: UInt,
    x8: UInt,               // syscall op
    x9: UInt,
    x10: UInt,
    x11: UInt,
    x12: UInt,
    x13: UInt,
    x14: UInt,
    x15: UInt,
    x16: UInt,
    x17: UInt,
    x18: UInt,
    x19: UInt,
    x20: UInt,
    x21: UInt,
    x22: UInt,
    x23: UInt,
    x24: UInt,
    x25: UInt,
    x26: UInt,
    x27: UInt,
    x28: UInt,
    x29: UInt,
    x30: UInt,
}

/// Bytes in one saved context.
///
/// Public because the kernel reserves a slot per thread and has to know this
/// fits: the kernel owns the storage and the HAL owns the layout. The assert
/// below keeps the number honest here; the kernel's own assert keeps its stride
/// honest there.
public static FRAME_BYTES: Int = 272

/// Doublewords in a frame, for `frame_init`'s zeroing loop.
static FRAME_WORDS: UInt = 34

// The frame boot.S builds must be the frame this file describes. A field added
// on one side and not the other would misread every register after it.
static_assert(sizeof<TrapFrame>() == FRAME_BYTES, "the arm64 trap frame is 34 doublewords")

// =============================================================================
// Board constants
// =============================================================================

static UART_BASE: UInt = 0x0900_0000
static FR_TX_FULL: UInt32 = 0x20         // FR bit 5 — transmit FIFO full

/// The interrupt controller: a distributor shared by the machine and a
/// per-core interface. This board wires the v2 layout, which
/// `tools/sos_runner.py` pins on the command line so a newer emulator's default
/// cannot become a controller this HAL does not program.
static GIC_DIST_BASE: UInt = 0x0800_0000
static GIC_CPU_BASE: UInt = 0x0801_0000

/// The line the core's physical timer arrives on: a per-core interrupt, so it
/// is the same number on every core and needs no distributor target.
static TIMER_IRQ: UInt = 30

// =============================================================================
// The linear-map seam
// =============================================================================
//
// Addresses stored as data stay physical; only a dereference converts. A
// `GrantRow`, a sosimg record, a boot-handle record, a region table row, a
// `Memory`/`IoMemory` capability and a fault report word all carry the physical
// address, which is the one name for a location that crosses any API. The
// kernel does not run at those addresses, so the moment it dereferences one it
// converts.
//
// Here the pair is an OR and an AND with a fixed offset: no table walk, no
// lookup. On both riscv32 HALs it is the identity and compiles to nothing.
// `kernel/core` names only these two functions and carries no tier
// conditional.
//
// Pure OR/AND is safe because the offset's low `VA_BITS` bits are zero and
// every address this board can name fits under that, so `pa | LINMAP_OFFSET`
// never carries into a set bit and `va & LINMAP_PHYS_MASK` never clears one.
// The `static_assert`s below (and the RAM one beside `RAM_BASE`) hold the
// board's map to it: widening RAM past 512 GiB or moving a device above it
// stops the build rather than folding an address onto another.
//
// `virt_to_phys` is idempotent on an address that is already physical, because
// masking off bits that are not set changes nothing. That lets it normalize a
// value of mixed provenance, such as a region table row base, which the linker
// fills in from a section symbol (a link address, high) in one row and from a
// literal (already physical) in the next.

/// The virtual-address size TCR selects for both halves: `T0SZ` = `T1SZ` =
/// `64 - VA_BITS`. 39 bits at the 4 KiB granule puts level 1 first, with 512
/// entries of 1 GiB each; `sink.c` writes the register and this is the number
/// it writes.
static VA_BITS: Int = 39

/// The low half of a 64-bit address at `VA_BITS`: the bits a physical address
/// may occupy, and exactly the mask `virt_to_phys` applies.
static LINMAP_PHYS_MASK: UInt = (1 << VA_BITS) - 1

/// Where the kernel lives: the canonical TTBR1 base for a `VA_BITS`-bit virtual
/// address, `2^64 - 2^39`. Every kernel address in the running system is
/// `physical | LINMAP_OFFSET`, and the kernel image is linked at these
/// addresses (`virt.ld` adds it to the load address and takes it back off with
/// `AT`, so the ELF's physical addresses are unchanged and QEMU loads the image
/// where the ELF header says).
///
/// Written as a literal because a const fold runs in the signed platform-`Int`
/// domain, where this value is negative. The asserts below check it against
/// `VA_BITS`, so the literal cannot drift from the register.
public static LINMAP_OFFSET: UInt = 0xFFFF_FF80_0000_0000

static_assert((LINMAP_OFFSET & LINMAP_PHYS_MASK) == 0,
              "the linear-map offset must not overlap the physical half, or `|` would carry")
static_assert((LINMAP_OFFSET | LINMAP_PHYS_MASK) == UInt.max,
              "the offset and the mask must partition the 64-bit address")

// The board's MMIO, held to the same bound as RAM. Both device blocks live in
// the first GiB, so a board file that moved a controller has to notice.
static_assert(UART_BASE <= LINMAP_PHYS_MASK,
              "the console UART must fit under the linear-map offset")
static_assert(GIC_DIST_BASE <= LINMAP_PHYS_MASK,
              "the GIC distributor must fit under the linear-map offset")
static_assert(GIC_CPU_BASE <= LINMAP_PHYS_MASK,
              "the GIC CPU interface must fit under the linear-map offset")

/// A physical address as the kernel must spell it to dereference it.
///
/// Every kernel-side `UnsafeMemory`/`UnsafePointer` built out of a stored
/// physical address goes through here: the sosimg overlays, the region table
/// overlays, the copy doors, the descriptor writes, and this file's own MMIO
/// views. An address that was already a kernel one does not: a pointer taken
/// from a Saw reference (`(&var THREAD_FRAMES) as ...`) is a link-time address
/// and is high already.
public func phys_to_virt(pa: UInt) -> UInt {
    pa | LINMAP_OFFSET
}

/// The inverse: a kernel dereference address back to the physical address that
/// names it everywhere else.
///
/// Its callers are the places a kernel address has to become the hardware's or
/// data: the translation-table pool's base (a descriptor and a TTBR hold
/// physical addresses), the payload and region table linker bounds, and the
/// region rows the linker resolved. Idempotent on an address that is already
/// physical.
public func virt_to_phys(va: UInt) -> UInt {
    va & LINMAP_PHYS_MASK
}

// =============================================================================
// Identity
// =============================================================================

/// What this kernel says it is booting on, for the banner.
public func arch_name() -> String {
    "arm64 (QEMU virt)"
}

/// This profile's `sosimg` arch tag. A process image built for the other
/// profile is refused by the loader rather than jumped into. The tag is read
/// from `imgformat`'s registry, so a HAL cannot claim a tag the format does not
/// define.
public func arch_tag() -> UInt8 {
    SosimgArch.Arm64.tag()
}

// =============================================================================
// Console
// =============================================================================

/// Write one byte to the kernel's console.
///
/// The kernel owns the machine, so this is the UART directly. Byte-at-a-time is
/// what the seam needs: the arch-free half formats, this half places.
///
/// Handover, device half (the protocol itself is stated on `kcore`'s
/// `Console`). This board has one UART and a driver process may be granted its
/// page, so after the handover marker there can be a second writer on this
/// device. Both writers use the data register and the transmit-full flag beside
/// it, each write being one 32-bit store behind its own poll, so a kernel byte
/// lands between two of the process's rather than inside one. The kernel never
/// touches the receive side, the interrupt-mask register or the control
/// register: a driver that owns receive owns it alone.
///
/// A driver on this board must enable the UART itself. The kernel's transmitter
/// works out of reset without programming the control register, so a process
/// that wants receive has to set it.
public func console_byte(b: UInt8) unsafe {
    Pl011(at: UART_BASE).write_byte(b)
}

// =============================================================================
// Stopping the machine
// =============================================================================

// `hlt #0xf000` is not expressible in Saw and neither is the register pinning
// the semihosting call needs, so both exits go through the C half. See `sink.c`
// for why semihosting rather than PSCI.
extern "C" {
    func sos_platform_exit(code: UInt)
    func sos_wait_for_irq()
}

/// Stop the machine with status 0. Never returns.
public func exit_pass() {
    sos_platform_exit(0)
    while true { }
}

/// Stop the machine with a non-zero status.
///
/// What status is `sosrt.abort_status`'s call: a zero code would report
/// success, and the rule that a failing exit never reads as a passing one is
/// decided once, for every board. How to stop is this file's: a semihosting
/// exit through the C leaf.
public func exit_fail(code: UInt) {
    sos_platform_exit(abort_status(code))
    while true { }
}

// =============================================================================
// The runtime's two hooks
// =============================================================================
//
// `sosrt` (rt/common/src/lib.saw) implements the `__saw_rt_*` seams over
// exactly two per-side hooks: where a byte goes, and how the machine stops. The
// kernel HAL answers "the UART" and "the platform's exit".

/// Stop the machine with a non-zero status, for the common runtime.
///
/// The promote-zero rule lives in `exit_fail`; this is only the seam name.
///
/// `-> Never` is what `sosrt` declares this hook to be. `exit_fail` diverges on
/// its own (it spins if the semihosting exit is somehow ignored) but is typed
/// `Void`, so the trailing loop carries the promise up to this signature.
@export("sos_rt_abort")
public func rt_abort(code: UInt32) -> Never {
    exit_fail(code as UInt)
    while { }
}

/// Write `len` bytes at `ptr` to the console. The panic path's writer.
///
/// The loop is `sosrt.console_write`, shared by every board; its check-freedom
/// contract and the machine code that shows it are stated there. This file
/// supplies the device it walks. On this instantiation the `-Oz` machine code
/// is a byte loop calling `write_byte` directly, and neither has an overflow
/// check, a bounds check, a trap or a call to `__saw_rt_panic`, so a panic
/// inside the panic reporter is unreachable.
@export("sos_rt_write")
public func rt_write(ptr: UnsafePointer<Int8>, len: UInt) unsafe {
    let sink = Pl011(at: UART_BASE)
    console_write(&sink, ptr, len)
}

// =============================================================================
// Privilege, protection and payload seams (boot.S / sink.c)
// =============================================================================

// The native seams this file calls for privilege and protection: the first
// entry into user mode (`boot.S`), the barrier and flush that publish a staged
// grant set, the domain switch with its by-ASID TLB flush, and two
// linker-symbol pairs (the payload bounds and the region table's). The
// protection primitive's descriptors are built below in Saw; only publishing
// them needs instructions. `sink.c` says at each of its leaves why it is
// native.
extern "C" {
    func sos_resume_frame(frame_addr: UInt)
    func sos_prot_commit()
    // The domain switch and its TLB maintenance. Both name a system register or
    // a maintenance instruction at assembly time, so both are C leaves, as
    // `sos_prot_commit` is.
    func sos_ttbr0_write(value: UInt)
    func sos_tlbi_asid(asid: UInt)
    func sos_payload_start() -> UInt
    func sos_payload_end() -> UInt
    func sos_region_table_start() -> UInt
    func sos_region_table_end() -> UInt
}

/// This target's protection granularity: a translation-table page. Profile A
/// grants at four-byte granularity, so a root image built for this profile has
/// to place its segments on page boundaries, and the loader checks that it did.
public static PROT_GRAIN: UInt = 4096

/// How many segments a root image may ask for. A page-table profile has no
/// small fixed region budget the way PMP does, so this is a sanity bound on a
/// hostile header rather than a hardware limit.
public static MAX_ROOT_SEGMENTS: UInt = 8

/// Root's region on this board. The base is 2 MiB into RAM, the same offset
/// Profile A uses, and here also a level-2 boundary, so root's pages come out
/// of the grant window whole. Mirrored by the root linker script.
///
/// `ROOT_LOAD_BASE` is the physical destination only. The address root sees its
/// image at is `USER_IMAGE_BASE` below; root is the one process for which the
/// two coincide.
public static ROOT_LOAD_BASE: UInt = 0x4020_0000
public static ROOT_REGION_TOP: UInt = 0x4024_0000
public static ROOT_STACK_LEN: UInt = 0x4000

// =============================================================================
// Placement: the two seams that decide a user address
// =============================================================================
//
// On this tier a user address is the kernel's answer. Every process image links
// at one canonical base and loads wherever the allocator put its frames; a
// `map` lands where a per-process cursor says. Both are functions rather than a
// tier flag the kernel branches on, because the other tier's answer is the
// identity (an image links where it loads, a mapping lands at its own physical
// address) and an identity body compiles to nothing. Each HAL states its own
// answer and `kernel/core` spells one sequence for both tiers.
//
// "An address is the same number in every process" (spec §5.5) is the tier-2
// answer, which `hal/riscv32-common` gives verbatim.

/// The one virtual base every user image on this board is linked at.
///
/// Root, a child and a grandchild all see their own image here, because each
/// runs under its own translation-table set and the low half belongs entirely
/// to whichever process is current. What differs between them is the physical
/// frames the identical virtual range resolves to, and that is the allocator's
/// answer rather than the linker's.
///
/// It equals `ROOT_LOAD_BASE`: root's image is placed at a HAL constant by the
/// boot door, so keeping the canonical link base equal to it leaves root at the
/// addresses it has always had, which keeps the boot transcript's `entry=` row
/// stable.
///
/// Mirrored by `hal/arm64/user/user.ld`, the one user linker script this board
/// has. Nothing at build time can compare the two (a Saw static's value is not
/// a linker symbol), so the loader's `check_segment` catches a script that
/// disagrees, with a named diagnostic.
public static USER_IMAGE_BASE: UInt = 0x4020_0000

/// The virtual base an image loading at physical `dest_base` is linked at: the
/// canonical base, whatever the frames are.
///
/// `dest_base` is ignored here and is the answer on the MPU tier, which is why
/// the seam takes it: an identity body needs the argument, and a constant that
/// ignored it would force a tier conditional upstairs.
public func image_link_base(dest_base: UInt) -> UInt {
    USER_IMAGE_BASE
}

/// Where a `map` of physical `pa` lands in a process whose map cursor stands at
/// `cursor`.
///
/// RAM takes the cursor: the address is the kernel's answer, and the caller
/// holds no opinion (`map` takes no VA hint on any tier).
///
/// A device window takes its own address. MMIO lives in a level-3 window of its
/// own here (`DEVICE_WINDOW_BASE`, one 2 MiB span), indexed by the hardware
/// address, and the addresses in it are the ones the board's region table
/// publishes, so placing a register block elsewhere in that window would buy a
/// driver nothing and cost the window a second cursor. This is a deliberate
/// limit: a translating tier could place MMIO, and this one does not.
public func map_place(cursor: UInt, pa: UInt, device: Bool) -> UInt {
    if device {
        return pa
    }
    cursor
}

/// May `[base, top)` be handed to a user domain as physical backing? The other
/// half of `map_target_ok`, which asks only about the virtual range.
///
/// A descriptor's output address may be any frame the linear map covers, so the
/// physical bound is RAM; the input range has to fit the 4 MiB grant window,
/// because that is the level-3 table's own span.
///
/// On the MPU tier the two predicates have the same body: where a user address
/// is its physical address, the virtual and physical questions are one
/// question.
public func map_source_ok(base: UInt, top: UInt) -> Bool {
    base < top && base >= RAM_BASE && top <= RAM_BASE + RAM_LEN
}

/// The one device window this board offers a process: the console UART's page.
///
/// A page because that is this profile's protection granularity, and one page
/// is what the register block needs.
public static DEVICE_GRANT_BASE: UInt = UART_BASE
public static DEVICE_GRANT_LEN: UInt = 0x1000

static_assert(DEVICE_GRANT_LEN >= PROT_GRAIN,
              "a device window cannot be finer than the protection grain")
static_assert((DEVICE_GRANT_BASE % PROT_GRAIN) == 0,
              "a device window must start on a page boundary")

/// How many protection rows one process's domain may hold on this profile: the
/// number `MemoryOp.Map` checks a target's `grant_count` against.
///
/// Here it is a policy number, not a hardware one. There are no numbered
/// regions to run out of: a grant is a walk of page descriptors, so the
/// hardware's only limit is the window's own size. What bounds a domain is the
/// kernel's grant record, a fixed array per process slot, and this is that
/// array's length (`kcore.limits.MAX_GRANT_ROWS`), restated as a HAL fact so
/// one number serves both profiles at the map check.
///
/// Don't widen it past the array: raising it means raising the storage every
/// process slot carries.
public static GRANT_ROW_BUDGET: UInt = 9

/// May `[base, top)` be installed as a RAM row in a user domain?
///
/// The 4 MiB grant window is the bound. `prot_region` enforces the same bound
/// by stopping the machine (`grant_outside_window`), which is right for the
/// loader path, where a memory map that outgrew the window is a kernel bug, and
/// wrong for a `map`, where the range came from a region a process chose. This
/// predicate moves that refusal to the op as a caller-visible `BadArg`;
/// `grant_outside_window` stays for the loader path.
///
/// Page alignment is not required of `base`: `prot_region` rounds down to the
/// page it starts in, as it does for a segment, so a map of a region that
/// begins mid-page grants the whole page. What is required is that every page
/// the walk would touch is inside the window, which the top bound tests since
/// the walk stops at `top`.
///
/// It asks about the virtual range only: the window is a level-3 table, so what
/// has to fit inside it is what indexes it, the input address. The physical
/// half is `map_source_ok`.
public func map_target_ok(base: UInt, top: UInt) -> Bool {
    base < top && base >= RAM_BASE && top <= RAM_BASE + (GRANT_PAGES << PAGE_SHIFT)
}

/// May `[base, base + len)` be installed as a device row? This profile's
/// granularity rule, checked on caller-chosen numbers.
///
/// A page is the finest thing this profile can grant, so a window is judged by
/// pages: both ends on a page boundary, and inside the one device window the
/// board publishes a level-3 table for. Profile A's rule differs in form (a
/// naturally aligned power of two, because a window there is one protection
/// entry) and not in purpose, which is why the predicate is per-HAL rather than
/// a shared check with two branches.
public func device_window_ok(base: UInt, len: UInt) -> Bool {
    if len < PROT_GRAIN || (len % PROT_GRAIN) != 0 {
        return false
    }
    if (base % PROT_GRAIN) != 0 {
        return false
    }
    base >= DEVICE_WINDOW_BASE && len <= DEVICE_WINDOW_BASE + DEVICE_WINDOW_LEN - base
}

/// An address the kernel itself cannot reach on this target. It sits under
/// level-1 entry 2 of the low translation base, which is invalid in every
/// per-process set, so a read is a translation fault taken at EL1 whatever
/// `TTBR0` holds. An address inside a user window would not do: whether a read
/// of it faults depends on what the current process has been granted.
public static UNMAPPED_PROBE: UInt = 0x8000_0000

/// Publish the staged grant set: order the descriptor writes and flush the TLB.
/// Separate from `prot_region` so a partially programmed set is never live. The
/// barriers are the only part that is not Saw; see `sink.c`.
public func prot_commit() {
    sos_prot_commit()
}

/// The processor state a user context resumes in: EL0t, with D/A/F masked and I
/// not, so interrupts are on in user mode and nowhere else.
///
/// It is written into the frame rather than into the register at the
/// transition, which makes a context switch a frame swap: every thread carries
/// the state it resumes in, and the assembly reads it back like any other word.
static SPSR_EL0T: UInt = 0x340

/// Build a fresh user context in `frame_addr`: `entry` as the resume address,
/// `stack_top` as the user stack pointer, `arg0` in the first argument
/// register, and the saved processor state that selects EL0.
///
/// Every other word is zeroed: nothing of the kernel's, and nothing of another
/// thread's, crosses into a context this builds. The link register is among the
/// zeroed ones on purpose: a thread entry that returns branches to zero and
/// takes an instruction abort, which spec §8 turns into the death of its
/// process, a diagnosed stop rather than a run into whatever follows.
///
/// No preemption point: `FRAME_WORDS` zeroing stores and four field stores, and
/// a half-built context is an in-flight invariant the trap path can reach.
public func frame_init(frame_addr: UInt, entry: UInt, stack_top: UInt,
                       arg0: UInt) unsafe {
    var w: UInt = 0
    while w < FRAME_WORDS {
        UnsafeMemory<UInt, Normal>(frame_addr + w * WORD_BYTES).write(0)
        w = w + 1
    }
    let frame = frame_at(frame_addr)
    frame.elr.write(entry)
    frame.spsr.write(SPSR_EL0T)
    frame.sp.write(stack_top)
    frame.x0.write(arg0)
}

static WORD_BYTES: UInt = 8

/// Resume the context saved in `frame_addr`, in user mode. Never returns.
///
/// This is the first entry to user mode, the only one that is not `ktrap`
/// handing a frame back to the trap entry; the assembly behind it is a single
/// branch into that entry's own restore path rather than a second copy of it.
public func resume_frame(frame_addr: UInt) -> Never {
    sos_resume_frame(frame_addr)
    while { }
}

/// First byte of the appended payload: the `.payload` section `virt.ld` bounds.
/// Saw cannot name a linker symbol, so the bounds arrive through C.
///
/// Physical, and the conversion is in `sink.c`. A linker symbol's address is a
/// link address and this kernel links high, but a payload's bounds are granted
/// to EL0 and read by the loader as an image base, both physical readings. So
/// the C accessors mask.
public func payload_start() -> UInt {
    sos_payload_start()
}

/// One past the last byte of the appended payload. Equal to `payload_start()`
/// in an image built without one.
public func payload_end() -> UInt {
    sos_payload_end()
}

/// First byte of the boot region table: the `.regions` section `virt.ld`
/// bounds. Saw cannot name a linker symbol, so the bounds arrive through C, as
/// the payload's do.
///
/// The table's own rows point at blob sections whose bases the linker resolves,
/// so those need no symbol the kernel can name, however many child images a
/// build appends.
public func region_table_start() -> UInt {
    sos_region_table_start()
}

/// One past the last byte of the region table. Equal to `region_table_start()`
/// in an image built without one, which is zero regions, not an error.
public func region_table_end() -> UInt {
    sos_region_table_end()
}

// =============================================================================
// Traps
// =============================================================================

/// The `ESR_EL1` exception classes the kernel can take from EL0 or take itself.
///
/// Backed by `UInt`, the width of the register the value arrives in. The
/// numbers are the architecture's, so they are pinned per case: a reorder here
/// must never renumber them.
enum ExceptionClass: UInt {
    case Unknown = 0,
    case SimdFpTrap = 7,
    case IllegalState = 14,
    case Svc64 = 21,
    case InsnAbortLower = 32,
    case InsnAbortSame = 33,
    case PcAlignment = 34,
    case DataAbortLower = 36,
    case DataAbortSame = 37,
    case SpAlignment = 38,
    case Breakpoint = 60,
}

extension ExceptionClass {
    /// The short symbolic name a fault line reports.
    ///
    /// The vocabulary is the same on both profiles (a store that user mode was
    /// not granted is a `store-access-fault` whether the hardware called it a
    /// PMP violation or a data abort), so the harness asserts one string
    /// against two architectures.
    func describe(&self, iss: UInt) -> String {
        match self {
            case Unknown -> "unknown-reason",
            case SimdFpTrap -> "fp-access-trap",
            case IllegalState -> "illegal-instruction",
            case Svc64 -> "svc-from-user",
            case InsnAbortLower -> "instruction-access-fault",
            case InsnAbortSame -> "instruction-access-fault",
            case PcAlignment -> "instruction-address-misaligned",
            // A data abort says which direction it was in ISS bit 6, the whole
            // difference between the two Profile A causes.
            case DataAbortLower -> abort_direction(iss),
            case DataAbortSame -> abort_direction(iss),
            case SpAlignment -> "stack-address-misaligned",
            case Breakpoint -> "breakpoint",
        }
    }
}

/// ISS bit 6 (WnR) on a data abort: set means the access was a write.
///
/// The fault class is deliberately ignored. The ISS also carries a `DFSC` field
/// saying which kind of abort this was (translation, permission, access flag,
/// address size) and this decode reads none of it. Spec §5.7 reports what a
/// process may act on: whether it was refused and in which direction. Which
/// table level noticed is the kernel's business.
///
/// This matters because a stray EL0 access to a page its process was not
/// granted finds an invalid descriptor and is a translation fault, where a
/// present EL0-denied descriptor would give a permission fault. Both are `EC`
/// 0x24, both come through here, and both render `store-access-fault` or
/// `load-access-fault`. Profile A's PMP violation has no class at all, which is
/// the deeper reason not to publish one.
///
/// The gate cannot witness this: every fault assertion in the runner is the
/// bare prefix `"SOS: fault "`. A change here needs a probe, a case made to
/// fault on a non-granted page with the raw `ESR` that `fault_trap` prints read
/// by hand.
func abort_direction(iss: UInt) -> String {
    if (iss & ISS_WNR) != 0 {
        "store-access-fault"
    } else {
        "load-access-fault"
    }
}

static ESR_EC_SHIFT: Int = 26
static ESR_EC_MASK: UInt = 0x3F
static ESR_ISS_MASK: UInt = 0x1FF_FFFF
static ISS_WNR: UInt = 0x40

/// Did this trap come from a syscall instruction, or is it a fault?
public func is_syscall(cause: UInt) -> Bool {
    ((cause >> ESR_EC_SHIFT) & ESR_EC_MASK) == (ExceptionClass.Svc64 as UInt)
}

/// The cause `boot.S`'s interrupt entry calls the kernel with.
///
/// An interrupt arrives on a vector of its own, with no syndrome register to
/// decode, but the kernel's trap handler takes one cause word for every trap.
/// So the entry passes a value the syndrome register cannot hold: the syndrome
/// is 32 bits wide, so any bit above that is impossible. `boot.S` builds the
/// same value (`.equ IRQ_CAUSE_HI`); the two are one description and must move
/// together.
static IRQ_CAUSE: UInt = 1 << 32

/// Is this trap an interrupt rather than a syscall or a fault?
///
/// Interrupts only ever arrive from user mode: they are masked at this
/// exception level throughout, and the vector table sends an interrupt taken at
/// kernel level to the kernel-bug path.
public func is_interrupt(cause: UInt) -> Bool {
    cause == IRQ_CAUSE
}

/// A short symbolic name for a raw `ESR_EL1` value.
///
/// `from(raw:)` is total, and the hardware may raise a class this kernel does
/// not model, so the miss has its own name rather than an arm. Everything it
/// does model is an exhaustive `match` in `describe`, so a class added to the
/// enum fails to compile until it is given a name.
public func cause_tag(cause: UInt) -> String {
    let ec = (cause >> ESR_EC_SHIFT) & ESR_EC_MASK
    guard let decoded = ExceptionClass.from(raw: ec) else {
        return "unexpected-trap"
    }
    decoded.describe(cause & ESR_ISS_MASK)
}

/// Overlay the saved context. One view construction, then ordinary field names.
func frame_at(frame_addr: UInt) unsafe -> UnsafeMemory<TrapFrame, Normal> {
    UnsafeMemory<TrapFrame, Normal>(frame_addr)
}

/// Where the trapped context resumes: the faulting instruction on a fault, the
/// interrupted one on an interrupt.
public func trap_pc(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).elr.read()
}

/// §5.7: x0 = handle, x8 = op, args x1-x3.
public func syscall_handle(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).x0.read()
}

public func syscall_op(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).x8.read()
}

public func syscall_arg0(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).x1.read()
}

public func syscall_arg1(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).x2.read()
}

public func syscall_arg2(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).x3.read()
}

/// Place a syscall's (status, value) pair where the caller will find it.
///
/// Nothing advances the saved PC here, unlike Profile A: `svc` traps with
/// `ELR_EL1` already pointing at the following instruction, so a kernel that
/// stepped past the syscall would skip a real one. Advancing is therefore the
/// HAL's decision and not the kernel's.
public func syscall_return(frame_addr: UInt, status: UInt, value: UInt) unsafe {
    let frame = frame_at(frame_addr)
    frame.x0.write(status)
    frame.x1.write(value)
}

// =============================================================================
// Diagnostics
// =============================================================================
//
// The kernel-bug path formats its own report in Saw with the helpers
// `rt/common/` provides. This is not the panic seam: `__saw_rt_write` has a
// stricter contract and shares none of this. These two use `String` and the
// ordinary runtime, which is fine on a path the kernel reaches having already
// decided to stop.

/// Write an ASCII string to the console, byte by byte.
func report_str(msg: String) {
    for scalar in msg.scalars() {
        console_byte(ascii_byte(scalar))
    }
}

/// Write a machine word as `0x` + one hex digit per nibble, at this target's
/// width: sixteen here, eight on Profile A.
func report_hex(v: UInt) {
    report_str("0x")
    let digits = hex_digits_per_word()
    var n = 0
    while n < digits {
        console_byte(hex_digit_of(v, n))
        n = n + 1
    }
}

// =============================================================================
// The kernel-bug path
// =============================================================================

/// Set once a kernel fault is being reported, so a second fault taken while
/// reporting exits immediately instead of looping on the console.
///
/// An `unsafe static var` rather than an `Atomic`: SOS is a uniprocessor kernel
/// that enables no interrupt sources in kernel mode (spec §7), and this flag is
/// only touched with the machine already failing.
unsafe static var IN_KERNEL_FAULT: UInt8 = 0

/// A trap the kernel itself took, i.e. a kernel bug. Reports the exception
/// class and stops the machine with it as the status, the arm64 spelling of
/// Profile A's "cause in the finisher's code bits". Never returns, and never
/// hangs.
///
/// `boot.S` reads the three system registers, because `mrs` names a register at
/// assembly time and Saw cannot spell one. Everything after that is formatting.
@export("sos_kernel_fault")
public func kernel_fault(esr: UInt, elr: UInt, far: UInt) unsafe {
    let ec = (esr >> ESR_EC_SHIFT) & ESR_EC_MASK
    if IN_KERNEL_FAULT != 0 {
        exit_fail(ec)
    }
    IN_KERNEL_FAULT = 1
    report_str("SOS: kernel fault ec=")
    report_hex(ec)
    report_str(" elr=")
    report_hex(elr)
    report_str(" far=")
    report_hex(far)
    report_str("\n")
    exit_fail(ec)
}

// =============================================================================
// Translation tables: this profile's isolation primitive
// =============================================================================
//
// Spec §5b: on Profile B an AddressSpace is a page-table root. Two kinds of
// table hierarchy exist, in one static pool:
//
//   - one per-process set for each process slot, selected by `TTBR0_EL1` with
//     the slot index as the ASID. It maps only the user windows, ungranted at
//     reset. Every other entry is invalid, so a page a process was not granted
//     is a translation fault.
//   - the kernel's linear map, built once and installed in `TTBR1_EL1`, which
//     no process switch touches.
//
// A per-process set (`build_set`), six tables:
//
//   level 1 (1 GiB entries, 39-bit VA out of the low translation base)
//     [0]  0x0000_0000  -> the device level 2
//     [1]  0x4000_0000  -> level 2
//     rest             invalid, which is what makes UNMAPPED_PROBE fault
//   level 2 (over RAM)
//     entries covering the grant window -> level 3 tables, page-granular
//     rest             invalid
//   level 3 (two tables, 4 KiB pages over the grant window, `GRANT_PAGES`)
//     ungranted        invalid (`DESC_ABSENT`)
//     granted pages    EL0 RO or RW and EL0-executable as the grant asks,
//                      never executable at EL1
//   device level 2
//     one entry, the block containing the console UART -> the device level 3
//     rest             invalid
//   device level 3 (4 KiB device pages over that one 2 MiB block)
//     ungranted        invalid (`DESC_ABSENT`)
//     granted pages    Device-nGnRE, EL0 RW, never executable
//
// The kernel linear map (`linmap_build`), three tables:
//
//   level 1
//     [0]  the device gigabyte -> a level 2 of 2 MiB Device blocks, EL1 RW,
//          never executable at either level
//     [1]  RAM's gigabyte      -> a level 2 of 2 MiB Normal blocks over
//          `RAM_LEN`, EL1 RW, never executable at EL0, and never executable at
//          EL1 except the one block holding the kernel image
//          (`KERNEL_IMAGE_BLOCK`)
//
// There is no level 3 in the linear map: page granularity is a property of the
// user windows, which live in the per-process sets. The sets do not repeat the
// EL1 half.
//
// The RAM grant window is the first `GRANT_PAGES` pages of RAM. It has to cover
// the kernel image as well as the root region, because the harness's cases
// grant a payload that executes in place inside the image. A page is reachable
// from EL0 only if it is granted: EL0 default-deny is the same property PMP
// gives Profile A.
//
// A block is not a grant unit: granting EL0 the block that holds the console
// would hand over every peripheral beside it. So the console's 2 MiB block is
// a table in the set, the minimum that makes a single page grantable.
//
// The kernel image block staying EL1-RWX is the arm64 spelling of "M-mode is
// unconstrained", not a claim about kernel W^X, which neither profile has.
//
// All of the above is arithmetic and 64-bit stores, so it is Saw. What stays
// native is the activation (system-register writes, a barrier pair and a TLB
// flush), because a system register is named at assembly time: `boot.S` enables
// the MMU and installs `TTBR1_EL1`, and `sink.c` holds the barrier and register
// leaves.

/// Descriptors in one per-process set, written once so the length and the
/// initializer cannot disagree: level 1, level 2, the two RAM level-3 tables
/// (`GRANT_PAGES`), the device level 2 and the device level 3. Within a set
/// the tables sit at `LEVEL2_OFFSET`, `LEVEL3_OFFSET`, `DEVICE_LEVEL2_OFFSET`
/// and `DEVICE_LEVEL3_OFFSET`.
///
/// All-zero until built, so the pool costs no image bytes. An unwritten
/// descriptor is invalid, which is the state a default-deny map wants.
static PT_SET_DESCRIPTORS: Int = 512 + 512 + 1024 + 512 + 512

/// Bytes in one set. The same number as `PT_SET_DESCRIPTORS * DESC_BYTES`,
/// spelled in `UInt` because it is address arithmetic; the assert below keeps
/// the two spellings from drifting.
static PT_SET_BYTES: UInt = (512 + 512 + 1024 + 512 + 512) * 8

/// How many persistent table sets the pool holds: one per process slot.
///
/// It is declared here rather than read from the kernel because a HAL that had
/// to import the kernel to size its own page tables would be the wrong way
/// round (the same reason `align_up` is duplicated below).
/// `kernel/core/limits.saw` static_asserts that the kernel's `MAX_PROCESSES`
/// fits this, as it does for `GRANT_ROW_BUDGET`, so the two cannot disagree
/// without the build saying so.
///
/// It is strictly larger than `MAX_PROCESSES`. `SlabKind.Processes` lets a
/// deployment donate process slots, but this pool is static and donation cannot
/// reach it, so on a translating tier a donated slot with no table set behind
/// it could never run. The kernel takes the smaller of the two numbers at run
/// time (`kcore.process.process_slots_usable`) and answers `NoResource` past
/// it.
///
/// The cost is paid in `.bss` only. The pool holds this many sets of
/// `PT_SET_DESCRIPTORS` descriptors, plus the linear map's descriptors and one
/// table of alignment slack (512). The slot count is also a margin: the
/// harness's largest case stays one slot below the wall rather than on it.
/// `.bss` is `NOLOAD`, so this costs no image bytes; it costs `boot.S`'s
/// zerofill and a set-build per slot.
///
/// `virt.ld`'s `ASSERT` on `_bss_end` against `ROOT_LOAD_BASE` is what catches
/// a raise that goes too far, which is why that assert names this constant.
public static PROT_DOMAIN_SLOTS: Int = 5

// The ASID is the slot index (see `prot_switch`), and `TCR_EL1.AS` = 0 makes
// the field 8 bits wide. Exceeding it would silently alias two domains' TLB
// entries onto one tag, so it is checked rather than reasoned about.
static_assert(PROT_DOMAIN_SLOTS <= 256,
              "the ASID is the process slot index and TCR_EL1.AS=0 gives it 8 bits")

/// The kernel's own tables: the linear map, which exists once. Three tables: a
/// level 1, a level 2 over the device gigabyte, and a level 2 over RAM's
/// gigabyte. There is no level 3 anywhere, because nothing in the kernel's own
/// map is granted a page at a time; page granularity is a property of the user
/// windows, which live in TTBR0 and in the per-process sets above.
///
/// The per-process sets do not repeat the EL1 half: TTBR1 is walked, so kernel
/// mappings live here, once.
static LINMAP_DESCRIPTORS: Int = 512 + 512 + 512

/// Bytes in the linear map, the `UInt` spelling for address arithmetic.
static LINMAP_BYTES: UInt = (512 + 512 + 512) * 8

/// The pool: one set per process slot, back to back, then the linear map, plus
/// one table's worth of alignment slack for the run-time round-up.
///
/// It is one region rather than an array per table because the hardware
/// requires each table to be page-aligned and Saw has no alignment attribute on
/// a static. Rounding the base up at run time costs a few instructions at boot
/// and asks nothing of the linker script, which is per-profile where this shape
/// is not.
///
/// A `[UInt64; N]` static is 8-aligned, so rounding its base up to a page
/// advances it by at most 4096 - 8 = 4088 bytes, which is 511 descriptors. One
/// spare table covers that however many sets and kernel tables sit behind it.
/// Adding a table to a set or to the linear map means re-checking the slack.
static PT_DESCRIPTORS: Int = (PT_SET_DESCRIPTORS * PROT_DOMAIN_SLOTS
                              + LINMAP_DESCRIPTORS + 512)

unsafe static var PAGE_TABLES: [UInt64; PT_DESCRIPTORS] = [0; PT_DESCRIPTORS]

/// Which set is live in `TTBR0_EL1`. Written only by `prot_switch`.
///
/// It makes `prot_reset` / `prot_region` / `prot_device` mean "edit the
/// currently loaded set", which the legacy harness kernels in `tests/` rely on:
/// they program the protection surface directly, hold no grant record and never
/// switch a domain, so they must keep reaching the set the machine is running
/// on.
///
/// `unsafe static var`: one word of compound global state resting on spec §7's
/// serialization argument (uniprocessor, and every writer runs with no
/// preemption point in it).
unsafe static var CURRENT_SET: UInt = 0

/// Descriptors per table at the 4 KiB granule: a table is one page of 8-byte
/// entries.
static PT_ENTRIES: UInt = 512
/// Pages the level-3 tables cover: the RAM grant window, reachable at page
/// granularity.
static GRANT_PAGES: UInt = 1024
static PAGE_SIZE: UInt = 4096
static DESC_BYTES: UInt = 8
/// Byte offsets of the later tables within a per-process set. The linear map
/// reuses `LEVEL2_OFFSET` and `LEVEL3_OFFSET` for its device and RAM level-2
/// tables.
static LEVEL2_OFFSET: UInt = 4096
static LEVEL3_OFFSET: UInt = 8192
static DEVICE_LEVEL2_OFFSET: UInt = 16_384
static DEVICE_LEVEL3_OFFSET: UInt = 20_480

static RAM_BASE: UInt = 0x4000_0000

/// How much RAM this board wires: `virt.ld`'s `MEMORY` LENGTH, restated because
/// the linear map has to know where to stop. Mapping exactly the RAM that
/// exists (rather than the whole gigabyte the level-1 entry covers) makes a
/// kernel dereference past the end of memory a translation fault instead of a
/// read of nothing.
static RAM_LEN: UInt = 128 * 1024 * 1024

// The linear map's own bound: every byte of RAM must fit under the offset for
// `pa | LINMAP_OFFSET` to be a pure OR. The device asserts sit with the seam.
static_assert(RAM_BASE + RAM_LEN - 1 <= LINMAP_PHYS_MASK,
              "RAM must fit under the linear-map offset for the OR/AND pair to be exact")

static PAGE_SHIFT: Int = 12
/// Where the ASID sits in `TTBR0_EL1`: bits 63:48, of which `TCR_EL1.AS` = 0
/// makes bits 55:48 significant. `PROT_DOMAIN_SLOTS` slots use that many of
/// those 256, and the `static_assert` beside that constant keeps the
/// ASID-as-slot-index encoding honest.
static TTBR_ASID_SHIFT: Int = 48
static BLOCK_SHIFT: Int = 21              // a level-2 block is 2 MiB
static MAIR_INDEX_SHIFT: Int = 2          // descriptor bits 4:2

/// The 2 MiB block the console UART sits in, and its base. The device level-3
/// table covers exactly this block, so a page grantable to EL0 is a page inside
/// it (`prot_device` diagnoses anything else).
static DEVICE_WINDOW_BASE: UInt = (UART_BASE >> BLOCK_SHIFT) << BLOCK_SHIFT
static DEVICE_WINDOW_LEN: UInt = 1 << BLOCK_SHIFT

// Descriptor bits (ARMv8-A VMSA, 4 KiB granule). Each is a lone architectural
// bit position, a standalone quantity, which is what a `static` is for. The two
// descriptor fields that are a closed set of alternatives are the enums below,
// where an exhaustive `match` and a pinned value are worth having.
static DESC_VALID: UInt64 = 0x1
static DESC_BLOCK: UInt64 = 0x0           // bit 1 clear at levels 1-2
static DESC_TABLE: UInt64 = 0x2           // bit 1 set at levels 1-2
static DESC_PAGE: UInt64 = 0x2            // at level 3 the same bit means "page"
static ATTR_SH_INNER: UInt64 = 0x300      // bits 9:8 — inner shareable
static ATTR_AF: UInt64 = 0x400            // bit 10 — access flag
/// Bit 11, not-global: this translation belongs to the ASID that installed it.
///
/// It makes a per-process set safe to cache. Every image links at
/// `USER_IMAGE_BASE`, so one VA resolves to different frames, or to nothing, in
/// different sets, and a global entry for it would let one process's cached
/// translation answer another's access. Every descriptor the two grant windows
/// hold carries this bit; the linear map's blocks stay global on purpose,
/// because they are identical for every process and sharing one TLB entry for
/// them is free and correct.
static ATTR_NG: UInt64 = 0x800
static ATTR_PXN: UInt64 = 0x20_0000_0000_0000   // bit 53 — no execute at EL1
static ATTR_UXN: UInt64 = 0x40_0000_0000_0000   // bit 54 — no execute at EL0

/// The access-permission field, descriptor bits 7:6. Exactly one of the four is
/// in a descriptor, which is why this is an enum rather than four constants
/// that could be OR-ed together by accident.
enum AccessPerm: UInt64 {
    case El1Rw = 0,          // EL1 read/write, EL0 no access
    case El0Rw = 64,         // EL1 + EL0 read/write
    case El1Ro = 128,        // EL1 read-only, EL0 no access
    case El0Ro = 192,        // EL1 + EL0 read-only
}

/// Which memory-attribute index a descriptor selects. The case value is the
/// index, and `mair_value()` below builds the register those indices describe
/// out of the same cases, so a type added here cannot leave its attribute byte
/// behind.
///
/// `Device` is the strictest the architecture has (non-Gathering,
/// non-Reordering, no Early write acknowledgement) and is what the kernel maps
/// its own MMIO with, so nothing sits between a store and the device.
/// `DeviceNGnRE` relaxes exactly one of those: a write may be acknowledged
/// before it reaches the peripheral, the ordinary attribute for a driver's
/// register block and what a granted device page carries. Neither may be
/// Normal-cacheable: a cached PL011 mapping would let a register read come out
/// of a line filled minutes ago.
enum MemoryType: UInt64 {
    case Device = 0,         // Device-nGnRnE
    case Normal = 1,         // Normal, write-back, read/write-allocate
    case DeviceNGnRE = 2,    // Device, early write acknowledgement permitted
}

extension MemoryType {
    /// This type as the attribute-index bits of a descriptor.
    func attr_index(&self) -> UInt64 {
        (self as UInt64) << MAIR_INDEX_SHIFT
    }
}

static MAIR_ATTR_DEVICE: UInt = 0x00
static MAIR_ATTR_NORMAL: UInt = 0xFF
static MAIR_ATTR_DEVICE_NGNRE: UInt = 0x04
static BITS_PER_MAIR_ATTR: Int = 8

/// The memory-attribute register the `MemoryType` indices describe: one byte
/// per index, low index first.
///
/// It is the other half of the descriptor encoding this file owns. `boot.S`
/// installs MAIR before any compiled code runs, so `sink.c` spells the value
/// again as `sos_boot_mair`, and `sos_mmu_tables` compares that copy against
/// this function on every boot, stopping the machine with
/// `SOS_ABORT_MAIR_DRIFT` if they differ. A memory type added above needs the
/// matching edit there.
@export("sos_mair_value")
func mair_value() -> UInt {
    ((MAIR_ATTR_DEVICE << (BITS_PER_MAIR_ATTR * ((MemoryType.Device as UInt64) as Int)))
     | (MAIR_ATTR_NORMAL << (BITS_PER_MAIR_ATTR * ((MemoryType.Normal as UInt64) as Int)))
     | (MAIR_ATTR_DEVICE_NGNRE
        << (BITS_PER_MAIR_ATTR * ((MemoryType.DeviceNGnRE as UInt64) as Int))))
}

/// This HAL's own failure code, distinct from anything the kernel or root
/// chooses. A grant the window cannot express is a kernel bug, not an image
/// problem, so it does not travel through the loader's `fatal_image`.
static ABORT_GRANT_OUTSIDE_WINDOW: UInt = 66

/// Round `v` up to the next multiple of `align` (a power of two).
///
/// The kernel core has one of these too and they are deliberately not shared: a
/// HAL that had to import the kernel to build its own page tables would be the
/// wrong way round.
func align_up(v: UInt, align: UInt) -> UInt {
    let rem = v & (align - 1)
    if rem == 0 {
        v
    } else {
        v + (align - rem)
    }
}

/// The page-aligned physical base of the whole pool: set 0's level-1 table.
///
/// Everything downstream of this number is the hardware's reading of it: a
/// `TTBR` holds a physical table base, and so does every table descriptor that
/// points at a next level. The pointer arrives as a kernel address (a Saw
/// reference to a static, which the linker placed in the high half), so this is
/// one of the seam's few `virt_to_phys` sites, and `put_desc` converts back at
/// the store.
///
/// Alignment survives the conversion in either order: the offset's low
/// `VA_BITS` bits are zero and `PAGE_SIZE` divides `2^VA_BITS`, so masking
/// never disturbs a page boundary.
func pool_base() unsafe -> UInt {
    align_up(virt_to_phys(((&var PAGE_TABLES) as UnsafePointer<UInt64>) as UInt),
             PAGE_SIZE)
}

/// The page-aligned base of `set`'s six tables.
///
/// Sets are `PT_SET_BYTES` apart and the pool base is page-aligned, so every
/// set's level-1 table is page-aligned too — which is what the hardware
/// requires and what makes one round-up serve the whole pool.
func set_base(set: UInt) unsafe -> UInt {
    pool_base() + set * PT_SET_BYTES
}

/// The page-aligned base of the live set's tables: the set the machine is
/// running on.
func tables_base() unsafe -> UInt {
    set_base(CURRENT_SET)
}

/// Write descriptor `index` of the table at physical address `table`.
///
/// This is the one dereference of a table address in this file. Table addresses
/// travel as physical throughout (they are what a descriptor and a `TTBR`
/// hold), so the linear-map conversion belongs at the store rather than at each
/// place a table base is computed. Every window walk, set build and grant edit
/// reaches memory through this line.
func put_desc(table: UInt, index: UInt, desc: UInt64) unsafe {
    UnsafeMemory<UInt64, Normal>(phys_to_virt(table + index * DESC_BYTES)).write(desc)
}

/// An ungranted page: a zero descriptor, which is invalid. That is the whole
/// encoding: no output address, no permissions, no attributes to get wrong.
///
/// A set holds only its process's grants. The kernel reaches its own text,
/// stack and table pool, and a peer's RAM for the copy doors, through TTBR1's
/// linear map, which no process switch touches, so TTBR0 owes the kernel
/// nothing. Isolation is therefore the absence of a translation rather than the
/// absence of a permission.
///
/// Both windows, RAM and device, share this one spelling: "not granted" carries
/// no attributes.
static DESC_ABSENT: UInt64 = 0

/// Every page of the window back to ungranted.
func reset_window(level3: UInt) unsafe {
    var i: UInt = 0
    while i < GRANT_PAGES {
        put_desc(level3, i, DESC_ABSENT)
        i = i + 1
    }
}

/// Every page of the device window back to ungranted.
func reset_device_window(level3: UInt) unsafe {
    var i: UInt = 0
    while i < PT_ENTRIES {
        put_desc(level3, i, DESC_ABSENT)
        i = i + 1
    }
}

/// The physical base of the linear map's level-1 table: the value `TTBR1_EL1`
/// holds for the life of the machine.
///
/// It sits after every process set in the same pool, so one run-time round-up
/// serves the whole pool.
func linmap_base() unsafe -> UInt {
    pool_base() + (PROT_DOMAIN_SLOTS as UInt) * PT_SET_BYTES
}

/// Which 2 MiB block of RAM the kernel image occupies: the one block the linear
/// map leaves executable. Zero, and `virt.ld`'s `_bss_end` assert keeps it so;
/// see `linmap_build`.
static KERNEL_IMAGE_BLOCK: UInt = 0

/// This HAL's second failure code: the linker script and this file disagree
/// about where the kernel lives. Distinct from `ABORT_GRANT_OUTSIDE_WINDOW` and
/// from anything the kernel or root chooses.
static ABORT_LINMAP_OFFSET: UInt = 67

/// Do the linker script and this file agree about where the kernel lives?
///
/// `LINMAP_OFFSET` is written twice: here, and in `virt.ld`, which adds it to
/// the load address and takes it back off with `AT`. Nothing at build time can
/// compare the two (a Saw `static`'s value is not a linker symbol), so they are
/// compared at boot against the address the linker gave a static this file
/// owns: one `and` and two compares, before anything can depend on being wrong.
///
/// It runs first in `linmap_build`, while the boot tables are still live and
/// the console still answers, so the report is reachable rather than a silent
/// stop.
func linmap_offset_probe() unsafe {
    let here = ((&var PAGE_TABLES) as UnsafePointer<UInt64>) as UInt
    if (here & LINMAP_OFFSET) != LINMAP_OFFSET {
        report_str("SOS: kernel is not linked in the high half: ")
        report_hex(here)
        report_str("\n")
        exit_fail(ABORT_LINMAP_OFFSET)
    }
    let pa = virt_to_phys(here)
    if pa < RAM_BASE || pa >= RAM_BASE + RAM_LEN {
        report_str("SOS: kernel physical address is outside RAM: ")
        report_hex(pa)
        report_str("\n")
        exit_fail(ABORT_LINMAP_OFFSET)
    }
}

/// Build the kernel's own map and hand back its level-1 base. `boot.S` installs
/// it in `TTBR1_EL1` from the identity map and never writes that register
/// again.
///
/// Two level-2 tables and nothing finer: 2 MiB Device blocks over the device
/// gigabyte, 2 MiB Normal blocks over the RAM this board wires. A kernel
/// dereference past `RAM_LEN` finds an invalid descriptor rather than a mapping
/// of nothing, which is why the walk stops at the real length instead of
/// filling the level-1 entry's whole gigabyte.
///
/// PXN is set everywhere the kernel's own text is not: exactly one 2 MiB block
/// is kernel-executable, the one the image occupies. The device half is PXN and
/// UXN throughout, since registers are not instructions.
///
/// "Exactly one block" holds because `virt.ld` requires the whole kernel image
/// to end below `ROOT_LOAD_BASE` (0x4020_0000) so `.bss` cannot overrun root's
/// load address, and that bound is the top of RAM's first 2 MiB block. The
/// linker script's ceiling and this carve-out are one number; an image that
/// outgrew the block stops the build rather than silently running
/// non-executable.
///
/// Per-section W^X inside that block (`.text` RX, `.rodata` RO, `.data`/`.bss`
/// RW) is not done: it wants a level-3 table and page-aligned section bounds
/// the linker script does not publish. The block is EL1 RWX, so the kernel's
/// own data is executable to the kernel.
///
/// No preemption point: two level-1 stores, `PT_ENTRIES` device blocks and one
/// block per 2 MiB of `RAM_LEN`, before `kmain`, with no interrupt controller
/// yet.
@export("sos_linmap_build")
func linmap_build() unsafe -> UInt {
    linmap_offset_probe()

    let level1 = linmap_base()
    let dev_level2 = level1 + LEVEL2_OFFSET
    let ram_level2 = level1 + LEVEL3_OFFSET

    put_desc(level1, 0, (dev_level2 as UInt64) | DESC_VALID | DESC_TABLE)
    put_desc(level1, 1, (ram_level2 as UInt64) | DESC_VALID | DESC_TABLE)

    // The device gigabyte: everything below RAM, EL1 read/write, never
    // executable at either level, strictest device attribute. The kernel's UART
    // and its interrupt controller are both in here.
    var d: UInt = 0
    while d < PT_ENTRIES {
        put_desc(dev_level2, d,
                 ((d << BLOCK_SHIFT) as UInt64)
                 | DESC_VALID | DESC_BLOCK | MemoryType.Device.attr_index()
                 | ATTR_AF | (AccessPerm.El1Rw as UInt64) | ATTR_PXN | ATTR_UXN)
        d = d + 1
    }

    // RAM: Normal cacheable, inner shareable, EL1 read/write, never executable
    // at EL0. Global on purpose: these translations belong to the kernel rather
    // than to an address space, so `ATTR_NG` would cost a TLB entry per process
    // for a mapping every process shares.
    var i: UInt = 0
    while i < (RAM_LEN >> BLOCK_SHIFT) {
        var block = (((RAM_BASE + (i << BLOCK_SHIFT)) as UInt64)
                     | DESC_VALID | DESC_BLOCK | MemoryType.Normal.attr_index()
                     | ATTR_AF | ATTR_SH_INNER | (AccessPerm.El1Rw as UInt64)
                     | ATTR_UXN)
        if i != KERNEL_IMAGE_BLOCK {
            block = block | ATTR_PXN
        }
        put_desc(ram_level2, i, block)
        i = i + 1
    }
    level1
}

/// Build the per-process table sets and hand back set 0's base, which is what
/// `TTBR0_EL1` starts on.
///
/// It runs with the MMU already on, from `boot.S` after the jump into the high
/// half and through the boot tables that jump installed. `put_desc` converts,
/// and the addresses in every descriptor stay physical.
///
/// No preemption point in any of the walks below: each set is a few table
/// links plus a full reset of both level-3 windows, `PROT_DOMAIN_SLOTS` times.
/// This runs before `kmain`, with no interrupt controller yet, so there is
/// nothing a point could deliver.
@export("sos_page_tables_build")
func page_tables_build() unsafe -> UInt {
    var set: UInt = 0
    while set < (PROT_DOMAIN_SLOTS as UInt) {
        build_set(set_base(set))
        set = set + 1
    }
    // Set 0 is `ROOT_PROCESS`'s (`kernel/core/limits.saw`: `ROOT_PROCESS = 0`),
    // and the boot door's `load_domain(ROOT_PROCESS)` switches to it
    // explicitly, so the ASID the machine starts on and the one root runs under
    // are the same number and nothing runs on a set that is not its own.
    set_base(0)
}

/// Build one complete set at `level1`: the two user windows, empty, and the
/// tables that reach them.
///
/// `TTBR0_EL1` is purely the user's register. A set maps the 4 MiB RAM grant
/// window and the console's device block at page granularity, both starting
/// ungranted, and every other address in the low half is invalid: no EL1 blocks
/// over RAM, no EL1 device blocks, no kernel anything.
///
/// The kernel is reachable from itself no matter which set is live, including
/// no set at all: `TCR_EL1.EPD1` is clear and the linear map is in TTBR1, which
/// no switch touches, and the cross-process copy funnels (`place_image`,
/// `copy_in`, `copy_out`) convert the physical address they resolve and
/// dereference through it.
///
/// A stray EL0 access to a non-granted window page is a translation fault, not
/// a permission fault. Spec §5.7's reported reason does not move, because
/// `cause_tag` decodes the ESR's `EC` field and the direction bit and never the
/// `DFSC` class; both are `EC` 0x24 and both render through `abort_direction`.
///
/// The level-2 and device level-2 tables stay full-size even though few entries
/// are live (`GRANT_PAGES / PT_ENTRIES` in the RAM level 2, one in the device
/// level 2): a translation table is a page, so an unused entry frees a
/// descriptor and never a table.
func build_set(level1: UInt) unsafe {
    let level2 = level1 + LEVEL2_OFFSET
    let level3 = level1 + LEVEL3_OFFSET
    let dev_level2 = level1 + DEVICE_LEVEL2_OFFSET
    let dev_level3 = level1 + DEVICE_LEVEL3_OFFSET

    // Level 1: a table over the device space below RAM, a table over RAM, and
    // nothing else; every other entry stays zero, i.e. invalid.
    put_desc(level1, 0, (dev_level2 as UInt64) | DESC_VALID | DESC_TABLE)
    put_desc(level1, 1, (level2 as UInt64) | DESC_VALID | DESC_TABLE)

    // The device level 2: one live entry, the block holding the console, which
    // points at a level-3 table so a single register page can be granted to
    // EL0. Every other entry stays zero: the kernel reaches its own MMIO
    // through the linear map, so a user set has no reason to name it.
    put_desc(dev_level2, DEVICE_WINDOW_BASE >> BLOCK_SHIFT,
             (dev_level3 as UInt64) | DESC_VALID | DESC_TABLE)
    reset_device_window(dev_level3)

    // Level 2 over RAM: the grant window's entries point at the level-3 tables,
    // where permissions are editable a page at a time. Every other entry stays
    // zero, which makes RAM outside the window unreachable from this process
    // rather than merely EL0-denied.
    var t: UInt = 0
    while t < GRANT_PAGES / PT_ENTRIES {
        put_desc(level2, t,
                 ((level3 + t * PT_ENTRIES * DESC_BYTES) as UInt64)
                 | DESC_VALID | DESC_TABLE)
        t = t + 1
    }

    reset_window(level3)
}

/// A grant the window cannot express. Never returns.
///
/// Skipping the page would be safe in the deny direction, but the kernel would
/// silently grant less than it was asked for, and the symptom would be a
/// user-mode fault at some unrelated later address. The only way to get here is
/// a memory map that outgrew the window, which is a kernel bug and reads as
/// one.
func grant_outside_window(va: UInt) {
    report_str("SOS: grant outside the page-granular window: ")
    report_hex(va)
    report_str("\n")
    exit_fail(ABORT_GRANT_OUTSIDE_WINDOW)
}

/// Revoke every grant. User mode then reaches nothing at all, the default-deny
/// the grants below carve out of.
///
/// Both windows, because a device grant is as revocable as a RAM one: a new
/// process must not inherit the last one's registers.
///
/// No preemption point here or in the `prot_region` / `prot_device` walks below
/// (at most `GRANT_PAGES` + `PT_ENTRIES` stores between them). They are bounded
/// and RAM-speed, and a half-rewritten descriptor table is an in-flight
/// invariant: the staged `prot_*` sequence is one edit, published by
/// `prot_commit`.
public func prot_reset() unsafe {
    reset_window(tables_base() + LEVEL3_OFFSET)
    reset_device_window(tables_base() + DEVICE_LEVEL3_OFFSET)
}

/// Stage grant `idx` as [base, top) with `perms`, a mask in the `SegFlag`
/// vocabulary.
///
/// `idx` is unused here: PMP has a fixed number of numbered regions and this
/// profile has pages, so the index is a Profile-A budget concept the seam
/// carries for both.
///
/// A grant installs exactly the permissions the image asked for, the same
/// contract Profile A's PMP has, so the two profiles cannot disagree about what
/// an image means. W^X for an image's segments rests on its linker script
/// alone: the loader's `has_sane_perms` refuses write-without-read and
/// executable device grants but not W|X, and a segment asking for R|W|X is
/// mapped EL0-RW without `ATTR_UXN`. Silently dropping a bit the image asked
/// for would hide a bad image rather than refuse it. `PXN` is the one thing
/// added unconditionally: the kernel must not execute user memory even by
/// accident, which Profile A's unconstrained M-mode cannot guarantee.
///
/// This legacy replay entry grants identity: the harness kernels in `tests/`
/// program this surface directly with ranges that are addresses as they are,
/// holding no grant record and no placed image, so the physical output is the
/// input. `prot_update` is the door placement goes through.
public func prot_region(idx: UInt, base: UInt, top: UInt, perms: UInt8) unsafe {
    install_region(tables_base() + LEVEL3_OFFSET, base, top, base, perms)
}

/// Grant the pages of `[base, top)` with `perms` in the level-3 window at
/// `level3`, translating to physical `pa`.
///
/// The walk `prot_region` and `prot_update` share: one takes the live set's
/// window, the other any process's.
///
/// `base`..`top` is the input range and `pa` is the output base. Both ends
/// round down to their own page, which keeps the offset between them exact: the
/// two are page-aligned together or misaligned together, because every
/// placement in this kernel is affine at page granularity.
func install_region(level3: UInt, base: UInt, top: UInt, pa: UInt,
                    perms: UInt8) unsafe {
    var attrs = (DESC_VALID | DESC_PAGE | MemoryType.Normal.attr_index() | ATTR_AF
                 | ATTR_SH_INNER | ATTR_NG | ATTR_PXN)
    if (perms & (SegFlag.Write as UInt8)) != 0 {
        attrs = attrs | (AccessPerm.El0Rw as UInt64)
    } else {
        attrs = attrs | (AccessPerm.El0Ro as UInt64)
    }
    if (perms & (SegFlag.Execute as UInt8)) == 0 {
        attrs = attrs | ATTR_UXN
    }
    // The bound is tested before the subtraction that would compute the page
    // index: `va - RAM_BASE` underflows below the base, and overflow checks are
    // always on, so the order turns a bad map into a diagnostic rather than a
    // panic from inside the protection primitive.
    let va_start = base - (base & (PAGE_SIZE - 1))
    let pa_start = pa - (pa & (PAGE_SIZE - 1))
    var va = va_start
    while va < top {
        if va < RAM_BASE {
            grant_outside_window(va)
        }
        let page = (va - RAM_BASE) >> PAGE_SHIFT
        if page >= GRANT_PAGES {
            grant_outside_window(va)
        }
        put_desc(level3, page, ((pa_start + (va - va_start)) as UInt64) | attrs)
        va = va + PAGE_SIZE
    }
}

/// Stage grant `idx` as a device window over `[base, base + len)`.
///
/// The attribute is the point on this profile. A page is device memory because
/// its descriptor says so, not because of where it is, so a window mapped with
/// the Normal attribute would be cached, speculatively read and merged, and a
/// register block under that is wrong, not merely slow. `DeviceNGnRE` is the
/// ordinary driver attribute (see `MemoryType`), and both no-execute bits go in
/// unconditionally because registers are not instructions.
///
/// Access-size discipline is the driver's half and cannot be expressed in a
/// descriptor: device memory permits no unaligned and no multi-register access,
/// so a driver reads and writes each register at its own width (32 bits on this
/// board's console) and never memcpy's a register block. The attribute
/// guarantees that the hardware will not merge or split the accesses the driver
/// does make.
///
/// `idx` is unused, as it is in `prot_region`.
public func prot_device(idx: UInt, base: UInt, len: UInt) unsafe {
    install_device(tables_base() + DEVICE_LEVEL3_OFFSET, base, len)
}

/// Grant the device pages of `[base, base + len)` in the device window at
/// `dev_level3`: `install_region`'s twin.
func install_device(dev_level3: UInt, base: UInt, len: UInt) unsafe {
    let attrs = (DESC_VALID | DESC_PAGE | MemoryType.DeviceNGnRE.attr_index()
                 | ATTR_AF | ATTR_NG | (AccessPerm.El0Rw as UInt64)
                 | ATTR_PXN | ATTR_UXN)
    // Tested before the subtraction that computes the page index, for the
    // reason `install_region` gives.
    var va = base - (base & (PAGE_SIZE - 1))
    while va < base + len {
        if va < DEVICE_WINDOW_BASE || va >= DEVICE_WINDOW_BASE + DEVICE_WINDOW_LEN {
            grant_outside_window(va)
        }
        put_desc(dev_level3, (va - DEVICE_WINDOW_BASE) >> PAGE_SHIFT,
                 (va as UInt64) | attrs)
        va = va + PAGE_SIZE
    }
}

// =============================================================================
// Persistent per-process domains
// =============================================================================
//
// The seam above is replay-shaped: the kernel's grant record is authoritative
// and the hardware image is rebuilt from it at every switch. That is the MPU
// tier's shape and it stays that on Profile A. Here each process owns a
// persistent table set, edited when its record is edited, and a switch is one
// register write.
//
// The calls below are the whole of the difference, and every HAL answers them,
// which lets `kernel/core` spell one sequence for every profile. On the riscv32
// boards (virt and the ESP32-C3), `prot_replay_at_switch` answers true,
// `prot_isolated` answers true as it does here, and the domain edits leave the
// hardware alone. The flat profile answers both tier facts false, and its
// `prot_switch` reopens PMP.

/// Does this profile rebuild its protection image at every switch? No.
///
/// The one tier fact `load_domain` reads: replay-at-switch is MPU-only, since
/// an ASID means nothing if tables are rebuilt under it. A tier difference is
/// advertised by the HAL that knows which tier it is, never faked, and this
/// compile-time constant lets the replay loop fold away here and stay whole on
/// Profile A.
// The two tier facts are functions, not `static`s. A module-level `static` does
// not carry module identity the way a free function does: two modules in one
// compilation unit cannot both declare `PROT_ISOLATED`, while both may declare
// `prot_isolated()` and each caller gets its own. A build profile is a module
// that overrides part of another's seam (`hal/riscv32-flat` re-exports the
// riscv32 virt board's device half and answers differently about protection),
// so a seam value a profile may need to override cannot be a `static`. The
// other HAL constants (`PROT_GRAIN`, `GRANT_ROW_BUDGET`, `FRAME_BYTES`, the
// memory map) stay `static`s because no profile overrides them.
//
// Both fold anyway, since a leaf returning a literal inlines, so
// `load_domain`'s replay loop still compiles away where it is dead.

public func prot_replay_at_switch() -> Bool { false }

/// Can this platform deny? Yes: an EL0 access to a page whose descriptor does
/// not permit it takes a data abort.
///
/// The second tier fact, and the only one that reaches userspace:
/// `kernel/core` maps it to `sosabi.ProtectionTier` and `SystemOp.TierGet`
/// hands the word out.
///
/// The kernel lives under TTBR1 and the whole low half belongs to the user, so
/// what a process may reach is exactly what its own tables map: isolation by
/// absence rather than by permission bits in a shared window, a stronger form
/// of the same `true`.
public func prot_isolated() -> Bool { true }

/// The switch: make `p`'s tables the live ones.
///
/// One `msr` and an `isb`, with no descriptor stores and no TLB flush. The ASID
/// is the process slot index: `PROT_DOMAIN_SLOTS` of them, in a field the
/// architecture gives at least 8 bits for (`TCR_EL1.AS` is 0 here, so 8), so no
/// allocator is needed and the number is stable for a process's whole life.
/// `TCR_EL1.A1` is 0, so TTBR0 is what defines the ASID. The `static_assert` at
/// `PROT_DOMAIN_SLOTS` keeps that encoding true as the pool grows.
///
/// Entries stay valid across the switch because every window descriptor carries
/// `ATTR_NG` and is therefore tagged with the ASID that installed it: the
/// switch changes which tag matches, it does not invalidate anything.
public func prot_switch(p: UInt) unsafe {
    CURRENT_SET = p
    sos_ttbr0_write(set_base(p) | (p << TTBR_ASID_SHIFT))
}

/// The range edit: make `[base, top)` in `p`'s own tables say exactly `perms`,
/// whether or not `p` is the process currently running.
///
/// `perms == 0` is a revocation. A grant of nothing is the absence of a grant:
/// a non-granted window page is invalid, so removal writes the same zero
/// `reset_window` writes. The encoding cannot collide with a live grant because
/// the kernel refuses to record a permitting-nothing row at both of its doors:
///
///   - an image segment must be readable or executable
///     (`imgformat.has_sane_perms`), so `flags == 0` never reaches the loader's
///     `record_grant`;
///   - `map_access` refuses no access at all, by name, as a caller-visible
///     `BadArg`.
///
/// Reached from both record funnels: `record_grant` passes the row's real
/// permissions, `remove_grant` passes zero. Those are the only two places a
/// grant record changes shape, so the record and the tables move together by
/// construction.
///
/// The device window takes the same path, `device` picking which window. Its
/// grant direction ignores `perms`, as `prot_device` does: a device page is
/// read/write to EL0 and never executable, a property of registers and not of
/// the image's flag bits. Its revoke direction writes `DESC_ABSENT`. So `perms`
/// is read here only to answer grant-or-revoke.
///
/// `base`..`top` is the user's virtual range and `pa` is what it translates to:
/// the input range selects the descriptors and `pa` is the output address
/// written into them. The revoke arm reads only the virtual half, since
/// removing a translation is a statement about which addresses stop resolving.
///
/// The device arm ignores `pa` because `map_place` answered `pa` for it: a
/// register block is mapped at the address the board publishes, so its two
/// halves are one number.
public func prot_update(p: UInt, base: UInt, top: UInt, pa: UInt, perms: UInt8,
                        device: Bool) unsafe {
    let level1 = set_base(p)
    if perms == 0 {
        var va = base - (base & (PAGE_SIZE - 1))
        while va < top {
            if device {
                put_desc(level1 + DEVICE_LEVEL3_OFFSET,
                         (va - DEVICE_WINDOW_BASE) >> PAGE_SHIFT,
                         DESC_ABSENT)
            } else {
                put_desc(level1 + LEVEL3_OFFSET, (va - RAM_BASE) >> PAGE_SHIFT,
                         DESC_ABSENT)
            }
            va = va + PAGE_SIZE
        }
    } else if device {
        install_device(level1 + DEVICE_LEVEL3_OFFSET, base, top - base)
    } else {
        install_region(level1 + LEVEL3_OFFSET, base, top, pa, perms)
    }
    invalidate_domain(p)
}

/// Retire `p`'s domain: every page of both its windows back to invalid,
/// wholesale.
///
/// This is not a range edit with wide bounds. It is domain retirement, with two
/// properties `prot_update` cannot carry:
///
///   - It is the fail-closed mask. It resets the whole set rather than the
///     ranges the record happens to list, so it is correct even if the record
///     and the hardware have skewed. Spelling teardown as a walk of the rows
///     would make the cleanup depend on the bookkeeping whose failure it is
///     there to contain.
///   - It anchors the ASID-reuse invalidation to one lifecycle event. A process
///     slot, and therefore an address-space identifier, becomes reusable here
///     and nowhere else, so the invalidation that stops a new process
///     inheriting a dead one's cached translations has exactly one site.
///
/// Reached from `clear_domain` at teardown.
public func prot_clear(p: UInt) unsafe {
    let level1 = set_base(p)
    reset_window(level1 + LEVEL3_OFFSET)
    reset_device_window(level1 + DEVICE_LEVEL3_OFFSET)
    invalidate_domain(p)
}

/// Drop every cached translation belonging to `p`'s ASID.
///
/// By ASID rather than by VA: a grant row spans a whole region, often many
/// pages, so the by-VA form is one `tlbi` per page and buys nothing. The edit
/// is confined to a single process's set, every descriptor in that set's
/// windows is `ATTR_NG` and so carries the ASID, and no other domain's entries
/// can match the tag.
///
/// It runs on every edit, live domain or not. An edit to a non-current domain
/// needs no maintenance in principle, but `p`'s stale entries may still sit in
/// the TLB from the last time it ran, and one instruction is far cheaper than
/// being wrong about which case this is. Removal must invalidate eagerly in any
/// case: an unmap that waited would be a revocation that did not revoke.
func invalidate_domain(p: UInt) unsafe {
    sos_tlbi_asid(p)
}

// =============================================================================
// The interrupt controller
// =============================================================================
//
// Every interrupt on this board arrives through one controller, in two halves:
// a distributor that decides which line wins, shared by the machine, and a
// per-core interface the winner is delivered through. Both are ordinary MMIO,
// so all of this is Saw.
//
// The cycle is claim-then-complete: reading the acknowledge register both says
// which line won and marks it active, and writing the same value back ends it.
// Between the two the line cannot win again, which makes the handler
// non-reentrant for free.
//
// Unlike Profile A, the timer is one of these lines (a per-core one), so the
// tick path exercises this claim/complete cycle on every tick and the seam's
// `IRQ_TIMER` is a real line number.

/// The per-core interface: what may be delivered, what won, and what is done.
struct GicCpuRegs {
    ctlr: UInt32,               // +0x00  deliver to this core at all
    pmr: UInt32,                // +0x04  the priority a line must beat
    bpr: UInt32,                // +0x08  preemption grouping (unused: no nesting)
    iar: ReadOnly<UInt32>,      // +0x0C  acknowledge: claims the winning line
    eoir: WriteOnly<UInt32>,    // +0x10  end of interrupt
}

/// The distributor's own two registers. Everything else it has is an array
/// indexed by line (enables, priorities, targets), reached by address below,
/// because a register block struct cannot describe a 1024-entry table this
/// kernel touches a few entries of.
struct GicDistRegs {
    ctlr: UInt32,               // +0x000  forward anything at all
    typer: ReadOnly<UInt32>,    // +0x004  how many lines this board wired
}

struct Gic {
    dist: UnsafeMemory<GicDistRegs, Device>,
    cpu: UnsafeMemory<GicCpuRegs, Device>,
}

/// Distributor array offsets, and the one write-only command register.
static GICD_ISENABLER: UInt = 0x100
static GICD_ICENABLER: UInt = 0x180
static GICD_IPRIORITYR: UInt = 0x400
static GICD_ITARGETSR: UInt = 0x800
static GICD_SGIR: UInt = 0xF00

static GIC_ENABLE: UInt32 = 1
/// The priority floor: a line is delivered only if its priority is numerically
/// below this (lower means more urgent here), so one floor plus one shared
/// active level is the whole policy; SOS prioritizes in software (spec §7).
static GIC_PRIORITY_FLOOR: UInt32 = 0xF0
static GIC_PRIORITY_ACTIVE: UInt8 = 0x80
static GIC_CPU0: UInt8 = 0x01

/// Lines below this are per-core and have no target register: the
/// software-generated ones and the per-core peripheral ones, the timer among
/// them.
static GIC_PERCORE_LINES: UInt = 32
static GIC_LINES_PER_WORD: UInt = 32
static GIC_LINES_PER_TYPER_STEP: UInt = 32
static GIC_TYPER_LINES_MASK: UInt32 = 0x1F
/// What the acknowledge register reads as when nothing is deliverable.
static GIC_SPURIOUS: UInt = 1023
/// Send to the requesting core only: the software-trigger register's target
/// filter, in bits 25:24.
static GIC_SGIR_TO_SELF: UInt32 = 0x200_0000
static REGISTER_BYTES: UInt = 4

extension Gic {
    init() unsafe -> Gic {
        // The two controller halves by their physical bases, reached through
        // the linear map, the same conversion the console's driver makes.
        Gic(dist: UnsafeMemory<GicDistRegs, Device>(phys_to_virt(GIC_DIST_BASE)),
            cpu: UnsafeMemory<GicCpuRegs, Device>(phys_to_virt(GIC_CPU_BASE)))
    }

    /// How many lines this board wired, out of the field that counts them in
    /// blocks of 32.
    func line_count(&self) unsafe -> UInt {
        let blocks = ((self.dist.typer.read() & GIC_TYPER_LINES_MASK) as UInt) + 1
        blocks * GIC_LINES_PER_TYPER_STEP
    }

    func word_at(&self, base: UInt, line: UInt) unsafe -> UnsafeMemory<UInt32, Device> {
        UnsafeMemory<UInt32, Device>(phys_to_virt(
            GIC_DIST_BASE + base + (line / GIC_LINES_PER_WORD) * REGISTER_BYTES))
    }

    /// A per-line byte register: priorities and targets are one byte each,
    /// which is why these are not the word view above.
    func byte_at(&self, base: UInt, line: UInt) unsafe -> UnsafeMemory<UInt8, Device> {
        UnsafeMemory<UInt8, Device>(phys_to_virt(GIC_DIST_BASE + base + line))
    }

    /// Every line masked, then both halves on. Nothing is deliverable until
    /// `irq_unmask` opens a line.
    ///
    /// No preemption point. The distributor is off for the whole loop, so a
    /// half-disabled controller is in-flight IRQ-shared state, and there is
    /// nothing to deliver anyway since this brings the controller up. At most
    /// 32 word writes.
    func reset(&self) unsafe {
        self.dist.ctlr.write(0)
        let lines = self.line_count()
        var word: UInt = 0
        while word * GIC_LINES_PER_WORD < lines {
            let disable = UnsafeMemory<UInt32, Device>(phys_to_virt(
                GIC_DIST_BASE + GICD_ICENABLER + word * REGISTER_BYTES))
            disable.write(0xFFFF_FFFF)
            word = word + 1
        }
        self.dist.ctlr.write(GIC_ENABLE)
        self.cpu.pmr.write(GIC_PRIORITY_FLOOR)
        self.cpu.ctlr.write(GIC_ENABLE)
    }

    func unmask(&self, line: UInt) unsafe {
        self.byte_at(GICD_IPRIORITYR, line).write(GIC_PRIORITY_ACTIVE)
        // A per-core line is delivered to the core it belongs to and its target
        // register is read-only; a shared one has to be pointed at a core, and
        // this kernel is uniprocessor.
        if line >= GIC_PERCORE_LINES {
            self.byte_at(GICD_ITARGETSR, line).write(GIC_CPU0)
        }
        let enable = self.word_at(GICD_ISENABLER, line)
        enable.write((1 as UInt32) << ((line % GIC_LINES_PER_WORD) as UInt32))
    }

    /// Masking is a write-one-to-clear register, so this touches one line and
    /// needs no read-modify-write of the word around it.
    func mask(&self, line: UInt) unsafe {
        let disable = self.word_at(GICD_ICENABLER, line)
        disable.write((1 as UInt32) << ((line % GIC_LINES_PER_WORD) as UInt32))
    }

    func claim(&self) unsafe -> UInt {
        self.cpu.iar.read() as UInt
    }

    func complete(&self, line: UInt) unsafe {
        self.cpu.eoir.write(line as UInt32)
    }

    /// Raise a software-generated line on this core.
    func raise_to_self(&self, line: UInt) unsafe {
        let trigger = UnsafeMemory<UInt32, Device>(
            phys_to_virt(GIC_DIST_BASE + GICD_SGIR))
        trigger.write(GIC_SGIR_TO_SELF | (line as UInt32))
    }
}

/// The controller had nothing to give. Both profiles report a spurious
/// interrupt as this value; here the hardware says 1023 and the seam maps it,
/// and line 0 is a software-generated line SOS never raises.
public static IRQ_NONE: UInt = 0

/// The line the periodic timer arrives on.
public static IRQ_TIMER: UInt = TIMER_IRQ

/// The line `irq_raise_selftest_line` raises: a software-generated one, which
/// is this controller's own way to make an interrupt happen.
static SELFTEST_IRQ: UInt = 5

/// Bring the interrupt controller up with every line masked.
public func intc_init() unsafe {
    Gic().reset()
}

/// Let `line` interrupt the kernel.
public func irq_unmask(line: UInt) unsafe {
    Gic().unmask(line)
}

/// Stop `line` interrupting the kernel: spec §9's mask-on-fire, which the
/// Interrupt object's `ack` undoes.
public func irq_mask(line: UInt) unsafe {
    Gic().mask(line)
}

/// Which line is being serviced, or `IRQ_NONE`.
///
/// The cause is unused on this profile: an interrupt has its own vector, so the
/// controller is the only thing that knows which line it was. (Profile A
/// answers the timer half out of the cause word, which is why the seam passes
/// it at all.)
///
/// The acknowledge value is returned whole rather than masked to its line
/// number, because on a multi-core machine it also carries which core sent a
/// software-generated line and the completion has to give that back. This
/// kernel is uniprocessor, so the field is always zero and the value is the
/// line; an SMP port is where that stops being true.
public func irq_claim(cause: UInt) unsafe -> UInt {
    let acknowledged = Gic().claim()
    if acknowledged == GIC_SPURIOUS {
        return IRQ_NONE
    }
    acknowledged
}

/// End of service for `line`.
public func irq_complete(line: UInt) unsafe {
    Gic().complete(line)
}

/// Is `line` one this board wires?
///
/// The distributor reports how many it has, so the bound is read from the
/// hardware. Line 0 is a software-generated line SOS never raises and is what
/// the seam reports for "nothing", so it is excluded at the same time. The
/// timer's line is in this range on this profile, since it is an ordinary
/// controller line here; the kernel excludes it arch-free, because "the tick is
/// not for rent" is a policy rather than a fact about the board.
public func irq_line_valid(line: UInt) unsafe -> Bool {
    line != IRQ_NONE && line < Gic().line_count()
}

/// Ask for a pending line without a trap having delivered one: the idle path's
/// half of the seam.
///
/// It is `irq_claim` under a second name here: this controller answers "which
/// line won" out of one register whether or not a vector ran, so the cause word
/// `irq_claim` takes is already unused. Profile A's timer is not a controller
/// source, which is why the two names exist.
public func irq_poll() unsafe -> UInt {
    irq_claim(IRQ_CAUSE)
}

/// Park this core until an interrupt is pending.
///
/// It wakes on a pending physical interrupt whether or not this exception level
/// would take one, which is the property the idle path needs, since interrupts
/// stay masked at EL1 forever. The core sleeps, the line arrives, execution
/// continues at the next instruction, and `irq_poll` finds it.
public func wait_for_irq() {
    sos_wait_for_irq()
}

/// Raise a line from software, for interrupt bring-up. Returns the line raised.
///
/// This controller has a software trigger, so unlike Profile A no device is
/// involved: the line is one of the software-generated ones, raised at this
/// core. It is edge-like, one raise being one delivery, so nothing re-fires
/// after the handler completes.
///
/// It stays because a line raised in kernel mode and a line bound to no
/// Interrupt object (the report-and-leave-masked path) are reachable only
/// through this.
public func irq_raise_selftest_line() unsafe -> UInt {
    let gic = Gic()
    gic.unmask(SELFTEST_IRQ)
    gic.raise_to_self(SELFTEST_IRQ)
    SELFTEST_IRQ
}

// =============================================================================
// The core's physical timer
// =============================================================================
//
// The periodic tick comes from the core's own timer, which is system registers
// rather than MMIO, so unlike Profile A's memory-mapped comparator the touches
// below are C leaves, one instruction each; the arithmetic, the period and the
// policy are here.
//
// The counter is free-running and the compare register is an absolute deadline
// on the same scale; the line asserts while the counter is at or past it. That
// is a level condition, so servicing a fire means programming the next deadline
// rather than acknowledging one. The controller still needs its
// end-of-interrupt afterwards; on Profile A the timer is not a controller line
// at all.
//
// One compare register has two customers. The scheduler tick (spec §7) and the
// Timer objects (§2) share this single piece of hardware, and the seam takes an
// absolute deadline so that the sharing is the kernel's arithmetic: it programs
// the earliest of the two and this file never learns there were two.

extern "C" {
    // The timer's frequency in ticks per second: a property of the machine,
    // readable only through a system register.
    func sos_timer_freq() -> UInt
    // The control register: enabled, masked, and whether the timer has fired.
    func sos_timer_ctl_read() -> UInt
    func sos_timer_ctl_write(value: UInt)
    // The free-running counter, and the deadline it is compared against.
    func sos_timer_count() -> UInt
    func sos_timer_set_compare(value: UInt)
}

static TIMER_CTL_ENABLE: UInt = 1         // bit 0
static TIMER_CTL_FIRED: UInt = 4          // bit 2 — the condition is met
static NS_PER_SECOND: UInt64 = 1_000_000_000

/// Counter units to nanoseconds, exactly and without overflowing.
///
/// The split makes it exact at both ends. A plain `units * 1e9 / freq`
/// overflows a 64-bit product after about five minutes of uptime at this
/// machine's 62.5 MHz; a plain `units / (freq / 1e9)` is a division by zero,
/// since no sane timer runs at a gigahertz. Splitting into whole seconds plus a
/// remainder keeps every intermediate inside the word and loses nothing: the
/// remainder is below `freq`, so its product with 1e9 cannot overflow either.
func units_to_ns(units: UInt64) unsafe -> UInt64 {
    let freq = sos_timer_freq() as UInt64
    (units / freq) * NS_PER_SECOND + ((units % freq) * NS_PER_SECOND) / freq
}

/// Nanoseconds to counter units, the same split run backwards, rounding up.
///
/// Up rather than nearest, because the seam's contract is that a deadline never
/// fires early: the kernel treats an interrupt as "something may be due" and
/// reprograms if nothing is, so an early fire costs a round trip while a late
/// one costs nothing. The saturating guard keeps the kernel's "never" deadline
/// representable: the seconds product would otherwise overflow, and Saw's
/// overflow checks are on in a kernel.
func ns_to_units(ns: UInt64) unsafe -> UInt64 {
    let freq = sos_timer_freq() as UInt64
    let secs = ns / NS_PER_SECOND
    if secs > UInt64.max / freq {
        return UInt64.max
    }
    let rem = ns % NS_PER_SECOND
    secs * freq + ((rem * freq) + NS_PER_SECOND - 1) / NS_PER_SECOND
}

/// This machine's monotonic time in nanoseconds since the counter started
/// (spec §2's Clock row).
///
/// The counter is the clock. There is no second time source and no software
/// accumulator: the free-running counter is what a `Clock.now()` reads and what
/// every Timer deadline is measured against, so the two cannot disagree about
/// what "now" is. Its epoch is the machine's power-on, which matches the
/// Monotonic domain's contract: it never steps and never goes backwards.
public func timer_now_ns() unsafe -> UInt64 {
    units_to_ns(sos_timer_count() as UInt64)
}

/// Program the one compare register to interrupt at `at_ns`.
///
/// A deadline already past fires as soon as interrupts are deliverable. A
/// deadline of `UInt64.max` is the kernel's "never", and saturates to a counter
/// value this machine reaches in some nine thousand years.
///
/// The deadline is written before the timer is enabled, so a stale compare
/// value left over from an earlier schedule can never assert in the gap.
/// Enabling and unmasking every time is idempotent and lets a kernel that armed
/// no tick at boot still serve a Timer a process armed later.
public func timer_set_deadline_ns(at_ns: UInt64) unsafe {
    sos_timer_set_compare(ns_to_units(at_ns) as UInt)
    sos_timer_ctl_write(TIMER_CTL_ENABLE)
    irq_unmask(IRQ_TIMER)
}

/// Has the timer fired without a tick having been taken for it?
public func timer_pending() -> Bool {
    (sos_timer_ctl_read() & TIMER_CTL_FIRED) != 0
}
