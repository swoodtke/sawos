//! The Xtensa kernel HAL, Saw half: the ESP32-S3 board under Espressif QEMU,
//! a call0 kernel running call0 and windowed processes, on the `Flat`
//! protection tier.
//!
//! One directory holds the architecture and the board together, as
//! `hal/arm64/` does: there is one Xtensa board. The kernel core above this
//! file (`kernel/core/`) names no architecture and reaches the machine only
//! through the surface below. `../ABI.md` is the contract every board fact
//! here comes from, with the probe that produced it; `boot.S` (reset, vectors,
//! trap entry, restore) and `sink.c` (special registers, linker symbols,
//! `simcall`) are the parts of it that cannot be Saw.
//!
//! What the core gives this HAL to work with, and what it lacks:
//!   * no privilege: PS.UM selects a vector, not a permission, and user code
//!     can rewrite every special register (../ABI.md §5e). The kernel's checks
//!     on the syscall path are real; memory protection is not, and the tier
//!     word says so;
//!   * no FPU use: every image is built without it, and CPENABLE stays 0
//!     (`boot.S`'s `_start` writes it), so an FP instruction is a fault;
//!   * interrupts through the interrupt matrix onto level-1 CPU interrupts,
//!     taken at the user vector with EXCCAUSE 4. The kernel runs at INTLEVEL
//!     15 and takes one only to end its idle `waiti`, at the kernel vector,
//!     which returns to the idle poll without delivering it (`wait_for_irq`).
//!
//! Addresses and machine words are `UInt` throughout, never `Int`, the
//! discipline the riscv32 HALs keep. On this target `Int` is 32-bit signed,
//! and a register word with bit 31 set (an INTERRUPT mask, SYSTIMER's CLK_EN)
//! would land in its negative half.

// The arch-free half of the console and the stop: the sink trait this file's
// UART conforms to, the one write loop over it, and the exit-status
// promotion.
import sosrt.{ConsoleSink, console_write, abort_status}

// The image-format registry, for this profile's arch tag, and the permission
// bits the bus rule reads.
import imgformat.{SosimgArch, SegFlag}

// The native leaves, all in `sink.c` apart from the resume path, which is the
// tail of `boot.S`'s trap entry, and the windowed-call stub's close, beside
// the stub in `boot.S`.
extern "C" {
    func sos_resume_frame(frame_addr: UInt)
    func sos_payload_start() -> UInt
    func sos_payload_end() -> UInt
    func sos_region_table_start() -> UInt
    func sos_region_table_end() -> UInt
    func sos_intenable_write(mask: UInt)
    func sos_interrupt_read() -> UInt
    func sos_intclear_write(mask: UInt)
    func sos_sim_exit(status: UInt)
    func sos_windowed_call_close()
    func sos_idle_wait()
    func sos_idle_wake_count() -> UInt
}

// =============================================================================
// Identity
// =============================================================================

/// What this kernel says it is booting on, for the banner.
public func arch_name() -> String {
    "xtensa (ESP32-S3)"
}

/// This profile's `sosimg` arch tag. An image tagged for another profile is
/// refused by the loader rather than jumped into.
///
/// It reads the tag out of `imgformat`'s registry rather than repeating the
/// number, so the HAL and the image format cannot drift.
public func arch_tag() -> UInt8 {
    SosimgArch.Xtensa.tag()
}

// =============================================================================
// The protection tier: Flat
// =============================================================================
//
// This core has no privilege to protect anything with (../ABI.md §5e): no
// ring, no privileged instruction, no MMU or MPU in the core. So the seam is
// answered the way `hal/riscv32-flat` answers it, without the hardware act
// that profile needs: there is no default-deny here to open. Every `prot_*`
// call records nothing in hardware, and the kernel's grant record stays the
// one authority on what a process was given.
//
// They are functions, not statics, for the reason `hal/riscv32-esp32c3`'s
// `lib.saw` gives: a profile overrides a seam value by declaring a function of
// the same name, which a module-level `static` cannot be.

/// Can this platform deny? No. `kernel/core` maps this to
/// `sosabi.ProtectionTier.Flat` and `SystemOp.TierGet` hands it out, so a
/// program that relies on isolation reads it once and refuses to run.
public func prot_isolated() -> Bool { false }

/// Does this profile rebuild a protection image at every switch? No: there is
/// none to rebuild, and `false` lets `load_domain`'s replay loop fold away.
public func prot_replay_at_switch() -> Bool { false }

/// Nothing to reset: no hardware region exists.
public func prot_reset() unsafe {
}

/// A no-op. The row stays in the kernel's record, which is authoritative on
/// every tier; this profile never turns one into a hardware region.
public func prot_region(idx: UInt, base: UInt, top: UInt, perms: UInt8) unsafe {
}

/// A no-op, for `prot_region`'s reason.
public func prot_device(idx: UInt, base: UInt, len: UInt) unsafe {
}

/// A no-op: every access already lands, so there is nothing to publish.
public func prot_commit() unsafe {
}

/// A no-op: the switch installs nothing on this tier.
public func prot_switch(p: UInt) unsafe {
}

/// A no-op apart from one assertion.
///
/// A row's `base` names the bytes at its `pa`: the same number, or, for code
/// used in place, the instruction-window name of flash the kernel reads at its
/// data-window name (`same_bytes`). A row that drifted from that would mean
/// the placement seams disagree, and a profile programming no hardware could
/// not otherwise notice.
public func prot_update(p: UInt, base: UInt, top: UInt, pa: UInt, perms: UInt8,
                        device: Bool) unsafe {
    assert(same_bytes(base, pa, top - base),
           "a user address on the flat tier names the bytes at its row's pa")
}

/// Nothing to retire: `clear_domain` has already emptied the kernel's record,
/// the only place this profile's protection state lives.
public func prot_clear(p: UInt) unsafe {
}

/// This profile's protection granularity, a word. Nothing enforces it in
/// hardware; it is the alignment the kernel rounds grants and the stats region
/// to.
public static PROT_GRAIN: UInt = 4

/// How many segments a root image may ask for. No hardware wall stands behind
/// it here; it is the riscv32 profiles' number.
public static MAX_ROOT_SEGMENTS: UInt = 7

/// How many protection rows a domain may hold: the number `MemoryOp.Map`
/// checks a target's `grant_count` against. No hardware wall stands behind it
/// on this tier, so it is the board's policy, and the grant record
/// (`MAX_GRANT_ROWS`, the larger of it and an image's segments plus its stack)
/// is its length.
public static GRANT_ROW_BUDGET: UInt = 16
public static MAX_GRANT_ROWS: Int = 16

/// The handle entries every process body holds (`kcore.limits.MAX_HANDLES`);
/// a process's table is longer by the handle blocks it holds. A policy
/// number, the same on every board, that `kcore.limits` holds against the
/// region table root's table must take beside its first handles.
public static MAX_HANDLES: Int = 32

/// How many process domains this profile can serve: a bound chosen never to
/// bind, since no per-process hardware image is stored. It also sizes the
/// kernel's stats region (`kernel/core/stats.saw`).
public static PROT_DOMAIN_SLOTS: Int = 256

/// May `[base, base + len)` be carved as a device window?
///
/// No hardware region has to express it on this tier. The rule is the riscv32
/// profiles' (a naturally aligned power of two, at least the grain), so a
/// carve refused on one 32-bit flat profile is refused on the other: the flat
/// tier disclaims protecting memory, not the kernel's argument checks.
public func device_window_ok(base: UInt, len: UInt) -> Bool {
    if len < PROT_GRAIN {
        return false
    }
    // A power of two, tested without a loop: exactly one bit set.
    if (len & (len - 1)) != 0 {
        return false
    }
    (base % len) == 0
}

// =============================================================================
// Placement: identity
// =============================================================================
//
// Nothing translates on this machine, so an address is the same number in
// every process and in the kernel. Each process links at its own base. Flash
// has two names, one per bus window (../ABI.md §2a), and a process's code and
// read-only data are used in place there (spec §5.6): `same_bytes` and
// `segment_bus_ok` below are this board's answers.

/// A physical address as the kernel dereferences it: itself.
public func phys_to_virt(pa: UInt) -> UInt {
    pa
}

/// The inverse: itself.
public func virt_to_phys(va: UInt) -> UInt {
    va
}

/// The base an image loading at physical `dest_base` is linked at: the same
/// number, since nothing relocates it.
public func image_link_base(dest_base: UInt) -> UInt {
    dest_base
}

/// Where a `map` of `pa` lands: at `pa`. The cursor is the translating tier's
/// instrument and is ignored here.
public func map_place(cursor: UInt, pa: UInt, device: Bool) -> UInt {
    pa
}

/// Does a RAM `map` take an address of its own here? No: a row's address is
/// its memory's own, so a row's `room` has nothing to keep and is recorded as
/// zero.
public func map_translates() -> Bool { false }

/// Flash offset 0 in each bus window, and how much of each window is flash:
/// the first 16 MiB, MMU entries 0 to 255. Instructions are fetched through
/// the first and data is read through the second; the two are one flash. The
/// mask ROM maps all 512 entries to the flash before it enters the kernel
/// (../ABI.md §2a), and the PSRAM's map takes entries from 256 up (§17), so
/// no address above the first 16 MiB of either window is taken for flash
/// here, mapped to the PSRAM or not.
public static FLASH_IBUS: UInt = 0x4200_0000
public static FLASH_DBUS: UInt = 0x3C00_0000
public static FLASH_WINDOW_LEN: UInt = 0x0100_0000

/// Does `[addr, addr + len)` lie in the window that starts at `base`?
func in_flash_window(addr: UInt, len: UInt, base: UInt) -> Bool {
    (addr >= base && addr - base < FLASH_WINDOW_LEN
     && len <= FLASH_WINDOW_LEN - (addr - base))
}

/// Does the user address `link` name the `len` bytes the kernel holds at
/// physical `at`? When the two are one number, and when `link` is the
/// instruction-window name of the flash the kernel reads at `at`, its
/// data-window name. The kernel holds an image by its data-window address, so
/// code linked at the instruction-window name of its own bytes is used in
/// place (spec §5.6).
public func same_bytes(link: UInt, at: UInt, len: UInt) -> Bool {
    if link == at {
        return true
    }
    (in_flash_window(link, len, FLASH_IBUS)
     && in_flash_window(at, len, FLASH_DBUS)
     && link - FLASH_IBUS == at - FLASH_DBUS)
}

/// Can this board's buses serve a segment of `len` bytes linked at `addr` with
/// the image permissions `flags`, used in place or copied (spec §5.6)?
///
/// An executable segment only in place in the instruction window and not
/// writable: the part fetches no instruction at a DRAM address, and the
/// loader writes no IRAM (a part refuses its byte stores). A read-only
/// segment in place in the data window, or copied into process RAM; a
/// writable one copied into process RAM. Every width works at the DRAM
/// addresses process RAM has, and a byte load in the instruction window does
/// not, so nothing but code is linked there (../ABI.md §3c). Process RAM is
/// the SRAM range, and the PSRAM once a board has brought it up
/// (`segment_bus_ok_with`).
public func segment_bus_ok(addr: UInt, len: UInt, flags: UInt8,
                           in_place: Bool) -> Bool {
    segment_bus_ok_with(addr, len, flags, in_place, psram_bytes())
}

/// `segment_bus_ok` on a board whose PSRAM holds `psram` bytes from
/// `PSRAM_BASE`, 0 for none: a board facade asks it with its own count.
public func segment_bus_ok_with(addr: UInt, len: UInt, flags: UInt8,
                                in_place: Bool, psram: UInt) -> Bool {
    let writes = (flags & (SegFlag.Write as UInt8)) != 0
    if (flags & (SegFlag.Execute as UInt8)) != 0 {
        return in_place && not writes && in_flash_window(addr, len, FLASH_IBUS)
    }
    if in_place {
        return not writes && in_flash_window(addr, len, FLASH_DBUS)
    }
    (in_range(addr, len, RAM_BASE, RAM_TOP)
     || (psram != 0 && in_range(addr, len, PSRAM_BASE, PSRAM_BASE + psram)))
}

/// Does `[addr, addr + len)` lie in `[base, top)`? A range of no bytes at
/// `top` does.
func in_range(addr: UInt, len: UInt, base: UInt, top: UInt) -> Bool {
    addr >= base && addr <= top && len <= top - addr
}

// =============================================================================
// The memory map
// =============================================================================
//
// `esp32s3.ld` keeps the kernel's data in DRAM and its vectors in the bottom
// of IRAM, and leaves the DRAM range `RAM_BASE`..`RAM_TOP` to processes. The
// ranges are chosen so that no two overlap on silicon either, where IRAM
// 0x4037_8000 + n and DRAM 0x3FC8_8000 + n are one SRAM (../ABI.md §3a): no
// range the kernel uses is the twin of the processes' range.

/// The RAM a process may be given, at DRAM addresses, which take every access
/// width on the part. It holds only what a process writes: its writable
/// segments, its arena and its stack. Its code and read-only data are used in
/// place in flash (`same_bytes`). The image builder divides it, linking each
/// process for its region through `../user/user.ld`, and the region table
/// names each child's destination and the pool:
///
///   0x3FCB_0000  root's region      96 KiB, the top 16 KiB its stack
///   0x3FCC_8000  the others'        each the same shape
///   0x3FCE_0000  the RAM pool       64 KiB
///   0x3FCF_0000  the top
public static RAM_BASE: UInt = 0x3FCB_0000
public static RAM_TOP: UInt = 0x3FCF_0000

/// Where the kernel's own RAM begins: its `.data` and `.bss` run from here to
/// root's region (`esp32s3.ld`'s `DRAM`), below the processes' range. The
/// image builder holds a board description's kernel range to it, and every
/// process range to `RAM_TOP`.
public static KERNEL_RAM_BASE: UInt = 0x3FC8_C000

/// The IRAM range silicon also serves through the data bus: IRAM
/// `SHARED_IRAM_BASE`..`SHARED_IRAM_TOP` and DRAM `IRAM_DRAM_OFFSET` lower are
/// one SRAM under two names (../ABI.md §3a). The emulator keeps IRAM and DRAM
/// as two arrays, so there a store through one name is not seen through the
/// other; nothing in the kernel relies on either answer. `tests/bus_probe.saw`
/// probes the process range under both names.
public static SHARED_IRAM_BASE: UInt = 0x4037_8000
public static SHARED_IRAM_TOP: UInt = 0x403E_0000
public static IRAM_DRAM_OFFSET: UInt = 0x006F_0000

static_assert(RAM_BASE + IRAM_DRAM_OFFSET >= SHARED_IRAM_BASE
              && RAM_TOP + IRAM_DRAM_OFFSET <= SHARED_IRAM_TOP,
              "the process range must lie in the DRAM that has an IRAM name")

/// The DRAM name of the shared IRAM address `iram`.
public func dram_name(iram: UInt) -> UInt {
    iram - IRAM_DRAM_OFFSET
}

/// The IRAM name of the shared DRAM address `dram`.
public func iram_name(dram: UInt) -> UInt {
    dram + IRAM_DRAM_OFFSET
}

/// May `[base, top)` be installed as a RAM row in a user domain? On this tier
/// nothing is installed, but the range is still checked: a map of a device
/// window through the RAM door, or of the kernel's own memory, is refused.
public func map_target_ok(base: UInt, top: UInt) -> Bool {
    process_ram(base, top, psram_bytes())
}

/// May `[base, top)` be handed to a user domain as physical backing? The same
/// question as `map_target_ok` on a machine that does not translate, stated
/// separately so each reads where it is asked. Flash is not such memory: a
/// `Memory` over it is an image source and never a destination, a mapping or
/// a slab donation (spec §5.6, §2.8).
public func map_source_ok(base: UInt, top: UInt) -> Bool {
    process_ram(base, top, psram_bytes())
}

/// Is `[base, top)` process RAM on a board whose PSRAM holds `psram` bytes
/// from `PSRAM_BASE`, 0 for none: inside the SRAM range, or inside the
/// PSRAM's? A range reaching into both is not, since the two are not
/// adjacent and the bytes between them are flash. A board facade asks it
/// with its own count.
public func process_ram(base: UInt, top: UInt, psram: UInt) -> Bool {
    if base >= top {
        return false
    }
    if base >= RAM_BASE && top <= RAM_TOP {
        return true
    }
    psram != 0 && base >= PSRAM_BASE && top <= PSRAM_BASE + psram
}

/// Where the PSRAM is mapped once a board has brought it up: the data-bus
/// address of MMU entry 256 (../ABI.md §17), where the data window's 16 MiB
/// of flash end.
public static PSRAM_BASE: UInt = 0x3D00_0000

static_assert(PSRAM_BASE == FLASH_DBUS + FLASH_WINDOW_LEN,
              "the PSRAM's map begins where the flash's ends")

/// How many bytes of PSRAM this board has brought up: none. A board facade
/// that brings its PSRAM up answers with its own count, which
/// `map_target_ok`, `map_source_ok` and `segment_bus_ok` read.
public func psram_bytes() -> UInt {
    0
}

/// Root's region, which the image builder links root for: its writable
/// segment loads from the base and the stack occupies the top
/// `ROOT_STACK_LEN` bytes.
public static ROOT_LOAD_BASE: UInt = RAM_BASE
public static ROOT_REGION_TOP: UInt = 0x3FCC_8000
public static ROOT_STACK_LEN: UInt = 0x4000

/// UART0. The mask ROM leaves it at 115200 (../ABI.md §4), so the console
/// needs only the FIFO write.
static UART_BASE: UInt = 0x6000_0000

/// The one device window this board offers a process: UART0's page.
public static DEVICE_GRANT_BASE: UInt = UART_BASE
public static DEVICE_GRANT_LEN: UInt = 0x1000

static_assert(DEVICE_GRANT_LEN >= PROT_GRAIN,
              "a device window cannot be finer than the protection grain")
static_assert((DEVICE_GRANT_BASE % DEVICE_GRANT_LEN) == 0,
              "the board's own device window must pass `device_window_ok`")

/// An address the kernel cannot read: no device and no memory answers it, and
/// a load faults with LoadProhibited (../ABI.md §3c).
public static UNMAPPED_PROBE: UInt = 0x1000_0000

// =============================================================================
// Console: UART0
// =============================================================================

/// `UART_STATUS`'s transmit-FIFO occupancy field, and the depth it counts
/// against. The emulator always reports zero here (../ABI.md §4), so the poll
/// is silicon's.
static UART_TXFIFO_CNT_SHIFT: UInt32 = 16
static UART_TXFIFO_CNT_MASK: UInt32 = 0x3FF
static UART_TX_FIFO_DEPTH: UInt32 = 128
/// `UART_INT_ENA` bit 1: interrupt while the transmit FIFO is empty. The one
/// interrupt the kernel can make the console raise on demand.
static UART_INT_TXFIFO_EMPTY: UInt32 = 1 << 1

/// The UART register block, in the eight words this kernel reaches. The
/// registers are word-spaced, so declaration order is the layout. A
/// `ReadOnly<T>` field exposes only `.read()`.
struct EspUartRegs {
    fifo: UInt32,               // +0x00  write a byte to transmit
    int_raw: ReadOnly<UInt32>,  // +0x04
    int_st: ReadOnly<UInt32>,   // +0x08
    int_ena: UInt32,            // +0x0C
    int_clr: UInt32,            // +0x10
    clkdiv: UInt32,             // +0x14
    rx_filt: UInt32,            // +0x18
    status: ReadOnly<UInt32>,   // +0x1C  TXFIFO_CNT in bits 25:16
}

/// The console driver. A safe type: only the methods reaching through `regs`
/// carry the `unsafe` effect.
struct EspUart {
    regs: UnsafeMemory<EspUartRegs, Device>,
}

extension EspUart {
    init(at: UInt) unsafe -> EspUart {
        EspUart(regs: UnsafeMemory<EspUartRegs, Device>(at))
    }
}

/// There is room while the transmit FIFO holds fewer than its depth, and the
/// byte goes to the FIFO register. `write_byte` and the panic path's loop are
/// `sosrt`'s, generic over this conformance.
extension EspUart: ConsoleSink {
    func can_write(&self) unsafe -> Bool {
        let status = self.regs.status.read()
        let cnt = (status >> UART_TXFIFO_CNT_SHIFT) & UART_TXFIFO_CNT_MASK
        cnt < UART_TX_FIFO_DEPTH
    }

    func put(&self, b: UInt8) unsafe {
        self.regs.fifo.write(b as UInt32)
    }
}

/// Write one byte to the kernel's console.
///
/// One UART, and a driver process may be granted its page, so after the
/// handover marker there can be a second writer (the protocol is stated on
/// `kcore`'s `Console`). Each write is one register store guarded by its own
/// poll, so the two interleave and neither loses a byte.
public func console_byte(b: UInt8) unsafe {
    if s3stall.CONSOLE_STALL_COUNT { s3stall.counted_byte(b) } else { EspUart(at: UART_BASE).write_byte(b) }
}

/// Write a string to the console, byte at a time, allocating nothing: the stop
/// paths below use it.
func console_str(s: String) unsafe {
    var i = 0
    while i < s.len() {
        console_byte(s.byte_at(i))
        i += 1
    }
}

/// Write a 32-bit word as eight hex digits, allocating nothing.
func console_hex(v: UInt) unsafe {
    var shift: Int = 28
    while shift >= 0 {
        let d = (v >> shift) & 0xF
        let c = if d < 10 { d + 48 } else { d + 87 }
        console_byte(c as UInt8)
        shift -= 4
    }
}

// =============================================================================
// Stopping the machine
// =============================================================================
//
// The part has no finisher. Under `-semihosting` the emulator gives the guest
// one door, `simcall` SYS_exit, and the status reaches the host (../ABI.md
// §10). Each stop also prints a verdict line first, so a run without
// semihosting, or one whose status nobody reads, still says how it ended, and
// halts afterwards in case the door is shut.

/// Report a clean stop and halt.
public func exit_pass() unsafe {
    if s3stall.CONSOLE_STALL_COUNT { s3stall.report_stall() }; console_str("SOS-S3: halt pass\n")
    sos_sim_exit(0)
    while true { }
}

/// Report a failing stop, carrying its code, and halt.
///
/// What status to report is `sosrt.abort_status`'s call: a failing exit never
/// reads as a passing one. The line and the exit status carry the same code.
public func exit_fail(code: UInt) unsafe {
    let status = abort_status(code)
    console_str("SOS-S3: halt fail code=0x")
    console_hex(status)
    console_byte(10)
    sos_sim_exit(status)
    while true { }
}

// =============================================================================
// The runtime's hooks
// =============================================================================
//
// `sosrt` implements the `__saw_rt_*` seams over three per-side hooks: where a
// byte goes, how the machine stops, which thread asks. The first two name this
// board's devices; `kcore.sched` answers the third.

/// Write the runtime's text to the console, then stop the machine with a
/// non-zero status, for the common runtime.
///
/// `-> Never` is what `sosrt` declares this hook to be; `exit_fail` diverges
/// but is typed `Void`, so the trailing loop carries the promise.
@export("sos_rt_abort")
public func rt_abort(ptr: UnsafePointer<Int8>, len: UInt,
                     code: UInt32) unsafe -> Never {
    rt_write(ptr, len)
    exit_fail(code as UInt)
    while { }
}

/// Write `len` bytes at `ptr` to the console: the panic path's writer, over
/// `sosrt.console_write`'s check-free loop.
@export("sos_rt_write")
public func rt_write(ptr: UnsafePointer<Int8>, len: UInt) unsafe {
    let sink = EspUart(at: UART_BASE)
    console_write(&sink, ptr, len)
}

// =============================================================================
// The trap frame
// =============================================================================

/// The context `boot.S` saves on a trap from user mode: 76 words. Declaration
/// order is the layout, so these fields and `boot.S`'s `F_*` offsets are one
/// description.
///
/// A switch keeps the whole register file, call0 thread or windowed
/// (../ABI.md §7c): a0..a15 are the window that trapped, the other 48
/// physical registers follow it in `ar` by their position from WINDOWBASE,
/// and WINDOWBASE and WINDOWSTART are saved beside them; PS carries the
/// window fields. SAR and SCOMPARE1 are kept as compiled code uses them, LBEG,
/// LEND and LCOUNT because user code built elsewhere may use the zero-overhead
/// loop, and THREADPTR because it is per-thread by definition. EXCCAUSE and
/// EXCVADDR are what the trap was.
struct TrapFrame {
    pc: UInt,               // EPC1: where the context resumes
    ps: UInt,               // PS, with EXCM set; `rfe` clears it
    a0: UInt,               // return address
    a1: UInt,               // stack pointer
    a2: UInt,               // syscall handle / status out; entry argument
    a3: UInt,               // syscall arg 0 / value out
    a4: UInt,               // syscall arg 1
    a5: UInt,               // syscall arg 2
    a6: UInt,
    a7: UInt,
    a8: UInt,               // syscall op
    a9: UInt,
    a10: UInt,
    a11: UInt,
    a12: UInt,
    a13: UInt,
    a14: UInt,
    a15: UInt,
    sar: UInt,
    loop_begin: UInt,       // LBEG; the loop registers are spelled out
    loop_end: UInt,         // LEND  because `lend` is a Saw keyword
    loop_count: UInt,       // LCOUNT
    exccause: UInt,
    excvaddr: UInt,
    scompare1: UInt,
    threadptr: UInt,
    windowbase: UInt,
    windowstart: UInt,
    ar: [UInt; 48],         // panes WINDOWBASE + 4 to + 15
}

/// Bytes in one saved context. Public because the kernel reserves a slot per
/// thread: the kernel owns the storage and the HAL owns the layout.
public static FRAME_BYTES: Int = 304

/// Words in a frame, for `frame_init`'s zeroing loop.
static FRAME_WORDS: UInt = 76
static WORD_BYTES: UInt = 4

static_assert(sizeof<TrapFrame>() == FRAME_BYTES,
              "the Xtensa trap frame is 76 words, as boot.S lays it out")

/// PS for a context's first entry: UM = 1 so its traps arrive at the user
/// vector, EXCM = 1 so `rfe` is what clears it, INTLEVEL = 0 so interrupts
/// are taken, WOE = 1 and CALLINC = 1 so an entry that opens with `entry`
/// runs as a function `call4` reached. A call0 entry never reads either.
static PS_USER_ENTRY: UInt = 0x0005_0030

/// The pane a context starts in, WINDOWBASE 0, as its one live frame: the
/// caller a windowed entry's `entry` rotates away from (../ABI.md §7d).
static WINDOWSTART_ENTRY: UInt = 1

/// The return address a windowed entry finds in its a0: the a4 of the pane it
/// starts in, which its `entry` makes a0. Its top two bits say call4, so the
/// entry's `retw` is an ordinary return, and the address it returns to,
/// 0x7FFF_FFFC with the top bits of a flash or IRAM PC, is one nothing is
/// mapped at: the fetch faults, the windowed form of a call0 entry's return
/// to address zero.
static WINDOWED_ENTRY_RETURN: UInt = 0x7FFF_FFFC

/// Overlay the saved context.
func frame_at(frame_addr: UInt) unsafe -> UnsafeMemory<TrapFrame, Normal> {
    UnsafeMemory<TrapFrame, Normal>(frame_addr)
}

/// Build a fresh user context in `frame_addr`: `entry` as the resume address,
/// `stack_top` as the stack pointer, `arg0` in the first argument register of
/// either convention.
///
/// One start state serves a call0 entry and a windowed one (../ABI.md §7d):
/// a call0 entry finds `arg0` in a2 and never rotates the window; a windowed
/// entry's `entry` rotates by one pane, as if `call4` had reached it, and
/// finds `arg0` in its a2 (a6 here) and `WINDOWED_ENTRY_RETURN` in its a0 (a4
/// here). Every other word is zeroed, so nothing of the kernel's or another
/// thread's crosses into it. A call0 entry's return address is zero on
/// purpose: an entry that returns jumps to address zero and takes an
/// instruction fault, which spec §8 turns into the death of its process.
///
/// No preemption point: a fixed count of word stores, and a half-built
/// context is an in-flight invariant the trap path can reach.
public func frame_init(frame_addr: UInt, entry: UInt, stack_top: UInt,
                       arg0: UInt) unsafe {
    var w: UInt = 0
    while w < FRAME_WORDS {
        UnsafeMemory<UInt, Normal>(frame_addr + w * WORD_BYTES).write(0)
        w = w + 1
    }
    let frame = frame_at(frame_addr)
    frame.pc.write(entry)
    frame.ps.write(PS_USER_ENTRY)
    frame.a1.write(stack_top)
    frame.a2.write(arg0)
    frame.a4.write(WINDOWED_ENTRY_RETURN)
    frame.a6.write(arg0)
    frame.windowstart.write(WINDOWSTART_ENTRY)
}

/// Resume the context saved in `frame_addr`, in user mode. Never returns.
///
/// The first entry to user mode, and the only one that is not `ktrap` handing a
/// frame back: it is the trap entry's own restore path (`boot.S`), entered
/// from the top.
public func resume_frame(frame_addr: UInt) -> Never {
    sos_resume_frame(frame_addr)
    while { }
}

/// Claim a trap as a floating-point first use: never. No thread may use the
/// FPU on this profile (CPENABLE stays 0), so an FP instruction is a
/// coprocessor-disabled fault and its process dies of it.
public func fp_trap(frame_addr: UInt, cause: UInt) unsafe -> Bool {
    false
}

/// No floating-point state to save at a switch.
public func fp_switch_out(frame_addr: UInt) unsafe {
}

/// No floating-point state to install at a switch.
public func fp_switch_in(frame_addr: UInt) unsafe {
}

// =============================================================================
// Traps
// =============================================================================

/// The EXCCAUSE values the kernel can see from user mode. The numbers are the
/// Xtensa ISA's, so each case pins its own: a reorder must never renumber
/// them. ../ABI.md §5c lists the ones probed.
enum TrapCause: UInt {
    case IllegalInstruction = 0,
    case Syscall = 1,
    case InstructionFetchError = 2,
    case LoadStoreError = 3,
    case Level1Interrupt = 4,
    case IntegerDivideByZero = 6,
    case LoadStoreAlignment = 9,
    case InstrPifDataError = 12,
    case LoadStorePifDataError = 13,
    case InstrPifAddrError = 14,
    case LoadStorePifAddrError = 15,
    case InstFetchProhibited = 20,
    case LoadProhibited = 28,
    case StoreProhibited = 29,
    case Coprocessor0Disabled = 32,
}

extension TrapCause {
    /// The short name a fault line reports. Where the event is the one another
    /// profile also reports, the name is that profile's, so one harness string
    /// serves every machine.
    func describe(&self) -> String {
        match self {
            case IllegalInstruction -> "illegal-instruction",
            case Syscall -> "syscall",
            case InstructionFetchError -> "instruction-access-fault",
            case LoadStoreError -> "load-store-error",
            case Level1Interrupt -> "interrupt",
            case IntegerDivideByZero -> "integer-divide-by-zero",
            case LoadStoreAlignment -> "load-store-misaligned",
            case InstrPifDataError -> "instruction-bus-error",
            case LoadStorePifDataError -> "load-store-bus-error",
            case InstrPifAddrError -> "instruction-address-error",
            case LoadStorePifAddrError -> "load-store-address-error",
            case InstFetchProhibited -> "instruction-access-fault",
            case LoadProhibited -> "load-access-fault",
            case StoreProhibited -> "store-access-fault",
            case Coprocessor0Disabled -> "fp-disabled",
        }
    }
}

/// A short symbolic name for a raw trap cause. `from(raw:)` is total over the
/// word, so a cause this file does not model has a name of its own rather than
/// an arm.
public func cause_tag(cause: UInt) -> String {
    guard let decoded = TrapCause.from(raw: cause) else {
        return "unexpected-trap"
    }
    decoded.describe()
}

/// Did this trap come from a `syscall` instruction?
public func is_syscall(cause: UInt) -> Bool {
    cause == (TrapCause.Syscall as UInt)
}

/// Is this trap an interrupt? Every interrupt this kernel enables is a level-1
/// CPU interrupt, which reaches the user vector with EXCCAUSE 4. The kernel
/// takes one itself only at the idle `waiti`, and `boot.S` returns from that
/// one without entering `ktrap`.
public func is_interrupt(cause: UInt) -> Bool {
    cause == (TrapCause.Level1Interrupt as UInt)
}

/// `syscall` is a 3-byte instruction and EPC1 points at it (../ABI.md §5b), so
/// a returning syscall steps past it or the trap repeats forever.
static SYSCALL_INSN_LEN: UInt = 3

/// Where the trapped context resumes: the faulting instruction on a fault, the
/// interrupted one on an interrupt.
public func trap_pc(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).pc.read()
}

// The register convention (spec §5.7): the handle and the arguments in the
// first argument registers of the call0 ABI, a2 then a3..a5, and the op in
// a8, the first register outside the argument run, which is the shape the
// other profiles keep. The answer comes back as the status in a2 and the
// value in a3. They are the registers of the window that executed `syscall`,
// so a windowed stub uses the same ones of its own window.

/// The handle the call is made through: a2.
public func syscall_handle(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).a2.read()
}

/// The op: a8.
public func syscall_op(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).a8.read()
}

/// The first argument: a3.
public func syscall_arg0(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).a3.read()
}

/// The second argument: a4.
public func syscall_arg1(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).a4.read()
}

/// The third argument: a5.
public func syscall_arg2(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).a5.read()
}

/// Place a syscall's (status, value) pair in a2 and a3 and step the saved PC
/// past the `syscall`.
public func syscall_return(frame_addr: UInt, status: UInt, value: UInt) unsafe {
    let frame = frame_at(frame_addr)
    frame.a2.write(status)
    frame.a3.write(value)
    frame.pc.write(frame.pc.read() + SYSCALL_INSN_LEN)
}

// =============================================================================
// The appended payload and the region table
// =============================================================================
//
// Saw cannot name a linker symbol, so the bounds `esp32s3.ld` defines arrive
// through `sink.c`.

/// First byte of the appended payload.
///
/// This is the loader's first read of the root image, so it is also where
/// the kernel stops calling the ROM: from here on `sos_windowed_call` refuses
/// (`boot.S`, ../ABI.md §7g), because the ROM's functions read tables in RAM
/// a process may be given.
public func payload_start() -> UInt {
    sos_windowed_call_close()
    sos_payload_start()
}

/// One past the last byte of the appended payload; equal to `payload_start()`
/// in an image built without one.
public func payload_end() -> UInt {
    sos_payload_end()
}

/// First byte of the boot region table.
public func region_table_start() -> UInt {
    sos_region_table_start()
}

/// One past the last byte of the region table; equal to the start in an image
/// built with no table, which is zero regions and not an error.
public func region_table_end() -> UInt {
    sos_region_table_end()
}

// =============================================================================
// The timer: SYSTIMER
// =============================================================================
//
// UNIT0 is the counter and TARGET0 the comparator that supplies the tick, at
// 16 MHz (../ABI.md §6a). The comparator runs one-shot and is re-armed for
// every deadline: the periodic mode miscounts on the emulator (§6c). The seam
// is absolute, so one comparator serves the scheduler tick and the Timer
// objects and the kernel programs the earlier of the two.
//
// TARGET0's interrupt is a level: it holds the CPU interrupt pending until
// SYSTIMER's own status is cleared, which `set_deadline` does before arming.

static SYSTIMER_BASE: UInt = 0x6002_3000
/// `SYSTIMER_CONF` bits: CLK_EN and UNIT0_WORK_EN start the counter;
/// TARGET0_WORK_EN arms the comparator.
static SYSTIMER_CLK_EN: UInt32 = 0x8000_0000
static SYSTIMER_UNIT0_WORK_EN: UInt32 = 1 << 30
static SYSTIMER_TARGET0_WORK_EN: UInt32 = 1 << 24
/// `SYSTIMER_UNIT0_OP` bits: write UPDATE, then poll VALUE_VALID.
static SYSTIMER_UNIT0_UPDATE: UInt32 = 1 << 30
static SYSTIMER_UNIT0_VALUE_VALID: UInt32 = 1 << 29
/// `SYSTIMER_COMP0_LOAD` bit 0: publish the staged TARGET0 value.
static SYSTIMER_COMP0_LOAD: UInt32 = 1
/// TARGET0's bit in the ENA / RAW / CLR / ST quartet.
static SYSTIMER_TARGET0_INT: UInt32 = 1

/// Nanoseconds per counter unit at 16 MHz is 62.5, stated as a ratio so
/// `timer_now_ns` multiplies before it divides.
static NS_PER_UNIT_NUM: UInt64 = 125
static NS_PER_UNIT_DEN: UInt64 = 2

/// Bits in a machine word, for the split 64-bit SYSTIMER registers.
static WORD_BITS: Int = 32

/// The SYSTIMER register block, in the words this kernel reaches. Its offsets
/// are the ones ../ABI.md §6a probed.
struct SystimerRegs {
    conf: UInt32,                       // +0x00
    unit0_op: UInt32,                   // +0x04  write UPDATE, poll VALUE_VALID
    unit1_op: UInt32,                   // +0x08
    unit0_load_hi: UInt32,              // +0x0C
    unit0_load_lo: UInt32,              // +0x10
    unit1_load_hi: UInt32,              // +0x14
    unit1_load_lo: UInt32,              // +0x18
    target0_hi: UInt32,                 // +0x1C
    target0_lo: UInt32,                 // +0x20
    target1_hi: UInt32,                 // +0x24
    target1_lo: UInt32,                 // +0x28
    target2_hi: UInt32,                 // +0x2C
    target2_lo: UInt32,                 // +0x30
    target0_conf: UInt32,               // +0x34  0 = unit0, one-shot
    target1_conf: UInt32,               // +0x38
    target2_conf: UInt32,               // +0x3C
    unit0_value_hi: ReadOnly<UInt32>,   // +0x40
    unit0_value_lo: ReadOnly<UInt32>,   // +0x44
    unit1_value_hi: ReadOnly<UInt32>,   // +0x48
    unit1_value_lo: ReadOnly<UInt32>,   // +0x4C
    comp0_load: UInt32,                 // +0x50
    comp1_load: UInt32,                 // +0x54
    comp2_load: UInt32,                 // +0x58
    unit0_load: UInt32,                 // +0x5C
    unit1_load: UInt32,                 // +0x60
    int_ena: UInt32,                    // +0x64
    int_raw: ReadOnly<UInt32>,          // +0x68
    int_clr: UInt32,                    // +0x6C
    int_st: ReadOnly<UInt32>,           // +0x70
}

/// The driver: one block holds both the counter and its comparator.
struct Systimer {
    regs: UnsafeMemory<SystimerRegs, Device>,
}

extension Systimer {
    init() unsafe -> Systimer {
        Systimer(regs: UnsafeMemory<SystimerRegs, Device>(SYSTIMER_BASE))
    }

    /// Start UNIT0 counting. Idempotent: it states both enables whatever the
    /// mask ROM left.
    func start(&self) unsafe {
        self.regs.conf.write(
            self.regs.conf.read() | SYSTIMER_CLK_EN | SYSTIMER_UNIT0_WORK_EN)
    }

    /// The counter, read by handshake: UPDATE latches all 52 bits into the
    /// value registers at once and VALUE_VALID says when they are there, so
    /// the two halves are one reading.
    ///
    /// No preemption point: the poll waits on a hardware latch.
    func now(&self) unsafe -> UInt64 {
        self.regs.unit0_op.write(SYSTIMER_UNIT0_UPDATE)
        while (self.regs.unit0_op.read() & SYSTIMER_UNIT0_VALUE_VALID) == 0 { }
        let hi = self.regs.unit0_value_hi.read()
        let lo = self.regs.unit0_value_lo.read()
        (((hi as UInt64) << WORD_BITS) | (lo as UInt64))
    }

    func deadline(&self) unsafe -> UInt64 {
        (((self.regs.target0_hi.read() as UInt64) << WORD_BITS)
         | (self.regs.target0_lo.read() as UInt64))
    }

    /// Program the next deadline as a one-shot alarm.
    ///
    /// The comparator is disarmed while its target changes and armed again
    /// last, after the stale alarm is cleared, which is the sequence
    /// ../ABI.md §6c took three ticks with. Clearing the alarm also lowers
    /// the level a fire raised. The halves are taken with `truncating:`,
    /// which is what splitting a wide value into two registers means.
    func set_deadline(&self, at: UInt64) unsafe {
        self.regs.conf.write(self.regs.conf.read() & ~SYSTIMER_TARGET0_WORK_EN)
        self.regs.target0_conf.write(0)
        self.regs.target0_hi.write(UInt32.from(truncating: at >> WORD_BITS))
        self.regs.target0_lo.write(UInt32.from(truncating: at))
        self.regs.comp0_load.write(SYSTIMER_COMP0_LOAD)
        self.regs.int_clr.write(SYSTIMER_TARGET0_INT)
        self.regs.int_ena.write(SYSTIMER_TARGET0_INT)
        self.regs.conf.write(self.regs.conf.read() | SYSTIMER_TARGET0_WORK_EN)
    }

    /// Has the alarm fired, or is its deadline already behind the counter?
    /// The comparison catches a deadline programmed in the past, which the
    /// seam says must fire as soon as interrupts are deliverable.
    func expired(&self) unsafe -> Bool {
        if (self.regs.int_raw.read() & SYSTIMER_TARGET0_INT) != 0 {
            return true
        }
        self.now() >= self.deadline()
    }
}

/// Round a nanosecond time up to a whole counter unit: a deadline must never
/// fire early. The saturating guard keeps the kernel's "never" deadline
/// representable, since rounding `UInt64.max` up would overflow.
func ns_to_units(ns: UInt64) -> UInt64 {
    if ns > (UInt64.max - (NS_PER_UNIT_NUM - 1)) / NS_PER_UNIT_DEN {
        return UInt64.max / NS_PER_UNIT_NUM * NS_PER_UNIT_DEN
    }
    (ns * NS_PER_UNIT_DEN + NS_PER_UNIT_NUM - 1) / NS_PER_UNIT_NUM
}

/// Has anything programmed the comparator yet? An untouched comparator's
/// deadline is zero and reads as permanently expired, so the idle poll asks
/// SYSTIMER only once this is set. Its one writer, `timer_set_deadline_ns`,
/// runs in the kernel with interrupts masked on one core.
unsafe static var TIMER_PROGRAMMED: Bool = false

/// This machine's monotonic time in nanoseconds since the counter started
/// (spec §2's Clock row). The counter is the clock: `Clock.now()` and every
/// Timer deadline are measured against it, and it never steps back.
public func timer_now_ns() unsafe -> UInt64 {
    Systimer().now() * NS_PER_UNIT_NUM / NS_PER_UNIT_DEN
}

/// Program TARGET0 to interrupt at `at_ns`.
///
/// A deadline already past fires as soon as interrupts are deliverable. The
/// kernel's "never", `UInt64.max`, becomes a counter value about 4.8 years
/// after power-on: the comparator keeps 52 bits of unit count.
///
/// The delivery path (matrix route, INTENABLE) is `intc_init`'s, up before
/// anything arms a deadline.
public func timer_set_deadline_ns(at_ns: UInt64) unsafe {
    let timer = Systimer()
    timer.start()
    timer.set_deadline(ns_to_units(at_ns))
    TIMER_PROGRAMMED = true
}

/// Has the timer expired without a tick having been taken for it?
public func timer_pending() unsafe -> Bool {
    Systimer().expired()
}

// =============================================================================
// The interrupt matrix and the core's level-1 interrupts
// =============================================================================
//
// Every peripheral source has a map register at `INTMATRIX_BASE + 4 * source`
// holding the CPU interrupt it is routed to (../ABI.md §6c). This kernel uses
// level-1, level-triggered CPU interrupts only: they arrive at the user vector
// with EXCCAUSE 4, and their pending bit falls with the source, so nothing has
// to clear a latch at the core.
//
// A line is given a CPU interrupt of its own when it is unmasked and keeps it
// while masked, and INTENABLE is the per-line mask; the route moves only when
// a CPU interrupt is taken back for another line. Routing is not a mask on
// the emulator: its matrix moves a CPU interrupt's level only when a source
// routed there changes level, not when a route changes (../ABI.md §6c).
// Unrouted sources go to `INTMATRIX_UNROUTED`, CPU interrupt 6, CCOMPARE0's
// internal line, which takes no matrix input and is never enabled. The kernel
// runs at INTLEVEL 15, so an enabled interrupt reaches the kernel only at the
// idle `waiti` (`wait_for_irq`).

static INTMATRIX_BASE: UInt = 0x600C_2000
static REGISTER_BYTES: UInt = 4
static INTMATRIX_UNROUTED: UInt32 = 6

/// The matrix's PRO-CPU sources, 0..98: the range the board probe swept.
/// Source 0 is reserved here for "no source", which is `IRQ_NONE`.
static INTMATRIX_SOURCES: Int = 99
static INTMATRIX_MAX_SOURCE: UInt = 98

/// SYSTIMER TARGET0's source (../ABI.md §6c) and the CPU interrupt the kernel
/// takes it on: level 1, level-triggered.
static SYSTIMER_TARGET0_SOURCE: UInt = 57
static TIMER_CPU_INT: UInt = 1
static TIMER_CPU_INT_BIT: UInt = 1 << TIMER_CPU_INT

/// UART0's source: the one device the kernel can make interrupt on demand,
/// which is what `irq_raise_selftest_line` uses.
static CONSOLE_IRQ: UInt = 27

/// The level-1, level-triggered CPU interrupts a device line may be given,
/// from ../ABI.md §5d and §6c: 1 is the timer's; 0 is left out so that zero
/// can mean "unassigned" in `LINE_CPU_INT`; 5 read as not driven in one of the
/// probe's two runs, so it is not handed out.
static DEVICE_CPU_INTS: [UInt8; 9] = [2, 3, 4, 8, 9, 12, 13, 17, 18]
static DEVICE_CPU_INT_COUNT: UInt = 9

/// The CPU interrupt each source is routed to, zero for none. A line keeps its
/// assignment while masked and loses it only to a take-back (`irq_unmask`).
/// Global state on a serialization argument the compiler cannot see: one
/// core, and every writer runs in the kernel with interrupts masked.
unsafe static var LINE_CPU_INT: [UInt8; INTMATRIX_SOURCES]

/// The line each entry of `DEVICE_CPU_INTS` is assigned to, `IRQ_NONE` for
/// none: the other direction of `LINE_CPU_INT`, which a take-back needs.
unsafe static var ENTRY_LINE: [UInt8; 9]

/// The INTENABLE bits the kernel has set, kept because the register is written
/// through a C leaf and the claim masks pending bits with it.
unsafe static var INTENABLE_SHADOW: UInt = 0

static_assert(IRQ_TIMER > INTMATRIX_MAX_SOURCE,
              "the timer's line must not collide with a real interrupt source")

/// The controller had nothing to give. Never a real line.
public static IRQ_NONE: UInt = 0

/// The line the timer arrives on: a number no matrix source can have.
public static IRQ_TIMER: UInt = 1024

/// One source's map register.
func map_reg(source: UInt) unsafe -> UnsafeMemory<UInt32, Device> {
    UnsafeMemory<UInt32, Device>(INTMATRIX_BASE + source * REGISTER_BYTES)
}

/// Let CPU interrupt `cpuint` reach the core.
func cpu_int_enable(cpuint: UInt) unsafe {
    INTENABLE_SHADOW = INTENABLE_SHADOW | ((1 as UInt) << cpuint)
    sos_intenable_write(INTENABLE_SHADOW)
}

/// Stop CPU interrupt `cpuint` reaching the core. It may stay pending.
func cpu_int_disable(cpuint: UInt) unsafe {
    INTENABLE_SHADOW = INTENABLE_SHADOW & ~((1 as UInt) << cpuint)
    sos_intenable_write(INTENABLE_SHADOW)
}

/// Which source is routed to `cpuint`, or `IRQ_NONE`. The matrix is the table:
/// the map registers the kernel itself wrote are scanned.
func source_of(cpuint: UInt) unsafe -> UInt {
    var source: UInt = 1
    while source <= INTMATRIX_MAX_SOURCE {
        if (map_reg(source).read() as UInt) == cpuint {
            return source
        }
        source = source + 1
    }
    IRQ_NONE
}

/// The lowest pending, enabled device line, or `IRQ_NONE`. INTERRUPT shows a
/// CPU interrupt pending whether or not it is enabled (../ABI.md §6b), so it
/// is masked with what the kernel enabled, and the timer's bit is left to the
/// timer's own test.
func pending_device_line() unsafe -> UInt {
    let pending = sos_interrupt_read() & INTENABLE_SHADOW & ~TIMER_CPU_INT_BIT
    if pending == 0 {
        return IRQ_NONE
    }
    var cpuint: UInt = 0
    while ((pending >> cpuint) & 1) == 0 {
        cpuint = cpuint + 1
    }
    source_of(cpuint)
}

/// Bring the controller up with every source routed nowhere, the timer's
/// source wired to its CPU interrupt, and that interrupt enabled.
///
/// It also undoes the mask ROM's own routing (UART0 to CPU interrupt 5,
/// ../ABI.md §2c), so the kernel starts from a matrix it wrote all of, and no
/// line holds a CPU interrupt.
///
/// No preemption point: one store per source, once, at boot, before anything
/// can be pending.
public func intc_init() unsafe {
    INTENABLE_SHADOW = 0
    sos_intenable_write(0)
    var source: UInt = 0
    while source <= INTMATRIX_MAX_SOURCE {
        map_reg(source).write(INTMATRIX_UNROUTED)
        LINE_CPU_INT[source as Int] = 0
        source = source + 1
    }
    var entry: UInt = 0
    while entry < DEVICE_CPU_INT_COUNT {
        ENTRY_LINE[entry as Int] = IRQ_NONE as UInt8
        entry = entry + 1
    }
    map_reg(SYSTIMER_TARGET0_SOURCE).write(TIMER_CPU_INT as UInt32)
    sos_intclear_write(TIMER_CPU_INT_BIT)
    cpu_int_enable(TIMER_CPU_INT)
}

/// Let `line` interrupt the kernel.
///
/// A source needs a CPU interrupt of its own while it is unmasked, because the
/// trap reports only which CPU interrupt is pending. A line that still holds
/// one from an earlier unmask reuses it. Otherwise it takes the lowest
/// unassigned entry of `DEVICE_CPU_INTS`, and failing that takes one back from
/// a masked line (`take_back_entry`). The source is routed to its CPU
/// interrupt before the interrupt is enabled.
///
/// Only an unmasked line keeps its CPU interrupt from a take-back, so the stop
/// below needs more lines unmasked at once than `DEVICE_CPU_INT_COUNT`. The
/// kernel unmasks a line only for a live Interrupt, whose slab holds
/// `MAX_INTERRUPTS` (`kernel/core/limits.saw`), and for the selftest line, so
/// a kernel whose `MAX_INTERRUPTS` stays below `DEVICE_CPU_INT_COUNT` cannot
/// reach it; one that outgrows it has to grow this board's table. It is a stop
/// rather than a refusal because the Interrupt has been minted by the time its
/// line is unmasked.
///
/// What a take-back costs depends on the matrix. Silicon's is combinational,
/// so a source still asserting raises its new CPU interrupt at the route
/// write; that is read from Espressif's fix to the emulator's model, not
/// probed on a part. The installed emulator moves a level only when a source
/// changes level (../ABI.md §6c): a masked line that is still bound, still
/// asserting and loses its CPU interrupt to a take-back does not fire at its
/// next unmask unless its device model sends its level again. A take-back
/// happens only once more distinct lines have been unmasked than there are
/// CPU interrupts free.
public func irq_unmask(line: UInt) unsafe {
    var cpuint = LINE_CPU_INT[line as Int] as UInt
    if cpuint == 0 {
        var entry = unassigned_entry()
        if entry == DEVICE_CPU_INT_COUNT {
            entry = take_back_entry()
        }
        if entry == DEVICE_CPU_INT_COUNT {
            console_str("SOS-S3: out of CPU interrupts for line 0x")
            console_hex(line)
            console_byte(10)
            exit_fail(1)
        }
        let holder = ENTRY_LINE[entry as Int] as UInt
        if holder != IRQ_NONE {
            map_reg(holder).write(INTMATRIX_UNROUTED)
            LINE_CPU_INT[holder as Int] = 0
        }
        cpuint = DEVICE_CPU_INTS[entry as Int] as UInt
        ENTRY_LINE[entry as Int] = line as UInt8
        LINE_CPU_INT[line as Int] = cpuint as UInt8
        map_reg(line).write(cpuint as UInt32)
    }
    cpu_int_enable(cpuint)
}

/// The lowest entry of `DEVICE_CPU_INTS` no line is assigned, or
/// `DEVICE_CPU_INT_COUNT` when every one is.
func unassigned_entry() unsafe -> UInt {
    var entry: UInt = 0
    while entry < DEVICE_CPU_INT_COUNT {
        if (ENTRY_LINE[entry as Int] as UInt) == IRQ_NONE {
            return entry
        }
        entry = entry + 1
    }
    DEVICE_CPU_INT_COUNT
}

/// The entry to take back from a masked line, or `DEVICE_CPU_INT_COUNT` when
/// every assigned line is unmasked.
///
/// A masked line may be one whose Interrupt is gone or one awaiting its
/// driver's ack, and the HAL cannot tell which. So the lowest masked entry
/// whose CPU interrupt is not pending is preferred: its source is quiet,
/// nothing is lost by moving it, and on the emulator no level is left behind
/// on the CPU interrupt for its next line to take as a fire. Only when every
/// masked entry is pending is the lowest of them taken.
///
/// That fallback has a cost on the installed emulator (../ABI.md §6c). The
/// line that takes such an entry inherits a CPU interrupt that is still high:
/// it gets a fire nobody raised, and again after each ack, because it keeps
/// the entry and the level has not moved. The old device's level changes go
/// to its new route, not to this CPU interrupt, so the stale level falls only
/// when a source routed to it, the new line's own device, sends a level. It
/// takes more asserting devices left masked at once than the preference can
/// avoid: every unassigned entry gone and every masked one pending. A
/// combinational matrix has no such stale level; silicon's is one by
/// Espressif's fix to the model, which is read, not probed.
func take_back_entry() unsafe -> UInt {
    let pending = sos_interrupt_read()
    var fallback = DEVICE_CPU_INT_COUNT
    var entry: UInt = 0
    while entry < DEVICE_CPU_INT_COUNT {
        let bit = (1 as UInt) << (DEVICE_CPU_INTS[entry as Int] as UInt)
        if (INTENABLE_SHADOW & bit) == 0 {
            if (pending & bit) == 0 {
                return entry
            }
            if fallback == DEVICE_CPU_INT_COUNT {
                fallback = entry
            }
        }
        entry = entry + 1
    }
    fallback
}

/// Stop `line` interrupting the kernel (spec §9's mask-on-fire): disable its
/// CPU interrupt.
///
/// The route and the assignment stay, so the source's level goes on reaching
/// the CPU interrupt it will be enabled on again, and a source still asserting
/// at the next unmask fires again, which is the level semantics the spec asks
/// for. The CPU interrupt is given back only when an unmask takes it
/// (`irq_unmask`). Idempotent: the kernel masks a line on delivery and again
/// when its Interrupt is destroyed.
public func irq_mask(line: UInt) unsafe {
    let cpuint = LINE_CPU_INT[line as Int] as UInt
    if cpuint != 0 {
        cpu_int_disable(cpuint)
    }
}

/// Which line is being serviced, or `IRQ_NONE`.
///
/// The cause word says only "a level-1 interrupt"; INTERRUPT says which. The
/// timer is asked first, by its own CPU interrupt.
public func irq_claim(cause: UInt) unsafe -> UInt {
    let pending = sos_interrupt_read() & INTENABLE_SHADOW
    if (pending & TIMER_CPU_INT_BIT) != 0 {
        return IRQ_TIMER
    }
    pending_device_line()
}

/// End of service for `line`: nothing to do at the core.
///
/// Every CPU interrupt this kernel uses is level-triggered, so it falls when
/// its source does. A device line was masked at INTENABLE before this runs;
/// the timer's level was cleared when the next deadline was programmed, which
/// the kernel does on every fire. Clearing SYSTIMER's status again here would
/// be wrong rather than redundant: a deadline programmed close enough to have
/// fired already would lose its alarm, and nothing would raise it again.
public func irq_complete(line: UInt) unsafe {
}

/// Is `line` a source this board wires?
///
/// Source 0 is "no source", and the timer's source is the kernel's own. A
/// bound Interrupt on it would take the tick from the kernel: its first unmask
/// would route source 57 to a device CPU interrupt, off CPU interrupt 1 where
/// the timer is claimed, so each tick would arrive as that line's fire, and
/// the line's mask-on-fire would leave the tick disabled.
public func irq_line_valid(line: UInt) -> Bool {
    line != IRQ_NONE && line <= INTMATRIX_MAX_SOURCE &&
        line != SYSTIMER_TARGET0_SOURCE
}

/// Ask for a pending line without a trap having delivered one: the idle path
/// and the preemption points.
///
/// The timer is asked of SYSTIMER rather than of INTERRUPT, so a deadline
/// already behind the counter counts, and only once something has programmed
/// it. Device lines come from INTERRUPT, which shows a pending bit with the
/// kernel at INTLEVEL 15 as well as at 0.
public func irq_poll() unsafe -> UInt {
    if timer_due() {
        return IRQ_TIMER
    }
    pending_device_line()
}

/// Park the core until an interrupt is pending.
///
/// `waiti` sleeps only until an interrupt it will then take (../ABI.md §6d),
/// so the sleep is `boot.S`'s `sos_idle_wait`: `waiti 0`, which every line
/// the kernel enables can end, since all are level 1. The interrupt is taken
/// at the kernel vector, which counts it and returns here at INTLEVEL 15
/// without delivering it; the line stays pending, being level-triggered, and
/// the idle loop's `irq_poll` finds it as it finds any other.
///
/// While the timer reads expired (`irq_poll`'s own test) the core does not
/// sleep: the poll that follows delivers the timer at once, without a round
/// trip through the kernel vector. The alarm fires for a target already
/// behind the counter on the emulator (../ABI.md §6d) and, by ESP-IDF's
/// code, on the part, so the guard saves that round trip and is not what
/// keeps such a deadline from being slept on for good.
public func wait_for_irq() unsafe {
    if timer_due() {
        return
    }
    sos_idle_wait()
}

/// Has a deadline been programmed and has it expired? `irq_poll`'s timer
/// test.
func timer_due() unsafe -> Bool {
    TIMER_PROGRAMMED && Systimer().expired()
}

/// How many interrupts the idle `waiti` has taken since boot. Each ends one
/// sleep of `wait_for_irq`; the count wraps.
public func idle_wakes() unsafe -> UInt {
    sos_idle_wake_count()
}

/// Raise a line from software, for interrupt bring-up. Returns the line.
///
/// There is no software trigger at the matrix, so the source is a real device:
/// the console's "transmit FIFO empty" interrupt, which asserts as soon as it
/// is enabled. The kernel masks the line in its handler, so the still-asserting
/// device does not re-fire. The board smoke's `external_irq` case takes it.
public func irq_raise_selftest_line() unsafe -> UInt {
    irq_unmask(CONSOLE_IRQ)
    EspUart(at: UART_BASE).regs.int_ena.write(UART_INT_TXFIFO_EMPTY)
    CONSOLE_IRQ
}

// =============================================================================
// The build keys
// =============================================================================
//
// An image's build keys (../ABI.md §14) are two modules the runner maps to a
// key's directory under `../keys/`: `s3clock`, the CPU clock, and `s3stall`,
// whether the console counts its stalls. In an image built at the defaults
// (`rom`, the count off) every reference to a key's code folds away, and the
// image is the bytes it is without the keys. Two things keep it so. The
// compiler lays out functions and statics in the order the code it lowers
// first names them, even code an image folds away, so a key's code names
// nothing in this file: its modules reach their registers through views of
// their own. And the line of every overflow check in this file is compiled
// into the image, so the keys are imported down here, below the last one,
// and `console_byte` and `exit_pass` name the stall count on the line that
// was there. Nothing else in this file is keyed.
//
// `clock_init` is the clock key's, and `kmain` calls it first, before
// anything prints or is timed; the `rom` key's writes nothing. When the
// stall count is on, `console_byte` writes through the count's own path,
// which times each wait for FIFO room once the tick is armed, and
// `exit_pass` prints the count before its own line.

public import s3clock.{clock_init}
import s3stall

// =============================================================================
// The kernel's own zeroed memory
// =============================================================================
//
// Down here, below the last overflow check, for the build keys' reason above:
// nothing in these lines moves a line an image compiles in.

extern "C" {
    func sos_kernel_slabs_start() -> UInt
    func sos_kernel_slabs_end() -> UInt
}

/// First byte of the kernel's slab region: the board script's
/// `_sos_slabs_start`, where the `.bss.sos_slab*` input sections begin. An
/// image's slab areas are linked there, and the kernel installs only an area
/// that lies wholly between this and `kernel_slabs_end()`.
public func kernel_slabs_start() -> UInt {
    sos_kernel_slabs_start()
}

/// One past the last byte of the slab region: the board script's
/// `_sos_slabs_end`. The region holds no static of the kernel's.
public func kernel_slabs_end() -> UInt {
    sos_kernel_slabs_end()
}

// =============================================================================
// The kernel's windowed calls, refused after the loader
// =============================================================================

/// The status a refused windowed call stops the machine with: the core's
/// `ExitCode.KernelBug`, which this file cannot name, since the core imports
/// it.
static WINDOWED_CALL_REFUSED_STATUS: UInt = 6

/// Stop the machine: the kernel called `sos_windowed_call` (`boot.S`) after
/// the loader began, when the ROM function `fn_addr` may read RAM a process
/// was given (../ABI.md §7g). The stub comes here instead of calling it.
@export("sos_windowed_call_refused")
public func windowed_call_refused(fn_addr: UInt) unsafe -> Never {
    console_str("SOS-S3: kernel bug: windowed call to 0x")
    console_hex(fn_addr)
    console_str(" after the loader\n")
    exit_fail(WINDOWED_CALL_REFUSED_STATUS)
    while { }
}

// =============================================================================
// The PSRAM's bring-up, Saw half
// =============================================================================
//
// `mspi.c` makes every step and every check of the bring-up from IRAM, in one
// call, and fills in a record; this half passes it the description and prints
// the line a stop's record says (../ABI.md §16). Nothing here touches the
// memory-SPI controller but `psram_spi1_words`, which only reads it;
// SYSTIMER, which `psram_cpu_passes` and `psram_ticks` start and read; and,
// at the end of the file, the PSRAM itself, which only the read-back test
// writes (§17). Down here, below the last overflow check, for the build
// keys' reason above.

extern "C" {
    func sos_psram_bringup(expect: UInt, record: UInt, last_step: UInt) -> UInt
    func sos_psram_time_reads(expect: UInt, record: UInt, which: UInt,
                              searches: UInt) -> UInt
    func sos_ccount_read() -> UInt
}

/// The description the part must match, as `mspi.c`'s
/// `struct sos_psram_expect` lays it out.
public struct PsramExpect {
    efuse_cap: UInt32,
    efuse_vendor: UInt32,
    vendor: UInt32,
    density: UInt32,
    divider: UInt32,
    sysclk: UInt32,
    cpu_per: UInt32,
    core_clk_sel: UInt32,
}

static_assert(sizeof<PsramExpect>() == 32, "PsramExpect is mspi.c's layout")

/// What the bring-up found, as `mspi.c`'s `struct sos_psram_record` lays it
/// out.
public struct PsramRecord {
    stop: UInt32,
    read: UInt32,
    expect: UInt32,
    command: UInt32,
    address: UInt32,
    efuse: UInt32,
    pad_hold: UInt32,
    sysclk: UInt32,
    cpu_per: UInt32,
    core_clk_sel: UInt32,
    saved: UInt32,
    spi1_clock: UInt32,
    misc_gate: UInt32,
    mr01: UInt32,
    mr23: UInt32,
    mr4: UInt32,
    mr8: UInt32,
    mr01_after: UInt32,
    mr_cycles: UInt32,
    cycles: UInt32,
    mapped: UInt32,
}

static_assert(sizeof<PsramRecord>() == 84, "PsramRecord is mspi.c's layout")

/// `last_step` for a bring-up that ends after S8, the identity; after S9, the
/// mode register's write; and after S12, the map: the whole call (`mspi.c`'s
/// STEP_S8, STEP_S9, STEP_S12).
public static PSRAM_THROUGH_S8: UInt = 0x80
public static PSRAM_THROUGH_S9: UInt = 0x90
public static PSRAM_THROUGH_S12: UInt = 0xC0

/// The stops' codes (../ABI.md §16c).
static PSRAM_STOP_NOT_DRAM: UInt = 0x50
static PSRAM_STOP_EFUSE: UInt = 0x51
static PSRAM_STOP_PAD_HELD: UInt = 0x52
static PSRAM_STOP_CLOCK: UInt = 0x53
static PSRAM_STOP_BUSY_BEFORE: UInt = 0x54
static PSRAM_STOP_ECC: UInt = 0x55
static PSRAM_STOP_GATE: UInt = 0x56
static PSRAM_STOP_BUSY_COMMAND: UInt = 0x57
static PSRAM_STOP_GATE_LOST: UInt = 0x58
static PSRAM_STOP_NOT_FINISHED: UInt = 0x59
static PSRAM_STOP_VENDOR: UInt = 0x5A
static PSRAM_STOP_DIE: UInt = 0x5B
static PSRAM_STOP_DENSITY: UInt = 0x5C
static PSRAM_STOP_MR0: UInt = 0x5D
static PSRAM_STOP_MMU: UInt = 0x5E
static PSRAM_STOP_BUS_OFF: UInt = 0x5F
public static PSRAM_STOP_READ_BACK: UInt = 0x60
static PSRAM_STOP_MEASUREMENT: UInt = 0x61
static PSRAM_STOP_STILL_BUSY: UInt = 0x62

/// Run the bring-up's steps S0 to `last_step`, then S10, on the description at
/// `expect`, filling in the record at `record`; both must be DRAM. Answers 0,
/// or the stop code, whose line `psram_stop_line` prints.
public func psram_bringup(expect: UInt, record: UInt,
                          last_step: UInt) unsafe -> UInt {
    sos_psram_bringup(expect, record, last_step)
}

/// The measurements `psram_time_reads` makes (`mspi.c`'s TIME_*): the array
/// read of 2 and of 10 bytes at divide by 4, and the MR0/MR1 read at divide
/// by 4 and by 8.
public static PSRAM_TIME_ARRAY_SHORT: UInt = 1
public static PSRAM_TIME_ARRAY_LONG: UInt = 2
public static PSRAM_TIME_MR_FAST: UInt = 3
public static PSRAM_TIME_MR_SLOW: UInt = 4

/// Bisect `searches` times how many CCOUNT cycles after its start the
/// measurement `which`'s command ends, under the gate (../ABI.md §16b), and
/// answer the stop code (0 when none); the record's `cycles` is the sum.
public func psram_time_reads(expect: UInt, record: UInt, which: UInt,
                             searches: UInt) unsafe -> UInt {
    sos_psram_time_reads(expect, record, which, searches)
}

/// SYSTIMER's ticks in a millisecond: it counts the crystal at 16 MHz
/// (../ABI.md §6a).
static PSRAM_TICKS_PER_MS: UInt64 = 16000
/// The interval a pass of `psram_cpu_passes` spans, at least: 5 ms.
static PSRAM_CPU_TICKS: UInt64 = 80000

/// One end of a pass's interval: SYSTIMER's count, then CCOUNT. Both ends
/// run these same instructions, so the time from the snapshot to the CCOUNT
/// read is the same at each and drops out of the difference.
func psram_cpu_sample(timer: &Systimer) unsafe -> (UInt64, UInt) {
    let ticks = timer.now()
    (ticks, sos_ccount_read())
}

/// One pass of the CPU's clock against SYSTIMER: CCOUNT's advance, and
/// SYSTIMER's over the same interval, at least `PSRAM_CPU_TICKS`.
public struct PsramCpuPass {
    cycles: UInt64,
    ticks: UInt64,
}

extension PsramCpuPass {
    /// The CPU's clock in kHz the pass gives.
    public func khz(&self) -> UInt {
        UInt.from(truncating: self.cycles * PSRAM_TICKS_PER_MS / self.ticks)
    }
}

func psram_cpu_pass(timer: &Systimer) unsafe -> PsramCpuPass {
    let start = psram_cpu_sample(&timer)
    var end = psram_cpu_sample(&timer)
    while end.0 - start.0 < PSRAM_CPU_TICKS {
        end = psram_cpu_sample(&timer)
    }
    PsramCpuPass(cycles: (end.1 &- start.1) as UInt64,
                 ticks: end.0 - start.0)
}

/// Two passes of the CPU's clock against SYSTIMER, run back to back; the
/// second is the measurement. The first takes SYSTIMER's first snapshot,
/// which can be slower than the rest, and fills the caches with the code it
/// runs from flash, whose first fetch at a slow clock costs a thousand
/// cycles or more and, landing between one end's snapshot and its CCOUNT
/// read, would count against that end alone.
public func psram_cpu_passes(first: &var PsramCpuPass,
                             second: &var PsramCpuPass) unsafe {
    let timer = Systimer()
    timer.start()
    first = psram_cpu_pass(&timer)
    second = psram_cpu_pass(&timer)
}

/// `digits` hex digits of `v`, after `0x`.
func psram_hex(v: UInt, digits: Int) unsafe {
    console_str("0x")
    var shift: Int = (digits - 1) * 4
    while shift >= 0 {
        let d = (v >> shift) & 0xF
        let c = if d < 10 { d + 48 } else { d + 87 }
        console_byte(c as UInt8)
        shift -= 4
    }
}

/// The eFuse's PSRAM_CAP code by name (efuse/esp32s3/esp_efuse_table.csv).
func psram_cap_name(code: UInt) -> String {
    if code == 0 { return "none" }
    if code == 1 { return "8 MiB" }
    if code == 2 { return "2 MiB" }
    "16 MiB"
}

/// The eFuse's PSRAM_VENDOR code by name (the same table).
func psram_vendor_name(code: UInt) -> String {
    if code == 0 { return "none" }
    if code == 1 { return "AP 3.3 V" }
    if code == 2 { return "AP 1.8 V" }
    "unnamed"
}

/// MR2's density field by size (IDF esp_psram/esp32s3/
/// esp_psram_impl_octal.c, `s_print_psram_info`'s table).
func psram_density_name(code: UInt) -> String {
    if code == 1 { return "4 MiB" }
    if code == 3 { return "8 MiB" }
    if code == 5 { return "16 MiB" }
    if code == 7 { return "32 MiB" }
    if code == 6 { return "64 MiB" }
    "no size"
}

/// What a command of the call is, by its command word and address.
func psram_command_name(command: UInt, address: UInt) -> String {
    if command == 0xC0C0 { return "MR0 write" }
    if command == 0x0000 { return "array read" }
    if address == 0 { return "MR0/MR1 read" }
    if address == 2 { return "MR2/MR3 read" }
    if address == 4 { return "MR4 read" }
    "MR8 read"
}

/// The tail of a wait's line: every wait in the call reads SPI_MEM_CMD(1) at
/// most `mspi.c`'s POLL_BOUND times.
func psram_polls() unsafe {
    console_str(" after 100000 polls")
}

func psram_command(command: UInt, address: UInt) unsafe {
    psram_hex(command, 4)
    console_str(" (")
    console_str(psram_command_name(command, address))
    console_str(")")
}

/// Print the line for the stop `stop` that `psram_bringup` or
/// `psram_time_reads` answered, from the description at `expect` and the
/// record at `record`. For 0x50 neither is read: the line names the two
/// addresses.
public func psram_stop_line(expect: UInt, record: UInt, stop: UInt) unsafe {
    console_str("SOS-S3: psram stop: ")
    if stop == PSRAM_STOP_NOT_DRAM {
        console_str("bring-up record at 0x")
        console_hex(record)
        console_str(" or expectation at 0x")
        console_hex(expect)
        console_str(" is not in DRAM\n")
        return
    }
    let e = UnsafeMemory<PsramExpect, Normal>(expect)
    let r = UnsafeMemory<PsramRecord, Normal>(record)
    let read = r.read.read() as UInt
    let command = r.command.read() as UInt
    let address = r.address.read() as UInt
    if stop == PSRAM_STOP_EFUSE {
        let want_cap = e.efuse_cap.read() as UInt
        let want_vendor = e.efuse_vendor.read() as UInt
        console_str("efuse word 0x60007054 = 0x")
        console_hex(read)
        console_str(" says PSRAM_CAP=")
        psram_hex((read >> 3) & 3, 1)
        console_str(" PSRAM_VENDOR=")
        psram_hex((read >> 7) & 3, 1)
        console_str(", the board says ")
        psram_hex(want_cap, 1)
        console_str(" (")
        console_str(psram_cap_name(want_cap))
        console_str(") and ")
        psram_hex(want_vendor, 1)
        console_str(" (")
        console_str(psram_vendor_name(want_vendor))
        console_str(")\n")
    } else if stop == PSRAM_STOP_PAD_HELD {
        console_str("pads held, RTC_CNTL_DIG_PAD_HOLD = 0x")
        console_hex(read)
        console_str(", the board needs pads 26-28 and 33-37 free\n")
    } else if stop == PSRAM_STOP_CLOCK {
        console_str("clock SYSCLK_CONF=0x")
        console_hex(r.sysclk.read() as UInt)
        console_str(" CPU_PER_CONF=0x")
        console_hex(r.cpu_per.read() as UInt)
        console_str(" CORE_CLK_SEL=")
        psram_hex(r.core_clk_sel.read() as UInt, 1)
        console_str(", the board's PSRAM divider is for SYSCLK_CONF&0x80fff=0x")
        console_hex(e.sysclk.read() as UInt)
        console_str(" CPU_PER_CONF&7=")
        psram_hex(e.cpu_per.read() as UInt, 1)
        console_str(" CORE_CLK_SEL=")
        psram_hex(e.core_clk_sel.read() as UInt, 1)
        console_str("\n")
    } else if stop == PSRAM_STOP_BUSY_BEFORE {
        console_str("SPI1 busy before any command, SPI_MEM_CMD = 0x")
        console_hex(read)
        psram_polls()
        console_str("\n")
    } else if stop == PSRAM_STOP_ECC {
        console_str("SYSCON_SRAM_ACE0_ATTR = 0x")
        console_hex(read)
        console_str(" still has ECC on after clearing it\n")
    } else if stop == PSRAM_STOP_GATE {
        console_str("SPI1 MISC = 0x")
        console_hex(read)
        console_str(" after selecting CS1 alone; nothing was sent\n")
    } else if stop == PSRAM_STOP_BUSY_COMMAND {
        console_str("SPI1 busy before command ")
        psram_command(command, address)
        console_str(", SPI_MEM_CMD = 0x")
        console_hex(read)
        psram_polls()
        console_str("\n")
    } else if stop == PSRAM_STOP_GATE_LOST {
        console_str("SPI1 MISC = 0x")
        console_hex(read)
        console_str(" before command ")
        psram_command(command, address)
        console_str("; not sent\n")
    } else if stop == PSRAM_STOP_NOT_FINISHED {
        console_str("SPI1 command ")
        psram_command(command, address)
        console_str(" did not finish, SPI_MEM_CMD = 0x")
        console_hex(read)
        psram_polls()
        console_str("; CS0 left disabled\n")
    } else if stop == PSRAM_STOP_VENDOR {
        let want = e.vendor.read() as UInt
        console_str("MR1 vendor = ")
        psram_hex(read, 2)
        console_str(", the board says ")
        psram_hex(want, 2)
        if want == 0x0D { console_str(" (AP Memory)") }
        console_str("\n")
    } else if stop == PSRAM_STOP_DIE {
        console_str("MR2 = ")
        psram_hex(read, 2)
        console_str(" has the good-die bit clear, the board says a good die\n")
    } else if stop == PSRAM_STOP_DENSITY {
        let want = e.density.read() as UInt
        console_str("MR2 density = ")
        psram_hex(read, 1)
        console_str(" (")
        console_str(psram_density_name(read))
        console_str("), the board says ")
        psram_hex(want, 1)
        console_str(" (")
        console_str(psram_density_name(want))
        console_str(")\n")
    } else if stop == PSRAM_STOP_MR0 {
        console_str("MR0 = ")
        psram_hex(read, 2)
        console_str(" after writing 0x28\n")
    } else if stop == PSRAM_STOP_MMU {
        console_str("MMU entry ")
        psram_hex(address, 3)
        console_str(" reads 0x")
        console_hex(read)
        console_str(", wrote 0x")
        console_hex(r.expect.read() as UInt)
        console_str("\n")
    } else if stop == PSRAM_STOP_BUS_OFF {
        console_str("data bus off, EXTMEM_DCACHE_CTRL1 = 0x")
        console_hex(read)
        console_str("\n")
    } else if stop == PSRAM_STOP_MEASUREMENT {
        console_str("a timing measurement 0x")
        console_hex(read)
        console_str("; the measurements are 1 to 4\n")
    } else if stop == PSRAM_STOP_STILL_BUSY {
        console_str("SPI1 command ")
        psram_command(command, address)
        console_str(" still busy 4096 cycles after it started, ")
        console_str("SPI_MEM_CMD = 0x")
        console_hex(read)
        console_str("\n")
    } else {
        console_str("code 0x")
        console_hex(stop)
        console_str(", which this kernel does not name\n")
    }
}

/// SPI1's base (IDF reg_base.h, DR_REG_SPI1_BASE), for the words below.
static PSRAM_SPI1_BASE: UInt = 0x6000_2000

/// How many words the bring-up saves at S5 and puts back at S10.
public static PSRAM_SPI1_WORDS: Int = 11

/// The offset from SPI1's base of the `i`th word the bring-up saves, in
/// `mspi.c`'s order (IDF spi_mem_reg.h, SPI_MEM_<NAME>_REG(1)).
func psram_spi1_offset(i: Int) -> UInt {
    if i == 0 { return 0x14 }       // CLOCK
    if i == 1 { return 0x08 }       // CTRL
    if i == 2 { return 0x18 }       // USER
    if i == 3 { return 0x1C }       // USER1
    if i == 4 { return 0x20 }       // USER2
    if i == 5 { return 0x04 }       // ADDR
    if i == 6 { return 0x24 }       // MOSI_DLEN
    if i == 7 { return 0x28 }       // MISO_DLEN
    if i == 8 { return 0x3C }       // CACHE_FCTRL
    if i == 9 { return 0xE0 }       // DDR
    0x34                            // MISC
}

func psram_spi1_name(i: Int) -> String {
    if i == 0 { return "clock" }
    if i == 1 { return "ctrl" }
    if i == 2 { return "user" }
    if i == 3 { return "user1" }
    if i == 4 { return "user2" }
    if i == 5 { return "addr" }
    if i == 6 { return "mosi_dlen" }
    if i == 7 { return "miso_dlen" }
    if i == 8 { return "fctrl" }
    if i == 9 { return "ddr" }
    "misc"
}

/// Read the words the bring-up saves into `words`, for a harness to compare
/// across the call. Each register is read; nothing is written.
public func psram_spi1_words(words: &var [UInt32; 11]) unsafe {
    var i = 0
    while i < PSRAM_SPI1_WORDS {
        words[i] = UnsafeMemory<UInt32, Device>(
            PSRAM_SPI1_BASE + psram_spi1_offset(i)).read()
        i += 1
    }
}

/// Print, for a harness, SPI1's MISC and clock as they read now, and whether
/// every word the bring-up saves reads as it did in `before`, naming each one
/// that does not.
public func psram_spi1_line(before: &[UInt32; 11]) unsafe {
    var after: [UInt32; 11] = [0; 11]
    psram_spi1_words(&var after)
    console_str("SOS psram: SPI1 MISC=0x")
    console_hex(after[10] as UInt)
    console_str(" clock=0x")
    console_hex(after[0] as UInt)
    var same = true
    var i = 0
    while i < PSRAM_SPI1_WORDS {
        if after[i] != before[i] {
            if same { console_str(" after the call, differing:") }
            same = false
            console_str(" ")
            console_str(psram_spi1_name(i))
            console_str("=0x")
            console_hex(before[i] as UInt)
            console_str("->0x")
            console_hex(after[i] as UInt)
        }
        i += 1
    }
    if same { console_str(" after the call, as before it") }
    console_str("\n")
}

// =============================================================================
// The flash's reads, Saw half
// =============================================================================
//
// `mspi.c`'s `sos_flash_read` sends one of the flash's five reads from IRAM,
// with every check before it writes SPI1, and fills in a record; this half
// passes it the record and prints the line a stop's record says (../ABI.md
// §18). It writes nothing to the memory-SPI controller itself.

extern "C" {
    func sos_flash_read(record: UInt, op: UInt, addr: UInt) -> UInt
}

/// What a read found, as `mspi.c`'s `struct sos_flash_record` lays it out:
/// a stop's words, the answer (its first byte in [7:0]), whether SPI1's
/// words had been saved when it stopped, and MISC(1) as the gate read it.
public struct FlashRecord {
    stop: UInt32,
    read: UInt32,
    expect: UInt32,
    command: UInt32,
    address: UInt32,
    answer: UInt32,
    saved: UInt32,
    misc: UInt32,
}

static_assert(sizeof<FlashRecord>() == 32, "FlashRecord is mspi.c's layout")

/// The flash's reads, the only commands `sos_flash_read` sends (`mspi.c`'s
/// FLASH_*, IDF spi_flash_defs.h): the JEDEC ID (3 bytes), status registers
/// 1, 2 and 3 (a byte each) and SFDP (4 bytes at a 24-bit address).
public static FLASH_RDID: UInt = 0x9F
public static FLASH_RDSR: UInt = 0x05
public static FLASH_RDSR2: UInt = 0x35
public static FLASH_RDSR3: UInt = 0x15
public static FLASH_RDSFDP: UInt = 0x5A

/// The stops' codes (../ABI.md §18a).
static FLASH_STOP_GATE: UInt = 0x73
static FLASH_STOP_BUSY: UInt = 0x74
static FLASH_STOP_STUCK: UInt = 0x75
static FLASH_STOP_NOT_DRAM: UInt = 0x79
static FLASH_STOP_NOT_READ: UInt = 0x7A
static FLASH_STOP_DDR: UInt = 0x7B

/// Send the flash the read `op` (one of FLASH_*), at `addr` for SFDP,
/// filling in the record at `record`, which must be DRAM. Answers 0, or the
/// stop code, whose line `flash_stop_line` prints; after 0x75 the caller
/// halts.
public func flash_read(record: UInt, op: UInt, addr: UInt) unsafe -> UInt {
    sos_flash_read(record, op, addr)
}

/// The tail of a stop's line: whether SPI1 was written before it, and so
/// put back.
func flash_untouched(saved: UInt32) unsafe {
    if saved != 0 {
        console_str("; nothing was sent, SPI1 put back\n")
    } else {
        console_str("; nothing was sent\n")
    }
}

/// Print the line for the stop `stop` that `flash_read` answered, from the
/// record at `record`. For 0x79 the record is not read: the line names its
/// address.
public func flash_stop_line(record: UInt, stop: UInt) unsafe {
    console_str("SOS-S3: flash stop: ")
    if stop == FLASH_STOP_NOT_DRAM {
        console_str("the record at 0x")
        console_hex(record)
        console_str(" is not in DRAM\n")
        return
    }
    let r = UnsafeMemory<FlashRecord, Normal>(record)
    let read = r.read.read() as UInt
    let command = r.command.read() as UInt
    let saved = r.saved.read()
    if stop == FLASH_STOP_NOT_READ {
        psram_hex(read, 2)
        console_str(" is not one of the flash's reads (0x9f 0x05 0x35 0x15 ")
        console_str("0x5a)")
        flash_untouched(saved)
    } else if stop == FLASH_STOP_GATE {
        console_str("SPI1 MISC=0x")
        console_hex(read)
        console_str(" before command ")
        psram_hex(command, 2)
        console_str(", the flash's commands need chip select 0 alone ")
        console_str("(0x00000002)")
        flash_untouched(saved)
    } else if stop == FLASH_STOP_DDR {
        console_str("SPI1 DDR=0x")
        console_hex(read)
        console_str(" before command ")
        psram_hex(command, 2)
        console_str(", the flash's reads need single data rate (0)")
        flash_untouched(saved)
    } else if stop == FLASH_STOP_BUSY {
        console_str("SPI1 busy before command ")
        psram_hex(command, 2)
        console_str(", SPI_MEM_CMD=0x")
        console_hex(read)
        psram_polls()
        flash_untouched(saved)
    } else if stop == FLASH_STOP_STUCK {
        console_str("SPI1 command ")
        psram_hex(command, 2)
        console_str(" did not finish, SPI_MEM_CMD=0x")
        console_hex(read)
        psram_polls()
        console_str("; SPI1 left as it is\n")
    } else {
        console_str("code 0x")
        console_hex(stop)
        console_str(", which this kernel does not name\n")
    }
}

/// Print, for a harness, `lead`, then SPI1's MISC and clock as they read
/// now, and whether every word the reads save reads as it did in `before`
/// (`psram_spi1_words`), naming each one that does not.
public func flash_spi1_line(lead: String, before: &[UInt32; 11]) unsafe {
    var after: [UInt32; 11] = [0; 11]
    psram_spi1_words(&var after)
    console_str(lead)
    console_str("SPI1 MISC=0x")
    console_hex(after[10] as UInt)
    console_str(" clock=0x")
    console_hex(after[0] as UInt)
    var same = true
    var i = 0
    while i < PSRAM_SPI1_WORDS {
        if after[i] != before[i] {
            if same { console_str(" after the reads, differing:") }
            same = false
            console_str(" ")
            console_str(psram_spi1_name(i))
            console_str("=0x")
            console_hex(before[i] as UInt)
            console_str("->0x")
            console_hex(after[i] as UInt)
        }
        i += 1
    }
    if same { console_str(" after the reads, as before them") }
    console_str("\n")
}

/// One past the highest user address a RAM row may take. A row's address is
/// its bytes' on this board, so it is RAM's end.
public static USER_RAM_TOP: UInt = RAM_TOP

// =============================================================================
// The PSRAM brought up whole: the map, the read-back test, the line
// =============================================================================
//
// What a board facade with PSRAM runs from its `memory_init` (../ABI.md §17):
// the description of its part at the image's clock, the whole call (S0 to
// S12), the read-back test (S14) over every byte it describes, and the line
// that says how it went. The facade publishes the PSRAM (S15) only when this
// answers 0. This board describes none, so its `memory_init` writes nothing.

/// Bring up the RAM this board describes beyond what the boot left usable:
/// none. `kmain` calls it after `clock_init` and the banner, before anything
/// is loaded; the `esp32s3-r8` board's facade brings its PSRAM up here.
public func memory_init() unsafe {
}

extern "C" {
    func sos_board_image() -> UInt
}

/// Is this image linked for the part rather than the emulator? A board image
/// is linked with `_sos_semihosting` at 0 (`sink.c`, ../ABI.md §10), the one
/// link-time fact that tells the two machines apart: a PSRAM description
/// names the part's clock words in a board image and the emulator's in any
/// other (`PsramClock`).
public func board_image() -> Bool {
    sos_board_image() != 0
}

/// The clock a PSRAM description is for: the three words S0.3 compares, each
/// masked as it compares them (`mspi.c`'s SYSCLK_MASK, CPU_PER_MASK and
/// CORE_CLK_SEL_MASK), and the divider word for the bus at that clock, as
/// IDF's `mspi_timing_ll_set_psram_clock` encodes it (../ABI.md §16b).
public struct PsramClock {
    sysclk: UInt32,
    cpu_per: UInt32,
    core_clk_sel: UInt32,
    divider: UInt32,
}

/// The emulator's clock words, the same whatever an image's clock key
/// stores: SYSCLK_CONF reads the PLL selected at a pre-divider of 1, and
/// CPU_PER_CONF and the memory-SPI core clock select read 0 (../ABI.md §14e,
/// §16b). Masked as S0.3 compares them.
public static PSRAM_EMULATOR_SYSCLK: UInt32 = 0x0008_0401
public static PSRAM_EMULATOR_CPU_PER: UInt32 = 0
public static PSRAM_EMULATOR_CORE_CLK_SEL: UInt32 = 0

/// The divider word that divides the memory-SPI core clock by `div` in
/// SPI_MEM_SRAM_CLK(0) and SPI_MEM_CLOCK(1) (IDF
/// `mspi_timing_ll_set_psram_clock`, hal/esp32s3/include/hal/
/// mspi_timing_tuning_ll.h): SCLK_EQU_SYSCLK [31] alone for 1; otherwise
/// SCLKCNT_N [23:16] and SCLKCNT_L [7:0] `div - 1`, and SCLKCNT_H [15:8]
/// `div / 2 - 1`.
public func psram_divider_word(div: UInt) -> UInt32 {
    if div <= 1 {
        return 0x8000_0000
    }
    (((div - 1) << 16) | ((div / 2 - 1) << 8) | (div - 1)) as UInt32
}

/// The sizes of the part's octal AP PSRAM that the eFuse and the chip both
/// name: 8 MiB (PSRAM_CAP 1, MR2's density 3) and 16 MiB (PSRAM_CAP 3,
/// density 5). efuse/esp32s3/esp_efuse_table.csv; IDF esp_psram/esp32s3/
/// esp_psram_impl_octal.c, `s_print_psram_info`.
public static PSRAM_8_MIB: UInt = 0x80_0000
public static PSRAM_16_MIB: UInt = 0x100_0000

/// The description of `bytes` (8 or 16 MiB) of AP Memory's octal PSRAM at
/// 3.3 V (PSRAM_VENDOR 1, MR1's vendor 0x0D) at `clock`. One fact, the size,
/// sets both the eFuse's size code and the chip's density.
public func psram_expect(bytes: UInt, clock: PsramClock) -> PsramExpect {
    assert(bytes == PSRAM_8_MIB || bytes == PSRAM_16_MIB,
           "a PSRAM description is 8 or 16 MiB")
    let sixteen = bytes == PSRAM_16_MIB
    PsramExpect(efuse_cap: if sixteen { 3 } else { 1 }, efuse_vendor: 1,
                vendor: 0x0D, density: if sixteen { 5 } else { 3 },
                divider: clock.divider, sysclk: clock.sysclk,
                cpu_per: clock.cpu_per, core_clk_sel: clock.core_clk_sel)
}

/// The description and the record of a board's bring-up: kernel statics, so
/// DRAM, as `mspi.c`'s entry check requires.
unsafe static var PSRAM_EXPECT: PsramExpect
unsafe static var PSRAM_RECORD: PsramRecord

/// Write the description of `bytes` at `clock` into the bring-up's own, and
/// answer its address for `psram_bringup`.
public func psram_description(bytes: UInt, clock: PsramClock) unsafe -> UInt {
    PSRAM_EXPECT = psram_expect(bytes, clock)
    ((&var PSRAM_EXPECT) as UnsafePointer<PsramExpect>) as UInt
}

/// The address of the bring-up's own record, for `psram_bringup`.
public func psram_record() unsafe -> UInt {
    ((&var PSRAM_RECORD) as UnsafePointer<PsramRecord>) as UInt
}

/// The read-back test's pattern (IDF esp_psram.c, `s_test_psram`): the word
/// at word index p from `PSRAM_BASE` is written with p ^ this.
static PSRAM_TEST_PATTERN: UInt = 0xAAAA_AAAA
/// The test writes and reads every eighth word, one in each 32 bytes.
static PSRAM_TEST_STEP: UInt = 8

/// What the read-back test found: how many of the words it wrote read back
/// otherwise, and the first such word's address, what it read and what was
/// written there.
public struct PsramReadBack {
    wrong: UInt,
    at: UInt,
    read: UInt32,
    wrote: UInt32,
}

/// S14, the read-back test (IDF `s_test_psram`): every eighth word of the
/// `bytes` bytes at `PSRAM_BASE` written with its word index ^ 0xAAAAAAAA,
/// then each read back. The span is many times the data cache, so every word
/// written has been evicted to the chip before the read pass reaches it, and
/// every read is a fill from the chip; a chip smaller than its description
/// aliases, and a word written later reads back where an earlier one was.
/// Each access is a volatile load or store, so each one is made.
public func psram_read_back(bytes: UInt) unsafe -> PsramReadBack {
    let words = bytes / 4
    var p: UInt = 0
    while p < words {
        let at = UnsafeMemory<UInt32, Device>(PSRAM_BASE + 4 * p)
        at.write((p ^ PSRAM_TEST_PATTERN) as UInt32)
        p += PSRAM_TEST_STEP
    }
    var found = PsramReadBack(wrong: 0, at: 0, read: 0, wrote: 0)
    p = 0
    while p < words {
        let want = (p ^ PSRAM_TEST_PATTERN) as UInt32
        let got = UnsafeMemory<UInt32, Device>(PSRAM_BASE + 4 * p).read()
        if got != want {
            if found.wrong == 0 {
                found = PsramReadBack(wrong: 0, at: PSRAM_BASE + 4 * p,
                                      read: got, wrote: want)
            }
            found.wrong += 1
        }
        p += PSRAM_TEST_STEP
    }
    found
}

/// `v` in decimal.
func psram_decimal(v: UInt) unsafe {
    if v >= 10 {
        psram_decimal(v / 10)
    }
    console_byte(((v % 10) + 48) as UInt8)
}

/// Print the read-back test's stop line, 0x60, for what it `found` over
/// `bytes`.
public func psram_read_back_line(found: &PsramReadBack, bytes: UInt) unsafe {
    console_str("SOS-S3: psram stop: read-back at 0x")
    console_hex(found.at)
    console_str(" read 0x")
    console_hex(found.read as UInt)
    console_str(", wrote 0x")
    console_hex(found.wrote as UInt)
    console_str(" (0x")
    console_hex(found.wrong)
    console_str(" of 0x")
    console_hex(bytes / 4 / PSRAM_TEST_STEP)
    console_str(" words wrong)\n")
}

/// Print the line that says `bytes` of PSRAM are up, with the mode registers
/// as the bring-up whose record is at `record` read them last.
public func psram_up_line(record: UInt, bytes: UInt) unsafe {
    let r = UnsafeMemory<PsramRecord, Normal>(record)
    let mr01 = r.mr01_after.read() as UInt
    let mr23 = r.mr23.read() as UInt
    console_str("SOS-S3: psram ")
    psram_decimal(bytes >> 20)
    console_str(" MiB at 0x")
    console_hex(PSRAM_BASE)
    console_str(", MR0=")
    psram_hex(mr01 & 0xFF, 2)
    console_str(" MR1=")
    psram_hex(mr01 >> 8, 2)
    console_str(" MR2=")
    psram_hex(mr23 & 0xFF, 2)
    console_str(" MR3=")
    psram_hex(mr23 >> 8, 2)
    console_str(", read-back ok\n")
}

/// Bring up `bytes` of the part's PSRAM described at `clock`: the whole call
/// (`psram_map_up`), then the read-back test over all of it
/// (`psram_test_up`). Answers 0 once the line that says so is printed, or
/// the stop's code once its line is.
public func psram_up(bytes: UInt, clock: PsramClock) unsafe -> UInt {
    let stop = psram_map_up(bytes, clock)
    if stop != 0 {
        return stop
    }
    psram_test_up(bytes)
}

/// The whole call, S0 to S12, on the bring-up's own description of `bytes`
/// at `clock` and its own record. Answers 0, or the stop's code once its
/// line is printed.
public func psram_map_up(bytes: UInt, clock: PsramClock) unsafe -> UInt {
    let expect = psram_description(bytes, clock)
    let record = psram_record()
    let stop = psram_bringup(expect, record, PSRAM_THROUGH_S12)
    if stop != 0 {
        psram_stop_line(expect, record, stop)
    }
    stop
}

/// The read-back test over the `bytes` the bring-up's own call mapped (S14).
/// Answers 0 once the line that says the PSRAM is up is printed, or 0x60
/// once the test's stop line is.
public func psram_test_up(bytes: UInt) unsafe -> UInt {
    let found = psram_read_back(bytes)
    if found.wrong != 0 {
        psram_read_back_line(&found, bytes)
        return PSRAM_STOP_READ_BACK
    }
    psram_up_line(psram_record(), bytes)
    0
}

/// SYSTIMER's count, in ticks of 1/16 us, the counter started first if
/// nothing has started it: for a harness to time a step of the bring-up.
public func psram_ticks() unsafe -> UInt64 {
    let timer = Systimer()
    timer.start()
    timer.now()
}
