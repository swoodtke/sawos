//! The console key `b921600`: UART0 at 921,600 baud from the crystal.
//!
//! One of the `s3console` modules, mapped by a case's `console` (the runner)
//! or an image's `[keys]` (`sosimage`). The HAL's `clock_init` calls its
//! `console_init` first (`../../kernel/lib.saw`). The switch is
//! `s3consolekit`'s (`../console-common/`); `../../ABI.md` §14i has the
//! sequence, this divisor (694 sixteenths, 922,190 baud, 0.064 percent fast)
//! and its derivation.

import s3consolekit.{console_switch, console_switch_found}

static BAUD: UInt = 921_600

/// Set the console's rate this image is built for.
public func console_init() unsafe {
    console_switch("b921600", BAUD)
}

/// `console_init` on a UART0 whose CLK_CONF reads `clk_conf`, handed in where
/// the emulator's own word is not the part's (`tests/xtensa/
/// console_found.saw`).
public func console_init_found(clk_conf: UInt32) unsafe {
    console_switch_found("b921600", BAUD, clk_conf)
}
