//! The console stall key `on`: from the moment the tick is first armed, the
//! console counts the bytes it writes and the SYSTIMER ticks it spends waiting
//! for room in UART0's transmit FIFO, and the clean stop prints both.
//!
//! One of the `s3stall` modules, which the runner maps by whether an image's
//! case asks for the count (`console_stall`). The HAL's `console_byte` writes
//! through `counted_byte` when `CONSOLE_STALL_COUNT` is set, and its
//! `exit_pass` prints the count (`../../kernel/lib.saw`; `../../ABI.md` §14
//! says how a reader uses it).
//!
//! The count starts when SYSTIMER's comparator is first armed, which is the
//! tick's, just before the first entry to user mode: the HAL's
//! `set_deadline` sets TARGET0_WORK_EN and nothing clears it for longer than
//! the store that rewrites the target. So the boot's own lines are not in it.
//!
//! It reaches UART0 and SYSTIMER through its own views of their registers
//! rather than the HAL's drivers: the HAL names nothing here, so an image
//! built with the count off is the bytes it would be without it.

/// Whether the console measures how long the kernel waits for FIFO room.
public static CONSOLE_STALL_COUNT: Bool = true

/// UART0's transmit FIFO, and its status word with the FIFO's occupancy in
/// [25:16], counted against the FIFO's depth (../../ABI.md §4).
static UART0_FIFO: UInt = 0x6000_0000
static UART0_STATUS: UInt = 0x6000_001C
static TXFIFO_CNT_SHIFT: UInt32 = 16
static TXFIFO_CNT_MASK: UInt32 = 0x3FF
static TX_FIFO_DEPTH: UInt32 = 128

/// SYSTIMER's CONF, whose TARGET0_WORK_EN says the comparator is armed, and
/// UNIT0, read by handshake: write UPDATE to UNIT0_OP, poll VALUE_VALID,
/// then read the two halves (../../ABI.md §6a). The HAL starts the counter
/// before it arms the comparator.
static SYSTIMER_CONF: UInt = 0x6002_3000
static TARGET0_WORK_EN: UInt32 = 1 << 24
static SYSTIMER_UNIT0_OP: UInt = 0x6002_3004
static SYSTIMER_UNIT0_VALUE_HI: UInt = 0x6002_3040
static SYSTIMER_UNIT0_VALUE_LO: UInt = 0x6002_3044
static UNIT0_UPDATE: UInt32 = 1 << 30
static UNIT0_VALUE_VALID: UInt32 = 1 << 29
static WORD_BITS: Int = 32

/// SYSTIMER counts at 16 MHz.
static TICKS_PER_US: UInt64 = 16

/// The ticks spent waiting for room and the bytes written since the count
/// started, and whether it has. Global state on a serialization argument the
/// compiler cannot see: one core, and every writer runs in the kernel with
/// interrupts masked.
unsafe static var STALL_TICKS: UInt64 = 0
unsafe static var STALL_BYTES: UInt = 0
unsafe static var STARTED: Bool = false

/// Has the count started? Once the comparator has been armed it has, for
/// good.
func started() unsafe -> Bool {
    if not STARTED {
        STARTED = (device_word(SYSTIMER_CONF).read() & TARGET0_WORK_EN) != 0
    }
    STARTED
}

/// One 32-bit device register.
func device_word(addr: UInt) unsafe -> UnsafeMemory<UInt32, Device> {
    UnsafeMemory<UInt32, Device>(addr)
}

/// Is there room in the transmit FIFO?
func room() unsafe -> Bool {
    let status = device_word(UART0_STATUS).read()
    ((status >> TXFIFO_CNT_SHIFT) & TXFIFO_CNT_MASK) < TX_FIFO_DEPTH
}

/// SYSTIMER's UNIT0 now.
///
/// No preemption point: the poll waits on a hardware latch.
func now() unsafe -> UInt64 {
    let op = device_word(SYSTIMER_UNIT0_OP)
    op.write(UNIT0_UPDATE)
    while (op.read() & UNIT0_VALUE_VALID) == 0 { }
    let hi = device_word(SYSTIMER_UNIT0_VALUE_HI).read()
    let lo = device_word(SYSTIMER_UNIT0_VALUE_LO).read()
    ((hi as UInt64) << WORD_BITS) | (lo as UInt64)
}

/// Write one console byte, as the HAL's console does: wait for room, then
/// store it. Once the count has started, a wait is timed and the byte is
/// counted; a byte that finds room costs one status read, as uncounted.
public func counted_byte(b: UInt8) unsafe {
    let counting = started()
    if not room() {
        let start = now()
        while not room() { }
        if counting {
            STALL_TICKS = STALL_TICKS + (now() - start)
        }
    }
    if counting {
        STALL_BYTES = STALL_BYTES + 1
    }
    device_word(UART0_FIFO).write(b as UInt32)
}

/// The count's line, for a clean stop: the wait in microseconds and the bytes
/// written. Both are read before the line, whose own bytes are counted too.
public func report_stall() unsafe {
    let stalled_us = UInt.from(truncating: STALL_TICKS / TICKS_PER_US)
    let bytes = STALL_BYTES
    write_str("SOS-S3: console stalled ")
    write_decimal(stalled_us)
    write_str(" us writing ")
    write_decimal(bytes)
    write_str(" bytes after the tick was armed\n")
}

func write_str(s: String) unsafe {
    var i = 0
    while i < s.len() {
        counted_byte(s.byte_at(i))
        i += 1
    }
}

/// Write `v` in decimal, allocating nothing.
func write_decimal(v: UInt) unsafe {
    var digits: [UInt8; 10] = [0; 10]
    var count: Int = 0
    var rest = v
    while {
        digits[count] = UInt8.from(truncating: rest % 10) + 48
        count += 1
        rest = rest / 10
        if rest == 0 {
            break
        }
    }
    while count > 0 {
        count -= 1
        counted_byte(digits[count])
    }
}
