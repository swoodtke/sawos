//! The flash key `qio40`: `qio80`'s switch with the flash at 40 MHz, the
//! memory-SPI core clock divided by 2. It is built beside `qio80` to tell a
//! timing failure at 80 MHz from a failure of the sequence: the same stores
//! at half the clock (`../../ABI.md` §18f). It reads QE at every boot and
//! stops if it is clear, as `qio80` does.
//!
//! One of the `s3flash` modules, mapped by a case's `flash_key` (the runner)
//! or an image's `[keys]` (`sosimage`). The HAL's `clock_init` calls its
//! `flash_init` after the clock key's (`../../kernel/lib.saw`). The switch is
//! `s3flashkit`'s (`../flash-common/`).

import s3clock.{MSPI_CORE_MHZ}
import s3flashkit.{flash_init_at, MODE_HALF, MODE_QUAD}

static_assert(MSPI_CORE_MHZ == 80,
              "qio40 needs a clock key on the PLL: pll80, pll160 or pll240")

/// Switch the flash's reads to QIO at 40 MHz, or say why not and leave them
/// as the ROM left them.
public func flash_init() unsafe {
    flash_init_at("qio40", MODE_QUAD | MODE_HALF)
}
