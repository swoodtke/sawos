//! The clock key `pll160`: the CPU on the BBPLL at 160 MHz, the PLL at 480
//! MHz divided by 3, with the LDOs set first as ESP-IDF sets them for every
//! speed below 240 MHz.
//!
//! One of the `s3clock` modules, mapped by a case's `clock` (the runner) or an
//! image's `[keys]` (`sosimage`). The HAL re-exports its `clock_init`, which
//! `kmain` calls first, before anything prints or is timed and before the
//! loader (`../../kernel/lib.saw`). `../../ABI.md` §14 has the sequence
//! ESP-IDF v5.4.1 runs, the source of each step, and which of it this takes.
//!
//! In order (`s3clockkit`'s `pll_ldo_switch`):
//!
//!   * the LDO settings: ESP-IDF's `g_rtc_dbias_pvt_non_240m` and
//!     `g_dig_dbias_pvt_non_240m`, computed from the eFuse's calibration
//!     (`s3dbias`, `../../dbias/`) and held to the range ESP-IDF's
//!     arithmetic gives them. Out of it, a line says so, nothing is written,
//!     and the boot goes on at the clock the ROM left;
//!   * a CPU found at 240 MHz: a line says so, nothing is written, and the
//!     boot goes on at 240. ESP-IDF writes these two settings after the
//!     clock comes down from 240, where this key would write them before;
//!   * the BBPLL powered and set to 480 MHz, as `pll80` does;
//!   * the two LDO writes `rtc_init` makes (esp_hw_support/port/esp32s3/
//!     rtc_init.c), in its order: I2C_DIG_REG (block 0x6D, host 1;
//!     soc/esp32s3/include/soc/regi2c_dig_reg.h) register 4, EXT_RTC_DREG
//!     [4:0], then register 6, EXT_DIG_DREG [4:0];
//!   * 40 us for the voltage to settle, the wait
//!     `rtc_clk_cpu_freq_to_pll_mhz` (rtc_clk.c) makes after it moves an
//!     LDO; in an application `rtc_init` runs long before the switch;
//!   * `rtc_clk_cpu_freq_to_pll_mhz(160)`'s three stores: CPUPERIOD_SEL 1,
//!     the pre-divider to 1, the source to the PLL.
//!
//! What moves with it, beside `pll80`'s list: APB stays 80 MHz on the PLL;
//! the memory-SPI core clock follows CORE_CLK_SEL and the PLL, not
//! CPUPERIOD_SEL, so the flash stays 20 MHz. The LDO slaves stay as the ROM
//! leaves them, all six on, where ESP-IDF opens five at 160 MHz.
//!
//! Every word written is volatile, the LDO settings with the rest: a power
//! cycle puts each back. The eFuse is only read.
//!
//! It reaches every register through `s3clockkit`'s views and the ROM's
//! functions rather than the HAL's drivers: the HAL names nothing here, so an
//! image built at the `rom` key is the bytes it would be without the keys.

import s3clockkit.{ClockWords, clock_words, efuse_dbias, pll_ldo_switch}
import s3dbias.{Dbias}

/// CPUPERIOD_SEL for 160 MHz: the PLL at 480 MHz divided by 3.
static CPUPERIOD_160M: UInt32 = 1

/// Set the CPU clock this image is built for: the PLL at 160 MHz, with the
/// LDOs set from the eFuse first.
public func clock_init() unsafe {
    clock_init_found(clock_words())
}

/// `clock_init` on a CPU whose clock words read `found`.
public func clock_init_found(found: ClockWords) unsafe {
    clock_init_at(efuse_dbias(), found)
}

/// `clock_init` with the LDO settings `dbias`, on a CPU whose clock words
/// read `found`. Settings outside the range ESP-IDF's arithmetic gives them
/// stop it before anything is written.
public func clock_init_at(dbias: Dbias, found: ClockWords) unsafe {
    pll_ldo_switch("pll160", dbias, rtc: dbias.rtc_non_240m,
                   dig: dbias.dig_non_240m, period: CPUPERIOD_160M,
                   found: found)
}
