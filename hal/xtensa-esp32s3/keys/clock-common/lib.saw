//! What the clock keys that write share: the clock words' addresses, the
//! console held still across a switch, the CPU's speed measured against
//! SYSTIMER, a console writer of their own, the stop for a CPU found at 240
//! MHz, and the PLL keys' bring-up, LDO writes and switch.
//!
//! The `s3clockkit` module. The profile maps it for every image, but only a
//! clock key that writes imports it (`../clock-xtal40/`, `../clock-pll80/`,
//! `../clock-pll160/`, `../clock-pll240/`), so an image at the `rom` key
//! compiles nothing from it. Like the keys, it reaches every register through
//! views of its own and names nothing in `../../kernel/lib.saw`.
//! `../../ABI.md` §14 is the source of every number.

import s3dbias.{Calibration, Dbias, EfuseWords, EFUSE_BASE, EFUSE_SYS_3,
                EFUSE_SYS_4, EFUSE_SYS_5, EFUSE_PART1_DATA4, check_dbias,
                stored_dbias}

extern "C" {
    func sos_ccount_read() -> UInt
    func sos_clock_store(addr: UInt, value: UInt)
    func sos_pll_bringup() -> UInt
    func sos_windowed_call(fn_addr: UInt, a: UInt, b: UInt, c: UInt, d: UInt,
                           e: UInt, f: UInt) -> UInt
}

/// SYSTEM_SYSCLK_CONF_REG: SOC_CLK_SEL [11:10] (0 the crystal, 1 the PLL, 2
/// RC_FAST) and PRE_DIV_CNT [9:0], the crystal's divider less one.
public static SYSCLK_CONF: UInt = 0x600C_0060
public static SOC_CLK_SEL_SHIFT: UInt32 = 10
public static SOC_CLK_SEL_MASK: UInt32 = 0x3
public static SOC_CLK_SEL_XTAL: UInt32 = 0
public static SOC_CLK_SEL_PLL: UInt32 = 1
public static PRE_DIV_CNT_MASK: UInt32 = 0x3FF

/// SYSTEM_CPU_PER_CONF_REG: PLL_FREQ_SEL [2] and CPUPERIOD_SEL [1:0], the
/// PLL's division for the CPU.
public static CPU_PER_CONF: UInt = 0x600C_0010
public static CPUPERIOD_SEL_MASK: UInt32 = 0x3

/// CPUPERIOD_SEL for 240 MHz: the PLL at 480 MHz divided by 2.
public static CPUPERIOD_240M: UInt32 = 2

/// The CPU's two clock words as a key finds them, before it writes
/// anything: SYSCLK_CONF and CPU_PER_CONF.
public struct ClockWords {
    sysclk: UInt32,
    cpu_per: UInt32,
}

/// The clock words as they read now.
public func clock_words() unsafe -> ClockWords {
    ClockWords(sysclk: device_word(SYSCLK_CONF).read(),
               cpu_per: device_word(CPU_PER_CONF).read())
}

/// Whether `found` has the CPU at 240 MHz: on the PLL, with CPUPERIOD_SEL 2.
/// On the crystal CPUPERIOD_SEL clocks nothing, whatever it holds.
public func at_240(found: ClockWords) -> Bool {
    let source = (found.sysclk >> SOC_CLK_SEL_SHIFT) & SOC_CLK_SEL_MASK
    source == SOC_CLK_SEL_PLL &&
        (found.cpu_per & CPUPERIOD_SEL_MASK) == CPUPERIOD_240M
}

/// The stop of a key that would lower a CPU found at 240 MHz, `name` its
/// line's name: its `not taken` line, before anything is written. ESP-IDF
/// lowers both LDOs once the clock has come down from 240
/// (`rtc_clk_cpu_freq_to_pll_mhz` and `rtc_clk_cpu_freq_to_xtal`, rtc_clk.c),
/// a step no key below 240 makes, so such a key leaves the CPU, and the
/// voltage, as it found them.
public func write_not_lowered(name: String, found: ClockWords) unsafe {
    write_str("SOS-S3: clock ")
    write_str(name)
    write_str(" not taken: the CPU was found at 240 MHz, which this key ")
    write_str("does not lower; nothing is written sysclk=0x")
    write_hex(found.sysclk)
    write_str(" cpu_per=0x")
    write_hex(found.cpu_per)
    write_byte(10)
}

/// UART0: the transmit FIFO, the status word with the FIFO's occupancy in
/// [25:16], the divisor, FSM_STATUS with ST_UTX_OUT in [7:4] (zero with the
/// transmitter idle), and CLK_CONF with SCLK_SEL in [21:20] (1 APB, 2
/// RC_FAST, 3 the crystal).
static UART0_FIFO: UInt = 0x6000_0000
static UART0_CLKDIV: UInt = 0x6000_0014
static UART0_STATUS: UInt = 0x6000_001C
static UART0_FSM_STATUS: UInt = 0x6000_006C
public static UART0_CLK_CONF: UInt = 0x6000_0078
static TXFIFO_CNT_SHIFT: UInt32 = 16
static TXFIFO_CNT_MASK: UInt32 = 0x3FF
static TX_FIFO_DEPTH: UInt32 = 128
static ST_UTX_OUT_SHIFT: UInt32 = 4
static ST_UTX_OUT_MASK: UInt32 = 0xF
static SCLK_SEL_SHIFT: UInt32 = 20
static SCLK_SEL_MASK: UInt32 = 0x3
static SCLK_XTAL: UInt32 = 3

/// The words the mask ROM's `Uart_Init` (0x4004_89F0) writes for UART0: the
/// clock enables, SCLK_SEL 3 and no pre-divide; and the divisor, 40 MHz
/// times 16 over 115200 = 5555, the integer part 347 in [11:0] and the
/// sixteenths, 3, in [23:20], as ESP-IDF's `uart_ll_set_baudrate` computes it.
static UART_CLK_CONF_ROM: UInt32 = 0x0370_0000
static UART_CLKDIV_ROM: UInt32 = (3 << 20) | 347
static_assert((40_000_000 * 16) / 115_200 == (347 * 16) + 3,
              "the console's divisor is 40 MHz over 115200, in sixteenths")

/// SPI0's SPI_MEM_CORE_CLK_SEL_REG and SPI_MEM_CLOCK_REG: the memory-SPI core
/// clock's select and the flash's divider over it. Read for the line only.
public static SPI0_CORE_CLK_SEL: UInt = 0x6000_30EC
public static SPI0_CLOCK: UInt = 0x6000_3014

/// RTC_CNTL_DATE_REG, whose bits [18:13] are the LDO slaves ESP-IDF powers
/// down by CPU speed. Read for the line only.
public static RTC_CNTL_DATE: UInt = 0x6000_81FC

/// SYSTIMER: CONF's CLK_EN and UNIT0_WORK_EN start UNIT0, which is read by
/// handshake: write UPDATE to UNIT0_OP, poll VALUE_VALID, read the halves
/// (../../ABI.md §6a).
static SYSTIMER_CONF: UInt = 0x6002_3000
static SYSTIMER_CLK_EN: UInt32 = 0x8000_0000
static SYSTIMER_UNIT0_WORK_EN: UInt32 = 1 << 30
static SYSTIMER_UNIT0_OP: UInt = 0x6002_3004
static SYSTIMER_UNIT0_VALUE_HI: UInt = 0x6002_3040
static SYSTIMER_UNIT0_VALUE_LO: UInt = 0x6002_3044
static UNIT0_UPDATE: UInt32 = 1 << 30
static UNIT0_VALUE_VALID: UInt32 = 1 << 29
static WORD_BITS: Int = 32

/// How long one measurement of the CPU's speed lasts: 5 ms of SYSTIMER, which
/// counts at 16 MHz.
static MEASURE_TICKS: UInt64 = 80000
static TICKS_PER_US: UInt64 = 16

/// Wait at least `ticks` of SYSTIMER, which `systimer_start` has started.
///
/// No preemption point: it runs at boot, before anything else.
public func systimer_wait(ticks: UInt64) unsafe {
    let start = systimer_now()
    while systimer_now() - start < ticks { }
}

/// One 32-bit device register.
public func device_word(addr: UInt) unsafe -> UnsafeMemory<UInt32, Device> {
    UnsafeMemory<UInt32, Device>(addr)
}

/// Start SYSTIMER's UNIT0, as the kernel's own timer does later, and take
/// one snapshot that is thrown away: the first handshake after the clock is
/// enabled can take longer than the later ones, and inside a measurement
/// that time would be counted in SYSTIMER's interval and not in CCOUNT's.
public func systimer_start() unsafe {
    let systimer = device_word(SYSTIMER_CONF)
    systimer.write(systimer.read() | SYSTIMER_CLK_EN | SYSTIMER_UNIT0_WORK_EN)
    let _ = systimer_now()
}

/// Keep the console's clock off the CPU's: UART0 clocked by the crystal at
/// 115200, which is what the mask ROM leaves, so on a part this finds
/// SCLK_SEL at the crystal and writes nothing. Any other select is put back
/// to the ROM's words, with the transmitter idle.
public func console_on_crystal(clk_conf: UInt32) unsafe {
    if ((clk_conf >> SCLK_SEL_SHIFT) & SCLK_SEL_MASK) == SCLK_XTAL {
        return
    }
    device_word(UART0_CLK_CONF).write(UART_CLK_CONF_ROM)
    device_word(UART0_CLKDIV).write(UART_CLKDIV_ROM)
}

/// Wait until UART0 has sent every byte it holds, the test the ROM's
/// `uart_tx_wait_idle` makes: the FIFO empty and the transmitter idle.
///
/// No preemption point: it runs once, at boot, before anything else.
public func console_drain() unsafe {
    let status = device_word(UART0_STATUS)
    let fsm = device_word(UART0_FSM_STATUS)
    while {
        let fifo = (status.read() >> TXFIFO_CNT_SHIFT) & TXFIFO_CNT_MASK
        let tx = (fsm.read() >> ST_UTX_OUT_SHIFT) & ST_UTX_OUT_MASK
        if fifo == 0 && tx == 0 {
            break
        }
    }
}

/// SYSTIMER's UNIT0 now.
///
/// No preemption point: the poll waits on a hardware latch.
func systimer_now() unsafe -> UInt64 {
    let op = device_word(SYSTIMER_UNIT0_OP)
    op.write(UNIT0_UPDATE)
    while (op.read() & UNIT0_VALUE_VALID) == 0 { }
    let hi = device_word(SYSTIMER_UNIT0_VALUE_HI).read()
    let lo = device_word(SYSTIMER_UNIT0_VALUE_LO).read()
    ((hi as UInt64) << WORD_BITS) | (lo as UInt64)
}

/// One end of a pass's interval: SYSTIMER's count, then CCOUNT. Both ends
/// run these same instructions, so the time from the snapshot to the CCOUNT
/// read is the same at each and drops out of the difference.
///
/// No preemption point: the snapshot polls a hardware latch.
func cpu_sample() unsafe -> (UInt64, UInt) {
    let ticks = systimer_now()
    (ticks, sos_ccount_read())
}

/// One pass: CCOUNT's advance, and SYSTIMER's over the same interval, at
/// least `MEASURE_TICKS`, as hundredths of a MHz. The division goes through
/// microseconds so every step stays in one word however long a slow host
/// stretches the interval.
func cpu_pass() unsafe -> UInt {
    let start = cpu_sample()
    var end = cpu_sample()
    while end.0 - start.0 < MEASURE_TICKS {
        end = cpu_sample()
    }
    let cycles = (end.1 &- start.1) as UInt
    let us = UInt.from(truncating: (end.0 - start.0) / TICKS_PER_US)
    (cycles / us) * 100 + (cycles % us) * 100 / us
}

/// The CPU's speed in hundredths of a MHz, SYSTIMER having been started by
/// `systimer_start`: two passes back to back, the second the measurement. The
/// first fills the caches with the code it runs from flash, whose first fetch
/// at a slow clock costs a thousand cycles or more and, landing between one
/// end's snapshot and its CCOUNT read, would count against that end alone.
///
/// No preemption point: it runs at boot, before anything else.
public func cpu_centi_mhz() unsafe -> UInt {
    let _ = cpu_pass()
    cpu_pass()
}

/// Write one console byte: wait for room, then store it, as the HAL's console
/// does.
public func write_byte(b: UInt8) unsafe {
    let status = device_word(UART0_STATUS)
    while {
        let count = (status.read() >> TXFIFO_CNT_SHIFT) & TXFIFO_CNT_MASK
        if count < TX_FIFO_DEPTH {
            break
        }
    }
    device_word(UART0_FIFO).write(b as UInt32)
}

public func write_str(s: String) unsafe {
    var i = 0
    while i < s.len() {
        write_byte(s.byte_at(i))
        i += 1
    }
}

/// Write a word as eight hex digits.
public func write_hex(v: UInt32) unsafe {
    var shift: Int = 28
    while shift >= 0 {
        let d = UInt8.from(truncating: (v >> shift) & 0xF)
        write_byte(if d < 10 { d + 48 } else { d + 87 })
        shift -= 4
    }
}

/// Write `v` in decimal, allocating nothing.
func write_decimal(v: UInt) unsafe {
    var digits: [UInt8; 10] = [0; 10]
    var count: Int = 0
    var rest = v
    while {
        digits[count] = UInt8.from(truncating: rest % 10) + 48
        count += 1
        rest = rest / 10
        if rest == 0 {
            break
        }
    }
    while count > 0 {
        count -= 1
        write_byte(digits[count])
    }
}

/// Write hundredths as a decimal with two places.
public func write_centi(v: UInt) unsafe {
    write_decimal(v / 100)
    write_byte(46)
    let frac = v % 100
    write_byte(UInt8.from(truncating: frac / 10) + 48)
    write_byte(UInt8.from(truncating: frac % 10) + 48)
}

// -- The PLL keys ------------------------------------------------------------

/// `sos_pll_bringup`'s answer when the BBPLL reported its calibration done.
static PLL_CAL_DONE: UInt = 0

/// RTC_CNTL_OPTIONS0, whose BB_I2C_FORCE_PD [6], BBPLL_I2C_FORCE_PD [8] and
/// BBPLL_FORCE_PD [10] the bring-up clears. Read for the line.
static RTC_CNTL_OPTIONS0: UInt = 0x6000_8000

/// I2C_MST_ANA_CONF0: the analog master's BBPLL calibration controls
/// (STOP_FORCE_HIGH [2], STOP_FORCE_LOW [3]) and CAL_DONE [24]. Read for the
/// line.
static I2C_MST_ANA_CONF0: UInt = 0x6000_E040

/// The mask ROM's analog-bus functions (esp32s3.rom.ld), windowed, reached
/// through `sos_windowed_call`: `rom_i2c_readReg(block, host, reg)` and
/// `rom_i2c_writeReg_Mask(block, host, reg, msb, lsb, data)`, which ESP-IDF's
/// REGI2C_READ and REGI2C_WRITE_MASK are on this chip.
static ROM_I2C_READ: UInt = 0x4000_5D48
static ROM_I2C_WRITE_MASK: UInt = 0x4000_5D6C

/// The BBPLL's block on the analog bus, its host, and its register 8:
/// OR_CAL_CAP [3:0], OR_CAL_UDF [4], OR_CAL_OVF [5], OR_CAL_END [6] and
/// OR_LOCK [7] (soc/esp32s3/include/soc/regi2c_bbpll.h). Read for the line
/// once the bring-up has run.
static I2C_BBPLL: UInt = 0x66
static I2C_BBPLL_HOSTID: UInt = 1
static I2C_BBPLL_OR_CAL: UInt = 8

/// One register of an analog-bus block, through the ROM.
public func analog_read(block: UInt, host: UInt, reg: UInt) unsafe -> UInt {
    sos_windowed_call(ROM_I2C_READ, block, host, reg, 0, 0, 0)
}

/// Bits `msb` to `lsb` of an analog-bus register set to `data`, through the
/// ROM, which reads the register and writes it back with the field replaced.
public func analog_write_mask(block: UInt, host: UInt, reg: UInt, msb: UInt,
                              lsb: UInt, data: UInt) unsafe {
    let _ = sos_windowed_call(ROM_I2C_WRITE_MASK, block, host, reg, msb, lsb,
                              data)
}

/// What a PLL key found before it moved anything, and what the bring-up
/// left: the words its line prints.
public struct PllStart {
    sysclk_before: UInt32,
    cpu_per_before: UInt32,
    options0_before: UInt32,
    uart_clk: UInt32,
    centi_before: UInt,
    /// Whether the bring-up ran: the CPU was on the crystal. A CPU found on
    /// the PLL keeps it, and the PLL is not brought up again under it.
    brought_up: Bool,
    /// The BBPLL's register 8 after the bring-up.
    bbpll: UInt,
}

/// Why a PLL key leaves the CPU where it found it.
public enum PllNotTaken {
    /// The CPU was found at 240 MHz, and the key runs it slower
    /// (`write_not_lowered`).
    case FoundAt240,
    /// The BBPLL did not report its calibration done within the bring-up's
    /// bound.
    case CalibrationNotDone
}

/// The first half of a PLL key, `name` its line's name, `period` the
/// CPUPERIOD_SEL it switches to, and `found` the clock words it read first:
/// a key below 240 MHz handed a CPU at 240 stops before it writes anything
/// (`write_not_lowered`). Then the speed measured, the console drained and
/// held on the crystal, and, from the crystal, the BBPLL powered and set to
/// 480 MHz (`sos_pll_bringup`, `../../kernel/boot.S`; ESP-IDF's
/// `rtc_clk_bbpll_enable` and `rtc_clk_bbpll_configure`). From RC_FAST, or a
/// select no source names, it prints why and stops in a quiet loop before
/// any clock word is written (SYSTIMER is already counting). When the
/// calibration is not reported done it prints the `not taken` line and
/// answers so: nothing switches to the PLL.
public func pll_bring_up(name: String, period: UInt32,
                         found: ClockWords) unsafe -> Result<PllStart,
                                                             PllNotTaken> {
    if period != CPUPERIOD_240M && at_240(found) {
        write_not_lowered(name, found)
        return PllNotTaken.FoundAt240
    }
    let sysclk = device_word(SYSCLK_CONF)
    let options0 = device_word(RTC_CNTL_OPTIONS0)
    let sysclk_before = found.sysclk
    let cpu_per_before = found.cpu_per
    let options0_before = options0.read()
    let uart_clk = device_word(UART0_CLK_CONF).read()
    systimer_start()
    let centi_before = cpu_centi_mhz()

    let source = (sysclk_before >> SOC_CLK_SEL_SHIFT) & SOC_CLK_SEL_MASK
    if source != SOC_CLK_SEL_XTAL && source != SOC_CLK_SEL_PLL {
        write_str("SOS-S3: clock ")
        write_str(name)
        write_str(" refused: sysclk=0x")
        write_hex(sysclk_before)
        write_str(": the switch is taken from the crystal or the PLL\n")
        while { }
    }

    console_drain()
    console_on_crystal(uart_clk)
    let brought_up = source == SOC_CLK_SEL_XTAL
    var bbpll: UInt = 0
    if brought_up {
        if sos_pll_bringup() != PLL_CAL_DONE {
            write_str("SOS-S3: clock ")
            write_str(name)
            write_str(" not taken: the BBPLL did not ")
            write_str("report its calibration done; the CPU stays on the ")
            write_str("crystal sysclk=0x")
            write_hex(sysclk.read())
            write_str(" options0=0x")
            write_hex(options0_before)
            write_str("->0x")
            write_hex(options0.read())
            write_str(" ana_conf0=0x")
            write_hex(device_word(I2C_MST_ANA_CONF0).read())
            write_str(" mhz=")
            write_centi(centi_before)
            write_byte(10)
            return PllNotTaken.CalibrationNotDone
        }
        bbpll = analog_read(I2C_BBPLL, I2C_BBPLL_HOSTID, I2C_BBPLL_OR_CAL)
    }
    PllStart(sysclk_before: sysclk_before, cpu_per_before: cpu_per_before,
             options0_before: options0_before, uart_clk: uart_clk,
             centi_before: centi_before, brought_up: brought_up, bbpll: bbpll)
}

/// The second half of a PLL key: the CPU moved onto the PLL at the division
/// `period` (CPUPERIOD_SEL: 0 for 80 MHz, 1 for 160, 2 for 240), then the
/// speed measured and the key's line printed up to its end, which the caller
/// writes. The three stores are `rtc_clk_cpu_freq_to_pll_mhz`'s
/// (esp_hw_support/port/esp32s3/rtc_clk.c): CPUPERIOD_SEL, PRE_DIV_CNT 0,
/// SOC_CLK_SEL 1, in that order, each a store of its own from IRAM.
/// CPU_PER_CONF is read again because the bring-up set its PLL_FREQ_SEL.
public func pll_switch(name: String, start: PllStart, period: UInt32) unsafe {
    let sysclk = device_word(SYSCLK_CONF)
    let cpu_per = device_word(CPU_PER_CONF)
    let periodic = (cpu_per.read() & ~CPUPERIOD_SEL_MASK) | period
    sos_clock_store(CPU_PER_CONF, periodic as UInt)
    let divided = start.sysclk_before & ~PRE_DIV_CNT_MASK
    sos_clock_store(SYSCLK_CONF, divided as UInt)
    let on_pll = ((divided & ~(SOC_CLK_SEL_MASK << SOC_CLK_SEL_SHIFT))
                  | (SOC_CLK_SEL_PLL << SOC_CLK_SEL_SHIFT))
    sos_clock_store(SYSCLK_CONF, on_pll as UInt)
    let sysclk_after = sysclk.read()
    let cpu_per_after = cpu_per.read()
    let centi_after = cpu_centi_mhz()

    write_str("SOS-S3: clock ")
    write_str(name)
    write_str(" sysclk=0x")
    write_hex(start.sysclk_before)
    write_str("->0x")
    write_hex(sysclk_after)
    write_str(" cpu_per=0x")
    write_hex(start.cpu_per_before)
    write_str("->0x")
    write_hex(cpu_per_after)
    write_str(" options0=0x")
    write_hex(start.options0_before)
    write_str("->0x")
    write_hex(device_word(RTC_CNTL_OPTIONS0).read())
    if start.brought_up {
        write_str(" bbpll=0x")
        write_hex(start.bbpll as UInt32)
    } else {
        write_str(" bbpll=kept")
    }
    write_str(" ana_conf0=0x")
    write_hex(device_word(I2C_MST_ANA_CONF0).read())
    write_str(" mhz=")
    write_centi(start.centi_before)
    write_str("->")
    write_centi(centi_after)
    write_str(" uart_clk=0x")
    write_hex(start.uart_clk)
    write_str(" mspi_core=0x")
    write_hex(device_word(SPI0_CORE_CLK_SEL).read())
    write_str(" mspi_clock=0x")
    write_hex(device_word(SPI0_CLOCK).read())
    write_str(" rtc_date=0x")
    write_hex(device_word(RTC_CNTL_DATE).read())
}

// -- The PLL keys that set the LDOs ------------------------------------------

/// I2C_DIG_REG on the analog bus, its host, and the two registers written:
/// EXT_RTC_DREG and EXT_DIG_DREG, each in bits [4:0] of its register
/// (soc/esp32s3/include/soc/regi2c_dig_reg.h).
static I2C_DIG_REG: UInt = 0x6D
static I2C_DIG_REG_HOSTID: UInt = 1
static EXT_RTC_DREG: UInt = 4
static EXT_DIG_DREG: UInt = 6
static DREG_MSB: UInt = 4
static DREG_LSB: UInt = 0
static DREG_MASK: UInt = 0x1F

/// `esp_rom_delay_us(40)`, in SYSTIMER's 16 MHz ticks.
static LDO_SETTLE_TICKS: UInt64 = 40 * 16

/// ESP-IDF's four LDO settings for this part: the eFuse's four calibration
/// words read, and `rtc_set_stored_dbias`'s arithmetic over them
/// (`s3dbias`, `../../dbias/`). The eFuse is only read.
public func efuse_dbias() unsafe -> Dbias {
    let words = EfuseWords(
        sys3: device_word(EFUSE_BASE + EFUSE_SYS_3).read(),
        sys4: device_word(EFUSE_BASE + EFUSE_SYS_4).read(),
        sys5: device_word(EFUSE_BASE + EFUSE_SYS_5).read(),
        part1_data4: device_word(EFUSE_BASE + EFUSE_PART1_DATA4).read())
    stored_dbias(Calibration(words: words))
}

/// One LDO setting as it reads now.
func dreg(reg: UInt) unsafe -> UInt {
    analog_read(I2C_DIG_REG, I2C_DIG_REG_HOSTID, reg) & DREG_MASK
}

/// A PLL key that sets both LDOs before it moves the CPU's clock, `name` its
/// line's name: `rtc` and `dig` are the pair of `dbias` it writes, `period`
/// its CPUPERIOD_SEL and `found` the clock words it read first. In order:
///
///   * `dbias` held to the range ESP-IDF's arithmetic gives it
///     (`check_dbias`). Out of it, a line says so, nothing is written, and
///     the boot goes on at the clock found;
///   * `pll_bring_up`, with its two stops;
///   * EXT_RTC_DREG [4:0] = `rtc`, then EXT_DIG_DREG [4:0] = `dig`, each
///     through the mask ROM's `rom_i2c_writeReg_Mask`, which ESP-IDF's
///     REGI2C_WRITE_MASK is: the order of `rtc_init` (rtc_init.c) and of
///     `rtc_clk_cpu_freq_to_pll_mhz` (rtc_clk.c);
///   * 40 us of SYSTIMER for the voltage to settle, the wait
///     `rtc_clk_cpu_freq_to_pll_mhz` makes after it moves an LDO;
///   * `pll_switch` at `period`, and the line's LDO words.
public func pll_ldo_switch(name: String, dbias: Dbias, rtc: UInt32,
                           dig: UInt32, period: UInt32,
                           found: ClockWords) unsafe {
    try check_dbias(dbias) catch {
        write_str("SOS-S3: clock ")
        write_str(name)
        write_str(" not taken: the LDO settings are outside ESP-IDF's range; ")
        write_str("nothing is written ldo=")
        write_str(dbias.source.name())
        write_str(" dig=0x")
        write_hex(dig)
        write_str(" rtc=0x")
        write_hex(rtc)
        write_byte(10)
        return
    }
    let start = try pll_bring_up(name, period, found) catch { return }

    let rtc_before = dreg(EXT_RTC_DREG)
    let dig_before = dreg(EXT_DIG_DREG)
    analog_write_mask(I2C_DIG_REG, I2C_DIG_REG_HOSTID, EXT_RTC_DREG, DREG_MSB,
                      DREG_LSB, rtc as UInt)
    analog_write_mask(I2C_DIG_REG, I2C_DIG_REG_HOSTID, EXT_DIG_DREG, DREG_MSB,
                      DREG_LSB, dig as UInt)
    systimer_wait(LDO_SETTLE_TICKS)
    let rtc_after = dreg(EXT_RTC_DREG)
    let dig_after = dreg(EXT_DIG_DREG)

    pll_switch(name, start, period)
    write_str(" ldo=")
    write_str(dbias.source.name())
    write_str(" dig=0x")
    write_hex(dig)
    write_str(" rtc=0x")
    write_hex(rtc)
    write_str(" ext_dig_dreg=0x")
    write_hex(dig_before as UInt32)
    write_str("->0x")
    write_hex(dig_after as UInt32)
    write_str(" ext_rtc_dreg=0x")
    write_hex(rtc_before as UInt32)
    write_str("->0x")
    write_hex(rtc_after as UInt32)
    write_byte(10)
}
