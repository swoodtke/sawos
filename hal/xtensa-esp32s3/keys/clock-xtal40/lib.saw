//! The clock key `xtal40`: the CPU on the 40 MHz crystal with its pre-divider
//! at 1, the crystal undivided.
//!
//! One of the `s3clock` modules, mapped by a case's `clock` (the runner) or an
//! image's `[keys]` (`sosimage`). The HAL re-exports its `clock_init`, which
//! `kmain` calls first, before anything prints or is timed
//! (`../../kernel/lib.saw`). `../../ABI.md` §14 has the sequence ESP-IDF runs
//! for every speed, the source of each step, and which of it this takes.
//!
//! The switch is ESP-IDF's `rtc_clk_cpu_freq_to_xtal(40, 1)`: SYSCLK_CONF's
//! pre-divider to 1, then its source to the crystal. Each store that moves
//! the CPU's clock is made by `sos_clock_store` from IRAM (`../../kernel/
//! boot.S`), so no instruction is fetched through the flash cache while the
//! clock, and with it the memory-SPI clock, moves. What a clock change could
//! carry with it:
//!
//!   * the console: the mask ROM clocks UART0 from the crystal (its
//!     `Uart_Init` writes SCLK_SEL 3 and the divisor from 40 MHz), which this
//!     does not move, so the divisor stays right. The switch waits for the
//!     transmitter to go idle first, and puts a console found on another
//!     clock back on the ROM's words before it moves anything;
//!   * SYSTIMER counts the crystal at 16 MHz whatever the CPU runs at;
//!   * the flash: no memory-SPI register is written; ABI.md §14 says what the
//!     flash's clock is under each reading of the core clock;
//!   * the watchdogs clocked from APB are off (`boot.S`'s `_start`).
//!
//! Every word written here is volatile: a chip reset (power, or the EN pin
//! esptool and the board's reset button pull) puts it back. A CPU found at
//! 240 MHz is left there with a line that says so, and nothing is written.
//!
//! The line it prints is the record a board run needs: the two clock words
//! before and after, the CPU's speed measured before and after (CCOUNT over a
//! fixed SYSTIMER interval), and the words a clock change could move: UART0's
//! clock, the memory-SPI core clock's select and the flash's divider, and the
//! RTC word holding the LDO slaves.
//!
//! It reaches every register through its own views and `s3clockkit`'s
//! (`../clock-common/`) rather than the HAL's drivers: the HAL names nothing
//! here, so an image built at the `rom` key is the bytes it would be without
//! the keys.

import s3clockkit.{SYSCLK_CONF, SOC_CLK_SEL_SHIFT, SOC_CLK_SEL_MASK,
                   SOC_CLK_SEL_XTAL, SOC_CLK_SEL_PLL, PRE_DIV_CNT_MASK,
                   CPU_PER_CONF, UART0_CLK_CONF, SPI0_CORE_CLK_SEL, SPI0_CLOCK,
                   RTC_CNTL_DATE, ClockWords, at_240, clock_words,
                   write_not_lowered, device_word, systimer_start,
                   console_on_crystal, console_drain, cpu_centi_mhz,
                   write_byte, write_str, write_hex, write_centi}

extern "C" {
    func sos_clock_store(addr: UInt, value: UInt)
}

/// Set the CPU clock this image is built for: the crystal, undivided. From
/// RC_FAST, or a select no source names, it prints why and stops in a quiet
/// loop before any clock word is written (SYSTIMER is already counting).
public func clock_init() unsafe {
    clock_init_found(clock_words())
}

/// `clock_init` on a CPU whose clock words read `found`. A CPU found at 240
/// MHz is left there, before anything is written (`write_not_lowered`):
/// ESP-IDF's `rtc_clk_cpu_freq_to_xtal` lowers both LDOs once it has left
/// 240, and this key sets no LDO.
public func clock_init_found(found: ClockWords) unsafe {
    if at_240(found) {
        write_not_lowered("xtal40", found)
        return
    }
    let sysclk = device_word(SYSCLK_CONF)
    let cpu_per = device_word(CPU_PER_CONF)
    let sysclk_before = found.sysclk
    let cpu_per_before = found.cpu_per
    let uart_clk = device_word(UART0_CLK_CONF).read()
    systimer_start()
    let centi_before = cpu_centi_mhz()

    let source = (sysclk_before >> SOC_CLK_SEL_SHIFT) & SOC_CLK_SEL_MASK
    if source != SOC_CLK_SEL_XTAL && source != SOC_CLK_SEL_PLL {
        write_str("SOS-S3: clock xtal40 refused: sysclk=0x")
        write_hex(sysclk_before)
        write_str(": the switch is taken from the crystal or the PLL\n")
        while { }
    }

    console_drain()
    console_on_crystal(uart_clk)
    // The pre-divider moves the CPU's clock only when the crystal is already
    // the source, and then the second store is not made.
    let divided = sysclk_before & ~PRE_DIV_CNT_MASK
    sos_clock_store(SYSCLK_CONF, divided as UInt)
    if source != SOC_CLK_SEL_XTAL {
        let on_crystal = divided & ~(SOC_CLK_SEL_MASK << SOC_CLK_SEL_SHIFT)
        sos_clock_store(SYSCLK_CONF, on_crystal as UInt)
    }
    let sysclk_after = sysclk.read()
    let cpu_per_after = cpu_per.read()
    let centi_after = cpu_centi_mhz()

    write_str("SOS-S3: clock xtal40 sysclk=0x")
    write_hex(sysclk_before)
    write_str("->0x")
    write_hex(sysclk_after)
    write_str(" cpu_per=0x")
    write_hex(cpu_per_before)
    write_str("->0x")
    write_hex(cpu_per_after)
    write_str(" mhz=")
    write_centi(centi_before)
    write_str("->")
    write_centi(centi_after)
    write_str(" uart_clk=0x")
    write_hex(uart_clk)
    write_str(" mspi_core=0x")
    write_hex(device_word(SPI0_CORE_CLK_SEL).read())
    write_str(" mspi_clock=0x")
    write_hex(device_word(SPI0_CLOCK).read())
    write_str(" rtc_date=0x")
    write_hex(device_word(RTC_CNTL_DATE).read())
    write_byte(10)
}

/// The clock words this key leaves on the part, as the PSRAM bring-up's S0.3
/// compares them: SYSTEM_SYSCLK_CONF & 0x80FFF, SYSTEM_CPU_PER_CONF & 7 and
/// SPI_MEM_CORE_CLK_SEL & 3, from the part's `sysclk` 0x000a8000, `cpu_per`
/// 0x0000000c and `mspi_core` 0 (../../ABI.md §14h, §16b).
public static PART_SYSCLK: UInt32 = 0x0008_0000
public static PART_CPU_PER: UInt32 = 0x4
public static PART_CORE_CLK_SEL: UInt32 = 0

/// The memory-SPI core clock this key leaves, in MHz: the CPU's own clock, the
/// crystal (../../ABI.md §16b).
public static MSPI_CORE_MHZ: UInt = 40
