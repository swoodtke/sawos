//! The QEMU `virt` board HAL, Saw half: riscv32, M-mode.
//!
//! This is the board half only. Everything architectural (trap frame, cause
//! decoding, syscall accessors, the PMP staging apparatus, the payload/region
//! linker seams and the protection budget) lives in `rv32core`
//! (`hal/riscv32-common/kernel/`), shared with every riscv32 board, and is
//! re-exported below so that `kcore` sees one `hal` surface. What is left
//! here makes this machine this machine: an NS16550A console, the SiFive test
//! finisher, the CLINT, the PLIC, and where RAM is.
//!
//! The kernel core above (`kernel/core/`) names no architecture. It reaches the
//! board, the privilege transition and the memory-protection hardware only
//! through the surface below, which `hal/arm64/kernel/` implements the same way
//! for Profile B. `ABI.md` beside this file is the contract; `boot.S` is the
//! part of it that cannot be Saw, and `sink.c` is shared from the common
//! directory.
//!
//! Addresses and machine words are `UInt` throughout, never `Int`. On this
//! target `Int` is 32-bit signed, so a RAM address like 0x8020_0000 lands in
//! its negative half.

// The arch-free half of the console and the stop: the sink trait this file's
// UART conforms to, the one write loop over it, and the exit-status promotion
// shared by every HAL.
import sosrt.{ConsoleSink, console_write, abort_status}

// The `hal` seam, re-exported. `kernel/core` imports the module named `hal` and
// reaches every one of these through it; they live in `rv32core` because they
// are facts about riscv32 rather than about this board, and this line keeps
// that invisible from above.
public import rv32core.{
    arch_tag, cause_tag, device_window_ok, fp_switch_in, fp_switch_out, fp_trap,
    FRAME_BYTES, frame_init,
    GRANT_ROW_BUDGET, image_link_base, IRQ_NONE, IRQ_TIMER, is_interrupt,
    is_syscall, map_place,
    MAX_ROOT_SEGMENTS, payload_end, payload_start, phys_to_virt, prot_clear,
    prot_commit,
    prot_device, PROT_DOMAIN_SLOTS, PROT_GRAIN, prot_region,
    prot_reset, prot_switch, prot_update,
    region_table_end, region_table_start,
    resume_frame, same_bytes, segment_bus_ok,
    syscall_arg0, syscall_arg1, syscall_arg2, syscall_handle,
    syscall_op, syscall_return, trap_pc, virt_to_phys,
}

// What this file needs from the shared core and `kcore` does not: the cause
// word's interrupt flag and its architectural codes, which this board's
// `irq_claim` decodes against the PLIC, and the machine word width its split
// 64-bit timer registers are halves of.
import rv32core.{INTERRUPT_FLAG, InterruptCause, WORD_BITS}

// The two C leaves this board calls. The rest of `sink.c`'s surface is
// declared in `rv32core`, which calls it; an `extern` carries no visibility and
// cannot be re-exported, so the block is split by caller and the two halves
// name disjoint symbols.
extern "C" {
    func sos_mie_write(mask: UInt)
    func sos_wait_for_irq()
}

// =============================================================================
// NS16550A UART
// =============================================================================

/// The NS16550A register block. Registers are byte-spaced; the struct's natural
/// declaration-order layout places each at its hardware offset. A `ReadOnly<T>`
/// field exposes only `.read()`; a plain field is read-write.
struct UartRegs {
    thr: UInt8,             // +0  transmit holding / receive buffer
    ier: UInt8,             // +1  interrupt enable
    iir: UInt8,             // +2  interrupt id / FIFO control
    lcr: UInt8,             // +3  line control
    mcr: UInt8,             // +4  modem control
    lsr: ReadOnly<UInt8>,   // +5  line status
    msr: ReadOnly<UInt8>,   // +6  modem status
    scr: UInt8,             // +7  scratch
}

/// The console driver. A safe type (unsafety is not transitive): only the
/// methods reaching through `regs` carry the `unsafe` effect.
struct Uart16550 {
    regs: UnsafeMemory<UartRegs, Device>,
}

extension Uart16550 {
    init(at: UInt) unsafe -> Uart16550 {
        Uart16550(regs: UnsafeMemory<UartRegs, Device>(at))
    }
}

/// The two register touches, and nothing else. The transmitter is polled, and
/// every access is a volatile Device load/store.
///
/// `write_byte` and the panic path's write loop are `sosrt`'s, generic over
/// this conformance and monomorphized here. What makes a 16550 a 16550 is the
/// pair below: TX holding register empty is LSR bit 5 set, and the byte goes
/// to THR.
extension Uart16550: ConsoleSink {
    func can_write(&self) unsafe -> Bool {
        (self.regs.lsr.read() & LSR_TX_EMPTY) != 0
    }

    func put(&self, b: UInt8) unsafe {
        self.regs.thr.write(b)
    }
}

// =============================================================================
// SiFive test finisher (QEMU `virt`)
// =============================================================================

struct SifiveTestRegs {
    finisher: UInt32,
}

/// Writing FINISHER_PASS exits the emulator with status 0; FINISHER_FAIL
/// carries an exit code in its upper half. (`boot.S`'s `kernel_fault` drives
/// the same device from assembly.)
struct SifiveTest {
    regs: UnsafeMemory<SifiveTestRegs, Device>,
}

extension SifiveTest {
    init(at: UInt) unsafe -> SifiveTest {
        SifiveTest(regs: UnsafeMemory<SifiveTestRegs, Device>(at))
    }
}

// =============================================================================
// Board constants
// =============================================================================

static UART_BASE: UInt = 0x1000_0000
static TEST_BASE: UInt = 0x0010_0000
static LSR_TX_EMPTY: UInt8 = 0x20        // LSR bit 5 — TX holding register empty
static IER_TX_EMPTY: UInt8 = 0x02        // IER bit 1 — interrupt when TX is empty
static FINISHER_PASS: UInt32 = 0x5555
static FINISHER_FAIL: UInt = 0x3333
static FAIL_CODE_SHIFT: Int = 16

/// The core-local timer, whose comparator this hart's periodic tick comes from.
/// The counter is at its own address rather than at an offset from the
/// comparator: they are far apart in this block, so they are two views.
static TIMER_CMP_BASE: UInt = 0x0200_4000
static TIMER_COUNT_BASE: UInt = 0x0200_BFF8
/// The board's timebase, as counter units per microsecond: 10 MHz on this
/// machine (`timebase-frequency` in its device tree). No register holds it; it
/// is a property of the board.
static TIMER_UNITS_PER_US: UInt = 10

/// Nanoseconds per counter unit: the timebase above, inverted, because the seam
/// speaks nanoseconds and this counter does not. It divides exactly (10 MHz is
/// 100 ns a tick), so no resolution is lost.
static NS_PER_UNIT: UInt64 = 100

/// The platform interrupt controller, in the four windows this kernel uses.
/// The context is the one this hart takes interrupts in; the second context
/// this board wires is for a privilege mode SOS does not run in.
static PLIC_PRIORITY_BASE: UInt = 0x0C00_0000
static PLIC_ENABLE_BASE: UInt = 0x0C00_2000
static PLIC_CONTEXT_BASE: UInt = 0x0C20_0000
/// Sources this board wires (`riscv,ndev`). Source 0 is reserved as "no
/// source", which is what a claim returns when it has nothing to give.
static PLIC_MAX_SOURCE: UInt = 95
/// The line the board's console sits on: the one device this kernel can make
/// interrupt on demand, which is what `irq_raise_selftest_line` spends.
static CONSOLE_IRQ: UInt = 10

// =============================================================================
// Identity
// =============================================================================

// The two tier facts are functions, not `static`s, and that is forced. A
// module-level `static` does not carry module identity the way a free function
// does: two modules in one compilation unit cannot both declare
// `PROT_ISOLATED`, while both may declare `prot_isolated()` and each caller
// gets its own. A build profile is a module that overrides part of another's
// seam (`hal/riscv32-flat` re-exports this board's whole device half and
// answers differently about protection), so a seam value a profile may need to
// override cannot be a `static`. The other HAL constants (`PROT_GRAIN`,
// `GRANT_ROW_BUDGET`, `FRAME_BYTES`, the memory map) stay `static`s because
// nothing overrides them.
//
// Both fold anyway (a leaf returning a literal inlines), so `load_domain`'s
// replay loop still compiles away where it is dead.

/// Whether this profile rebuilds its protection image at every switch. It does:
/// the PMP replay in `load_domain` is the switch here, which is why
/// `prot_switch` is empty.
public func prot_replay_at_switch() -> Bool { true }

/// Whether this platform can deny. It can. This is the tier word, the only
/// protection fact that reaches userspace: `kernel/core` maps it to
/// `sosabi.ProtectionTier` and `SystemOp.TierGet` hands the word out, where a
/// program that relies on isolation reads it once and refuses to run if it
/// reads `Flat`.
///
/// It answers a `Bool` and not that enum because the dependency order forbids
/// the enum here (a board's `lib.saw` imports `sosrt`, never `sosabi`).
///
/// It is a claim about the hardware, not about the `prot_*` bodies. `true`
/// promises that an access a process was not granted faults, which on this
/// board is RISC-V's default-deny rule: the kernel, the UART and the finisher
/// are locked away from root by saying nothing about them.
public func prot_isolated() -> Bool { true }

/// What this kernel says it is booting on, for the banner.
public func arch_name() -> String {
    "riscv32 (QEMU virt)"
}

// =============================================================================
// Console
// =============================================================================

/// Write one byte to the kernel's console.
///
/// The kernel owns the machine, so this is the UART directly. Byte-at-a-time is
/// what the seam needs: the arch-free half above formats, this half places.
///
/// The handover protocol's device half (the protocol itself is stated on
/// `kcore`'s `Console`). This board has one UART and a driver process may be
/// granted its page, so after the handover marker there can be a second writer
/// on this device. The two writers share the transmit holding register and the
/// line-status bit this loop polls, so a byte written here between two of the
/// process's lands between them: interleaved, never lost or corrupted, since
/// each write is one register store guarded by its own poll. The kernel's
/// diagnostic paths therefore stay usable after handover, and the protocol
/// keeps them from being noise on a transcript that is still being written.
///
/// The console path never touches the receive side or the interrupt-enable
/// register: the transmitter is polled here, so a driver that owns receive owns
/// it alone. (`irq_raise_selftest_line` writes the interrupt-enable register,
/// for interrupt bring-up only.)
public func console_byte(b: UInt8) unsafe {
    Uart16550(at: UART_BASE).write_byte(b)
}

// =============================================================================
// Stopping the machine
// =============================================================================

/// Terminate the emulator with status 0. Never returns; if the write is somehow
/// ignored, spin rather than fall back into the caller.
public func exit_pass() unsafe {
    SifiveTest(at: TEST_BASE).regs.finisher.write(FINISHER_PASS)
    while true { }
}

/// Terminate the emulator with a non-zero status.
///
/// What status is `sosrt.abort_status`'s call: a zero code would make the
/// finisher report success, and the rule that a failing exit never reads as a
/// passing one is decided once, for every board. How to stop is this file's:
/// the SiFive test finisher takes the code in its upper half.
public func exit_fail(code: UInt) unsafe {
    SifiveTest(at: TEST_BASE).regs.finisher.write(
        (FINISHER_FAIL | (abort_status(code) << FAIL_CODE_SHIFT)) as UInt32)
    while true { }
}

// =============================================================================
// The runtime's two hooks
// =============================================================================
//
// `sosrt` (rt/common/src/lib.saw) implements the frozen `__saw_rt_*` seams over
// exactly two per-side hooks: where a byte goes, and how the machine stops. The
// kernel HAL answers "the UART" and "the test finisher". Both stay on the board
// side because both name the board's own device.

/// Stop the machine with a non-zero status, for the common runtime.
///
/// The promote-zero rule lives in `exit_fail`, so this is the seam name and
/// nothing else.
///
/// `-> Never` states in the type what `sosrt` declares this hook to be.
/// `exit_fail` diverges on its own (it spins if the finisher write is somehow
/// ignored) but is typed `Void`, so the trailing loop carries the promise up to
/// this signature.
@export("sos_rt_abort")
public func rt_abort(code: UInt32) unsafe -> Never {
    exit_fail(code as UInt)
    while { }
}

/// Write `len` bytes at `ptr` to the console. The panic path's writer.
///
/// The loop is `sosrt.console_write`, shared by every board; its check-freedom
/// contract and the machine code that shows it are stated there. This file
/// supplies the device it walks. On this instantiation the `-Oz` machine code
/// is a byte loop calling `write_byte` directly, and neither has an overflow
/// check, a bounds check, a trap or a call to `__saw_rt_panic`, so a panic
/// inside the panic reporter is unreachable.
@export("sos_rt_write")
public func rt_write(ptr: UnsafePointer<Int8>, len: UInt) unsafe {
    let sink = Uart16550(at: UART_BASE)
    console_write(&sink, ptr, len)
}

// =============================================================================
// This board's memory map
// =============================================================================

/// Where RAM is on this board, and how much of it there is: the window
/// `map_target_ok` judges a RAM mapping against.
///
/// QEMU's `virt` machine places RAM at this base and gives it 128 MiB by
/// default, which is what the harness runs. It is stated here rather than
/// derived because nothing on this profile publishes it: the linker script
/// knows where the kernel is, not where memory ends.
public static RAM_BASE: UInt = 0x8000_0000
public static RAM_TOP: UInt = 0x8800_0000

/// May `[base, top)` be installed as a RAM row in a user domain?
///
/// Both profiles have addresses a grant cannot express, and the loader stops
/// the machine on one, since a memory map that outgrew the hardware is a kernel
/// bug. A `map()` is different: the range comes from a region a process chose,
/// so an unmappable one is a caller error, and the kernel must answer `BadArg`
/// at the op rather than die inside the protection primitive.
///
/// On this profile a PMP entry can name any address, so the predicate accepts
/// everything in RAM. That is not vacuous: it refuses a map of a device window
/// through the RAM door, and a region whose bounds have wrapped.
///
/// Board-side, unlike its `device_window_ok` sibling: the granularity rule is
/// PMP's and is shared, but where RAM is belongs to this machine alone.
public func map_target_ok(base: UInt, top: UInt) -> Bool {
    base < top && base >= RAM_BASE && top <= RAM_TOP
}

/// May `[base, top)` be handed to a user domain as physical backing?
///
/// The same body as `map_target_ok`, which is the tier split in one file. The
/// two questions are which input addresses a domain may use and which output
/// frames it may reach; on a machine that does not translate they are the same
/// question, because there is only one address. The arm64 HAL answers them
/// differently (a 4 MiB grant window against 128 MiB of RAM). The two
/// predicates are deliberately identical rather than one forwarding to the
/// other, so each states its own question where a reader of either finds it.
public func map_source_ok(base: UInt, top: UInt) -> Bool {
    base < top && base >= RAM_BASE && top <= RAM_TOP
}

/// Root's region on this board (mirrored by the root linker script and recorded
/// in `virt.ld`'s memory map). Segments load from the base; the stack occupies
/// the top `ROOT_STACK_LEN` bytes.
public static ROOT_LOAD_BASE: UInt = 0x8020_0000
public static ROOT_REGION_TOP: UInt = 0x8024_0000
public static ROOT_STACK_LEN: UInt = 0x4000

/// The one device window this board offers a process: the console UART's page.
///
/// A page, not the register block. The eight registers occupy eight bytes, but
/// this board's emulator only puts an access on its fast path when the
/// protection region covers a whole aligned page, and a byte-tight region makes
/// user mode far slower. A driver's register touch is the hottest thing in an
/// interrupt path, so the grant is page-aligned and page-sized and the extra
/// bytes belong to nothing.
///
/// A page is also what lets one NAPOT entry express the window: a naturally
/// aligned power-of-two region is one PMP entry rather than a TOR pair.
public static DEVICE_GRANT_BASE: UInt = UART_BASE
public static DEVICE_GRANT_LEN: UInt = 0x1000

static_assert(DEVICE_GRANT_LEN >= PROT_GRAIN,
              "a device window cannot be finer than the protection grain")
static_assert((DEVICE_GRANT_BASE % DEVICE_GRANT_LEN) == 0,
              "a NAPOT region must be aligned to its own size")

/// An address the kernel itself cannot reach on this target: nothing is there
/// and nothing maps it. The harness's kernel-fault case reads it to prove a
/// fault taken in kernel mode is diagnosed rather than hung on. It is
/// per-target because "unmapped" is: on a profile whose kernel runs with an MMU
/// on, low addresses are the device window and reading one succeeds.
public static UNMAPPED_PROBE: UInt = 0x0000_0000

// =============================================================================
// Which sources may interrupt this hart
// =============================================================================
//
// Two masks stand between a device and this kernel, and they are not
// interchangeable. This one is the hart's: one bit per interrupt class (timer,
// external), and it is what makes a class reachable at all. The PLIC's, below,
// is per source within the external class.
//
// The global enable is deliberately never set. This hart delivers a machine
// interrupt to a lower privilege mode unconditionally, and to itself only with
// the global bit set, so leaving that bit clear forever means interrupts are
// taken from user mode only. The kernel needs no critical sections and the trap
// path needs no epilogue; a wrongly-arrived interrupt lands on `trap.S`'s
// kernel-bug path, a diagnosed stop rather than a silent reentry.
//
// The class shadow is board-side: on this board the tags below are `mie` bit
// positions and the shadow is literally what gets written, while the C3's
// matrix gates everything through one bit and makes them software tags.

/// The class mask, staged here because the register it mirrors is written
/// through a C leaf and reading it back would cost a second one. Compound
/// global state on a serialization argument the compiler cannot see:
/// uniprocessor, and its one writer, `irq_class_enable`, runs in the kernel
/// with interrupts masked (at bring-up and from `timer_set_deadline_ns`).
unsafe static var IRQ_CLASSES: UInt = 0

/// Class bits, by their architectural positions.
static IRQ_CLASS_TIMER: UInt = 0x80         // bit 7
static IRQ_CLASS_EXTERNAL: UInt = 0x800     // bit 11

/// Let a class of interrupt reach this hart.
func irq_class_enable(bit: UInt) unsafe {
    IRQ_CLASSES = IRQ_CLASSES | bit
    sos_mie_write(IRQ_CLASSES)
}

// =============================================================================
// The machine timer
// =============================================================================
//
// The periodic tick comes from the core-local timer: a free-running 64-bit
// counter and a per-hart comparator, both ordinary MMIO, so all of it is Saw.
//
// The condition is a level, not an edge: the timer asserts while the counter is
// at or past the comparator. Servicing a fire therefore means programming the
// next deadline rather than acknowledging one, since writing a comparator in
// the future is what lowers the line. That is why the seam is
// `timer_set_deadline_ns` and why `irq_complete` has nothing to do for this
// line.
//
// One comparator, two customers: the scheduler tick and the Timer objects share
// this hardware. The seam is absolute rather than periodic so that sharing is
// the kernel's arithmetic; it programs the earliest deadline of the two and
// this file never learns there were two.
//
// The counter is 64 bits on a 32-bit machine, and each half is its own
// register. A read has to survive a carry between the halves, and a write has
// to avoid the instant where the halves describe a deadline that is neither the
// old one nor the new one.

/// The comparator, low half first.
struct TimerCmpRegs {
    lo: UInt32,
    hi: UInt32,
}

/// The counter, same shape and read-only.
struct TimerCountRegs {
    lo: ReadOnly<UInt32>,
    hi: ReadOnly<UInt32>,
}

/// The driver: this hart's comparator, and the counter it is compared against.
struct MachineTimer {
    cmp: UnsafeMemory<TimerCmpRegs, Device>,
    count: UnsafeMemory<TimerCountRegs, Device>,
}

extension MachineTimer {
    init() unsafe -> MachineTimer {
        MachineTimer(cmp: UnsafeMemory<TimerCmpRegs, Device>(TIMER_CMP_BASE),
                     count: UnsafeMemory<TimerCountRegs, Device>(TIMER_COUNT_BASE))
    }

    /// The counter, read carry-safely: the high half is read either side of the
    /// low one, and a carry between the two reads is retried. Without this a
    /// read that straddled a carry would be off by 2^32 counter units, about
    /// seven minutes here.
    ///
    /// No preemption point: the retry is bounded by one carry, and this is
    /// reached from the delivery path anyway.
    func now(&self) unsafe -> UInt64 {
        var hi = self.count.hi.read()
        var lo = self.count.lo.read()
        var hi2 = self.count.hi.read()
        while hi != hi2 {
            hi = hi2
            lo = self.count.lo.read()
            hi2 = self.count.hi.read()
        }
        (((hi as UInt64) << WORD_BITS) | (lo as UInt64))
    }

    func deadline(&self) unsafe -> UInt64 {
        (((self.cmp.hi.read() as UInt64) << WORD_BITS)
         | (self.cmp.lo.read() as UInt64))
    }

    /// Program the next deadline. The low half goes to all-ones first, so the
    /// pair never momentarily names a deadline in the past (the classic
    /// split-comparator write order, and the reason this is a method rather
    /// than two stores at the call site).
    ///
    /// The halves are taken with `truncating:`, which is what splitting a wide
    /// value into two registers means; a checked cast would be a panic edge on
    /// the one path a kernel wants free of them.
    func set_deadline(&self, at: UInt64) unsafe {
        self.cmp.lo.write(0xFFFF_FFFF)
        self.cmp.hi.write(UInt32.from(truncating: at >> WORD_BITS))
        self.cmp.lo.write(UInt32.from(truncating: at))
    }

    /// Has the timer expired without being serviced? This is the pending
    /// condition (the hardware asserts on exactly this comparison), so it needs
    /// no interrupt-controller state and no extra register.
    func expired(&self) unsafe -> Bool {
        self.now() >= self.deadline()
    }
}

/// Round a nanosecond time up to a whole counter unit.
///
/// Up rather than nearest, because the seam's contract is that a deadline never
/// fires early: the kernel treats an interrupt as "something may be due" and
/// reprograms if nothing is, so an early fire costs a round trip while a late
/// one costs nothing. The saturating guard keeps the "never" deadline
/// representable: rounding `UInt64.max` up would otherwise overflow, and Saw's
/// overflow checks are on in a kernel.
func ns_to_units(ns: UInt64) -> UInt64 {
    if ns > UInt64.max - (NS_PER_UNIT - 1) {
        return UInt64.max / NS_PER_UNIT
    }
    (ns + NS_PER_UNIT - 1) / NS_PER_UNIT
}

/// This machine's monotonic time in nanoseconds since the counter started
/// (spec §2's Clock row).
///
/// The counter is the clock. There is no second time source and no software
/// accumulator: the free-running counter is what a `Clock.now()` reads and what
/// every Timer deadline is measured against, so the two cannot disagree about
/// what "now" is. Its epoch is the machine's power-on, which matches the
/// Monotonic domain's contract: it never steps and never goes backwards.
public func timer_now_ns() unsafe -> UInt64 {
    MachineTimer().now() * NS_PER_UNIT
}

/// Program the one hardware comparator to interrupt at `at_ns`.
///
/// The machine has one comparator and two customers, the scheduler tick (spec
/// §7) and the Timer objects (§2), so this seam takes an absolute deadline and
/// nothing else. The kernel composes the two arch-free by programming the
/// earliest, and the HAL never needs to know which customer a deadline came
/// from.
///
/// A deadline already past fires as soon as interrupts are deliverable. A
/// deadline of `UInt64.max` is the kernel's "never", and lands far enough out
/// that this counter reaches it in some six hundred years.
///
/// It enables the timer interrupt class every time, which is idempotent and is
/// what lets a kernel that armed no tick at boot still serve a Timer a process
/// armed later.
public func timer_set_deadline_ns(at_ns: UInt64) unsafe {
    MachineTimer().set_deadline(ns_to_units(at_ns))
    irq_class_enable(IRQ_CLASS_TIMER)
}

/// Has the timer expired without a tick having been taken for it?
public func timer_pending() unsafe -> Bool {
    MachineTimer().expired()
}

// =============================================================================
// The platform interrupt controller
// =============================================================================
//
// Every device interrupt on this board arrives through one controller, which
// prioritizes the sources and hands the winner to a context, a (hart,
// privilege) pair. SOS uses one context, the one this kernel runs in.
//
// The cycle is claim-then-complete: reading the claim register both says which
// source won and marks it in service, and writing the same number back releases
// it. Between the two the source cannot win again, which makes the handler
// non-reentrant for free.
//
// Masking is by priority, not by the enable bit. This controller ignores a
// completion for a source that is not enabled for the context, so masking a
// line by disabling it between claim and complete would leave it in service
// forever. Priority 0 means "never wins", which is the same mask without that
// hazard.

/// The context window: the priority a source must beat to be delivered here,
/// and the register that claims and completes.
struct PlicContextRegs {
    threshold: UInt32,
    claim: UInt32,
}

struct Plic {
    context: UnsafeMemory<PlicContextRegs, Device>,
}

/// Priority levels this kernel uses: 0 is the architecture's "never
/// interrupt", and every unmasked line shares the one level above it (SOS
/// prioritizes in software, spec §7, not in the controller).
static PLIC_PRIORITY_MASKED: UInt32 = 0
static PLIC_PRIORITY_ACTIVE: UInt32 = 1
static PLIC_SOURCES_PER_WORD: UInt = 32
static REGISTER_BYTES: UInt = 4

extension Plic {
    init() unsafe -> Plic {
        Plic(context: UnsafeMemory<PlicContextRegs, Device>(PLIC_CONTEXT_BASE))
    }

    /// One source's priority register.
    func priority_at(&self, line: UInt) unsafe -> UnsafeMemory<UInt32, Device> {
        UnsafeMemory<UInt32, Device>(PLIC_PRIORITY_BASE + line * REGISTER_BYTES)
    }

    /// The enable word holding this source's bit, for this context.
    func enable_word_at(&self, line: UInt) unsafe -> UnsafeMemory<UInt32, Device> {
        UnsafeMemory<UInt32, Device>(
            PLIC_ENABLE_BASE + (line / PLIC_SOURCES_PER_WORD) * REGISTER_BYTES)
    }

    /// Every source masked and disabled, and the context's threshold at 0 so
    /// that an unmasked source at any priority above it gets through.
    ///
    /// No preemption point, for two independent reasons and either would be
    /// enough. A half-masked controller is itself IRQ-shared state in flight (a
    /// point in the middle would poll the very device it is halfway through
    /// reconfiguring), and this runs before `intc_init` completes, so nothing
    /// can be pending to find. It is one store per source up to
    /// `PLIC_MAX_SOURCE` plus the enable words and the threshold, at MMIO
    /// speed, once, at boot.
    func reset(&self) unsafe {
        var line: UInt = 1
        while line <= PLIC_MAX_SOURCE {
            self.priority_at(line).write(PLIC_PRIORITY_MASKED)
            line = line + 1
        }
        var word: UInt = 0
        while word * PLIC_SOURCES_PER_WORD <= PLIC_MAX_SOURCE {
            UnsafeMemory<UInt32, Device>(
                PLIC_ENABLE_BASE + word * REGISTER_BYTES).write(0)
            word = word + 1
        }
        self.context.threshold.write(0)
    }

    func set_priority(&self, line: UInt, priority: UInt32) unsafe {
        self.priority_at(line).write(priority)
    }

    func set_enabled(&self, line: UInt) unsafe {
        let word = self.enable_word_at(line)
        word.write(word.read() | (1u32 << ((line % PLIC_SOURCES_PER_WORD) as Int)))
    }

    /// Which source won, and mark it in service. 0 means none; the
    /// architecture reserves source 0 for exactly that.
    func claim(&self) unsafe -> UInt {
        self.context.claim.read() as UInt
    }

    /// Release the source, so it may win again once it is unmasked.
    func complete(&self, line: UInt) unsafe {
        self.context.claim.write(line as UInt32)
    }
}

static_assert(IRQ_TIMER > PLIC_MAX_SOURCE,
              "the timer's line must not collide with a real interrupt source")

/// Bring the interrupt controller up with every line masked, and make the
/// external class reachable at the hart. Individual lines are opened by
/// `irq_unmask` and by nothing else.
public func intc_init() unsafe {
    Plic().reset()
    irq_class_enable(IRQ_CLASS_EXTERNAL)
}

/// Let `line` interrupt the kernel.
public func irq_unmask(line: UInt) unsafe {
    let plic = Plic()
    plic.set_enabled(line)
    plic.set_priority(line, PLIC_PRIORITY_ACTIVE)
}

/// Stop `line` interrupting the kernel (spec §9's mask-on-fire, which the
/// Interrupt object's `ack` undoes).
public func irq_mask(line: UInt) unsafe {
    Plic().set_priority(line, PLIC_PRIORITY_MASKED)
}

/// Which line is being serviced, or `IRQ_NONE`.
///
/// The class comes from the cause word and the source, for an external
/// interrupt, from the controller, which is why claiming takes the cause: on
/// this profile the timer never reaches the controller at all.
public func irq_claim(cause: UInt) unsafe -> UInt {
    let code = cause & ~INTERRUPT_FLAG
    if code == (InterruptCause.MachineTimer as UInt) {
        return IRQ_TIMER
    }
    if code == (InterruptCause.MachineExternal as UInt) {
        return Plic().claim()
    }
    IRQ_NONE
}

/// End of service for `line`.
///
/// The timer has none: its line is lowered by programming the next deadline
/// into the comparator, and this controller never saw it.
public func irq_complete(line: UInt) unsafe {
    if line == IRQ_TIMER {
        return
    }
    Plic().complete(line)
}

/// Is `line` a source this board wires?
///
/// The controller's source space is what a driver's line number has to be in,
/// and source 0 is architecturally reserved for "no source", so a bind of
/// either end is a number that could never name a device. The timer's line is
/// not excluded here: on this profile it is not one of this controller's
/// sources at all (see `IRQ_TIMER`), so it is already outside this range, and
/// the kernel excludes it arch-free anyway because that is a policy rather than
/// a fact about the board.
public func irq_line_valid(line: UInt) -> Bool {
    line != IRQ_NONE && line <= PLIC_MAX_SOURCE
}

/// Ask for a pending line without a trap having delivered one: the idle path's
/// half of the seam.
///
/// The kernel idles with interrupts masked, so a line that arrives then is
/// pending rather than delivered and nothing hands the kernel a cause word.
/// This is the same claim `irq_claim` performs, driven by a question instead of
/// by a trap.
///
/// The timer is checked first and by hand, because on this profile it is not
/// one of the controller's sources: its condition is the comparator's, so the
/// only way to notice it is to compare. It is consulted only when the timer
/// class has been enabled, since a comparator nothing has ever programmed reads
/// as permanently expired (its deadline is zero), and treating that as a fire
/// would make an idle kernel spin on a timer nobody started. Once something has
/// programmed it, the kernel's "never" deadline keeps the same loop quiet
/// without the gate's help.
public func irq_poll() unsafe -> UInt {
    if (IRQ_CLASSES & IRQ_CLASS_TIMER) != 0 {
        if MachineTimer().expired() {
            return IRQ_TIMER
        }
    }
    Plic().claim()
}

/// Park this hart until an interrupt is pending.
///
/// It wakes on a pending interrupt of an enabled class whether or not the
/// global enable would let it be taken, which is the property the idle path
/// needs, since the global enable stays clear forever. So the core sleeps, the
/// line arrives, execution continues at the next instruction, and `irq_poll`
/// finds it.
public func wait_for_irq() unsafe {
    sos_wait_for_irq()
}

/// Raise a line from software, for interrupt bring-up. Returns the line raised.
///
/// There is no software-trigger register on this controller, so the source is a
/// real device: the console's "transmit register is empty" interrupt, which
/// asserts as soon as it is enabled and needs no input to arrive. It is the one
/// device this kernel already owns, and the kernel masks the line in its
/// handler, so the still-asserting device does not re-fire.
///
/// Two claims are reachable only through it, and both are the kernel's rather
/// than a driver's. It raises a line in kernel mode, so the transcript reads
/// "raised, entered user mode, only then serviced", which is the
/// interrupts-from-user-mode-only rule for a device line as the timer case
/// makes it for a timer; and the line it raises is bound to no Interrupt
/// object, which is the one path where `on_external_irq` reports and leaves the
/// line masked.
public func irq_raise_selftest_line() unsafe -> UInt {
    irq_unmask(CONSOLE_IRQ)
    Uart16550(at: UART_BASE).regs.ier.write(IER_TX_EMPTY)
    CONSOLE_IRQ
}
