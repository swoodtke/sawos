// SOS M4 unit 2: CONSUMED IS CONSUMED (sawos design 14; spec §2.1's single-use,
// §3's generations).
//
// **A ONE-SHOT IS SPENT BY THE OP THAT DISCHARGES IT.** `resolve` destroys the
// caller's handle ENTRY the way `RELEASE_OP` does — unbind, generation bump,
// unref — so the word it was called through is stale the instant it returns.
// Asking again is not a second answer and not a status: it is the ordinary
// `BadHandle` fault, which is design 3's diagnosis of a released word rather than
// anything this unit invented.
//
//   SOS deadclaim: resolved len=1
//   SOS: process fault: bad handle
//
// **THE TYPED LAYER MAKES THAT HARD TO REACH, WHICH IS THE POINT.** A
// `PipeReply` disarms itself when the kernel consumes it, so a spent claim
// carries the `NO_HANDLE` sentinel and dropping it is a no-op; this program has
// to ask a SECOND time through the same value to meet the fault at all. What it
// proves is that the kernel's own check is real underneath the wrapper's — single
// use is a property of the LEDGER, and the `NoCopy` value is the ergonomics on
// top of it.
//
// It is also why `pipe-abandon` cannot show "nothing un-closes" the way
// `pipe-peer-gone` does: a connection's `PeerClosed` is a LEVEL a caller may
// re-read for ever, and an exchange's is the end of that exchange.
//
// **AND SINCE SL-16 THIS IS THE ONLY PLACE IN THE SUITE THAT CAN SHOW THE FAULT
// FROM SAW.** `reply` and `reply_wait` became `consumes` methods at sawc 0.4.0,
// so a second use through either is refused by the compiler and
// `pipe-reply-wait-dead`, which used to prove the same fault on the server side,
// had to be retargeted. `resolve` could not follow them: an `Ok(None)` poll
// consumes nothing, and an effect that consumes on every path would spend a live
// claim the first time the answer had not arrived yet. So the claim side keeps
// its `&var self` receiver, keeps its answer-decided disarm, and keeps this
// case — which is now carrying the whole demonstration that the ledger is real
// underneath the wrapper.

import sos.{System, Process, PipeInlet, PipeOutlet, PipeReply, PipeRequest,
            SosStatus, PIPE_BODY_BYTES}

static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS deadclaim: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let pair = try proc.pipe_create() catch {
        print("SOS deadclaim: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (inlet, outlet) = move pair

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    var buf: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 42

    let staged = try inlet.post(body: &msg, len: 1) catch {
        print("SOS deadclaim: post failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard var claim = move staged else {
        let _ = system.debug_print("SOS deadclaim: fresh ring refused a post\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let taken = try outlet.take(into: &var buf) catch {
        print("SOS deadclaim: take failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let (_, request) = move taken else {
        let _ = system.debug_print("SOS deadclaim: nothing staged\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var obligation = move request

    msg[0] = 43
    try (move obligation).reply(body: &msg, len: 1) catch {
        print("SOS deadclaim: reply failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let answered = try claim.resolve(into: &var buf) catch {
        print("SOS deadclaim: resolve failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let got = answered else {
        let _ = system.debug_print("SOS deadclaim: the reply went missing\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS deadclaim: resolved len={}\n", got)

    // AND AGAIN, THROUGH THE SPENT CLAIM. The value disarmed itself above, so
    // this reaches the kernel with a word that names nothing and the process
    // ends. Neither arm below runs.
    match claim.resolve(into: &var buf) {
        case Ok(_) -> {
            let _ = system.debug_print("SOS deadclaim: a spent claim answered twice\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
        case Err(e) -> {
            print("SOS deadclaim: second resolve refused: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
}
