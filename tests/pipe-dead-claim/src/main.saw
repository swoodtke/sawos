// SOS M4 unit 4.5: A CLAIM THAT CAN NEVER BE ANSWERED (sawos design 22;
// `designs/010` ruling 12(b)/(c); spec §2.1's single-use, §3's rights).
//
// **THE RULED FLOW, EXECUTED.** The server drops its obligation, so the client's
// exchange is over before it began; the client ASKS with `ready()`, is told the
// terminal on the ERROR channel, and DROPS the claim rather than resolving it.
// That last step is the whole of ruling 12(b)'s amendment: a reply that can
// never come needs no second call, so the terminal does not live where a
// caller's instinct is to ask once more.
//
//   SOS deadclaim: the server let its obligation go
//   SOS deadclaim: ready says peer closed
//   SOS deadclaim: claim dropped unresolved
//
// **THE DOUBLE RESOLVE THIS CASE USED TO PROVE IS A COMPILE ERROR NOW.** Through
// unit 4 the program resolved a spent claim a second time to meet the kernel's
// `BadHandle` — the ledger showing through the wrapper. `resolve` became a
// `consumes` method at unit 4.5 (it can, now that every path consumes), so the
// second use is refused by the compiler and the suite's last Saw-visible ledger
// `BadHandle` retires with it. The kernel's check still stands for a raw-altitude
// caller holding a word; `pipe-reply-wait-dead` is the precedent for a case whose
// fault moved out of Saw's reach the same way.
//
// **AND A MINT PROBE RIDES IT** (ruling 12(c)). A one-shot has ONE NAME:
// `pipe_reply_rights()` withholds the universal `Mint` bit, so a sibling of a
// claim cannot be made — and asking for one is a fault rather than a status,
// because a process knows which rights it holds. That refusal is what ends this
// program, exactly as `pipe-no-post`'s and `pipe-no-reply`'s do:
//
//   SOS deadclaim: minting a sibling of a one-shot
//   SOS: process fault: access denied
//
// It is the last act rather than the first because everything above it is the
// ruled flow, and the flow reaches its own end cleanly before the probe spends
// the process.

import sos.{System, Process, PipeInlet, PipeOutlet, PipeReply, PipeRequest,
            SosStatus, PIPE_BODY_BYTES}

static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS deadclaim: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let pair = try proc.pipe_create() catch {
        print("SOS deadclaim: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (inlet, outlet) = move pair

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 42

    let claim = try inlet.post(body: &msg, len: 1) catch {
        print("SOS deadclaim: post failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let taken = try outlet.take() catch {
        print("SOS deadclaim: take failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (_, request) = move taken

    // **THE SERVER GIVES UP.** Dropping the obligation is the whole of it —
    // there is no `abandon()` verb — and the exchange's request column reaching
    // zero is what the claim's level reads as terminal.
    let _ = move request
    let _ = system.debug_print("SOS deadclaim: the server let its obligation go\n")

    // **THE TERMINAL IS ON THE ERROR CHANNEL** (ruling 12(b)). `Ok(false)` would
    // mean "not yet, and the connection is still good", which would be a lie
    // here and would send this caller round a loop that can never end. Nothing
    // is consumed by the asking: the claim below this line is the same claim.
    match claim.ready() {
        case Ok(_) -> {
            let _ = system.debug_print("SOS deadclaim: a dead exchange looked alive\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
        case Err(e) -> { print("SOS deadclaim: ready says {}\n", e) },
    }

    // **AND SO IT IS DROPPED, NOT RESOLVED.** The wrapper's ordinary release is
    // the right end for a claim with nothing to fetch — a resolve would spend a
    // trap to be told what `ready()` already said, and the whole reason the
    // terminal rides the error channel is that there is no second call to make.
    let _ = move claim
    let _ = system.debug_print("SOS deadclaim: claim dropped unresolved\n")

    // **THE ONE-NAME PROBE** (ruling 12(c)), on a fresh claim, and it ENDS THE
    // PROCESS. `pipe_reply_rights()` does not carry `Mint`, attenuation is
    // monotonic, and a missing right is a fault rather than a status: the caller
    // holds the handle and could have known.
    msg[0] = 44
    let second = try inlet.post(body: &msg, len: 1) catch {
        print("SOS deadclaim: second post failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS deadclaim: minting a sibling of a one-shot\n")
    let _ = second.mint()

    // UNREACHABLE: the line above does not return, because the kernel ends this
    // process at the rights check. Written so the refusal reads as a refusal
    // rather than as a missing case.
    let _ = system.debug_print("SOS deadclaim: a one-shot minted a sibling\n")
    let _ = system.shutdown(EXIT_FAILED)
}
