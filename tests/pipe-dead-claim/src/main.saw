// A claim whose exchange can never be answered (spec §2.1 single-use, §3
// rights).
//
// The server drops its obligation, so the client's exchange is over before it
// began. The client asks with `ready()`, is told the terminal on the error
// channel, and drops the claim rather than resolving it: a reply that can never
// come needs no second call.
//
//   SOS deadclaim: the server let its obligation go
//   SOS deadclaim: ready says the other end of this connection is gone
//   SOS deadclaim: claim dropped unresolved
//
// Resolving a spent claim a second time is a compile error (`resolve` consumes
// the claim), so this case does not exercise the kernel's `BadHandle` for it;
// that check only matters to a raw-altitude caller holding a word.
//
// A mint probe ends the program. A one-shot has one name:
// `pipe_reply_rights()` withholds `Mint`, so minting a sibling of a claim is a
// fault (access denied) rather than a status, because a process knows which
// rights it holds, exactly as in `pipe-no-post` and `pipe-no-reply`:
//
//   SOS deadclaim: minting a sibling of a one-shot
//   SOS: process fault: access denied
//
// The probe comes last because it spends the process.

import sos.{System, Process, PipeInlet, PipeOutlet, PipeReply, PipeRequest,
            SosStatus, PIPE_BODY_BYTES}

static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS deadclaim: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let pair = try proc.pipe_create() catch {
        print("SOS deadclaim: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (inlet, outlet) = move pair

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 42

    let claim = try inlet.post(body: &msg, len: 1) catch {
        print("SOS deadclaim: post failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let taken = try outlet.take() catch {
        print("SOS deadclaim: take failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (_, request) = move taken

    // The server gives up. Dropping the obligation is the whole of it (there
    // is no `abandon()` verb); the exchange's request column reaching zero is
    // what the claim's level reads as terminal.
    let _ = move request
    let _ = system.debug_print("SOS deadclaim: the server let its obligation go\n")

    // The terminal is on the error channel: `Ok(false)` would mean "not yet,
    // the connection is still good" and send a caller round a loop that can
    // never end. Asking consumes nothing; the claim below is the same claim.
    match claim.ready() {
        case Ok(_) -> {
            let _ = system.debug_print("SOS deadclaim: a dead exchange looked alive\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
        case Err(e) -> { print("SOS deadclaim: ready says {}\n", e) },
    }

    // The claim is dropped, not resolved: a resolve would spend a trap to be
    // told what `ready()` already said.
    let _ = move claim
    let _ = system.debug_print("SOS deadclaim: claim dropped unresolved\n")

    // The one-name probe, on a fresh claim. `pipe_reply_rights()` does not
    // carry `Mint`, attenuation is monotonic, and a missing right is a fault
    // rather than a status: the caller holds the handle and could have known.
    // It ends the process.
    msg[0] = 44
    let second = try inlet.post(body: &msg, len: 1) catch {
        print("SOS deadclaim: second post failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS deadclaim: minting a sibling of a one-shot\n")
    let _ = second.mint()

    // Unreachable: the kernel ends this process at the rights check. Written
    // so the refusal reads as a refusal rather than as a missing case.
    let _ = system.debug_print("SOS deadclaim: a one-shot minted a sibling\n")
    let _ = system.shutdown(EXIT_FAILED)
}
