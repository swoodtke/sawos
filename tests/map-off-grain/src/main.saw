// `map` answers a status, never a fault, for an allocation the board cannot
// grant (spec §2.5): a server that maps a client's Memory cannot check it
// first, and a mapping covers exactly its allocation, so none is rounded.
//
// The build gives root, beside its pool, a boot allocation whose length is
// off the grain (`off_grain_destinations`), one whose base is a byte past the
// grain with whole grains of length, one whose length runs off the end of the
// address space (`wrapping_region`) and one of no bytes (`empty_region`). An
// allocation out of the pool, on the grain, maps first; each of the others is
// `NoResource` and root carries on:
//
//   SOS mapgrain: an allocation on the grain, mapped: taken
//   SOS mapgrain: a length off the grain: <status>
//   SOS mapgrain: a base off the grain: <status>
//   SOS mapgrain: a length past the end of the address space: <status>
//   SOS mapgrain: a length of zero: <status>
//   SOS mapgrain: done
//
// A 64-bit row's length is a signed integer in the description, so the
// build has no row that runs off the end of the address space there, and the
// third line says so instead.

import sos.{System, Process, Memory, Pool, MapAccess, SosStatus}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.Unknown

static RW: UInt32 = MapAccess.Read | MapAccess.Write

/// A page: a whole number of grains on every profile.
static PAGE: UInt = 0x1000

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS mapgrain: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&system, &proc) catch {
        print("SOS mapgrain: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS mapgrain: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    // The pool, the two allocations off the grain, the one that wraps and the
    // empty one: the table's order, each read where it is mapped.
    var pool_rec = try proc.boot_handle_next()
    var short_rec = try proc.boot_handle_next()
    var skewed_rec = try proc.boot_handle_next()
    guard let pool = pool_rec.take_pool() else { return BUG }
    guard let short = short_rec.take_memory() else { return BUG }
    guard let skewed = skewed_rec.take_memory() else { return BUG }

    let piece = try pool.allocate(len: PAGE)
    let view = try proc.map(memory: &piece, access: RW)
    let _ = system.debug_print(
        "SOS mapgrain: an allocation on the grain, mapped: taken\n")
    let _ = move view

    try refused(&proc, &short, "a length off the grain")
    try refused(&proc, &skewed, "a base off the grain")

    // A 64-bit table has no row that runs off the end of the address space:
    // a length is a signed integer in the description.
    if sizeof<UInt>() == 8 {
        print("SOS mapgrain: no row runs off a 64-bit address space\n")
    } else {
        var wide_rec = try proc.boot_handle_next()
        guard let wide = wide_rec.take_memory() else { return BUG }
        try refused(&proc, &wide, "a length past the end of the address space")
    }

    var empty_rec = try proc.boot_handle_next()
    guard let empty = empty_rec.take_memory() else { return BUG }
    try refused(&proc, &empty, "a length of zero")
    return
}

/// A `map` of `memory` that answers `NoResource`, which is printed. A mapping,
/// or any other status, fails the case.
func refused(proc: &Process, memory: &Memory,
             what: String) -> Result<Void, SosStatus> {
    match proc.map(memory: &memory, access: RW) {
        case Ok(_) -> {
            print("SOS mapgrain: {}: mapped\n", what)
            return BUG
        },
        case Err(status) -> {
            match status {
                case NoResource -> {
                    print("SOS mapgrain: {}: {}\n", what, status)
                },
                case _ -> {
                    print("SOS mapgrain: {}: the wrong status: {}\n", what,
                          status)
                    return BUG
                },
            }
        },
    }
    return
}
