// A `Handle` limit is at most the handle table's size, `MAX_HANDLES` (spec
// §2.7). A limit above it answers `NoResource` and sets nothing: no op reports
// the size of a board's handle table, so the caller could not have known.
//
// Root's own Handle row has no cap, so its own limit bounds nothing here, and
// the table is the one bound the number meets. A limit of the table's size is
// taken; one more is refused, and the row still reads the table's size.
//
//   SOS quotahandles: child handle row limit=12 used=0
//   SOS quotahandles: limit 16, the table, taken
//   SOS quotahandles: limit 17: no room for what was asked
//   SOS quotahandles: the row still reads limit=16
//   SOS quotahandles: done

import sos.{System, QuotaKind, SosStatus}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// `kcore.limits`' `MAX_HANDLES`, the same on every board. No op publishes
/// it, which is why a limit past it is a status.
static TABLE: UInt16 = 16

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)
    try run(&system) catch {
        print("SOS quotahandles: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS quotahandles: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System) -> Result<Void, SosStatus> {
    let proc = try system.process_self()
    var image_rec = try proc.boot_handle_next()
    var ram_rec = try proc.boot_handle_next()
    guard let image = image_rec.take_memory() else { return BUG }
    guard let ram = ram_rec.take_memory() else { return BUG }
    let child = try system.process_create(image: &image, memory: &ram)

    let before = try child.quota_get(kind: QuotaKind.Handle)
    print("SOS quotahandles: child handle row limit={} used={}\n", before.limit,
          before.used)
    try child.quota_set(kind: QuotaKind.Handle, limit: TABLE)
    print("SOS quotahandles: limit {}, the table, taken\n", TABLE)
    match child.quota_set(kind: QuotaKind.Handle, limit: TABLE + 1) {
        case Ok(_) -> {
            print("SOS quotahandles: UNEXPECTED past the table, taken\n")
            return BUG
        },
        case Err(why) -> {
            print("SOS quotahandles: limit {}: {}\n", TABLE + 1, why)
        },
    }
    let after = try child.quota_get(kind: QuotaKind.Handle)
    print("SOS quotahandles: the row still reads limit={}\n", after.limit)
    return
}
