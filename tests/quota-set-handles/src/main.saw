// A `Handle` limit past the body's `MAX_HANDLES` entries needs a handle
// block (spec §2.7): taken when the machine has one free, and otherwise
// `NoResource`, setting nothing. No op reports the machine's free blocks, so
// the caller could not have known.
//
// Root's own Handle row has no cap, so its own limit bounds nothing here. A
// limit of the body's entries needs no block and is taken. One more needs a
// block, and the case runs twice: on an image with none, where the limit is
// refused and the row still reads the body's entries, and on an image with
// one, where it is taken.
//
//   SOS quotahandles: child handle row limit=16 used=0
//   SOS quotahandles: limit 32, the body's entries, taken
//   SOS quotahandles: limit 33: no room for what was asked    (no block)
//   SOS quotahandles: the row reads limit=32
//   SOS quotahandles: limit 33: taken                         (one block)
//   SOS quotahandles: the row reads limit=33
//   SOS quotahandles: done

import sos.{System, QuotaKind, SosStatus}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// `MAX_HANDLES`, the same on every board (`hal.MAX_HANDLES`).
static BODY: UInt16 = 32

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)
    try run(&system) catch {
        print("SOS quotahandles: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS quotahandles: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System) -> Result<Void, SosStatus> {
    let proc = try system.process_self()
    var image_rec = try proc.boot_handle_next()
    var ram_rec = try proc.boot_handle_next()
    guard let image = image_rec.take_memory() else { return BUG }
    guard let ram = ram_rec.take_memory() else { return BUG }
    let child = try system.process_create(image: &image, memory: &ram)

    let before = try child.quota_get(kind: QuotaKind.Handle)
    print("SOS quotahandles: child handle row limit={} used={}\n", before.limit,
          before.used)
    try child.quota_set(kind: QuotaKind.Handle, limit: BODY)
    print("SOS quotahandles: limit {}, the body's entries, taken\n", BODY)
    match child.quota_set(kind: QuotaKind.Handle, limit: BODY + 1) {
        case Ok(_) -> print("SOS quotahandles: limit {}: taken\n", BODY + 1),
        case Err(why) -> print("SOS quotahandles: limit {}: {}\n", BODY + 1,
                               why),
    }
    let after = try child.quota_get(kind: QuotaKind.Handle)
    print("SOS quotahandles: the row reads limit={}\n", after.limit)
    return
}
