//! `uart-reader` against a driver whose receive ring holds `RING` bytes:
//! it waits until the driver has received all `TYPED`, then reads the ring,
//! then the mark.

public static MODE: Int = 2

/// The bytes the runner types.
public static TYPED: Int = 32

/// The driver's receive ring (`tests/images/uart/lost.saw`).
public static RING: Int = 8
