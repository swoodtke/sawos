//! `uart-reader` reading more bytes than the driver's receive threshold,
//! typed at once: the receive FIFO's full cause.

public static MODE: Int = 1

/// The bytes the runner types, at once: more than the default `RX_FULL`, 64.
public static TYPED: Int = 100

/// The bytes it reads: all of them.
public static RING: Int = 100
