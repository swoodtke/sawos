// The fused call spends `PipeInletRight.Post` (spec §3).
//
// `Call` has no right of its own: it submits a message exactly as `post` does
// (same ring, same body maximum, same peer-gone answer) and adds only a park,
// which needs no authority because no Waiter is involved and the claim is
// kernel-internal. A second bit would let a launcher hand out an
// endpoint that may post and may not call, a distinction with no security
// content.
//
//   SOS nocall: minted without Post     a sibling that may travel and may mint
//   SOS: process fault: access denied   ...and may not call either
//
// This is `pipe_no_post`'s case at the second op on the same object; the pair
// shows the two ops share one gate.
//
// It faults before it could park: the rights check runs in
// `pipe_inlet_op_decoded`, above `pipe_call`, so nothing is staged and no
// thread is tied to an exchange. A `Call` that got past the gate would park
// forever (nobody serves it) and the kernel's deadlock report would answer.

import sos.{System, Process, PipeInlet, PipeOutlet, SosStatus, PipeInletRight,
            PIPE_BODY_BYTES}

static EXIT_FAILED: UInt = 1

/// The keep mask; `Post` is absent. Same mask as `pipe_no_post`: one mask,
/// both ops.
static NO_POST: UInt32 = (PipeInletRight.Transfer | PipeInletRight.Mint)

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS nocall: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let pair = try proc.pipe_create() catch {
        print("SOS nocall: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (inlet, outlet) = move pair

    let narrowed = try inlet.mint(rights: NO_POST) catch {
        print("SOS nocall: mint failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS nocall: minted without Post\n")

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 1
    match narrowed.send(body: &msg, len: 1) {
        case Ok(_) -> {
            let _ = system.debug_print("SOS nocall: an unspent right called\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
        // Unreachable: the kernel ends this process at the rights check. The
        // arm is written so the refusal reads as a refusal rather than as a
        // missing case.
        case Err(e) -> {
            print("SOS nocall: call refused: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
}
