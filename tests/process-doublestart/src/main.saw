// A second `start()` faults the caller.
//
// Root creates a child, starts it, and starts it again. The transcript:
//
//   SOS doublestart: started once
//   SOS: process fault: object in the wrong state process=0
//   SOS: process teardown ... process=0
//
// and the machine exits with the kernel's process-fault status. The line after
// "started once" is never printed, because the second call does not return.
//
// A fault and not a status: a launcher knows whether it has started a process,
// since it started it one call earlier in its own code. That is checkable by
// the caller, unlike a malformed image, which is data the launcher was handed
// (see `process-badimage`, where the same launcher survives the mistake it
// could not have prevented).
//
// Process 0 is the one that dies, and the teardown line says so. That
// separates this transcript from the lifecycle case's, where the same two
// lines name process 1 and the run continues. Root is init: its death stops
// the machine, children and all.
//
// The child never runs. This image's kernel arms no tick and root makes no
// blocking call between the two starts, so nothing takes the processor away
// from root and the ordering is forced rather than raced.

import sos.{System, Process, Memory, BootHandle, SosStatus}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS doublestart: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    var image = try proc.boot_handle_next() catch {
        print("SOS doublestart: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS doublestart: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The record hands the region over; see `process-lifecycle` for why
    // `take_memory` is the one way out.
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS doublestart: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try child.start() catch {
        print("SOS doublestart: first start failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS doublestart: started once\n")

    // This does not return. The kernel ends this process (the caller) because
    // starting a started process is broken code rather than a condition to
    // report.
    let _ = child.start()

    // Unreachable. Printing it would be the failure: it would mean the kernel
    // handed back a status where the contract says it terminates.
    let _ = system.debug_print("SOS doublestart: second start RETURNED\n")
    let _ = system.shutdown(EXIT_FAILED)
}
