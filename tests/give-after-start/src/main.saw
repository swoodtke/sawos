// The boot set freezes at start: a give after `start` faults the process.
//
// Whatever a launcher gives a child must be complete at the child's first
// instruction, since a child that drains a half-populated set cannot tell "not
// given yet" from "not given". `start` is the barrier that makes a
// half-populated table unrepresentable. No synchronization is needed: the
// launcher gives, then starts, and after that the set is closed.
//
//   SOS giveafter: started
//   SOS: process fault: object in the wrong state process=0
//   SOS: process teardown ... process=0
//
// A give afterwards is `BadState`, the same fault a second `start` raises,
// through the same process-state word, so the two refusals are one rule. It is
// a fault and not a status because the caller could have known: it is the one
// that started the child.
//
// Dynamic transfer is refused only here. A handle may travel to a process that
// is already running and expecting it, over a channel, to a receiver that
// asked. What this refuses is a launcher reaching into a running process's
// table behind its back.
//
// The child never runs: root dies first, and root's death stops the machine
// (process 0 is init; spec §8). Which child image is appended is therefore
// immaterial, and the case reuses `child-fault`.

import sos.{System, Process, Memory, BootHandle, SosStatus}

static EXIT_FAILED: UInt = 1

static TAG: UInt = 3

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS giveafter: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    var image = try proc.boot_handle_next() catch {
        print("SOS giveafter: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS giveafter: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS giveafter: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The no-tag form, which is what a launcher writes when it is furnishing
    // nothing; here it closes the set before anything was furnished. Root keeps
    // running, which is what lets the next line be reached.
    try child.start() catch {
        print("SOS giveafter: start failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS giveafter: started\n")

    // Too late. The set froze above, and this does not return.
    let _ = child.give(memory: move image_mem, tag: TAG)

    let _ = system.debug_print("SOS giveafter: survived, which is the bug\n")
    let _ = system.shutdown(EXIT_FAILED)
}
