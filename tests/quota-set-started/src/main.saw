// A launcher sets its child's quota rows before the start and never after
// (spec §2.7): `QuotaSet` naming a process that is not `Created` is a
// `BadState` fault, as `Start` and `Give` are.
//
// Root creates a child and starts it; the child has not run yet when root asks
// (a start never preempts its caller), so it is started and nothing more. The
// limit asked for is the unlimited sentinel, which is a `BadArg` fault of its
// own: that the answer is `BadState` says the state is decided before the
// limit.
//
//   SOS quotastarted: started
//   SOS quotastarted: setting the sentinel on a started child
//   SOS: process fault: object in the wrong state

import sos.{System, QuotaKind, QUOTA_UNLIMITED, SosStatus}

static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)
    try run(&system) catch {
        print("SOS quotastarted: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.shutdown(EXIT_FAILED)
}

/// Start the child, then set one of its rows. The set does not return.
func run(system: &System) -> Result<Void, SosStatus> {
    let proc = try system.process_self()
    var image_rec = try proc.boot_handle_next()
    var ram_rec = try proc.boot_handle_next()
    guard let image = image_rec.take_memory() else { return BUG }
    guard let ram = ram_rec.take_memory() else { return BUG }
    let child = try system.process_create(image: &image, memory: &ram)
    try child.start()
    print("SOS quotastarted: started\n")
    print("SOS quotastarted: setting the sentinel on a started child\n")
    let _ = child.quota_set(kind: QuotaKind.Thread, limit: QUOTA_UNLIMITED)
    print("SOS quotastarted: UNREACHABLE the row was set\n")
    return
}
