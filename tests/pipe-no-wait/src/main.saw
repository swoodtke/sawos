// An unspent `Wait` right on a connection end (spec §3).
//
// `pipe_no_post`'s claim at the wait door. All four pipe kinds carry a `Wait`
// bit in every default set, because attenuation is monotonic: a bit not minted
// at creation could never appear later. The narrowing is therefore the
// holder's, written once as a `MINT_OP` keep mask, and this program executes
// that at the wait door:
//
//   SOS nowait: minted without Wait     a sibling that may take and may travel
//   SOS: process fault: access denied   ...and may not watch
//
// The mask is a real policy and not a test fixture. `Transfer | Mint | Take`
// with `Wait` absent describes a polling helper: a process handed work to drain
// and deliberately not handed the authority to park on the connection, so it
// can never hold a Waiter slot open on somebody else's pipe.
//
// Spending the missing right is a fault and not a status: a process knows
// which rights it holds, so the mistake is one it could have checked. The
// kernel terminates the process and stays up to say so.

import sos.{System, Process, PipeInlet, PipeOutlet, Waiter, AttachMode,
            SosStatus, PipeOutletRight}

static EXIT_FAILED: UInt = 1

/// The key the refused attach would have used. It never reaches the kernel's
/// key table: the rights check runs first, inside `waitable_slot`, where
/// waitability and the right are one question.
static KEY: UInt = 61

/// The keep mask; `Wait` is absent. Three bits: this end may be handed on, may
/// be narrowed further, and may be read, and may not be watched.
static NO_WAIT: UInt32 = (PipeOutletRight.Transfer | PipeOutletRight.Mint
                          | PipeOutletRight.Take)

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS nowait: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let waiter = try proc.waiter_create() catch {
        print("SOS nowait: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let pair = try proc.pipe_create() catch {
        print("SOS nowait: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (inlet, outlet) = move pair

    let narrowed = try outlet.mint(rights: NO_WAIT) catch {
        print("SOS nowait: mint failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS nowait: minted without Wait\n")

    // A second name is a second reference on this connection's outlet column,
    // so the original could still be attached; what is refused is this handle,
    // which makes attenuation per-capability rather than per-object.
    match waiter.add(outlet: &narrowed, key: KEY, mode: AttachMode.Persistent) {
        case Ok(_) -> {
            let _ = system.debug_print("SOS nowait: an unspent right attached\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
        // Unreachable: the kernel ends this process at the rights check. The
        // arm is written so the refusal reads as a refusal rather than as a
        // missing case.
        case Err(e) -> {
            print("SOS nowait: attach refused: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
}
