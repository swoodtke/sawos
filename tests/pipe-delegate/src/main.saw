// Delegation across a process boundary (spec §2.1's zero-copy example, §12).
//
// A server may move its obligation to a third party who replies directly. Here
// it is at its smallest: root posts a question, takes the obligation off its
// own outlet, and `give`s that obligation to a child which holds no end of the
// connection at all. The child answers, and the bytes land at root's claim.
//
//   SOS delegate: created          the pair, and a child to hand work to
//   SOS delegate: gave the request the obligation crossed the boundary
//   SOS childreply: replied        ...and was discharged over there
//   SOS delegate: reply len=4 b=68,79,78,69   `DONE`, read at the client
//
// What the child cannot do is the point. It has no inlet, no outlet and no way
// to name root's pipe; it cannot post, cannot take, and cannot answer any
// question but this one. The obligation is the whole of its authority, and it
// knows where the answer goes, which is why §2.1's filesystem can forward a
// read to a flash driver without the payload ever transiting the filesystem.
//
// The order matters. The child's reply, its exit and its teardown all come
// before root reads the bytes: root's first `ready()` is false (the child was
// runnable and had not run), so root parks on a timer and the child runs to
// completion. A reply lives in the exchange's own ring slot, so it outlives the
// process that wrote it exactly as a staged message outlives its sender.
//
// `code={four}` and `len=4` are the same fact from the two sides of the
// boundary.
//
// The poll is bounded and parks between rounds. Root polls the claim and waits
// on a timer between polls, rather than waiting on the claim; a spin would be a
// hang the deadlock report could not see.

import sos.{System, Process, PipeInlet, PipeOutlet, PipeReply, PipeRequest,
            Clock, ClockType, Timer, Waiter, SosStatus, SystemRight,
            PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// The key root attaches its timer under. A number that appears nowhere else in
/// the transcript.
static KEY: UInt = 83

/// Five milliseconds per poll round: long enough for the child to be scheduled,
/// drain one record, reply and exit, and short enough that a broken run ends
/// rather than hanging.
static PARK_NS: UInt64 = 5_000_000

/// The ceiling on the poll. A run that needs more than this has a bug, and
/// printing a miss is a better failure than a spin.
static POLL_ROUNDS: Int = 8

/// Root's config, and the whole of the contract with the child. `child-reply`
/// expects exactly these words; the kernel supplies no meaning for either.
static TAG_BOOT: UInt = 7
static TAG_REQUEST: UInt = 11

/// What a child of this launcher may ask its System object for: print, learn
/// its own Process object, and pass a handle on. `Transfer` is the ticket the
/// give itself checks.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS delegate: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    var image = try proc.boot_handle_next() catch {
        print("SOS delegate: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS delegate: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS delegate: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let pair = try proc.pipe_create() catch {
        print("SOS delegate: pipe create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (inlet, outlet) = move pair
    let _ = system.debug_print("SOS delegate: created\n")

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 63

    // Root asks its own question and takes it off its own outlet. Both ends are
    // root's; what crosses the boundary is neither of them.
    var claim = try inlet.post(body: &msg, len: 1) catch {
        print("SOS delegate: post failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let taken = try outlet.take() catch {
        print("SOS delegate: take failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (_, request) = move taken

    let for_child = try system.mint(rights: CHILD_SYSTEM) catch {
        print("SOS delegate: mint failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        print("SOS delegate: give system failed: {}\n", error.0)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    // The give consumes the wrapper, so root cannot answer its own question
    // below this line, which is what delegation means. The exchange is
    // untouched by the move: an obligation names a ring slot, and a give
    // changes only which table names the obligation.
    match child.give(request: move request, tag: TAG_REQUEST) {
        case Ok(_) -> {
            let _ = system.debug_print("SOS delegate: gave the request\n")
        },
        case Err(e) -> {
            print("SOS delegate: give request failed: {}\n", e.0)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }

    try child.start(boot_tag: TAG_BOOT) catch {
        print("SOS delegate: start failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The parking machinery. Root polls the claim and waits on a timer between
    // polls, and the poll stands in for a blocking `send`.
    let clock = try system.clock_get(type: ClockType.Monotonic) catch {
        print("SOS delegate: no clock: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let waiter = try proc.waiter_create() catch {
        print("SOS delegate: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let timer = try clock.timer_create() catch {
        print("SOS delegate: no timer: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try waiter.add(&timer, KEY) catch {
        print("SOS delegate: attach failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let answer = try poll_reply(move claim, &timer, &waiter) catch {
        print("SOS delegate: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    if not answer.have {
        let _ = system.debug_print("SOS delegate: nothing came back\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS delegate: reply len={} b={},{},{},{}\n", answer.length,
          answer.b0, answer.b1, answer.b2, answer.b3)

    print("SOS delegate: done\n")
    let _ = proc.exit(EXIT_OK)
}

/// What the poll below found, flattened out of the message it came in.
struct Answer {
    have: Bool,
    length: UInt,
    b0: UInt,
    b1: UInt,
    b2: UInt,
    b3: UInt,
}

/// The poll, in its own frame. It is a phase rather than a block because a
/// `PipeMsg` is a message-sized value and every `print` with format arguments
/// reserves its own scratch, so a `_start` holding both would exhaust root's
/// stack grant on the 64-bit profile.
///
/// It is a `ready()` loop with one resolve at the end. A resolve parks, which
/// would make the loop a blocking receive with a timer attached to nothing. So
/// the loop asks the level (non-consuming, as many times as it likes) and the
/// single consuming act happens once, after the answer is known to be there.
/// The claim is taken by value for that reason: a `&var` parameter could not be
/// moved into a consuming method.
func poll_reply(claim: PipeReply, timer: &Timer,
                waiter: &Waiter) -> Result<Answer, SosStatus> {
    var rounds: Int = 0
    var arrived = false
    while rounds < POLL_ROUNDS && not arrived {
        rounds = rounds + 1
        arrived = try claim.ready()
        if not arrived {
            try timer.arm(after_ns: PARK_NS)
            try waiter.wait()
        }
    }
    if not arrived {
        // The claim is dropped rather than resolved: resolving would park on an
        // answer this loop has just spent its whole budget not seeing.
        let _ = move claim
        return Answer(have: false, length: 0, b0: 0, b1: 0, b2: 0, b3: 0)
    }
    let answer = try (move claim).resolve()
    return Answer(have: true, length: answer.len,
                  b0: answer.bytes[0] as UInt,
                  b1: answer.bytes[1] as UInt,
                  b2: answer.bytes[2] as UInt,
                  b3: answer.bytes[3] as UInt)
}
