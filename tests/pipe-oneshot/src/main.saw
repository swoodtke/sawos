// SOS M4 unit 2: THE ONE-SHOT PAIR, END TO END IN ONE PROCESS (sawos design 14;
// spec §2.1).
//
// **REQUEST/REPLY IS A PRIMITIVE, AND THIS IS THE SMALLEST PROGRAM THAT PROVES
// IT.** Root creates a connection, holds both ends, and plays both sides of
// every exchange — no second process, no waitability, nothing parked. The
// transcript is a list of properties:
//
//   request len=3 b=65,66,67   a take hands over the MESSAGE and the obligation
//   pending is none            a resolve before the reply is `Ok(None)`, not an
//                              error, and it consumes nothing
//   reply len=2 b=90,89        the reply BYTES came back through the same slot
//   zero reply len=0           a reply that carries no data is still an answer
//   fifo replies a=11 b=22 c=33  three exchanges in flight at once, answered out
//                              of order, and each claim got ITS OWN reply
//   depth with one in flight=15  ONE unsettled exchange costs ONE ring slot
//   depth settled=16           ...and settling it gives the slot back
//
// **THE LAST TWO ROWS ARE THE UNIT'S SHARPEST CLAIM** (design 14 D-1). Unit 1
// freed a staging slot the moment its bytes were taken; unit 2's slot carries the
// REPLY back, so it recycles only when the exchange settles — which makes
// `PIPE_INFLIGHT` a bound on AWAITING-REPLY EXCHANGES, design 10 ruling 6's
// "in-flight messages per client" read literally. This program never names the
// number: it holds one exchange open, posts until the kernel refuses and COUNTS
// (15), then discharges the held exchange and counts again (16). A kernel that
// freed the slot at the take would print 16 both times.
//
// **NOTHING HERE IS AN ERROR EXCEPT A DEAD PEER.** A ring with no free slot and
// an exchange with no reply yet are both "not right now" — transient, cleared by
// the other side — so they arrive in the OK channel with a distinguishable
// absence (design 234 §4). `pipe-abandon` is where the error channel is proved.
//
// **ONE PHASE PER FUNCTION, AND THE FRAME IS WHY.** Root's stack grant is
// `hal.ROOT_STACK_LEN` — 16 KiB, one page-pair on both profiles — and every
// `print` with format arguments reserves message scratch in ITS OWN frame
// (design 137: the message is assembled in stack scratch so a panic survives an
// exhausted allocator). A `_start` holding every phase of this case therefore
// holds every phase's scratch at once, which overflowed the grant on the 64-bit
// profile and not on the 32-bit one. So each phase is a function that reports by
// RETURNING a status and `_start` prints once. That is also how it reads best:
// each function is one claim.
//
// EVERY LOOP IS BOUNDED. A poll loop with no ceiling is a hang the deadlock
// report cannot see.

import sos.{System, Process, PipeInlet, PipeOutlet, PipeReply, PipeRequest,
            SosStatus, PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// The ceiling on every counting loop. Comfortably past any staging ring this
/// kernel could have — the point is that the loop terminates whatever the kernel
/// answers, not that the number is tight.
static MAX_ROUNDS: Int = 64

/// **WHAT A PHASE ANSWERS WHEN ITS OWN ARITHMETIC IS WRONG.** Every refusal in
/// this case that is NOT the kernel's is a bug in the case, and it needs a value
/// to carry out of a `Result` — so it borrows the one status that can never
/// legitimately reach `_start` from any call these phases make, and `_start`
/// prints it. It is a test's internal assertion vocabulary, not a claim about the
/// kernel.
static BUG: SosStatus = SosStatus.Revoked

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS oneshot: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let pair = try proc.pipe_create() catch {
        print("SOS oneshot: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (inlet, outlet) = move pair
    let _ = system.debug_print("SOS oneshot: created\n")

    try round_trip(&inlet, &outlet) catch {
        print("SOS oneshot: round trip failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try zero_reply(&proc, &inlet, &outlet) catch {
        print("SOS oneshot: zero reply failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try three_in_flight(&inlet, &outlet) catch {
        print("SOS oneshot: three in flight failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try ring_around_one(&inlet, &outlet) catch {
        print("SOS oneshot: ring count failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    print("SOS oneshot: done\n")
    let _ = proc.exit(EXIT_OK)
}

/// **THE ROUND TRIP, BOTH WAYS** — and the pending answer in the middle of it.
///
/// A post answers a CLAIM; a take answers the message AND the obligation to
/// reply to it; a resolve before the reply is `Ok(None)` and consumes nothing,
/// which is what makes polling with the same claim legal; a reply lands where
/// that claim is waiting. The bytes are what is asserted at each end, because a
/// status alone would not show that either copy funnel carried anything.
func round_trip(inlet: &PipeInlet, outlet: &PipeOutlet) -> Result<Void, SosStatus> {
    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 65
    msg[1] = 66
    msg[2] = 67

    var claim = try inlet.post(body: &msg, len: 3)

    let taken = try outlet.take()
    let (arrived, request) = move taken
    let obligation = move request
    print("SOS oneshot: request len={} b={},{},{}\n", arrived.len,
          arrived.bytes[0] as UInt, arrived.bytes[1] as UInt,
          arrived.bytes[2] as UInt)

    // **THE PENDING QUESTION IS `ready()` NOW, AND IT IS `Ok(false)`**
    // (`designs/010` ruling 12(b)). Through unit 4 this line was a `resolve`
    // answering `Ok(None)`; a resolve would PARK here, because the exchange is
    // taken and the server has not answered — which is exactly the state the
    // question exists for. It consumes nothing, so the claim below this line is
    // the SAME claim, and readiness is monotonic, so a `false` here can only
    // become a `true`.
    let ready = try claim.ready()
    if ready { return BUG }
    let _ = write_line("SOS oneshot: pending is not ready\n")

    msg[0] = 90
    msg[1] = 89
    try (move obligation).reply(body: &msg, len: 2)

    // ...and now the level is up, so the resolve returns WITHOUT parking. The
    // move is the typed tier's half of ruling 12(b): the claim is spent, and a
    // second use of this binding is a compile error.
    let got = try (move claim).resolve()
    print("SOS oneshot: reply len={} b={},{}\n", got.len,
          got.bytes[0] as UInt, got.bytes[1] as UInt)
    return
}

/// **A REPLY OF ZERO BYTES IS STILL AN ANSWER** — and since M4 unit 4.5 nothing
/// has to keep it apart from "no reply yet", because "no reply yet" is not an
/// answer this op can give: a pending resolve PARKS (`designs/010` ruling
/// 12(b)). The same simplification on the request side is `take`'s: a
/// zero-length message is `Ok`, an empty ring is `Err(WouldBlock)`.
/// **AND IT IS THE PHASE THE TRAP COUNT IS TAKEN OVER** (sawos design 16),
/// because it is the smallest complete exchange in the file: post, take, reply,
/// resolve, and not one printed byte between the brackets. Every printed byte is
/// an `ecall`, so a measured window containing a `print` counts the prose.
func zero_reply(proc: &Process, inlet: &PipeInlet,
                outlet: &PipeOutlet) -> Result<Void, SosStatus> {
    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 5

    let before = try proc.stats()
    let claim = try inlet.post(body: &msg, len: 1)
    let obligation = try take_one(&outlet)
    try (move obligation).reply(body: &msg, len: 0)
    let zero = try (move claim).resolve()
    // The closing read is charged at trap entry like any other, so:
    //
    //     delta = post + take + reply + resolve + this read = 4 + 1 = 5
    //
    // **NOTHING RELEASES INSIDE THE BRACKET**, which is the other half of the
    // arithmetic and is why the read sits HERE rather than at the end of the
    // function: `claim` and `obligation` are owning wrappers, and a wrapper
    // still holding a live word issues a release when it falls out of scope.
    // Those releases are traps too — they are just this phase's epilogue rather
    // than its exchange. Since M4 unit 4.5 both of them are spent by CONSUMING
    // ops instead, so this phase's epilogue is empty and the arithmetic is the
    // exchange alone.
    let after = try proc.stats()

    print("SOS oneshot: zero reply len={}\n", zero.len)
    print("SOS oneshot: the exchange cost {} traps\n",
          after.syscalls - before.syscalls)
    return
}

/// **THREE EXCHANGES IN FLIGHT AT ONCE, ANSWERED OUT OF ORDER**, and each claim
/// resolves to ITS OWN reply.
///
/// A design that kept one reply slot per CONNECTION rather than per exchange
/// would print the same digit three times here; one that keyed replies by queue
/// position would print them permuted, because the obligations are discharged
/// 2, 3, 1. An exchange is not a queue position.
func three_in_flight(inlet: &PipeInlet,
                     outlet: &PipeOutlet) -> Result<Void, SosStatus> {
    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]

    msg[0] = 1
    let c1 = try inlet.post(body: &msg, len: 1)
    msg[0] = 2
    let c2 = try inlet.post(body: &msg, len: 1)
    msg[0] = 3
    let c3 = try inlet.post(body: &msg, len: 1)

    // The obligations come out in the order the messages went in.
    let r1 = try take_one(&outlet)
    let r2 = try take_one(&outlet)
    let r3 = try take_one(&outlet)

    msg[0] = 22
    try (move r2).reply(body: &msg, len: 1)
    msg[0] = 33
    try (move r3).reply(body: &msg, len: 1)
    msg[0] = 11
    try (move r1).reply(body: &msg, len: 1)

    let a = try resolve_one(move c1)
    let b = try resolve_one(move c2)
    let c = try resolve_one(move c3)
    print("SOS oneshot: fifo replies a={} b={} c={}\n", a, b, c)
    return
}

/// **THE RING, COUNTED AROUND ONE UNSETTLED EXCHANGE** — the lifecycle change
/// made visible.
///
/// The held message is TAKEN, so its bytes are already in this process's buffer
/// and unit 1 would have given the slot back; unit 2's slot is still spent,
/// because the reply has nowhere else to live. So the free depth is one short,
/// and discharging the exchange restores it. The program never names
/// `PIPE_INFLIGHT`: what it asserts is the DIFFERENCE.
func ring_around_one(inlet: &PipeInlet,
                     outlet: &PipeOutlet) -> Result<Void, SosStatus> {
    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 7

    let claim = try inlet.post(body: &msg, len: 1)
    let obligation = try take_one(&outlet)

    let busy = try fill(&inlet, &msg)
    print("SOS oneshot: depth with one in flight={}\n", busy)

    let back = try drain(&outlet)
    if back != busy { return BUG }

    // ...and now the held exchange settles: the obligation is discharged and the
    // claim takes its answer, so the slot goes back and the ring is whole again.
    msg[0] = 8
    try (move obligation).reply(body: &msg, len: 1)
    let _ = try (move claim).resolve()

    let whole = try fill(&inlet, &msg)
    print("SOS oneshot: depth settled={}\n", whole)
    return
}

/// **POST AND GIVE THE CLAIM UP — §2.1's TELL IDIOM.** The message is staged and
/// the client says at once that it does not want the answer, so the exchange
/// settles as soon as the server discharges. It is what the counting loops use,
/// because they are about the RING and not about the pair.
func tell(inlet: &PipeInlet, body: &[UInt8; PIPE_BODY_BYTES],
          len: UInt) -> Result<Bool, SosStatus> {
    let claim = try inlet.post(body: &body, len: len) catch {
        match error {
            case WouldBlock -> { return false },
            case _ -> { return error },
        }
    }
    let _ = move claim
    return true
}

/// Take, and discharge the obligation by dropping it — the mirror of `tell`.
func take_and_drop(outlet: &PipeOutlet) -> Result<Bool, SosStatus> {
    let got = try outlet.take() catch {
        match error {
            case WouldBlock -> { return false },
            case _ -> { return error },
        }
    }
    let (_, request) = move got
    let _ = move request
    return true
}

/// Post until the kernel refuses, and hand back how many went — the ring's FREE
/// depth, counted rather than named. The messages are tells, so nothing this
/// leaves behind holds a slot waiting for a reply.
func fill(inlet: &PipeInlet, body: &[UInt8; PIPE_BODY_BYTES]) -> Result<UInt, SosStatus> {
    var depth: UInt = 0
    var filling = true
    var rounds: Int = 0
    while filling && rounds < MAX_ROUNDS {
        rounds = rounds + 1
        let put = try tell(&inlet, &body, 1)
        if put {
            depth = depth + 1
        } else {
            filling = false
        }
    }
    return depth
}

/// Take everything staged, discharging as it goes.
func drain(outlet: &PipeOutlet) -> Result<UInt, SosStatus> {
    var took: UInt = 0
    var going = true
    var rounds: Int = 0
    while going && rounds < MAX_ROUNDS {
        rounds = rounds + 1
        let got = try take_and_drop(&outlet)
        if got {
            took = took + 1
        } else {
            going = false
        }
    }
    return took
}

/// Take one message and hand its obligation back, refusing an empty ring as an
/// error — every take reached this way has a message waiting by construction, so
/// an absence is a bug in the case rather than a poll.
func take_one(outlet: &PipeOutlet) -> Result<PipeRequest, SosStatus> {
    let got = try outlet.take()
    let (_, request) = move got
    return move request
}

/// Resolve one claim and answer the first byte of its reply — which is what the
/// three-in-flight row asserts, one digit per exchange.
///
/// **IT TAKES THE CLAIM BY VALUE**, because `resolve` consumes it (`designs/010`
/// ruling 12(b)): a `&var` parameter could not be moved out of, so the helper's
/// signature carries the same single-use the op does and the call sites spell
/// `resolve_one(move c1)`.
func resolve_one(claim: PipeReply) -> Result<UInt, SosStatus> {
    let answer = try (move claim).resolve()
    return answer.bytes[0] as UInt
}

/// One line to the console, out of a phase that holds no `System`.
///
/// A phase gets the two connection ends and nothing else, because that is all
/// any of them is about — so the one line that carries no format arguments goes
/// through the runtime's own writer rather than through a `System` handle
/// threaded down for it. `print` of a literal writes the bytes and reserves no
/// message scratch, which is the property this whole file is arranged around.
func write_line(text: String) -> Int {
    print("{}", text)
    0
}
