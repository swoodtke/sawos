// One-shot pair, end to end in one process (spec §2.1).
//
// Request/reply is a primitive, and this is the smallest program that proves
// it. Root creates a connection, holds both ends, and plays both sides of every
// exchange: no second process, no waitability, nothing parked. The transcript
// is a list of properties:
//
//   request len=3 b=65,66,67   a take hands over the message and the obligation
//   pending is not ready       `ready()` before the reply answers false and
//                              consumes nothing
//   reply len=2 b=90,89        the reply bytes came back through the same slot
//   zero reply len=0           a reply that carries no data is still an answer
//   fifo replies a=11 b=22 c=33  three exchanges in flight at once, answered
//                              out of order; each claim got its own reply
//   depth with one in flight=15  one unsettled exchange costs one ring slot
//   depth settled=16           ...and settling it gives the slot back
//
// The last two rows are the sharpest claim: a slot carries the reply back, so
// it recycles only when the exchange settles, which makes `PIPE_INFLIGHT` a
// bound on awaiting-reply exchanges. This program never names the number: it
// holds one exchange open, posts until the kernel refuses and counts (15), then
// discharges the held exchange and counts again (16). A kernel that freed the
// slot at the take would print 16 both times.
//
// A ring with no free slot and an exchange with no reply yet are both "not
// right now", cleared by the other side. A full ring answers `Err(WouldBlock)`,
// which `tell` below turns into `false`; a pending resolve parks instead of
// answering. A dead peer is the terminal error.
//
// One phase per function, because of the frame. Root's stack grant is
// `hal.ROOT_STACK_LEN` and every `print` with format
// arguments reserves message scratch in its own frame (the message is assembled
// in stack scratch so a panic survives an exhausted allocator). A `_start`
// holding every phase would hold every phase's scratch at once, which
// overflowed the grant on the 64-bit profile and not on the 32-bit one. So each
// phase is a function that reports by returning a status and `_start` prints
// once.
//
// Every loop is bounded: a poll loop with no ceiling is a hang the deadlock
// report cannot see.

import sos.{System, Process, PipeInlet, PipeOutlet, PipeReply, PipeRequest,
            SosStatus, PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// The ceiling on every counting loop. Comfortably past any staging ring this
/// kernel could have — the point is that the loop terminates whatever the kernel
/// answers, not that the number is tight.
static MAX_ROUNDS: Int = 64

/// What a phase answers when its own arithmetic is wrong. A refusal in this
/// case that is not the kernel's is a bug in the case, and it needs a value to
/// carry out of a `Result`, so it borrows the one status that can never
/// legitimately reach `_start` from any call these phases make. It is the
/// test's internal assertion vocabulary, not a claim about the kernel.
static BUG: SosStatus = SosStatus.Revoked

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS oneshot: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let pair = try proc.pipe_create() catch {
        print("SOS oneshot: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (inlet, outlet) = move pair
    let _ = system.debug_print("SOS oneshot: created\n")

    try round_trip(&inlet, &outlet) catch {
        print("SOS oneshot: round trip failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try zero_reply(&proc, &inlet, &outlet) catch {
        print("SOS oneshot: zero reply failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try three_in_flight(&inlet, &outlet) catch {
        print("SOS oneshot: three in flight failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try ring_around_one(&inlet, &outlet) catch {
        print("SOS oneshot: ring count failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    print("SOS oneshot: done\n")
    let _ = proc.exit(EXIT_OK)
}

/// The round trip both ways, and the pending answer in the middle of it.
///
/// A post answers a claim; a take answers the message and the obligation to
/// reply to it; a reply lands where that claim is waiting. The bytes are
/// asserted at each end, because a status alone would not show that either copy
/// carried anything.
func round_trip(inlet: &PipeInlet, outlet: &PipeOutlet) -> Result<Void, SosStatus> {
    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 65
    msg[1] = 66
    msg[2] = 67

    var claim = try inlet.post(body: &msg, len: 3)

    let taken = try outlet.take()
    let (arrived, request) = move taken
    let obligation = move request
    print("SOS oneshot: request len={} b={},{},{}\n", arrived.len,
          arrived.bytes[0] as UInt, arrived.bytes[1] as UInt,
          arrived.bytes[2] as UInt)

    // The pending question is `ready()` and it answers false. A `resolve`
    // here would park, because the exchange is taken and the server has not
    // answered, which is the state the question exists for. `ready()`
    // consumes nothing, so the claim below is the same claim, and readiness
    // is monotonic: a false can only become a true.
    let ready = try claim.ready()
    if ready { return BUG }
    let _ = write_line("SOS oneshot: pending is not ready\n")

    msg[0] = 90
    msg[1] = 89
    try (move obligation).reply(body: &msg, len: 2)

    // The level is up now, so the resolve returns without parking. The move
    // spends the claim: a second use of this binding is a compile error.
    let got = try (move claim).resolve()
    print("SOS oneshot: reply len={} b={},{}\n", got.len,
          got.bytes[0] as UInt, got.bytes[1] as UInt)
    return
}

/// A reply of zero bytes is still an answer. Nothing has to keep it apart from
/// "no reply yet", because a pending resolve parks rather than answering. The
/// request side is the same: a zero-length message is `Ok`, an empty ring is
/// `Err(WouldBlock)`.
///
/// This is also the phase the trap count is taken over, because it is the
/// smallest complete exchange in the file: post, take, reply, resolve, and not
/// one printed byte between the brackets. Every printed byte is a syscall, so
/// a measured window containing a `print` counts the prose.
func zero_reply(proc: &Process, inlet: &PipeInlet,
                outlet: &PipeOutlet) -> Result<Void, SosStatus> {
    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 5

    let before = try proc.stats()
    let claim = try inlet.post(body: &msg, len: 1)
    let obligation = try take_one(&outlet)
    try (move obligation).reply(body: &msg, len: 0)
    let zero = try (move claim).resolve()
    // The closing read is charged at trap entry like any other, so:
    //
    //     delta = post + take + reply + resolve + this read = 4 + 1 = 5
    //
    // Nothing releases inside the bracket: `claim` and `obligation` are owning
    // wrappers, and a wrapper still holding a live word issues a release (a
    // trap) when it falls out of scope. Both are spent by consuming ops
    // (`resolve`, `reply`), so no release is charged and the arithmetic is the
    // exchange alone. The read sits before the end of the function so that a
    // scope-exit release, were there one, would fall outside the window.
    let after = try proc.stats()

    print("SOS oneshot: zero reply len={}\n", zero.len)
    print("SOS oneshot: the exchange cost {} traps\n",
          after.syscalls - before.syscalls)
    return
}

/// Three exchanges in flight at once, answered out of order; each claim
/// resolves to its own reply.
///
/// A design that kept one reply slot per connection rather than per exchange
/// would print the same digit three times here; one that keyed replies by queue
/// position would print them permuted, because the obligations are discharged
/// 2, 3, 1. An exchange is not a queue position.
func three_in_flight(inlet: &PipeInlet,
                     outlet: &PipeOutlet) -> Result<Void, SosStatus> {
    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]

    msg[0] = 1
    let c1 = try inlet.post(body: &msg, len: 1)
    msg[0] = 2
    let c2 = try inlet.post(body: &msg, len: 1)
    msg[0] = 3
    let c3 = try inlet.post(body: &msg, len: 1)

    // The obligations come out in the order the messages went in.
    let r1 = try take_one(&outlet)
    let r2 = try take_one(&outlet)
    let r3 = try take_one(&outlet)

    msg[0] = 22
    try (move r2).reply(body: &msg, len: 1)
    msg[0] = 33
    try (move r3).reply(body: &msg, len: 1)
    msg[0] = 11
    try (move r1).reply(body: &msg, len: 1)

    let a = try resolve_one(move c1)
    let b = try resolve_one(move c2)
    let c = try resolve_one(move c3)
    print("SOS oneshot: fifo replies a={} b={} c={}\n", a, b, c)
    return
}

/// The ring, counted around one unsettled exchange.
///
/// The held message is taken, so its bytes are already in this process's
/// buffer, but its slot is still spent because the reply has nowhere else to
/// live. So the free depth is one short, and discharging the exchange restores
/// it. The program never names `PIPE_INFLIGHT`: it asserts the difference.
func ring_around_one(inlet: &PipeInlet,
                     outlet: &PipeOutlet) -> Result<Void, SosStatus> {
    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 7

    let claim = try inlet.post(body: &msg, len: 1)
    let obligation = try take_one(&outlet)

    let busy = try fill(&inlet, &msg)
    print("SOS oneshot: depth with one in flight={}\n", busy)

    let back = try drain(&outlet)
    if back != busy { return BUG }

    // The held exchange settles: the obligation is discharged and the claim
    // takes its answer, so the slot goes back and the ring is whole again.
    msg[0] = 8
    try (move obligation).reply(body: &msg, len: 1)
    let _ = try (move claim).resolve()

    let whole = try fill(&inlet, &msg)
    print("SOS oneshot: depth settled={}\n", whole)
    return
}

/// Post and give the claim up (§2.1's tell idiom). The client says at once that
/// it does not want the answer, so the exchange settles as soon as the server
/// discharges. The counting loops use it because they are about the ring, not
/// the pair.
func tell(inlet: &PipeInlet, body: &[UInt8; PIPE_BODY_BYTES],
          len: UInt) -> Result<Bool, SosStatus> {
    let claim = try inlet.post(body: &body, len: len) catch {
        match error {
            case WouldBlock -> { return false },
            case _ -> { return error },
        }
    }
    let _ = move claim
    return true
}

/// Take, and discharge the obligation by dropping it — the mirror of `tell`.
func take_and_drop(outlet: &PipeOutlet) -> Result<Bool, SosStatus> {
    let got = try outlet.take() catch {
        match error {
            case WouldBlock -> { return false },
            case _ -> { return error },
        }
    }
    let (_, request) = move got
    let _ = move request
    return true
}

/// Post until the kernel refuses, and hand back how many went: the ring's free
/// depth, counted rather than named. The messages are tells, so nothing this
/// leaves behind holds a slot waiting for a reply.
func fill(inlet: &PipeInlet, body: &[UInt8; PIPE_BODY_BYTES]) -> Result<UInt, SosStatus> {
    var depth: UInt = 0
    var filling = true
    var rounds: Int = 0
    while filling && rounds < MAX_ROUNDS {
        rounds = rounds + 1
        let put = try tell(&inlet, &body, 1)
        if put {
            depth = depth + 1
        } else {
            filling = false
        }
    }
    return depth
}

/// Take everything staged, discharging as it goes.
func drain(outlet: &PipeOutlet) -> Result<UInt, SosStatus> {
    var took: UInt = 0
    var going = true
    var rounds: Int = 0
    while going && rounds < MAX_ROUNDS {
        rounds = rounds + 1
        let got = try take_and_drop(&outlet)
        if got {
            took = took + 1
        } else {
            going = false
        }
    }
    return took
}

/// Take one message and hand its obligation back, refusing an empty ring as an
/// error. Every take reached this way has a message waiting by construction, so
/// an absence is a bug in the case rather than a poll.
func take_one(outlet: &PipeOutlet) -> Result<PipeRequest, SosStatus> {
    let got = try outlet.take()
    let (_, request) = move got
    return move request
}

/// Resolve one claim and answer the first byte of its reply, which is what the
/// three-in-flight row asserts, one digit per exchange.
///
/// It takes the claim by value, because `resolve` consumes it: a `&var`
/// parameter could not be moved out of, so the signature carries the op's
/// single use and call sites spell `resolve_one(move c1)`.
func resolve_one(claim: PipeReply) -> Result<UInt, SosStatus> {
    let answer = try (move claim).resolve()
    return answer.bytes[0] as UInt
}

/// One line to the console, out of a phase that holds no `System`.
///
/// A phase gets the two connection ends and nothing else, so the one line that
/// carries no format arguments goes through the runtime's own writer rather
/// than a `System` handle threaded down for it. `print` of a literal writes the
/// bytes and reserves no message scratch, the property this file is arranged
/// around.
func write_line(text: String) -> Int {
    print("{}", text)
    0
}
