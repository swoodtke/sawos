// Blocking send written out of the primitives (spec §2.1).
//
// A blocking send is waiting on the claim, and a timeout is the same wait with
// a Timer on the same Waiter. This program is that composition, inline. No
// wrapper type is built over the timeout form: a timeout the kernel genuinely
// needs would be an op. The plain blocking send is the fused `PipeInlet.send`
// (one `Call`), which takes no timeout; it appears after the first round trip
// as the comparison.
//
//   post           stage the message, take the claim
//   add(reply:)    attach the claim, one-shot
//   wait           park; the record carries the answer's bytes
//   (timeout leg)  a Timer on the same Waiter; the key the wait answers with
//                  says which of the two won
//
// In the first round trip only root parks. The child runs once root blocks in
// its wait, finds the message already readable on its outlet, takes it and
// answers; that reply wakes root:
//
//   SOS childserver: replied         the child ran when root blocked, took the
//                                    message, and answered
//   SOS sendmanual: reply len=4 b=80,79,78,71
//                                    root parked on the claim and woke with
//                                    `PONG` in the wait record; no `resolve`
//                                    is involved
//   SOS sendmanual: timed out        a second connection nobody serves: the
//                                    Timer's key came back, not the claim's
//   SOS sendmanual: after cancel ... the claim was ours the whole time, so
//                                    dropping it is the cancellation, which
//                                    the server's later `reply` is told about
//
// Root's first wait cannot complete before the child runs, so the transcript's
// order shows the child's reply woke root. A polling implementation would print
// the same bytes with none of that blocking.
//
// The room leg is exercised on the unserved connection: the ring is filled
// first, so the poster is refused and has to park on the inlet's room-to-post
// level before it can post. `post` answers `Err(WouldBlock)` for that refusal,
// and this program acts on it.
//
// One phase per function, within the stack ceiling.

import sos.{System, Process, Clock, ClockType, Timer, Waiter, PipeInlet,
            PipeOutlet, PipeReply, PipeRequest, WaitResult, WaitPayload,
            InletLevel, AttachMode, SosStatus, SystemRight,
            PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// Root's config, and the whole of the contract with the child. `child-server`
/// expects exactly these words; the kernel supplies no meaning for either.
static TAG_BOOT: UInt = 7
static TAG_OUTLET: UInt = 12

/// What a child of this launcher may ask its System object for: print, learn
/// its own Process object, and pass a handle on. `Transfer` is the ticket the
/// give itself checks.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// The composition's own keys. A client that writes the composition inline owns
/// its Waiter's key space, and these are the two words it spends: the claim
/// (and, on the unserved connection, the room level; they never overlap in
/// time, so one key serves both) and the timer. They appear nowhere else, so a
/// record naming one names an attachment this program made.
static KEY_CLAIM: UInt = 21
static KEY_TIMER: UInt = 22

/// The request's length and bytes: `PING`.
static PING_LEN: UInt = 4

/// The unserved connection's one-byte message length.
static ONE: UInt = 1

/// Five milliseconds. Long enough that a working machine never trips it on the
/// served connection, short enough that the unserved one gives up promptly.
static TIMEOUT_NS: UInt64 = 5_000_000

/// The ceiling on the fill loop. The point is that it terminates whatever the
/// kernel answers, not that the number is tight.
static MAX_ROUNDS: Int = 64

static BUG: SosStatus = SosStatus.Revoked

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS sendmanual: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    try round_trip(&system, &proc) catch {
        print("SOS sendmanual: round trip failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try timed_out(&system, &proc) catch {
        print("SOS sendmanual: timeout leg failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    print("SOS sendmanual: done\n")
    let _ = proc.exit(EXIT_OK)
}

/// The blocking round trip, across a process boundary, in three calls.
///
/// Root creates the connection, gives the server end to a child, and then does
/// the composition by hand: post, attach the claim one-shot, wait. Nothing else
/// in root is runnable at the wait, so the kernel runs the child; the child
/// parks on its outlet, is woken by the post that already happened
/// (level-triggered, so the order does not matter), takes, and replies. That
/// reply wakes root, and the bytes are in the record it wakes with.
///
/// The attach is non-consuming: the timeout leg below must be able to keep the
/// claim, so both legs use the same shape. `give` is the multiplexer's tool,
/// not this one's.
func round_trip(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var image = try proc.boot_handle_next()
    var dest = try proc.boot_handle_next()
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem, memory: &dest_mem)

    let pair = try proc.pipe_create()
    let (inlet, outlet) = move pair
    let waiter = try proc.waiter_create()

    let for_child = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move for_child, tag: TAG_BOOT)
    // The server end leaves root entirely. Root keeps the inlet and nothing
    // else, so it can only learn anything from the child's reply.
    try child.give(outlet: move outlet, tag: TAG_OUTLET)
    let _ = system.debug_print("SOS sendmanual: gave the outlet\n")

    try child.start(boot_tag: TAG_BOOT)

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 80
    msg[1] = 73
    msg[2] = 78
    msg[3] = 71

    // The measured window opens here. The three calls below are the whole
    // composition and nothing else may sit inside the bracket (no print, no
    // mint, no wrapper falling out of scope), or the count stops being
    // arithmetic. Every printed byte is one syscall, so a `print` in the window
    // would count the prose instead of the composition.
    let before = try proc.stats()

    // 1. Post. The ring is fresh, so it cannot refuse; the room leg is
    //    exercised on the unserved connection below.
    var claim = try inlet.post(body: &msg, len: PING_LEN)

    // 2. Attach the claim, one-shot: a reply happens once.
    try waiter.add(reply: &claim, key: KEY_CLAIM, mode: AttachMode.OneShot)

    // 3. Wait. This blocks, and what comes back is the answer itself.
    let woke = try waiter.wait()

    // The window closes here, with its own trap inside the count. `ktrap`
    // charges the syscall column at trap entry, ahead of the dispatch, so this
    // reading includes the call that took it:
    //
    //     delta = post + attach + wait + this read = 3 + 1 = 4
    //
    // The wait parked, and that is the claim: root blocked, the child was
    // scheduled, took the message and replied, yet root paid one trap for all
    // of it, because a park is one syscall however long it parks (the wake
    // writes the answer into root's frame; it does not re-enter the kernel
    // through the door).
    let after = try proc.stats()

    if woke.key != KEY_CLAIM { return BUG }
    print("SOS sendmanual: reply len={} b={},{},{},{}\n", reply_len(&woke),
          reply_byte(&woke, 0), reply_byte(&woke, 1), reply_byte(&woke, 2),
          reply_byte(&woke, 3))
    print("SOS sendmanual: the round trip cost {} traps\n",
          after.syscalls - before.syscalls)

    // The same exchange the other way: same connection, same server, same four
    // bytes each way; only the spelling differs. `child-server` answers twice
    // for exactly this reason.
    //
    // The second window is as empty as the first: one call, one closing read,
    // and no print between them.
    let fused_before = try proc.stats()
    let answer = try inlet.send(body: &msg, len: PING_LEN)
    let fused_after = try proc.stats()

    if answer.len != PING_LEN { return BUG }
    print("SOS sendmanual: fused reply len={} b={},{},{},{}\n", answer.len,
          answer.bytes[0], answer.bytes[1], answer.bytes[2], answer.bytes[3])

    // The companion row. Each delta carries its own closing `stats()` trap, so
    // subtracting one from each leaves the ops the caller wrote: post + attach
    // + wait against `send`, three against one, measured by the same process
    // against the same server in the same boot.
    //
    // The fused call also mints nothing: the composition holds a `PipeReply`
    // handle for the length of the exchange and the fused path holds no table
    // row at all, which the trap count does not show.
    print("SOS sendmanual: ops manual={} fused={}\n",
          (after.syscalls - before.syscalls) - 1,
          (fused_after.syscalls - fused_before.syscalls) - 1)
    return
}

/// Nobody serves this connection, so the timer wins, and the claim stays the
/// caller's the whole time.
///
/// This is the timeout leg written out: the same wait, with a Timer attached
/// to the same Waiter. The kernel learns nothing about durations; `Timer.arm`
/// is the op that knows.
///
/// The key resolves the race (§2.2). Exactly one of the two attachments
/// delivered, and a one-shot delivery detaches, so the loser is the one still
/// attached and the only one left to remove. That bookkeeping is the caller's.
///
/// The room leg runs first. The ring is filled with tells before the real
/// post, so the post is refused and the composition has to park on the
/// inlet's room-to-post level before it has a claim at all. `Err(WouldBlock)`
/// is a level to wait on rather than a failure to give up on.
func timed_out(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    let pair = try proc.pipe_create()
    let (inlet, outlet) = move pair
    let waiter = try proc.waiter_create()
    let clock = try system.clock_get(type: ClockType.Monotonic)
    let timer = try clock.timer_create()

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    var buf: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 1

    // 0. The room leg. Fill the ring so the post below is refused, take one
    //    message and drop its obligation so a slot settles, then park on the
    //    inlet's level to be told there is space again.
    let filled = try fill(&inlet, &msg)
    // The refusal arrives on the error channel, so the arm that proves the ring
    // is full is a `WouldBlock` match.
    match inlet.post(body: &msg, len: ONE) {
        case Ok(claim) -> {
            let _ = move claim
            return BUG
        },
        case Err(e) -> {
            match e {
                case WouldBlock -> {},
                case _ -> { return e },
            }
        },
    }
    let took = try take_and_drop(&outlet, &var buf)
    if not took { return BUG }
    try waiter.add(inlet: &inlet, key: KEY_CLAIM, mode: AttachMode.OneShot)
    let room = try waiter.wait()
    print("SOS sendmanual: filled={} then room says {}\n", filled,
          level_name(&room))

    // 1. Post, now that the level said there is space.
    var claim = try inlet.post(body: &msg, len: ONE)

    // 2. Attach both: the claim, and the Timer that bounds the wait.
    try waiter.add(reply: &claim, key: KEY_CLAIM, mode: AttachMode.OneShot)
    try waiter.add(timer: &timer, key: KEY_TIMER, mode: AttachMode.OneShot)
    try timer.arm(after_ns: TIMEOUT_NS)

    // 3. Wait, and let the key say which won.
    let woke = try waiter.wait()
    if woke.key == KEY_CLAIM {
        let _ = system.debug_print("SOS sendmanual: an unserved pipe replied\n")
        return BUG
    }
    // The Timer won. Its own attachment detached at the delivery; the claim's
    // is still live, so the caller removes it. The claim itself is still ours
    // (§2.1's `TimedOut(pending:)` shape).
    try waiter.remove(KEY_CLAIM)
    let _ = system.debug_print("SOS sendmanual: timed out\n")

    // The cancellation. Dropping the live claim is how §2.1 says a client gives
    // up; it needs no verb.
    let _ = move claim

    // Now play the server on the connection the client gave up on. The message
    // is still staged — abandoning a claim does not un-send what was sent — so
    // the take succeeds and the reply is what carries the news.
    let got = try outlet.take()
    let (_, request) = move got
    let obligation = move request
    match (move obligation).reply(body: &msg, len: ONE) {
        case Ok(_) -> {
            let _ = system.debug_print("SOS sendmanual: a cancelled claim took a reply\n")
            return BUG
        },
        case Err(e) -> { print("SOS sendmanual: after cancel {}\n", e) },
    }

    let _ = try drain(&outlet, &var buf)
    return
}

/// How many bytes the reply in this record carries.
func reply_len(r: &WaitResult) -> UInt {
    match r.what {
        case Reply(outcome) -> outcome.len(),
        case _ -> 0,
    }
}

/// Byte `i` of it, read through a borrow, which is what makes `PipeMsg` being
/// `NoCopy` cost a caller nothing.
func reply_byte(r: &WaitResult, i: Int) -> UInt {
    match r.what {
        case Reply(outcome) -> outcome.byte(i) as UInt,
        case _ -> 0,
    }
}

/// Which of the inlet level's two readings this record carries.
func level_name(r: &WaitResult) -> String {
    match r.what {
        case Room(state) -> {
            match state {
                case Room -> "there is space",
                case PeerGone -> "the peer is gone",
            }
        },
        case _ -> "not a room record",
    }
}

/// Post and give the claim up (§2.1's tell idiom), which the fill loop uses
/// because it is about the ring and not about the pair.
func tell(inlet: &PipeInlet, body: &[UInt8; PIPE_BODY_BYTES],
          len: UInt) -> Result<Bool, SosStatus> {
    let claim = try inlet.post(body: &body, len: len) catch {
        match error {
            case WouldBlock -> { return false },
            case _ -> { return error },
        }
    }
    let _ = move claim
    return true
}

/// Take, and discharge the obligation by dropping it — the mirror of `tell`.
func take_and_drop(outlet: &PipeOutlet,
                   into: &var [UInt8; PIPE_BODY_BYTES]) -> Result<Bool, SosStatus> {
    let got = try outlet.take() catch {
        match error {
            case WouldBlock -> { return false },
            case _ -> { return error },
        }
    }
    let (_, request) = move got
    let _ = move request
    return true
}

/// Post until the kernel refuses, and hand back how many went.
func fill(inlet: &PipeInlet, body: &[UInt8; PIPE_BODY_BYTES]) -> Result<UInt, SosStatus> {
    var depth: UInt = 0
    var filling = true
    var rounds: Int = 0
    while filling && rounds < MAX_ROUNDS {
        rounds = rounds + 1
        let put = try tell(&inlet, &body, ONE)
        if put {
            depth = depth + 1
        } else {
            filling = false
        }
    }
    return depth
}

/// Take everything staged, discharging as it goes.
func drain(outlet: &PipeOutlet,
           into: &var [UInt8; PIPE_BODY_BYTES]) -> Result<UInt, SosStatus> {
    var took: UInt = 0
    var going = true
    var rounds: Int = 0
    while going && rounds < MAX_ROUNDS {
        rounds = rounds + 1
        let got = try take_and_drop(&outlet, &var into)
        if got {
            took = took + 1
        } else {
            going = false
        }
    }
    return took
}
