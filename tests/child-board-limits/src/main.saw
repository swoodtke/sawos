// Test child: a child at its board's mapping default maps to the board's
// grant budget.
//
//   SOS childboardlimits: maps=4 quota=1
//
// Each record is a page its launcher gave it, and each is mapped into this
// process once, through its own Process handle: two rows of one process never
// overlap (spec §2.5), so a row spends a page of its own. The launcher gives
// one page more than this process's mapping row, so the loop ends at a
// refusal, and `quota=1` says it was the quota's. The row is the board's
// default, the grant budget's rows less the ones this image spent, so the
// refusal comes with every row of the budget installed: a map meeting the
// budget itself with quota left would be the kernel stop `install_row`
// asserts against, and the line would never print.
//
// The exit code is the map count, so the launcher reads the same fact through
// the spec.md §8 status word that the console line states.

import sos.{System, Process, Memory, Mapping, MapAccess, SosStatus}

/// Read and write, which is what any scratch region wants.
static RW: UInt32 = MapAccess.Read | MapAccess.Write

/// What it ends with when the kernel's answers were not the shape this case
/// claims.
static EXIT_MISMATCH: UInt = 97

static YES: UInt = 1
static NO: UInt = 0

func flag(b: Bool) -> UInt {
    if b { YES } else { NO }
}

/// Was this refusal the policy one? Matched by name rather than by number, so
/// the claim survives a renumbering of the wire table.
func is_quota(status: SosStatus) -> Bool {
    match status {
        case QuotaExceeded -> true,
        case _ -> false,
    }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        print("SOS childboardlimits: no process handle: {}\n", error)
        return
    }

    var maps: UInt = 0
    var quota = false
    var other = false
    while not quota && not other {
        var record = try proc.boot_handle_next() catch {
            print("SOS childboardlimits: no page after {} maps: {}\n", maps, error)
            let _ = proc.exit(EXIT_MISMATCH)
            return
        }
        guard let region = record.take_memory() else {
            print("SOS childboardlimits: the record is not a region\n")
            let _ = proc.exit(EXIT_MISMATCH)
            return
        }
        match proc.map(memory: &region, access: RW) {
            case Ok(_) -> { maps = maps + 1 },
            case Err(status) -> {
                if is_quota(status) {
                    quota = true
                } else {
                    other = true
                }
            },
        }
    }

    print("SOS childboardlimits: maps={} quota={}\n", maps, flag(quota))
    if other {
        let _ = proc.exit(EXIT_MISMATCH)
    }
    let _ = proc.exit(maps)
}
