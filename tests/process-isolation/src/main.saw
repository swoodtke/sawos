// Isolation: one process cannot touch another's memory.
//
// This case makes that a claim rather than an assumption. Root launches
// `child-poke`, which stores a word into root's own stack; the transcript
// reads:
//
//   SOS isolation: started
//   SOS: fault <store/data-abort> cause=... epc=... tval=...
//   SOS: process teardown ... process=1
//   SOS isolation: root survived child status=131072
//   SOS isolation: done
//
// What the fault line proves: the child's store names an address inside root's
// granted region. It faults because the switch into the child reloaded the
// protection domain (root's rows out, the child's rows in). Neither profile
// could fake that: riscv32 spends all four PMP regions on a three-segment
// image, and arm64's grant window is a single shared EL0 permission map. A
// kernel that left root's grants installed would let the store land, the child
// would spin, and this line would not be here.
//
// So the assertion is the presence of a hardware fault, and a broken reload
// fails by omission rather than by a wrong value, which is the failure mode
// worth engineering for, because a wrong value can be argued with.
//
// `child status=131072` is `Faulted` with code 0: kind 2 in the high half
// (2 * 65536), and zero in the low, because a hardware fault carries no
// `FaultReason`; the cause is in the console line, not in the status word.
// The lifecycle case differs: its child died in a syscall and reports
// `131073`.
//
// Root parks on a generous timer for the same reason the lifecycle case does:
// this image's kernel arms no tick, so the wait below is the only way root
// gives the processor up and the timer is the only way it gets it back.

import sos.{System, Process, Memory, BootHandle, Clock, ClockType, Timer,
            Waiter, SosStatus}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

static KEY: UInt = 88

/// Twenty milliseconds — three orders of magnitude more than the child needs to
/// be scheduled and take one fault.
static PARK_NS: UInt64 = 20_000_000

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS isolation: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // Row 0 is the child's image blob, row 1 the RAM it runs in: this build's
    // config, which is root's business and never the kernel's.
    var image = try proc.boot_handle_next() catch {
        print("SOS isolation: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS isolation: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The record hands the region over; see `process-lifecycle` for why
    // `take_memory` is the one way out.
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS isolation: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try child.start() catch {
        print("SOS isolation: start failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS isolation: started\n")

    let clock = try system.clock_get(type: ClockType.Monotonic) catch {
        print("SOS isolation: no clock: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let waiter = try proc.waiter_create() catch {
        print("SOS isolation: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let timer = try clock.timer_create() catch {
        print("SOS isolation: no timer: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try waiter.add(&timer, KEY) catch {
        print("SOS isolation: attach failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try timer.arm(after_ns: PARK_NS) catch {
        print("SOS isolation: arm failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try waiter.wait() catch {
        print("SOS isolation: wait failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let status = try child.get_status() catch {
        print("SOS isolation: status failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS isolation: root survived child status={}\n", status)

    // The same handle answers how the child spent its life. `syscalls=0
    // faults=1` is `child-poke`'s whole biography in two numbers: it holds no
    // handles, so it never reached the kernel through the syscall door, and the
    // one trap it took was the store into its neighbour's memory that the
    // hardware refused. This is the only shape in which the fault column is
    // observable: a faulting process is not around to ask about itself, so the
    // reader has to be the supervisor whose handle held the slot open.
    //
    // It is also the sharp end of the counting rule: a bad syscall is charged
    // to the syscall column even though it ends the process, because the
    // columns are keyed by how the machine entered the kernel. `death_fault`'s
    // child asserts that other half, `syscalls=1 faults=0`, the exact mirror of
    // this line.
    let cost = try child.stats() catch {
        print("SOS isolation: stats failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS isolation: child syscalls={} faults={}\n",
          cost.syscalls, cost.faults)

    print("SOS isolation: done\n")
    let _ = proc.exit(EXIT_OK)
}
