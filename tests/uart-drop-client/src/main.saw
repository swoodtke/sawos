//! A client that drops the claim of a read its UART driver answers from its
//! buffer, then reads on.
//!
//! The client reads one byte, then asks the driver how many bytes it has
//! buffered until it says at least one: the next typed byte has reached the
//! driver, and only this client reads, so it stays there. The client then
//! tells a `Read` (posts it and drops the claim) and calls a `Sync`. The
//! connection is served in order, so when the `Sync` answers, the driver has
//! answered that read from its buffer and the reply went nowhere. The byte it
//! was answered with must go back to the buffer, so the reads after it get
//! every byte that was typed: the client writes them back as one line.
//!
//! How many times it asks depends on how soon the emulator hands the device
//! the next byte, and nothing here depends on that.
//!
//! The script runs on a thread at `Rt1`, which its declaration's full band map
//! puts above the driver's `Rt0`. A post readies the driver below the poster,
//! so the told `Read`'s claim is dropped before the driver takes it, and its
//! answer goes nowhere; a driver above the poster would take it, and answer
//! it, between the post and the drop.

import sos.{System, BootSet, Priority, Process, SosStatus}
import uartproto.{Uart, UartBody, UartError, UartOp}
import uartpipe.{PipeTransport, uart}

/// The client end of the driver's connection, as `process.toml` declares it.
static TAG_UART: UInt = 2

/// How many bytes the harness types.
static TYPED: Int = 4

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

func echo(u: &var Uart<PipeTransport>) -> Result<Void, UartError> {
    var got: [UInt8; TYPED] = [0; TYPED]
    try u.mark()
    got[0] = try u.read()
    var buffered = try u.pending()
    while buffered < 1 {
        buffered = try u.pending()
    }
    var body = UartBody.empty()
    let n = body.bare(UartOp.Read)
    try u.transport.tell(&body.bytes, n)
    try u.sync()
    var i = 1
    while i < TYPED {
        got[i] = try u.read()
        i = i + 1
    }
    try u.write("SOS uartdrop: after a dropped read, ")
    i = 0
    while i < TYPED {
        try u.write_byte(got[i])
        i = i + 1
    }
    try u.write("\n")
    try u.sync()
    return
}

/// The thread's stack, in words.
static STACK_WORDS: Int = 2048
unsafe static var STACK: [UInt; STACK_WORDS] = [0; STACK_WORDS]

/// What `_start` hands the thread, by its address: the client.
struct Shared {
    u: Uart<PipeTransport>,
}

extension Shared: NoCopy {}

/// The thread: `at` is `_start`'s `Shared`.
func script(at: UInt) unsafe sync -> UInt {
    let s = at as UnsafePointer<Shared>
    try echo(&var s[0].u) catch {
        print("SOS uartdrop: stopped: {}", error)
        return EXIT_FAILED
    }
    EXIT_OK
}

/// Runs `script` on a thread at `Rt1` and joins it; answers its exit code.
func run(proc: &Process, shared: &var Shared) unsafe -> Result<UInt, SosStatus> {
    let top = ((&var STACK) as UnsafePointer<UInt>) as UInt +
              (STACK_WORDS as UInt) * (sizeof<UInt>() as UInt)
    let entry: FuncPointer<(UInt) sync -> UInt> = script
    let at = ((&var shared) as UnsafePointer<Shared>) as UInt
    let thread = try proc.thread_create(run: entry, arg: at, stack_top: top)
    try thread.start(band: Priority.Rt1)
    thread.join()
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)
    let proc = try system.process_self() catch { return }
    var set = try BootSet(process: &proc) catch {
        print("SOS uartdrop: drain: {}", error)
        let _ = proc.exit(EXIT_FAILED)
        return
    }
    guard var record = set.take(TAG_UART) else {
        print("SOS uartdrop: no record {}", TAG_UART)
        let _ = proc.exit(EXIT_FAILED)
        return
    }
    guard let inlet = record.take_inlet() else {
        print("SOS uartdrop: record {} is no inlet", TAG_UART)
        let _ = proc.exit(EXIT_FAILED)
        return
    }
    var shared = Shared(u: uart(move inlet))
    let code = try run(&proc, &var shared) catch {
        print("SOS uartdrop: the thread: {}", error)
        let _ = proc.exit(EXIT_FAILED)
        return
    }
    let _ = proc.exit(code)
}
