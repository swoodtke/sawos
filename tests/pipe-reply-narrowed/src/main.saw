// The `Reply` gate, reached through a give's keep mask (spec §2.1, §3).
//
// A handle without `PipeRequestRight.Reply` cannot be made in one process: an
// obligation is never minted narrower, and `take` yields the full set. The one
// way to make one is a give through a keep mask, so the gate needs two
// processes. Root posts a question, takes the obligation off its own outlet,
// and gives it to a child with `keep = Transfer | Wait`, leaving `Reply` out.
//
//   SOS narrowreply: gave the obligation without Reply
//   SOS childnarrowed: the obligation reads back without Reply
//   SOS childnarrowed: now replying
//   SOS: process fault: access denied process=0x…01
//   SOS narrowreply: the child died of the denial
//   SOS narrowreply: the claim answers the other end of this connection is gone
//
// The child's reply is refused with a fault, not a status, so the process
// dies. Its teardown releases the obligation undischarged, which abandons the
// exchange: the claim root still holds therefore answers `PeerClosed`.
//
// Had the gate let the reply through, the child would print that its reply
// was accepted and exit with a code of its own. The fault row would be
// missing, root would refuse the status it read, and the last two rows would
// never be printed.
//
// One phase per function, because of the stack ceiling.

import sos.{System, Process, Waiter, WaitResult, WaitPayload, PipeInlet,
            PipeOutlet, PipeReply, PipeRequest, PipeRequestRight, SosStatus,
            SystemRight, PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status the kernel can never hand this program, so meeting it in the error
/// channel means an assertion in this file failed rather than a call did.
static BUG: SosStatus = SosStatus.Revoked

/// §8's word for a process the kernel terminated with
/// `FaultReason.AccessDenied`: kind 2 in the high half, reason 3 in the low.
static CHILD_FAULTED: UInt = 131075

static KEY_DEATH: UInt = 93

/// Root's config. `child-narrowed` drains its boot set and reads the
/// obligation's tag: its `TAG_REPLY_WAIT` (12) asks for `reply_wait`, and any
/// other tag for `reply`. So the tags are distinct and `TAG_REQUEST` is not 12.
static TAG_BOOT: UInt = 7
static TAG_REQUEST: UInt = 11

/// What a child of this launcher may ask its System object for.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// The obligation may be passed on and waited on, and not answered.
static REQUEST_KEEP: UInt32 = (PipeRequestRight.Transfer
                               | PipeRequestRight.Wait)

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS narrowreply: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    try run(&system, &proc) catch {
        print("SOS narrowreply: failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let _ = proc.exit(EXIT_OK)
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var image = try proc.boot_handle_next()
    var dest = try proc.boot_handle_next()
    guard let image_mem = image.take_memory() else { return BUG }
    guard let dest_mem = dest.take_memory() else { return BUG }

    let child = try system.process_create(image: &image_mem, memory: &dest_mem)

    let pair = try proc.pipe_create()
    let (inlet, outlet) = move pair

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 63
    let claim = try inlet.post(body: &msg, len: 1)
    let taken = try outlet.take()
    let (_, request) = move taken

    let waiter = try proc.waiter_create()
    try waiter.add(process: &child, key: KEY_DEATH)

    let for_child = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try child.give(request: move request, tag: TAG_REQUEST,
                   keep: REQUEST_KEEP) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    print("SOS narrowreply: gave the obligation without Reply\n")
    try child.start(boot_tag: TAG_BOOT)

    try await_denial(&waiter)
    try ask_claim(move claim)
    return
}

/// Park until the child ends, and check it ended on the denial.
func await_denial(waiter: &Waiter) -> Result<Void, SosStatus> {
    let ended = try waiter.wait()
    if ended.key != KEY_DEATH {
        return BUG
    }
    match ended.what {
        case Process(status) -> {
            if status != CHILD_FAULTED {
                print("SOS narrowreply: child status={}\n", status)
                return BUG
            }
        },
        case _ -> return BUG,
    }
    print("SOS narrowreply: the child died of the denial\n")
    return
}

/// Ask the claim what the teardown decided. A `match` rather than the guard
/// shape, deliberately: this is a negative assertion on a specific status.
func ask_claim(claim: PipeReply) -> Result<Void, SosStatus> {
    match (move claim).resolve() {
        case Ok(_) -> {
            print("SOS narrowreply: the claim resolved to a reply\n")
            return BUG
        },
        case Err(status) -> {
            print("SOS narrowreply: the claim answers {}\n", status)
        },
    }
    return
}
