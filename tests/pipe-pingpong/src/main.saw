// The fused paths, counted.
//
// A composed RPC is three traps where a fused call can be fewer. This case
// states the number: `ProcessOp.Stats` lets the machine print the trap counts
// instead of a reader inferring them from kernel source.
//
//   SOS pingpong: served=8 last request b=7,80,73,78
//   SOS pingpong: client traps=11 for 8 round trips
//   SOS pingpong: server traps=18 for 8 messages
//   SOS pingpong: per RPC client=1 server=2
//
// # Topology
//
// Root serves and the child is the client, for three reasons.
//
//   - The client's window is its whole life, so the client must be silent.
//     Every printed byte is one syscall, so an exactly-asserted count and a
//     `print` cannot share a process. `child-pingpong` prints nothing and its
//     launcher reads its columns through the handle that outlives it, the only
//     arrangement in which the client's per-RPC cost is a measured number.
//   - The server's window has to close by itself. Root's loop ends when the
//     child dies: the last inlet handle goes with it, the outlet's readable
//     level turns terminal, and the wait root is already parked in delivers
//     `PeerGone`. So the loop needs no counter, timer or sentinel message, and
//     the peer-gone path costs zero extra traps, which keeps the server's
//     arithmetic clean.
//   - Reversed, root would run a counted `send` loop and the child would need
//     a termination protocol root could not observe without printing inside
//     its own window.
//
// # The arithmetic
//
// A `stats()` call is itself a syscall and is charged before it answers:
// `ktrap` counts at trap entry, ahead of the dispatch, so a delta between two
// readings carries the second reading's own trap.
//
//     delta = (traps inside the window) + 1
//
// The client, whose whole life is the window (its launcher reads the total):
//
//     process_self 1 + boot_handle_next 1 + ROUNDS sends + exit 1 = ROUNDS + 3
//
// The server, bracketed around a print-free loop:
//
//     wait 1  +  ROUNDS x (take 1 + reply_wait 1)  +  the closing read 1
//       =  2 x ROUNDS + 2
//
// The server spends two traps per message, and the second is the `take`.
// `reply_wait` fuses the reply and the next wait, but the readable level only
// says "there is something", never "here it is", so the take is its own op
// here. The fusion removes exactly one trap per message: the composed loop is
// wait + take + reply (three), this one is take + reply_wait (two). The
// client's saving is the bigger one: post + attach + wait (three) becomes
// `send` (one).
//
// # What the payload proves
//
// Each round carries a sequence number both ways (request `[n, P, I, N]`, reply
// `[n + 1, P, O, N]`) and the child refuses any answer whose number is not its
// own plus one. So `code=33` means eight replies arrived, each matching its
// own request, in order. Root prints the last request's bytes, which is the
// same claim from the other end of the connection.
//
// One phase per function, because of the stack ceiling.

import sos.{System, Process, ProcessStats, Waiter, WaitResult, WaitPayload,
            PipeOutlet, PipeRequest, OutletLevel, ReplyWaitError, SosStatus,
            SystemRight, PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status the kernel can never hand this program, so meeting it in the error
/// channel means an assertion in this file failed rather than a call did
/// (`pipe_oneshot`'s vocabulary).
static BUG: SosStatus = SosStatus.Revoked

/// How many round trips. `child-pingpong` states the same number.
static ROUNDS: Int = 8

/// The message length both ways.
static PAYLOAD_LEN: UInt = 4

static BYTE_P: UInt8 = 80
static BYTE_O: UInt8 = 79
static BYTE_N: UInt8 = 78

/// What the child's whole life costs: `process_self`, one `boot_handle_next`,
/// `ROUNDS` sends, `exit`. Its source states the same sum from the other side.
static CLIENT_SYSCALLS: UInt64 = 11

static_assert(8 + 3 == 11,
              "the client's total is its round trips plus its three bracket traps")

/// What root's measured window costs: the opening `wait`, then a `take` and a
/// `reply_wait` per message, plus the closing read's own trap.
static SERVER_TRAPS: UInt64 = 18

static_assert(1 + 2 * 8 + 1 == 18,
              "the server's delta is one wait, two traps a message, and the read")

/// The child's verdict when every round matched. `child-pingpong` picks it.
static CHILD_MATCHED: UInt = 33

/// `Exited`(1) << 16 | 33 — the §8 status word root requires of the child, so
/// the wake could not have come from a fault or from a child that gave up.
static CHILD_STATUS: UInt = 65569

static_assert((1 * 65536) + 33 == 65569,
              "the child's status word is Exited in the high bits and its code")

/// The key root's outlet is attached under — a number that appears nowhere else
/// in this transcript.
static KEY_OUTLET: UInt = 71

/// The tags root's two gives travel under: the inlet the child posts through,
/// and the System record the child starts with.
static TAG_INLET: UInt = 5
static TAG_BOOT: UInt = 6

/// What a child of this launcher may ask its System object for. `Transfer` is
/// the bit `give` checks on the thing being given; everything else is absent
/// by silence. This child never prints, so it never needs `Debug`.
static CHILD_SYSTEM: UInt32 = (SystemRight.ProcessSelf | SystemRight.Transfer)

/// What one turn of the server loop answered, carried out of the measured
/// window so the reporting can happen outside it.
struct Served {
    count: Int,
    last0: UInt8,
    last1: UInt8,
    last2: UInt8,
    last3: UInt8,
    /// Root's own delta over the print-free serving window.
    traps: UInt64,
    /// The child's whole syscall column, read after it died through the handle
    /// root created it with. The slot stays open for as long as anything names
    /// it, which is what makes a dead process's cost readable at all.
    client: UInt64,
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS pingpong: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let done = try run(&system, &proc) catch {
        print("SOS pingpong: server failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    if done.count != ROUNDS {
        print("SOS pingpong: served={} wanted {}\n", done.count, ROUNDS)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS pingpong: served={} last request b={},{},{},{}\n", done.count,
          done.last0, done.last1, done.last2, done.last3)

    if done.traps != SERVER_TRAPS {
        print("SOS pingpong: server traps={} wanted {}\n", done.traps,
              SERVER_TRAPS)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    if done.client != CLIENT_SYSCALLS {
        print("SOS pingpong: client traps={} wanted {}\n", done.client,
              CLIENT_SYSCALLS)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS pingpong: client traps={} for {} round trips\n",
          done.client, ROUNDS)
    print("SOS pingpong: server traps={} for {} messages\n", done.traps, ROUNDS)

    // The per-RPC row. The brackets are subtracted here rather than inside the
    // window, so the division is over the loop and nothing else: the client's
    // three setup traps and the server's opening wait plus closing read.
    print("SOS pingpong: per RPC client={} server={}\n",
          (done.client - 3) / (ROUNDS as UInt64),
          (done.traps - 2) / (ROUNDS as UInt64))

    let _ = proc.exit(EXIT_OK)
}

/// Launch, then serve, and measure only the serving.
///
/// The launch is the ordinary one (drain the two boot regions, create, wire,
/// start) and happens entirely outside the bracket, because every line of it
/// is a trap and none of it is what this case is about.
///
/// Root parks as its first measured act, and nothing else in root is runnable,
/// so the child is what the kernel finds to run. From then on the two
/// processes hand the processor back and forth exactly once per message: the
/// child's `send` stages and parks, which wakes root; root's `reply_wait`
/// answers and parks, which wakes the child. Both threads are genuinely
/// `Blocked` in between, which is what makes the trap counts mean what they
/// say: a poll loop anywhere would have produced the same bytes and a
/// different number.
func run(system: &System, proc: &Process) -> Result<Served, SosStatus> {
    var image = try proc.boot_handle_next()
    var dest = try proc.boot_handle_next()
    guard let image_mem = image.take_memory() else { return BUG }
    guard let dest_mem = dest.take_memory() else { return BUG }

    let child = try system.process_create(image: &image_mem, memory: &dest_mem)
    let pair = try proc.pipe_create()
    let (inlet, outlet) = move pair
    let waiter = try proc.waiter_create()

    // Persistent, because this attachment has to survive `ROUNDS` deliveries
    // and one terminal one. A one-shot would detach at the first message and
    // the second `reply_wait` would park on an empty Waiter forever (see
    // `sos.waiter`'s docstring).
    try waiter.add(outlet: &outlet, key: KEY_OUTLET)

    // Give the inlet and the System record, then start the child on the System
    // record's tag.
    try child.give(inlet: move inlet, tag: TAG_INLET) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let for_child = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try child.start(boot_tag: TAG_BOOT)

    var served = try serve(&outlet, &waiter, &proc)

    // The child is dead by now (its exit is what ended the loop), so its status
    // word is there to be read, and requiring it rules out a child that
    // faulted or gave up mid-round.
    let status = try child.get_status()
    if status != CHILD_STATUS {
        return BUG
    }
    // The dead child's columns. Read here, outside every measured window, and
    // through a handle whose object no longer has a process behind it.
    let client = try child.stats()
    var answer = move served
    answer.client = client.syscalls
    return move answer
}

/// The measured window: one `wait`, then `take` and `reply_wait` until the
/// peer is gone.
///
/// Nothing else is inside the bracket (no print, no mint, no wrapper falling
/// out of scope), which makes the number arithmetic rather than observation.
/// Every printed byte is one syscall, so a window with a `print` in it would be
/// counting this file's prose.
///
/// The first turn is a plain `wait`: `reply_wait` needs a request to consume,
/// and the first turn has none, so the degenerate form the op deliberately does
/// not have is spelled with the op that already exists. The same call is how a
/// real loop recovers from a dead client; this server ends instead (see the
/// catch below).
func serve(outlet: &PipeOutlet, waiter: &Waiter,
           proc: &Process) -> Result<Served, SosStatus> {
    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    var out: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    out[1] = BYTE_P
    out[2] = BYTE_O
    out[3] = BYTE_N

    var count: Int = 0
    var last0: UInt8 = 0
    var last1: UInt8 = 0
    var last2: UInt8 = 0
    var last3: UInt8 = 0

    let before = try proc.stats()

    var wake = try waiter.wait()
    var serving = true
    while serving {
        // The terminal level is the loop's exit condition.
        var more = false
        match wake.what {
            case Readable(level) -> {
                match level {
                    case Msg -> { more = true },
                    case PeerGone -> { more = false },
                }
            },
            // The kernel reported an attachment this program never made.
            case _ -> { return BUG },
        }
        if not more {
            serving = false
        } else {
            let got = try outlet.take()
            let (arrived, request) = move got
            let obligation = move request
            if arrived.len != PAYLOAD_LEN {
                return BUG
            }
            last0 = arrived.bytes[0]
            last1 = arrived.bytes[1]
            last2 = arrived.bytes[2]
            last3 = arrived.bytes[3]
            // The answer is the request's sequence number plus one, which lets
            // the child tell a matching reply from a stale one. `&+` is the
            // wrapping add: Saw's overflow checks are always on and the
            // arithmetic is a byte's.
            out[0] = arrived.bytes[0] &+ 1
            count = count + 1
            wake = try (move obligation).reply_wait(body: &out,
                                                    len: PAYLOAD_LEN,
                                                    waiter: &waiter) catch {
                // Both legs end this server, and only because it is a test with
                // exactly one client: a real loop answers `Reply(_)` by going
                // back to `waiter.wait()`, since the obligation is discharged
                // either way and one dead client cannot stall it.
                return BUG
            }
        }
    }

    let after = try proc.stats()
    if after.syscalls < before.syscalls {
        return BUG
    }
    return Served(count: count, last0: last0, last1: last1, last2: last2,
                  last3: last3, traps: after.syscalls - before.syscalls,
                  client: 0)
}
