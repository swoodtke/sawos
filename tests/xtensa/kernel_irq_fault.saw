// An interrupt taken in kernel mode anywhere but the idle wait stops the
// machine: the kernel vector finds EPC1 outside `sos_idle_resume` and reports
// a kernel fault, a level-1 interrupt at the kernel vector.
//
// UART0's line (source 27) is raised, so an enabled level-1 interrupt is
// pending, and then the kernel calls `ktest_irq_window` (`kernel_irq.S`):
//
//   SOS kirq: line 0x0000001b pending, INTLEVEL 0 in a kernel path
//   SOS-S3: kernel fault vector=0x00000300 exccause=0x00000004 ...
//
// Were the interrupt taken and returned from, the leaf would return and the
// kernel would print `SOS kirq: returned` and stop with a pass.

import kcore.{console}
import hal

extern "C" {
    func ktest_irq_window()
}

@export("kmain")
func kmain() unsafe {
    hal.intc_init()
    let line = hal.irq_raise_selftest_line()
    let uart = console()
    uart.write_str("SOS kirq: line ")
    uart.write_hex(line)
    uart.write_str(" pending, INTLEVEL 0 in a kernel path\n")
    ktest_irq_window()
    uart.write_str("SOS kirq: returned\n")
    hal.exit_pass()
}
