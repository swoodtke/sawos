// The `xtal40` key handed a CPU on the crystal with CPUPERIOD_SEL 2:
// SYSCLK_CONF as the ROM leaves it (SOC_CLK_SEL 0, PRE_DIV_CNT 1) and
// CPU_PER_CONF with PLL_FREQ_SEL 1 and CPUPERIOD_SEL 2. On the crystal
// CPUPERIOD_SEL clocks nothing, so the CPU is not at 240 MHz and the key
// takes its switch: its line, then the boot goes on. The emulator's own
// words have the CPU on the PLL, so the words are handed in rather than
// read. Built at the `xtal40` clock key.

import kcore.{console}
import hal
import s3clock.{clock_init_found}
import s3clockkit.{ClockWords}

@export("kmain")
func kmain() unsafe {
    clock_init_found(ClockWords(sysclk: 0x000A_8001, cpu_per: 0x0000_000E))
    console().write_str("SOS clockfound: the boot goes on\n")
    hal.exit_pass()
}
