// The clock the `esp32s3-r8` board's PSRAM description names for this image
// (../../hal/xtensa-esp32s3/ABI.md §17): the image's clock key's words as the
// part leaves them in a board image and the emulator's in any other, and the
// divider that runs the bus at 20 MHz from the key's memory-SPI core clock.
// It writes nothing but the console.
//
//   SOS psram: described sysclk=... cpu_per=... core_clk_sel=... divider=...
//   board_image=yes|no
//   SOS-S3: halt pass

import kcore.{console}
import hal

@export("kmain")
func kmain() unsafe {
    let clock = hal.psram_clock()
    let uart = console()
    uart.write_str("SOS psram: described sysclk=")
    uart.write_hex(clock.sysclk as UInt)
    uart.write_str(" cpu_per=")
    uart.write_hex(clock.cpu_per as UInt)
    uart.write_str(" core_clk_sel=")
    uart.write_hex(clock.core_clk_sel as UInt)
    uart.write_str(" divider=")
    uart.write_hex(clock.divider as UInt)
    uart.write_str(" board_image=")
    uart.write_str(if hal.board_image() { "yes" } else { "no" })
    uart.write_str("\n")
    hal.exit_pass()
}
