// A kernel that executes an FP or PIE instruction outside `sos_fp_save` and
// `sos_fp_load`, on the ESP32-S3: `ktest_fp_planted` comes from whichever of
// `fp_planted*.S` the case links, each planting one kind. The build
// disassembles the image and refuses it, so this kernel never boots; were it
// booted, it would print the word and pass.

import kcore.{console}
import hal

extern "C" {
    func ktest_fp_planted(word: UInt) -> UInt
}

@export("kmain")
func kmain() unsafe {
    let out = console()
    out.write_str("SOS fpplanted: ")
    out.write_hex(ktest_fp_planted(0x5EED))
    out.write_str("\n")
    hal.exit_pass()
}
