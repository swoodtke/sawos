// The console at its key's rate, carrying a long line: `hal.clock_init()` as
// `kmain` calls it, which switches the console, then one line of 256
// characters after a short prefix, and the pass line. A capture of a board
// image opened at the key's rate (`sosimage flash` prints it) must read the
// line whole: a byte lost or changed is the rate failing.
//
//   SOS-S3: console KEY clkdiv=... (the key's line, at its rate)
//   SOS consoleline: 0123456789ABCDEF, sixteen times
//   SOS-S3: halt pass

import kcore.{console}
import hal

@export("kmain")
func kmain() unsafe {
    hal.clock_init()
    let out = console()
    out.write_str("SOS consoleline: ")
    var i = 0
    while i < 16 {
        out.write_str("0123456789ABCDEF")
        i += 1
    }
    out.write_str("\n")
    hal.exit_pass()
}
