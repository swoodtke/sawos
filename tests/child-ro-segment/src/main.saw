// Test child: a pipe-creation record aimed at this image's own memory, which
// is linked with its read-only data above its writable data (spec §2.2). The
// role says where:
//
//   1  a word of the read-only data, which lies inside the copy-out window
//   2  a word of the writable data
//   3  a `Waiter.Wait` whose record is at a word of the read-only data
//   4  a `Waiter.Wait` whose record is at a word of the writable data
//
// The waits find an Event already signalled, so a wait the kernel accepts
// returns at once with its record written.
//
// A call the kernel answers leaves this process alive, and it exits with a
// code of its own that the launcher can tell apart from every fault.
//
// It works at the C altitude because the buffer is an address this program
// picks, which the typed tier never lets a caller name.

import sos.{ALL_RIGHTS, EventMode, sos_system_process_self,
            sos_process_boot_handle_next, sos_process_exit, sos_event_receive,
            sos_process_pipe_create, sos_process_waiter_create,
            sos_process_event_create, sos_event_signal, sos_waiter_add,
            sos_waiter_wait}

extern "C" {
    func sos_ro_cell() -> UInt
}

static TAG_ROLE: UInt = 32

static ROLE_READ_ONLY: UInt = 1
static ROLE_DATA: UInt = 2
static ROLE_WAIT_READ_ONLY: UInt = 3
static ROLE_WAIT_DATA: UInt = 4

/// The key the signalled Event is attached under.
static KEY_EVENT: UInt = 61

/// How this process ends when the kernel answered its call.
static EXIT_TAKEN: UInt = 7
/// The call was refused with a status.
static EXIT_SETUP: UInt = 97
/// The boot set held no role.
static EXIT_NO_ROLE: UInt = 98

static STATUS_OK: UInt = 0
static NONE: UInt = 0

static BOOT_WORDS: Int = 3
/// The record the kernel writes is two words; the capacity is that.
static RECORD_WORDS: Int = 2
/// More than any record the kernel writes here (a wait record carries a whole
/// message), so the destination has bytes behind it up to the record's end.
static CELL_WORDS: Int = 64

unsafe static var ROLE: UInt = 0
unsafe static var CELL: [UInt; CELL_WORDS] = [0; CELL_WORDS]

func word_bytes() -> UInt {
    sizeof<UInt>() as UInt
}

func ask_process(boot_handle: UInt) unsafe -> UInt {
    var out: UInt = NONE
    let status = sos_system_process_self(boot_handle, ALL_RIGHTS as UInt,
                                         (&var out) as UnsafePointer<UInt>)
    if status != STATUS_OK {
        return NONE
    }
    out
}

func event_word(handle: UInt) unsafe -> UInt {
    var word: UInt = 0
    let _ = sos_event_receive(handle, (&var word) as UnsafePointer<UInt>)
    word
}

func next_record(proc: UInt, rec: &var [UInt; BOOT_WORDS]) unsafe -> UInt {
    sos_process_boot_handle_next(proc, (&var rec) as UnsafePointer<UInt>,
                                 (BOOT_WORDS as UInt) * word_bytes())
}

func drain(proc: UInt) unsafe {
    var rec: [UInt; BOOT_WORDS] = [0; BOOT_WORDS]
    while next_record(proc, &var rec) == STATUS_OK {
        if rec[0] == TAG_ROLE {
            ROLE = event_word(rec[2])
        }
    }
}

func create_at(proc: UInt, at: UInt) unsafe -> UInt {
    let made = sos_process_pipe_create(proc, at as UnsafePointer<UInt>,
                                       (RECORD_WORDS as UInt) * word_bytes())
    if made != STATUS_OK {
        return EXIT_SETUP
    }
    EXIT_TAKEN
}

/// A `Waiter.Wait` with its record at `at`, on a Waiter holding an Event that
/// is already signalled. A wait the kernel took returns at once.
func wait_at(proc: UInt, at: UInt) unsafe -> UInt {
    var waiter: UInt = NONE
    var event: UInt = NONE
    let made_waiter = sos_process_waiter_create(
        proc, (&var waiter) as UnsafePointer<UInt>)
    if made_waiter != STATUS_OK {
        return EXIT_SETUP
    }
    let made_event = sos_process_event_create(
        proc, EventMode.Or as UInt, (&var event) as UnsafePointer<UInt>)
    if made_event != STATUS_OK {
        return EXIT_SETUP
    }
    if sos_event_signal(event, 1) != STATUS_OK {
        return EXIT_SETUP
    }
    if sos_waiter_add(waiter, event, KEY_EVENT, 0) != STATUS_OK {
        return EXIT_SETUP
    }
    let waited = sos_waiter_wait(waiter, at as UnsafePointer<UInt>,
                                 (CELL_WORDS as UInt) * word_bytes())
    if waited != STATUS_OK {
        return EXIT_SETUP
    }
    EXIT_TAKEN
}

func act(proc: UInt) unsafe -> UInt {
    if ROLE == ROLE_READ_ONLY {
        return create_at(proc, sos_ro_cell())
    }
    if ROLE == ROLE_DATA {
        return create_at(proc, ((&var CELL) as UnsafePointer<UInt>) as UInt)
    }
    if ROLE == ROLE_WAIT_READ_ONLY {
        return wait_at(proc, sos_ro_cell())
    }
    if ROLE == ROLE_WAIT_DATA {
        return wait_at(proc, ((&var CELL) as UnsafePointer<UInt>) as UInt)
    }
    EXIT_NO_ROLE
}

@export("_start")
func _start(boot_handle: UInt) {
    let proc = ask_process(boot_handle)
    if proc == NONE {
        return
    }
    drain(proc)
    let code = act(proc)
    let _ = sos_process_exit(proc, code)
}
