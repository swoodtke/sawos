// Freestanding: the task dump on bare metal, under QEMU.
//
// A kernel that dies with work in flight has no debugger attached and no core
// to open; what it has is a serial port. The dump walks its own task slots
// through the in-binary table and writes every live task's logical stack
// straight to that port: no allocator, no unwinder, no host, and built under
// `--no-hidden-alloc` like every other kernel image.
//
// The kernel spawns a task, lets it park in a sleep, and dumps; then it panics
// while that task is still parked, and the panic path dumps again on its own.
// So the serial transcript carries both dumps in order: the explicit
// `dump_tasks()` and the automatic post-panic one.
//
// The stub seams below are this test's, not a kernel facility. `sosrt`
// defines no reactor and no clock seam (the kernel's Clock objects are reached
// by syscall, not through the runtime), and the cooperative executor's park
// path names both, so a freestanding link needs every name resolved. Each
// body is the honest "there is no such facility on this machine" answer
// rather than a pretend one. `knap`'s sleep does reach the clock stub: its 0
// never advances, so the sleeper stays parked, which is the state both dumps
// need.
//
// `--runtime-provider` checks every stub against sawlang's `runtime/ABI.md`,
// so they cannot drift from the contract they satisfy. The check compares
// arity and width class on every target and refuses a mismatch with
// `export.seam-signature`. That is why the clock stub returns `Int64`: the
// ABI's clock seam is a 64-bit integer, and `Int` is a machine word, a
// different class even on a 64-bit target. `UInt64` would pass as well; the
// executor reads the value as unsigned.

import kcore
import std.task.*

@export("__saw_rt_reactor_create")
func rt_reactor_create(r_out: Int) -> Int {
    0
}

@export("__saw_rt_reactor_destroy")
func rt_reactor_destroy(r: Int) {
}

// SOS has no reactor: -16 is the portable tag for ENOSYS (`Other`), never 0.
@export("__saw_rt_reactor_register")
func rt_reactor_register(r: Int, fd: Int, write: Int, token: Int) -> Int {
    -16
}

@export("__saw_rt_reactor_unregister")
func rt_reactor_unregister(r: Int, fd: Int, write: Int) {
}

@export("__saw_rt_reactor_poll")
func rt_reactor_poll(r: Int, timeout_ms: Int, count_out: Int) -> Int {
    0
}

@export("__saw_rt_reactor_wake")
func rt_reactor_wake(r: Int) {
