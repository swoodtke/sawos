// `taskdump_stubs.c`, linked beside this file as the case's `csrc`, holds C
// stand-ins for the runtime's thread, mutex and condition-variable names. They
// stay out of `rt/common_c/support.c`, so no other image links them.

// Two frames deep, which is the honest proof of the walk on bare metal: the
// dump has to reconstruct a logical stack the machine has no record of.
//
// The nest relies on the compiler embedding a nested suspending callee in its
// caller under the freestanding profile, which compiles to an object rather
// than a program with a `main`. Without that, `ksleeper` would call `knap`
// blocking and the park would run inline on the kernel's only stack.
//
// `knap` sleeps rather than yielding: a yield leaves the task ready, and the
// sweep would run it to completion before the watcher's turn.
func knap(n: Int) -> Int {
    sleep(Duration.ms(5))
    n * 2
}

func ksleeper(n: Int) -> Int {
    let r = knap(n)
    r
}

func kwatcher() {
    dump_tasks()
}

@export("kmain")
func kmain() {
    var g = TaskGroup()
    let a = g.spawn(ksleeper(4))
    let b = g.spawn(kwatcher())
    b.join()
    // The panic runs while `a` is still parked, so the panic path has a live
    // task to dump on its own: the automatic dump, on bare metal.
    panic("SOS task dump: deliberate panic")
}

unsafe static var EXEC_WORD: Int = 0

@export("__saw_rt_thread_executor")
func rt_thread_executor() unsafe -> Int {
    EXEC_WORD
}

@export("__saw_rt_set_thread_executor")
func rt_set_thread_executor(record: Int) unsafe -> Int {
    EXEC_WORD = record
    0
}

@export("__saw_rt_output_lock")
func rt_output_lock() {
}

@export("__saw_rt_output_unlock")
func rt_output_unlock() {
}

@export("__saw_rt_write_error")
func rt_write_error(ptr: UnsafePointer<Int8>, len: UInt) unsafe {
    sos_rt_write(ptr, len)
}

extern "C" {
    func sos_rt_write(ptr: UnsafePointer<Int8>, len: UInt)
}
