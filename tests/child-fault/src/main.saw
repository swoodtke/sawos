// Test child: the handle-less process. A child created by `process_create` and
// run by `start()` with no boot tag receives `NO_HANDLE` in its first argument
// register, so it holds no authority at all: no console, no clock, no way to
// end itself politely.
//
// It dies by trying. `System(boot_handle: 0)` wraps handle zero, which spec.md
// §3 reserves to name nothing, and the first byte of the print below is an
// `ecall` the kernel answers by terminating this process for a bad handle. A
// fault in a syscall ends the process and reschedules; for a child it does not
// end the machine (process 0's death does).
//
// Expected transcript:
//
//   SOS: process fault: bad handle process=0x00000001   <- process one
//   SOS: process teardown ... process=0x00000001        <- and the machine
//   SOS lifecycle: root survived ...                    <- stayed up
//
// A kernel that still stopped on any process's death would end the run at the
// second line, and root's would never be printed.
//
// It names no architecture; only the linker script differs per machine.

import sos.{System}

@export("_start")
func _start(boot_handle: UInt) {
    // The wrapper is honest: `boot_handle` is what the kernel put in the
    // register, and for this child that is `NO_HANDLE`.
    let system = System(boot_handle: boot_handle)

    // This does not come back. The first `ecall` names handle 0, the kernel's
    // dispatch resolves it to nothing, and the fault ends the process.
    let _ = system.debug_print("a child with no handles cannot say this\n")

    // Unreachable. A child that somehow survived the call above has nowhere to
    // go: there is no `exit` without a Process handle, so spinning is all that
    // is left. The harness would catch it as a timeout rather than a pass.
    while { }
}
