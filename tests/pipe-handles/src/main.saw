// Handles in messages, with the handle-table ledger observed (spec §2.1's
// `send(data?, handles?)`). The request direction is measured here; the reply
// direction is not (see below).
//
// The ledger is the half this case exists for. That a capability can travel in
// a message is proved by the child using what it was sent; that the sender
// gives it up at the post is a claim about the handle table, and a claim about
// a table needs a way to look at one. Root's is looked at by minting siblings
// until it refuses: the depth of that recursion is exactly how many slots were
// free, and reading it at three moments states the rule as a number.
//
//   free before the post          the entry is root's, bound, counted
//   free after the post           one more: the post unbound it
//   free after the child takes    the same number: the mint was the child's
//
// Only take-at-post produces that sequence. A design that left the entry with
// the sender until the rendezvous would hold the second number level and raise
// the third; one that copied the handle at the post would move neither; one
// that counted a reference for the message without unbinding would move the
// second the other way. The entry leaves at the post, the kernel holds the
// reference in between, and the mint happens in a table root cannot see, which
// is why the third reading is a non-event and is asserted to be one.
//
// Every other handle move is kept outside the readings. A mint, a give and a
// take each move this table too, so the launch happens before the first reading
// and the claim the post mints is given to the Waiter rather than added, which
// releases its entry as part of the attach and leaves the staged handle as the
// only thing the comparison is about.
//
// The reply direction is deliberately not proved here. `pipe-delegate-msg`
// shows the answering half: a capability coming back on this reply would land
// in root's table at the delivery and net out against the entry the rendezvous
// freed, so the third reading would say nothing. One case measures the ledger
// and the other exercises the symmetry.
//
// How root knows the child has taken, which makes the third reading
// well-defined: the child posts through the inlet it was handed, and root waits
// on the far end of that connection. The message cannot exist unless the take
// happened, so the wait is the synchronisation and no poll is involved.
//
// One phase per function: every `print` with format arguments reserves message
// scratch in its own frame, so a single long `_start` would exhaust root's
// stack grant on the 64-bit profile.

import sos.{System, Process, PipeInlet, PipeOutlet, PipeReply, PipeRequest,
            PipeHandle, PipeHandles, PipeMsg, Waiter, WaitResult, WaitPayload,
            OutletLevel, SystemRight, SosStatus, PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// Root's config, and the whole of the contract with the child.
static TAG_BOOT: UInt = 7
static TAG_OUTLET: UInt = 11

/// The keys root attaches under. Two attachments on one Waiter, so the key is
/// what says which of them woke it.
static KEY_READABLE: UInt = 31
static KEY_REPLY: UInt = 32

/// What a child of this launcher may ask its System object for.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// The byte `child-handles` posts through an inlet it was handed, and the
/// length of the reply it sends back.
static BYTE_VIA: UInt8 = 86
static REPLY_LEN: UInt = 4

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS handles: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    try run(&system, &proc) catch {
        print("SOS handles: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.shutdown(EXIT_OK)
}

/// Launch, send the capability, and hand off to the two observing phases.
func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var image = try proc.boot_handle_next()
    var dest = try proc.boot_handle_next()
    guard let image_mem = image.take_memory() else { return BUG }
    guard let dest_mem = dest.take_memory() else { return BUG }

    let child = try system.process_create(image: &image_mem, memory: &dest_mem)

    // Connection A: root posts, the child takes. Connection B: the capability
    // that travels, and the one root listens on afterwards.
    let a = try proc.pipe_create()
    let (a_in, a_out) = move a
    let b = try proc.pipe_create()
    let (b_in, b_out) = move b
    let waiter = try proc.waiter_create()
    try waiter.add(outlet: &b_out, key: KEY_READABLE)
    let _ = system.debug_print("SOS handles: created\n")

    // Every handle move that is not the one under test happens here, ahead of
    // the first reading.
    let for_child = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move for_child, tag: TAG_BOOT)
    try child.give(outlet: move a_out, tag: TAG_OUTLET)

    let before = free_slots(&system)

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 1
    var carrying = PipeHandles.none()
    carrying.put(0, inlet: move b_in)
    let claim = try a_in.post_with(body: &msg, len: 1, handles: &var carrying)
    // Given, not added. A post mints a claim into this table; handing it to
    // the subscription releases that entry as part of the attach, so the second
    // reading is about the staged handle alone.
    try waiter.give(reply: move claim, key: KEY_REPLY) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }

    let after_post = free_slots(&system)

    try child.start(boot_tag: TAG_BOOT)

    let via = try hear_post(&waiter, &b_out)
    let after_take = free_slots(&system)

    try verdict(&system, before, after_post, after_take, via)
    try hear_reply(&system, &waiter)
    return
}

/// The three readings, checked and printed.
///
/// The numbers are printed and the verdict is asserted: how many slots root's
/// table happens to have free is a property of this program's other handles,
/// while the relations between the three are what the take-at-post rule
/// claims.
func verdict(system: &System, before: UInt, after_post: UInt, after_take: UInt,
             via: UInt8) -> Result<Void, SosStatus> {
    print("SOS handles: free before={} after post={} after take={}\n",
          before, after_post, after_take)
    if after_post != before + 1 {
        let _ = system.debug_print("SOS handles: the post did not unbind the entry\n")
        return BUG
    }
    if after_take != after_post {
        let _ = system.debug_print("SOS handles: the take moved root's table\n")
        return BUG
    }
    if via != BYTE_VIA {
        let _ = system.debug_print("SOS handles: the child posted the wrong byte\n")
        return BUG
    }
    let _ = system.debug_print("SOS handles: the post moved the entry and the take was the child's\n")
    return
}

/// The child's post, which is the proof the handle works and, because root
/// cannot be woken here unless the take happened, the synchronisation the third
/// ledger reading needs. Answers the byte the child wrote.
func hear_post(waiter: &Waiter, b_out: &PipeOutlet) -> Result<UInt8, SosStatus> {
    let heard = try waiter.wait()
    if heard.key != KEY_READABLE {
        return BUG
    }
    let arrived = try b_out.take()
    let (from_child, their_request) = move arrived
    let via = from_child.bytes[0]
    let _ = move from_child
    let _ = move their_request
    return via
}

/// The answer, through the subscription that owns the claim. Root never
/// resolves: the bytes arrive in the wait record, and the claim's own entry
/// went at the `give`.
///
/// The reply carries data and no handle, deliberately (see `child-handles`): a
/// capability coming back here would land in this table at the delivery and
/// disturb the readings this case is about.
///
/// Nothing is spent here, so nothing is opened. The length is read through the
/// place the delivery put it in (a single-level match plus a `&self` accessor,
/// which borrows), and the record drops at this frame's end with its payload
/// still inside it.
func hear_reply(system: &System, waiter: &Waiter) -> Result<Void, SosStatus> {
    let back = try waiter.wait()
    if back.key != KEY_REPLY {
        return BUG
    }
    var len: UInt = 0
    match back.what {
        case Reply(outcome) -> { len = outcome.len() },
        case _ -> { return BUG },
    }
    if len != REPLY_LEN {
        return BUG
    }
    let _ = system.debug_print("SOS handles: the answer came back through the subscription\n")
    return
}

/// How many free slots this process's handle table has, counted by filling it
/// and letting go.
///
/// There is no introspection op (a process cannot ask what it holds), so the
/// table is measured by asking for one more until the answer is no. Each frame
/// holds its sibling across the recursion, so the depth is the occupancy, and
/// the unwind gives every slot back before the caller sees the number.
///
/// It is exact: root's handle quota is unlimited, so the wall this meets is the
/// table and nothing else.
func free_slots(system: &System) -> UInt {
    let got = try? system.mint()
    guard let held = move got else { return 0 }
    let deeper = free_slots(&system)
    let _ = move held
    deeper + 1
}
