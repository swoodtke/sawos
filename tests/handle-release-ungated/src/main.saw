// Release is ungated, and mint-per-call refills.
//
//   SOS release: ungated=1 refilled=1
//   SOS release: done
//
// `ungated` is a release succeeding with no right checked. Destroying your own
// capability instance harms nobody (identity lives in the object's slot, not in
// the handle, so a released handle takes nothing from anyone else holding one),
// so there is nobody for a gate to protect. If one is ever wanted it is a new
// universal bit, never a retasking of an existing one.
//
// The sharpest form of the claim is a release succeeding through a handle
// whose rights word is zero, which `sos_handle_mint` could build at this
// altitude. This case instead uses a Clock handle, whose kind's rights
// (`ClockRight.Read`, `ClockRight.TimerCreate`, `ClockRight.Mint`) gate
// reading the time, making timers and minting, and say nothing about release.
// A kernel that checked any per-kind right here would have to invent one, and
// this would fail.
//
// `refilled` is the other half, and the two belong in one case because either
// alone is misleading. A release that succeeded but left the slot unusable
// would be a leak with a success status. The second ask succeeding only shows
// the getter still answers; the teardown's handle count in the runner (one
// Clock left after mint, release and re-mint) is what shows the release really
// unbound the first and that the getter mints rather than caching.
//
// It exits clean, which is load-bearing: every other case in this family ends
// with the process dead, so this one shows a release is an ordinary successful
// op rather than a differently spelled fault.
//
// It reaches the C altitude because a raw word is the only thing that can be
// released twice or asked about; the typed layer releases by dropping, which
// `handle-drop-release` covers.

import sos.{System, Process, ClockType, sos_system_clock_get, sos_handle_release}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// The status word a successful op answers with (`SosStatus.Ok`).
static STATUS_OK: UInt = 0

static YES: UInt = 1
static NO: UInt = 0

func flag(b: Bool) -> UInt {
    if b { YES } else { NO }
}

/// Ask for a Clock, answering the raw handle word, or 0, which names nothing.
func ask_clock(handle: UInt) unsafe -> UInt {
    var out: UInt = 0
    let status = sos_system_clock_get(handle, ClockType.Monotonic as UInt,
                                      (&var out) as UnsafePointer<UInt>)
    if status != STATUS_OK {
        return 0
    }
    out
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS release: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let first = ask_clock(boot_handle)
    if first == 0 {
        let _ = system.debug_print("SOS release: no clock\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // No right is checked. A Clock's rights gate reading the time, making
    // timers and minting; none is a right to destroy your own handle, and there
    // is no such right on any kind.
    let ungated = sos_handle_release(first) == STATUS_OK

    // This ask succeeding does not by itself show a fresh mint or that the
    // release unbound the first handle; the teardown's handle count does.
    let refilled = ask_clock(boot_handle) != 0

    print("SOS release: ungated={} refilled={}\n", flag(ungated), flag(refilled))
    print("SOS release: done\n")
    let _ = proc.exit(EXIT_OK)
}
