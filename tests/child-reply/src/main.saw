// Child that answers a question it was never asked (spec §2.1, §12).
//
// It bootstraps like every other child (a masked System handle in its first
// argument register, its own Process object derived from it, its boot set
// drained from there). The new thing is what the set carries: a `PipeRequest`,
// the obligation to send one reply.
//
// It holds no end of any connection. There is no inlet here and no outlet;
// this process cannot post, cannot take, and cannot name the pipe the message
// arrived on. What it has is the obligation, and the obligation knows where
// the answer goes. That is why §2.1 calls the one-shot pair the delegation
// primitive, and why the canonical example (a filesystem forwarding a read to
// the flash driver, whose bytes go straight to the client) needs nothing else.
//
// The answer outlives the replier. The obligation is consumed by the reply,
// the process exits, and the launcher resolves its claim afterwards, so the
// transcript shows the exit and the teardown before the bytes. A reply lives
// in the exchange's own ring slot, so the replier's death takes nothing with
// it.
//
// The payload is `DONE` in ASCII, and the launcher asserts all four bytes: a
// status alone would not show that the copy funnel carried the data.

import sos.{System, Process, PipeRequest, BootHandle, BootHandleKind, SosStatus,
            PIPE_BODY_BYTES}

/// What it ends with when the boot set was not what the config promised. A
/// number the transcript's `code=` field distinguishes on sight.
static EXIT_NO_REQUEST: UInt = 97

/// The reply, and the exit code that says how many bytes of it went.
static PAYLOAD_LEN: UInt = 4

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        print("SOS childreply: no process handle: {}\n", error)
        return
    }

    var body: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    body[0] = 68
    body[1] = 79
    body[2] = 78
    body[3] = 69

    var replied = false
    var going = true
    while going {
        match proc.boot_handle_next() {
            case Ok(h) -> {
                var rec = move h
                match rec.kind {
                    case PipeRequest -> {
                        if let request = rec.take_request() {
                            let obligation = move request
                            // The reply is the whole of this process. It
                            // consumes the obligation, so there is nothing
                            // left to release and nothing to forget.
                            try (move obligation).reply(body: &body,
                                                        len: PAYLOAD_LEN) catch {
                                print("SOS childreply: reply failed: {}\n", error)
                                let _ = proc.exit(EXIT_NO_REQUEST)
                                return
                            }
                            replied = true
                        }
                    },
                    // A record of any other kind is a capability this child was
                    // given and does not want: it drops at the end of this arm
                    // and releases whatever it held.
                    case _ -> {},
                }
            },
            case Err(_) -> { going = false },
        }
    }

    if not replied {
        let _ = system.debug_print("SOS childreply: no request in the boot set\n")
        let _ = proc.exit(EXIT_NO_REQUEST)
    }

    let _ = system.debug_print("SOS childreply: replied\n")
    // The exit code is the payload's length, so the kernel's account of this
    // process and the launcher's reading of the reply say the same number from
    // the two sides of the boundary.
    let _ = proc.exit(PAYLOAD_LEN)
}
