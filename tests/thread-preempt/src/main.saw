// Preemption (spec §7).
//
// Two workers print a letter and then wait for the other worker to print its
// own, spinning on a shared counter. Neither yields, blocks, or makes any call
// that could give the processor up, so a worker that is waiting for the other
// can only be answered if something takes the processor away from it, and the
// only thing that can is the timer running out a thread's slice.
//
//   ABBAABBA...                 <- which worker goes first is timing; that the
//                                  processor changes hands is the claim
//   SOS preempt: joined a=33 b=44
//
// The handoff is forced by construction, not by how long a worker runs. Each
// worker publishes how many letters it has printed and, after printing, spins
// until the other has printed as many. The worker that prints first cannot
// leave its spin until the other has run, so the transcript crosses between
// the two threads in every round however many ticks the host delivers or how
// late. A kernel that never preempted would leave the first worker spinning
// forever and the case would end at the harness timeout.
//
// The kernel booting this image is `tests/threads_timer.saw`, which arms the
// periodic tick before it loads the image. The cooperative twin of this case
// (`thread-basics`) runs under a kernel that arms nothing, so the two
// transcripts together separate "the scheduler switches" from "a thread asked
// it to".

import sos.{System, Process, Thread}

/// The boot handle, parked for the workers, and the witness that says which
/// thread `_start` is running as (handle 0 names nothing, so a parked one is
/// never 0). A worker derives everything else off it: `System(boot_handle:)` ->
/// `process_self()` -> `thread_self()`. See `thread-basics` for why every
/// thread of an image written in Saw enters at the same address.
unsafe static var BOOT_HANDLE: UInt = 0

/// How many letters each worker has printed, published for the other to read.
/// An atomic load is what keeps a spin on it from being hoisted out of its
/// loop.
static PRINTED_A: Atomic<Int> = Atomic(0)
static PRINTED_B: Atomic<Int> = Atomic(0)

static STACK_WORDS: Int = 1024
unsafe static var STACK_A: [UInt64; STACK_WORDS] = [0; STACK_WORDS]
unsafe static var STACK_B: [UInt64; STACK_WORDS] = [0; STACK_WORDS]

static BYTES_PER_WORD: UInt = 8
static STACK_ALIGN: UInt = 16

static ROLE_A: UInt = 1
static ROLE_B: UInt = 2
static ROUNDS: Int = 8
static EXIT_A: UInt = 33
static EXIT_B: UInt = 44

static NO_VALUE: UInt = 0

func stack_top(base: UInt) -> UInt {
    let top = base + (STACK_WORDS as UInt) * BYTES_PER_WORD
    top - (top % STACK_ALIGN)
}

func stack_a_top() unsafe -> UInt {
    stack_top(((&var STACK_A) as UnsafePointer<UInt64>) as UInt)
}

func stack_b_top() unsafe -> UInt {
    stack_top(((&var STACK_B) as UnsafePointer<UInt64>) as UInt)
}

func park_boot_handle(word: UInt) unsafe {
    BOOT_HANDLE = word
}

func parked_boot_handle() unsafe -> UInt {
    BOOT_HANDLE
}

/// Publish that `role` has printed `count` letters.
func publish(role: UInt, count: Int) {
    if role == ROLE_A {
        PRINTED_A.store(count)
    } else {
        PRINTED_B.store(count)
    }
}

/// Spin until the worker other than `role` has printed `count` letters. The
/// loop makes no call into the kernel, so it ends only when the processor goes
/// to the other worker and back.
func await_other(role: UInt, count: Int) {
    var seen = 0
    while seen < count {
        seen = if role == ROLE_A { PRINTED_B.load() } else { PRINTED_A.load() }
    }
}

func worker(role: UInt) {
    let system = System(boot_handle: parked_boot_handle())
    let proc = try system.process_self() catch { return }
    let me = try proc.thread_self() catch { return }
    let tag = if role == ROLE_A { "A" } else { "B" }
    var round = 0
    while round < ROUNDS {
        let _ = system.debug_print(tag)
        round = round + 1
        publish(role, round)
        await_other(role, round)
    }
    let _ = (move me).exit(if role == ROLE_A { EXIT_A } else { EXIT_B })
}

func initial(boot_handle: UInt) {
    park_boot_handle(boot_handle)

    let system = System(boot_handle: boot_handle)
    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS preempt: no process handle\n")
        let _ = system.shutdown(1)
        return
    }

    let a = try proc.thread_create(stack_top: stack_a_top(), arg: ROLE_A) catch {
        print("SOS preempt: create failed: {}\n", error)
        let _ = system.shutdown(1)
        return
    }
    let b = try proc.thread_create(stack_top: stack_b_top(), arg: ROLE_B) catch {
        print("SOS preempt: create failed: {}\n", error)
        let _ = system.shutdown(1)
        return
    }

    let _ = system.debug_print("SOS preempt: two spinners, no yields\n")
    let _ = a.start()
    let _ = b.start()

    let ra: UInt = try a.join() catch { NO_VALUE }
    let rb: UInt = try b.join() catch { NO_VALUE }
    print("\nSOS preempt: joined a={} b={}\n", ra, rb)

    // The interrupt column, where it is actually non-zero. This case's point
    // is that ticks land in user mode, so the column has something to show:
    // every alternation in the transcript above is one of these.
    //
    // Printed, never asserted: a tick lands where the host puts it, so the
    // number moves run to run. The counters are per-process, so this is both
    // workers' ticks and the initial thread's together.
    //
    // The number is smaller than the tick count because an interrupt taken
    // while the kernel is idle never reaches `ktrap` (the idle path polls the
    // controller rather than taking a vector), so this column counts what
    // preempted this process.
    let cost = try proc.stats() catch {
        let _ = proc.exit(0)
        return
    }
    print("SOS preempt: interrupts={}\n", cost.interrupts)
    let _ = proc.exit(0)
}

@export("_start")
func _start(arg: UInt) {
    if parked_boot_handle() == 0 {
        initial(arg)
    } else {
        worker(arg)
    }
}
