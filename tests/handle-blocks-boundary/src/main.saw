// The lowest free index and a slot's generation across the edge between the
// body's entries and the first handle block, and a word that names nothing
// past the body (spec §3).
//
// The image holds a block for each of three children, and a body for the
// third. Root launches `child-blocks-boundary` three times, each with its
// `Handle` row at 48, one block past the body's 32, and Systems it can mint
// siblings of, making all three before any runs. The child fills indexes 31
// and 32, releases both and mints twice more, then uses a word that names
// nothing, which ends it with `BadHandle`. The first is started with its one
// System, word 1, and uses the word it released for index 32; the second is
// started with word 2 and uses a word whose index field is zero; the third
// is started with word 3 and uses the word of index 48, one past its table:
//
//   SOS blocksedge: the body filled to index 32 first-life=1
//   SOS blocksedge: reminted reused=1 lower-first=1
//   SOS blocksedge: using the word released for index 32
//   SOS: process fault: bad handle process={one}
//   SOS blocksboundary: stale ended status=131073  <- Faulted << 16 | BadHandle
//   SOS blocksedge: the body filled to index 32 first-life=1
//   SOS blocksedge: reminted reused=1 lower-first=1
//   SOS blocksedge: using index zero at the reminted generation
//   SOS: process fault: bad handle process={two}
//   SOS blocksboundary: zero ended status=131073
//   ...
//   SOS blocksedge: using index 48, one past the table
//   SOS: process fault: bad handle process={three}
//   SOS blocksboundary: past ended status=131073
//   SOS blocksboundary: done

import sos.{System, Process, Memory, QuotaKind, AttachMode, SosStatus,
            SystemRight}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// The children's row: one block past the body's entries.
static ROW: UInt16 = 48

/// The key root watches each child's death under.
static KEY: UInt = 7

/// What a child may ask its System object for: print, and mint siblings;
/// and `Transfer`, which the give spends.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.Mint
                               | SystemRight.Transfer)

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)
    try run(&system) catch {
        print("SOS blocksboundary: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS blocksboundary: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System) -> Result<Void, SosStatus> {
    let proc = try system.process_self()
    // Rows: each child's image, then the RAM of each.
    var a_image_rec = try proc.boot_handle_next()
    var b_image_rec = try proc.boot_handle_next()
    var c_image_rec = try proc.boot_handle_next()
    var a_ram_rec = try proc.boot_handle_next()
    var b_ram_rec = try proc.boot_handle_next()
    var c_ram_rec = try proc.boot_handle_next()
    guard let a_image = a_image_rec.take_memory() else { return BUG }
    guard let b_image = b_image_rec.take_memory() else { return BUG }
    guard let c_image = c_image_rec.take_memory() else { return BUG }
    guard let a_ram = a_ram_rec.take_memory() else { return BUG }
    guard let b_ram = b_ram_rec.take_memory() else { return BUG }
    guard let c_ram = c_ram_rec.take_memory() else { return BUG }

    // All are made before any runs, so each runs in a body no process has
    // used, whose every word is a first life.
    let a = try make(&system, &a_image, &a_ram)
    let b = try make(&system, &b_image, &b_ram)
    let c = try make(&system, &c_image, &c_ram)
    let stale = try launch(&system, &proc, &a, 1)
    print("SOS blocksboundary: stale ended status={}\n", stale)
    let zero = try launch(&system, &proc, &b, 2)
    print("SOS blocksboundary: zero ended status={}\n", zero)
    let past = try launch(&system, &proc, &c, 3)
    print("SOS blocksboundary: past ended status={}\n", past)
    return
}

/// Create a child at the row.
func make(system: &System, image: &Memory,
          ram: &Memory) -> Result<Process, SosStatus> {
    let child = try system.process_create(image: &image, memory: &ram)
    try child.quota_set(kind: QuotaKind.Handle, limit: ROW)
    return move child
}

/// Give `child` `systems` Systems under tags 1 onward, start it with the
/// last, and wait for its death. Answers its §8 status word.
func launch(system: &System, proc: &Process, child: &Process,
            systems: UInt) -> Result<UInt, SosStatus> {
    var tag: UInt = 1
    while tag <= systems {
        let for_child = try system.mint(rights: CHILD_SYSTEM)
        try child.give(system: move for_child, tag: tag) catch {
            let (why, back) = move error
            let _ = move back
            return why
        }
        tag = tag + 1
    }
    let waiter = try proc.waiter_create()
    try waiter.add(process: &child, key: KEY, mode: AttachMode.OneShot)
    try child.start(boot_tag: systems)
    let _ = try waiter.wait()
    return try child.get_status()
}
