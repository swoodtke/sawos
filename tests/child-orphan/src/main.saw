// Test child: a process that dies with a thread parked in a fused call.
//
// A fused call's claim is a reference no handle table holds. That is the saving
// of the fused path (no `PipeReply` is minted, so a blocking client spends no
// table row), and it is why `end_process` needs an arm for it: the teardown's
// close-all walks handles, and there is none here. Something else must abandon
// the claim, or the ring slot is pinned forever and `Exchange.caller` names a
// thread slot about to be recycled.
//
// Two threads, one connection, symmetric on purpose. Both take an inlet out of
// the boot set, make one fused call, and end the whole process if it is
// answered, so the launcher need not know which of the two it is talking to.
// It answers one of the two messages; that thread exits the process; the other
// is still parked when the teardown runs.
//
// The launcher's later `reply` to the second obligation proves the arm: it
// gets `Err(PeerClosed)`, because the claim column reached zero in the
// teardown.
//
// # How both threads reach the pipe without passing a handle
//
// The `sos` module offers no way to take a handle word out of a typed wrapper,
// so a thread cannot be handed one by a sibling. The launcher instead mints a
// second inlet onto the same connection and gives both, so the boot set holds
// two client ends and each thread drains one. A sibling is a second name on one
// connection, which makes the two calls two exchanges on one ring.
//
// Every thread of this image enters at `_start`, because Saw cannot name the
// address of a function, so the entry works out which thread it is the way
// `thread-basics` does: the initial thread is the one that has not yet parked
// the boot handle.

import sos.{System, Process, PIPE_BODY_BYTES}

/// The boot handle, parked by the initial thread for the sibling, and the "have
/// I run yet" witness. Handle 0 names nothing (the object table reserves zero),
/// so a parked boot handle is never 0 and an unparked slot is never a handle.
unsafe static var BOOT_HANDLE: UInt = 0

/// The sibling's stack, in this process's own zero-init data (spec.md §8:
/// thread stacks are userspace memory passed to thread creation).
static STACK_WORDS: Int = 512
unsafe static var STACK: [UInt64; STACK_WORDS] = [0; STACK_WORDS]

static BYTES_PER_WORD: UInt = 8
/// Every profile wants a 16-byte-aligned stack pointer; one of them checks.
static STACK_ALIGN: UInt = 16

/// The sibling's argument. It is never read — both threads do the same thing —
/// and it is here because `thread_create` takes one.
static ROLE_SIBLING: UInt = 2

/// One byte, which is a message rather than an absence.
static PAYLOAD_LEN: UInt = 1

/// The call was answered, so this thread ends the process, with the other
/// thread still parked in its own call.
static EXIT_ANSWERED: UInt = 61

/// Something went wrong before the call could be made, or the call itself was
/// refused. Either way the launcher reads a code it did not expect.
static EXIT_REFUSED: UInt = 62

func park(word: UInt) unsafe {
    BOOT_HANDLE = word
}

func parked() unsafe -> UInt {
    BOOT_HANDLE
}

/// The highest 16-aligned address inside the sibling's stack reservation.
/// Stacks grow down, so this is where the thread starts.
func stack_top() unsafe -> UInt {
    let base = ((&var STACK) as UnsafePointer<UInt64>) as UInt
    let top = base + (STACK_WORDS as UInt) * BYTES_PER_WORD
    top - (top % STACK_ALIGN)
}

@export("_start")
func _start(arg: UInt) {
    if parked() == 0 {
        initial(arg)
        return
    }
    sibling()
}

/// The initial thread: park the seed, make the sibling, start it, and then do
/// exactly what the sibling does.
///
/// The sibling is started before this thread calls, and it does not matter
/// which of the two reaches the pipe first: they are interchangeable, so
/// whichever message the launcher answers is the one whose thread exits.
func initial(boot_handle: UInt) {
    park(boot_handle)

    let system = System(boot_handle: boot_handle)
    let proc = try system.process_self() catch { return }

    let helper = try proc.thread_create(stack_top: stack_top(),
                                        arg: ROLE_SIBLING) catch {
        let _ = proc.exit(EXIT_REFUSED)
        return
    }
    let _ = helper.start()

    call_and_exit(&proc)
}

/// The sibling: derive everything from the parked seed, then the same call.
func sibling() {
    let system = System(boot_handle: parked())
    let proc = try system.process_self() catch { return }
    call_and_exit(&proc)
}

/// One fused call; the whole process ends if it is answered.
///
/// `exit` is `ProcessOp.Exit`, not `ThreadOp.Exit`: this ends the process, so
/// the sibling still parked inside its own `send` goes down with it. That is
/// the state `end_process`'s orphaned-claim arm exists for and the only way to
/// reach it, since nothing in SOS can kill a thread from outside.
func call_and_exit(proc: &Process) {
    var record = try proc.boot_handle_next() catch {
        let _ = proc.exit(EXIT_REFUSED)
        return
    }
    guard let inlet = record.take_inlet() else {
        let _ = proc.exit(EXIT_REFUSED)
        return
    }

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 1

    // This parks. Exactly one of the two threads is ever woken from it.
    let _ = try inlet.send(body: &msg, len: PAYLOAD_LEN) catch {
        let _ = proc.exit(EXIT_REFUSED)
        return
    }

    let _ = proc.exit(EXIT_ANSWERED)
}
