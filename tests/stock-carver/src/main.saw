//! A child of a stock-root case: it carves the device window it is given
//! under tag 2 until the kernel refuses, and prints how many carves it got
//! (`tests/stockkit`).

import stockkit

static TAG_WINDOW: UInt = 2

@export("_start")
func _start(boot_handle: UInt) {
    stockkit.carve_all(boot_handle, "carver", TAG_WINDOW)
}
