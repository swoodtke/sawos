// A process written with `main` in an image that names a console with no
// tick: it prints a line, which is posted and waits in the ring, since the
// driver runs only once this process parks, and returns an `Err`. The entry
// writes the `error:` line through the runtime's error stream, which posts it
// to the console after the line, and the start-up's `Sync` parks the process
// until the driver has written both, so they come before the kernel's exit
// line. The status is 1.

import sos.{SosStatus}
import sosmain

func main() -> Result<Void, SosStatus> {
    print("SOS consoleerror: a line, then an Err from main")
    return SosStatus.BadImage
}
