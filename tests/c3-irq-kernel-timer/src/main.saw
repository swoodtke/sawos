// Smoke case (ESP32-C3): binding the interrupt-matrix source the
// kernel routes to its own tick faults the caller with `BadArg`, as binding
// the timer's line does. The transcript reads:
//
//   SOS c3irq: binding the kernel timer's source
//   SOS: process fault: argument outside its domain
//
// Releasing a bound Interrupt masks its line, which on this board unroutes the
// source, so a bound tick source would stop the kernel's timer trap.
//
// The number is the matrix source of SYSTIMER TARGET0
// (`SYSTIMER_TARGET0_SOURCE` in hal/riscv32-esp32c3/kernel/lib.saw); the HAL
// does not export it to userspace.

import sos.{System, Process, Interrupt}

static TIMER_SOURCE: UInt = 37

static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS c3irq: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let _ = system.debug_print("SOS c3irq: binding the kernel timer's source\n")

    // Does not return: the kernel terminates this process.
    let _ = proc.interrupt_bind(line: TIMER_SOURCE)

    let _ = system.debug_print("SOS c3irq: still alive, which is the bug\n")
    let _ = system.shutdown(EXIT_FAILED)
}
