//! What the PWM cases' client children do.
//!
//! A client starts from its stock root's boot set, takes the client end of the
//! driver's connection, and makes `pwmproto` calls through `Remote`. A call
//! that the driver answers with other than the status the script wants is
//! printed, as `SOS NAME: STEP: got X, wanted Y`, and ends the script: the
//! console's missing lines are what turns a case red.
//!
//! `Sleeper` is a Timer on a Waiter of its own, for a board stage's pauses.
//! Nothing here asserts how long a pause took.

import sos.{System, Process, BootSet, PipeInlet, PipeHandles, Waiter, Timer, ClockType,
            IoMemory, SosStatus, PIPE_BODY_BYTES}
import pwmproto.{BODY_BYTES, Frame, PwmBody, PwmStatus}

static_assert(BODY_BYTES == PIPE_BODY_BYTES, "the wire's body is the kernel's")

public static EXIT_OK: UInt = 0
public static EXIT_FAILED: UInt = 1

/// A status no honest path of a script produces: a wrong answer from the
/// driver, which the script has printed.
public static MISMATCH: SosStatus = SosStatus.BadImage

/// The Waiter's key for `Sleeper`'s Timer.
static KEY_TIMER: UInt = 1

/// The driver's `Inspect` answer: its five words, each read from the device.
public struct Words {
    duty_r: UInt32
    timer: UInt32
    conf0: UInt32
    out_sel: UInt32
    iomux: UInt32
}

/// The head of the driver's `Log` answer.
public struct LogHead {
    total: UInt8
    dropped: UInt16
    n: UInt8
}

/// The driver's connection, the process that holds it, and the rest of its
/// boot set.
public struct Remote {
    name: String
    proc: Process
    inlet: PipeInlet
    body: PwmBody
    system: System
    set: BootSet
}

extension Remote: NoCopy {}

/// Starts a client: its Process handle, its boot set and the inlet it holds
/// under `tag`. A failure is printed and ends the client, and answers `None`.
public func begin(boot_handle: UInt, name: String, tag: UInt) -> Remote? {
    let system = System(boot_handle: boot_handle)
    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS pwmkit: no process handle")
        let _ = system.shutdown(EXIT_FAILED)
        return None
    }
    var set = try BootSet(process: &proc) catch {
        print("SOS {}: drain: {}", name, error)
        let _ = proc.exit(EXIT_FAILED)
        return None
    }
    guard var record = set.take(tag) else {
        print("SOS {}: no record {}", name, tag)
        let _ = proc.exit(EXIT_FAILED)
        return None
    }
    guard let inlet = record.take_inlet() else {
        print("SOS {}: record {} is no inlet", name, tag)
        let _ = proc.exit(EXIT_FAILED)
        return None
    }
    Remote(name: name, proc: move proc, inlet: move inlet, body: PwmBody.empty(),
           system: move system, set: move set)
}

/// Ends the client with `code`.
public func finish(remote: &Remote, code: UInt) {
    let _ = remote.proc.exit(code)
}

extension Remote {
    /// The device window record `tag` of its boot set, or `None` when it has
    /// no such record.
    public func take_window(&var self, tag: UInt) -> IoMemory? {
        guard var record = self.set.take(tag) else { return None }
        record.take_iomemory()
    }

    /// Prints a mismatch and answers the status that ends the script.
    public func mismatch(&self, step: String, got: String, wanted: String) -> SosStatus {
        print("SOS {}: {}: got {}, wanted {}", self.name, step, got, wanted)
        MISMATCH
    }

    /// Requires `reply`'s status to be `want`.
    func status_is(&self, step: String, reply: &Frame, want: PwmStatus) -> Result<Void, SosStatus> {
        guard let got = reply.status() else {
            return self.mismatch(step, "no status", want.describe())
        }
        if got != want {
            return self.mismatch(step, got.describe(), want.describe())
        }
        return
    }

    /// Sends the request in the body and requires the answer's status to be
    /// `want`.
    public func expect(&var self, step: String, len: UInt,
                       want: PwmStatus) -> Result<Frame, SosStatus> {
        let msg = try self.inlet.send(body: &self.body.bytes, len: len)
        let reply = Frame(len: msg.len, bytes: msg.bytes)
        try self.status_is(step, &reply, want)
        return move reply
    }

    /// Sends the request carrying `handles` and requires the answer's status to
    /// be `want`.
    public func expect_with(&var self, step: String, len: UInt, want: PwmStatus,
                            handles: &var PipeHandles) -> Result<Frame, SosStatus> {
        let msg = try self.inlet.send_with(body: &self.body.bytes, len: len,
                                           handles: &var handles)
        let reply = Frame(len: msg.len, bytes: msg.bytes)
        try self.status_is(step, &reply, want)
        return move reply
    }

    /// `Set(channel, pulse_us)`, answered `Ok`: the counts it came to.
    public func set(&var self, step: String, channel: UInt8,
                    pulse_us: UInt32) -> Result<UInt32, SosStatus> {
        let n = self.body.set(channel, pulse_us)
        let reply = try self.expect(step, n, PwmStatus.Ok)
        if reply.len != 5 {
            return self.mismatch(step, "a reply of {reply.len} bytes", "5")
        }
        return reply.u32(1)
    }

    /// `Stop(channel)`, answered `Ok`.
    public func stop(&var self, step: String, channel: UInt8) -> Result<Void, SosStatus> {
        let n = self.body.stop(channel)
        let reply = try self.expect(step, n, PwmStatus.Ok)
        if reply.len != 1 {
            return self.mismatch(step, "a reply of {reply.len} bytes", "1")
        }
        return
    }

    /// `Inspect(channel)`, answered `Ok`: the words it read.
    public func inspect(&var self, step: String, channel: UInt8) -> Result<Words, SosStatus> {
        let n = self.body.inspect(channel)
        let reply = try self.expect(step, n, PwmStatus.Ok)
        if reply.len != 21 {
            return self.mismatch(step, "a reply of {reply.len} bytes", "21")
        }
        return Words(duty_r: reply.u32(1), timer: reply.u32(5), conf0: reply.u32(9),
                     out_sel: reply.u32(13), iomux: reply.u32(17))
    }

    /// `Log(from)`, answered `Ok`: its head, with the reply for its entries.
    public func log(&var self, step: String, from: UInt8) -> Result<Frame, SosStatus> {
        let n = self.body.log(from)
        let reply = try self.expect(step, n, PwmStatus.Ok)
        let count = reply.byte(4) as UInt
        if reply.len != 5 + 8 * count {
            return self.mismatch(step, "a reply of {reply.len} bytes", "{5 + 8 * count}")
        }
        return move reply
    }

    /// The log's head: how many entries it kept and dropped.
    public func log_head(&var self, step: String) -> Result<LogHead, SosStatus> {
        let reply = try self.log(step, 0)
        return LogHead(total: reply.byte(1), dropped: reply.u16(2), n: reply.byte(4))
    }
}

/// The address and word of entry `i` of a `Log` answer.
public func entry(reply: &Frame, i: Int) -> (UInt32, UInt32) {
    (reply.u32(5 + 8 * i), reply.u32(9 + 8 * i))
}

/// A Timer on a Waiter of its own.
public struct Sleeper {
    waiter: Waiter
    timer: Timer
}

extension Sleeper: NoCopy {}

/// Makes a Sleeper from `remote`'s System and Process.
public func sleeper(remote: &Remote) -> Result<Sleeper, SosStatus> {
    let clock = try remote.system.clock_get(type: ClockType.Monotonic)
    let waiter = try remote.proc.waiter_create()
    let timer = try clock.timer_create()
    try waiter.add(&timer, KEY_TIMER)
    return Sleeper(waiter: move waiter, timer: move timer)
}

extension Sleeper {
    /// Pauses for `ns` nanoseconds.
    public func sleep(&self, ns: UInt64) -> Result<Void, SosStatus> {
        try self.timer.arm(after_ns: ns)
        let woke = try self.waiter.wait()
        let _ = move woke
        return
    }
}
