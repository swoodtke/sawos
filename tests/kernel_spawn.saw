// A kernel source that spawns a background task. The kernel compiles `kcore`,
// `sosrt`, `sosabi`, `imgformat` and `hal`, and never `sos`, whose floor is
// what declares the background group's two entries; so no module of this
// compile owns the group, and the spawn is refused where it is written
// (`spawn.freestanding`, spec §10.1). The case asserts the refusal.

import kcore

func work() -> Int {
    7
}

@export("kmain")
func kmain() {
    let task = Task.spawn(work())
    task.detach()
}
