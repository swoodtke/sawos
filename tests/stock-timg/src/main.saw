//! A child of the gate's stock-root images on the ESP32-S3: it holds timer
//! group 1 whole and prints its timer 0's alarm word (`tests/stockkit`).

import stockkit
import stockconfig.{name, OFFSET}

@export("_start")
func _start(boot_handle: UInt) {
    stockkit.probe(boot_handle, name(), OFFSET)
}
