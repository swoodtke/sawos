// Nothing runnable, and nothing that could ever make something runnable
// (spec §7): the kernel reports a deadlock and terminates the process.
//
// The kernel idles instead of reporting a deadlock only when something outside
// the thread set could deliver readiness: a bound interrupt line or an armed
// Timer. This case pins the other branch: neither exists, so the idle rule
// must not apply.
//
// The program is the smallest thing that can deadlock: one thread, one Event
// nobody else holds, one Waiter, and a wait. It binds no interrupt and arms no
// timer, which is what makes the answer a report rather than a wait.

import sos.{System, Process, Event, Waiter}

static KEY: UInt = 1

static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS deadlock: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let waiter = try proc.waiter_create() catch {
        print("SOS deadlock: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let event = try proc.event_create() catch {
        print("SOS deadlock: no event: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try waiter.add(&event, KEY) catch {
        print("SOS deadlock: attach failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let _ = system.debug_print("SOS deadlock: waiting for a signal nobody sends\n")

    // Does not return: this thread parks, nothing else is runnable, and no
    // readiness can arrive from outside — so the kernel terminates the process
    // rather than waiting for a wake that cannot come.
    let _ = waiter.wait()

    let _ = system.debug_print("SOS deadlock: woke, which is the bug\n")
    let _ = system.shutdown(EXIT_FAILED)
}
