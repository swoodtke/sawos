// Test child written with `main`, for `main_no_system`: started with no tag,
// it has no System, so its `print` is dropped with no call to the kernel;
// `main` touches none of the boot context, and returns 3. The start-up then
// has no Process handle to exit through, and panics saying so, with the
// status on the line.

import sosmain

func main() -> Int {
    print("SOS mainbare: a line with no System to print it")
    3
}
