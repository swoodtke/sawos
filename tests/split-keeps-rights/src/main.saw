// A split piece carries its parent handle's rights (spec §2.5, §3).
//
// The parent is a sibling that keeps `Split` and `Map` and drops
// `MapExecute`. A piece cut from it must not map executable either, or a
// handle narrowed to forbid executable mappings could regain the right by
// splitting.
//
//   SOS splitkeep: minted a sibling without MapExecute
//   SOS splitkeep: the piece maps read-write      <- it is a live handle
//   SOS splitkeep: asking for execute through the piece
//   SOS: process fault: access denied
//
// The read-write map is the control: a piece that could not map at all would
// produce the same refusal for the wrong reason. The refusal is a fault, so it
// is the last thing this program does.

import sos.{System, Process, Memory, Pool, Mapping, MapAccess, MemoryRight,
            SosStatus}

static CHUNK: UInt = 0x1000

static RX: UInt32 = MapAccess.Read | MapAccess.Execute
static RW: UInt32 = MapAccess.Read | MapAccess.Write

/// `Split` and `Map` are kept; `MapExecute` is absent by silence.
static NARROW: UInt32 = (MemoryRight.Split | MemoryRight.Map)

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS splitkeep: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    var pool_record = try proc.boot_handle_next() catch {
        print("SOS splitkeep: no pool region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let pool = pool_record.take_pool() else {
        let _ = system.debug_print("SOS splitkeep: pool record is not a pool\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let page = try pool.allocate(len: CHUNK) catch {
        print("SOS splitkeep: allocation failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let narrow = try page.mint(rights: NARROW) catch {
        print("SOS splitkeep: mint failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS splitkeep: minted a sibling without MapExecute\n")

    // `page` is exactly `CHUNK` bytes, so the piece is the whole region.
    let piece = try narrow.split(len: CHUNK) catch {
        print("SOS splitkeep: split through the sibling failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _data = try proc.map(memory: &piece, access: RW) catch {
        print("SOS splitkeep: mapping read-write failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS splitkeep: the piece maps read-write\n")

    let _ = system.debug_print("SOS splitkeep: asking for execute through the piece\n")
    match proc.map(memory: &piece, access: RX) {
        case Ok(_) -> {
            let _ = system.debug_print("SOS splitkeep: UNREACHABLE mapped executable\n")
            let _ = system.shutdown(EXIT_FAILED)
        },
        case Err(e) -> {
            print("SOS splitkeep: UNREACHABLE status {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
        },
    }
    let _ = proc.exit(EXIT_OK)
}
