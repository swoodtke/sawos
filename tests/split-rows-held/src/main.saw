// A split respects the rows a child's image and stack count on its region
// (spec §2.5). Root creates a child and leaves it unstarted, which is all the
// rows need: they are recorded at the create.
//
//   SOS splitrows: cut through the image refused: <status>
//   SOS splitrows: cut through the stack refused: <status>
//                                                <- a cut that would leave one
//                                                   row granting bytes of two
//                                                   regions answers a status
//                                                   and changes nothing
//   SOS splitrows: front piece cut                <- a cut above every segment
//                                                   and below the stack takes
//                                                   the image's rows with it
//   SOS: process fault: object in the wrong state <- and the piece is not
//                                                   donatable while they are
//                                                   there: its bytes are a
//                                                   child's, not the kernel's
//
// The last line is a fault, so it is the only way to assert it, and root is
// the donor. A kernel that left the rows counted on the region the front was
// cut from would see an idle piece, accept the donation and put its own slab
// inside the child's image.
//
// The first cut is one page, which lies inside the child's first segment on
// both profiles; the second leaves the last page of the stack out of the
// piece. Neither is a quantity the program computes: the layout is the child's
// linker script's and the stack length the HAL's (`hal.ROOT_STACK_LEN`), and a
// layout in which either cut stopped crossing a row would surface here as a cut
// that was accepted.

import sos.{System, Process, Memory, SlabKind, SosStatus}

/// The child's region is this long on every profile.
static REGION_LEN: UInt = 0x40000

/// One protection unit's worth on either profile.
static PAGE: UInt = 0x1000

/// The front piece's length: above the small child's image, below its stack.
static CUT: UInt = 0x10000

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A cut that must be refused: say so, or say it was accepted.
func refused(system: &System, region: &Memory, len: UInt,
             through_image: Bool) -> Bool {
    match region.split(len: len) {
        case Ok(piece) -> {
            let _ = move piece
            return false
        },
        case Err(why) -> {
            if through_image {
                print("SOS splitrows: cut through the image refused: {}\n", why)
            } else {
                print("SOS splitrows: cut through the stack refused: {}\n", why)
            }
            return true
        },
    }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS splitrows: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var image_record = try proc.boot_handle_next() catch {
        print("SOS splitrows: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest_record = try proc.boot_handle_next() catch {
        print("SOS splitrows: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let image = image_record.take_memory() else {
        let _ = system.debug_print(
            "SOS splitrows: image record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let dest = dest_record.take_memory() else {
        let _ = system.debug_print(
            "SOS splitrows: dest record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _child = try system.process_create(image: &image, memory: &dest) catch {
        print("SOS splitrows: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    if not refused(&system, &dest, PAGE, true) {
        let _ = system.debug_print(
            "SOS splitrows: UNREACHABLE — cut through the image accepted\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    if not refused(&system, &dest, REGION_LEN - PAGE, false) {
        let _ = system.debug_print(
            "SOS splitrows: UNREACHABLE — cut through the stack accepted\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let front = try dest.split(len: CUT) catch {
        print("SOS splitrows: front cut failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS splitrows: front piece cut\n")

    // This call does not return: the donation is a `BadState` fault. Both arms
    // are unreachable, on `tests/slab-donate-shared`'s pattern.
    match system.slab_donate(kind: SlabKind.Waiters, memory: move front) {
        case Ok(_) -> {
            let _ = system.debug_print(
                "SOS splitrows: UNREACHABLE — a piece with rows was absorbed\n")
            let _ = system.shutdown(EXIT_FAILED)
        },
        case Err(_) -> {
            let _ = system.debug_print(
                "SOS splitrows: UNREACHABLE — refused with a status\n")
            let _ = system.shutdown(EXIT_FAILED)
        },
    }
}
