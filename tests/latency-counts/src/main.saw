// An Interrupt's latency record counts the fires a thread was delivered and
// resets when it is read (spec §9).
//
// The line is the console UART's transmitter-empty source, which asserts as
// soon as it is enabled with the transmitter empty (`tests/latency-line`).
// Each round parks this thread on the line and has a second thread enable
// the source, so the fire wakes a parked thread; the thread then turns the
// source off and acks, so the device cannot assert again at the unmask and
// each round is exactly one fire. The second thread runs only when this one
// parks (the image arms no tick, and a start does not preempt), which is
// what orders the round. The record then holds four fires and a worst
// interval above zero, and a second read finds the window empty.
//
//   SOS latcount: the first read is empty
//   SOS latcount: four fires measured, the worst above zero
//   SOS latcount: the second read is empty
//
// No latency value is printed or compared with another: how long a fire took
// depends on the host. That it took some time is all the record can promise.

import sos.{System, Process, SosStatus}

/// The boot handle, parked by the initial thread: it is also how the entry
/// tells a worker from the initial thread (a handle is never 0).
unsafe static var BOOT_HANDLE: UInt = 0

/// The worker's stack, in this process's own zero-init data.
static STACK_WORDS: Int = 1024
unsafe static var STACK: [UInt64; STACK_WORDS] = [0; STACK_WORDS]
static BYTES_PER_WORD: UInt = 8
static STACK_ALIGN: UInt = 16

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

static KEY_LINE: UInt = 61
static ROUNDS: UInt64 = 4

// The console UART's line and its transmitter-empty source, answered by the
// target's own C file (`tests/latency-line`).
extern "C" {
    func latency_line() -> UInt
    func latency_source_on()
    func latency_source_off()
}

func stack_top() unsafe -> UInt {
    let base = ((&var STACK) as UnsafePointer<UInt64>) as UInt
    let top = base + (STACK_WORDS as UInt) * BYTES_PER_WORD
    top - (top % STACK_ALIGN)
}

func park_boot_handle(word: UInt) unsafe {
    BOOT_HANDLE = word
}

func parked_boot_handle() unsafe -> UInt {
    BOOT_HANDLE
}

/// The worker: let the line fire, and end.
func worker() {
    let system = System(boot_handle: parked_boot_handle())
    let proc = try system.process_self() catch { return }
    let me = try proc.thread_self() catch { return }
    latency_source_on()
    let _ = (move me).exit(0)
}

@export("_start")
func _start(arg: UInt) {
    if parked_boot_handle() == 0 {
        initial(arg)
    } else {
        worker()
    }
}

func initial(boot_handle: UInt) {
    park_boot_handle(boot_handle)
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS latcount: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&system, &proc) catch {
        print("SOS latcount: failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS latcount: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var record = try proc.boot_handle_next()
    guard let window = record.take_iomemory() else {
        let _ = system.debug_print("SOS latcount: the boot record is no window\n")
        return SosStatus.BadImage
    }
    let _mapping = try proc.map(iomemory: &window)

    let irq = try system.interrupt_bind(line: latency_line())
    let waiter = try proc.waiter_create()
    try waiter.add(&irq, KEY_LINE)

    let empty = try irq.latency()
    if empty.fires != 0 || empty.worst_ns != 0 {
        let _ = system.debug_print("SOS latcount: the first read was not empty\n")
        return SosStatus.BadImage
    }
    let _ = system.debug_print("SOS latcount: the first read is empty\n")

    var round: UInt64 = 0
    while round < ROUNDS {
        let helper = try proc.thread_create(stack_top: stack_top(), arg: 1)
        try helper.start()
        let woke = try waiter.wait()
        let _ = move woke
        latency_source_off()
        try irq.ack()
        let _ = try helper.join()
        round = round + 1
    }

    let counted = try irq.latency()
    if counted.fires != ROUNDS || counted.worst_ns == 0 {
        print("SOS latcount: fires={} worst_nonzero={}\n", counted.fires,
              counted.worst_ns != 0)
        return SosStatus.BadImage
    }
    let _ = system.debug_print("SOS latcount: four fires measured, the worst above zero\n")

    let again = try irq.latency()
    if again.fires != 0 || again.worst_ns != 0 {
        print("SOS latcount: the second read: fires={} worst_nonzero={}\n",
              again.fires, again.worst_ns != 0)
        return SosStatus.BadImage
    }
    let _ = system.debug_print("SOS latcount: the second read is empty\n")
    return
}
