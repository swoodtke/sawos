// A supervisor is woken by a death.
//
// There is no timer in this file. Some launchers park on a generous deadline
// while their child runs; this one attaches the child's own Process handle to
// a Waiter and parks on it, so the only thing in the machine that can make root
// runnable again is the child ending. A kernel that did not notify would leave
// nothing runnable and the run would end in `every thread blocked`. The failure
// is loud, which is what makes a plain `wait()` an assertion.
//
// The transcript is read as an order:
//
//   SOS deathnotify: started
//   SOS bye: exiting                              <- the child's last word
//   SOS: process exit: code=... process=...
//   SOS: process teardown ... process=...
//   SOS deathnotify: woke key=44 status=65541     <- root, on the far side
//   SOS deathnotify: done
//
// The wake line comes after the teardown line. The kernel notifies as soon as
// the status word is recorded, before it closes a single handle, but the
// notification only queues a thread; the dying process's teardown runs to
// completion inside the same syscall and root is picked afterwards. A
// supervisor therefore never observes a half-dead process.
//
// `status=65541` is `Exited`(1) << 16 | 5: the kind in the high half and the
// child's own exit code in the low one, out of a wait record rather than a
// `get_status` poll. `key=44` is the word root chose at `attach` and the
// kernel handed back unread.
//
// The attach happens before the start, which is the supervisor shape rather
// than a requirement: a death is a terminal level, so a late attach works too
// (`death-late-attach` proves that).

import sos.{System, Process, Memory, BootHandle, Waiter, WaitResult,
            WaitPayload, SosStatus, SystemRight}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// The key this case attaches the child's Process handle under: a number that
/// appears nowhere else in the transcript, so reading it back proves the record
/// came from this attachment.
static KEY: UInt = 44

/// Root's config: the tag the child's System handle travels under.
static TAG_BOOT: UInt = 21

/// What a child of this launcher may ask its System object for: print, and
/// learn its own Process object, which is the handle its `exit` goes through.
/// `Transfer` is in the mask because it is the bit `give` checks on the thing
/// being given; everything else is absent by silence.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// The §8 status word out of the record the kernel copied into this process's
/// memory while the thread was parked.
///
/// The other three arms panic, and not defensively: this program attached
/// exactly one thing, so a record of any other kind would mean the kernel
/// reported an attachment nobody made, a bug in the pair rather than a
/// condition to handle.
func status_of(r: &WaitResult) -> UInt {
    match r.what {
        case Process(status) -> status,
        case _ -> panic("this program attached only a Process"),
    }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS deathnotify: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The boot set, in the build's row order: the child's image blob, then the
    // RAM it will run in. Root's config is what says which ordinal is which.
    var image = try proc.boot_handle_next() catch {
        print("SOS deathnotify: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS deathnotify: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let image_mem = image.take_memory() else {
        let _ = system.debug_print("SOS deathnotify: image record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let dest_mem = dest.take_memory() else {
        let _ = system.debug_print("SOS deathnotify: dest record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS deathnotify: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let waiter = try proc.waiter_create() catch {
        print("SOS deathnotify: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The attachment spends `ProcessRight.Wait`, the same bit `get_status`
    // spends, because this is the same question asked asynchronously. The
    // other three `add` overloads' rules hold unchanged.
    try waiter.add(process: &child, key: KEY) catch {
        print("SOS deathnotify: attach failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let for_child = try system.mint(rights: CHILD_SYSTEM) catch {
        print("SOS deathnotify: mint failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        print("SOS deathnotify: give failed: {}\n", error.0)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try child.start(boot_tag: TAG_BOOT) catch {
        print("SOS deathnotify: start failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS deathnotify: started\n")

    // The park. Nothing else in this machine is armed, so the child's death is
    // the only thing that can end this call.
    let record = try waiter.wait() catch {
        print("SOS deathnotify: wait failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    print("SOS deathnotify: woke key={} status={}\n",
          record.key, status_of(&record))
    print("SOS deathnotify: done\n")
    let _ = proc.exit(EXIT_OK)
}
