// `kill-churn`'s rounds, timed: where one round's time goes on the ESP32-S3.
//
// The same two hundred rounds as `kill-churn` (create a `child-kill-victim`,
// give it its role and its boot System, start it, yield until it holds still,
// kill it and read its word, release it), with the Monotonic clock read at
// the edge of each phase. Each phase's time is added to its total, and the
// totals are printed once, at the end, in microseconds:
//
//   create   `process_create`: the record, the body, the image's rows
//   give     the role Event, the inlet of a CALL round's pipe, the System
//   start    `Process.start`
//   settle   yielding until the child's system-call count says it holds still
//   kill     `Process.kill` and `get_status`, the kernel's teardown line
//            included
//   release  dropping the round's handles
//   all      each round from its first read of the clock to its last
//
// Nothing is printed per round. The kernel prints its teardown line in every
// kill, and an image of this case counts how long its console waited for room
// (the HAL's `console_stall` key); that count runs to the clean stop, so
// before its one line root waits for the UART to drain, and prints nothing
// after it. The line fits the transmit FIFO, so it waits for nothing.
//
//   SOS killprof: us create=... give=... start=... settle=... kill=...
//                 release=... all=...      (one line)

import sos.{System, Process, Memory, Clock, SosStatus, SystemRight}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

static TAG_BOOT: UInt = 31

/// The tags and roles `child-kill-victim` knows.
static TAG_ROLE: UInt = 40
static TAG_INLET: UInt = 41
static ROLE_SPIN: UInt = 1
static ROLE_PARK: UInt = 2
static ROLE_SLEEP: UInt = 3
static ROLE_CALL: UInt = 4

/// The system calls a victim makes before it holds still, by role.
static HELD_SPIN: UInt64 = 4
static HELD_PARK: UInt64 = 8
static HELD_SLEEP: UInt64 = 11
static HELD_CALL: UInt64 = 6

/// A killed word: `Killed` (3) in the high half over the code. Each round
/// kills with the code `CODE_BASE` plus its number.
static KILLED_KIND: UInt = 3
static KIND_SHIFT: UInt = 16
static CODE_BASE: UInt = 0x100

static ROUNDS: Int = 200

static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer | SystemRight.ClockGet)

static NS_PER_US: UInt64 = 1000

/// How long root waits before its line: longer than the UART takes to send
/// a full transmit FIFO (128 bytes at 115200 baud, about 11 ms).
static DRAIN_NS: UInt64 = 50_000_000
static KEY_DRAIN: UInt = 1

/// One round's clock readings, at the edges of its phases.
struct Stamps {
    begin: UInt64,
    created: UInt64,
    given: UInt64,
    started: UInt64,
    settled: UInt64,
    killed: UInt64,
    released: UInt64,
}

/// Nanoseconds per phase, summed over the rounds.
struct Totals {
    create: UInt64,
    give: UInt64,
    start: UInt64,
    settle: UInt64,
    kill: UInt64,
    release: UInt64,
    all: UInt64,
}

extension Totals {
    func add(&var self, s: Stamps) {
        self.create += s.created - s.begin
        self.give += s.given - s.created
        self.start += s.started - s.given
        self.settle += s.settled - s.started
        self.kill += s.killed - s.settled
        self.release += s.released - s.killed
        self.all += s.released - s.begin
    }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)
    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS killprof: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&system, &proc) catch {
        print("SOS killprof: refused: {}", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var img_rec = try proc.boot_handle_next()
    var ram_rec = try proc.boot_handle_next()
    guard let img = img_rec.take_memory() else { return BUG }
    guard let ram = ram_rec.take_memory() else { return BUG }
    let clock = try system.clock_get()
    var totals = Totals(create: 0, give: 0, start: 0, settle: 0, kill: 0,
                        release: 0, all: 0)
    var round = 0
    while round < ROUNDS {
        let stamps = try one_round(&system, &proc, &clock, &img, &ram,
                                   round) catch {
            print("SOS killprof: round {} refused: {}", round, error)
            return error
        }
        totals.add(stamps)
        round = round + 1
    }
    try drain(&proc, &clock)
    print("SOS killprof: us create={} give={} start={} settle={} kill={} release={} all={}",
          totals.create / NS_PER_US, totals.give / NS_PER_US,
          totals.start / NS_PER_US, totals.settle / NS_PER_US,
          totals.kill / NS_PER_US, totals.release / NS_PER_US,
          totals.all / NS_PER_US)
    return
}

/// One victim, killed in the state this round's number names, with the
/// clock read at each phase's edge.
func one_round(system: &System, proc: &Process, clock: &Clock, img: &Memory,
               ram: &Memory, round: Int) -> Result<Stamps, SosStatus> {
    let role = ((round % 4) as UInt) + 1
    let begin = try clock.now()
    let child = try system.process_create(image: &img, memory: &ram)
    let created = try clock.now()
    try tell(&proc, &child, role)
    if role == ROLE_CALL {
        let pair = try proc.pipe_create()
        let (inlet, outlet) = move pair
        try child.give(inlet: move inlet, tag: TAG_INLET) catch {
            let (why, back) = move error
            let _ = move back
            return why
        }
        try give_boot(&system, &child)
        let given = try clock.now()
        try child.start(boot_tag: TAG_BOOT)
        let started = try clock.now()
        try settle(&proc, &child, held(role))
        let settled = try clock.now()
        try kill_and_check(&child, round)
        let killed = try clock.now()
        let _ = move outlet
        let _ = move child
        let released = try clock.now()
        return Stamps(begin: begin, created: created, given: given,
                      started: started, settled: settled, killed: killed,
                      released: released)
    }
    try give_boot(&system, &child)
    let given = try clock.now()
    try child.start(boot_tag: TAG_BOOT)
    let started = try clock.now()
    try settle(&proc, &child, held(role))
    let settled = try clock.now()
    try kill_and_check(&child, round)
    let killed = try clock.now()
    let _ = move child
    let released = try clock.now()
    return Stamps(begin: begin, created: created, given: given,
                  started: started, settled: settled, killed: killed,
                  released: released)
}

func held(role: UInt) -> UInt64 {
    if role == ROLE_SPIN {
        HELD_SPIN
    } else if role == ROLE_PARK {
        HELD_PARK
    } else if role == ROLE_SLEEP {
        HELD_SLEEP
    } else {
        HELD_CALL
    }
}

func kill_and_check(child: &Process, round: Int) -> Result<Void, SosStatus> {
    let code = CODE_BASE + (round as UInt)
    try child.kill(code: code)
    let word = try child.get_status()
    if word != (KILLED_KIND << KIND_SHIFT) + code {
        print("SOS killprof: round {} reads {}", round, word)
        return BUG
    }
    return
}

/// Yield until `child` has made `want` system calls. A victim that makes
/// more has a different path than its role says, and that is refused.
func settle(proc: &Process, child: &Process,
            want: UInt64) -> Result<Void, SosStatus> {
    let me = try proc.thread_self()
    while {
        let st = try child.stats()
        if st.syscalls == want {
            return
        }
        if st.syscalls > want {
            print("SOS killprof: the child made {} system calls, not {}",
                  st.syscalls, want)
            return BUG
        }
        let _ = me.yield_now()
    }
}

/// Give `child` its role: an Event whose word is the role.
func tell(proc: &Process, child: &Process,
          role: UInt) -> Result<Void, SosStatus> {
    let ev = try proc.event_create()
    try ev.signal(bits: role)
    try child.give(event: move ev, tag: TAG_ROLE) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    return
}

func give_boot(system: &System, child: &Process) -> Result<Void, SosStatus> {
    let boot = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move boot, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    return
}

/// Park on a Timer for `DRAIN_NS`, so the UART has sent the last teardown
/// line before root's own.
func drain(proc: &Process, clock: &Clock) -> Result<Void, SosStatus> {
    let timer = try clock.timer_create()
    let nap = try proc.waiter_create()
    try nap.add(timer: &timer, key: KEY_DRAIN)
    try timer.arm(after_ns: DRAIN_NS)
    let _ = try nap.wait()
    return
}
