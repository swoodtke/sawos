// A malformed image is a status, not a fault.
//
// Root calls `process_create` with its two regions the wrong way round: the
// child's empty destination RAM as the image, and the image blob as the
// destination. The first region holds zeros, so it has no magic, and the
// kernel answers:
//
//   SOS badimage: create refused: not a loadable process image
//   SOS badimage: still running, exiting clean
//
// and the machine exits zero.
//
// Every other way a process can hand the kernel something wrong ends the
// process: a bad handle, an unknown op, a right it was not given, a misaligned
// buffer, a duplicate attachment key are all caller errors the process could
// have checked. This one is not: a launcher did not write the bytes it was
// handed. It received a region capability and was asked to start what is in
// it, and a launcher that cannot report a bad image cannot go on to launch
// anything else.
//
// The `from(raw:)` precedent is the same: an unrecognized wire byte is data a
// reader rejects, never a trap.
//
// The swap is a realistic mistake (a launcher whose config maps ordinals to
// roles backwards) and it keeps the two regions disjoint, so what the kernel
// refuses is the magic rather than an overlap. Nothing is copied: all
// validation happens before the first byte moves, so the real destination
// region is untouched and root could try again with the arguments the right
// way round.

import sos.{System, Process, Memory, BootHandle, SosStatus}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS badimage: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    var image = try proc.boot_handle_next() catch {
        print("SOS badimage: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS badimage: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The record hands the region over; see `process-lifecycle` for why
    // `take_memory` is the one way out.
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    // The arguments are swapped on purpose.
    match system.process_create(image: &dest_mem, memory: &image_mem) {
        case Ok(_) -> {
            let _ = system.debug_print("SOS badimage: a region of zeros LOADED\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
        case Err(e) -> print("SOS badimage: create refused: {}\n", e),
    }

    // Root is still here.
    print("SOS badimage: still running, exiting clean\n")
    let _ = proc.exit(EXIT_OK)
}
