// Release, re-mint, and the stale word: the re-mint takes the same slot back
// with a different word, and the old word then faults with "bad handle".
//
// Each transcript line rules something out:
//
//   SOS remint: differs=1 reused=1     the re-mint took the same slot back
//                                      and stamped a different word on it
//   SOS: process fault: bad handle     the old word names nothing now
//   SOS: process teardown ...
//
// `differs` is the word moving: the slot's generation survived the unbind and
// was incremented by it, so the next mint in that slot cannot produce the word
// the last one did.
//
// `reused` is the harder half, and it is asserted without naming the split,
// which matters because `HANDLE_INDEX_BITS` is configurable and a test that
// hardcoded `0xFF` would silently stop checking anything if it moved. The
// argument is arithmetic instead: a first-life word is the bare index
// (generation 0 stamps nothing), so it is a small number bounded by the table
// size; a reused slot's word carries generation bits and is therefore larger
// than any first-life word can be. So the program mints three handles (one it
// releases, one that must take the freed slot back, and one that must land on a
// fresh slot) and asserts the reused one's word is greater than the fresh
// one's. Nothing but a generation stamp can make that true.
//
// The fault is the point. Using a handle you released is broken code, and
// generations turn it from an alias onto a stranger's object into a `BadHandle`
// the kernel names. The protection is best-effort: a word held across a full
// wrap of one slot's generation aliases silently. Tables are per-process, so
// such a collision crosses no boundary and grants nothing.
//
// It goes through the C altitude, and that is half the claim. The typed Saw
// surface has no word extractor and no word constructor (a `Clock` in hand is
// one the kernel handed over), so a claim about a word, and a use of a word the
// caller has already given up, are both unspellable there. `timer-badclock`
// reaches this floor for the mirror reason. The typed layer offers
// `handle-drop-release` instead: the same mechanism seen as scopes rather than
// as numbers.

import sos.{System, ClockType, sos_system_clock_get, sos_handle_release}

static EXIT_FAILED: UInt = 1

/// The status word a successful op answers with (`SosStatus.Ok`), as a number
/// because this file works at the C altitude, where a status is one.
static STATUS_OK: UInt = 0

static YES: UInt = 1
static NO: UInt = 0

func flag(b: Bool) -> UInt {
    if b { YES } else { NO }
}

/// Ask for a Clock, answering the raw handle word, or 0, which names nothing,
/// if the call was refused.
///
/// Every ask mints, so each call here is a fresh capability instance and a
/// fresh word.
func ask_clock(handle: UInt) unsafe -> UInt {
    var out: UInt = 0
    let status = sos_system_clock_get(handle, ClockType.Monotonic as UInt,
                                      (&var out) as UnsafePointer<UInt>)
    if status != STATUS_OK {
        return 0
    }
    out
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    // One: a handle, at generation 0, so its word is the bare index.
    let first = ask_clock(boot_handle)
    if first == 0 {
        let _ = system.debug_print("SOS remint: no clock\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // Two: give it back. Release is ungated (no right is checked, on any kind)
    // and unbinds the entry while incrementing the slot's generation. The
    // object is untouched: the machine's Clock is kernel-eternal and owned by
    // nobody.
    let released = sos_handle_release(first)
    if released != STATUS_OK {
        let _ = system.debug_print("SOS remint: release refused\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // Three: ask again. `mint_handle` takes the lowest free index, which is the
    // one just freed, and stamps it with the generation that survived the
    // unbind, so this word is the same slot at a new life.
    let again = ask_clock(boot_handle)

    // Four: once more, which must land on a slot that has never been used and
    // so carries generation 0, a first-life word, the bare index.
    let fresh = ask_clock(boot_handle)

    print("SOS remint: differs={} reused={}\n",
          flag(again != first),
          flag(again > fresh))

    // Five: the old word. It names a live slot at the wrong life, so it
    // resolves to nothing and the kernel ends this process, which is the reason
    // this case does not exit clean.
    let _ = system.debug_print("SOS remint: using the word we gave back\n")
    let _ = sos_handle_release(first)

    let _ = system.debug_print("SOS remint: survived, which is the bug\n")
    let _ = system.shutdown(EXIT_FAILED)
}
