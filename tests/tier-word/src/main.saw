// The tier word.
//
// The platform advertises what it can deny, and a program reads it once: ask
// the System object, match on the answer, and decide whether to run. A program
// that relies on isolation stops here when the word is `Flat`; a program that
// does not carries on either way.
//
// The transcript, read as three claims:
//
//   SOS tier: Flat            <- the platform said which tier it is
//   SOS tier: stable          <- and it says the same thing every time
//   SOS tier: kernel boundary intact   <- the syscall-path checks still hold
//
// The third line is the one worth arguing about. The flat tier does not
// protect memory, the kernel's included, from a process; it disclaims that
// along with `unmap`'s revocation half and peer isolation. What it does not
// disclaim is the syscall path: handles, rights, quotas and lifetimes are
// checked on every syscall on every tier. This program proves that the only
// way a refusal can be proved: it mints a System sibling with the tier bit
// stripped and asks again. The kernel refuses that ask on a flat platform
// exactly as it would on an isolated one, because rights are not tiered.
//
// That refusal is a fault, not a status: a missing right is a mistake the
// caller could have checked, so the kernel ends the process rather than
// answering it. The program therefore prints its third line before the ask that
// kills it, and the case asserts the process fault and the teardown that
// follows. This program never reaches a clean shutdown and has no `EXIT_OK`.

import sos.{System, ProtectionTier, SystemRight, SosStatus}

static EXIT_FAILED: UInt = 1

// Every System right except `TierGet`: the keep mask that makes the sibling a
// handle which can do everything this program has been doing and cannot ask the
// one question. Spelled as the bits to keep rather than as an inversion,
// because a mask is monotonic and naming what survives is what a launcher
// actually writes.
static KEEP_WITHOUT_TIER: UInt32 = (SystemRight.Debug | SystemRight.Shutdown
                                    | SystemRight.ProcessSelf
                                    | SystemRight.ClockGet
                                    | SystemRight.Mint
                                    | SystemRight.Transfer)

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    // The ask. No arguments, no resource spent, and the answer is one of
    // exactly two words.
    let tier = try system.tier() catch {
        print("SOS tier: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // A `match` rather than a comparison: an exhaustive match makes a third
    // word, were one ever added, a compile error here rather than a silent
    // fall-through.
    match tier {
        case Isolated -> {
            let _ = system.debug_print("SOS tier: Isolated\n")
        },
        case Flat -> {
            let _ = system.debug_print("SOS tier: Flat\n")
        },
    }

    // A platform fact does not change. Asking twice asserts that this op reads
    // a compile-time constant rather than sampling something: an implementation
    // that answered from mutable state would be a different op with the same
    // name.
    let again = try system.tier() catch {
        print("SOS tier: second ask refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    if again != tier {
        let _ = system.debug_print("SOS tier: UNSTABLE\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS tier: stable\n")

    // The syscall-path right check, on whatever tier this is. The sibling holds
    // every System right this handle held except `TierGet`.
    let narrowed = try system.mint(rights: KEEP_WITHOUT_TIER) catch {
        print("SOS tier: mint failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // Printed before the ask, because the ask does not return: a missing right
    // faults the process. This line is the last thing the program says, and the
    // kernel's fault report is the next line in the transcript.
    let _ = system.debug_print("SOS tier: kernel boundary intact\n")

    let _ = narrowed.tier()

    // Unreachable on a correct kernel: the ask above ended this process. A
    // build that gets here has answered a question through a handle that was
    // not allowed to ask it, which is a capability leak and not a tier
    // property, so it fails loudly rather than shutting down cleanly.
    let _ = system.debug_print("SOS tier: UNREACHABLE\n")
    let _ = system.shutdown(EXIT_FAILED)
}
