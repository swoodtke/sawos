// Test child: donates a region another process has mapped, and is killed for
// it.
//
// It holds the region's only handle and carries `SystemRight.SlabDonate`, so
// nothing is refused for want of a right or a sibling reference. The one thing
// it cannot see is that root has a grant row installed on those bytes.
//
// Both arms of the match are unreachable, and print that. The donation does not
// return: `maps != 0` is a fault, not a status (the caller could have checked;
// here the launcher mapped the page before handing it over). If either line
// prints, the kernel absorbed a mapped region or downgraded the refusal to a
// status.

import sos.{System, Process, Memory, SlabKind, SosStatus}

static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        print("SOS donor: no process handle: {}\n", error)
        return
    }

    // One record: the region its launcher gave it. The drain hands records back
    // in give order and there is only one.
    var record = try proc.boot_handle_next() catch {
        print("SOS donor: no region: {}\n", error)
        let _ = proc.exit(EXIT_FAILED)
        return
    }
    guard let region = record.take_memory() else {
        let _ = system.debug_print("SOS donor: the record is not a region\n")
        let _ = proc.exit(EXIT_FAILED)
        return
    }

    let _ = system.debug_print("SOS donor: donating a mapped region\n")

    match system.slab_donate(kind: SlabKind.Waiters, memory: move region) {
        case Ok(_) -> {
            let _ = system.debug_print(
                "SOS donor: UNREACHABLE — a mapped region was absorbed\n")
            let _ = proc.exit(EXIT_FAILED)
        },
        case Err(_) -> {
            let _ = system.debug_print(
                "SOS donor: UNREACHABLE — refused with a status\n")
            let _ = proc.exit(EXIT_FAILED)
        },
    }
}
