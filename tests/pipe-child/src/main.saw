// SOS M4 unit 1: A CONNECTION THAT CROSSES A PROCESS BOUNDARY (sawos design 13
// D-3; spec §2.1, §12).
//
// **THE SEED OF UNIT 5's CLIENT.** Root creates a pair, KEEPS THE OUTLET and
// GIVES THE INLET to a child; the child posts one message and exits; root polls
// until it arrives and prints the bytes. That is the whole of IPC in this
// system, and every mechanism in it already shipped:
//
//   `pipe_create`      one op, two ends, through a copy-out record
//   `give(inlet:)`     the courier op, over a NEW kind — `Transfer` is minted
//                      in `pipe_inlet_rights()` for exactly this
//   the boot drain     the child collects the end the same way it would
//                      collect a region (§12), with the TAG as the only
//                      cross-process vocabulary
//   post / take        data-only, polling, no waitability anywhere
//
// **NOTHING ABOUT THE LAUNCH FLOW CHANGED**, which is the claim design 10
// ruling 3 makes by putting the factory on the Process object: mint a masked
// System sibling, give it, give the pipe end, start naming the boot tag. A
// connection end is a capability like any other, so it rides the machinery
// `give-boot-drain` already proves.
//
// **THE POLL IS BOUNDED AND PARKS BETWEEN ROUNDS.** This image's kernel arms no
// scheduler tick, so the only thing that ever takes the processor away from root
// is root parking — and a spin would be a hang the deadlock report could not
// see. So root takes, and if the ring is empty it arms a timer and waits, at
// most `POLL_ROUNDS` times. The FIRST take necessarily answers `Ok(None)`: the
// child has been made runnable and has not run.
//
// **THE MESSAGE OUTLIVES ITS SENDER.** By the time root reads it the child has
// dropped its inlet and exited — the transcript shows the exit and the teardown
// BEFORE the bytes — so this is also `pipe-peer-gone`'s drain-first rule seen
// across a real process boundary rather than inside one program.

import sos.{System, Process, PipeInlet, PipeOutlet, PipeReply, PipeRequest,
            Clock, ClockType, Timer, Waiter, SosStatus, SystemRight,
            PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// The key root attaches its timer under. A number that appears nowhere else in
/// the transcript.
static KEY: UInt = 81

/// Five milliseconds per poll round — long enough for the child to be scheduled,
/// drain one record, post and exit, and short enough that a broken run ends
/// rather than hanging.
static PARK_NS: UInt64 = 5_000_000

/// The ceiling on the poll. A run that needs more than this has a bug, and
/// printing a miss is a better failure than a spin.
static POLL_ROUNDS: Int = 8

/// ROOT'S CONFIG, and the whole of the contract with the child. `child-post`
/// expects exactly these words; the kernel supplies no meaning for either.
static TAG_BOOT: UInt = 7
static TAG_PIPE: UInt = 9

/// What a child of this launcher may ask its System object for: print, learn its
/// own Process object, and pass a handle on. `Transfer` is in the mask for the
/// reason `give-boot-drain` records — it is the ticket the give itself checks.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// Take, and discharge the obligation by dropping it. The child posted with the
/// TELL idiom — it gave its claim up at once — so nobody is listening and the
/// exchange settles here (sawos design 14).
func take_message(outlet: &PipeOutlet,
                  into: &var [UInt8; PIPE_BODY_BYTES]) -> Result<UInt?, SosStatus> {
    let got = try outlet.take(into: &var into)
    if let (n, request) = move got {
        let _ = move request
        let some: UInt? = n
        return move some
    }
    return None
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS pipechild: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    var image = try proc.boot_handle_next() catch {
        print("SOS pipechild: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS pipechild: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS pipechild: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS pipechild: created\n")

    // **BOTH ENDS ARE MINTED HERE, AND ONLY ONE TRAVELS.** That asymmetry is
    // what makes a launcher a launcher: it decides which side of the
    // conversation each process is on, and the child has no way to ask for the
    // other end because there is no op that produces one from an inlet.
    let pair = try proc.pipe_create() catch {
        print("SOS pipechild: pipe create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (inlet, outlet) = move pair

    let for_child = try system.mint(rights: CHILD_SYSTEM) catch {
        print("SOS pipechild: mint failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        print("SOS pipechild: give system failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    // THE GIVE CONSUMES THE WRAPPER, so there is no way to post through this end
    // below this line — the funnel disarms the value before the syscall and lets
    // it drop. What root gives away it cannot use.
    match child.give(inlet: move inlet, tag: TAG_PIPE) {
        case Ok(_) -> {
            let _ = system.debug_print("SOS pipechild: gave the inlet\n")
        },
        case Err(e) -> {
            print("SOS pipechild: give inlet failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }

    try child.start(boot_tag: TAG_BOOT) catch {
        print("SOS pipechild: start failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS pipechild: started\n")

    // The parking machinery. Unit 1 has no waitable pipe — that is unit 3 — so
    // what root waits on is a TIMER, and the poll is what stands in for the
    // blocking receive the ladder has not reached yet.
    let clock = try system.clock_get(type: ClockType.Monotonic) catch {
        print("SOS pipechild: no clock: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let waiter = try proc.waiter_create() catch {
        print("SOS pipechild: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let timer = try clock.timer_create() catch {
        print("SOS pipechild: no timer: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try waiter.add(&timer, KEY) catch {
        print("SOS pipechild: attach failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    var buf: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    var length: UInt = 0
    var have = false
    var rounds: Int = 0
    while (not have) && rounds < POLL_ROUNDS {
        rounds = rounds + 1
        let got = try take_message(&outlet, &var buf) catch {
            print("SOS pipechild: take refused: {}\n", error)
            let _ = system.shutdown(EXIT_FAILED)
            return
        }
        if let n = got {
            length = n
            have = true
        } else {
            try timer.arm(after_ns: PARK_NS) catch {
                print("SOS pipechild: arm failed: {}\n", error)
                let _ = system.shutdown(EXIT_FAILED)
                return
            }
            try waiter.wait() catch {
                print("SOS pipechild: wait failed: {}\n", error)
                let _ = system.shutdown(EXIT_FAILED)
                return
            }
        }
    }

    if not have {
        let _ = system.debug_print("SOS pipechild: nothing arrived\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS pipechild: received len={} b={},{},{},{}\n", length,
          buf[0] as UInt, buf[1] as UInt, buf[2] as UInt, buf[3] as UInt)

    print("SOS pipechild: done\n")
    let _ = proc.exit(EXIT_OK)
}
