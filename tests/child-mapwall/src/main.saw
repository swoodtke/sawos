// SOS CHILD: THE POLICY CAP IS REACHED BEFORE THE HARDWARE'S (sawos design 7
// D-3; sawlang#232 agenda item 8).
//
// **AGENDA ITEM 8's SENTENCE, FROM THE SIDE THAT CAN SEE IT.** The ruled
// sentence — *a `map()` meeting the physical wall with quota headroom left is a
// kernel bug to assert against* — is written in the kernel as a `fatal`, and a
// `fatal` is by construction a thing no passing run ever shows. This program is
// the other half of the same claim, the half a transcript can carry: it maps
// until it is refused, and the refusal it meets is POLICY's.
//
//   SOS childmapwall: maps=2 quota=1
//
// **A CLEAN RUN IS THE PROOF, and that is worth saying plainly.** If the order
// were the other way round, this child's third map would have met the row
// budget while its ledger still had room — and the machine would have STOPPED
// with `SOS: kernel bug:` instead of printing anything below. So the line above
// existing at all is the ordering, and `quota=1` is which refusal it was.
//
// **THE NUMBERS ARE THE SAME ON BOTH MACHINES**, which is the reason this is a
// child rather than root. A child's mapping allowance is
// `DEFAULT_QUOTA_MAPPINGS`, clamped at install time to the rows its own domain
// has left after its image — two on both profiles, since a two-segment image
// plus its stack spends three of riscv32's eight rows and three of arm64's
// nine, leaving five and six. Root's allowance IS its free row count, which
// differs per profile, so a root-side version of this case would print a
// different number on each machine.
//
// **EACH MAPPING OBJECT IS DROPPED AND EACH ROW STAYS**, which is deliberate
// and is what makes this a ledger test rather than a slab test. `case Ok(_)`
// releases the Mapping the kernel just handed back, so its SLOT returns
// immediately (design 7 D-2) — and the grant row it installed does not, because
// a Mapping owns its row and not the reverse. The mapping quota counts ROWS, so
// the charge stays exactly as long as the row does, and the third map is
// refused even though the Mapping slab is untouched. A ledger that counted
// OBJECTS would have let this loop run forever.

import sos.{System, Process, Memory, Mapping, MapAccess, SosStatus}

/// Read and write, which is what any scratch region wants.
static RW: UInt32 = MapAccess.Read | MapAccess.Write

/// More rounds than the allowance, so the loop is stopped by the kernel rather
/// than by its own counter — and fewer than the free rows on either profile, so
/// a bug that let every round through would still not reach the wall and would
/// present as a wrong NUMBER rather than as a kernel stop.
static ROUNDS: Int = 4

/// What it ends with when the kernel's answers were not the shape this case
/// claims.
static EXIT_MISMATCH: UInt = 97

static YES: UInt = 1
static NO: UInt = 0

func flag(b: Bool) -> UInt {
    if b { YES } else { NO }
}

/// Was this refusal the POLICY one? Matched by NAME rather than by number, so
/// the claim survives a renumbering of the wire table.
func is_quota(status: SosStatus) -> Bool {
    match status {
        case QuotaExceeded -> true,
        case _ -> false,
    }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        print("SOS childmapwall: no process handle: {}\n", error)
        return
    }

    // ONE RECORD: the region its launcher gave it. The tag is the launcher's
    // config and this program does not read it — the drain hands records back
    // in give order and there is only one.
    var record = try proc.boot_handle_next() catch {
        print("SOS childmapwall: no region: {}\n", error)
        let _ = proc.exit(EXIT_MISMATCH)
        return
    }
    guard let region = record.take_memory() else {
        print("SOS childmapwall: the record is not a region\n")
        let _ = proc.exit(EXIT_MISMATCH)
        return
    }

    // **THE SAME REGION, MAPPED INTO ITSELF AGAIN AND AGAIN.** Double-mapping
    // is allowed (design 6 D-3, agenda item 7) — two rows, two Mappings, no
    // aliasing bookkeeping owed on a machine that does not translate — so this
    // spends rows without needing a second region to spend them on.
    var maps: UInt = 0
    var quota = false
    var other = false
    var round = 0
    while round < ROUNDS && not quota && not other {
        match proc.map(memory: &region, access: RW) {
            case Ok(_) -> { maps = maps + 1 },
            case Err(status) -> {
                if is_quota(status) {
                    quota = true
                } else {
                    other = true
                }
            },
        }
        round = round + 1
    }

    print("SOS childmapwall: maps={} quota={}\n", maps, flag(quota))

    if other || not quota {
        let _ = proc.exit(EXIT_MISMATCH)
    }
    // The exit code is the map count, so the launcher reads the same fact
    // through the §8 status word that the console line states.
    let _ = proc.exit(maps)
}
