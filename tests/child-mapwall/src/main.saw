// Test child: the policy quota is reached before the hardware's row budget.
//
// A `map()` that meets the physical wall with quota headroom left is a kernel
// bug, which the kernel asserts with a `fatal` that no passing run shows. This
// program is the half a transcript can carry: it maps until it is refused, and
// the refusal is the quota's.
//
//   SOS childmapwall: maps=2 quota=1
//
// A clean run is the proof. With the order reversed, the third map would meet
// the row budget while the ledger still had room, and the machine would stop
// with `SOS: kernel bug:` instead of printing the line above. The line existing
// at all is the ordering; `quota=1` is which refusal it was.
//
// The numbers are the same on both machines, which is why this is a child
// rather than root. A child's mapping allowance is `DEFAULT_QUOTA_MAPPINGS`,
// clamped at install time to the rows its own domain has left after its image.
// Those leave at least the default on both profiles, so the clamp does not
// bind. Root's allowance is its free row count, which differs per profile, so a
// root-side version would print a different number on each machine.
//
// Each Mapping object is dropped and each row stays, which makes this a ledger
// test rather than a slab test. `case Ok(_)` releases the Mapping the kernel
// handed back, so its slot returns immediately, but the grant row it installed
// does not (a Mapping owns its row, not the reverse). The quota counts rows, so
// the charge stays as long as the row does and the third map is refused even
// though the Mapping slab is untouched. A ledger that counted objects would let
// the loop run forever.

import sos.{System, Process, Memory, Mapping, MapAccess, SosStatus}

/// Read and write, which is what any scratch region wants.
static RW: UInt32 = MapAccess.Read | MapAccess.Write

/// More rounds than the allowance, so the loop is stopped by the kernel rather
/// than by its own counter, and fewer than the free rows on either profile, so
/// a bug that let every round through would not reach the wall and would show
/// as a wrong number rather than as a kernel stop. The launcher gives a page
/// for each.
static ROUNDS: Int = 4

/// What it ends with when the kernel's answers were not the shape this case
/// claims.
static EXIT_MISMATCH: UInt = 97

static YES: UInt = 1
static NO: UInt = 0

func flag(b: Bool) -> UInt {
    if b { YES } else { NO }
}

/// Was this refusal the policy one? Matched by name rather than by number, so
/// the claim survives a renumbering of the wire table.
func is_quota(status: SosStatus) -> Bool {
    match status {
        case QuotaExceeded -> true,
        case _ -> false,
    }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        print("SOS childmapwall: no process handle: {}\n", error)
        return
    }

    // One page per round, each mapped into this process once. The records are
    // the pages its launcher gave it, one per round; the tag is the launcher's
    // config and this program does not read it. Two rows of one process never
    // overlap (spec §2.5), so each row spends a page of its own.
    var maps: UInt = 0
    var quota = false
    var other = false
    var round = 0
    while round < ROUNDS && not quota && not other {
        var record = try proc.boot_handle_next() catch {
            print("SOS childmapwall: no page for round {}: {}\n", round, error)
            let _ = proc.exit(EXIT_MISMATCH)
            return
        }
        guard let region = record.take_memory() else {
            print("SOS childmapwall: the record is not a region\n")
            let _ = proc.exit(EXIT_MISMATCH)
            return
        }
        match proc.map(memory: &region, access: RW) {
            case Ok(_) -> { maps = maps + 1 },
            case Err(status) -> {
                if is_quota(status) {
                    quota = true
                } else {
                    other = true
                }
            },
        }
        round = round + 1
    }

    print("SOS childmapwall: maps={} quota={}\n", maps, flag(quota))

    if other || not quota {
        let _ = proc.exit(EXIT_MISMATCH)
    }
    // The exit code is the map count, so the launcher reads the same fact
    // through the spec.md §8 status word that the console line states.
    let _ = proc.exit(maps)
}
