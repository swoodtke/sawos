// The shipping kernel's entry with the stack report on: a case run on this
// kernel ends with the kernel stack's deepest use printed, and fails if the
// stack's far end was reached.
//
// Everything else is `kernel/main.saw`, so a case that runs on both kernels
// behaves the same on each. The peak is a measurement: the report line is
// printed and never matched, because it moves with every change to the
// kernel.

import kcore.{console, load_root_and_enter, boot_tick_enabled, TICK_PERIOD_US,
              paint_kernel_stack, enable_stack_report}
import hal

@export("kmain")
func kmain() {
    paint_kernel_stack()
    enable_stack_report()

    hal.clock_init()

    let uart = console()
    uart.write_str("SOS M1: kernel up on ")
    uart.write_str(hal.arch_name())
    uart.write_str("\n")

    hal.memory_init()
    hal.intc_init()

    load_root_and_enter(if boot_tick_enabled() { TICK_PERIOD_US } else { 0 })
}
