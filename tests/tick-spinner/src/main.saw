// Preemption of a process that never yields (spec §7).
//
// Root launches `child-spin`, a child that loops forever and makes no syscall,
// then yields. The child is ready and has no reason to give the processor up,
// so root runs again only if the scheduler tick takes the processor away from
// the child: the yield returns once the child's slice has run out. On a kernel
// with no tick the child holds the machine and this program never prints its
// second line.
//
// The yield returning is not the whole claim. Root then reads the child's
// `ProcessStats` and requires its `interrupts` column to be at least one: the
// child took an interrupt while it was the running process, and nothing but the
// tick can have been that interrupt. The value is not printed or compared
// beyond that.
//
//   SOS tickspin: child started
//   SOS tickspin: the tick took the processor from the child
//
// This case's image asks for the tick (the runner's `"tick": True`); the
// others run cooperatively.

import sos.{System, Process, Memory, BootHandle, SosStatus}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS tickspin: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // Row 0 is the child's image blob, row 1 the RAM it runs in: this build's
    // config, which is root's business and never the kernel's.
    var image = try proc.boot_handle_next() catch {
        print("SOS tickspin: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS tickspin: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS tickspin: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    try child.start() catch {
        print("SOS tickspin: start failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS tickspin: child started\n")

    // Everything runnable at the yield runs before it returns, and the child
    // never blocks, yields or exits: only the tick ends its turn.
    let me = try proc.thread_self() catch {
        print("SOS tickspin: no thread: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = me.yield_now()

    let seen = try child.stats() catch {
        print("SOS tickspin: stats failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    if seen.interrupts == 0 {
        let _ = system.debug_print("SOS tickspin: the child took no interrupt\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print(
        "SOS tickspin: the tick took the processor from the child\n")
    let _ = proc.exit(EXIT_OK)
}
