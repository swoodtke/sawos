// A give the kernel refuses for capacity hands a Waiter and a Timer back
// usable (spec §3).
//
// Root creates a child it never starts and gives it masked System siblings,
// one tag each, until the child's handle budget refuses one with
// `QuotaExceeded`. It then makes a Waiter and a Timer and gives each: the
// child's table is still at its budget, so both gives are refused with the
// same status. The refusal is a status, so the kernel left root's entries in
// place, and `Process.give` returns each object in its error payload. Root
// attaches the returned Timer to the returned Waiter, arms it and waits for
// the fire, which only live handles can do.
//
// Root exits still holding both, so its close-all releases them. Its teardown
// line counts one Waiter and one Timer, freed because the refused gives left
// no other name for either.

import sos.{System, Process, Waiter, Timer, ClockType, SystemRight, SosStatus,
            WaitPayload}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// The first boot tag. Each give takes the next one, so no tag repeats and the
/// only refusal left to meet is the budget's.
static TAG_FIRST: UInt = 40

/// The tags of the Waiter and Timer gives, distinct from every sibling's.
static TAG_WAITER: UInt = 90
static TAG_TIMER: UInt = 91

/// The key the returned Timer is attached under, and how soon it fires.
static KEY: UInt = 60
static DELAY_NS: UInt64 = 1_000_000

/// What each sibling carries: `Transfer` so it can be given at all.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS waitablereturns: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&system, &proc) catch {
        print("SOS waitablereturns: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var image = try proc.boot_handle_next()
    var dest = try proc.boot_handle_next()
    guard let image_mem = image.take_memory() else { return SosStatus.BadImage }
    guard let dest_mem = dest.take_memory() else { return SosStatus.BadImage }

    // The child stays `Created`, so every give below is legal and the boot set
    // never freezes.
    let child = try system.process_create(image: &image_mem, memory: &dest_mem)

    var given: UInt = 0
    while true {
        let sibling = try system.mint(rights: CHILD_SYSTEM)
        try child.give(system: move sibling, tag: TAG_FIRST + given) catch {
            let (why, back) = move error
            print("SOS waitablereturns: gave {} siblings then refused: {}\n",
                  given, why)
            let _ = move back
            break
        }
        given = given + 1
    }

    let clock = try system.clock_get(type: ClockType.Monotonic)
    let waiter = try proc.waiter_create()
    let timer = try clock.timer_create()

    let w = try returned_waiter(&child, move waiter)
    let t = try returned_timer(&child, move timer)

    try w.add(timer: &t, key: KEY)
    try t.arm(after_ns: DELAY_NS)
    let woke = try w.wait()
    match woke.what {
        case Timer(fires) -> {
            print("SOS waitablereturns: the returned pair fired: key={} fires={}\n",
                  woke.key, fires)
        },
        case _ -> { return SosStatus.BadImage },
    }
    // `exit` does not return, so the teardown finds both still held.
    let _ = proc.exit(EXIT_OK)
    return
}

/// Give `waiter` to the child; the give must be refused, and the Waiter comes
/// back.
func returned_waiter(child: &Process, waiter: Waiter) -> Result<Waiter, SosStatus> {
    try child.give(waiter: move waiter, tag: TAG_WAITER) catch {
        let (why, back) = move error
        print("SOS waitablereturns: the Waiter give was refused: {}\n", why)
        return move back
    }
    print("SOS waitablereturns: the Waiter give was not refused\n")
    return SosStatus.BadImage
}

/// Give `timer` to the child; the give must be refused, and the Timer comes
/// back.
func returned_timer(child: &Process, timer: Timer) -> Result<Timer, SosStatus> {
    try child.give(timer: move timer, tag: TAG_TIMER) catch {
        let (why, back) = move error
        print("SOS waitablereturns: the Timer give was refused: {}\n", why)
        return move back
    }
    print("SOS waitablereturns: the Timer give was not refused\n")
    return SosStatus.BadImage
}
