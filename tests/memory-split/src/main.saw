// The pool, split (spec §2.5). `split(len)` on a pool root mints a region over
// `len` bytes of the pool (first fit from the pool's free list, else the front
// cut) and the handle keeps naming the rest, so allocation is this call in a
// loop. The transcript reads as three claims:
//
//   SOS split: a=170 b=187 a-again=170       <- the pieces are disjoint
//                                               (0xaa, 0xbb, 0xaa; the bytes
//                                               render as decimal)
//   SOS split: cuts=20 refused=0             <- a dropped piece returns its
//                                               slot, so the slab is not what a
//                                               cursor runs into
//   SOS: process fault: argument outside its domain
//                                            <- an oversize cut is a fault
//
// The second line: `CUT_ROUNDS` is more than the slab has slots
// (`MAX_MEMORIES`), so completing them all with nothing refused is the
// claim. Each cut mints a region, the wrapper dies at the end of the arm, the
// release takes its count to zero, and the slot comes straight back for the
// next round.
//
// The first line proves the arithmetic. A region has no bounds reader, so "the
// parent advanced" cannot be observed by asking. It is observed by using both
// pieces: write 0xaa into the first, 0xbb into the second, read the first
// again. A parent that had not advanced would hand out the same range twice and
// the second write would have destroyed the first.
//
// The maps are what make the writes possible at all. Every address in this
// program faults until mapped; the pool is memory this image never declared and
// the linker never heard of.
//
// The last line is deliberately a death. `BadArg` is a fault by the faults
// rule, spec §5.7 (a caller that asks for more than it holds could have
// checked), so the only way to assert it is to meet it, and a case that meets
// a fault ends there. Everything above it has already been proven by then.

import sos.{System, Process, Memory, Mapping, MapAccess, SosStatus}

// The address of this program's first mapping: its config, per architecture, in
// C because Saw cannot name an address. See `tests/poolbase_riscv32.c`.
extern "C" {
    func sos_test_pool_base() -> UInt
}

/// One protection unit's worth on either profile: 4 KiB is a multiple of both
/// `PROT_GRAIN`s, so one number serves both machines.
static CHUNK: UInt = 0x1000

/// Read and write, which is what a scratch region wants. The bits fold at this
/// annotated `static` because a fixed-width slot is a const position.
static RW: UInt32 = MapAccess.Read | MapAccess.Write

/// A length no remaining pool can satisfy: the oversize cut.
static OVERSIZE: UInt = 0x0100_0000

/// How many cut-and-drop rounds the loop runs. Past `MAX_MEMORIES` on purpose:
/// a run that completes this many rounds with nothing refused is possible only
/// because a dropped region gives its slot back. It is also far inside the
/// pool's own supply (many chunks, two of them already cut above), so the
/// number this loop stops at is the one this program chose and not one the
/// machine imposed.
static CUT_ROUNDS: Int = 20

static EXIT_FAILED: UInt = 1

/// Write one byte through a mapping. `unsafe` because it names a pointer type,
/// and confined to one line.
func poke(addr: UInt, value: UInt8) unsafe {
    UnsafeMemory<UInt8, Normal>(addr).write(value)
}

/// Read one byte back.
func peek(addr: UInt) unsafe -> UInt8 {
    UnsafeMemory<UInt8, Normal>(addr).read()
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS split: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The boot set carries one row: the RAM pool. Its tag is 0 because it is
    // the only row, which is root's config knowing the build's row order.
    var record = try proc.boot_handle_next() catch {
        print("SOS split: no pool region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let pool = record.take_memory() else {
        let _ = system.debug_print("SOS split: boot record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let base = sos_test_pool_base()

    // Cut one. The piece covers `[base, base + CHUNK)` and `pool` now names
    // everything after it.
    let first = try pool.split(len: CHUNK) catch {
        print("SOS split: first cut failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _first_map = try proc.map(memory: &first, access: RW) catch {
        print("SOS split: first map failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    poke(base, 0xAA)

    // Cut two, which lands where the cursor now points.
    let second = try pool.split(len: CHUNK) catch {
        print("SOS split: second cut failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _second_map = try proc.map(memory: &second, access: RW) catch {
        print("SOS split: second map failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    poke(base + CHUNK, 0xBB)

    // The disjointness claim, as a value: the first byte is still what it was.
    print("SOS split: a={} b={} a-again={}\n", peek(base) as Int,
          peek(base + CHUNK) as Int, peek(base) as Int)

    // A dropped piece returns its slot. `case Ok(_)` binds nothing, so the
    // region the kernel just minted dies at the end of the arm and its deinit
    // releases the only handle onto it, which takes the reference count to zero
    // inside that release, and the slot is free before the next round asks for
    // one. `CUT_ROUNDS` is past the slab's slots (`MAX_MEMORIES`), so
    // `refused=0` is only possible if the recycling is real.
    var cuts = 0
    var refused: UInt = 0
    while cuts < CUT_ROUNDS && refused == 0 {
        match pool.split(len: CHUNK) {
            case Ok(_) -> { cuts = cuts + 1 },
            case Err(_) -> { refused = 1 },
        }
    }
    print("SOS split: cuts={} refused={}\n", cuts, refused)

    // An oversize cut is a fault. The caller knows what it has split off;
    // asking for more than it holds is a mistake it could have checked, so it
    // ends here.
    let _ = system.debug_print("SOS split: asking for more than is left\n")
    let _ = pool.split(len: OVERSIZE)

    let _ = system.debug_print("SOS split: UNREACHABLE\n")
    let _ = system.shutdown(EXIT_FAILED)
}
