// An unspent right on a connection end (spec §3).
//
// The attenuation proof for the pipe kinds. `pipe_inlet_rights()` mints
// `Transfer | Mint | Post | Wait` and has to be permissive: attenuation is
// monotonic, so a bit not minted at creation could never appear later. The
// narrowing is therefore the holder's, written once as a `MINT_OP` keep mask,
// and this program executes that:
//
//   SOS nopost: minted without Post     a sibling that may travel and may mint
//   SOS: process fault: access denied   ...and may not send a single byte
//
// The mask names `Transfer | Mint` and says nothing about `Post` or `Wait`: a
// keep mask's polarity makes the unnamed bits absent. A launcher can hand a
// child such a sibling and the child holds a real connection end it can pass
// on and can never write to, stated once at the mint rather than checked at
// every post.
//
// Spending the missing right is a fault and not a status: a process knows
// which rights it holds, so the mistake is one it could have checked. The
// kernel terminates the process and stays up to say so.

import sos.{System, Process, PipeInlet, PipeOutlet, SosStatus, PipeInletRight,
            PIPE_BODY_BYTES}

static EXIT_FAILED: UInt = 1

/// The keep mask; `Post` is absent. Two bits, reading as the policy it is:
/// this end may be handed on and may be narrowed further, and may not be used.
static NO_POST: UInt32 = (PipeInletRight.Transfer | PipeInletRight.Mint)

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS nopost: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let pair = try proc.pipe_create() catch {
        print("SOS nopost: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (inlet, outlet) = move pair

    let narrowed = try inlet.mint(rights: NO_POST) catch {
        print("SOS nopost: mint failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS nopost: minted without Post\n")

    // A second name is a second reference on this connection's inlet column,
    // so the original is still able to post; what is refused is this handle,
    // which makes attenuation per-capability rather than per-object.
    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 1
    match narrowed.post(body: &msg, len: 1) {
        case Ok(_) -> {
            let _ = system.debug_print("SOS nopost: an unspent right posted\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
        // Unreachable: the kernel ends this process at the rights check. The
        // arm is written so the refusal reads as a refusal rather than as a
        // missing case.
        case Err(e) -> {
            print("SOS nopost: post refused: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
}
