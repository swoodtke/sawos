// SOS M3 unit 3: THE MASK HOLDS AT RUN TIME (sawos design 4, as ruled Aug 29).
//
// `give-boot-drain` shows what a masked System handle LETS a child do. This
// shows what it does not, which is the half that makes a keep mask a security
// property rather than a convenience:
//
//   SOS noshutdown: started a child that may print and not stop the machine
//   SOS childover: I can print, so Debug travelled
//   SOS childover: now trying to stop the machine
//   SOS: process fault: access denied process=1
//   SOS: process teardown ... process=1
//   SOS noshutdown: root survived child status=131075
//   SOS noshutdown: done
//
// **`Shutdown` IS ABSENT BY SILENCE**, which is the polarity ruling doing its
// work: this launcher's mask names `Debug` and `ProcessSelf` and `ClockGet`, and
// a right it never mentions is a right the child does not get — today, and when
// the System object grows one nobody has thought of yet.
//
// **THE FAULT NAMES PROCESS 1, AND THE MACHINE KEEPS RUNNING.** A masked bit is
// enforced by the same path a never-minted one is — the rights check in the
// dispatch, then design 178's faults ruling ending the caller — so the child
// dies and root does not. `status=131075` is that fact arriving as a VALUE
// through the Process handle root kept: `Faulted` (2) in the high half,
// `AccessDenied` (3) in the low. The console says it and the status word says
// it, from the two sides of the boundary.
//
// **A KEEP MASK CANNOT BE UNDONE FROM INSIDE.** The child holds no `Mint` and no
// `Transfer` either, and even if it held `Mint` a sibling's rights are a SUBSET
// of its source's — so there is no sequence of ops that recovers `Shutdown`.
// That is what makes the one line of policy at the top of this file the whole of
// the policy.
//
// ROOT PARKS ON A GENEROUS TIMER while the child runs, so the ordering is forced
// rather than raced.

import sos.{System, Process, Memory, BootHandle, Clock, ClockType, Timer,
            Waiter, SosStatus, SystemRight}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

static KEY: UInt = 77
static PARK_NS: UInt64 = 20_000_000

static TAG_BOOT: UInt = 7

/// **THE POLICY.** Print, name yourself, tell the time. `Shutdown` is not here,
/// which is the whole of the case. `Transfer` is, because it is the bit `give`
/// checks on the thing being given — a launcher cannot narrow below the ticket
/// that lets the narrowed handle arrive (see `give-boot-drain`'s note).
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.ClockGet | SystemRight.Transfer)

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = match system.process_self() {
        case Ok(p) -> p,
        case Err(_) -> {
            let _ = system.debug_print("SOS noshutdown: no process handle\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }

    var image = match proc.boot_handle_next() {
        case Ok(h) -> h,
        case Err(e) -> {
            print("SOS noshutdown: no image region: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    var dest = match proc.boot_handle_next() {
        case Ok(h) -> h,
        case Err(e) -> {
            print("SOS noshutdown: no destination region: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = match system.process_create(image: &image_mem,
                                            memory: &dest_mem) {
        case Ok(c) -> c,
        case Err(e) -> {
            print("SOS noshutdown: create failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }

    let for_child = match system.mint(rights: CHILD_SYSTEM) {
        case Ok(s) -> s,
        case Err(e) -> {
            print("SOS noshutdown: mint failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    match child.give(system: move for_child, tag: TAG_BOOT) {
        case Ok(_) -> {},
        case Err(e) -> {
            print("SOS noshutdown: give failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    match child.start(boot_tag: TAG_BOOT) {
        case Ok(_) -> {},
        case Err(e) -> {
            print("SOS noshutdown: start failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    let _ = system.debug_print(
        "SOS noshutdown: started a child that may print and not stop the machine\n")

    // Park, so the child gets the processor and oversteps.
    let clock = match system.clock_get(type: ClockType.Monotonic) {
        case Ok(c) -> c,
        case Err(e) -> {
            print("SOS noshutdown: no clock: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    let waiter = match proc.waiter_create() {
        case Ok(w) -> w,
        case Err(e) -> {
            print("SOS noshutdown: no waiter: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    let timer = match clock.timer_create() {
        case Ok(t) -> t,
        case Err(e) -> {
            print("SOS noshutdown: no timer: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    match waiter.add(&timer, KEY) {
        case Ok(_) -> {},
        case Err(e) -> {
            print("SOS noshutdown: attach failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    match timer.arm(after_ns: PARK_NS) {
        case Ok(_) -> {},
        case Err(e) -> {
            print("SOS noshutdown: arm failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    match waiter.wait() {
        case Ok(_) -> {},
        case Err(e) -> {
            print("SOS noshutdown: wait failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }

    // THE MACHINE IS STILL HERE, which is the claim. The child asked to stop it
    // and was refused; the refusal killed the asker.
    let status = match child.get_status() {
        case Ok(s) -> s,
        case Err(e) -> {
            print("SOS noshutdown: status failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    print("SOS noshutdown: root survived child status={}\n", status)

    print("SOS noshutdown: done\n")
    let _ = proc.exit(EXIT_OK)
}
