// Test child launcher: a keep mask holds at run time.
//
// `give-boot-drain` shows what a masked System handle lets a child do. This
// shows what it does not, which makes a keep mask a security property rather
// than a convenience:
//
//   SOS noshutdown: started a child that may print and not stop the machine
//   SOS childover: I can print, so Debug travelled
//   SOS childover: now trying to stop the machine
//   SOS: process fault: access denied process=1
//   SOS: process teardown ... process=1
//   SOS noshutdown: root survived child status=131075
//   SOS noshutdown: done
//
// `Shutdown` is absent by silence: this launcher's mask names `Debug`,
// `ProcessSelf`, `ClockGet` and `Transfer`, and a right it never mentions is a
// right the child does not get, including rights the System object grows later.
//
// The fault names process 1 and the machine keeps running. A masked bit is
// enforced by the same path as a never-minted one (the rights check in the
// dispatch, then the fault ending the caller), so the child dies and root does
// not. `status=131075` is that fact as a value through the Process handle root
// kept: `Faulted` (2) in the high half, `AccessDenied` (3) in the low.
//
// A keep mask cannot be undone from inside. The child holds no `Mint`, and even
// with `Mint` a sibling's rights are a subset of its source's, so no sequence
// of ops recovers `Shutdown`.
//
// Root parks on a generous timer while the child runs, so the ordering is
// forced rather than raced.

import sos.{System, Process, Memory, BootHandle, Clock, ClockType, Timer,
            Waiter, SosStatus, SystemRight}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

static KEY: UInt = 77
static PARK_NS: UInt64 = 20_000_000

static TAG_BOOT: UInt = 7

/// The policy: print, name yourself, tell the time. `Shutdown` is not here,
/// which is the point of the case. `Transfer` is, because it is the bit `give`
/// checks on the thing being given: a launcher cannot narrow below the ticket
/// that lets the narrowed handle arrive (see `give-boot-drain`).
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.ClockGet | SystemRight.Transfer)

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS noshutdown: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    var image = try proc.boot_handle_next() catch {
        print("SOS noshutdown: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS noshutdown: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS noshutdown: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let for_child = try system.mint(rights: CHILD_SYSTEM) catch {
        print("SOS noshutdown: mint failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        print("SOS noshutdown: give failed: {}\n", error.0)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try child.start(boot_tag: TAG_BOOT) catch {
        print("SOS noshutdown: start failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print(
        "SOS noshutdown: started a child that may print and not stop the machine\n")

    // Park, so the child gets the processor and oversteps.
    let clock = try system.clock_get(type: ClockType.Monotonic) catch {
        print("SOS noshutdown: no clock: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let waiter = try proc.waiter_create() catch {
        print("SOS noshutdown: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let timer = try clock.timer_create() catch {
        print("SOS noshutdown: no timer: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try waiter.add(&timer, KEY) catch {
        print("SOS noshutdown: attach failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try timer.arm(after_ns: PARK_NS) catch {
        print("SOS noshutdown: arm failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try waiter.wait() catch {
        print("SOS noshutdown: wait failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The machine is still here. The child asked to stop it and was refused;
    // the refusal killed the asker.
    let status = try child.get_status() catch {
        print("SOS noshutdown: status failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS noshutdown: root survived child status={}\n", status)

    print("SOS noshutdown: done\n")
    let _ = proc.exit(EXIT_OK)
}
