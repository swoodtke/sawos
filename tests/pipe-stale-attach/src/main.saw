// SOS M4 unit 4: A STAGED HANDLE STAYS THE SENDER'S, AND A SENDER MAY LET IT GO
// (sawos design 18; `designs/010` ruling 5, the first of its three consequences;
// spec §2.1's rendezvous).
//
// **THE LEDGER NEVER HAS AN IN-FLIGHT LIMBO STATE.** A handle attached to a
// message is NOT copied anywhere and NOT counted anywhere new: the entry stays
// bound in the sender's own table, counted on its object's column and charged to
// the sender's handle quota, and what the ring slot records is a NOTE saying
// which table to look in and which word to look for. The transfer happens at the
// RENDEZVOUS and nowhere else.
//
// That design has one consequence a program can actually see, and this case is
// it: **THE SENDER MAY RELEASE A STAGED ENTRY, AND THE SLOT THEN ARRIVES EMPTY.**
// Fire-and-forget is a shape §2.1 blesses, so a sender is not held to a message
// it has already handed over; the take re-validates each staged word through the
// ordinary generation check, and a word whose entry is gone is delivered as an
// EMPTY SLOT. NOTHING LEAKED, NOTHING WAS FORGED, and the receiver was told the
// truth — which is the alternative to counting a reference nobody could later be
// sure to drop.
//
// **IT IS WRITTEN AT THE C ALTITUDE, AND THAT IS A FINDING RATHER THAN A
// SHORTCUT.** The typed `PipeHandles.put` DISARMS the wrapper it takes, which is
// the transfer-funnel contract and is what keeps two owners of one word from
// ever existing — so a Saw program that attaches a handle to a message has no
// name left for it and CANNOT release it. Reaching this state at all takes a raw
// caller assembling the send record by hand, exactly as `pipe-dead-claim` has to
// ask a second time through a spent value to show that the kernel's check is
// real underneath the wrapper's.
//
// TWO ROUNDS, IDENTICAL BUT FOR ONE RELEASE. The control round proves a staged
// handle arrives; the second releases the sender's entry between the post and
// the take and proves the slot arrives empty. One number each, printed together,
// so the transcript carries the difference rather than an assertion about it.

import sos.{System, SosStatus, PIPE_BODY_BYTES, PIPE_MSG_HANDLES,
            sos_system_process_self,
            sos_process_pipe_create, sos_handle_release, sos_handle_mint,
            sos_pipe_inlet_post, sos_pipe_outlet_take}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// The status word a successful raw op answers with (`SosStatus.Ok`). Spelled as
/// a number because this file works at the C altitude, where a status is one.
static STATUS_OK: UInt = 0

/// **KEEP EVERY RIGHT** — all-ones, which is what the typed `mint()` default
/// means. Spelled as a number for `STATUS_OK`'s reason.
static KEEP_ALL: UInt = 0xFFFF_FFFF

/// A word that names nothing.
static NO_WORD: UInt = 0

/// Words in a `PipeCreate` answer: the inlet, then the outlet.
static CREATE_WORDS: Int = 2

/// The send record's shape, at the altitude that has to build it by hand: a body
/// ADDRESS, a length, and one word per message handle slot. `sosabi` publishes
/// the layout and a raw caller mirrors it, which is the contract every other
/// record in this tree crosses on.
static SEND_BODY_WORD: Int = 0
static SEND_LEN_WORD: Int = 1
static SEND_HANDLE_WORD_0: Int = 2
static SEND_RECORD_WORDS: Int = 2 + PIPE_MSG_HANDLES

/// Words this file gives a `Take` to answer into.
///
/// **IT IS AN OVER-PROVISION, NOT THE RECORD'S SIZE** (the at-least rule): a
/// copy-out capacity may be larger than the record where an inbound length may
/// not, and a caller at this altitude cannot name `pipe_take_record_bytes()` —
/// it is `sosabi`'s, which this file neither imports nor could. Sixty-four
/// machine words is 256 bytes on the 32-bit profile and 512 on the 64-bit one,
/// comfortably past both profiles' record.
static TAKE_BUF_WORDS: Int = 64

/// Where the two things this file reads out of a take's answer live.
///
/// **WORD 1 IS THE PACKED META ON BOTH PROFILES, AND THAT IS THE FIXED-PREFIX
/// RULE PAYING FOR ITSELF.** The record is the obligation, then the meta, then
/// the handle words, then the body — everything fixed-size ahead of the variable
/// tail — so the meta begins at the machine word after the obligation whatever
/// the word size is. Its FIRST byte is the message's length and the kind bytes
/// follow, so `kinds[0]` is the second byte of that word: on a little-endian
/// profile, a shift of eight.
static TAKE_REQUEST_WORD: Int = 0
static TAKE_META_WORD: Int = 1
static META_KIND0_SHIFT: Int = 8
static BYTE_MASK: UInt = 0xFF

/// Which word the first HANDLE slot lands in — and it is the one number in this
/// file that differs per profile, because the meta's five bytes occupy TWO
/// machine words on the 32-bit profile and ONE on the 64-bit one. Deriving it
/// rather than writing it is what keeps the file honest on both: the handle
/// region is word-aligned, so it starts at the first whole word after the
/// obligation and the meta.
///
/// A FUNCTION and not a `static` for the tree's usual reason: `sizeof<T>()` does
/// not fold in a static initializer.
func take_handle_word_0() -> Int {
    1 + (((1 + PIPE_MSG_HANDLES) + sizeof<UInt>() - 1) / sizeof<UInt>())
}

@export("_start")
func _start(boot_handle: UInt) {
    // **THE TYPED `System` IS BUILT AND THEN NOT USED, AND IT HAS TO BE.**
    // `System(boot_handle:)` is what PARKS the handle the freestanding runtime
    // writes the console through (`sos.rt`), so a file that works entirely at the
    // C altitude and still wants to `print` builds one first. Everything below
    // this line is raw words on purpose; this one line is what makes the raw
    // program able to say anything at all.
    let system = System(boot_handle: boot_handle)

    let proc = ask_process(boot_handle)
    if proc == NO_WORD {
        print("SOS staleattach: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // TWO CONNECTIONS: one to send THROUGH, and one whose client end is the
    // capability being sent. The second carries no traffic — it exists to be a
    // givable handle with a kind a receiver can name.
    var carrier: [UInt; CREATE_WORDS] = [0; CREATE_WORDS]
    if make_pipe(proc, &var carrier) != STATUS_OK {
        print("SOS staleattach: create refused\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var cargo: [UInt; CREATE_WORDS] = [0; CREATE_WORDS]
    if make_pipe(proc, &var cargo) != STATUS_OK {
        print("SOS staleattach: second create refused\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let inlet = carrier[0]
    let outlet = carrier[1]
    let spare = cargo[0]

    let live = round(inlet, outlet, spare, false)
    let dead = round(inlet, outlet, spare, true)

    print("SOS staleattach: kept={} released={}\n", live, dead)
    if live == 0 {
        print("SOS staleattach: a live handle went missing\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    if dead != 0 {
        print("SOS staleattach: a released handle arrived anyway\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS staleattach: a released staged handle arrives as an empty slot\n")

    let _ = sos_handle_release(cargo[1])
    let _ = sos_handle_release(cargo[0])
    let _ = sos_handle_release(carrier[1])
    let _ = sos_handle_release(carrier[0])
    let _ = sos_handle_release(proc)
    let _ = system.shutdown(EXIT_OK)
}

/// This process's own Process handle, or `NO_WORD`.
func ask_process(boot: UInt) unsafe -> UInt {
    var out: UInt = 0
    if sos_system_process_self(boot, KEEP_ALL,
                               (&var out) as UnsafePointer<UInt>) != STATUS_OK {
        return NO_WORD
    }
    out
}

/// A connection, as two raw words.
func make_pipe(proc: UInt, into: &var [UInt; CREATE_WORDS]) unsafe -> UInt {
    sos_process_pipe_create(proc, (&var into) as UnsafePointer<UInt>,
                            (CREATE_WORDS * sizeof<UInt>()) as UInt)
}

/// One round: mint a sibling of `spare`, attach IT to a message, optionally
/// release the sibling before the take, and answer the kind byte the take
/// delivered — zero exactly when the slot arrived empty.
///
/// **THE SIBLING IS WHAT MAKES THE TWO ROUNDS COMPARABLE.** A mint is a second
/// NAME on the same connection end, so both rounds send the same KIND of thing
/// and differ only in whether the sender let its name go before the rendezvous.
func round(inlet: UInt, outlet: UInt, spare: UInt, release_it: Bool) unsafe -> UInt {
    let word = mint_sibling(spare)
    if word == NO_WORD {
        print("SOS staleattach: mint refused\n")
        return 0
    }
    if post_with_handle(inlet, word) != STATUS_OK {
        print("SOS staleattach: post refused\n")
        return 0
    }
    if release_it {
        // **THE SENDER LETS IT GO.** Nothing about staging took a reference, so
        // this is an ordinary release of an ordinary entry — and the note the
        // ring slot holds now names a word that resolves to nothing.
        let _ = sos_handle_release(word)
    }
    // **THE SENDER'S WORD IS STALE FROM HERE, ON THE ROUND THAT DELIVERED.**
    // The rendezvous UNBOUND it — that is the whole of what "the entry moves"
    // means — so releasing it would be the ordinary `BadHandle` fault design 3's
    // generations exist to draw. What this process holds instead is the word the
    // take rebound, and `take_kind` releases that one.
    take_kind(outlet)
}

/// A second NAME for whatever `spare` names, as a raw word.
func mint_sibling(spare: UInt) unsafe -> UInt {
    var out: UInt = 0
    if sos_handle_mint(spare, KEEP_ALL,
                       (&var out) as UnsafePointer<UInt>) != STATUS_OK {
        return NO_WORD
    }
    out
}

/// Post a one-byte message carrying `word` in its first handle slot, and drop
/// the claim — §2.1's TELL idiom, because this case is about the HANDLE and not
/// about the answer.
func post_with_handle(inlet: UInt, word: UInt) unsafe -> UInt {
    var body: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    body[0] = 1
    var args: [UInt; SEND_RECORD_WORDS] = [0; SEND_RECORD_WORDS]
    args[SEND_BODY_WORD] = ((&var body) as UnsafePointer<UInt8>) as UInt
    args[SEND_LEN_WORD] = 1
    args[SEND_HANDLE_WORD_0] = word
    var claim: UInt = 0
    let status = sos_pipe_inlet_post(inlet, (&var args) as UnsafePointer<UInt>,
                                     (SEND_RECORD_WORDS * sizeof<UInt>()) as UInt,
                                     (&var claim) as UnsafePointer<UInt>)
    if status != STATUS_OK {
        return status
    }
    // The claim is given up at once, which is what makes this a tell.
    let _ = sos_handle_release(claim)
    STATUS_OK
}

/// Take one message and answer the KIND BYTE of its first handle slot, releasing
/// everything the take minted.
///
/// **THE KIND BYTE IS WHAT SAYS A SLOT IS OCCUPIED**, at every position: a slot's
/// kind and its word are zero together, so a decode reads the kinds first and
/// never looks at a word it was not told about. Reading it here is reading
/// exactly what `sos.pipe`'s own decode reads, one altitude down.
func take_kind(outlet: UInt) unsafe -> UInt {
    var buf: [UInt; TAKE_BUF_WORDS] = [0; TAKE_BUF_WORDS]
    let status = sos_pipe_outlet_take(outlet, (&var buf) as UnsafePointer<UInt>,
                                      (TAKE_BUF_WORDS * sizeof<UInt>()) as UInt)
    if status != STATUS_OK {
        print("SOS staleattach: take refused\n")
        return 0
    }
    // Discharging the obligation by RELEASE tells a client that is still
    // listening `PeerClosed`; nobody is listening here, so the exchange settles.
    let _ = sos_handle_release(buf[TAKE_REQUEST_WORD])
    // ...and a handle that DID arrive is released too, so the two rounds start
    // from the same table. A zero word releases nothing, which is what the empty
    // slot answers.
    let carried = buf[take_handle_word_0()]
    if carried != NO_WORD {
        let _ = sos_handle_release(carried)
    }
    (buf[TAKE_META_WORD] >> META_KIND0_SHIFT) & BYTE_MASK
}
