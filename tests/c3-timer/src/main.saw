// SOS design 20, the `timer` SMOKE CASE — ESP32-C3, NON-GATING.
//
// A SYSTIMER TARGET0 alarm reaches the CPU THROUGH THE INTERRUPT MATRIX, and it
// does so five times. The transcript is read as an order:
//
//   SOS c3timer: arming
//   SOS c3timer: tick 1 key=37 fires=1
//   ...
//   SOS c3timer: tick 5 key=37 fires=1
//   SOS c3timer: done ticks=5 slept=1
//
// WHAT FIVE TICKS PROVE THAT ONE WOULD NOT. One arrival could be a latched
// status the kernel happened to poll at the right moment; five successive
// one-shot arms cannot be, because each is armed only after the previous one
// was reported, so every arrival after the first is a fresh edge that had to be
// routed through the matrix and taken as a trap while the process was parked.
// That is the board half of the case — the C3's alarm is an EDGE source, and an
// edge that arrives with the delivery path down is lost forever, so a HAL that
// armed before configuring would stall here on tick 1 rather than answer wrong.
//
// WHAT `slept=1` PROVES. It compares clock readings taken either side of the
// whole loop and asserts that at least the armed delay times the tick count
// passed, so a `wait` that returned immediately — a readiness bug, or a kernel
// mistaking the latched status for a fresh fire — fails here even though the
// tick count would look right.
//
// This image's kernel arms NO scheduler tick and the process has ONE thread, so
// at each wait there is nothing runnable and no other thread that could ever
// make something runnable. The only wake source is the clock.
//
// THERE IS NO ACK ANYWHERE IN THIS FILE — the wait that reported the fire is
// what consumed it, exactly as on virt. The board's own acknowledgement (the
// SYSTIMER status latch and the matrix's edge latch) is the HAL's business and
// never a program's.

import sos.{System, Process, Clock, ClockType, Timer, Waiter, WaitResult,
            WaitPayload}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

static YES: UInt = 1
static NO: UInt = 0

/// The key this case attaches under and expects back — a number no bit pattern
/// in this file could produce by accident.
static KEY: UInt = 37

/// Two milliseconds, the same delay the virt profile's timer cases use: long
/// enough that the wait genuinely parks, short enough that five of them cost
/// nothing.
static DELAY_NS: UInt64 = 2_000_000

/// How many times the alarm must arrive. Five, for the reason in the header.
static TICKS: UInt = 5

func flag(b: Bool) -> UInt {
    if b { YES } else { NO }
}

/// The fire count out of the record the kernel copied into this process's
/// memory while the thread was parked.
func fires_of(r: &WaitResult) -> UInt {
    match r.what {
        case Timer(fires) -> fires,
        case _ -> panic("this program attached only a Timer"),
    }
}

func now_of(clock: &Clock) -> UInt64 {
    try clock.now() catch { 0u64 }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS c3timer: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let clock = try system.clock_get(type: ClockType.Monotonic) catch {
        print("SOS c3timer: no clock: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let waiter = try proc.waiter_create() catch {
        print("SOS c3timer: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let timer = try clock.timer_create() catch {
        print("SOS c3timer: no timer: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // ATTACH BEFORE ARMING. A disarmed Timer is never ready, so this attach
    // reports nothing and the loop below is reached with a wait set that only
    // an arm can fill.
    try waiter.add(&timer, KEY) catch {
        print("SOS c3timer: attach failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // READ THE CLOCK BEFORE THE FIRST ARM, not after: the deadline is set
    // relative to the arm, so a reading taken later would be after the instant
    // the delay is measured from and `slept` could read false on a correct
    // kernel.
    let before = now_of(&clock)

    let _ = system.debug_print("SOS c3timer: arming\n")

    var n: UInt = 0
    while n < TICKS {
        // No `interval_ns`, so each of these is a ONE-SHOT that disarms itself
        // when it fires. Arming again is the whole of what it takes to use the
        // same Timer once more — no detach, no re-attach, no ack — which is why
        // every pass after the first is a genuinely fresh edge.
        try timer.arm(after_ns: DELAY_NS) catch {
            print("SOS c3timer: arm failed: {}\n", error)
            let _ = system.shutdown(EXIT_FAILED)
            return
        }
        let r = try waiter.wait() catch {
            print("SOS c3timer: wait failed: {}\n", error)
            let _ = system.shutdown(EXIT_FAILED)
            return
        }
        n = n + 1
        print("SOS c3timer: tick {} key={} fires={}\n", n, r.key, fires_of(&r))
    }

    let after = now_of(&clock)
    print("SOS c3timer: done ticks={} slept={}\n",
          n, flag(after - before >= DELAY_NS * (TICKS as UInt64)))
    let _ = proc.exit(EXIT_OK)
}
