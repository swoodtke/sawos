// Smoke case (ESP32-C3): a SYSTIMER TARGET0 alarm reaches the CPU
// through the interrupt matrix, five times. The transcript reads:
//
//   SOS c3timer: arming
//   SOS c3timer: tick 1 key=37 fires=1
//   ...
//   SOS c3timer: tick 5 key=37 fires=1
//   SOS c3timer: done ticks=5 slept=1
//
// Five ticks prove what one would not. One arrival could be a latched status
// the kernel happened to poll at the right moment. Five successive one-shot
// arms cannot be, because each is armed only after the previous one was
// reported, so every arrival after the first is a fresh edge that had to be
// routed through the matrix and taken as a trap while the process was parked.
// The C3's alarm is an edge source, and an edge that arrives with the
// delivery path down is lost, so a HAL that armed before configuring would
// stall on tick 1 rather than answer wrong.
//
// `slept=1` compares clock readings taken either side of the whole loop and
// asserts that at least the armed delay times the tick count passed. A `wait`
// that returned immediately (a readiness bug, or a kernel mistaking the
// latched status for a fresh fire) fails here even though the tick count
// would look right.
//
// This image's kernel arms no scheduler tick and the process has one thread,
// so at each wait nothing is runnable and the only wake source is the clock.
//
// There is no ack in this file: the wait that reported the fire consumed it,
// as on virt. The board's own acknowledgement (the SYSTIMER status latch and
// the matrix's edge latch) is the HAL's business.

import sos.{System, Process, Clock, ClockType, Timer, Waiter, WaitResult,
            WaitPayload}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

static YES: UInt = 1
static NO: UInt = 0

/// The key this case attaches under and expects back.
static KEY: UInt = 37

/// Two milliseconds, the delay the virt profile's timer cases use: long enough
/// that the wait parks, short enough that five of them cost nothing.
static DELAY_NS: UInt64 = 2_000_000

/// How many times the alarm must arrive (see the header).
static TICKS: UInt = 5

func flag(b: Bool) -> UInt {
    if b { YES } else { NO }
}

/// The fire count out of the record the kernel copied into this process's
/// memory while the thread was parked.
func fires_of(r: &WaitResult) -> UInt {
    match r.what {
        case Timer(fires) -> fires,
        case _ -> panic("this program attached only a Timer"),
    }
}

func now_of(clock: &Clock) -> UInt64 {
    try clock.now() catch { 0u64 }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS c3timer: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let clock = try system.clock_get(type: ClockType.Monotonic) catch {
        print("SOS c3timer: no clock: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let waiter = try proc.waiter_create() catch {
        print("SOS c3timer: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let timer = try clock.timer_create() catch {
        print("SOS c3timer: no timer: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // Attach before arming. A disarmed Timer is never ready, so this attach
    // reports nothing and the loop below starts with a wait set that only an
    // arm can fill.
    try waiter.add(&timer, KEY) catch {
        print("SOS c3timer: attach failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // Read the clock before the first arm, not after: the deadline is set
    // relative to the arm, so a later reading would fall after the instant the
    // delay is measured from and `slept` could read false on a correct kernel.
    let before = now_of(&clock)

    let _ = system.debug_print("SOS c3timer: arming\n")

    var n: UInt = 0
    while n < TICKS {
        // No `interval_ns`, so each arm is a one-shot that disarms itself when
        // it fires. Arming again is all it takes to reuse the Timer (no
        // detach, re-attach or ack), so every pass after the first is a fresh
        // edge.
        try timer.arm(after_ns: DELAY_NS) catch {
            print("SOS c3timer: arm failed: {}\n", error)
            let _ = system.shutdown(EXIT_FAILED)
            return
        }
        let r = try waiter.wait() catch {
            print("SOS c3timer: wait failed: {}\n", error)
            let _ = system.shutdown(EXIT_FAILED)
            return
        }
        n = n + 1
        print("SOS c3timer: tick {} key={} fires={}\n", n, r.key, fires_of(&r))
    }

    let after = now_of(&clock)
    print("SOS c3timer: done ticks={} slept={}\n",
          n, flag(after - before >= DELAY_NS * (TICKS as UInt64)))
    let _ = proc.exit(EXIT_OK)
}
