//! A child of the stock-root image `tests/images/stock_root_wide.toml`, which
//! serves thirty connections (`process.toml`): root holds more handles than
//! its body's table while it makes them, so the image's root has the table
//! the builder derived. The child only reports that it started and exits.

import sos.{System}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)
    let proc = try system.process_self() catch {
        print("SOS rootwide: no process handle: {}\n", error)
        return
    }
    print("SOS rootwide: up\n")
    let _ = proc.exit(0)
}
