// A dying process disowns the shared objects charged to it (spec §2.10's
// refund rule).
//
// Expected transcript, read as an order:
//
//   SOS chargedisown: started
//   SOS: process exit: code=... process=1        <- the charger
//   SOS: process teardown ... process=1
//   SOS chargedisown: the charger is gone
//   SOS chargedisown: freed and donated what it left
//   SOS probe: pipes=2 regions=4 windows=2 quota=1
//   SOS: process exit: code=8 process=1          <- the probe, in slot 1
//   SOS: process teardown ... process=1
//   SOS chargedisown: probe status=65544
//   SOS chargedisown: done
//
// One child image plays both parts (`child-disown`), so the case can carry a
// pool beside it.
//
// The charger makes a connection, splits two regions off a sibling of root's
// pool and carves a window off a view of root's device window, all charged to
// it. It posts the connection's client end, both regions and the window to
// root in one message and exits; its teardown disowns all four, which the
// staged message still names. Root lets go of everything that names the dead
// charger, its Process handle and the attachment root watched the death
// through, and slot 1 is reclaimed there, although the four objects charged to
// it are live: an object charged to a process does not hold its slot. Root
// then takes them.
//
// The probe is created next and lands in slot 1, which its teardown line's
// `process=` field reports. It spends one connection, one region and one
// window, and parks. Root then gives back the charger's objects, each through
// a different free path: it releases the connection (`free_pipe`), releases
// one region (`memory_release_if_idle`), donates the other to the Memory slab
// (`memory_retire_donated`) and releases the window (the IoMemory free). Each
// was disowned, so each credits nobody.
//
// The probe then spends every kind until refused, and gets exactly its
// allowance of each. A free that credited a disowned object's charged process
// as it stood at the charge would credit the probe, and that kind would count
// one more (`pipes=3 regions=5 windows=3`); a free that indexed the ledger with
// the no-owner value would stop the machine. `status=65544` is `Exited` (1) in
// the high half and the probe's total in the low.
//
// One phase per function: root's stack grant is small and a `PipeMsg` is a
// message-sized value, so the phases are split rather than held in one frame.

import sos.{System, Process, Memory, IoMemory, PipeInlet, PipeHandle,
            ClockType, SlabKind, SystemRight, SosStatus, PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// Root's config: the tags the child's boot records travel under.
static TAG_BOOT: UInt = 7
static TAG_CARRIER: UInt = 21
static TAG_GO: UInt = 23
static TAG_RAM: UInt = 24
static TAG_WINDOW: UInt = 25

/// The keys root's attachments live under.
static KEY_CHARGER: UInt = 52
static KEY_PROBE: UInt = 53
static KEY_PARK: UInt = 54

/// Twenty milliseconds: far longer than the probe needs to spend its first
/// connection, region and window and park. See `process-lifecycle`.
static PARK_NS: UInt64 = 20_000_000

/// The length of each view of the device window root hands out.
static WINDOW_LEN: UInt = 0x1000

/// What a child of this launcher may ask its System object for.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// The byte the charger marks its message with.
static BYTE_MARK: UInt8 = 78

/// The charger's "its objects went" exit code, and the kind half of a §8
/// status word for a process that exited.
static CHARGER_SENT: UInt = 44
static EXITED: UInt = 1 << 16

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS chargedisown: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    try run(&system, &proc) catch {
        print("SOS chargedisown: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS chargedisown: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var img_rec = try proc.boot_handle_next()
    var ram_rec = try proc.boot_handle_next()
    var pool_rec = try proc.boot_handle_next()
    var window_rec = try proc.boot_handle_next()
    guard let image = img_rec.take_memory() else { return BUG }
    guard let ram = ram_rec.take_memory() else { return BUG }
    guard let pool = pool_rec.take_memory() else { return BUG }
    guard let window = window_rec.take_iomemory() else { return BUG }

    let left = try outlive(&system, &proc, &image, &ram, &pool, &window)
    let (gift_pipe, gift_piece, gift_donated, gift_window) = move left

    // The probe lands in the charger's slot. Root creates nothing after it,
    // so the image and the RAM go, to keep root's table within its rows.
    let probe = try system.process_create(image: &image, memory: &ram)
    let _ = move image
    let _ = move ram
    let go = try proc.pipe_create()
    let (go_in, go_out) = move go
    try furnish(&system, &probe, &pool, &window)
    try probe.give(outlet: move go_out, tag: TAG_GO) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try probe.start(boot_tag: TAG_BOOT)
    try park(&system, &proc)

    // The charger's objects go back, each through its own free path. All four
    // were disowned, so nobody is credited.
    let _ = move gift_pipe
    let _ = move gift_piece
    try donate(&system, move gift_donated)
    let _ = move gift_window
    let _ = system.debug_print(
        "SOS chargedisown: freed and donated what it left\n")

    let status = try release_probe(&proc, &probe, &go_in)
    print("SOS chargedisown: probe status={}\n", status)
    return
}

/// Give a child what both parts need: a masked System, a sibling of the pool
/// and a view of the device window. The view is charged to root.
func furnish(system: &System, child: &Process, pool: &Memory,
             window: &IoMemory) -> Result<Void, SosStatus> {
    let for_child = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let sibling = try pool.mint()
    try child.give(memory: move sibling, tag: TAG_RAM) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let view = try window.carve(offset: 0, len: WINDOW_LEN)
    try child.give(iomemory: move view, tag: TAG_WINDOW) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    return
}

/// Launch the charger, outlive it, and take what it sent: a connection's
/// client end, two regions and a window, all charged to it and disowned by its
/// death. Nothing of root's names the charger when this returns.
func outlive(system: &System, proc: &Process, image: &Memory, ram: &Memory,
             pool: &Memory, window: &IoMemory) -> Result<(PipeHandle,
                                                          PipeHandle,
                                                          PipeHandle,
                                                          PipeHandle),
                                                         SosStatus> {
    let child = try system.process_create(image: &image, memory: &ram)
    let carrier = try proc.pipe_create()
    let (carrier_in, carrier_out) = move carrier

    let waiter = try proc.waiter_create()
    try waiter.add(process: &child, key: KEY_CHARGER)

    try furnish(&system, &child, &pool, &window)
    try child.give(inlet: move carrier_in, tag: TAG_CARRIER) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try child.start(boot_tag: TAG_BOOT)
    let _ = system.debug_print("SOS chargedisown: started\n")

    let woke = try waiter.wait()
    if woke.key != KEY_CHARGER {
        return BUG
    }
    match woke.what {
        case Process(status) -> {
            if status != EXITED + CHARGER_SENT {
                print("SOS chargedisown: the charger exited {}\n", status)
                return BUG
            }
        },
        case _ -> { return BUG },
    }
    let _ = system.debug_print("SOS chargedisown: the charger is gone\n")

    // The attachment and the Process handle are the only references on the
    // charger's slot, so it is reclaimed here, before root takes the objects
    // charged to the charger.
    try waiter.remove(KEY_CHARGER)
    let _ = move waiter
    let _ = move child

    let got = try carrier_out.take()
    let (arrived, request) = move got
    var msg = move arrived
    let _ = move request
    if msg.bytes[0] != BYTE_MARK {
        return BUG
    }
    guard let a = msg.handles[0].take() else { return BUG }
    guard let b = msg.handles[1].take() else { return BUG }
    guard let c = msg.handles[2].take() else { return BUG }
    guard let d = msg.handles[3].take() else { return BUG }
    return (move a, move b, move c, move d)
}

/// Donate a region that arrived in a message to the Memory slab.
func donate(system: &System, h: PipeHandle) -> Result<Void, SosStatus> {
    match h {
        case Memory(m) -> {
            var region = move m
            try system.slab_donate(kind: SlabKind.Memories,
                                   memory: move region) catch {
                let (why, back) = move error
                let _ = move back
                return why
            }
            return
        },
        case _ -> { return BUG },
    }
}

/// Give the processor up long enough for the probe to spend its first
/// connection, region and window, and park.
func park(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    let clock = try system.clock_get(type: ClockType.Monotonic)
    let waiter = try proc.waiter_create()
    let timer = try clock.timer_create()
    try waiter.add(&timer, KEY_PARK)
    try timer.arm(after_ns: PARK_NS)
    let _ = try waiter.wait()
    return
}

/// Tell the probe to go on, and read its ending.
func release_probe(proc: &Process, probe: &Process,
                   go: &PipeInlet) -> Result<UInt, SosStatus> {
    let waiter = try proc.waiter_create()
    try waiter.add(process: &probe, key: KEY_PROBE)
    var body: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    let claim = try go.post(body: &body, len: 1)
    let _ = move claim
    let woke = try waiter.wait()
    if woke.key != KEY_PROBE {
        return BUG
    }
    match woke.what {
        case Process(status) -> { return status },
        case _ -> { return BUG },
    }
}
