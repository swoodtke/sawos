// Nothing un-dies: a death is a terminal level, and a process record stays open
// as long as something can still read its §8 status word.
//
// A death never clears, so it can be observed by somebody who was not watching
// when it happened, as often as they like, for as long as they hold a
// reference to it. Take the last reference away and the record goes. Expected
// transcript:
//
//   SOS deathlate: started
//   SOS bye: exiting
//   SOS: process exit: code=... process=1
//   SOS: process teardown ... process=1
//   SOS deathlate: first=65541 second=65541      <- attached after the death,
//                                                   and answered twice
//   SOS deathlate: held=1                        <- the attachment alone
//   SOS bye: exiting
//   SOS: process exit: code=... process=1        <- the record came back
//   SOS: process teardown ... process=1
//   SOS deathlate: done
//
// `first=` is the late attach. Root sleeps on a timer until the child is
// already gone, and only then attaches its Process handle. An edge-triggered
// design would have nothing left to report, and this line would print a wait
// that never returned. It returns immediately, because readiness is
// `state == Gone` and that is still true.
//
// `second=` is the terminal part. The delivery of an Event's word clears it and
// a Timer's fire count is spent by the wait that reports it; a death spends
// nothing. The second wait on the same attachment answers the same word, and
// would answer it a thousand times.
//
// The rest is the record's reference count observed through the supervision
// flow. A dead process's record lives exactly as long as something can still
// read its status word, and an attachment is one of those things. Root drops
// the two references one at a time:
//
//   - release the Process handle, leaving only the attachment: a third wait
//     still answers the same word, because the record is still `Gone`. That
//     is `held=1`; the attachment alone kept it. A kernel that did not count
//     the attachment would reach zero references at the release with the
//     attachment still in place, which it reports as a kernel bug and stops.
//   - remove the attachment: the count reaches zero and the record frees inside
//     that very syscall. A second child, created next, takes the lowest free
//     record, so the kernel's own exit line names process 1 again; had the
//     record been held it would name process 2.

import sos.{System, Process, Memory, BootHandle, Clock, ClockType, Timer,
            Waiter, WaitResult, WaitPayload, AttachMode, SosStatus, SystemRight}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

static YES: UInt = 1
static NO: UInt = 0

/// The key the park timer is attached under, the key the dead child is, and the
/// key the second child's death is watched under. Distinct numbers, because
/// the attachments live on one Waiter, which is what §2.2's key uniqueness is
/// for.
static KEY_TIMER: UInt = 46
static KEY_DEATH: UInt = 47
static KEY_AGAIN: UInt = 48

/// Twenty milliseconds: three orders of magnitude more than the child needs to
/// print one line and exit. See `process-lifecycle`.
static PARK_NS: UInt64 = 20_000_000

/// Root's config: the tag the child's System handle travels under.
static TAG_BOOT: UInt = 21

/// What this launcher's child may ask its System object for. See
/// `death-notify`.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

func flag(b: Bool) -> UInt {
    if b { YES } else { NO }
}

/// The §8 status word out of the record. The Timer arm panics like the other
/// two even though this program does attach a timer: by the time this is
/// called the timer has already fired and been consumed, so a Timer record
/// here would mean the wait answered from the wrong attachment.
func status_of(r: &WaitResult) -> UInt {
    match r.what {
        case Process(status) -> status,
        case _ -> panic("this program attached only a Process"),
    }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS deathlate: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    var image = try proc.boot_handle_next() catch {
        print("SOS deathlate: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS deathlate: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    // Both regions are used by both `process_create`s below, so they are taken
    // into locals rather than borrowed out of the records in place. The second
    // child is loaded into the same RAM as the first, which is dead by then.
    guard let image_mem = image.take_memory() else {
        let _ = system.debug_print("SOS deathlate: image record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let dest_mem = dest.take_memory() else {
        let _ = system.debug_print("SOS deathlate: dest record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS deathlate: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let for_child = try system.mint(rights: CHILD_SYSTEM) catch {
        print("SOS deathlate: mint failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        print("SOS deathlate: give failed: {}\n", error.0)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try child.start(boot_tag: TAG_BOOT) catch {
        print("SOS deathlate: start failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS deathlate: started\n")

    // The park is a timer, deliberately. This case must attach late, so root
    // has to give the processor up by some means that is not the death itself.
    let clock = try system.clock_get(type: ClockType.Monotonic) catch {
        print("SOS deathlate: no clock: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let waiter = try proc.waiter_create() catch {
        print("SOS deathlate: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let timer = try clock.timer_create() catch {
        print("SOS deathlate: no timer: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = waiter.add(&timer, KEY_TIMER)
    let _ = timer.arm(after_ns: PARK_NS)
    try waiter.wait() catch {
        print("SOS deathlate: park failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The late attach. The child has been dead for a while.
    try waiter.add(process: &child, key: KEY_DEATH) catch {
        print("SOS deathlate: attach failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let first = match waiter.wait() {
        case Ok(r) -> status_of(&r),
        case Err(e) -> {
            print("SOS deathlate: first wait failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    let second = match waiter.wait() {
        case Ok(r) -> status_of(&r),
        case Err(e) -> {
            print("SOS deathlate: second wait failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    print("SOS deathlate: first={} second={}\n", first, second)

    // The first reference goes, written as a drop: `let _ = move child`
    // consumes the wrapper and its `deinit` issues the release. The attachment
    // is what is left, and a third wait reads the record through it.
    let _ = move child
    let third = match waiter.wait() {
        case Ok(r) -> status_of(&r),
        case Err(e) -> {
            print("SOS deathlate: third wait failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    print("SOS deathlate: held={}\n", flag(third == first))

    // And the second. A `remove` names the attachment by key and never touches
    // the waitable, but the reference it drops is the waitable's, and here that
    // reference is the last one.
    try waiter.remove(KEY_DEATH) catch {
        print("SOS deathlate: remove failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    try run_again(&system, &waiter, &image_mem, &dest_mem) catch {
        print("SOS deathlate: second child failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    print("SOS deathlate: done\n")
    let _ = proc.exit(EXIT_OK)
}

/// The second child takes the lowest free record. Its exit line is the
/// kernel's answer to whether the first child's record was freed. A phase of
/// its own because root's stack grant is small and every `print` with format
/// arguments reserves scratch in its caller's frame.
func run_again(system: &System, waiter: &Waiter, image: &Memory,
               dest: &Memory) -> Result<Void, SosStatus> {
    let again = try system.process_create(image: &image, memory: &dest)
    let for_again = try system.mint(rights: CHILD_SYSTEM)
    try again.give(system: move for_again, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try waiter.add(process: &again, key: KEY_AGAIN, mode: AttachMode.OneShot)
    try again.start(boot_tag: TAG_BOOT)
    let _ = try waiter.wait()
    return
}
