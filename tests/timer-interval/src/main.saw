// A periodic timer is ack-free, and missed fires coalesce (spec §2's Timer
// row).
//
// Claims, in the order the transcript makes them:
//
//   SOS interval: tick one fires=N
//   SOS interval: tick two fires=N ackfree=1
//   SOS interval: coalesced=1
//   SOS interval: late=1
//   SOS interval: drained fires=1
//   SOS interval: done
//
// No asserted line depends on how long anything took. The emulator's clock
// follows the host, so a loaded host stretches every duration and can delay an
// interrupt's delivery while the guest's clock runs on. The periodic counts
// are `N` and printed for a reader only: a fire delivered more than a period
// late coalesces, so any count of one or more is correct. Every claim below is
// made on something the program waits for, never on how much time passed.
//
// 1. The kernel re-arms, not the process. The first two waits are the whole of
//    what this program does between them: no ack, no re-arm, no re-attach. A
//    timer that did not re-arm itself would leave the second wait parked
//    forever with nothing to wake it, which this kernel reports as a deadlock
//    rather than hanging, so the failure is a red run in milliseconds.
//    `ackfree=1` records that claim where a reader will see it.
//
// 2. Fires accumulate when nobody is waiting. The third phase spins in
//    userspace, not waiting, until the kernel has taken two interrupts while
//    this process ran (`ProcessStats.interrupts`). Each interrupt that finds
//    the Timer due counts at least one fire, so two of them leave at least two
//    fires pending however far apart the host delivered them. They did not
//    queue as separate wakes and were not dropped: the wait answers once with
//    `fires` above one. `coalesced=1` is that comparison. This is the property
//    that makes a slow consumer degrade into coarser reporting instead of
//    falling permanently behind.
//
// 3. One late fire counts every period it missed. The Timer is re-armed with
//    an interval of one nanosecond, which no interrupt can be on time for: it
//    is taken some time after the deadline, so the lateness is at least one
//    interval and the single fire the wait reports counts more than one
//    period. A host stall only makes the interrupt later, which only raises
//    the count. A kernel that counted one fire per interrupt, or discarded
//    the periods it missed, reads one here.
//
// 4. The wait consumes the count, and the last phase proves it without a
//    stopwatch: cancel, re-arm as a one-shot, wait. That count can only be one.
//    A kernel that never reset the count would report the coalesced total again
//    there, and a `disarm` that left the fires behind would report them too, so
//    one line covers both.

import sos.{System, Process, Clock, ClockType, Timer, Waiter, WaitResult,
            WaitPayload, SosStatus}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

static YES: UInt = 1
static NO: UInt = 0

static KEY: UInt = 66

/// A millisecond period, far above the kernel's minimum lead, so every fire
/// here is a real scheduled one.
static PERIOD_NS: UInt64 = 1_000_000

/// How many interrupts the third phase sees taken before it reads the count.
/// Two is the least that makes "above one" true by construction.
static SERVICED: UInt = 2

/// An interval no interrupt can be on time for: every fire is late by at
/// least this many nanoseconds, so it counts at least two periods.
static LATE_INTERVAL_NS: UInt64 = 1

func flag(b: Bool) -> UInt {
    if b { YES } else { NO }
}

func fires_of(r: &WaitResult) -> UInt {
    match r.what {
        case Timer(fires) -> fires,
        case _ -> panic("this program attached only a Timer"),
    }
}

/// How many interrupts the kernel has taken while this process was running.
func interrupts_of(proc: &Process) -> Result<UInt, SosStatus> {
    let seen = try proc.stats()
    return seen.interrupts as UInt
}

/// Spin, making a call each pass, until `count` more interrupts have been
/// taken. Timer fires land during this (the line is enabled and the kernel
/// takes each interrupt) and accumulate in the object rather than waking
/// anybody, which is the state the second claim is about. What ends the spin is
/// the kernel's own count and not the clock, so a host that delays the
/// interrupts only lengthens it.
func spin_until_serviced(proc: &Process,
                         count: UInt) -> Result<Void, SosStatus> {
    let start = try interrupts_of(&proc)
    var done = false
    while not done {
        let seen = try interrupts_of(&proc)
        if seen - start >= count {
            done = true
        }
    }
    return
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS interval: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let clock = try system.clock_get() catch {
        print("SOS interval: no clock: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let waiter = try proc.waiter_create() catch {
        print("SOS interval: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let timer = try clock.timer_create() catch {
        print("SOS interval: no timer: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try waiter.add(&timer, KEY) catch {
        print("SOS interval: attach failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // A repeating schedule: first fire one period out, then every period.
    try timer.arm(after_ns: PERIOD_NS, interval_ns: PERIOD_NS) catch {
        print("SOS interval: arm failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let one = try waiter.wait() catch {
        print("SOS interval: first wait failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS interval: tick one fires={}\n", fires_of(&one))

    // Nothing happens between these two waits: no ack, no re-arm.
    let two = try waiter.wait() catch {
        print("SOS interval: second wait failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let count_two = fires_of(&two)
    print("SOS interval: tick two fires={} ackfree={}\n",
          count_two, flag(count_two >= 1))

    // Now go away without waiting, until two interrupts have been taken.
    try spin_until_serviced(&proc, SERVICED) catch {
        print("SOS interval: spin failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let many = try waiter.wait() catch {
        print("SOS interval: third wait failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS interval: coalesced={}\n", flag(fires_of(&many) > 1))

    // A fire is always late by more than a one-nanosecond interval.
    let _ = timer.disarm()
    try timer.arm(after_ns: PERIOD_NS, interval_ns: LATE_INTERVAL_NS) catch {
        print("SOS interval: late arm failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let late = try waiter.wait() catch {
        print("SOS interval: late wait failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS interval: late={}\n", flag(fires_of(&late) > 1))

    // The drain, proved without a stopwatch: cancel, re-arm as a one-shot,
    // wait. That count can only be one. A kernel that never reset the count
    // would report the coalesced total again here, and a `disarm` that left
    // the fires behind would report them too, so the single line covers both.
    let _ = timer.disarm()
    try timer.arm(after_ns: PERIOD_NS) catch {
        print("SOS interval: rearm failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let fresh = try waiter.wait() catch {
        print("SOS interval: fourth wait failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS interval: drained fires={}\n", fires_of(&fresh))

    print("SOS interval: done\n")
    let _ = proc.exit(EXIT_OK)
}
