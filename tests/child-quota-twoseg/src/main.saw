// Test child: `child-bye`'s program, linked with its read-only data folded
// into its code (`twoseg.*.ld`), so its image has two segments where every
// other test image has three, and its domain one more free grant row. The case
// that uses it never starts it.

import sos.{System}

static EXIT_CODE: UInt = 5

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        print("SOS twoseg: no process handle: {}\n", error)
        return
    }

    let _ = system.debug_print("SOS twoseg: exiting\n")
    let _ = proc.exit(EXIT_CODE)
}
