//! A child of the gate's stock-root images on the riscv32 `virt` board whose
//! declaration names two of the launch convention's four System rights: it
//! prints every right of its System handle and exits (`tests/stockkit`).

import stockkit

@export("_start")
func _start(boot_handle: UInt) {
    stockkit.hold(boot_handle, "narrow")
}
