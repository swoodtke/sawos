// SOS design 20, the `isolation` SMOKE CASE — ESP32-C3, NON-GATING.
//
// A user-mode touch of a KERNEL-OWNED address faults and is REPORTED, which is
// the brief's third case and the one that proves the PMP program over the real
// C3 map. Root launches `c3-child-poke`, which stores a word at 0x4037_C000 —
// the first word of SRAM, the kernel's own `.data`, granted to nobody. The
// transcript reads:
//
//   SOS c3iso: started
//   SOS: fault <store fault> cause=... epc=... tval=...
//   SOS: process teardown ... process=1
//   SOS c3iso: root survived child status=131072
//   SOS c3iso: child syscalls=0 faults=1
//   SOS c3iso: done
//
// WHAT THE FAULT LINE PROVES. U-mode on RISC-V matches no PMP entry at that
// address, so the store is refused by the hardware — which is the property the
// whole protection model rests on and the one a fresh board port can get wrong
// by programming its sixteen entries at the wrong addresses. A kernel whose
// rows were misplaced would let the store LAND, the child would spin, and this
// line would simply not be here. So the assertion is the PRESENCE of a hardware
// fault, and a broken program fails by omission rather than by a wrong value.
//
// `child status=131072` is `Faulted` with code 0: kind 2 in the high half
// (2 * 65536) and zero in the low, because a HARDWARE fault carries no
// `FaultReason` — the cause is in the console line, not in the status word.
//
// `syscalls=0 faults=1` is the child's whole biography in two numbers: it holds
// no handles, so it never reached the kernel through the syscall door at all,
// and the ONE trap it took was the store the hardware refused.
//
// ROOT PARKS ON A GENEROUS TIMER because this image's kernel arms no scheduler
// tick, so the wait below is the only way root gives the processor up and the
// timer is the only way it gets it back. That makes this case depend on the
// `timer` case's machinery too — deliberately: if the SYSTIMER path were broken
// this would hang rather than report, and the two cases would fail together
// rather than one masking the other.

import sos.{System, Process, Memory, BootHandle, Clock, ClockType, Timer,
            Waiter, SosStatus}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

static KEY: UInt = 88

/// Twenty milliseconds — three orders of magnitude more than the child needs to
/// be scheduled and take one fault.
static PARK_NS: UInt64 = 20_000_000

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS c3iso: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // Row 0 is the child's image blob, row 1 the RAM it runs in — this build's
    // config, which is root's business and never the kernel's.
    var image = try proc.boot_handle_next() catch {
        print("SOS c3iso: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS c3iso: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS c3iso: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try child.start() catch {
        print("SOS c3iso: start failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS c3iso: started\n")

    let clock = try system.clock_get(type: ClockType.Monotonic) catch {
        print("SOS c3iso: no clock: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let waiter = try proc.waiter_create() catch {
        print("SOS c3iso: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let timer = try clock.timer_create() catch {
        print("SOS c3iso: no timer: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try waiter.add(&timer, KEY) catch {
        print("SOS c3iso: attach failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try timer.arm(after_ns: PARK_NS) catch {
        print("SOS c3iso: arm failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try waiter.wait() catch {
        print("SOS c3iso: wait failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let status = try child.get_status() catch {
        print("SOS c3iso: status failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS c3iso: root survived child status={}\n", status)

    let cost = try child.stats() catch {
        print("SOS c3iso: stats failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS c3iso: child syscalls={} faults={}\n",
          cost.syscalls, cost.faults)

    print("SOS c3iso: done\n")
    let _ = proc.exit(EXIT_OK)
}
