//! `console-flood` past the ring: seventeen lines, so its last waits in a
//! call while the ring is full, then a stretch of computing at `Low`, below
//! root, a line after it, and a return.

public static LINES: Int = 17
public static AUX: Bool = false
public static END: Int = 0
public static YIELDS: Int = 0
public static HOG_NS: UInt64 = 1_500_000_000
public static HOG_LOW: Bool = true
public static AFTER: Bool = true
