//! `console-flood` as a quick client that panics: a byte told to `aux`, no
//! line, and a panic.

public static LINES: Int = 0
public static AUX: Bool = true
public static END: Int = 2
public static YIELDS: Int = 0
public static HOG_NS: UInt64 = 0
public static HOG_LOW: Bool = false
public static AFTER: Bool = false
