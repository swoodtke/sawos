// Negative case: the kernel never shares slab backing with user-reachable
// memory.
//
// Transcript:
//
//   SOS slabshared: minted a sibling
//   SOS: process fault: object in the wrong state process=0x...
//   SOS: process teardown handles=...
//
// The safety condition is `refs == 1 && maps == 0`; this case exercises the
// first half. A donated region becomes kernel object storage (the kernel writes
// Waiter slots into those bytes), so anything else that can still reach them is
// a hole through the object model. `refs` counts the handle entries naming a
// region, so the donated handle being the only one answers "can anybody else
// still name this?".
//
// A sibling is the cheapest way to make the condition false: `mint` is the
// ordinary way a second name onto one region comes to exist, and nothing about
// the sibling is malformed. It is a good capability that must not coexist with
// a donation.
//
// The process dies rather than getting a status back because root minted that
// sibling: a caller that cannot see a condition it created itself is not a
// caller the kernel can help, and every other caller-checkable refusal on this
// path (a handle that names nothing, a handle that is not a Memory, an unknown
// `SlabKind`) ends the process for the same reason. The two refusals root
// cannot compute (a region too small for one slot of a kind whose size is
// kernel-internal, an extent chain that is full) are statuses, and
// `tests/slab-donate` is where the op returns.
//
// The `maps == 0` half is not exercised here: proving it needs a live mapping,
// which needs a second process to map into or a self-map, and it is the same
// `BadState` out of the same three-condition block just below the one this case
// reaches. `tests/slab-donate-mapped` covers it.

import sos.{System, Process, Memory, Pool, SlabKind, SosStatus}

/// One protection unit's worth on either profile.
static PAGE: UInt = 0x1000

static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS slabshared: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var pool_record = try proc.boot_handle_next() catch {
        let _ = system.debug_print("SOS slabshared: no pool region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let pool = pool_record.take_pool() else {
        let _ = system.debug_print(
            "SOS slabshared: pool record is not a pool\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let scratch = try pool.allocate(len: PAGE) catch {
        print("SOS slabshared: no page to donate: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The second name. `sibling` stays live for the rest of the program: a
    // sibling that had been released would leave `refs` at 1 and the donation
    // would be safe.
    let sibling = try scratch.mint() catch {
        print("SOS slabshared: no sibling: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS slabshared: minted a sibling\n")

    // This call does not return. Both arms below are unreachable, on
    // `tests/map-wx-refused`'s pattern: a case whose negative arrives as a
    // fault must fail loudly if it ever arrives as a value instead.
    match system.slab_donate(kind: SlabKind.Waiters, memory: move scratch) {
        case Ok(_) -> {
            let _ = system.debug_print(
                "SOS slabshared: UNREACHABLE — a shared region was absorbed\n")
            let _ = system.shutdown(EXIT_FAILED)
        },
        case Err(_) -> {
            let _ = system.debug_print(
                "SOS slabshared: UNREACHABLE — refused with a status\n")
            let _ = system.shutdown(EXIT_FAILED)
        },
    }
}
