// SOS M3 unit 3: A MASK THAT OMITS `Transfer` MAKES AN UNGIVABLE HANDLE (sawos
// design 4 as ruled Aug 29).
//
// **ONE TRANSCRIPT, TWO CLAIMS, and they are the same claim from two ends.**
// `give` is gated on the UNIVERSAL `Transfer` bit of the handle being given —
// the first consumer §3's universal low byte ever had, declared in M2 and read
// by nothing until this unit — and `mint` produces a handle whose rights are the
// source's INTERSECTED with a keep mask. So a sibling minted through a mask that
// does not name `Transfer` cannot be given, and this file proves the gate and
// the attenuation in one line of transcript:
//
//   SOS notransfer: minted without Transfer
//   SOS: process fault: access denied process=0
//   SOS: process teardown ... process=0
//
// **WHY IT IS A MINTED SIBLING RATHER THAN ROOT'S OWN HANDLE.** An earlier cut
// of this case gave root's System handle directly, on the M2 fact that
// `root_system_rights()` withheld `Transfer` ("nobody to transfer to in a
// one-process world"). The Aug-29 rulings ended that: root's handle CARRIES
// `Transfer` now, because giving a masked System sibling to a child is the whole
// launch flow. So the ungivable handle in this system is one a launcher MADE
// ungivable, which is the more interesting fact and the one worth a case.
//
// **AND IT CANNOT BE UNDONE.** There is no sequence of ops that recovers a
// masked bit: a mint's result is a subset of its source, so minting again from
// the narrowed sibling only narrows further. Attenuation is monotonic (§3), and
// with `MINT_OP` it is finally something a launcher can perform rather than
// something the kernel does at creation.
//
// The keep mask is spelled as a COMPLEMENT here — everything except `Transfer` —
// which is the notation the polarity ruling deliberately leaves available: this
// case means "the same handle, minus one bit", and writing it that way puts the
// fail-OPEN choice at the call site where a reader can see it. `give-boot-drain`
// means a whitelist and writes one.
//
// The funnel CONSUMES the wrapper before the syscall (design 3 D-5's
// disarm-before-syscall), so the last line this program can print is the one
// above the give. That ordering is the contract, not an accident of this file.

import sos.{System, Process, Memory, BootHandle, SosStatus, SystemRight}

static EXIT_FAILED: UInt = 1

static TAG: UInt = 1

/// Everything this handle has, EXCEPT the movability bit. The `& 0xFFFF_FFFF`
/// is not decoration: Saw folds a constant in the signed platform-`Int` domain,
/// so a bare `~x` is negative and would not fit the mask's `UInt32`.
static NO_TRANSFER: UInt32 = ~(SystemRight.Transfer as UInt32) & 0xFFFF_FFFF

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS notransfer: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    var image = try proc.boot_handle_next() catch {
        print("SOS notransfer: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS notransfer: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS notransfer: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let stuck = try system.mint(rights: NO_TRANSFER) catch {
        print("SOS notransfer: mint failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS notransfer: minted without Transfer\n")

    // REFUSED. The handle resolves and the receiver is `Created`; what it lacks
    // is the one universal bit this op checks — because a mask left it out.
    let _ = child.give(system: move stuck, tag: TAG)

    let _ = system.debug_print("SOS notransfer: survived, which is the bug\n")
    let _ = system.shutdown(EXIT_FAILED)
}
