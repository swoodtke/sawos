// A mask that omits `Transfer` makes an ungivable handle: the give faults the
// process with "access denied".
//
// `give` is gated on the universal `Transfer` bit of the handle being given,
// and `mint` produces a handle whose rights are the source's intersected with a
// keep mask. So a sibling minted through a mask that does not name `Transfer`
// cannot be given, and this file proves the gate and the attenuation in one
// transcript:
//
//   SOS notransfer: minted without Transfer
//   SOS: process fault: access denied process=0
//   SOS: process teardown ... process=0
//
// The ungivable handle is a minted sibling rather than root's own, because
// root's System handle carries `Transfer` (giving a masked sibling to a child
// is the whole launch flow). The ungivable handle in this system is one a
// launcher made ungivable.
//
// It cannot be undone. No sequence of ops recovers a masked bit: a mint's
// result is a subset of its source, so minting again from the narrowed sibling
// only narrows further. Attenuation is monotonic (§3).
//
// The keep mask is spelled as a complement here (everything except `Transfer`),
// a notation the keep-mask polarity leaves available: this case means "the same
// handle, minus one bit", and writing it that way puts the fail-open choice at
// the call site where a reader can see it. `give-boot-drain` means a whitelist
// and writes one.
//
// The funnel consumes the wrapper before the syscall, so the last line this
// program can print is the one above the give. That ordering is the contract,
// not an accident of this file.

import sos.{System, Process, Memory, BootHandle, SosStatus, SystemRight}

static EXIT_FAILED: UInt = 1

static TAG: UInt = 1

/// Everything this handle has, except the movability bit. The `& 0xFFFF_FFFF`
/// is not decoration: Saw folds a constant in the signed platform-`Int` domain,
/// so a bare `~x` is negative and would not fit the mask's `UInt32`.
static NO_TRANSFER: UInt32 = ~(SystemRight.Transfer as UInt32) & 0xFFFF_FFFF

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS notransfer: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    var image = try proc.boot_handle_next() catch {
        print("SOS notransfer: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS notransfer: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS notransfer: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let stuck = try system.mint(rights: NO_TRANSFER) catch {
        print("SOS notransfer: mint failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS notransfer: minted without Transfer\n")

    // Refused. The handle resolves and the receiver is `Created`; what it lacks
    // is the one universal bit this op checks, because a mask left it out.
    let _ = child.give(system: move stuck, tag: TAG)

    let _ = system.debug_print("SOS notransfer: survived, which is the bug\n")
    let _ = system.shutdown(EXIT_FAILED)
}
