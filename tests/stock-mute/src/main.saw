//! A child of the gate's stock-root images on the riscv32 `virt` board whose
//! declaration names every right of the launch convention's but `debug`: its
//! prints are dropped, and it exits having printed nothing (`tests/stockkit`).

import stockkit

@export("_start")
func _start(boot_handle: UInt) {
    stockkit.hold(boot_handle, "mute")
}
