// Test child: a system call whose result goes into memory its launcher mapped
// into it (spec §2.2). The launcher says where, and the role says which call:
//
//   1  `Process.PipeCreate`, its record written at that address at once
//   2  `Waiter.Wait` on the launcher's Waiter, its record written there when
//      the launcher's Event is signalled
//
// A call the kernel answers leaves this process alive, and it exits with a
// code of its own that the launcher can tell apart from every fault.
//
// It works at the C altitude because the buffer is an address the launcher
// picked, which the typed tier never lets a caller name.

import sos.{ALL_RIGHTS, sos_system_process_self, sos_process_boot_handle_next,
            sos_process_exit, sos_event_receive, sos_process_pipe_create,
            sos_waiter_wait}

static TAG_ROLE: UInt = 32
static TAG_ADDR: UInt = 33
static TAG_WAITER: UInt = 34

static ROLE_CREATE_AT: UInt = 1
static ROLE_WAIT_AT: UInt = 2

/// How this process ends when the kernel answered its call.
static EXIT_TAKEN: UInt = 7
/// A step before the call under test was refused, or the call itself.
static EXIT_SETUP: UInt = 97
/// The boot set held no role.
static EXIT_NO_ROLE: UInt = 98

static STATUS_OK: UInt = 0
static NONE: UInt = 0

static BOOT_WORDS: Int = 3
/// The capacity handed to both calls: more than any record the kernel writes.
static RECORD_WORDS: Int = 64

unsafe static var ROLE: UInt = 0
unsafe static var ADDR: UInt = 0
unsafe static var WAITER: UInt = 0

func word_bytes() -> UInt {
    sizeof<UInt>() as UInt
}

func ask_process(boot_handle: UInt) unsafe -> UInt {
    var out: UInt = NONE
    let status = sos_system_process_self(boot_handle, ALL_RIGHTS as UInt,
                                         (&var out) as UnsafePointer<UInt>)
    if status != STATUS_OK {
        return NONE
    }
    out
}

func event_word(handle: UInt) unsafe -> UInt {
    var word: UInt = 0
    let _ = sos_event_receive(handle, (&var word) as UnsafePointer<UInt>)
    word
}

func next_record(proc: UInt, rec: &var [UInt; BOOT_WORDS]) unsafe -> UInt {
    sos_process_boot_handle_next(proc, (&var rec) as UnsafePointer<UInt>,
                                 (BOOT_WORDS as UInt) * word_bytes())
}

func drain(proc: UInt) unsafe {
    var rec: [UInt; BOOT_WORDS] = [0; BOOT_WORDS]
    while next_record(proc, &var rec) == STATUS_OK {
        let tag = rec[0]
        let word = rec[2]
        if tag == TAG_ROLE {
            ROLE = event_word(word)
        } else if tag == TAG_ADDR {
            ADDR = event_word(word)
        } else if tag == TAG_WAITER {
            WAITER = word
        }
    }
}

func act(proc: UInt) unsafe -> UInt {
    let capacity = (RECORD_WORDS as UInt) * word_bytes()
    if ROLE == ROLE_CREATE_AT {
        let made = sos_process_pipe_create(proc, ADDR as UnsafePointer<UInt>,
                                           capacity)
        if made != STATUS_OK {
            return EXIT_SETUP
        }
        return EXIT_TAKEN
    }
    if ROLE == ROLE_WAIT_AT {
        let woke = sos_waiter_wait(WAITER, ADDR as UnsafePointer<UInt>,
                                   capacity)
        if woke != STATUS_OK {
            return EXIT_SETUP
        }
        return EXIT_TAKEN
    }
    EXIT_NO_ROLE
}

@export("_start")
func _start(boot_handle: UInt) {
    let proc = ask_process(boot_handle)
    if proc == NONE {
        return
    }
    drain(proc)
    let code = act(proc)
    let _ = sos_process_exit(proc, code)
}
