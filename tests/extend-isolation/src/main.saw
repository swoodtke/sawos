// A grown row grants exactly the bytes it grew over, on the isolated
// profiles (spec §2.5).
//
//   SOS extendiso: grown, its last byte holds its mark: yes
//   SOS extendiso: extended again, reading past the row
//   SOS: fault ...
//
// A page from the front of a fresh pool, mapped read-write with a page of
// room, is extended and its row grown by a page, and the row's new last byte
// is written and read back. Then the allocation is extended by one more page
// and the row is not grown: the first byte past the row is the allocation's
// own now, and the row still ends below it, so the read is the hardware's
// fault. Neither an extension nor a growth reaches past what the row was
// grown over.

import sos.{System, Process, Pool, AllocateFrom, MapAccess, SosStatus}

static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.Unknown

static PAGE: UInt = 0x1000
static RW: UInt32 = MapAccess.Read | MapAccess.Write
static MARK: UInt8 = 0x4B

func poke(at: UInt, mark: UInt8) unsafe {
    UnsafeMemory<UInt8, Normal>(at).write(mark)
}

func peek(at: UInt) unsafe -> UInt8 {
    UnsafeMemory<UInt8, Normal>(at).read()
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS extendiso: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&proc) catch {
        print("SOS extendiso: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS extendiso: UNREACHABLE\n")
    let _ = system.shutdown(EXIT_FAILED)
}

func run(proc: &Process) -> Result<Void, SosStatus> {
    var pool_rec = try proc.boot_handle_next()
    guard let pool = pool_rec.take_pool() else { return BUG }

    let mem = try pool.allocate(len: PAGE, from: AllocateFrom.Front)
    let view = try proc.map(memory: &mem, access: RW, room: PAGE)
    try mem.extend(len: PAGE)
    try view.grow(len: PAGE)
    let base = try view.base()
    let last = base + 2 * PAGE - 1
    poke(last, MARK)
    let holds = peek(last) == MARK
    print("SOS extendiso: grown, its last byte holds its mark: {}\n",
          if holds { "yes" } else { "no" })

    try mem.extend(len: PAGE)
    print("SOS extendiso: extended again, reading past the row\n")
    let past = peek(last + 1)
    print("SOS extendiso: read {}\n", past)
    return
}
