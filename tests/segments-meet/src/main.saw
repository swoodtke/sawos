// No two rows of one image meet (spec §5.6): an image two of whose segments'
// granted ranges meet is `BadImage` at `process_create`, and one whose
// segments only touch loads.
//
// Root writes each image itself, into an allocation out of the pool, and
// creates a process from it into another allocation. Every segment is a
// zero-filled one, copied, linked a whole number of grains above the
// destination's link base: a grain is `g` below, a segment's range is written
// `[a, b)` in grains, `[a)` is a segment of no bytes at `a`, and the entry
// lies in the first executable segment.
//
//   SOS segmeet: two at one address: BadImage                [0,2) [0,2)
//   SOS segmeet: the second over the first's last grain: BadImage
//                                                             [0,2) [1,3)
//   SOS segmeet: the second under the first's first grain: BadImage
//                                                             [1,3) [0,2)
//   SOS segmeet: a byte into a grain, the next at that grain: BadImage
//                                                       [0,1g+1) [1,3)
//   SOS segmeet: the first and the last of three: BadImage
//                                                       [0,2) [4,6) [1,3)
//   SOS segmeet: the last two of three: BadImage         [0,2) [4,6) [5,7)
//   SOS segmeet: side by side: loaded                         [0,2) [2,4)
//   SOS segmeet: side by side, the second below: loaded       [2,4) [0,2)
//   SOS segmeet: a byte into a grain, the next past it: loaded
//                                                       [0,1g+1) [2,4)
//   SOS segmeet: three side by side: loaded              [0,2) [2,4) [4,6)
//   SOS segmeet: no bytes inside another, listed after it: loaded
//                                                             [0,2) [1)
//   SOS segmeet: no bytes inside another, listed before it: loaded
//                                                             [1) [0,2)
//   SOS segmeet: no bytes at another's base: loaded           [0,2) [0)
//   SOS segmeet: no bytes at another's top: loaded            [0,2) [2)
//   SOS segmeet: a stack top at a part-filled grain's end: a thread made
//                                                       [0,2) [4,5g+1)
//   SOS segmeet: done
//
// A segment's range is its row's, rounded up to the grain: one that ends a
// byte into a grain is granted that whole grain, so a segment linked at that
// grain meets it, and one linked at the next grain does not, and a thread may
// keep its stack in that grain past the segment's bytes. A segment of no
// bytes records a row of no bytes, which holds no address and so meets no
// segment, wherever it lies. Every pair is asked, whatever order the table
// lists them in. An image that loads is a process that is created and never
// started; its handle goes at once.
//
// The images carry the architecture's tag and its grain, by the word size:
// a 64-bit word is arm64, whose grain is a page and whose images link at one
// canonical base (`hal.USER_IMAGE_BASE`), and a 32-bit word is riscv32, whose
// grain is four bytes and whose images link where their destination is.

import sos.{System, Process, Memory, Pool, MapAccess, SosStatus}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.Unknown

static RW: UInt32 = MapAccess.Read | MapAccess.Write

/// The destination: room for seven grains of segments below the kernel's
/// stack grant (`hal.ROOT_STACK_LEN`) on every profile. The image: its header
/// and segment table, in a page.
static DEST_LEN: UInt = 0x1_0000
static IMAGE_LEN: UInt = 0x1000

/// The sosimg format as `imgformat` lays it out: a 24-byte header and a
/// 24-byte record per segment, little-endian.
static MAGIC: UInt32 = 0x4953_4F53
static VERSION: UInt32 = 3
static PRIO: UInt32 = 0x0101_0100
static HEADER_BYTES: UInt = 24
static SEG_BYTES: UInt = 24
static ARCH_RISCV32: UInt32 = 1
static ARCH_ARM64: UInt32 = 2

/// `SegFlag`'s bits.
static READ: UInt32 = 1
static WRITE: UInt32 = 2
static EXECUTE: UInt32 = 4
static RX_FLAGS: UInt32 = READ | EXECUTE
static RW_FLAGS: UInt32 = READ | WRITE

/// arm64's canonical link base, `hal.USER_IMAGE_BASE`.
static ARM64_LINK_BASE: UInt = 0x4020_0000

/// What a create answered.
static LOADED: UInt = 1
static REFUSED: UInt = 2

/// One segment: its link address and length in bytes from the link base, and
/// its flags.
struct Seg {
    at: UInt,
    len: UInt,
    flags: UInt32,
}

/// What every image is written for: the destination's link base, the grain,
/// and the architecture's tag.
struct Target {
    link: UInt,
    grain: UInt,
    arch: UInt32,
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS segmeet: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&system, &proc) catch {
        print("SOS segmeet: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS segmeet: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var pool_rec = try proc.boot_handle_next()
    guard let pool = pool_rec.take_pool() else { return BUG }
    let dest = try pool.allocate(len: DEST_LEN)
    let image = try pool.allocate(len: IMAGE_LEN)
    let view = try proc.map(memory: &image, access: RW)
    let at = try view.base()
    let target = try target_of(&proc, &dest)
    let g = target.grain

    try expect(&system, &image, &dest, at, &target,
               seg(0, 2 * g, RX_FLAGS), seg(0, 2 * g, RW_FLAGS), none(), 2,
               REFUSED, "two at one address: BadImage")
    try expect(&system, &image, &dest, at, &target,
               seg(0, 2 * g, RX_FLAGS), seg(g, 2 * g, RW_FLAGS), none(), 2,
               REFUSED, "the second over the first's last grain: BadImage")
    try expect(&system, &image, &dest, at, &target,
               seg(g, 2 * g, RX_FLAGS), seg(0, 2 * g, RW_FLAGS), none(), 2,
               REFUSED, "the second under the first's first grain: BadImage")
    try expect(&system, &image, &dest, at, &target,
               seg(0, g + 1, RX_FLAGS), seg(g, 2 * g, RW_FLAGS), none(), 2,
               REFUSED, "a byte into a grain, the next at that grain: BadImage")
    try expect(&system, &image, &dest, at, &target,
               seg(0, 2 * g, RX_FLAGS), seg(4 * g, 2 * g, READ),
               seg(g, 2 * g, RW_FLAGS), 3,
               REFUSED, "the first and the last of three: BadImage")
    try expect(&system, &image, &dest, at, &target,
               seg(0, 2 * g, RX_FLAGS), seg(4 * g, 2 * g, READ),
               seg(5 * g, 2 * g, RW_FLAGS), 3,
               REFUSED, "the last two of three: BadImage")
    try expect(&system, &image, &dest, at, &target,
               seg(0, 2 * g, RX_FLAGS), seg(2 * g, 2 * g, RW_FLAGS), none(), 2,
               LOADED, "side by side: loaded")
    try expect(&system, &image, &dest, at, &target,
               seg(2 * g, 2 * g, RX_FLAGS), seg(0, 2 * g, RW_FLAGS), none(), 2,
               LOADED, "side by side, the second below: loaded")
    try expect(&system, &image, &dest, at, &target,
               seg(0, g + 1, RX_FLAGS), seg(2 * g, 2 * g, RW_FLAGS), none(), 2,
               LOADED, "a byte into a grain, the next past it: loaded")
    try expect(&system, &image, &dest, at, &target,
               seg(0, 2 * g, RX_FLAGS), seg(2 * g, 2 * g, READ),
               seg(4 * g, 2 * g, RW_FLAGS), 3,
               LOADED, "three side by side: loaded")
    try expect(&system, &image, &dest, at, &target,
               seg(0, 2 * g, RX_FLAGS), seg(g, 0, RW_FLAGS), none(), 2,
               LOADED, "no bytes inside another, listed after it: loaded")
    try expect(&system, &image, &dest, at, &target,
               seg(g, 0, RW_FLAGS), seg(0, 2 * g, RX_FLAGS), none(), 2,
               LOADED, "no bytes inside another, listed before it: loaded")
    try expect(&system, &image, &dest, at, &target,
               seg(0, 2 * g, RX_FLAGS), seg(0, 0, RW_FLAGS), none(), 2,
               LOADED, "no bytes at another's base: loaded")
    try expect(&system, &image, &dest, at, &target,
               seg(0, 2 * g, RX_FLAGS), seg(2 * g, 0, RW_FLAGS), none(), 2,
               LOADED, "no bytes at another's top: loaded")
    try part_filled_grain(&system, &image, &dest, at, &target)
    print("SOS segmeet: a stack top at a part-filled grain's end: {}\n",
          "a thread made")
    try view.unmap()
    return
}

/// A child whose writable segment ends a byte into its second grain, and a
/// thread of it whose stack top is that grain's end: the word below the top
/// lies in the part of the grain past the segment's bytes, which its row,
/// rounded up to the grain, grants.
func part_filled_grain(system: &System, image: &Memory, dest: &Memory,
                       at: UInt, target: &Target) -> Result<Void, SosStatus> {
    let g = target.grain
    let code = seg(0, 2 * g, RX_FLAGS)
    let data = seg(4 * g, g + 1, RW_FLAGS)
    let unused = none()
    write_image(at, &target, &code, &data, &unused, 2)
    let child = try system.process_create(image: &image, memory: &dest)
    let thread = try child.thread_create(stack_top: target.link + 6 * g,
                                         arg: 0)
    let _ = move thread
    return
}

func seg(at: UInt, len: UInt, flags: UInt32) -> Seg {
    Seg(at: at, len: len, flags: flags)
}

/// The record a two-segment image does not write.
func none() -> Seg {
    Seg(at: 0, len: 0, flags: 0)
}

/// What the images are written for. On arm64 every image links at the
/// canonical base. On riscv32 an image links where its destination is,
/// learned through a mapping of root's own that is gone again by the time
/// this returns: a mapping takes its memory's own address there.
func target_of(proc: &Process, dest: &Memory) -> Result<Target, SosStatus> {
    if sizeof<UInt>() == 8 {
        return Target(link: ARM64_LINK_BASE, grain: 0x1000, arch: ARCH_ARM64)
    }
    let view = try proc.map(memory: &dest, access: RW)
    let base = try view.base()
    try view.unmap()
    return Target(link: base, grain: 4, arch: ARCH_RISCV32)
}

/// Write the image of `count` segments (`a`, `b`, then `c`) at `at`, create a
/// process from it into `dest`, require the answer `want` and print `line`.
func expect(system: &System, image: &Memory, dest: &Memory, at: UInt,
            target: &Target, a: Seg, b: Seg, c: Seg, count: UInt,
            want: UInt, line: String) -> Result<Void, SosStatus> {
    write_image(at, &target, &a, &b, &c, count)
    var got = REFUSED
    match system.process_create(image: &image, memory: &dest) {
        case Ok(child) -> {
            let _ = move child
            got = LOADED
        },
        case Err(why) -> {
            match why {
                case BadImage -> {},
                case _ -> { return why },
            }
        },
    }
    if got != want {
        let _ = system.debug_print(
            "SOS segmeet: a create answered the other way\n")
        return BUG
    }
    print("SOS segmeet: {}\n", line)
    return
}

func poke(at: UInt, value: UInt32) unsafe {
    UnsafeMemory<UInt32, Device>(at).write(value)
}

/// One segment record at `at`: a zero-filled segment of `s.len` bytes linked
/// `s.at` bytes above the link base.
func write_seg(at: UInt, target: &Target, s: &Seg) unsafe {
    poke(at, (target.link + s.at) as UInt32)
    poke(at + 4, 0)
    poke(at + 8, 0)
    poke(at + 12, 0)
    poke(at + 16, s.len as UInt32)
    poke(at + 20, s.flags)
}

/// The image: a header, then `count` segment records. The entry is `a`'s link
/// address where `a` is executable, and `b`'s otherwise.
func write_image(at: UInt, target: &Target, a: &Seg, b: &Seg, c: &Seg,
                 count: UInt) unsafe {
    poke(at, MAGIC)
    poke(at + 4, VERSION | ((count as UInt32) << 16) | (target.arch << 24))
    poke(at + 8, PRIO)
    poke(at + 12, 0)
    var entry = a.at
    if (a.flags & EXECUTE) == 0 {
        entry = b.at
    }
    poke(at + 16, (target.link + entry) as UInt32)
    poke(at + 20, 0)
    let table = at + HEADER_BYTES
    write_seg(table, &target, &a)
    write_seg(table + SEG_BYTES, &target, &b)
    if count > 2 {
        write_seg(table + 2 * SEG_BYTES, &target, &c)
    }
}
