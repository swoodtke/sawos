// Test child: one fused call that must come back `PeerClosed`.
//
// It takes the inlet its launcher gave it and calls through it. Nothing ever
// answers on the happy path: the launcher ends the exchange (it kills the
// server, or takes the message and kills this process's peer), so the call
// parks and then comes back. The verdict is the exit code, which the launcher
// reads in the status word: `EXIT_PEER_CLOSED` when the call came back
// `PeerClosed`, and `EXIT_WRONG` for any other answer, a reply included.

import sos.{System, PipeInlet, SosStatus, PIPE_BODY_BYTES}

/// Two bytes, which is a message rather than an absence.
static PAYLOAD_LEN: UInt = 2

/// The call came back `PeerClosed`.
static EXIT_PEER_CLOSED: UInt = 51

/// The call answered something else, succeeding included.
static EXIT_WRONG: UInt = 52

/// The boot set held no inlet.
static EXIT_NO_INLET: UInt = 53

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        return
    }
    var rec = try proc.boot_handle_next() catch {
        let _ = proc.exit(EXIT_NO_INLET)
        return
    }
    guard let inlet = rec.take_inlet() else {
        let _ = proc.exit(EXIT_NO_INLET)
        return
    }
    if refused(&inlet) {
        let _ = proc.exit(EXIT_PEER_CLOSED)
        return
    }
    let _ = proc.exit(EXIT_WRONG)
}

/// One fused call that must come back `PeerClosed`.
///
/// A `match` rather than the tree's `try … catch` guard shape: this is a
/// negative test asserting a specific error value. An `Ok` here is a failure of
/// the case, not of the call.
func refused(inlet: &PipeInlet) -> Bool {
    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 1
    msg[1] = 2
    match inlet.send(body: &msg, len: PAYLOAD_LEN) {
        case Ok(_) -> false,
        case Err(status) -> {
            match status {
                case PeerClosed -> true,
                case _ -> false,
            }
        },
    }
}
