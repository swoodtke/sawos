// A limit set between the create and the start is the one the child meets
// (spec §2.7): set below its default, the child is refused one past it; set
// above, within the launcher's own, it holds more than its default.
//
// Root launches `child-quota-count` twice, which makes Events until its quota
// refuses one and exits with the count. Its default Event limit is four. The
// first is given two and the second six; root's own Event row has no cap, and
// the Event slab is larger than six, so the refusal each meets is its own
// row's.
//
//   SOS quotalimit: lower: event limit 2, default 4
//   SOS quotacount: made=2, then over its quota
//   SOS quotalimit: lower ended status=65538     <- Exited << 16 | 2
//   SOS quotalimit: higher: event limit 6, default 4
//   SOS quotacount: made=6, then over its quota
//   SOS quotalimit: higher ended status=65542    <- Exited << 16 | 6
//   SOS quotalimit: done

import sos.{System, Process, Memory, AttachMode, QuotaKind, SosStatus,
            SystemRight}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// Root's config: the tag the child's System travels under.
static TAG_BOOT: UInt = 21

/// The key root watches each child's death under.
static KEY: UInt = 74

/// What the child may ask its System object for: print, and learn its own
/// Process object, which its creates go through.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)
    try run(&system) catch {
        print("SOS quotalimit: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS quotalimit: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System) -> Result<Void, SosStatus> {
    let proc = try system.process_self()
    var image_rec = try proc.boot_handle_next()
    var ram_rec = try proc.boot_handle_next()
    guard let image = image_rec.take_memory() else { return BUG }
    guard let ram = ram_rec.take_memory() else { return BUG }

    let lower = try launch(&system, &proc, &image, &ram, "lower", 2)
    print("SOS quotalimit: lower ended status={}\n", lower)
    let higher = try launch(&system, &proc, &image, &ram, "higher", 6)
    print("SOS quotalimit: higher ended status={}\n", higher)
    return
}

/// Create the child, set its Event limit to `limit`, start it and wait for
/// its death. Answers its §8 status word; the handle goes with the return.
func launch(system: &System, proc: &Process, image: &Memory, ram: &Memory,
            name: String, limit: UInt16) -> Result<UInt, SosStatus> {
    let child = try system.process_create(image: &image, memory: &ram)
    let before = try child.quota_get(kind: QuotaKind.Event)
    try child.quota_set(kind: QuotaKind.Event, limit: limit)
    print("SOS quotalimit: {}: event limit {}, default {}\n", name, limit,
          before.limit)
    let for_child = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let waiter = try proc.waiter_create()
    try waiter.add(process: &child, key: KEY, mode: AttachMode.OneShot)
    try child.start(boot_tag: TAG_BOOT)
    let _ = try waiter.wait()
    return try child.get_status()
}
