// A program written with `main` that forgets `import sosmain`: the runtime's
// seams arrive through `sos`, but nothing defines `_start`, so the link is
// refused by the user script's assertion (`main_not_imported`).

import sos.{SosStatus}

func main() -> Result<Void, SosStatus> {
    print("SOS unimported: this program is never linked")
    return
}
