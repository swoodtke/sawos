// SOS M4 unit 3: AN ATTACHMENT FLAGS WORD OUTSIDE ITS DOMAIN (sawos design 15;
// spec §5.7's faults ruling).
//
// **`WaiterOp.Add` GREW A THIRD ARGUMENT AND PUBLISHED EXACTLY TWO BITS**
// (`designs/010` rulings 9(b) and 11(c)): bit 0 detaches at delivery, bit 1
// releases the caller's entry into the attachment's keeping. A word carrying any
// other bit names a behaviour the kernel has no reading of, and the set is
// published — so it is a mistake the caller could have checked, which design
// 178's faults ruling puts outside the status enum entirely.
//
//   SOS badmode: asking for flags 4     one bit above the published set
//   SOS: process fault: argument outside its domain
//
// **IT REACHES THE C ALTITUDE, AND THAT IS THE FINDING RATHER THAN THE
// WORKAROUND.** The typed surface CANNOT SPELL THIS: `AttachMode` has two cases
// and `give` is a verb, so the four legal combinations are the only things a Saw
// caller can ask for and an invalid mode is a compile-time impossibility. That
// is the typed layer working exactly as `pipe-dead-claim`'s docstring describes
// its own reach downward — the kernel's check is still real underneath, and this
// is the altitude at which a raw word legitimately exists to test it.
//
// The waitable is an EVENT and not a pipe, deliberately: the flags check runs in
// `waiter_add` BEFORE the handle is resolved to a kind, so it is kind-blind by
// construction and the cheapest waitable is the honest one to prove it with.

import sos.{System, sos_system_process_self, sos_process_event_create,
            sos_process_waiter_create, sos_waiter_add}

static EXIT_FAILED: UInt = 1

/// The status word a successful raw op answers with (`SosStatus.Ok`). Spelled as
/// a number because this file works at the C altitude, where a status is one.
static STATUS_OK: UInt = 0

/// `EventMode.Or`, as the wire value — the floor's documented difference in
/// kind: a C caller has no enum to be handed.
static MODE_OR: UInt = 0

static KEY: UInt = 71

/// **ONE BIT ABOVE THE PUBLISHED SET.** `WAITER_ADD_ONESHOT` is bit 0 and
/// `WAITER_ADD_CONSUMING` is bit 1, so bit 2 is the first word the kernel has no
/// reading of. Named rather than written as a bare literal, and written as a
/// shift because a flag value is a bit position (the Aug-17 style ruling).
static BAD_FLAGS: UInt = 1 << 2

/// This process's own Process handle, or `0` — which names nothing.
func ask_process(boot: UInt) unsafe -> UInt {
    var out: UInt = 0
    if sos_system_process_self(boot,
                               (&var out) as UnsafePointer<UInt>) != STATUS_OK {
        return 0
    }
    out
}

/// A fresh Event in this process, or `0`.
func make_event(proc: UInt) unsafe -> UInt {
    var out: UInt = 0
    if sos_process_event_create(proc, MODE_OR,
                                (&var out) as UnsafePointer<UInt>) != STATUS_OK {
        return 0
    }
    out
}

/// A fresh Waiter in this process, or `0`.
func make_waiter(proc: UInt) unsafe -> UInt {
    var out: UInt = 0
    if sos_process_waiter_create(proc,
                                 (&var out) as UnsafePointer<UInt>) != STATUS_OK {
        return 0
    }
    out
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = ask_process(boot_handle)
    if proc == 0 {
        let _ = system.debug_print("SOS badmode: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let waiter = make_waiter(proc)
    let event = make_event(proc)
    if waiter == 0 || event == 0 {
        let _ = system.debug_print("SOS badmode: no waiter or event\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    print("SOS badmode: asking for flags {}\n", BAD_FLAGS)

    // This does not return: the kernel refuses the word and ends the process.
    let _ = sos_waiter_add(waiter, event, KEY, BAD_FLAGS)

    let _ = system.debug_print("SOS badmode: an undefined flag attached\n")
    let _ = system.shutdown(EXIT_FAILED)
}
