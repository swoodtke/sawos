// An attachment flags word outside its domain faults the process (spec §5.7).
//
// `WaiterOp.Add` takes a flags word with exactly two published bits: bit 0
// detaches at delivery, bit 1 releases the caller's entry into the attachment's
// keeping. A word carrying any other bit names a behaviour the kernel has no
// reading of. The set is published, so this is a mistake the caller could have
// checked, which the faults rule (spec §5.7) puts outside the status enum
// entirely. Expected outcome:
//
//   SOS badmode: asking for flags 4     one bit above the published set
//   SOS: process fault: argument outside its domain
//
// The test works at the C altitude because the typed surface cannot spell this:
// `AttachMode` has two cases and `give` is a verb, so the four legal
// combinations are the only things a Saw caller can ask for and an invalid mode
// is a compile-time impossibility. The kernel's check is still real
// underneath, and the C altitude, where a raw word can be passed, is where to
// test it.
//
// The waitable is an event, not a pipe, deliberately: the flags check runs in
// `waiter_add` before the handle is resolved to a kind, so it is kind-blind and
// the cheapest waitable is enough to prove it.

import sos.{System, sos_system_process_self, sos_process_event_create,
            sos_process_waiter_create, sos_waiter_add}

static EXIT_FAILED: UInt = 1

/// The rights mask `ProcessOp.Give` and `SystemOp.ProcessSelf` take; all-ones
/// keeps every right. A number because this file works at the C altitude.
static KEEP_ALL: UInt = 0xFFFF_FFFF

/// The status word a successful raw op answers with (`SosStatus.Ok`), as a
/// number for the same reason.
static STATUS_OK: UInt = 0

/// `EventMode.Or`, as the wire value — the floor's documented difference in
/// kind: a C caller has no enum to be handed.
static MODE_OR: UInt = 0

static KEY: UInt = 71

/// One bit above the published set: `WAITER_ADD_ONESHOT` is bit 0 and
/// `WAITER_ADD_CONSUMING` is bit 1, so bit 2 is the first word the kernel has no
/// reading of. Written as a shift because a flag value is a bit position.
static BAD_FLAGS: UInt = 1 << 2

/// This process's own Process handle, or `0` — which names nothing.
func ask_process(boot: UInt) unsafe -> UInt {
    var out: UInt = 0
    if sos_system_process_self(boot, KEEP_ALL,
                               (&var out) as UnsafePointer<UInt>) != STATUS_OK {
        return 0
    }
    out
}

/// A fresh Event in this process, or `0`.
func make_event(proc: UInt) unsafe -> UInt {
    var out: UInt = 0
    if sos_process_event_create(proc, MODE_OR,
                                (&var out) as UnsafePointer<UInt>) != STATUS_OK {
        return 0
    }
    out
}

/// A fresh Waiter in this process, or `0`.
func make_waiter(proc: UInt) unsafe -> UInt {
    var out: UInt = 0
    if sos_process_waiter_create(proc,
                                 (&var out) as UnsafePointer<UInt>) != STATUS_OK {
        return 0
    }
    out
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = ask_process(boot_handle)
    if proc == 0 {
        let _ = system.debug_print("SOS badmode: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let waiter = make_waiter(proc)
    let event = make_event(proc)
    if waiter == 0 || event == 0 {
        let _ = system.debug_print("SOS badmode: no waiter or event\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    print("SOS badmode: asking for flags {}\n", BAD_FLAGS)

    // This does not return: the kernel refuses the word and ends the process.
    let _ = sos_waiter_add(waiter, event, KEY, BAD_FLAGS)

    let _ = system.debug_print("SOS badmode: an undefined flag attached\n")
    let _ = system.shutdown(EXIT_FAILED)
}
