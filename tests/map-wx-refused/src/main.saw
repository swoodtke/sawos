// No row is both writable and executable (spec §2.5). `map-exec-gated`
// beside this one asks whether a handle may produce an executable row at all;
// this asks whether one row may be both writable and executable. The answer is
// no, and the two lines above the refusal show why that is not a restriction:
//
//   SOS mapwx: read-write here, wrote 107 read 107
//   SOS mapwx: read-execute in a child: one allocation, two rows
//   SOS mapwx: asking for write and execute in one row
//   SOS: process fault: argument outside its domain
//
// The two views are the point of the first two lines. One allocation may be
// mapped twice (two rows, two Mappings, no aliasing bookkeeping), so the
// JIT-shaped pattern is available: write instructions through the RW row,
// fetch them through the RX row, with every individual protection row W^X.
// Here the RX row is in a child, created and never started: two rows of one
// process never overlap (spec §2.5), so where a mapping takes its memory's own
// address the two views are in two processes, and where the target places a
// mapping they may also be at two addresses of one. The refusal removes only
// the single row a process could write to and then fetch from, which has no
// honest use.
//
// It is refused through root's full pool handle, which carries
// `MemoryRight.MapExecute` and has just proved it. So this refusal cannot be
// the exec gate wearing a different hat: the rights are all there, and the word
// is what is wrong. `BadArg` rather than `AccessDenied` says exactly that.
//
// The boundary (also stated at the check and in §2.5): this rule governs the
// dynamic map. A process image's own segments arrive through `process_create`'s
// loader with `SegFlag` bits read out of the image, validated by
// `imgformat.has_sane_perms`, which refuses write-without-read and X-on-device
// but not W|X; an image's segments are kept apart by its linker script. That
// door is `SystemRight.ProcessCreate` authority; this one is any holder of a
// region.

import sos.{System, Process, Memory, Pool, Mapping, MapAccess, SosStatus}

extern "C" {
    func sos_test_pool_base() -> UInt
}

/// One page of the pool, which is the smallest thing either profile grants.
static CHUNK: UInt = 0x1000

static RW: UInt32 = MapAccess.Read | MapAccess.Write
static RX: UInt32 = MapAccess.Read | MapAccess.Execute

/// The one word this case refuses, spelled out of the same three cases every
/// legal word is spelled out of, which is what makes it caller-checkable.
static RWX: UInt32 = (MapAccess.Read | MapAccess.Write | MapAccess.Execute)

/// The byte this case writes through its read-write row. A number that appears
/// nowhere else in any transcript.
static MARK: UInt8 = 0x6B

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

func poke(addr: UInt, value: UInt8) unsafe {
    UnsafeMemory<UInt8, Normal>(addr).write(value)
}

func peek(addr: UInt) unsafe -> UInt8 {
    UnsafeMemory<UInt8, Normal>(addr).read()
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS mapwx: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The boot set, in the table's order: the child's image, its destination
    // and the RAM pool.
    var image_record = try proc.boot_handle_next() catch {
        print("SOS mapwx: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var ram_record = try proc.boot_handle_next() catch {
        print("SOS mapwx: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var pool_record = try proc.boot_handle_next() catch {
        print("SOS mapwx: no pool region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let image = image_record.take_memory() else {
        let _ = system.debug_print("SOS mapwx: image record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let ram = ram_record.take_memory() else {
        let _ = system.debug_print("SOS mapwx: dest record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let pool = pool_record.take_pool() else {
        let _ = system.debug_print("SOS mapwx: pool record is not a pool\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let page = try pool.allocate(len: CHUNK) catch {
        print("SOS mapwx: allocation failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The writable row, and a byte through it, so "writable" is a fact about
    // the machine rather than about the kernel's bookkeeping.
    let _data = try proc.map(memory: &page, access: RW) catch {
        print("SOS mapwx: read-write map failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    // This program never learned the address from the kernel: `map` answers
    // with a Mapping, not a number, and a region has no bounds reader. The
    // address of this process's first mapping is the build's config, published
    // to this package through one C constant per architecture, as the other map
    // cases do.
    let page_at = sos_test_pool_base()
    poke(page_at, MARK)
    print("SOS mapwx: read-write here, wrote {} read {}\n",
          MARK as Int, peek(page_at) as Int)

    // The executable row, of the same allocation, in a child: the second view,
    // and the reason W^X-per-row takes nothing away.
    let child = try system.process_create(image: &image, memory: &ram) catch {
        print("SOS mapwx: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _text = try child.map(memory: &page, access: RX) catch {
        print("SOS mapwx: read-execute map failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    // ASCII only on a console line: `ascii_byte` renders a non-ASCII scalar as
    // `?`, so an em dash here would reach the transcript as one. Punctuation
    // belongs in the comments.
    let _ = system.debug_print(
        "SOS mapwx: read-execute in a child: one allocation, two rows\n")

    // The refusal. Same allocation, same full handle, root as the target;
    // only the access word differs, and it is the one word the kernel will not
    // install. It is a fault, decided before the target's rows are looked at,
    // and it ends the process, so this is the last thing that happens.
    let _ = system.debug_print("SOS mapwx: asking for write and execute in one row\n")
    match proc.map(memory: &page, access: RWX) {
        case Ok(_) -> {
            let _ = system.debug_print("SOS mapwx: UNREACHABLE\n")
            let _ = system.shutdown(EXIT_FAILED)
        },
        case Err(e) -> {
            print("SOS mapwx: UNREACHABLE status {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
        },
    }
    let _ = proc.exit(EXIT_OK)
}
