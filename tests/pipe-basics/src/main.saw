// A connection end to end in one process (spec §2.1). Root creates a pair,
// holds both ends itself and exercises the data path, with no second process,
// no waitability and no parking. The transcript reads as a list of properties:
//
//   round trip len=3 b=65,66,67   the bytes came through, not merely a status
//   fifo order=123                order is preserved across several messages
//   empty message len=0           a data-free message is a message (§2.1),
//                                 distinguishable from "nothing yet"
//   ring depth=16                 the staging ring is 2 x MAX_THREADS deep and
//                                 a full one refuses rather than overwriting
//   drained=16                    every one of them was still there
//   take empty is none            an empty ring is `WouldBlock` at the op
//
// `depth=16` is a claim, not a number. `PIPE_INFLIGHT` is `2 * MAX_THREADS` in
// `kcore.limits` and is not published to userspace, so this program posts until
// the kernel says no and counts. A kernel that silently overwrote a staged
// message, or stopped one slot early, would print a different number.
//
// A full ring and an empty ring are both "not right now", so they ride the
// error channel as `WouldBlock`, not an Optional every caller would unwrap.
// The two helpers below are pollers and write that arm out. `PeerClosed` is
// the other error that reaches this channel; `pipe-peer-gone` proves it.
//
// A post answers a claim on the reply the message is owed, a take answers the
// obligation to send it, and a ring slot lives until the exchange settles, not
// until its bytes are taken. This case is about the data path, so it uses the
// tell idiom at every step (post, give the claim up; the message is still owed
// to the server) and discharges each obligation by dropping it. Both halves of
// every exchange go before the next line runs, so the slot recycles.
// `pipe-oneshot` deliberately leaves an exchange open and counts the ring with
// one in flight.
//
// Every loop is bounded. A poll loop with no ceiling is a hang the deadlock
// report cannot see, so both counting loops stop after `MAX_ROUNDS` whatever
// the kernel answers, and a run that hit the ceiling would print a number the
// expectation does not match.

import sos.{System, Process, PipeInlet, PipeOutlet, PipeReply, PipeRequest,
            PipeMsg,
            SosStatus, PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// The ceiling on every poll loop below. Comfortably past any staging ring this
/// kernel could have; the point is that the loop terminates whatever the
/// kernel answers, not that the number is tight.
static MAX_ROUNDS: Int = 64

/// Post and give the claim up (§2.1's tell idiom).
///
/// The message is staged and the client says at once that it does not want the
/// answer. That is legal, not a leak: a staged message is owed to a live outlet
/// whatever became of its claim, so the server still receives it, and the
/// exchange's ring slot is released the moment the server's obligation goes
/// too. Answers "was it staged".
///
/// This is a poller: `post` puts a full ring on the error channel, so this
/// caller, which fills a ring until it is refused, writes the `WouldBlock` arm
/// out and hands its own callers a `Bool`.
func tell(inlet: &PipeInlet, body: &[UInt8; PIPE_BODY_BYTES],
          len: UInt) -> Result<Bool, SosStatus> {
    let claim = try inlet.post(body: &body, len: len) catch {
        match error {
            case WouldBlock -> { return false },
            case _ -> { return error },
        }
    }
    let _ = move claim
    return true
}

/// Take and discharge by dropping. The obligation is answered the one way a
/// server with nothing to say can answer it, by releasing it, which tells a
/// client that is still listening `PeerClosed`. Here nobody is listening (the
/// claim went at the post), so the exchange settles and its ring slot goes
/// back.
///
/// The drain half of the same poller, with the same `WouldBlock` arm: an empty
/// ring is `Err(WouldBlock)` at the op and `Ok(None)` here, this program's own
/// vocabulary for "the drain is finished".
func take_message(outlet: &PipeOutlet) -> Result<PipeMsg?, SosStatus> {
    let got = try outlet.take() catch {
        match error {
            case WouldBlock -> { return None },
            case _ -> { return error },
        }
    }
    let (msg, request) = move got
    let _ = move request
    let some: PipeMsg? = move msg
    return move some
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS pipebasics: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The factory is on the process object, and it hands back both ends at once
    // through a two-word copy-out record (one op returns one word, and a
    // connection has two ends). Root keeps both here; `pipe-child` is where one
    // of them travels.
    let pair = try proc.pipe_create() catch {
        print("SOS pipebasics: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (inlet, outlet) = move pair
    let _ = system.debug_print("SOS pipebasics: created\n")

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]

    // Round trip. The bytes are what is asserted, not the status.
    msg[0] = 65
    msg[1] = 66
    msg[2] = 67
    let staged = try tell(&inlet, &msg, 3) catch {
        print("SOS pipebasics: post failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    if not staged {
        let _ = system.debug_print("SOS pipebasics: fresh ring refused a post\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let first = try take_message(&outlet) catch {
        print("SOS pipebasics: take failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let one = move first else {
        let _ = system.debug_print("SOS pipebasics: nothing staged\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS pipebasics: round trip len={} b={},{},{}\n", one.len,
          one.bytes[0] as UInt, one.bytes[1] as UInt, one.bytes[2] as UInt)

    // FIFO. Three messages in, three out, and the order is the claim: a ring
    // that handed back the newest first would print 3,2,1 here.
    msg[0] = 1
    let a = try tell(&inlet, &msg, 1) catch {
        print("SOS pipebasics: fifo post 1 failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    msg[0] = 2
    let b = try tell(&inlet, &msg, 1) catch {
        print("SOS pipebasics: fifo post 2 failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    msg[0] = 3
    let c = try tell(&inlet, &msg, 1) catch {
        print("SOS pipebasics: fifo post 3 failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    if not (a && b && c) {
        let _ = system.debug_print("SOS pipebasics: fifo posts refused\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var order: UInt = 0
    var seen: Int = 0
    while seen < 3 {
        let got = try take_message(&outlet) catch {
            print("SOS pipebasics: fifo take failed: {}\n", error)
            let _ = system.shutdown(EXIT_FAILED)
            return
        }
        guard let each = move got else {
            let _ = system.debug_print("SOS pipebasics: fifo ran dry\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        }
        // The three first-bytes accumulate as digits, so one number carries the
        // order and not only the set.
        order = order * 10 + (each.bytes[0] as UInt)
        seen = seen + 1
    }
    print("SOS pipebasics: fifo order={}\n", order)

    // The empty message. §2.1 makes a data-free body an option, and the two
    // channels keep "a message of length 0" apart from "no message": this take
    // answers `Ok(msg)` with `len` 0, where the one after the drain below
    // answers `Err(WouldBlock)`.
    let empty_staged = try tell(&inlet, &msg, 0) catch {
        print("SOS pipebasics: empty post failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    if not empty_staged {
        let _ = system.debug_print("SOS pipebasics: empty post refused\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let empty = try take_message(&outlet) catch {
        print("SOS pipebasics: empty take failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let zero = move empty else {
        let _ = system.debug_print("SOS pipebasics: empty message vanished\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS pipebasics: empty message len={}\n", zero.len)

    // The ring's depth, counted. Post until the kernel refuses; the count is
    // `PIPE_INFLIGHT`, which this program has no way to name.
    var depth: UInt = 0
    var filling = true
    var rounds: Int = 0
    while filling && rounds < MAX_ROUNDS {
        rounds = rounds + 1
        let put = try tell(&inlet, &msg, 1) catch {
            print("SOS pipebasics: fill failed: {}\n", error)
            let _ = system.shutdown(EXIT_FAILED)
            return
        }
        if put {
            depth = depth + 1
        } else {
            filling = false
        }
    }
    print("SOS pipebasics: ring depth={}\n", depth)

    // Every one of them is still there. A ring that dropped the oldest to make
    // room would drain fewer than it staged.
    var drained: UInt = 0
    var draining = true
    var passes: Int = 0
    while draining && passes < MAX_ROUNDS {
        passes = passes + 1
        let got = try take_message(&outlet) catch {
            print("SOS pipebasics: drain failed: {}\n", error)
            let _ = system.shutdown(EXIT_FAILED)
            return
        }
        if let _ = got {
            drained = drained + 1
        } else {
            draining = false
        }
    }
    print("SOS pipebasics: drained={}\n", drained)

    // An empty ring is `Err(WouldBlock)`, which the poller reads as its own
    // `None`. The loop above already met it once; asking again shows it is
    // stable.
    let nothing = try take_message(&outlet) catch {
        print("SOS pipebasics: empty ring is an error: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    if let _ = nothing {
        let _ = system.debug_print("SOS pipebasics: drained ring still had one\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS pipebasics: take empty is none\n")

    print("SOS pipebasics: done\n")
    let _ = proc.exit(EXIT_OK)
}
