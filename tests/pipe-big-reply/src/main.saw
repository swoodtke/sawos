// A reply bigger than the slot faults the process (spec §2.1).
//
// The reply rides the request's own slot, so the answer's maximum is the
// question's maximum, one number, `PIPE_BODY_BYTES`. A caller cannot even
// declare the buffer without it, so a `len` above it is a mistake the process
// could have checked, which the faults rule (spec §5.7) puts outside the status
// enum entirely. It is `pipe-oversized`'s line, running outward. Expected
// outcome:
//
//   SOS bigreply: asking for 129
//   SOS: process fault: argument outside its domain
//
// The length check runs before the copy and before the consume, which makes the
// refusal safe and not merely correct: nothing is read out of the caller's
// memory, the staging slot is untouched, and the obligation is not discharged.
// A hostile length is a diagnostic, never a partial write and never an exchange
// quietly closed.

import sos.{System, Process, PipeInlet, PipeOutlet, PipeReply, PipeRequest,
            SosStatus, PIPE_BODY_BYTES}

static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS bigreply: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let pair = try proc.pipe_create() catch {
        print("SOS bigreply: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (inlet, outlet) = move pair

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 1

    let claim = try inlet.post(body: &msg, len: 1) catch {
        print("SOS bigreply: post failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let taken = try outlet.take() catch {
        print("SOS bigreply: take failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (_, request) = move taken
    let obligation = move request

    // One byte past the slot. The buffer this names is a whole slot wide, so
    // nothing here is out of bounds in the caller's own memory; what is out of
    // bounds is the ask, which is the only thing the kernel is told.
    let too_much: UInt = (PIPE_BODY_BYTES as UInt) + 1
    print("SOS bigreply: asking for {}\n", too_much)

    match (move obligation).reply(body: &msg, len: too_much) {
        case Ok(_) -> {
            let _ = system.debug_print("SOS bigreply: an oversized reply was sent\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
        // Unreachable: the kernel ends this process at the length check, so
        // neither arm runs. Written so the refusal reads as a refusal.
        case Err(e) -> {
            print("SOS bigreply: reply refused: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
}
