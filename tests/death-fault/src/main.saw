// The fault arm: a death nobody chose wakes a supervisor.
//
// The same program as `death-notify` with one thing taken away. This launcher
// gives its child nothing: no System handle, no boot tag, so the child holds
// `NO_HANDLE` and the kernel terminates it at its first `ecall`. Root's park
// and attachment are identical, and what comes back out of the wait record is
// a different §8 status word. A supervisor learns that a child died, and how,
// through one mechanism, whether the child chose the ending or the kernel did.
//
// Expected transcript:
//
//   SOS deathfault: started
//   SOS: process fault: bad handle process=...      <- the kernel ending it
//   SOS: process teardown ... process=...
//   SOS deathfault: woke key=45 status=131073       <- root, on the far side
//   SOS deathfault: child syscalls=1 faults=0
//   SOS deathfault: done
//
// `status=131073` is `Faulted`(2) << 16 | 1, and the 1 is
// `FaultReason.BadHandle`: the same word `process-lifecycle` reads through
// `get_status`, arriving here as a wake instead of a poll.
//
// The fault report comes first and the wake last: `fault_process` prints, then
// records the status, then notifies, then tears the process down, and the
// notification only queues a thread, so root runs after the teardown has
// finished. Root never observes a half-dead process.

import sos.{System, Process, Memory, BootHandle, Waiter, WaitResult,
            WaitPayload, SosStatus}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// The key this case attaches the child's Process handle under.
static KEY: UInt = 45

/// The §8 status word out of the record. See `death-notify` for why the other
/// three arms panic rather than handle anything.
func status_of(r: &WaitResult) -> UInt {
    match r.what {
        case Process(status) -> status,
        case _ -> panic("this program attached only a Process"),
    }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS deathfault: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    var image = try proc.boot_handle_next() catch {
        print("SOS deathfault: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS deathfault: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let image_mem = image.take_memory() else {
        let _ = system.debug_print("SOS deathfault: image record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let dest_mem = dest.take_memory() else {
        let _ = system.debug_print("SOS deathfault: dest record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS deathfault: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let waiter = try proc.waiter_create() catch {
        print("SOS deathfault: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try waiter.add(process: &child, key: KEY) catch {
        print("SOS deathfault: attach failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // No `give`, no boot tag. The child receives `NO_HANDLE` in its first
    // argument register and dies at its first syscall: a sandboxed compute
    // process that is legal but doomed, used here as a fault generator.
    try child.start() catch {
        print("SOS deathfault: start failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS deathfault: started\n")

    let record = try waiter.wait() catch {
        print("SOS deathfault: wait failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    print("SOS deathfault: woke key={} status={}\n",
          record.key, status_of(&record))

    // The columns say which door the death came through. `syscalls=1
    // faults=0` is `child-fault`'s whole life: one `ecall`, naming handle zero,
    // which the kernel answered by ending it. The trap is charged to the
    // syscall column even though it killed the process, because the columns are
    // keyed by how the machine entered the kernel, not by what the kernel did
    // about it. That keeps `syscalls` predictable, since a caller cannot know
    // in advance which call will be refused.
    //
    // `process_isolation` asserts the mirror, `syscalls=0 faults=1`, a child
    // stopped by the hardware before it reached the syscall door.
    let cost = try child.stats() catch {
        print("SOS deathfault: stats failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS deathfault: child syscalls={} faults={}\n",
          cost.syscalls, cost.faults)

    print("SOS deathfault: done\n")
    let _ = proc.exit(EXIT_OK)
}
