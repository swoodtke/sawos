//! A child of the gate's stock-root images on the riscv32 `virt` board: it
//! holds the goldfish RTC whole and its line, and prints its alarm's upper
//! word (`tests/stockkit`).

import stockkit
import stockconfig.{name, OFFSET}

@export("_start")
func _start(boot_handle: UInt) {
    stockkit.probe(boot_handle, name(), OFFSET)
}
