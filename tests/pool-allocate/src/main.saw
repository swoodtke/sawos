// The pool, allocated from (spec §2.5). `allocate(len)` on a pool mints a
// region over `len` bytes of the pool (first fit from the pool's free list,
// else the front of its frontier) and the handle keeps naming the rest. The
// transcript reads as three claims:
//
//   SOS poolalloc: a=170 b=187 a-again=170   <- the allocations are disjoint
//                                               (0xaa, 0xbb, 0xaa; the bytes
//                                               render as decimal)
//   SOS poolalloc: rounds=20 refused=0       <- a dropped allocation returns
//                                               its slot, so the slab is not
//                                               what a loop runs into
//   SOS poolalloc: refused: this pool has no free range that long
//                                            <- an oversize allocation is a
//                                               status
//
// The second line: `ROUNDS` is more than the slab has slots (`MAX_MEMORIES`),
// so completing them all with nothing refused is the claim. Each round mints
// a region, the wrapper dies at the end of the arm, the release takes its
// count to zero, and the slot comes straight back for the next round.
//
// The first line proves the arithmetic. A region has no bounds reader, so "the
// frontier advanced" cannot be observed by asking. It is observed by using
// both allocations: write 0xaa into the first, 0xbb into the second, read the
// first again. A pool that had not advanced would hand out the same range
// twice and the second write would have destroyed the first.
//
// The maps are what make the writes possible at all. Every address in this
// program faults until mapped; the pool is memory this image never declared and
// the linker never heard of.
//
// The last line is a status, `NoMemory`, and not a fault: a pool may be shared
// with other holders, so what it holds is not something a caller can know when
// it asks (spec §5.7). The program reports it and shuts down cleanly.

import sos.{System, Process, Memory, Pool, Mapping, MapAccess, SosStatus}

// The address of this program's first mapping: its config, per architecture, in
// C because Saw cannot name an address. See `tests/poolbase_riscv32.c`.
extern "C" {
    func sos_test_pool_base() -> UInt
}

/// One protection unit's worth on either profile: 4 KiB is a multiple of both
/// `PROT_GRAIN`s, so one number serves both machines.
static CHUNK: UInt = 0x1000

/// Read and write, which is what a scratch region wants. The bits fold at this
/// annotated `static` because a fixed-width slot is a const position.
static RW: UInt32 = MapAccess.Read | MapAccess.Write

/// A length no remaining pool can satisfy: the oversize allocation.
static OVERSIZE: UInt = 0x0100_0000

/// How many allocate-and-drop rounds the loop runs. Past `MAX_MEMORIES` on
/// purpose: a run that completes this many rounds with nothing refused is
/// possible only because a dropped region gives its slot back. It is also far
/// inside the pool's own supply (many chunks, two of them already allocated
/// above), so the number this loop stops at is the one this program chose and
/// not one the machine imposed.
static ROUNDS: Int = 20

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// Write one byte through a mapping. `unsafe` because it names a pointer type,
/// and confined to one line.
func poke(addr: UInt, value: UInt8) unsafe {
    UnsafeMemory<UInt8, Normal>(addr).write(value)
}

/// Read one byte back.
func peek(addr: UInt) unsafe -> UInt8 {
    UnsafeMemory<UInt8, Normal>(addr).read()
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS poolalloc: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The boot set carries one row: the RAM pool. Its tag is 0 because it is
    // the only row, which is root's config knowing the build's row order.
    var record = try proc.boot_handle_next() catch {
        print("SOS poolalloc: no pool region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let pool = record.take_pool() else {
        let _ = system.debug_print(
            "SOS poolalloc: boot record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let base = sos_test_pool_base()

    // Allocation one covers `[base, base + CHUNK)` and the pool's frontier
    // now begins after it.
    let first = try pool.allocate(len: CHUNK) catch {
        print("SOS poolalloc: first allocation failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _first_map = try proc.map(memory: &first, access: RW) catch {
        print("SOS poolalloc: first map failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    poke(base, 0xAA)

    // Allocation two, which lands where the cursor now points.
    let second = try pool.allocate(len: CHUNK) catch {
        print("SOS poolalloc: second allocation failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _second_map = try proc.map(memory: &second, access: RW) catch {
        print("SOS poolalloc: second map failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    poke(base + CHUNK, 0xBB)

    // The disjointness claim, as a value: the first byte is still what it was.
    print("SOS poolalloc: a={} b={} a-again={}\n", peek(base) as Int,
          peek(base + CHUNK) as Int, peek(base) as Int)

    // A dropped allocation returns its slot. `case Ok(_)` binds nothing, so
    // the region the kernel just minted dies at the end of the arm and its
    // deinit releases the only handle onto it, which takes the reference count
    // to zero inside that release, and the slot is free before the next round
    // asks for one. `ROUNDS` is past the slab's slots (`MAX_MEMORIES`), so
    // `refused=0` is only possible if the recycling is real.
    var rounds = 0
    var refused: UInt = 0
    while rounds < ROUNDS && refused == 0 {
        match pool.allocate(len: CHUNK) {
            case Ok(_) -> { rounds = rounds + 1 },
            case Err(_) -> { refused = 1 },
        }
    }
    print("SOS poolalloc: rounds={} refused={}\n", rounds, refused)

    // An oversize allocation is a status: no free range is that long, and a
    // pool's free state is not something its holder can know in advance.
    let _ = system.debug_print("SOS poolalloc: asking for more than is left\n")
    let _over = try pool.allocate(len: OVERSIZE) catch {
        print("SOS poolalloc: refused: {}\n", error)
        let _ = system.shutdown(EXIT_OK)
        return
    }

    let _ = system.debug_print("SOS poolalloc: UNREACHABLE\n")
    let _ = system.shutdown(EXIT_FAILED)
}
