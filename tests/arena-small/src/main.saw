// Arena override: a package that chooses its own arena.
//
// The package's manifest names a two-line script (`arena-small.riscv32.ld`)
// that sets `ARENA_SIZE = 8K` before INCLUDEing the same `user.ld` every other
// package names. `sosrt`'s arena is a linker region, so this sets
// the size for this image only.
//
// There is no API to ask an arena how big it is. The program instead makes
// two requests whose outcomes together pin the size to a range only the
// override can produce:
//
//   SOS arenasmall: 2 KiB ok          <- the region is real (a 0 KiB arena, or
//                                        one the linker forgot, fails here)
//   SOS arenasmall: 16 KiB refused as a STATUS: allocation of 16384 bytes
//                                     (align 4) failed
//                                     <- the arena answered null, and std made
//                                        it the constructor's `AllocError`
//
// The second request proves the override. 16 KiB is past this package's 8 KiB
// and far inside the shared default arena, so an image that did not take the
// override serves the request and prints the UNREACHABLE line at the bottom,
// which fails the case loudly. The first request rules out the other way to
// be wrong: a region that ended up empty or unreserved fails at 2 KiB.
//
// The refusal is a status: `__saw_rt_alloc` answers null when the arena holds
// no such block (`rt/common/src/lib.saw`), and `Vector(capacity:)` hands the
// `AllocError` back, so the program goes on and shuts down clean.
//
// Runs on all three profiles: a link address and a heap behave the same on
// a flat platform as on an isolated one.

import sos.{System}

/// 512 words = 2 KiB. Comfortably inside the 8 KiB the script asks for, with
/// room for whatever the allocator rounds or aligns.
static WITHIN_WORDS: Int = 512

/// 4096 words = 16 KiB. Past the 8 KiB override, far inside the default.
static BEYOND_WORDS: Int = 4096

/// Written into the first request and read back.
static WITNESS: UInt32 = 0xA5A5_5A5A

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    // Request one: the override must still be able to serve it.
    var within = try Vector<UInt32>(capacity: WITHIN_WORDS) catch {
        print("SOS arenasmall: 2 KiB refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try within.push(WITNESS) catch {
        print("SOS arenasmall: push refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    // Reserving storage and using it are two claims; reading the witness back
    // shows the arena's address is inside the region the linker reserved.
    if within[0] != WITNESS {
        let _ = system.debug_print("SOS arenasmall: witness LOST\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS arenasmall: 2 KiB ok\n")

    // Request two: refused, as a status.
    let beyond = try Vector<UInt32>(capacity: BEYOND_WORDS) catch {
        print("SOS arenasmall: 16 KiB refused as a STATUS: {}", error)
        let _ = system.shutdown(EXIT_OK)
        return
    }

    // Unreachable on a correct build: a run that gets here linked the shared
    // default arena, so it exits non-zero.
    print("SOS arenasmall: UNREACHABLE, got {} words\n", beyond.len())
    let _ = system.shutdown(EXIT_FAILED)
}
