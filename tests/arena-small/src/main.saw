// Arena override: a package that chooses its own arena.
//
// The package's manifest names a two-line script (`arena-small.riscv32.ld`)
// that sets `ARENA_SIZE = 8K` before INCLUDEing the same `root.ld` every other
// root package names. `sosrt`'s bump arena is a linker region, so this sets
// the size for this image only.
//
// There is no API to ask an arena how big it is. The program instead makes
// two requests whose outcomes together pin the size to a range only the
// override can produce:
//
//   SOS arenasmall: 2 KiB ok          <- the region is real (a 0 KiB arena, or
//                                        one the linker forgot, fails here)
//   SOS arenasmall: asking 16 KiB     <- printed before the ask, because the
//                                        ask does not return
//   sos: out of arena memory          <- `sosrt`'s own failure; the machine
//                                        stops with `AbortCode.NoMemory`
//
// The second request proves the override. 16 KiB is past this package's 8 KiB
// and far inside the shared default arena, so an image that did not take the
// override serves the request, runs on, and prints the UNREACHABLE line at
// the bottom, which fails the case loudly. The first request rules out the
// other way to be wrong: a region that ended up empty or unreserved fails at
// 2 KiB.
//
// The failure is an abort, not a status: `__saw_rt_alloc` has nowhere to
// report to (it is the allocator every reporting path would allocate
// through), so it writes one line and stops the machine
// (`rt/common/src/lib.saw`). The `catch` arms below are unreachable on this
// runtime; they exist because the signatures carry an error channel.
//
// Runs on all three profiles: a link address and a bump cursor behave the
// same on a flat platform as on an isolated one.

import sos.{System}

/// 512 words = 2 KiB. Comfortably inside the 8 KiB the script asks for, with
/// room for whatever the allocator rounds or aligns.
static WITHIN_WORDS: Int = 512

/// 4096 words = 16 KiB. Both bounds are load-bearing: past this package's
/// 8 KiB, and far inside the default arena every package that overrides
/// nothing gets.
static BEYOND_WORDS: Int = 4096

/// A pattern with bits in both nibbles of every byte, so reading it back is a
/// claim about the storage rather than a coincidence with zeroed `.bss`.
static WITNESS: UInt32 = 0xA5A5_5A5A

static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    // Request one: the override must still be able to serve it.
    var within = try Vector<UInt32>(capacity: WITHIN_WORDS) catch {
        print("SOS arenasmall: 2 KiB refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try within.push(WITNESS) catch {
        print("SOS arenasmall: push refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    // Reserving storage and using it are two claims; reading the witness back
    // shows the arena's address is inside the region the linker reserved.
    if within[0] != WITNESS {
        let _ = system.debug_print("SOS arenasmall: witness LOST\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS arenasmall: 2 KiB ok\n")

    // Request two. Printed first, because the ask below does not return: the
    // next line in the transcript is the runtime's, not this program's.
    let _ = system.debug_print("SOS arenasmall: asking 16 KiB\n")
    let beyond = try Vector<UInt32>(capacity: BEYOND_WORDS) catch {
        // Unreachable on this runtime (see the header). If it is ever reached,
        // the allocator grew an error channel and this case should be
        // rewritten to assert that.
        print("SOS arenasmall: 16 KiB refused as a STATUS: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // Unreachable on a correct build: the ask above stopped the machine. A run
    // that gets here linked the shared default arena, so it exits non-zero.
    print("SOS arenasmall: UNREACHABLE, got {} words\n", beyond.len())
    let _ = system.shutdown(EXIT_FAILED)
}
