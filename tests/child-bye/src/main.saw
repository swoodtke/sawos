// Test child: ends on purpose. Derives its own Process object from the masked
// System handle, prints one line and calls `exit(EXIT_CODE)`.
//
// What the test observes is on the launcher's side: it is parked on a Waiter
// with this process's Process handle attached, and the exit code lands in the
// spec.md §8 status word that wakes it. EXIT_CODE is 5; the value is arbitrary
// but distinctive. The launcher prints `Exited`(1) << 16 | 5 = 65541, a word
// that differs from a fault ending (which reads `Faulted`(2) in the high half),
// so it identifies which ending happened.
//
// A child that cannot reach its own Process object falls off `_start`, whose
// link register is zero (§8). The kernel faults it and the launcher reads
// `Faulted` instead of `Exited`. The error arm does not retry.

import sos.{System}

/// The code this child ends with. Only its distinctness matters.
static EXIT_CODE: UInt = 5

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        print("SOS bye: no process handle: {}\n", error)
        // Nothing is left to exit with. Returning from the entry faults this
        // process, which the launcher reads as `Faulted` instead of `Exited`.
        return
    }

    let _ = system.debug_print("SOS bye: exiting\n")
    let _ = proc.exit(EXIT_CODE)
}
