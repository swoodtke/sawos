// A give the kernel refuses for capacity hands the object back (spec §3).
//
// Root creates a child it never starts and gives it masked System siblings,
// one tag each, until the child's handle budget refuses one with
// `QuotaExceeded`. The refusal is a status, so the kernel left root's entry in
// place, and `Process.give` returns the sibling in its error payload. Root
// prints through it, which only a live handle can do, then drops it and exits.
//
// Root's teardown line is the second half of the proof. Dropping the returned
// sibling releases its entry, so root ends holding exactly what it would hold
// had it stopped at the budget without meeting the refusal. A refused give
// that left its entry bound with no wrapper naming it would show up there as
// one handle more.

import sos.{System, Process, SystemRight}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// The first boot tag. Each give takes the next one, so no tag repeats and the
/// only refusal left to meet is the budget's.
static TAG_FIRST: UInt = 40

/// What each sibling carries: `Transfer` so it can be given at all, and
/// `Debug` so the one that comes back can prove it is live by printing.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS givefull: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The boot set, in the build's row order: the child's image blob, then the
    // RAM it would run in.
    var image = try proc.boot_handle_next() catch {
        print("SOS givefull: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS givefull: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let image_mem = image.take_memory() else {
        let _ = system.debug_print("SOS givefull: image record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let dest_mem = dest.take_memory() else {
        let _ = system.debug_print("SOS givefull: dest record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The child stays `Created`, so every give below is legal and the boot set
    // never freezes.
    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS givefull: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS givefull: created\n")

    var given: UInt = 0
    while true {
        let sibling = try system.mint(rights: CHILD_SYSTEM) catch {
            print("SOS givefull: mint failed: {}\n", error)
            let _ = system.shutdown(EXIT_FAILED)
            return
        }
        try child.give(system: move sibling, tag: TAG_FIRST + given) catch {
            let (why, back) = move error
            print("SOS givefull: gave {} then refused: {}\n", given, why)
            try back.debug_print("SOS givefull: the refused System still speaks\n") catch {
                print("SOS givefull: the refused System is dead: {}\n", error)
                let _ = system.shutdown(EXIT_FAILED)
                return
            }
            // Dropping it releases the entry the refusal left in root's table.
            let _ = move back
            break
        }
        given = given + 1
    }

    let _ = system.debug_print("SOS givefull: exiting\n")
    let _ = proc.exit(EXIT_OK)
}
