// Abandonment in three directions: every way a one-shot exchange can end with
// nobody on the other side delivers `SosStatus.PeerClosed` (spec §2.1), the
// same word a connection's own zero-arms use, and never strands a caller.
//
//   The client drops its claim. The server's `reply` is told, and its
//   obligation is discharged either way (never a silent success; the result
//   may be ignored with `let _ =`). That is the cancellation primitive: there
//   is no `cancel()` verb, only a claim going out of scope, and whether it
//   cancels anything is the protocol's decision, not the kernel's.
//
//   The server drops its obligation. The client's `resolve` is told, so there
//   are no hung clients and no timeout hacks.
//
//   The server end of the connection goes while a message is still staged.
//   Its obligation will never be minted, so the claim is abandoned by a server
//   that never existed, and `resolve` says so.
//
// Each answer spends its capability. A connection's `PeerClosed` is a level a
// caller may re-read forever; an exchange's is the end of that exchange, so
// the one-shot is consumed with it and asking again is a dead handle, not a
// repeat. `pipe-dead-claim` proves that fault on its own because it ends the
// process.
//
// Statuses are printed by name: the program prints the ABI enum's own
// `describe()`, so a renumbering of the wire table does not move the
// transcript.

import sos.{System, Process, PipeInlet, PipeOutlet, PipeReply, PipeRequest,
            SosStatus, PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS abandon: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let pair = try proc.pipe_create() catch {
        print("SOS abandon: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (inlet, outlet) = move pair
    let _ = system.debug_print("SOS abandon: created\n")

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]

    // Arm one, the client abandons: post, take, drop the claim, and the reply
    // that follows is told there is nobody to receive it.
    msg[0] = 1
    let claim = try inlet.post(body: &msg, len: 1) catch {
        print("SOS abandon: post failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var obligation = try take_one(&outlet) catch {
        print("SOS abandon: take failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // Dropping the claim is the cancellation. Deterministic destruction makes
    // the timing of the signal deterministic too.
    let _ = move claim

    match (move obligation).reply(body: &msg, len: 1) {
        case Ok(_) -> {
            let _ = system.debug_print("SOS abandon: a reply landed on nobody\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
        case Err(e) -> { print("SOS abandon: reply says {}\n", e) },
    }

    // Arm two, the server abandons: post, take, drop the obligation, and the
    // client is told rather than left waiting for an answer that cannot come.
    msg[0] = 2
    var pending = try inlet.post(body: &msg, len: 1) catch {
        print("SOS abandon: second post failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let dropped = try take_one(&outlet) catch {
        print("SOS abandon: second take failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = move dropped

    // The resolve does not park here, and that is the arm's point: a claim
    // whose obligation was dropped is terminal, not pending, so the op finishes
    // with `PeerClosed` instead of blocking on an answer nobody can write. The
    // move is the consume.
    match (move pending).resolve() {
        case Ok(_) -> {
            let _ = system.debug_print("SOS abandon: a reply arrived from nobody\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
        case Err(e) -> { print("SOS abandon: resolve says {}\n", e) },
    }

    // Arm three, the server end goes while the message is still staged. Its
    // obligation was never minted and now never can be, so the claim is
    // abandoned by a server that never existed. It uses a second connection
    // because this arm kills an end.
    let other = try proc.pipe_create() catch {
        print("SOS abandon: second create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (client, server) = move other

    msg[0] = 3
    var orphan = try client.post(body: &msg, len: 1) catch {
        print("SOS abandon: staged post failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The last outlet handle goes, so nobody can ever take what is staged and
    // the claim on it is owed an answer it will never get. The kernel derives
    // that from the connection's outlet column, not from a flag: a staged
    // exchange with no server end is an abandoned one.
    let _ = move server

    match (move orphan).resolve() {
        case Ok(_) -> {
            let _ = system.debug_print("SOS abandon: a dead outlet answered\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
        case Err(e) -> { print("SOS abandon: staged claim says {}\n", e) },
    }

    print("SOS abandon: done\n")
    let _ = proc.exit(EXIT_OK)
}

/// Take one message and hand its obligation back, refusing an empty ring as an
/// error — every take here has a message waiting by construction.
func take_one(outlet: &PipeOutlet) -> Result<PipeRequest, SosStatus> {
    let got = try outlet.take()
    let (_, request) = move got
    return move request
}
