// Child that touches memory its image never declared; `map-into-child`'s other
// half.
//
// Every address this program touches outside its own image is a gift. Its
// sosimg declares its segments and its kernel grants a stack; the pool page it
// writes below is in its domain for exactly one reason: its launcher installed
// a protection row there before starting it. A child that reaches for such an
// address without a row dies (`process_isolation` is that case); what a row
// changes is that one can be installed deliberately.
//
// It bootstraps exactly as root does (§12's symmetry): a System handle in its
// first argument register, its own Process handle derived from it. The handle
// it got is a masked sibling of root's, `Debug | ProcessSelf | Transfer` and
// nothing else, so it can print and learn which process it is, and can neither
// stop the machine nor spawn.
//
// The exit code is the byte it read back, so root asserts the round trip
// through the §8 status word as well as through the console.

import sos.{System, Process, SosStatus}

extern "C" {
    func sos_test_pool_base() -> UInt
}

static EXIT_FAILED: UInt = 1

/// The byte this child writes. A number that appears nowhere else in the
/// transcript, so a line carrying it can only have come from here.
static MARK: UInt8 = 0x3C

func poke(addr: UInt, value: UInt8) unsafe {
    UnsafeMemory<UInt8, Normal>(addr).write(value)
}

func peek(addr: UInt) unsafe -> UInt8 {
    UnsafeMemory<UInt8, Normal>(addr).read()
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS childtouch: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The mapped page. Nothing in this process's own boot set names it (the
    // child was given no regions at all), so the only thing that makes this
    // address reachable is the row its launcher installed.
    let base = sos_test_pool_base()
    poke(base, MARK)
    let seen = peek(base)
    print("SOS childtouch: wrote {} read {}\n", MARK as Int, seen as Int)

    let _ = proc.exit(seen as UInt)
}
