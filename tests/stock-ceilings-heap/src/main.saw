// A child of the gate's stock-root image `tests/images/stock_ceilings.toml`
// on the riscv32 `virt` board, written with `main`, whose declaration lists
// only the rights a program with a heap spends (`process.toml`, which the
// image builder holds to what the runtime needs): its start-up adopts the
// heap's pool, and the heap grows from it, past its built-in heap, with
// `Memory` and `Mapping` handles the ceilings leave exactly the rights the
// growth reads.

import sos.{Heap, HeapRefusal, SosStatus}
import sosmain

func main() -> Result<Void, SosStatus> {
    var grown = Vector<UInt8, Heap<0>>()
    var pushed: UInt = 0
    while pushed < 0x2000 {
        try grown.push(7u8) catch {
            break
        }
        pushed = pushed + 1
    }
    let info = Heap<0>().info()
    print("SOS ceilheap: the heap grew from its pool: {}",
          if pushed == 0x2000 && info.size > 0 { "yes" } else { "no" })
    print("SOS ceilheap: it was never refused: {}",
          if info.refusal == HeapRefusal.Never { "yes" } else { "no" })
    return
}
