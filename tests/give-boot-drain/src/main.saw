// SOS M3 unit 3: MINT, GIVE, START (sawos design 4 as ruled Aug 29; spec §3,
// §12).
//
// **THE MONEY SHOT, AND IT IS THREE ORDINARY OPS.** Root narrows its own
// authority into a sibling handle, hands the sibling to a child under a tag,
// runs the child naming that tag, and KEEPS the Process handle it supervises
// with. The transcript is read as an ORDER:
//
//   SOS givedrain: created                  <- a process exists, inert, table EMPTY
//   SOS givedrain: minted a masked System   <- narrowed BEFORE anything travels
//   SOS givedrain: gave 7 3 5               <- three capabilities, three tags
//   SOS givedrain: started
//   SOS childdrain: n=2 tags=35 kinds=0     <- THE CHILD'S OWN VOICE
//   SOS: process exit: code=2               <- ...and the kernel's account of it
//   SOS: process teardown ... process=1
//   SOS givedrain: root observed child status=65538
//   SOS givedrain: done
//
// WHAT EACH LINE RULES OUT.
//
// `minted a masked System` is `MINT_OP` with a KEEP MASK: the sibling gets
// `Debug | ProcessSelf | ClockGet | Transfer` and nothing else, because a mint's
// rights are the source's INTERSECTED with the mask. `Shutdown`, `ProcessCreate`
// and `Mint` are absent BY SILENCE — which is the polarity ruling working: a
// mask written today denies a System right added tomorrow, where a removal mask
// would have handed every future capability to every child. (`Transfer` is in
// the mask because it is the bit `give` checks on the thing being given; see the
// finding recorded at `CHILD_SYSTEM`.)
//
// `gave 7 3 5` before the start is the FREEZE: the boot set is complete at the
// child's first instruction because `start` is the barrier, and a give after it
// is `BadState` (`give_after_start` proves it). No synchronization is invented
// anywhere — the ordering IS the argument.
//
// **THE CHILD DRAINS TWO RECORDS, NOT THREE, AND THAT IS A RULING.** Resolving
// the boot tag CONSUMES the record it names: the register is the delivery. So
// the child meets 3 and 5 and never meets 7, and there is no way for one word to
// reach it through two doors and be released twice.
//
// **`SOS childdrain:` IS THE FIRST TIME ANYTHING BUT ROOT HAS SPOKEN.** The
// child owns no device; `Debug` travelled in the mask, which is what a
// capability is for.
//
// **AND ROOT STILL SUPERVISES.** `status=65538` is `Exited` (1) in the high half
// and the drain count (2) in the low, read through the Process handle root NEVER
// GAVE AWAY. Both halves at once — the child manages itself, root watches — is
// exactly what the mint bought: before it there was one Process handle per child
// and a launcher had to choose.
//
// THE TAGS ARE THE ONLY THING THE TWO PROGRAMS SHARE. 7, 3 and 5 mean what this
// file and `child-drain` agree they mean; the kernel hands each back unread and
// interprets none of them.
//
// ROOT PARKS ON A GENEROUS TIMER while the child runs, so the ordering above is
// forced rather than raced: this image's kernel arms no scheduler tick, so the
// only way root gives the processor up is the wait below.

import sos.{System, Process, Memory, BootHandle, Clock, ClockType, Timer,
            Waiter, SosStatus, SystemRight}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// The key this case attaches its timer under. A number that appears nowhere
/// else in the transcript.
static KEY: UInt = 77

/// Twenty milliseconds — three orders of magnitude more than the child needs to
/// be scheduled, drain two records, print and exit. See `process_lifecycle`.
static PARK_NS: UInt64 = 20_000_000

/// ROOT'S CONFIG, and the whole of the contract with the child. These are words
/// root chose; `child-drain` expects exactly them, in exactly this order, and
/// the kernel supplies no meaning for any of them.
static TAG_BOOT: UInt = 7
static TAG_IMAGE: UInt = 3
static TAG_RAM: UInt = 5

/// **THE POLICY, AND IT IS A WHITELIST.** What a child of this launcher may ask
/// its System object for: print, learn its own Process object, read the clock.
/// Everything else — stopping the machine, spawning, passing the handle on,
/// minting a wider one — is absent because it is not named, which is what makes
/// a keep mask fail CLOSED as the System object grows.
///
/// **`Transfer` IS IN THE MASK BECAUSE IT IS THE TICKET TO TRAVEL, and that is a
/// FINDING rather than a preference.** `give` checks the universal `Transfer`
/// bit on the handle BEING GIVEN, so a sibling minted without it cannot be
/// handed to anyone — which means a launcher cannot narrow BELOW the bit that
/// lets the narrowed thing arrive. The child therefore holds `Transfer` too and
/// could pass its System handle on; today that is inert (it has no
/// `ProcessCreate`, so there is no process for it to furnish, and no pipe to
/// send over until M4). `give_no_transfer` is the same constraint seen from the
/// refusing side. Closing it properly wants a ruling — a give that CONSUMES the
/// bit, or a strip-on-arrival rule — and both would amend D-1's rights-verbatim
/// sentence, so neither is taken here.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.ClockGet | SystemRight.Transfer)

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS givedrain: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The boot set, drained in ordinal order: row 0 is the child's image blob,
    // row 1 is the RAM it will run in. Root's config is what says which is
    // which, exactly as in every unit-2 case.
    var image = try proc.boot_handle_next() catch {
        print("SOS givedrain: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS givedrain: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS givedrain: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS givedrain: created\n")

    // **THE MINT.** Root narrows its own authority into a SIBLING — a second
    // handle onto the same System object, in root's own table, carrying the
    // intersection of root's rights and the mask above. Root's original is
    // untouched, which is what makes the next three lines possible at all.
    let for_child = try system.mint(rights: CHILD_SYSTEM) catch {
        print("SOS givedrain: mint failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS givedrain: minted a masked System\n")

    // **THE GIVES.** Each CONSUMES its wrapper — the transfer funnel's contract
    // (design 3 D-5) — so there is no way to touch any of the three below this
    // point: the funnel disarms the value before the syscall and lets it drop.
    // What root gives away it cannot keep.
    match child.give(system: move for_child, tag: TAG_BOOT) {
        case Ok(_) -> {},
        case Err(e) -> {
            print("SOS givedrain: give system failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    // The two regions the child does not actually need — its image was copied
    // into its RAM at create, and it declines both at the drain. They are here
    // because they are CAPABILITIES: what a launcher furnishes is a matter of
    // config rather than of mechanism, and the drain is what proves the order.
    match child.give(memory: move image_mem, tag: TAG_IMAGE) {
        case Ok(_) -> {},
        case Err(e) -> {
            print("SOS givedrain: give image failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    match child.give(memory: move dest_mem, tag: TAG_RAM) {
        case Ok(_) -> {},
        case Err(e) -> {
            print("SOS givedrain: give ram failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    print("SOS givedrain: gave {} {} {}\n", TAG_BOOT, TAG_IMAGE, TAG_RAM)

    // **THE START, naming the boot tag.** The kernel resolves 7 to the
    // child-side word, puts it in the child's first argument register, and marks
    // that record delivered — so root never sees a child-relative word at any
    // point and the child never meets one twice.
    match child.start(boot_tag: TAG_BOOT) {
        case Ok(_) -> {},
        case Err(e) -> {
            print("SOS givedrain: start failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    let _ = system.debug_print("SOS givedrain: started\n")

    // Park, so the child gets the processor. Everything below happens after the
    // child has lived, drained, printed and exited.
    let clock = try system.clock_get(type: ClockType.Monotonic) catch {
        print("SOS givedrain: no clock: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let waiter = try proc.waiter_create() catch {
        print("SOS givedrain: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let timer = try clock.timer_create() catch {
        print("SOS givedrain: no timer: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    match waiter.add(&timer, KEY) {
        case Ok(_) -> {},
        case Err(e) -> {
            print("SOS givedrain: attach failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    match timer.arm(after_ns: PARK_NS) {
        case Ok(_) -> {},
        case Err(e) -> {
            print("SOS givedrain: arm failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    match waiter.wait() {
        case Ok(_) -> {},
        case Err(e) -> {
            print("SOS givedrain: wait failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }

    // **AND ROOT ASKS.** The Process handle root kept is what makes this line
    // writable: the child managed itself with authority root minted, and root
    // watched. `65538` is `Exited` in the high half and the child's drain count
    // in the low — the same fact the console line above states, arriving as a
    // VALUE through the supervision path.
    let status = try child.get_status() catch {
        print("SOS givedrain: status failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS givedrain: root observed child status={}\n", status)

    print("SOS givedrain: done\n")
    let _ = proc.exit(EXIT_OK)
}
