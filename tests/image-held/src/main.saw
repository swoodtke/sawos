// A child running out of its image holds the image's bytes until its teardown
// (spec §5.6, §12).
//
// The case's one child is hand-assembled (`tests/<arch>/child_inplace.S`): a
// header and one R+X segment linked at the address of its own bytes, so the
// loader uses it in place, then filler out to the blob row's end. The child
// prints `SOS-H` and exits with `CHILD_MARK`; it has no segment the loader
// copies, only the stack the kernel grants in its destination.
//
// The blob's row is a pool. Root allocates the image off the front of it and
// launches the child from that allocation, then releases its handle on it
// before the child runs. The pool serves the next allocation from its free
// list first and its frontier second, so what the next allocation holds says
// whether the image's bytes went back:
//
//   SOS imageheld: launched from the image, its handle released
//   SOS imageheld: the next allocation is filler: the bytes are held
//                      while the child runs
//   SOS-H                                    the child, running in place
//   SOS imageheld: the child exited from its image
//   SOS imageheld: after the teardown the next allocation is the image
//   SOS-H                                    a second child from it
//   SOS imageheld: done

import sos.{System, Process, Pool, SosStatus, SystemRight}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.NoResource

/// The front of the blob that holds the image: `child_inplace.S` places its
/// header and code inside it and fills the blob with zeros behind it.
static PIECE: UInt = 0x100

static TAG_BOOT: UInt = 21
static KEY_DEATH: UInt = 6

/// What the child may ask its System object for: printing, and its own
/// Process handle to exit through; `Transfer` is what lets root give it.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// The child's exit code, and the §8 status word it makes: `Exited` in the
/// high half and the code in the low.
static CHILD_MARK: UInt = 0x48
static EXITED_MARK: UInt = 65608

static_assert((1 * 65536) + 0x48 == 65608,
              "an exit's status word is Exited in the high bits and the code")

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS imageheld: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&system, &proc) catch {
        print("SOS imageheld: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS imageheld: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var blob_rec = try proc.boot_handle_next()
    var ram_rec = try proc.boot_handle_next()
    guard let blob = blob_rec.take_pool() else { return BUG }
    guard let ram = ram_rec.take_memory() else { return BUG }

    let first = try blob.allocate(len: PIECE)
    let child = try system.process_create(image: &first, memory: &ram)
    let _ = move first
    try start(&system, &child)
    let _ = system.debug_print(
        "SOS imageheld: launched from the image, its handle released\n")

    // The child has not run yet: root keeps the processor until it blocks.
    // Were the image's bytes back in the pool, this would be the image.
    let second = try blob.allocate(len: PIECE)
    match system.process_create(image: &second, memory: &ram) {
        case Ok(_) -> {
            let _ = system.debug_print(
                "SOS imageheld: the image came back while it runs\n")
            return BUG
        },
        case Err(e) -> {
            if e != SosStatus.BadImage { return e }
        },
    }
    let _ = system.debug_print(
        "SOS imageheld: the next allocation is filler: the bytes are held\n")

    try wait_exit(&proc, &child)
    let _ = system.debug_print(
        "SOS imageheld: the child exited from its image\n")

    // The teardown dropped the child's rows, so the image's bytes are back on
    // the pool's free list, which serves this allocation. `second` is still
    // held, so the free list has nothing else to give.
    let third = try blob.allocate(len: PIECE)
    let again = try system.process_create(image: &third, memory: &ram)
    let _ = system.debug_print(
        "SOS imageheld: after the teardown the next allocation is the image\n")
    try start(&system, &again)
    try wait_exit(&proc, &again)
    let _ = move second
    return
}

/// Give `child` a System handle it may print and exit through, and start it.
func start(system: &System, child: &Process) -> Result<Void, SosStatus> {
    let boot = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move boot, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try child.start(boot_tag: TAG_BOOT)
    return
}

/// Wait for `child` to end and require that it exited with `CHILD_MARK`.
func wait_exit(proc: &Process, child: &Process) -> Result<Void, SosStatus> {
    let waiter = try proc.waiter_create()
    try waiter.add(process: &child, key: KEY_DEATH)
    let wake = try waiter.wait()
    let (key, what) = (move wake).open()
    match what {
        case Process(status) -> {
            if key != KEY_DEATH { return BUG }
            if status != EXITED_MARK {
                print("SOS imageheld: the child ended with status {}\n", status)
                return BUG
            }
        },
        case _ -> { return BUG },
    }
    return
}
