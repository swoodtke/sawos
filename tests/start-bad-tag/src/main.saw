// A boot tag that names nothing is a fault.
//
// `start(boot_tag:)` asks the kernel to resolve a tag against the child's boot
// set and put the child-side word in its first argument register. A tag no give
// ever used resolves to nothing, and there is no honest value to put there: a
// zero would be indistinguishable from the deliberate no-tag form (the
// sandboxed compute process), so a child started with a typo would silently
// become a sandbox instead of failing.
//
//   SOS badtag: gave tag 3
//   SOS: process fault: argument outside its domain process=0
//   SOS: process teardown ... process=0
//
// It is a fault and not a status because the caller can check it: the launcher
// wrote both the tag it gave and the tag it started with, and no resource is
// involved in the disagreement between them.
//
// The give is what makes the case sharp. With a record in the set, "the tag
// resolved to nothing" cannot be confused with "there was nothing to resolve
// against": tag 3 is there, and 9 is not.
//
// Zero is not the "no tag" sentinel; `start` takes a form argument instead.
// Root's own boot regions are tagged with ordinals starting at 0, so zero is a
// legitimate tag.

import sos.{System, Process, Memory, BootHandle, SosStatus}

static EXIT_FAILED: UInt = 1

/// The tag root gives.
static TAG_GIVEN: UInt = 3

/// The tag root starts with. It is not `TAG_GIVEN`, and that is the whole case.
static TAG_WRONG: UInt = 9

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS badtag: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    var image = try proc.boot_handle_next() catch {
        print("SOS badtag: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS badtag: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS badtag: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    match child.give(memory: move image_mem, tag: TAG_GIVEN) {
        case Ok(_) -> {
            print("SOS badtag: gave tag {}\n", TAG_GIVEN)
        },
        case Err(e) -> {
            print("SOS badtag: give failed: {}\n", e.0)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }

    // The set holds tag 3 and nothing else, so this resolves to nothing and does
    // not return.
    let _ = child.start(boot_tag: TAG_WRONG)

    let _ = system.debug_print("SOS badtag: survived, which is the bug\n")
    let _ = system.shutdown(EXIT_FAILED)
}
