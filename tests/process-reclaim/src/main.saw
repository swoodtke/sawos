// A dead process gives its body back at its teardown, while the handle onto it
// is still held (spec §2.7). What the handle keeps is the record, and the
// record comes back when the last handle onto it does.
//
// The transcript is read as an order:
//
//   SOS reclaim: started
//   SOS: process fault: bad handle process=1     <- the child, dying
//   SOS: process teardown ... process=1
//   SOS reclaim: body_back_while_held=1
//   SOS reclaim: done
//
// `body_back_while_held=1` is the body half. With the child dead and root still
// holding its Process handle, a filler process, created and never started,
// takes the lowest free body, which is the dead child's own. A second create
// then needs one more body, and with `MAX_PROCESSES` bodies there is one only
// because the dead child's went back at its teardown and only its record is
// held. A kernel whose dead processes kept their bodies refuses that create.
// The proof is written against "the table is full" rather than against a
// number.
//
// The record half is `process-records`, which holds dead processes until the
// record table refuses a create, releases them, and fills it again: at this
// scale the record table is too large to fill.
//
// Root parks on a generous timer while the child runs, so the ordering above
// is forced rather than raced: this image's kernel arms no scheduler tick, so
// the only way root gives the processor up is the wait, and the only way it
// gets it back is the timer it armed.

import sos.{System, Process, Memory, BootHandle, Clock, ClockType, Timer,
            Waiter, SosStatus}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// The key this case attaches its timer under.
static KEY: UInt = 88

/// Twenty milliseconds, three orders of magnitude more than the child needs to
/// be scheduled, run its one syscall and die. See `process-lifecycle`.
static PARK_NS: UInt64 = 20_000_000

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS reclaim: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // Row 0 is the child's image blob, row 1 the RAM it runs in: this build's
    // config, which is root's business and never the kernel's.
    var image = try proc.boot_handle_next() catch {
        print("SOS reclaim: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS reclaim: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The record hands the region over; see `process-lifecycle` for why
    // `take_memory` is the one way out. Both regions are used three times here,
    // which is why they are taken into locals: the later processes are loaded
    // from the same image into the same RAM, the first child's remains being
    // nothing the kernel tracks.
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS reclaim: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try child.start() catch {
        print("SOS reclaim: start failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS reclaim: started\n")

    // Park, so the child gets the processor and dies before anything below runs.
    let clock = try system.clock_get(type: ClockType.Monotonic) catch {
        print("SOS reclaim: no clock: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let waiter = try proc.waiter_create() catch {
        print("SOS reclaim: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let timer = try clock.timer_create() catch {
        print("SOS reclaim: no timer: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = waiter.add(&timer, KEY)
    let _ = timer.arm(after_ns: PARK_NS)
    try waiter.wait() catch {
        print("SOS reclaim: wait failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The filler: a create, never started, which takes the lowest free body,
    // the dead child's own. It is the same image into the same RAM as the child
    // that has already died; the first child's remains are nothing the kernel
    // tracks.
    let filler = try system.process_create(image: &image_mem,
                                           memory: &dest_mem) catch {
        print("SOS reclaim: filler create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // Root and the filler hold a body each, and the dead child is still held.
    // The body table has one more only if the dead child's body went back.
    let after = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS reclaim: body_back_while_held=0 ({})\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS reclaim: body_back_while_held=1\n")

    // The handles go here, with root's exit next. Releasing a never-started
    // process's last handle tears it down. The dead child's handle goes last,
    // which is the ordinary release of a `Gone` record.
    let _ = move after
    let _ = move filler
    let _ = move child
    print("SOS reclaim: done\n")
    let _ = proc.exit(EXIT_OK)
}
