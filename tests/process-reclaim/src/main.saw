// A dead process's slot comes back when the last handle onto it does.
//
// The transcript is read as an order, and the two flags are the two sides of
// one claim:
//
//   SOS reclaim: started
//   SOS: process fault: bad handle process=1     <- the child, dying
//   SOS: process teardown ... process=1
//   SOS reclaim: refused_before=1 reclaimed_after=1
//   SOS reclaim: done
//
// `refused_before=1` is the half that is easy to lose. With the child dead but
// root still holding its Process handle, a create with the table otherwise
// full must be refused: the dead slot is `Gone`, not `Free`, because the §8
// status word in it still has a possible reader. Asserting the refusal stops
// this case from passing on a kernel that reclaimed slots eagerly and lost the
// supervision story.
//
// "The table otherwise full" is something this case has to arrange.
// With `MAX_PROCESSES` slots, root plus a dead child can leave a slot free and
// the refusal would not happen. The case creates an unstarted filler process
// to spend it, which is why the proof is written against "the table is full"
// rather than against a number.
//
// `reclaimed_after=1` is the point of the case. Root drops the child's handle
// (no method call, just a value going out of scope, which is what `NoCopy` +
// `deinit` makes a release) and the create that was refused a moment ago now
// succeeds. Between the two calls the only thing that changed is that no
// handle anywhere names slot 1 any more, which is precisely the reader-count
// the reclaim asks for.
//
// Why a reader-count at all, since it reads like bookkeeping: the only thing a
// `Gone` slot still holds is its §8 status word, and that word is read only
// through a counted reference to the slot: a Process handle (`GetStatus`) or
// an attachment (a wait). The reclaim tests that count (`refs`), so a slot
// with no reference has no possible reader.
//
// Generations make the reuse safe. The second child lands in the slot the
// first one had; a word onto the first child would now name a live slot at the
// wrong life and resolve to nothing. Nothing in this case can hold such a
// word (the typed layer has no word extractor), so the stale-word half of the
// claim is `handle-remint`'s, made where words are visible.
//
// Root parks on a generous timer while the child runs, so the ordering above
// is forced rather than raced: this image's kernel arms no scheduler tick, so
// the only way root gives the processor up is the wait, and the only way it
// gets it back is the timer it armed.

import sos.{System, Process, Memory, BootHandle, Clock, ClockType, Timer,
            Waiter, SosStatus}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

static YES: UInt = 1
static NO: UInt = 0

/// The key this case attaches its timer under.
static KEY: UInt = 88

/// Twenty milliseconds, three orders of magnitude more than the child needs to
/// be scheduled, run its one syscall and die. See `process-lifecycle`.
static PARK_NS: UInt64 = 20_000_000

func flag(b: Bool) -> UInt {
    if b { YES } else { NO }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS reclaim: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // Row 0 is the child's image blob, row 1 the RAM it runs in: this build's
    // config, which is root's business and never the kernel's.
    var image = try proc.boot_handle_next() catch {
        print("SOS reclaim: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS reclaim: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The record hands the region over; see `process-lifecycle` for why
    // `take_memory` is the one way out. Both regions are used twice here, which
    // is why they are taken into locals: the second child is loaded from the
    // same image into the same RAM, the first child's remains being nothing
    // the kernel tracks.
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS reclaim: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try child.start() catch {
        print("SOS reclaim: start failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS reclaim: started\n")

    // Park, so the child gets the processor and dies before anything below runs.
    let clock = try system.clock_get(type: ClockType.Monotonic) catch {
        print("SOS reclaim: no clock: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let waiter = try proc.waiter_create() catch {
        print("SOS reclaim: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let timer = try clock.timer_create() catch {
        print("SOS reclaim: no timer: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = waiter.add(&timer, KEY)
    let _ = timer.arm(after_ns: PARK_NS)
    try waiter.wait() catch {
        print("SOS reclaim: wait failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The filler. This case's claim is about a `Gone` slot being unavailable
    // while a reader can still name it. That is only observable when the table
    // has nothing else to give, so the proof needs a live process in the
    // remaining slot: a create, never started, occupying the slot a further
    // process would otherwise take.
    //
    // It is the same image into the same RAM as the child that has already
    // died; the first child's remains are nothing the kernel tracks. Nothing
    // runs in this process: a created-and-unstarted slot holds a domain and no
    // thread, which is exactly the resource this case is about.
    let filler = try system.process_create(image: &image_mem,
                                           memory: &dest_mem) catch {
        print("SOS reclaim: filler create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // Before the release: the slot is `Gone`, not `Free`, because root's handle
    // onto it keeps the §8 status word readable. With root, the filler and the
    // dead child's slot there is nowhere for this create to go, so it is
    // refused with a status: the caller could not have known the table was
    // full, so this is not a fault.
    let refused_before = match system.process_create(image: &image_mem,
                                                     memory: &dest_mem) {
        case Ok(_) -> false,
        case Err(_) -> true,
    }

    // The release, written as a drop. `let _ = move child` consumes the wrapper
    // and its `deinit` issues the release; there is no typed `release()`
    // method, because dropping is the spelling. With that entry unbound, no
    // handle in any process's table names slot 1, so the kernel's reclaim scan
    // frees it.
    let _ = move child

    let reclaimed_after = match system.process_create(image: &image_mem,
                                                      memory: &dest_mem) {
        case Ok(_) -> true,
        case Err(_) -> false,
    }

    print("SOS reclaim: refused_before={} reclaimed_after={}\n",
          flag(refused_before), flag(reclaimed_after))
    // The filler's handle is kept to the end on purpose. Releasing it would
    // leave a `Created` slot nothing names, and `reclaim_process_slot` frees
    // only `Gone` slots, because a slot that never ran has no §8 status word to
    // decide readability by. Holding the handle keeps this case's arithmetic
    // honest and avoids provoking a state this case does not cover.
    print("SOS reclaim: done\n")
    let _ = proc.exit(EXIT_OK)
}
