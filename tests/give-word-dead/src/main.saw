// The giver's word is dead after a give: using it faults with "bad handle".
//
// A give is unbind-and-rebind, and the unbind is `unbind_handle`, the same
// function a release and a teardown call, generation bump included. So the
// moment a give returns, the word the giver held names a live slot at the wrong
// life, resolves to nothing, and using it is the ordinary `BadHandle` fault:
//
//   SOS worddead: gave the region, ok=1
//   SOS worddead: using the word we gave away
//   SOS: process fault: bad handle process=0
//   SOS: process teardown ... process=0
//
// Without generations this would be an alias rather than a diagnosis. The slot
// the give freed is the lowest free one, so the very next mint takes it back,
// and a kernel whose words carried no generation would resolve the giver's
// stale word onto whatever landed there. `handle-remint` makes the same claim
// about release; this makes it about the other way a handle leaves a table.
//
// It goes through the C altitude, and that is half the claim. The typed Saw
// surface has no word extractor and no word constructor, and `Process.give`
// consumes its wrapper and disarms it before the syscall, so "use the word you
// gave away" is not a sentence that layer can express. This file works one
// storey down, as `handle-remint` and `timer-badclock` do.
//
// The record layout is written out here, deliberately. Three machine words
// (tag, kind, handle) is the published contract of
// `sos_process_boot_handle_next`, and a caller at the C altitude supplies the
// buffer and its capacity itself. Naming the constants would mean importing the
// kernel-internal `sosabi`, which the vDSO discipline forbids; a C caller
// writes the numbers, and so does this file.

import sos.{System, SosStatus, sos_system_process_self, sos_process_boot_handle_next,
            sos_system_process_create, sos_process_give, sos_handle_release}

static EXIT_FAILED: UInt = 1

/// The keep mask `ProcessOp.Give` and `SystemOp.ProcessSelf` take; all-ones
/// keeps every right. A number because this file works at the C altitude, where
/// a rights mask is one.
static KEEP_ALL: UInt = 0xFFFF_FFFF

/// The status word a successful op answers with (`SosStatus.Ok`), as a number
/// for the same reason.
static STATUS_OK: UInt = 0

/// The boot-handle record: tag, kind, handle. See the header for why the layout
/// is written here rather than imported.
static RECORD_WORDS: Int = 3
static RECORD_HANDLE_WORD: Int = 2

/// The tag root gives the region under. Any word would do; the kernel
/// interprets none of them.
static TAG: UInt = 3

static YES: UInt = 1
static NO: UInt = 0

func flag(b: Bool) -> UInt {
    if b { YES } else { NO }
}

// Each pointer lives in one small named helper, which keeps `_start` a safe
// signature: a value comes back through an out-parameter (the shape a C ABI
// with no aggregate return has), and the pointer never leaves the function that
// made it. Every helper answers 0, the word that names nothing, when the call
// was refused.

/// This process's own Process handle, as a raw word.
func ask_process(handle: UInt) unsafe -> UInt {
    var out: UInt = 0
    // Keep every right.
    let status = sos_system_process_self(handle, KEEP_ALL,
                                         (&var out) as UnsafePointer<UInt>)
    if status != STATUS_OK {
        return 0
    }
    out
}

/// A child loaded from `image` into `ram`, as a raw Process handle word.
func make_child(system: UInt, image: UInt, ram: UInt) unsafe -> UInt {
    var out: UInt = 0
    let status = sos_system_process_create(system, image, ram,
                                           (&var out) as UnsafePointer<UInt>)
    if status != STATUS_OK {
        return 0
    }
    out
}

/// Take the next boot record, answering the raw handle word it carries, or 0,
/// which names nothing, when the set is drained.
func next_region_word(process: UInt) unsafe -> UInt {
    var buf: [UInt; RECORD_WORDS] = [0; RECORD_WORDS]
    let bytes = (RECORD_WORDS * sizeof<UInt>()) as UInt
    let status = sos_process_boot_handle_next(process,
                                              (&var buf) as UnsafePointer<UInt>,
                                              bytes)
    if status != STATUS_OK {
        return 0
    }
    buf[RECORD_HANDLE_WORD]
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let process = ask_process(boot_handle)
    if process == 0 {
        let _ = system.debug_print("SOS worddead: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The two boot regions, as words. Row 0 is the child's image blob and row 1
    // is the RAM it will run in, per root's config.
    let image = next_region_word(process)
    let ram = next_region_word(process)
    if image == 0 || ram == 0 {
        let _ = system.debug_print("SOS worddead: boot regions missing\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let child = make_child(boot_handle, image, ram)
    if child == 0 {
        let _ = system.debug_print("SOS worddead: create refused\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The give. It answers a status and nothing else (the child-side word is
    // meaningless to root, which can call no op through it), so `image` below
    // is the only word this program has for that region, and it is now
    // worthless.
    let gave = sos_process_give(child, image, TAG, KEEP_ALL)
    print("SOS worddead: gave the region, ok={}\n", flag(gave == STATUS_OK))
    if gave != STATUS_OK {
        let _ = system.shutdown(EXIT_FAILED)
    }

    // The old word. Its slot is the lowest free index, so the next mint would
    // take it, but its generation moved when the entry was unbound, so this
    // word names nothing and the kernel ends this process. `release` is the
    // shortest op that takes a bare word; the fault would be the same through
    // any of them.
    let _ = system.debug_print("SOS worddead: using the word we gave away\n")
    let _ = sos_handle_release(image)

    let _ = system.debug_print("SOS worddead: survived, which is the bug\n")
    let _ = system.shutdown(EXIT_FAILED)
}
