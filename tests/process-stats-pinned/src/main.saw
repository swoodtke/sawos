// A process's `pinned` column, in its stats, its row of the stats region and
// its record at its death (spec §2.7).
//
//   SOS statspin: nothing pinned: 0 0
//   SOS statspin: one page pinned: 4096 4096
//   SOS statspin: two pages pinned: 8192 8192
//   SOS statspin: the first unpinned: 4096 4096
//   SOS statspin: the second unpinned: 0 0
//   SOS statspin: first child: given while pinned: 4096
//   SOS pinleg: the given page's unpin: served
//   SOS pinleg: its pin: served
//   SOS pinleg: a second pin
//   SOS: process fault: object in the wrong state process=<n>
//   SOS statspin: first child: ended status=131077
//   SOS statspin: first child: the unpin lowered the pinner's column: 0
//   SOS statspin: first child: the dead child's record: pinned 4096
//   (the same lines again, for the second child)
//   SOS pinleg: pinned the given sibling
//   SOS statspin: dead pinner: ended status=65543
//   SOS statspin: dead pinner: pool pinned 12288 quarantined 8192
//   SOS statspin: dead pinner: after the unpin, pool pinned 8192
//   SOS statspin: dead pinner: after the unpin, launcher column 0
//   SOS statspin: dead pinner: after the unpin, record pinned 4096
//   SOS statspin: done
//
// Each pair is the `Process.stats()` answer and the region row's, which read
// one storage. Root pins and unpins two pages, so the column rises and falls
// by each page's length. It then pins a third and gives its only handle to
// `child-pin-leg`, which unpins it (the column is the pinner's, not the
// unpinner's: root's falls to zero and the child's has nothing to lower),
// pins it again and is ended by a second pin. The child's record, read through
// its handle after its death, keeps the page it left pinned. A second child,
// run in the body the first left, starts from a zeroed column and so ends with
// the same record. Each of those two pages is quarantined at its child's
// death, and the pool counts both beside the third page, which a handle of
// root's still names.

import sos.{System, Process, Memory, Pool, SosStatus, SystemRight,
            StatsRegion}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

static TAG_BOOT: UInt = 31
static TAG_ROLE: UInt = 32
static TAG_MEM: UInt = 34

static KEY_DEATH: UInt = 6

/// The role `child-pin-leg` takes a given page with.
static ROLE_GIVEN: UInt = 3
static ROLE_SIBLING: UInt = 4

static CHILD_SYSTEM: UInt32 = (SystemRight.Transfer | SystemRight.ProcessSelf
                               | SystemRight.Debug)

/// The child's destination: the whole of its region, which is this long on
/// every profile this case runs on.
static REGION_LEN: UInt = 0x4_0000

/// A page: a whole number of grains on every profile.
static PAGE: UInt = 0x1000

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS statspin: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&system, &proc) catch {
        print("SOS statspin: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS statspin: done\n")
    let _ = system.shutdown(EXIT_OK)
}

/// Print this process's `pinned` column through the op and through its row of
/// the stats region.
func say(what: String, proc: &Process,
         region: &StatsRegion) -> Result<Void, SosStatus> {
    let op = try proc.stats()
    print("SOS statspin: {}: {} {}\n", what, op.pinned, region.mine().pinned)
    return
}

/// Create the child, give it its role and its System sibling, and answer it.
func create(system: &System, proc: &Process, image: &Memory, dests: &Pool,
            role: UInt) -> Result<Process, SosStatus> {
    let dst = try dests.allocate(len: REGION_LEN)
    let child = try system.process_create(image: &image, memory: &dst)
    let _ = move dst
    let ev = try proc.event_create()
    try ev.signal(bits: role)
    try child.give(event: move ev, tag: TAG_ROLE) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let boot = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move boot, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    return move child
}

/// Start the child and answer the §8 status word it ends with.
func outlive(proc: &Process, child: &Process) -> Result<UInt, SosStatus> {
    let waiter = try proc.waiter_create()
    try waiter.add(process: &child, key: KEY_DEATH)
    try child.start(boot_tag: TAG_BOOT)
    let wake = try waiter.wait()
    let (key, what) = (move wake).open()
    match what {
        case Process(status) -> {
            if key != KEY_DEATH { return BUG }
            return status
        },
        case _ -> { return BUG },
    }
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var image_rec = try proc.boot_handle_next()
    var dests_rec = try proc.boot_handle_next()
    var pool_rec = try proc.boot_handle_next()
    guard let image = image_rec.take_memory() else { return BUG }
    guard let dests = dests_rec.take_pool() else { return BUG }
    guard let pool = pool_rec.take_pool() else { return BUG }
    let region = try system.stats_region_map()

    try say("nothing pinned", &proc, &region)
    let first = try pool.allocate(len: PAGE, contiguous: true)
    let _ = try first.pin()
    try say("one page pinned", &proc, &region)
    let second = try pool.allocate(len: PAGE, contiguous: true)
    let _ = try second.pin()
    try say("two pages pinned", &proc, &region)
    try first.unpin()
    try say("the first unpinned", &proc, &region)
    try second.unpin()
    try say("the second unpinned", &proc, &region)

    try round("first child", &system, &proc, &image, &dests, &pool)
    // The second child runs in the body the first one left, whose row was
    // zeroed at the create.
    try round("second child", &system, &proc, &image, &dests, &pool)
    try dead_pinner(&system, &proc, &image, &dests, &pool)
    return
}

/// A child pins the page its launcher gave it a sibling of and ends with it
/// pinned. The launcher's handle still names the page, so its unpin is served
/// after the pinner's death: it lowers the pool's pinned bytes and no column,
/// and the dead child's record keeps what it left.
func dead_pinner(system: &System, proc: &Process, image: &Memory,
                 dests: &Pool, pool: &Pool) -> Result<Void, SosStatus> {
    let page = try pool.allocate(len: PAGE, contiguous: true)
    let sibling = try page.mint()
    let child = try create(&system, &proc, &image, &dests, ROLE_SIBLING)
    try child.give(memory: move sibling, tag: TAG_MEM) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let status = try outlive(&proc, &child)
    print("SOS statspin: dead pinner: ended status={}\n", status)
    let before = try pool.available()
    print("SOS statspin: dead pinner: pool pinned {} quarantined {}\n",
          before.pinned, before.quarantined)
    try page.unpin()
    print("SOS statspin: dead pinner: after the unpin, pool pinned {}\n",
          (try pool.available()).pinned)
    print("SOS statspin: dead pinner: after the unpin, launcher column {}\n",
          (try proc.stats()).pinned)
    print("SOS statspin: dead pinner: after the unpin, record pinned {}\n",
          (try child.stats()).pinned)
    return
}

/// Pin a page, give it to a child that unpins it, pins it again and ends, and
/// print what the columns read before and after.
func round(label: String, system: &System, proc: &Process, image: &Memory,
           dests: &Pool, pool: &Pool) -> Result<Void, SosStatus> {
    let page = try pool.allocate(len: PAGE, contiguous: true)
    let _ = try page.pin()
    let child = try create(&system, &proc, &image, &dests, ROLE_GIVEN)
    try child.give(memory: move page, tag: TAG_MEM) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    print("SOS statspin: {}: given while pinned: {}\n", label,
          (try proc.stats()).pinned)
    let status = try outlive(&proc, &child)
    print("SOS statspin: {}: ended status={}\n", label, status)
    print("SOS statspin: {}: the unpin lowered the pinner's column: {}\n",
          label, (try proc.stats()).pinned)
    print("SOS statspin: {}: the dead child's record: pinned {}\n", label,
          (try child.stats()).pinned)
    return
}
