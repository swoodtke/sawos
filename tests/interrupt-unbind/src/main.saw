// A bound line comes back mid-life (spec §9): releasing the only Interrupt
// handle frees its slot and returns the line, so it can be bound again.
//
// An Interrupt's slot is freed when its count reaches zero. If it came back
// only at its process's teardown, the line would stay bound for the process's
// lifetime and a second bind of the same line would be a `LineBound` fault,
// which ends the process. The transcript is therefore the whole claim:
//
//   SOS irqunbind: bound line 5
//   SOS irqunbind: rebound=1              the line was genuinely returned
//   SOS: process teardown ... interrupts={one} ...
//
// The mask is the part that is not bookkeeping. Freeing the slot is half of it;
// the other half is that the kernel takes the line back, exactly as the
// teardown does (§9's handover run backwards). A device the dropping process
// was driving may still be asserting, and an unmasked line with no object
// behind it would be taken, reported and masked once per fire forever. That
// half is not directly observable from userspace, and the rebind stands in for
// it: `interrupt_bind` unmasks on success, so a line that came back masked is
// a line the second bind could arm.
//
// `interrupts={one}` in the teardown is the small statement beside the big one:
// this program bound the same line twice and the kernel holds exactly one
// Interrupt when it ends. Two would mean the first was never reclaimed, and it
// could not be two anyway, because the second bind would have faulted.
//
// The release is spelled as a drop, the typed layer's only spelling for it:
// `let _ = move first` consumes the wrapper and its deinit issues the syscall.
// Nothing here names a handle word.

import sos.{System, Process, Interrupt}

/// A line both machines wire and neither asserts unasked (the choice
/// `irq-earlyack` also makes): nothing can fire between the bind and the
/// release, so the sequence below is forced rather than raced.
static QUIET_LINE: UInt = 5

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS irqunbind: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let first = try proc.interrupt_bind(line: QUIET_LINE) catch {
        print("SOS irqunbind: first bind failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS irqunbind: bound line {}\n", QUIET_LINE)

    // The release. This is the only handle onto the object, so the count
    // reaches zero inside this line: the kernel masks the line and the slot
    // goes back to the slab, both before the next statement runs.
    let _ = move first

    // The proof. A line still bound answers `LineBound`, which is a fault and
    // would end this process without printing anything further. The line below
    // appearing in the transcript at all is the claim.
    let second = try proc.interrupt_bind(line: QUIET_LINE) catch {
        print("SOS irqunbind: rebind refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS irqunbind: rebound=1\n")

    // The second Interrupt is still held here (nothing consumes `second`, and
    // `exit` does not return), so the teardown reclaims exactly one, which is
    // what its count says. Exit rather than shutdown, so that line is printed
    // at all: `shutdown` stops the machine with nothing said.
    let _ = proc.exit(EXIT_OK)
    let _ = system.shutdown(EXIT_FAILED)
}
