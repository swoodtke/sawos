//! A child of the gate's stock-root images: it sends one byte on its
//! connection and prints the answer (`tests/stockkit`).

import stockkit
import stockconfig.{name}

static TAG_PEER: UInt = 2

/// The byte it sends.
static ASKED: UInt8 = 41

@export("_start")
func _start(boot_handle: UInt) {
    stockkit.ask(boot_handle, name(), TAG_PEER, ASKED)
}
