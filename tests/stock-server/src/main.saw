//! A child of the gate's stock-root images: it serves one request on its
//! connection, allocates from its pool and shows its declared `Waiter` row in
//! force (`tests/stockkit`).

import stockkit
import stockconfig.{name}

static TAG_ECHO: UInt = 2
static TAG_SCRATCH: UInt = 3

@export("_start")
func _start(boot_handle: UInt) {
    stockkit.serve(boot_handle, name(), TAG_ECHO, TAG_SCRATCH)
}
