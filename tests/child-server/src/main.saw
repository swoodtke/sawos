// Child server that parks (spec §2.1, §2.2, §12).
//
// It bootstraps like every other child (a masked System handle in its first
// argument register, its own Process object derived from it, its boot set
// drained from there). The set carries one thing: a `PipeOutlet`, the server
// end of a connection its launcher created and wired to itself.
//
// It blocks, and that is the point. It does not poll: it attaches the outlet to
// a Waiter of its own and waits. Its thread is `Blocked` until the launcher's
// message is staged, so the launcher's `post` is what wakes it: §2.2's readable
// arm, proved across a process boundary and through the kernel's own notify
// path rather than through a timer.
//
// Its answer is what unparks the launcher, whose composed `send` is parked on
// the claim at the same moment. The two halves of one round trip are two
// blocked threads in two processes, and each wakes the other exactly once. The
// transcript's ordering is the proof: a poll anywhere in the chain would
// produce the same bytes with none of the parking.
//
// The reply is `PONG` in ASCII, and the launcher asserts all four bytes: a
// status alone would not show that the record's body region carried the data.

import sos.{System, Process, PipeOutlet, PipeRequest, Waiter, WaitResult,
            WaitPayload, OutletLevel, AttachMode, BootHandle, BootHandleKind,
            SosStatus, PIPE_BODY_BYTES}

/// What it ends with when the boot set was not what the config promised. A
/// number the transcript's `code=` field distinguishes on sight.
static EXIT_NO_OUTLET: UInt = 96

/// The reply's length, and the exit code that says how many bytes went.
static PAYLOAD_LEN: UInt = 4

/// How many messages this child answers. Two, because its launcher does the
/// same exchange twice, once as the composition written out of the primitives
/// and once as the fused `send`, and measures both.
static ROUNDS: Int = 2

static KEY: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        print("SOS childserver: no process handle: {}\n", error)
        return
    }

    var outlet: PipeOutlet? = None
    var going = true
    while going {
        match proc.boot_handle_next() {
            case Ok(h) -> {
                var rec = move h
                match rec.kind {
                    case PipeOutlet -> { outlet = rec.take_outlet() },
                    // A record of any other kind is a capability this child was
                    // given and does not want: it drops at the end of this arm
                    // and releases whatever it held.
                    case _ -> {},
                }
            },
            case Err(_) -> { going = false },
        }
    }

    guard let server = move outlet else {
        let _ = system.debug_print("SOS childserver: no outlet in the boot set\n")
        let _ = proc.exit(EXIT_NO_OUTLET)
        return
    }
    let waiter = try proc.waiter_create() catch {
        print("SOS childserver: no waiter: {}\n", error)
        let _ = proc.exit(EXIT_NO_OUTLET)
        return
    }

    try serve(&server, &waiter) catch {
        print("SOS childserver: serve failed: {}\n", error)
        let _ = proc.exit(EXIT_NO_OUTLET)
        return
    }

    // The exit code is the payload's length, so the kernel's account of this
    // process and the launcher's reading of the reply say the same number from
    // the two sides of the boundary.
    let _ = proc.exit(PAYLOAD_LEN)
}

/// Park, take, answer, twice.
///
/// The attach is persistent, which is what a server loop wants: a `OneShot`
/// attachment would detach at the first delivery and the second wait would
/// park on an empty Waiter forever (see `sos.waiter`).
///
/// It answers twice because the launcher measures two spellings of the same
/// exchange, the composition (three traps) and the fused `PipeInlet.send` (one
/// trap). The same server answers the same message once for each, so the two
/// trap counts are comparable: nothing about the server differs between them.
///
/// It prints `replied` after the first turn and nothing after the second.
func serve(outlet: &PipeOutlet, waiter: &Waiter) -> Result<Void, SosStatus> {
    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    var buf: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 80
    msg[1] = 79
    msg[2] = 78
    msg[3] = 71

    try waiter.add(outlet: &outlet, key: KEY)

    var served: Int = 0
    while served < ROUNDS {
        // This blocks. Nothing else in this process is runnable, so the kernel
        // has to find work elsewhere and the launcher's message is what comes
        // back to it.
        let woke = try waiter.wait()
        match woke.what {
            case Readable(_) -> {},
            case _ -> { return SosStatus.Revoked },
        }

        let got = try outlet.take()
        let (_, request) = move got
        let obligation = move request
        try (move obligation).reply(body: &msg, len: PAYLOAD_LEN)
        served = served + 1
        // The one line this child prints, after the first turn. It is
        // freestanding `print` rather than `System.debug_print` because
        // `serve` holds no System handle.
        if served == 1 {
            print("SOS childserver: replied\n")
        }
    }
    return
}
