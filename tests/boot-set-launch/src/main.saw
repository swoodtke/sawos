// A launcher for a child that drains its boot set with `BootSet`. Root
// creates the child from its image and destination rows, gives it a masked
// System handle under the tag it starts it with, then an Event, its own pool
// and a second Event, starts it and waits for its end.
//
// The child is the case's: `child-no-heap` takes every record with no heap
// at all, and `child-set-release` takes one and watches the set release the
// other two. Both read the same three tags, which are this file's and theirs
// and the kernel's nothing.

import sos.{System, Process, BootSet, Waiter, SosStatus, SystemRight}

/// Root's boot set, in the build's row order: the child's image blob, the
/// RAM it runs in, and a pool.
static ROW_IMAGE: UInt = 0
static ROW_DEST: UInt = 1
static ROW_POOL: UInt = 2

/// The tags the child's records travel under.
static TAG_BOOT: UInt = 1
static TAG_EVENT: UInt = 2
static TAG_POOL: UInt = 3
static TAG_SPARE: UInt = 4

/// What the child may ask its System object for: print, and learn its own
/// Process object. `Transfer` is the bit `give` checks on what it gives.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// The key the child's Process is attached under.
static KEY: UInt = 93

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// Print the failed step and stop the machine.
func fail(system: &System, step: String, status: SosStatus) {
    print("SOS bootlaunch: {}: {}\n", step, status)
    let _ = system.shutdown(EXIT_FAILED)
}

/// Print the boot row that was not there and stop the machine.
func missing(system: &System, row: String) {
    print("SOS bootlaunch: no {}\n", row)
    let _ = system.shutdown(EXIT_FAILED)
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)
    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS bootlaunch: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var set = try BootSet(process: &proc) catch {
        fail(&system, "drain", error)
        return
    }
    guard let image_record = set.take(ROW_IMAGE) else {
        missing(&system, "image row")
        return
    }
    guard let dest_record = set.take(ROW_DEST) else {
        missing(&system, "destination row")
        return
    }
    guard let pool_record = set.take(ROW_POOL) else {
        missing(&system, "pool row")
        return
    }
    var image_rec = move image_record
    var dest_rec = move dest_record
    var pool_rec = move pool_record
    let image = image_rec.take_memory()!
    let dest = dest_rec.take_memory()!
    let pool = pool_rec.take_pool()!

    let child = try system.process_create(image: &image, memory: &dest) catch {
        fail(&system, "create", error)
        return
    }
    let for_child = try system.mint(rights: CHILD_SYSTEM) catch {
        fail(&system, "mint", error)
        return
    }
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        fail(&system, "give System", error.0)
        return
    }
    let event = try proc.event_create() catch {
        fail(&system, "event", error)
        return
    }
    try child.give(event: move event, tag: TAG_EVENT) catch {
        fail(&system, "give Event", error.0)
        return
    }
    try child.give(pool: move pool, tag: TAG_POOL) catch {
        fail(&system, "give pool", error.0)
        return
    }
    let spare = try proc.event_create() catch {
        fail(&system, "event", error)
        return
    }
    try child.give(event: move spare, tag: TAG_SPARE) catch {
        fail(&system, "give Event", error.0)
        return
    }
    try child.start(boot_tag: TAG_BOOT) catch {
        fail(&system, "start", error)
        return
    }
    let _ = system.debug_print("SOS bootlaunch: started\n")

    let waiter = try proc.waiter_create() catch {
        fail(&system, "waiter", error)
        return
    }
    try waiter.add(process: &child, key: KEY) catch {
        fail(&system, "attach", error)
        return
    }
    try waiter.wait() catch {
        fail(&system, "wait", error)
        return
    }
    let status = try child.get_status() catch {
        fail(&system, "status", error)
        return
    }
    print("SOS bootlaunch: child status={}\n", status)
    let _ = system.debug_print("SOS bootlaunch: done\n")
    let _ = proc.exit(EXIT_OK)
}
