// An Interrupt has one name, its handle (spec §2.10, §3): `Mint` is absent from
// `interrupt_rights()`, and attenuation is monotonic, so no handle onto an
// Interrupt can ever mint a sibling. The raw `MINT_OP` is the `AccessDenied`
// fault, the same one any handle without `Mint` meets, and it comes from the
// rights check before the object is consulted.
//
// The typed tier has no `Interrupt.mint` to spell it, so this drives the
// C-altitude floor with raw words, as `pipe-reply-wait-self` does. The
// transcript reads:
//
//   SOS irqmint: minting a sibling of an Interrupt
//   SOS: process fault: access denied

import sos.{System, sos_system_interrupt_bind, sos_handle_mint, ALL_RIGHTS}

static EXIT_FAILED: UInt = 1

/// The status word a successful op answers with (`SosStatus.Ok`).
static STATUS_OK: UInt = 0

/// The word that names nothing.
static NONE: UInt = 0

/// A line both machines wire and neither asserts unasked.
static QUIET_LINE: UInt = 5

/// An Interrupt on `line`, bound through `system`, as a raw word, or `NONE`.
func ask_interrupt(system: UInt, line: UInt) unsafe -> UInt {
    var out: UInt = NONE
    let status = sos_system_interrupt_bind(system, line,
                                           (&var out) as UnsafePointer<UInt>)
    if status != STATUS_OK {
        return NONE
    }
    out
}

/// Mint a sibling of `handle` keeping every right, answering the status word.
func mint_all(handle: UInt) unsafe -> UInt {
    var out: UInt = NONE
    sos_handle_mint(handle, ALL_RIGHTS as UInt,
                    (&var out) as UnsafePointer<UInt>)
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let irq = ask_interrupt(boot_handle, QUIET_LINE)
    if irq == NONE {
        let _ = system.debug_print("SOS irqmint: no interrupt\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let _ = system.debug_print("SOS irqmint: minting a sibling of an Interrupt\n")

    // Does not return: the kernel terminates this process.
    let status = mint_all(irq)

    print("SOS irqmint: the mint answered status={}\n", status)
    let _ = system.shutdown(EXIT_FAILED)
}
