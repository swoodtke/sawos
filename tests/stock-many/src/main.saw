// Test child: a stock root's child given many records. It says one line and
// exits with EXIT_CODE; its records go with it.

import sos.{System}

/// The code this child ends with. Only its distinctness matters.
static EXIT_CODE: UInt = 5

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)
    let proc = try system.process_self() catch {
        print("SOS many: no process handle: {}\n", error)
        return
    }
    let _ = system.debug_print("SOS many: exiting\n")
    let _ = proc.exit(EXIT_CODE)
}
