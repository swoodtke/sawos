// A limit is never below what the child already holds of its kind (spec §2.7):
// what a launcher created through the child's handle before the start is
// charged to the child, and a limit under it is a `BadArg` fault.
//
// Root makes two Events through the handle of a child it has not started, so
// the child's Event row reads two used. A limit of two, exactly what it holds,
// is taken; a limit of one is the fault.
//
//   SOS quotaheld: child event row limit=4 used=2
//   SOS quotaheld: limit 2, what it holds, taken
//   SOS quotaheld: setting limit 1, below what it holds
//   SOS: process fault: argument outside its domain

import sos.{System, QuotaKind, SosStatus}

static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)
    try run(&system) catch {
        print("SOS quotaheld: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.shutdown(EXIT_FAILED)
}

/// Charge the child two Events, then set its Event limit to two and to one.
/// The second set does not return.
func run(system: &System) -> Result<Void, SosStatus> {
    let proc = try system.process_self()
    var image_rec = try proc.boot_handle_next()
    var ram_rec = try proc.boot_handle_next()
    guard let image = image_rec.take_memory() else { return BUG }
    guard let ram = ram_rec.take_memory() else { return BUG }
    let child = try system.process_create(image: &image, memory: &ram)

    let a = try child.event_create()
    let b = try child.event_create()
    let row = try child.quota_get(kind: QuotaKind.Event)
    print("SOS quotaheld: child event row limit={} used={}\n", row.limit,
          row.used)
    try child.quota_set(kind: QuotaKind.Event, limit: 2)
    print("SOS quotaheld: limit 2, what it holds, taken\n")
    print("SOS quotaheld: setting limit 1, below what it holds\n")
    let _ = child.quota_set(kind: QuotaKind.Event, limit: 1)
    print("SOS quotaheld: UNREACHABLE the limit was taken\n")
    let _ = move b
    let _ = move a
    return
}
