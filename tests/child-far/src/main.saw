// Test child: the far end of a three-process delegation (spec.md §2.1's
// zero-copy example).
//
// This is the flash driver in §2.1's example. It is sent an obligation, in a
// message, over a connection whose other end belongs to a process it was never
// told about, and answering it puts bytes into a third process's parked call.
// An obligation is a capability, so it is spent exactly like one this program
// had taken itself.
//
// What it cannot do, each a fact about the object model:
//
//   - Name the client. It holds no end of that connection and no handle onto
//     the process. The reply lands because the obligation names the exchange.
//   - Name the process that forwarded it. That process is usually gone by the
//     time the reply is written, and it does not matter: the obligation left
//     the middle's table at the post, so what arrives here is a reference the
//     kernel has been holding since.
//   - Answer twice. `reply` consumes the wrapper, so a second use is a compile
//     error rather than a fault.
//
// It waits rather than polls, with a consuming persistent attach, so its
// launcher may start the three processes in any order. It prints nothing; the
// verdict travels in the spec.md §8 exit code.

import sos.{System, Process, PipeOutlet, PipeRequest, PipeHandle, PipeMsg,
            Waiter, WaitResult, WaitPayload, AttachMode, BootHandle, SosStatus,
            PIPE_BODY_BYTES}

/// A forwarded obligation was answered.
static EXIT_ANSWERED: UInt = 81
/// The boot set held no outlet where its launcher's config says one is.
static EXIT_NO_OUTLET: UInt = 82
/// A call that should not have been refused was.
static EXIT_REFUSED: UInt = 83
/// The message carried no handle, or one of a kind this arm does not expect.
static EXIT_NO_HANDLE: UInt = 84

/// The key the subscription is registered under.
static KEY_OUTLET: UInt = 6

/// Four bytes back: `D`, `O`, `N`, `E`.
static REPLY_LEN: UInt = 4
static BYTE_D: UInt8 = 68
static BYTE_O: UInt8 = 79
static BYTE_N: UInt8 = 78
static BYTE_E: UInt8 = 69

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        print("SOS childfar: no process handle: {}\n", error)
        return
    }

    let code = try answer(&proc) catch {
        print("SOS childfar: refused: {}\n", error)
        let _ = proc.exit(EXIT_REFUSED)
        return
    }
    let _ = proc.exit(code)
}

/// Take one message, and answer the obligation it carried.
func answer(proc: &Process) -> Result<UInt, SosStatus> {
    var rec = try proc.boot_handle_next()
    guard let outlet = rec.take_outlet() else { return EXIT_NO_OUTLET }

    let waiter = try proc.waiter_create()
    try waiter.give(outlet: move outlet, key: KEY_OUTLET,
                    mode: AttachMode.Persistent) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }

    let wake = try waiter.wait()
    var arrived = false
    match wake.what {
        case Message(_, _) -> { arrived = true },
        case _ -> {},
    }
    if not arrived {
        let _ = move wake
        return EXIT_NO_HANDLE
    }

    let (_, what) = (move wake).open()
    match what {
        case Message(m, r) -> {
            var msg = move m
            let own = move r
            // Take it out of its slot before matching it. `msg.handles[i]` is a
            // place; `take()` hands over an owned value, and a `match` on an
            // owned value consumes it, which lets an arm move the wrapper into
            // a consuming op.
            guard let carried = msg.handles[0].take() else {
                let _ = move own
                let _ = move msg
                return EXIT_NO_HANDLE
            }
            let _ = move msg
            match carried {
                case Request(rq) -> {
                    var body: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
                    body[0] = BYTE_D
                    body[1] = BYTE_O
                    body[2] = BYTE_N
                    body[3] = BYTE_E
                    // The bytes go straight to a process this one cannot name.
                    // They are written into the exchange's own ring slot and
                    // copied out through the original client's checked funnel
                    // while it resumes inside its own syscall, so the payload
                    // never transits the process that forwarded it (the
                    // zero-copy claim of spec.md §2.1).
                    let forwarded = move rq
                    try (move forwarded).reply(body: &body, len: REPLY_LEN)
                    // Its own obligation is dropped rather than answered: the
                    // middle gave its claim up at the post (§2.1's tell
                    // idiom), so nobody is waiting for this one.
                    let _ = move own
                    return EXIT_ANSWERED
                },
                case _ -> {
                    let _ = move own
                    return EXIT_NO_HANDLE
                },
            }
        },
        case _ -> { return EXIT_NO_HANDLE },
    }
}
