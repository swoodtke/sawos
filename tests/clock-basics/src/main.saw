// Clock object (spec §2's Clock row).
//
// Each claim is printed as a derived fact rather than a number, because the
// numbers are a real machine's and no assertion can name them:
//
//   minted=1 differs=1   a Clock arrives through the System handle, and asking
//                        twice mints a second handle onto the same object
//                        whose word differs from the first. §3's no-duplicate
//                        rule is about no amplification, not uniqueness: a
//                        mint that carries the kind's default rights through a
//                        gate the caller already passed hands out no authority
//                        a second ask could not have had the first time. Two
//                        instances buy ownership: each can be released on its
//                        own, which is what makes the wrapper an owner rather
//                        than a name. (There is no `clocks=` column to check:
//                        the machine's Clock is one kernel-eternal object per
//                        domain, owned by nobody, so a dead process frees
//                        none.)
//
//                        The word is read at the C altitude: a typed `Clock`
//                        has no word extractor, by design, so a claim about
//                        the word can only be made one floor down.
//                        `timer_badclock` reaches the same floor for the
//                        mirror reason. The typed half of this claim is the
//                        teardown count.
//   monotonic=1          two readings in a row never go backwards.
//   advanced=1 spanned=1 a reading taken after a spin is strictly greater, and
//                        the difference covers the interval spun. `advanced`
//                        alone would pass on a clock wired to a register that
//                        merely counts something; `spanned` says the units are
//                        nanoseconds. Together they are also the copy-out
//                        record's only real check on the 32-bit profile: a
//                        high half arriving as garbage makes both comparisons
//                        nonsense.
//   disarm_unarmed=1     disarming a Timer that was never armed is a no-op. It
//                        is here, in the no-waiting case, because it must not
//                        fault: the whole select-with-timeout idiom rests on
//                        being allowed to cancel a timeout that may already
//                        have expired.
//
// Nothing here waits. Every call answers immediately, so a regression that
// parked would park the only thread in the system and be reported as the
// deadlock it is, in microseconds, not at the timeout.

import sos.{System, Process, Clock, ClockType, Timer, sos_system_clock_get}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

static YES: UInt = 1
static NO: UInt = 0

/// How far to spin before the second reading. A microsecond is far longer than
/// the syscall round trip and far shorter than anything a harness waits for.
static SPIN_NS: UInt64 = 1000

/// The status word a successful op answers with (`SosStatus.Ok`), as a number
/// because this file reaches the C altitude, where a status is one.
static STATUS_OK: UInt = 0

func flag(b: Bool) -> UInt {
    if b { YES } else { NO }
}

/// Ask for a Clock at the C altitude, answering the raw handle word, or 0
/// (`NO_HANDLE`, which names nothing) if the call was refused.
///
/// It goes one floor down because the typed layer has no word extractor: a
/// `Clock` in hand is one the kernel handed over and there is no way back out
/// to an integer. So a claim about the word, that a second ask's differs from
/// the first's, can only be made here, as `timer_badclock` makes its claim
/// here for the mirror reason (the typed surface cannot express a bad domain
/// at all).
///
/// Each call mints. Nothing releases these two words, so both are still bound
/// at the exit and both are counted by the teardown line.
func ask_clock(handle: UInt) unsafe -> UInt {
    var out: UInt = 0
    let status = sos_system_clock_get(handle, ClockType.Monotonic as UInt,
                                      (&var out) as UnsafePointer<UInt>)
    if status != STATUS_OK {
        return 0
    }
    out
}

/// Spin on the clock itself until it reads `deadline`. This uses `now()` as
/// the timekeeper rather than counting iterations, so the delay is a real
/// duration on either machine rather than a guess about instruction speed.
func spin_to(clock: &Clock, deadline: UInt64) {
    var done = false
    while not done {
        match clock.now() {
            case Ok(t) -> {
                if t >= deadline {
                    done = true
                }
            },
            case Err(_) -> { done = true },
        }
    }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS clock: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let clock = try system.clock_get(type: ClockType.Monotonic) catch {
        print("SOS clock: no clock: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // Asking again mints again, and the two words differ. A machine has one
    // monotonic clock, a single kernel-eternal object, and these are two
    // capability instances naming it, not two objects and not one handle
    // handed out twice. §3's no-duplicate rule is not breached: its invariant
    // is no amplification, and both mints carry the kind's default rights
    // through the `SystemRight.ClockGet` gate this caller already passed, so
    // neither ask yields authority the other did not have.
    //
    // Two asks at the C altitude rather than one here and one above, so that
    // both words are visible and the comparison is between two things this
    // line can see. The teardown line below is the other half: each ask
    // minted a handle of its own, and they are all still bound at the exit.
    let first_word = ask_clock(boot_handle)
    let second_word = ask_clock(boot_handle)
    print("SOS clock: minted={} differs={}\n",
          flag(first_word != 0 && second_word != 0),
          flag(second_word != first_word))

    let first: UInt64 = try clock.now() catch {
        print("SOS clock: now failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let second: UInt64 = try clock.now() catch { 0u64 }
    print("SOS clock: monotonic={}\n", flag(second >= first))

    spin_to(&clock, first + SPIN_NS)
    let third: UInt64 = try clock.now() catch { 0u64 }
    print("SOS clock: advanced={} spanned={}\n",
          flag(third > second), flag(third - first >= SPIN_NS))

    // A Timer that is created and never armed. Disarming it is the no-op the
    // cancel idiom depends on; it is also the only thing done with it, so this
    // case creates a Timer without ever making the kernel owe a deadline for
    // it.
    let timer = try clock.timer_create() catch {
        print("SOS clock: no timer: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let quiet = match timer.disarm() {
        case Ok(_) -> true,
        case Err(_) -> false,
    }
    print("SOS clock: disarm_unarmed={}\n", flag(quiet))

    print("SOS clock: done\n")
    let _ = proc.exit(EXIT_OK)
}
