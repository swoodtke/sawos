//! A child of the gate's `stock_record_shapes` image on the riscv32 `virt`
//! board: it holds the server end of a connection and an inlet of it, each given with the rights its declaration names,
//! and prints the rights it holds (`tests/stockkit`).

import stockkit

@export("_start")
func _start(boot_handle: UInt) {
    stockkit.show_rights(boot_handle, "pipes")
}
