// A `Handle` limit is at most the longest handle table, `MAX_HANDLES` +
// `MAX_TABLE_BLOCKS` x `HANDLE_BLOCK` (spec §2.7, §2.8): 128 on every board.
//
// The image holds seven blocks, one more than a table may take, so the slab
// is not what refuses. A row of 129 would need the seventh and answers
// `NoResource`, setting nothing; 128 needs six and is taken. The child
// (`child-blocks-fill`) then fills that table, index 127 included, and
// releases the word 0, whose zero index field names nothing even in a table
// of the longest length; the kernel ends it with `BadHandle`:
//
//   SOS blockslongest: limit 129: no room for what was asked
//   SOS blockslongest: the row still reads limit=16
//   SOS blockslongest: limit 128 taken, reads limit=128
//   SOS blocksfill: held=128 limit=128, the last printed=1, then over its
//   quota
//   SOS blocksfill: the table is full; releasing the word 0
//   SOS: process fault: bad handle process={one}
//   SOS blockslongest: child ended status=131073  <- Faulted << 16 | BadHandle
//   SOS blockslongest: done

import sos.{System, QuotaKind, AttachMode, SosStatus, SystemRight}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// The longest table. No op publishes it, which is why a limit past it is a
/// status.
static LONGEST: UInt16 = 128

/// Root's config: the tag the child's System travels under.
static TAG_BOOT: UInt = 1

/// The key root watches the child's death under.
static KEY: UInt = 7

/// What the child may ask its System object for: print, learn its own
/// Process object and mint siblings; and `Transfer`, which the give spends.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Mint | SystemRight.Transfer)

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)
    try run(&system) catch {
        print("SOS blockslongest: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS blockslongest: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System) -> Result<Void, SosStatus> {
    let proc = try system.process_self()
    var image_rec = try proc.boot_handle_next()
    var ram_rec = try proc.boot_handle_next()
    guard let image = image_rec.take_memory() else { return BUG }
    guard let ram = ram_rec.take_memory() else { return BUG }
    let child = try system.process_create(image: &image, memory: &ram)

    match child.quota_set(kind: QuotaKind.Handle, limit: LONGEST + 1) {
        case Ok(_) -> {
            print("SOS blockslongest: UNEXPECTED limit {} taken\n", LONGEST + 1)
            return BUG
        },
        case Err(why) -> print("SOS blockslongest: limit {}: {}\n", LONGEST + 1,
                               why),
    }
    let before = try child.quota_get(kind: QuotaKind.Handle)
    print("SOS blockslongest: the row still reads limit={}\n", before.limit)
    try child.quota_set(kind: QuotaKind.Handle, limit: LONGEST)
    let after = try child.quota_get(kind: QuotaKind.Handle)
    print("SOS blockslongest: limit {} taken, reads limit={}\n", LONGEST,
          after.limit)

    let for_child = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let waiter = try proc.waiter_create()
    try waiter.add(process: &child, key: KEY, mode: AttachMode.OneShot)
    try child.start(boot_tag: TAG_BOOT)
    let _ = try waiter.wait()
    let status = try child.get_status()
    print("SOS blockslongest: child ended status={}\n", status)
    return
}
