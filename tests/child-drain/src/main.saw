// Test child: a furnished process that is neither root nor doomed.
//
// It receives a masked System handle in its first argument register and
// bootstraps as root does: derive its own Process object, drain the boot set
// its launcher furnished, report, exit with a code. Root's System handle and
// this one differ only in the bits of the rights word (spec.md §12); root's
// was minted at boot, this one is a sibling its launcher minted through a keep
// mask and gave under the tag it was started with.
//
// Asserted properties, each a property of `give`, `mint` or `start`:
//
//   - It can print: `Debug` was in the mask.
//   - It can name itself: `ProcessSelf` was in the mask, so `process_self()`
//     answers.
//   - Two records arrive, not three. The launcher gave three capabilities; the
//     one named by the boot tag was consumed by `start`'s resolution, because
//     the register is its delivery.
//   - They arrive in give order: tags 3 then 5, accumulated as digits into `35`
//     so one number carries the order as well as the set.
//   - `Drained` stays `Drained`: a second ask hands nothing back (the cursor
//     only advances, over records delivered through either door).
//
// The exit code is the drain count, which the launcher reads back through the
// Process handle it kept.
//
// `child_no_shutdown` proves the other half: `Shutdown`, `ProcessCreate` and
// `Mint` are absent from the keep mask, so this process cannot stop the
// machine, spawn or widen its authority.
//
// It names no architecture; only the linker script differs per machine.

import sos.{System, Process, BootHandle, BootHandleKind, SosStatus}

/// What the launcher's config says it gave, in the order it gave it, and what
/// `start`'s resolution took back out. The tags are the only thing the two
/// programs share; the kernel gives them no meaning.
static WANT_RECORDS: UInt = 2
static WANT_TAGS: UInt = 35
static WANT_KINDS: UInt = 0

/// What it ends with when the boot set was not what the config promised. It
/// cannot be a record count, so the transcript's `code=` field tells the two
/// outcomes apart.
static EXIT_MISMATCH: UInt = 99

@export("_start")
func _start(boot_handle: UInt) {
    // Adopt the System handle. `boot_handle` is the word the kernel resolved
    // out of this process's boot set at `start(boot_tag:)`; that record is
    // spent, so it cannot be handed over twice.
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        print("SOS childdrain: no process handle: {}\n", error)
        return
    }

    var count: UInt = 0
    var tags: UInt = 0
    var kinds: UInt = 0
    var going = true
    while going {
        match proc.boot_handle_next() {
            case Ok(h) -> {
                var rec = move h
                tags = tags * 10 + rec.tag
                kinds = kinds * 10 + (rec.kind as UInt)
                // A region this child was given and does not want is a
                // capability it declines: the record drops at the end of this
                // arm and releases it (drop is release).
                count = count + 1
            },
            case Err(_) -> { going = false },
        }
    }

    // It stays drained: the cursor only advances, over the record `start` took
    // as well as the ones delivered here, so a boot set is collected once.
    let still_drained = match proc.boot_handle_next() {
        case Ok(_) -> false,
        case Err(_) -> true,
    }

    print("SOS childdrain: n={} tags={} kinds={}\n", count, tags, kinds)

    // The brackets are load-bearing: a binary expression does not wrap in Saw
    // unless something already encloses it.
    let as_promised = (count == WANT_RECORDS && tags == WANT_TAGS
                       && kinds == WANT_KINDS && still_drained)
    if not as_promised {
        let _ = proc.exit(EXIT_MISMATCH)
    }

    // The exit code is the drain count. This call does not return.
    let _ = proc.exit(count)
}
