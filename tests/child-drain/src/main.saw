// SOS CHILD: THE FURNISHED PROCESS (sawos design 4 — M3 unit 3's money shot).
//
// **THE FIRST SOS PROCESS THAT IS NEITHER ROOT NOR DOOMED, and the first that
// ever spoke.** Every child before this unit received `NO_HANDLE` in its first
// argument register and could do exactly one thing — die trying (see
// `child-fault`). This one receives a MASKED SYSTEM HANDLE there and bootstraps
// exactly as root does: derive its own Process object, drain the boot set its
// launcher furnished, report, exit with a code.
//
// **THE SYMMETRY IS THE POINT** (§12). The kernel has one way in for every
// process — a System handle in a0 and nothing else — and root's differs from
// this one only in which bits its rights word carries. Root's was minted by the
// kernel at boot; this one is a SIBLING its launcher minted through a keep mask
// and gave under the tag it was started with. Neither side can tell, and neither
// needs to.
//
// WHAT IT ASSERTS, and every one is a property of `give`, `mint` or `start`:
//
//   - IT CAN SPEAK. `Debug` was in the mask, so this program prints — the first
//     time in SOS that anything but root has. It owns no device and drives no
//     UART; the authority came through a handle.
//   - IT CAN NAME ITSELF. `ProcessSelf` was in the mask, so `process_self()`
//     answers and everything below hangs off it.
//   - TWO RECORDS arrive, not three. The launcher gave THREE capabilities; the
//     one named by the boot tag was CONSUMED by `start`'s resolution, because
//     the register IS its delivery. `n=2` is that ruling, asserted.
//   - THEY ARRIVE IN GIVE ORDER — tags 3 then 5, accumulated as DIGITS into
//     `35` so one number carries the ORDER and not only the set.
//   - `Drained` STAYS `Drained`: the second ask hands nothing back, which is the
//     claim that the cursor only advances — over records delivered through
//     EITHER door.
//
// AND THE EXIT CODE IS THE DRAIN COUNT, which is what the launcher reads back
// through the Process handle it kept. The console line and the status word say
// the same thing from the two sides of the boundary, which is the whole of
// supervision working while the child manages itself.
//
// WHAT IT CANNOT DO is the other half of the claim, and `child_no_shutdown` is
// where that is proved: `Shutdown`, `ProcessCreate`, `Transfer` and `Mint` were
// absent BY SILENCE from the keep mask, so this process cannot stop the machine,
// cannot spawn, cannot pass its authority on and cannot widen it.
//
// It names no architecture and would build for either profile unchanged; the
// only per-machine thing about it is the linker script the manifest points at.

import sos.{System, Process, BootHandle, BootHandleKind, SosStatus}

/// What the launcher's config says it gave, in the order it gave it — and what
/// `start`'s resolution took back out again. THE TAGS ARE THE ONLY THING THE TWO
/// PROGRAMS SHARE; the kernel supplies no meaning for any of them.
static WANT_RECORDS: UInt = 2
static WANT_TAGS: UInt = 35
static WANT_KINDS: UInt = 0

/// What it ends with when the boot set was not what the config promised. A
/// number that could not be a record count, so the transcript's `code=` field
/// distinguishes the two outcomes on sight.
static EXIT_MISMATCH: UInt = 99

@export("_start")
func _start(boot_handle: UInt) {
    // THE ADOPTION, and it is the same line root writes. `boot_handle` is the
    // word the kernel resolved out of this process's own boot set at
    // `start(boot_tag:)` — a handle the kernel handed over, not a number anybody
    // guessed — and that record is spent, so nothing can hand it over twice.
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        print("SOS childdrain: no process handle: {}\n", error)
        return
    }

    var count: UInt = 0
    var tags: UInt = 0
    var kinds: UInt = 0
    var going = true
    while going {
        match proc.boot_handle_next() {
            case Ok(h) -> {
                var rec = move h
                tags = tags * 10 + rec.tag
                kinds = kinds * 10 + (rec.kind as UInt)
                // A region this child was given and does not want is a
                // capability it declines: the record drops at the end of this
                // arm and releases it, which is drop-is-release doing exactly
                // what design 3 built it for.
                count = count + 1
            },
            case Err(_) -> { going = false },
        }
    }

    // AND IT STAYS DRAINED. The cursor only advances — over the record `start`
    // took as well as the ones delivered here — so a boot set is collected once.
    let still_drained = match proc.boot_handle_next() {
        case Ok(_) -> false,
        case Err(_) -> true,
    }

    print("SOS childdrain: n={} tags={} kinds={}\n", count, tags, kinds)

    // The brackets are load-bearing: a binary expression does not wrap in Saw
    // unless something already encloses it (DF-172d).
    let as_promised = (count == WANT_RECORDS && tags == WANT_TAGS
                       && kinds == WANT_KINDS && still_drained)
    if not as_promised {
        let _ = proc.exit(EXIT_MISMATCH)
    }

    // THE EXIT CODE IS THE DRAIN COUNT, and the launcher reads it back through
    // the Process handle it kept. This call does not return.
    let _ = proc.exit(count)
}
