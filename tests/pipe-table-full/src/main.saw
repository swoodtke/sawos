// The rendezvous refuses atomically (spec §2.1).
//
// Handles and body move together or not at all. A take that carries handles
// mints several entries at once (the obligation, and one per live staged slot),
// and a table with room for some of them must refuse all of them. Otherwise a
// sender's capabilities could land in a table whose owner was never told they
// arrived, with no way to ask and no way to give them back.
//
// The kernel asks one question about the whole batch before any of it exists,
// and on a refusal nothing happened: the message stays staged, the readable
// level stays raised, and the exchange stays where it was. Free a slot, ask
// again, and the same message arrives.
//
// The middle probe is the proof. One free slot is enough for the obligation
// alone; a kernel that minted what it could and dropped the rest would succeed
// there and hand over a message with an empty slot where a capability had
// been. The case therefore probes at three table states (none free, one free,
// two free) and only the last may deliver.
//
// The table is filled by minting siblings until it refuses: there is no
// introspection op, so "how full is it" is asked by asking for one more. The
// holder is an array rather than a recursion because one frame per mint, each
// able to call a take that answers a message-sized record, exceeds the stack
// ceiling on the 64-bit profile.

import sos.{System, Process, PipeInlet, PipeOutlet, PipeReply, PipeRequest,
            PipeHandle, PipeHandles, PipeMsg, SosStatus, PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// The three things this case has to see, one bit each, so a partial result
/// names which probe went wrong rather than merely that one did.
static SAW_FULL_REFUSED: UInt = 1
static SAW_ONE_REFUSED: UInt = 2
static SAW_TWO_DELIVERED: UInt = 4
static SAW_ALL: UInt = 7

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        print("SOS tablefull: no process handle: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let seen = try run(&system, &proc) catch {
        print("SOS tablefull: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS tablefull: probes={} of {}\n", seen, SAW_ALL)
    if seen != SAW_ALL {
        let _ = system.debug_print("SOS tablefull: the refusal was not atomic\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS tablefull: one free slot is not enough, two deliver both\n")
    let _ = system.shutdown(EXIT_OK)
}

/// Stage one message with a handle, then probe the take at three table states.
///
/// One phase per function: a `PipeMsg` is a message-sized value and every
/// `print` with format arguments reserves its own scratch, so a `_start`
/// holding all of it meets root's stack grant (`hal.ROOT_STACK_LEN`) on the
/// 64-bit profile before it meets anything else.
func run(system: &System, proc: &Process) -> Result<UInt, SosStatus> {
    // Two connections: one to send through, and one whose client end is the
    // capability being sent. The second carries no traffic.
    let carrier = try proc.pipe_create()
    let (inlet, outlet) = move carrier
    let cargo = try proc.pipe_create()
    let (spare_in, spare_out) = move cargo

    // One message, staged and left there. The claim is given up at once (§2.1's
    // tell idiom), so the only thing holding this exchange is the message
    // itself, which is what a refused take must leave alone.
    var body: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    body[0] = 1
    var carrying = PipeHandles.none()
    carrying.put(0, inlet: move spare_in)
    let claim = try inlet.post_with(body: &body, len: 1, handles: &var carrying)
    let _ = move claim

    let seen = try fill_and_probe(&system, &outlet)

    let _ = move spare_out
    let _ = move outlet
    let _ = move inlet
    return seen
}

/// The slots this case fills the table with. A process's table is
/// `MAX_HANDLES` deep and the kernel does not publish that number (a caller
/// meeting a full table is told `NoResource`), so this holds a comfortable
/// upper bound and stops at the refusal.
static FILL_SLOTS: Int = 16

/// The holder is an array rather than a recursion: recursing one frame per mint
/// exceeds root's stack grant (`hal.ROOT_STACK_LEN`) on the 64-bit profile (one
/// frame per mint, each big enough to call a take that answers a
/// message-sized record). One frame and an array fits.
///
/// It is `NoCopy` because it holds `System` wrappers, and its drop releases
/// whatever is left, which makes an early return safe.
struct Filler {
    slots: [System?; FILL_SLOTS],
}

extension Filler: NoCopy {}

extension Filler {
    /// Every slot empty. Spelled out because a repeat literal cannot build a
    /// `NoCopy` optional (`[v; N]` needs an element that copies for free), so
    /// this literal tracks `FILL_SLOTS` by hand and the assert below catches it
    /// if the number moves.
    static func empty() -> Filler {
        Filler(slots: [None, None, None, None, None, None, None, None,
                       None, None, None, None, None, None, None, None])
    }
}

static_assert(FILL_SLOTS == 16,
              "Filler.empty spells its slots out and tracks FILL_SLOTS by hand")

/// Fill the handle table by minting siblings into `held`, and probe the take at
/// three table states on the way back down.
///
/// The occupancy is the fill and the unwind is the freeing: after the fill the
/// table is full, and each release gives back exactly one slot, in the order
/// the three probes want to ask about.
func fill_and_probe(system: &System, outlet: &PipeOutlet) -> Result<UInt, SosStatus> {
    var held = Filler.empty()
    var depth: Int = 0
    var filling = true
    while filling && depth < FILL_SLOTS {
        let got = try? system.mint()
        if let one = move got {
            held.slots[depth] = move one
            depth = depth + 1
        } else {
            filling = false
        }
    }
    if filling {
        // The table was deeper than this holder, so the fill never reached the
        // refusal and the probes below would be measuring nothing.
        return SosStatus.NoResource
    }

    var seen: UInt = 0
    // None free: a take that has to mint two things must refuse.
    if try take_refuses(&outlet) {
        seen = seen | SAW_FULL_REFUSED
    }

    // One free. One slot is enough for the obligation on its own; a kernel that
    // delivered here would have dropped the handle the message carried.
    let _ = held.slots[depth - 1].take()
    if try take_refuses(&outlet) {
        seen = seen | SAW_ONE_REFUSED
    }

    // Two free: the batch the refusals were about arrives whole.
    let _ = held.slots[depth - 2].take()
    if try take_delivers(&outlet) {
        seen = seen | SAW_TWO_DELIVERED
    }
    return seen
}

/// Did the take refuse, and leave the message where it was?
///
/// A refusal is a status and not a fault, because a full table is a resource
/// condition the caller could not have known about from the other side of the
/// connection. Both `NoResource` (the machine's edge) and `QuotaExceeded` (the
/// process's own budget) are accepted: they are the same answer to this
/// question.
func take_refuses(outlet: &PipeOutlet) -> Result<Bool, SosStatus> {
    match outlet.take() {
        case Ok(got) -> {
            // A delivery here is the bug this case is looking for, so whatever
            // arrived is dropped and the answer is no.
            let _ = move got
            false
        },
        case Err(_) -> true,
    }
}

/// Did the take deliver the message, its obligation and the handle it carried?
///
/// All three are checked, because "it succeeded" is not the claim: the claim is
/// that the batch the refusals were about arrives whole the moment there is
/// room for it.
func take_delivers(outlet: &PipeOutlet) -> Result<Bool, SosStatus> {
    let got = try outlet.take()
    let (arrived, request) = move got
    var msg = move arrived
    let _ = move request
    guard let carried = msg.handles[0].take() else { return false }
    match carried {
        case Inlet(i) -> {
            let _ = move i
            return true
        },
        case _ -> { return false },
    }
}
