// A give's keep mask narrows an Event (spec §3).
//
// Expected transcript, read as an order:
//
//   SOS eventnarrow: started
//   SOS childevent: narrow signalled        <- Signal survived the mask
//   SOS: process fault: access denied process=1
//   SOS eventnarrow: the child faulted
//
// Root gives the child an Event with `EventRight.Signal` as the keep mask. The
// child (`child-event`, narrowed role) signals it, then attaches it to a
// Waiter, which spends `EventRight.Wait`, a bit the mask dropped, so the
// kernel ends the child with `AccessDenied`. This is how a giver that attaches
// an Event itself keeps the right to attach for itself.

import sos.{System, Process, EventRight, SystemRight, SosStatus}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// Root's config: the tags the child's boot records travel under.
static TAG_BOOT: UInt = 7
static TAG_NARROW: UInt = 35

/// The key root's attachment lives under.
static KEY_CHILD: UInt = 86

/// What the child may do with the Event: signal it and nothing else.
static SIGNAL_ONLY: UInt32 = EventRight.Signal

/// What a child of this launcher may ask its System object for.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// The kind half of a §8 status word for a process that faulted.
static FAULTED: UInt = 2 << 16

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS eventnarrow: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    try run(&system, &proc) catch {
        print("SOS eventnarrow: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var img_rec = try proc.boot_handle_next()
    var ram_rec = try proc.boot_handle_next()
    guard let image = img_rec.take_memory() else { return BUG }
    guard let ram = ram_rec.take_memory() else { return BUG }

    let child = try system.process_create(image: &image, memory: &ram)
    let waiter = try proc.waiter_create()
    try waiter.add(process: &child, key: KEY_CHILD)

    let for_child = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let event = try proc.event_create()
    try child.give(event: move event, tag: TAG_NARROW,
                   keep: SIGNAL_ONLY) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try child.start(boot_tag: TAG_BOOT)
    let _ = system.debug_print("SOS eventnarrow: started\n")

    let woke = try waiter.wait()
    match woke.what {
        case Process(status) -> {
            if (status >> 16) << 16 != FAULTED {
                print("SOS eventnarrow: the child ended {}\n", status)
                return BUG
            }
        },
        case _ -> { return BUG },
    }
    let _ = system.debug_print("SOS eventnarrow: the child faulted\n")
    return
}
