// Test child: receives a capability in a message (spec.md §2.1's
// `send(data?, handles?)`).
//
// It does not know what it will be given. Everything it holds from its boot
// set was written by its launcher before it ran and frozen at `start`. A
// message's handle slot is the other door: it opens at run time, the sender
// chooses what goes through it, and the receiver finds out by matching on
// `PipeHandle`.
//
// The child branches on the kind of handle it was sent; the two arms are the
// proofs its two launchers want:
//
//   `Request` the delegation primitive arriving as a message rather than a
//             launch-time `give`. The obligation belongs to an exchange on a
//             connection this process cannot name, whose client it has never
//             heard of. It replies, and the bytes land at the original claim
//             with a capability of its own attached (§2.1's symmetry in the
//             direction that is easiest to forget). Launcher:
//             `pipe-delegate-msg`.
//   `Inlet`   a live connection end. It posts through it, which proves the word
//             it was handed is a working capability, then replies with no
//             handle attached (see the arm for why). Launcher: `pipe-handles`.
//
// The obligation it takes is its own, not the one it may reply to. A take
// always mints one; on the delegation arm this child drops it (its own client
// asked nothing and gave the claim up), and on the inlet arm it discharges it
// by replying. Keeping those two straight is what makes "a message carries
// handles" different from "a give".
//
// The verdict travels in the spec.md §8 exit code, so a launcher reads which
// arm ran without this child printing a word.

import sos.{System, Process, PipeInlet, PipeOutlet, PipeRequest, PipeHandle,
            PipeHandles, PipeMsg, BootHandle, BootHandleKind, SosStatus,
            PIPE_BODY_BYTES}

/// The boot set carries exactly one thing this child wants: the server end of
/// the connection its launcher posts through.
static EXIT_NO_OUTLET: UInt = 91
/// The message carried no handle, or one of a kind neither arm expects. An
/// empty ring or a full one rides the error channel, so the `try` that carries
/// every other failure covers those too and they need no codes of their own.
static EXIT_NO_HANDLE: UInt = 93
/// A call that should not have been refused was.
static EXIT_REFUSED: UInt = 94

/// The delegation arm ran: a forwarded obligation was answered.
static EXIT_FORWARDED: UInt = 41
/// The endpoint arm ran: a received inlet was posted through.
static EXIT_ENDPOINT: UInt = 42

/// Four bytes each way, so a launcher's assertion is about the data and not
/// only about the status.
static PAYLOAD_LEN: UInt = 4

/// `D`, `O`, `N`, `E`: what the forwarded obligation answers with.
static BYTE_D: UInt8 = 68
static BYTE_O: UInt8 = 79
static BYTE_N: UInt8 = 78
static BYTE_E: UInt8 = 69

/// The byte this child posts through an inlet it was handed. Distinctive, so
/// the launcher's take proves which process wrote it.
static BYTE_VIA: UInt8 = 86

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        print("SOS childhandles: no process handle: {}\n", error)
        return
    }

    guard let outlet = drain_outlet(&proc) else {
        let _ = system.debug_print("SOS childhandles: no outlet in the boot set\n")
        let _ = proc.exit(EXIT_NO_OUTLET)
        return
    }

    let code = try serve(&outlet) catch {
        print("SOS childhandles: refused: {}\n", error)
        let _ = proc.exit(EXIT_REFUSED)
        return
    }
    let _ = proc.exit(code)
}

/// The one thing this child's boot set is expected to hold.
func drain_outlet(proc: &Process) -> PipeOutlet? {
    var going = true
    while going {
        match proc.boot_handle_next() {
            case Ok(h) -> {
                var rec = move h
                match rec.kind {
                    case PipeOutlet -> {
                        if let got = rec.take_outlet() {
                            let some: PipeOutlet? = move got
                            return move some
                        }
                    },
                    // Anything else is a capability this child was given and does
                    // not want: it drops at the end of this arm.
                    case _ -> {},
                }
            },
            case Err(_) -> { going = false },
        }
    }
    None
}

/// Take the one message, and do whatever the handle it carried says.
func serve(outlet: &PipeOutlet) -> Result<UInt, SosStatus> {
    let got = try outlet.take()
    let (arrived, request) = move got
    var msg = move arrived
    let own = move request

    // Take it out of its slot before matching it. `msg.handles[i]` is a place;
    // `take()` hands over an owned value, and a `match` on an owned value
    // consumes it, which lets an arm move the wrapper into a consuming op.
    // Matching the slot where it sits would be a borrow, and the pinned sawc
    // refuses a `move` out of a borrowing arm.
    guard let carried = msg.handles[0].take() else { return EXIT_NO_HANDLE }

    match carried {
        // The delegation arm. The obligation is somebody else's exchange, on a
        // connection this process holds no end of. Replying to it sends the
        // bytes straight to the original client; the payload never transits the
        // process that forwarded it (spec.md §2.1's zero-copy example, with a
        // message where the example says "forwards").
        case Request(rq) -> {
            var body: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
            body[0] = BYTE_D
            body[1] = BYTE_O
            body[2] = BYTE_N
            body[3] = BYTE_E
            // The answer carries a capability of its own: `send(data?,
            // handles?)` means both directions, so a reply's handle slots are
            // the request's. What goes back is a sibling of this child's own
            // server end, the shape a service uses to hand a client a second
            // channel.
            //
            // The sibling leaves this process's table at the reply, not at the
            // delivery, so this process exiting afterwards cannot empty the
            // slot the launcher receives.
            let sibling = try outlet.mint()
            var back = PipeHandles.none()
            back.put(0, outlet: move sibling)
            let forwarded = move rq
            try (move forwarded).reply_with(body: &body, len: PAYLOAD_LEN,
                                            handles: &var back)
            // Its own obligation is dropped rather than answered: the launcher
            // gave the claim up at the post (§2.1's tell idiom), so nobody is
            // waiting for this one.
            let _ = move own
            return EXIT_FORWARDED
        },
        // The endpoint arm. A connection end that arrived in a message is a
        // connection end: posting through it is the proof.
        case Inlet(i) -> {
            var received = move i
            var body: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
            body[0] = BYTE_VIA
            let claim = try received.post(body: &body, len: 1)
            // A tell: the launcher is the one that takes, and nothing here
            // wants an answer.
            let _ = move claim

            // This reply carries no handle, because of the ledger its launcher
            // is measuring. A handle sent back here would land in the
            // launcher's table at the delivery and net out against the entry
            // the launcher's post freed, so the launcher's third reading would
            // prove nothing. The reply direction's handles are proved by the
            // other arm, where nobody is counting slots.
            body[0] = BYTE_D
            body[1] = BYTE_O
            body[2] = BYTE_N
            body[3] = BYTE_E
            try (move own).reply(body: &body, len: PAYLOAD_LEN)
            let _ = move received
            return EXIT_ENDPOINT
        },
        // Nothing else is expected; a capability this child cannot use is
        // dropped, not hidden.
        case _ -> {
            let _ = move own
            return EXIT_NO_HANDLE
        },
    }
}
