// The preemption kernel with a short tick.
//
// This is `tests/threads_timer.saw` with a shorter period and nothing else.
// A case that wants a preemption to land inside a window of a few
// instructions needs ticks to be frequent in host time, and how many a given
// boot takes depends on how fast the machine runs the workload, so the
// millisecond tick the interleaving case reads comfortably is too slow here.
//
// The period stays above the timer's floor (`TIMER_MIN_LEAD_NS` in
// `kernel/core/time.saw`), so every deadline it programs is one the timer
// accepts.

import kcore.{console, load_root_and_enter, start_tick, enable_tick_report}
import hal

/// The tick period, in microseconds.
static TICK_PERIOD_US: UInt = 100

@export("kmain")
func kmain() {
    let uart = console()
    uart.write_str("SOS M2: preemptive kernel up on ")
    uart.write_str(hal.arch_name())
    uart.write_str("\n")

    hal.intc_init()
    enable_tick_report()
    start_tick(TICK_PERIOD_US)

    load_root_and_enter()
}
