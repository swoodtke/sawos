// A `Mapping` limit is bounded by the named child's free grant rows, not the
// caller's (spec §2.7): the bound is the rows the child's own image left.
//
// The child is `child-quota-twoseg`, whose image spends one row fewer than
// root's, so its free rows are root's own `Mapping` limit plus one. That limit
// is taken; one more is `NoResource`. A kernel bounding the child by the
// caller's rows refuses the first.
//
//   SOS quotarowschild: one above root's own free rows: taken
//   SOS quotarowschild: two above root's own free rows: no room for what was asked
//   SOS quotarowschild: done

import sos.{System, QuotaKind, SosStatus}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)
    try run(&system) catch {
        print("SOS quotarowschild: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS quotarowschild: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System) -> Result<Void, SosStatus> {
    let proc = try system.process_self()
    var image_rec = try proc.boot_handle_next()
    var ram_rec = try proc.boot_handle_next()
    guard let image = image_rec.take_memory() else { return BUG }
    guard let ram = ram_rec.take_memory() else { return BUG }
    let child = try system.process_create(image: &image, memory: &ram)

    let own = try proc.quota_get(kind: QuotaKind.Mapping)
    match child.quota_set(kind: QuotaKind.Mapping, limit: own.limit + 1) {
        case Ok(_) -> {
            print("SOS quotarowschild: one above root's own free rows: taken\n")
        },
        case Err(why) -> {
            print("SOS quotarowschild: UNEXPECTED one above root's own: {}\n",
                  why)
            return BUG
        },
    }
    match child.quota_set(kind: QuotaKind.Mapping, limit: own.limit + 2) {
        case Ok(_) -> {
            print("SOS quotarowschild: UNEXPECTED two above root's own: taken\n")
            return BUG
        },
        case Err(why) -> {
            print("SOS quotarowschild: two above root's own free rows: {}\n",
                  why)
        },
    }
    return
}
