// SOS M5 unit 6: A SLAB'S CEILING IS THE DEPLOYMENT'S, NOT THE COMPILE'S
// (sawos design 32, on design 25 D-6).
//
// The transcript:
//
//   SOS slabdonate: floor=4 fifth refused: out of kernel objects
//   SOS slabdonate: donated a page of waiters
//   SOS slabdonate: fifth waiter created
//   SOS slabdonate: extent waiter woke key=77 word=4
//   SOS slabdonate: done
//
// FOUR CLAIMS, IN ORDER.
//
//  1. THE FLOOR IS REAL. `MAX_WAITERS` is 4 and root's quota is unlimited, so
//     the fifth `waiter_create` meets the SLAB and answers `NoResource` — "out
//     of kernel objects", the same status it has always answered, for the same
//     reason.
//
//  2. THE DONATION IS ORDINARY MEMORY. A page is cut out of root's pool with
//     `split` and handed to `SystemOp.SlabDonate`. Nothing about the region is
//     special: it is the same kind of capability a launcher would hand a child.
//     It is CONSUMED — `move scratch` at the call site says so, and there is no
//     way to get it back.
//
//  3. THE CEILING MOVED. The same call that was refused two lines earlier now
//     succeeds. That is the whole unit in one line.
//
//  4. **AND THE SLOT IN DONATED MEMORY IS A SLOT LIKE ANY OTHER**, which is the
//     claim that would be easy to leave untested and is the one that matters. A
//     count proves the allocator found the extent; it does not prove the kernel
//     can safely WRITE there. So the fifth waiter — the one that can only be in
//     extent 1, since the first four filled extent 0 — takes an attachment, is
//     signalled, and reports its key and the delivered word out of a wait
//     record. Attach, deliver and wake all read and write that slot.
//
// WHY THE SLOT COUNT IS NEVER PRINTED: a donated extent holds
// `page / sizeof(WaiterSlot)` slots, and that divisor differs between the two
// profiles (field alignment). The new ceiling is therefore arch-dependent, while
// every claim above is not — so the case asserts that the ceiling MOVED and
// leaves the arithmetic to design 32's As-built, which prices both.
//
// The house diagnostic style (see `tests/memory-recycle`): a failure prints and
// shuts down with a non-zero status, so a broken case cannot pass quietly.

import sos.{System, Process, Memory, Waiter, Event, EventMode, WaitResult,
            SlabKind, SosStatus}

/// One protection unit's worth on either profile — comfortably more than one
/// waiter slot, which is all the donation has to be.
static PAGE: UInt = 0x1000

/// The key the extent-1 waiter's attachment travels under. A number that appears
/// nowhere else in the transcript.
static KEY: UInt = 77

/// The bit the event is signalled with, and therefore the word the wait reports.
static BIT: UInt = 4

/// `MAX_WAITERS`, written down so that raising the kernel's floor fails THIS
/// case loudly rather than quietly making its first claim vacuous.
static FLOOR: UInt = 4

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// The word the wait delivered. This program attaches exactly one Event, so
/// every other payload is a kernel bug rather than a case to handle.
func at_wait(r: &WaitResult) -> UInt {
    match r.what {
        case Event(word) -> word,
        case _ -> panic("this program attached only an Event"),
    }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS slabdonate: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var pool_record = try proc.boot_handle_next() catch {
        let _ = system.debug_print("SOS slabdonate: no pool region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let pool = pool_record.take_memory() else {
        let _ = system.debug_print("SOS slabdonate: pool record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // ---- CLAIM 1: the compiled floor is real ------------------------------
    //
    // Four separate bindings rather than a loop, because every one of them has
    // to be LIVE at once for the fifth to meet the slab — a loop that dropped
    // each waiter as it went would never fill anything.
    let w0 = try proc.waiter_create() catch {
        print("SOS slabdonate: no waiter 0: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let w1 = try proc.waiter_create() catch {
        print("SOS slabdonate: no waiter 1: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let w2 = try proc.waiter_create() catch {
        print("SOS slabdonate: no waiter 2: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let w3 = try proc.waiter_create() catch {
        print("SOS slabdonate: no waiter 3: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The negative, asserted on the SPECIFIC status: a full slab is
    // `NoResource`, and an `Ok` here would mean the floor was never the floor.
    match proc.waiter_create() {
        case Ok(_) -> {
            let _ = system.debug_print(
                "SOS slabdonate: a fifth waiter existed BEFORE the donation\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
        case Err(e) -> print("SOS slabdonate: floor={} fifth refused: {}\n",
                             FLOOR, e),
    }

    // ---- CLAIM 2: the donation ------------------------------------------
    let scratch = try pool.split(len: PAGE) catch {
        print("SOS slabdonate: no page to donate: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    // THE REGION IS CONSUMED HERE. `move` is written at the call site, which is
    // the transfer-funnel contract: past this line the binding is dead and the
    // bytes are the kernel's forever. The error carries the region BACK — a
    // refused donation consumes nothing — and this program simply drops it,
    // since a failure here is a failure of the case.
    try system.slab_donate(kind: SlabKind.Waiters, memory: move scratch) catch {
        let _ = system.debug_print("SOS slabdonate: donation refused\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS slabdonate: donated a page of waiters\n")

    // ---- CLAIM 3: the ceiling moved --------------------------------------
    let w4 = try proc.waiter_create() catch {
        print("SOS slabdonate: the donated extent gave nothing: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS slabdonate: fifth waiter created\n")

    // ---- CLAIM 4: and the donated slot WORKS -----------------------------
    //
    // `w4` cannot be anywhere but the donated extent: `w0`..`w3` are still live
    // and they are extent 0 in its entirety.
    let event = try proc.event_create(mode: EventMode.Or) catch {
        print("SOS slabdonate: no event: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = w4.add(&event, KEY)
    // SIGNAL FIRST, THEN WAIT — §2.2 is level-triggered, so the readiness is
    // still there when the wait looks and this single-threaded program never
    // parks. (`tests/event-basics` is where that ordering is the subject.)
    let _ = event.signal(BIT)
    let report = try w4.wait() catch {
        print("SOS slabdonate: extent waiter never woke: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS slabdonate: extent waiter woke key={} word={}\n",
          report.key, at_wait(&report))

    let _ = system.debug_print("SOS slabdonate: done\n")
    let _ = proc.exit(EXIT_OK)
    let _ = system.shutdown(EXIT_FAILED)
}
