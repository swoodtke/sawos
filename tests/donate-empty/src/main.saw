// An empty region is no slab donation, and the caller keeps it (spec §2.8).
//
// The build's pool row is three bytes long and begins one byte past a grain
// boundary (`pool_bytes`, `pool_skew`). The kernel starts a pool at its row's
// first grain boundary, and this row ends before it reaches one, so the pool
// root drains has no bytes at all: `available` reads zero for both counts.
// Root donates it. The region rule asks only of a region with bytes, so the
// pool meets the answer a region too small for any slot gets: a status, with
// the pool handed back and root still running:
//
//   SOS donateempty: the pool holds total=0 largest=0
//   SOS donateempty: an empty pool is refused: out of kernel objects
//   SOS donateempty: done
//
// An allocation is never empty (`allocate` refuses a length of zero), so a
// boot row is the one way to make an empty region.

import sos.{System, Process, Pool, SlabKind, SosStatus}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.Unknown

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS donateempty: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&system, &proc) catch {
        print("SOS donateempty: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS donateempty: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var pool_rec = try proc.boot_handle_next()
    guard let pool = pool_rec.take_pool() else { return BUG }

    let held = try pool.available()
    print("SOS donateempty: the pool holds total={} largest={}\n", held.total,
          held.largest)
    try system.slab_donate(kind: SlabKind.Waiters, pool: move pool) catch {
        let (why, back) = move error
        let _ = move back
        print("SOS donateempty: an empty pool is refused: {}\n", why)
        return
    }
    let _ = system.debug_print("SOS donateempty: an empty pool was taken\n")
    return BUG
}
