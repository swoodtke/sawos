// A child an image launches more than once. Each instance is its own link of
// this package, so an instance that runs at all ran in the region and the
// slot its own image was linked for.
//
// It derives its own Process object from the masked System handle its
// launcher gave it, says one line and calls `exit(EXIT_CODE)`. Its launcher
// reads `Exited`(1) << 16 | 7 = 65543 from the wait record.

import sos.{System}

/// The code each instance ends with.
static EXIT_CODE: UInt = 7

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        print("SOS instance: no process handle: {}\n", error)
        // Returning from the entry faults this process, which its launcher
        // reads as `Faulted`.
        return
    }

    let _ = system.debug_print("SOS instance: running\n")
    let _ = proc.exit(EXIT_CODE)
}
