// Freestanding: the dump path itself, on every architecture.
//
// The companion to `taskdump.saw`, which spawns real tasks and parks one.
// This one proves the parts that have nothing to do with having tasks: the
// backtrace table is linked into the kernel image, the walker compiles and
// links freestanding under `--no-hidden-alloc`, it runs on bare metal, and
// it reaches the console through the same `__saw_rt_write` seam `print`
// uses.
//
// It also pins the other half of the panic contract: a program with no live
// task takes the runtime seam directly with its message, so a panic here
// prints exactly its own message and nothing else. The dump above the panic
// line comes from the explicit call; nothing is appended below it.

import kcore
import std.task.{dump_tasks}

@export("__saw_rt_output_lock")
func rt_output_lock() {
}

@export("__saw_rt_output_unlock")
func rt_output_unlock() {
}

@export("__saw_rt_write_error")
func rt_write_error(ptr: UnsafePointer<Int8>, len: UInt) unsafe {
    sos_rt_write(ptr, len)
}

extern "C" {
    func sos_rt_write(ptr: UnsafePointer<Int8>, len: UInt)
}

@export("kmain")
func kmain() {
    dump_tasks()
    panic("SOS task dump: no tasks here")
}
