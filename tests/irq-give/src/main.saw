// An Interrupt crosses a process boundary by give and by message, works there,
// and dies with its holder (spec §2.10, §3, §9).
//
// Root binds two lines, which it holds the right to
// (`SystemRight.InterruptBind` is in the boot System handle). It gives a child
// (`child-irq`) the first under a tag and stages the second in a message, then
// starts it and parks on its death. The child attaches both to a Waiter, which
// spends `InterruptRight.Wait` on each, and acks the given one with no fire
// outstanding. The ack is `BadState`, not `AccessDenied`, so the right came
// across with the handle, and the fault ends the child while it holds both
// Interrupts:
//
//   SOS irqgive: started
//   SOS childirq: attached the given and the sent Interrupt
//   SOS childirq: acking with no fire outstanding
//   SOS: process fault: object in the wrong state process=1
//   SOS: process teardown handles=... interrupts=2 ...
//   SOS irqgive: the holder ended status=131077     <- Faulted(2) << 16 | 5
//   SOS irqgive: capacity after the holder's death=4
//   SOS irqgive: both lines bound again
//
// The last line is the claim about death. Root gave away the only name of each
// Interrupt, so the child's teardown destroyed both and their lines came
// back: a line still bound would be a `LineBound` fault ending root.
// `interrupts=2` is the child's teardown counting the two Interrupts its
// handles destroyed.
//
// What this does not do is service a fire. `child_echo_*` and `uart_service_*`
// do: their drivers wait, drain the device and ack real interrupts.

import sos.{System, Process, Interrupt, PipeHandles, SystemRight, SosStatus,
            PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// Two lines both machines wire and neither asserts unasked.
static LINE_GIVEN: UInt = 5
static LINE_SENT: UInt = 6

/// Root's config: the tags the child's boot records travel under.
static TAG_BOOT: UInt = 7
static TAG_LINE: UInt = 31
static TAG_INBOX: UInt = 32

/// The key root's attachment on the child lives under.
static KEY_CHILD: UInt = 81

/// What a child of this launcher may ask its System object for. It holds no
/// `InterruptBind`: it is given the lines it holds.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// `Faulted`(2) << 16 | `BadState`(5): the child's ack with nothing fired.
static ACK_FAULT: UInt = 131077

/// The first line the capacity count binds: clear of the two above and of the
/// console's line on both machines.
static FIRST_PROBE_LINE: UInt = 11

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS irqgive: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&system, &proc) catch {
        print("SOS irqgive: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS irqgive: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var img_rec = try proc.boot_handle_next()
    var ram_rec = try proc.boot_handle_next()
    guard let image = img_rec.take_memory() else { return BUG }
    guard let ram = ram_rec.take_memory() else { return BUG }

    let child = try system.process_create(image: &image, memory: &ram)
    let given = try system.interrupt_bind(line: LINE_GIVEN)
    let sent = try system.interrupt_bind(line: LINE_SENT)
    let inbox = try proc.pipe_create()
    let (inbox_in, inbox_out) = move inbox

    let for_child = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try child.give(interrupt: move given, tag: TAG_LINE) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try child.give(outlet: move inbox_out, tag: TAG_INBOX) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }

    // The message is staged before the child exists to take it.
    var body: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    var carrying = PipeHandles.none()
    carrying.put(0, interrupt: move sent)
    let claim = try inbox_in.post_with(body: &body, len: 1,
                                       handles: &var carrying)
    let _ = move claim

    let watch = try proc.waiter_create()
    try watch.add(process: &child, key: KEY_CHILD)
    try child.start(boot_tag: TAG_BOOT)
    let _ = system.debug_print("SOS irqgive: started\n")

    let woke = try watch.wait()
    if woke.key != KEY_CHILD {
        return BUG
    }
    match woke.what {
        case Process(status) -> {
            print("SOS irqgive: the holder ended status={}\n", status)
            if status != ACK_FAULT {
                return BUG
            }
        },
        case _ -> { return BUG },
    }

    // Root gave away the only name of each Interrupt, so the holder's death
    // destroyed both and the teardown's sweep freed their slots: all four are
    // free. A slot left invalid would show here as a smaller count.
    print("SOS irqgive: capacity after the holder's death={}\n",
          count_free(&system, FIRST_PROBE_LINE))
    // A line still bound is a `LineBound` fault.
    let first = try system.interrupt_bind(line: LINE_GIVEN)
    let second = try system.interrupt_bind(line: LINE_SENT)
    let _ = system.debug_print("SOS irqgive: both lines bound again\n")
    let _ = move first
    let _ = move second
    return
}

/// Bind lines from `line` up until the slab refuses, each Interrupt held in
/// its own frame while the next is asked for, and answer how many were bound.
func count_free(system: &System, line: UInt) -> UInt {
    let irq = try system.interrupt_bind(line: line) catch { return 0 }
    let n = count_free(&system, line + 1)
    let _ = move irq
    return n + 1
}
