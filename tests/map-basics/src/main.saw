// Map (spec §2.5): an address that faulted before is memory after. This is the
// inverse of every protection proof that only reaches for an ungranted address:
// `root_server_oversteps` reaches for one and dies; this program obtains the
// authority, installs it, and writes. Together they show a protection domain
// being data.
//
// The transcript reads as three claims:
//
//   SOS mapbasics: wrote 0x5a read 90       <- the row installed, immediately
//                                              (90 is 0x5a; the byte renders as
//                                              decimal)
//   SOS mapbasics: double-mapped read-only  <- allowed
//   SOS mapbasics: still 90                 <- the alias destroyed nothing
//
// The first line also proves the live-domain rule half the time. The scheduler
// skips equal domains, so a `map` into the running process would never be
// installed if the op did not reload. The write on the next line shows it did.
// (`map_unmap` proves the other direction, the one that matters for
// revocation.)
//
// The double map shows per-mapping access. Access is a property of the mapping,
// not of the region (`MemoryRight` has no R/W/X pair on purpose), so one region
// can be installed read-write here and read-only there. On a machine with no
// translation both rows name the same addresses and the hardware's own matching
// rule decides which one answers; on a translating machine the second row
// lands at a second virtual address. Either way this case asserts that both
// install and that a read at `base` still works, and deliberately does not
// write again afterwards.

import sos.{System, Process, Memory, Pool, Mapping, MapAccess, SosStatus}

extern "C" {
    func sos_test_pool_base() -> UInt
}

static CHUNK: UInt = 0x1000

static RW: UInt32 = MapAccess.Read | MapAccess.Write
static RO: UInt32 = MapAccess.Read

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

func poke(addr: UInt, value: UInt8) unsafe {
    UnsafeMemory<UInt8, Normal>(addr).write(value)
}

func peek(addr: UInt) unsafe -> UInt8 {
    UnsafeMemory<UInt8, Normal>(addr).read()
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS mapbasics: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    var record = try proc.boot_handle_next() catch {
        print("SOS mapbasics: no pool region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let pool = record.take_pool() else {
        let _ = system.debug_print("SOS mapbasics: boot record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let base = sos_test_pool_base()

    let chunk = try pool.allocate(len: CHUNK) catch {
        print("SOS mapbasics: allocation failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The map. `proc` is this process's own handle, so root is mapping into
    // itself, which spends `ProcessRight.Map` on that handle and
    // `MemoryRight.Map` on the region: two rights on two objects.
    let _rw_map = try proc.map(memory: &chunk, access: RW) catch {
        print("SOS mapbasics: map failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    poke(base, 0x5A)
    print("SOS mapbasics: wrote 0x5a read {}\n", peek(base) as Int)

    // The double map. The same region, a second Mapping, read-only. Nothing
    // refuses it and nothing has to: two rows over one region are two rows,
    // and the region is not consumed by being installed.
    let _ro_map = try proc.map(memory: &chunk, access: RO) catch {
        print("SOS mapbasics: double map failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS mapbasics: double-mapped read-only\n")
    print("SOS mapbasics: still {}\n", peek(base) as Int)

    let _ = system.debug_print("SOS mapbasics: done\n")
    let _ = system.shutdown(EXIT_OK)
}
