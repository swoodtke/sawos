//! A child of the gate's stock-root images on the arm64 `virt` board: it
//! holds the PL031 RTC whole and its line, and prints its match register
//! (`tests/stockkit`).

import stockkit
import stockconfig.{name, OFFSET}

@export("_start")
func _start(boot_handle: UInt) {
    stockkit.probe(boot_handle, name(), OFFSET)
}
