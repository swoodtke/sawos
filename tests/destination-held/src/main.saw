// A destination released while its child runs is held until the child's
// death (spec §2.5).
//
// A child's copied segments and its stack are rows counted on the allocation
// it was created in. A launcher that allocates that destination from a pool,
// creates the child in it and releases its only handle leaves an allocation
// the child's rows still name, so its bytes do not go back to the pool while
// the child runs.
//
//   SOS desthold: child parked                   <- the child printed nothing
//                                                   yet and waits for `go`
//   SOS desthold: destination released          <- root's only handle on it
//   SOS desthold: next allocation taken and mapped
//   SOS desthold: while the child lives, witness found=0
//                                                <- what a third party can see:
//                                                   the next allocation is not
//                                                   the child's bytes
//   SOS livedata: pattern intact                 <- the child's own voice
//   SOS desthold: child ended status=65607
//   SOS desthold: after its death, witness found=1
//                                                <- the child's bytes came
//                                                   home; a fresh allocation
//                                                   of the same size is them,
//                                                   and carries the pattern
//   SOS desthold: done
//
// "Found" is the program's own measurement: the child's pattern is four words
// that appear nowhere else, and the launcher looks for them through a mapping
// of the allocation it was given. No address is asserted, only whether the
// pattern is in the bytes an allocation names.
//
// The pool is the child's destination row, and the destination is its front
// `DEST_LEN` bytes, at the address the child is linked at. A pool serves its
// free list first, so a kernel that let the destination's range go home at the
// release would serve its front to the next allocation, the scan would find
// the pattern while the child lives, and the launcher's write through its
// mapping would reach the child's data: the child then reports `pattern
// changed`.
//
// A look is `LOOK_LEN` bytes: a power of two so the mapping fits a protection
// entry on every profile, larger than the child's image (its arena is small,
// `tests/child-live-data`) and no larger than what the pool holds past the
// destination, so a look is served whether or not the destination came back.
//
// Each leg is a function of its own, for the reason `tests/memory-recycle`
// gives about root's stack.

import sos.{System, Process, Memory, Pool, Mapping, MapAccess, Event,
            SosStatus, SystemRight}

/// The child's destination: the front half of its region, which is twice this
/// long on every profile this case runs on.
static DEST_LEN: UInt = 0x2_0000

/// A look's length.
static LOOK_LEN: UInt = 0x1_0000

/// The tags the child's gives travel under.
static TAG_BOOT: UInt = 11
static TAG_READY: UInt = 51
static TAG_GO: UInt = 52

/// The child's pattern, as it writes it, and the word the launcher writes over
/// its first.
static W0: UInt32 = 0x51AB_C0DE
static W1: UInt32 = 0x0BAD_F00D
static W2: UInt32 = 0x1357_9BDF
static W3: UInt32 = 0x2468_ACE0
static CLOBBER: UInt32 = 0xDEAD_BEEF

/// What `Exited` with the child's intact verdict reads as through the status
/// word: `Exited` in the high half, the code in the low.
static STATUS_INTACT: UInt = 65_607

static NOT_FOUND: Int = -1

static RW: UInt32 = MapAccess.Read | MapAccess.Write

/// What a child of this launcher may ask its System object for.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// The most turns root yields waiting on the child.
static MAX_TURNS: Int = 100000

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

func peek(addr: UInt) unsafe -> UInt32 {
    UnsafeMemory<UInt32, Normal>(addr).read()
}

func poke(addr: UInt, value: UInt32) unsafe {
    UnsafeMemory<UInt32, Normal>(addr).write(value)
}

/// The byte offset in `[base, base + LOOK_LEN)` where the child's four words
/// begin, or `NOT_FOUND`.
func find_witness(base: UInt) unsafe -> Int {
    var off: UInt = 0
    while off + 16 <= LOOK_LEN {
        if peek(base + off) == W0 && peek(base + off + 4) == W1 &&
           peek(base + off + 8) == W2 && peek(base + off + 12) == W3 {
            return off as Int
        }
        off = off + 4
    }
    NOT_FOUND
}

/// Yield until `event` has been signalled.
func await_event(proc: &Process, event: &Event) -> Result<Void, SosStatus> {
    let me = try proc.thread_self()
    var turns = 0
    while turns < MAX_TURNS {
        let bits = try event.receive()
        if bits != 0 {
            return
        }
        let _ = me.yield_now()
        turns = turns + 1
    }
    return BUG
}

/// Yield until `child` has ended and answer its status word.
func await_end(proc: &Process, child: &Process) -> Result<UInt, SosStatus> {
    let me = try proc.thread_self()
    var turns = 0
    while turns < MAX_TURNS {
        let status = try child.get_status()
        if status != 0 {
            return status
        }
        let _ = me.yield_now()
        turns = turns + 1
    }
    return BUG
}

/// Give `child` a masked System and the two Events, and start it.
func launch(system: &System, child: &Process, ready: &Event,
            go: &Event) -> Result<Void, SosStatus> {
    let for_child = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let ready_sibling = try ready.mint()
    try child.give(event: move ready_sibling, tag: TAG_READY) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let go_sibling = try go.mint()
    try child.give(event: move go_sibling, tag: TAG_GO) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try child.start(boot_tag: TAG_BOOT)
    return
}

/// Allocate `LOOK_LEN` bytes from `pool`, map them into this process and say
/// whether the child's pattern is in them. With `clobber` set the first word of
/// the pattern is overwritten when found.
func look(proc: &Process, pool: &Pool,
         clobber: Bool) -> Result<Bool, SosStatus> {
    let piece = try pool.allocate(len: LOOK_LEN)
    let mapping = try proc.map(memory: &piece, access: RW)
    let base = try mapping.base()
    let at = find_witness(base)
    if at != NOT_FOUND && clobber {
        poke(base + (at as UInt), CLOBBER)
    }
    try mapping.unmap()
    return at != NOT_FOUND
}

func report(system: &System, found: Bool, while_alive: Bool) {
    if while_alive {
        if found {
            let _ = system.debug_print(
                "SOS desthold: while the child lives, witness found=1\n")
        } else {
            let _ = system.debug_print(
                "SOS desthold: while the child lives, witness found=0\n")
        }
    } else {
        if found {
            let _ = system.debug_print(
                "SOS desthold: after its death, witness found=1\n")
        } else {
            let _ = system.debug_print(
                "SOS desthold: after its death, witness found=0\n")
        }
    }
}

/// The whole sequence against one child.
func run(system: &System, proc: &Process, image: &Memory,
         pool: &Pool) -> Result<Void, SosStatus> {
    let dest = try pool.allocate(len: DEST_LEN)
    let child = try system.process_create(image: &image, memory: &dest)
    let ready = try proc.event_create()
    let go = try proc.event_create()
    try launch(&system, &child, &ready, &go)
    try await_event(&proc, &ready)
    let _ = system.debug_print("SOS desthold: child parked\n")

    let _ = move dest
    let _ = system.debug_print("SOS desthold: destination released\n")

    // The next allocation of a look's size, and whatever it holds.
    let alive = try look(&proc, &pool, true)
    let _ = system.debug_print(
        "SOS desthold: next allocation taken and mapped\n")
    report(&system, alive, true)

    try go.signal(1)
    let status = try await_end(&proc, &child)
    print("SOS desthold: child ended status={}\n", status)
    if status != STATUS_INTACT {
        return BUG
    }

    let after = try look(&proc, &pool, false)
    report(&system, after, false)
    return
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS desthold: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var image_record = try proc.boot_handle_next() catch {
        print("SOS desthold: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var pool_record = try proc.boot_handle_next() catch {
        print("SOS desthold: no destination pool: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let image = image_record.take_memory() else {
        let _ = system.debug_print(
            "SOS desthold: image record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let pool = pool_record.take_pool() else {
        let _ = system.debug_print(
            "SOS desthold: destination record is not a pool\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&system, &proc, &image, &pool) catch {
        print("SOS desthold: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS desthold: done\n")
    let _ = system.shutdown(EXIT_OK)
}
