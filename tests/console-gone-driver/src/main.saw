// A `uartproto` driver that ends before it serves anyone: it exits with
// `EXIT_GONE` at once, leaving its boot set undrained, so the server end it
// was given goes with it and every client's request answers `PeerClosed`.

import sos.{System}

/// The status it ends with, which its launcher reports.
static EXIT_GONE: UInt = 2

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)
    let proc = try system.process_self() catch { return }
    let _ = proc.exit(EXIT_GONE)
}
