// A process that never yields, for `tick_spinner`.
//
// It makes no syscall and holds no handle, so nothing it does can give the
// processor up; what takes it away is the scheduler tick. The loop is the
// whole program.

// The `sos` module is imported for the runtime, not the API: it pulls `sosrt`
// into this compilation unit, and `sosrt` defines the `__saw_rt_*` seams every
// freestanding image needs.
import sos.{System}

@export("_start")
func _start(boot_handle: UInt) {
    // Park the handle the kernel gave this process, which is nothing here:
    // the runtime's writer checks it and stays silent.
    let _ = System(boot_handle: boot_handle)

    while { }
}
