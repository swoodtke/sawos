// The runtime's arena under two levels (spec §7). Root's manifest puts `Low`
// at level 1, `Normal` at 2 and `High` at 3, and this image's kernel arms no
// tick, so the only switches are a thread's own and the Timer's wake.
//
// A Low thread takes a block from the arena and gives it back, in a loop that
// ends when the High thread says it is done. The High thread arms a one-shot
// Timer, parks on a Waiter attached to it, and on each fire takes a block,
// writes it, reads it back and gives it back, for `ROUNDS` rounds. A fire
// lands wherever the Low thread is, and most of the Low thread's time is
// inside the arena's window. Each window runs inside the section, so a fire
// that lands in one wakes the High thread and the kernel holds it back until
// the Low thread leaves: the High thread then finds the arena free. Were the
// window outside the section, the High thread would preempt the Low thread
// inside it, find the lock held and spin above the only thread that could
// give it back, for good.
//
// Every round is one such fire, so the chance that none lands inside a window
// is nil. What decides the case is that both threads finish, not how long
// they take or how many blocks the Low thread took, so nothing here reads
// the clock but the Timer's delay:
//
//   SOS rtarena: the High thread took and checked 100 blocks
//   SOS rtarena: the Low thread ended
//   SOS rtarena: done
//
// The first `thread_create(run:)` registers the section word, which the
// windows need.

import sos.{Priority, SosStatus, Thread}
import sosmain

// Declared as `std.alloc` declares them, since a program's declarations of one
// symbol must agree; `sosrt` defines them.
extern "C" {
    func __saw_rt_alloc(size: Int, align: Int) -> UnsafePointer<Int8>?
    func __saw_rt_dealloc(ptr: UnsafePointer<Int8>, size: Int, align: Int)
}

/// How many fires the High thread waits for.
static ROUNDS: Int = 100

/// The Timer's delay. Whenever it ends, the Low thread is running or about to.
static FIRE_NS: UInt64 = 100_000

static KEY_FIRE: UInt = 7

static LOW_BYTES: Int = 48
static HIGH_BYTES: Int = 64
static BLOCK_ALIGN: Int = 8
static FILL: UInt8 = 0xA5u8

/// Set by the High thread when its rounds are over.
static DONE: Atomic<Int> = Atomic(0)

/// Each thread's stack.
static STACK_WORDS: Int = 1024
unsafe static var STACK_HIGH: [UInt; STACK_WORDS] = [0; STACK_WORDS]
unsafe static var STACK_LOW: [UInt; STACK_WORDS] = [0; STACK_WORDS]

func top_of(base: UInt) -> UInt {
    base + (STACK_WORDS as UInt) * (sizeof<UInt>() as UInt)
}

func top_high() unsafe -> UInt {
    top_of(((&var STACK_HIGH) as UnsafePointer<UInt>) as UInt)
}

func top_low() unsafe -> UInt {
    top_of(((&var STACK_LOW) as UnsafePointer<UInt>) as UInt)
}

func main() -> Result<Void, SosStatus> {
    let high = try sosmain.context().process().thread_create(
        run: high_runs, arg: 0, stack_top: top_high())
    let low = try sosmain.context().process().thread_create(
        run: low_runs, arg: 0, stack_top: top_low())
    try high.start(band: Priority.High)
    try low.start(band: Priority.Low)
    let rounds = try high.join()
    print("SOS rtarena: the High thread took and checked {} blocks", rounds)
    let _ = try low.join()
    print("SOS rtarena: the Low thread ended")
    print("SOS rtarena: done")
    return
}

/// The High thread: one block a fire.
func high_runs(arg: UInt) sync -> UInt {
    fires()
    ROUNDS as UInt
}

func fires() unsafe sync {
    let clock = try sosmain.context().system().clock_get() catch {
        panic("SOS rtarena: no clock: {}", error)
    }
    let timer = try clock.timer_create() catch {
        panic("SOS rtarena: no timer: {}", error)
    }
    let waiter = try sosmain.context().process().waiter_create() catch {
        panic("SOS rtarena: no waiter: {}", error)
    }
    try waiter.add(timer: &timer, key: KEY_FIRE) catch {
        panic("SOS rtarena: the timer was not attached: {}", error)
    }
    var round = 0
    while round < ROUNDS {
        try timer.arm(after_ns: FIRE_NS) catch {
            panic("SOS rtarena: the timer was not armed: {}", error)
        }
        let _ = try waiter.wait() catch {
            panic("SOS rtarena: the wait was refused: {}", error)
        }
        take_and_check()
        round = round + 1
    }
    DONE.store(1)
}

/// A block, written and read back, and given back.
func take_and_check() unsafe sync {
    let block = __saw_rt_alloc(HIGH_BYTES, BLOCK_ALIGN)! as UInt
    var at: UInt = 0
    while at < (HIGH_BYTES as UInt) {
        UnsafeMemory<UInt8, Normal>(block + at).write(FILL)
        at = at + 1
    }
    at = 0
    while at < (HIGH_BYTES as UInt) {
        if UnsafeMemory<UInt8, Normal>(block + at).read() != FILL {
            panic("SOS rtarena: a block lost its bytes")
        }
        at = at + 1
    }
    __saw_rt_dealloc(block as UnsafePointer<Int8>, HIGH_BYTES, BLOCK_ALIGN)
}

/// The Low thread: a block and its return, until the High thread is done.
func low_runs(arg: UInt) sync -> UInt {
    churn()
    0
}

func churn() unsafe sync {
    while DONE.load() == 0 {
        let block = __saw_rt_alloc(LOW_BYTES, BLOCK_ALIGN)! as UInt
        __saw_rt_dealloc(block as UnsafePointer<Int8>, LOW_BYTES, BLOCK_ALIGN)
    }
}
