// The stats region is read-only, proved by dying on it.
//
// A denial can only be proved by meeting it. `stats-region` proves the page is
// readable and that its numbers are the kernel's own; this program proves the
// grant is read-only by storing into the page and not coming back.
//
// The transcript reads as three claims:
//
//   SOS statsro: read ok       <- the row is installed; this is not a program
//                                 that faults because it was never granted
//                                 anything
//   SOS statsro: writing       <- printed before the store, which does not
//                                 return
//   SOS: fault ...             <- the kernel's report, and the assertion
//
// The columns must not be writable: they are the kernel's account of what every
// process has cost the machine, and a writer could lie to every supervisor
// about its own traffic and its peers'. The region hands out read only, and
// `MapAccess.Write` never appears on this op's path.
//
// This case runs on the isolated tier only. The assertion is denial by the
// hardware, which the `Flat` tier disclaims: on a flat platform the store
// lands, this program runs on and prints its UNREACHABLE line, and the case
// would fail by omission. The runner excludes it there by name with its reason.

import sos.{System, Process, StatsRegion, ProcessStats, SosStatus}

static EXIT_FAILED: UInt = 1

/// The value this program tries to force into the kernel's counters. Its
/// arrival anywhere would be the bug; it appears in no expectation.
static LIE: UInt64 = 0x7777_7777

func poke(addr: UInt, value: UInt64) unsafe {
    UnsafeMemory<UInt64, Normal>(addr).write(value)
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let region = try system.stats_region_map() catch {
        print("SOS statsro: map failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The row is really there. Without this read a fault below would prove
    // nothing, since an address that was never granted faults too. Reading a
    // column first makes the fault a statement about the access bits rather
    // than about the mapping.
    let mine = region.mine()
    if mine.syscalls == 0 {
        let _ = system.debug_print("SOS statsro: own row reads zero syscalls\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS statsro: read ok\n")

    // Printed before the store, because the store does not return. This is the
    // last thing the program says; the kernel's fault report is the next line in
    // the transcript.
    let _ = system.debug_print("SOS statsro: writing\n")

    poke(region.base, LIE)

    // Unreachable on hardware that can deny. A build that gets here has let a
    // process write the kernel's own accounting, so it fails loudly rather than
    // shutting down cleanly.
    let _ = system.debug_print("SOS statsro: UNREACHABLE\n")
    let _ = system.shutdown(EXIT_FAILED)
}
