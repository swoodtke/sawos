// SOS M2 unit 3: a thread PARKS on a Waiter and another thread's signal wakes
// it (design 178 D5; spec §2.2, §2.4).
//
// The transcript is read as an ORDER, and the order is the whole claim:
//
//   SOS wake: worker started, parking     <- the initial thread, before wait()
//   SOS wake: worker signalling           <- the OTHER thread, which could only
//                                            have run because the first parked
//   SOS wake: woke key=77 at-wait=1 after=4
//   SOS wake: joined worker=99
//
// THE TWO NUMBERS ARE ONE ARITHMETIC CLAIM, and it is the third thing this case
// proves. The worker signals five times. The FIRST signal is what wakes the
// parked thread, so the record it copied out says 1 — and the delivery TAKES
// that 1, which is the Aug-17 ruling. The other four land while the woken thread
// is still only runnable and accumulate from zero, so the `receive` that follows
// reads 4. One plus four is five: nothing was lost and nothing was counted
// twice, which is exactly what the old snapshot semantics could not say — it
// answered 1 and 5, with the 1 reported to nobody's cost.
//
// A `wait` that answered without parking would put the middle line last, since
// nothing else can move the processor: this image's kernel arms NO timer, and
// `start` only makes a thread runnable — it does not switch. So the second line
// arriving in the middle means the first thread really did block, and the third
// means the signal really did carry the key and the readiness back into its
// frame.
//
// EVERY THREAD ENTERS AT `_start` and works out which it is from the parked
// boot handle, for the reason `thread-basics` gives (DF-178c: Saw cannot name a
// function's address, so `thread_create` has no entry to be handed).
//
// HOW TWO THREADS SHARE A KERNEL OBJECT, since this is the first program that
// needs to. NOT by passing a handle word — the `sos` module offers no way to
// take one out of a typed handle, which is the ruled guarantee. And NOT by
// sharing the wrapper VALUE, which is what this program used to do: since sawos
// design 3 a handle wrapper is `NoCopy` and its drop RELEASES the handle, so two
// copies would be two owners of one word and the second drop would be a
// `BadHandle` fault the program did nothing to deserve.
//
// **BY ADDRESS.** The initial thread stays the sole OWNER — its `Event` lives in
// its frame for the whole run, since it is parked inside `wait()` while the
// worker runs — and it parks a POINTER to that owned value where the worker can
// find it. The worker BORROWS through the pointer to call `signal`, which takes
// `&self` and moves nothing. One owner, one release, exactly as the type system
// would enforce if a reference could cross a thread boundary; the pointer is the
// unsafe-tier spelling of a borrow the checker cannot see, which is what this
// file already does for the worker's stack.
//
// WHAT WOULD BE BETTER, recorded rather than worked around: each thread holding
// its OWN handle onto the one Event. Mint-per-call (design 3 D-4) is exactly
// that shape, but the getters that mint are System's and Process's — there is no
// op that hands out a second handle onto an Event a process already owns, so
// there is nothing to call. Unit 3's `give` is where that arrives.

import sos.{System, Process, Thread, Event, EventMode, Waiter, WaitResult,
            WaitPayload}

/// The boot handle, parked for the worker — and the witness that says which
/// thread `_start` is running as (handle 0 names nothing, so a parked one is
/// never 0).
unsafe static var BOOT_HANDLE: UInt = 0

/// WHERE the initial thread's Event lives, for the worker to borrow through.
///
/// An ADDRESS and not the value, because a handle wrapper is `NoCopy` with a
/// releasing deinit (sawos design 3 D-5) and so may have exactly one owner — and
/// because a static could not hold one anyway: statics are immortal and never
/// run a deinit, which the compiler refuses outright. Zero means "not parked
/// yet", which no real address is.
unsafe static var SHARED_EVENT_AT: UInt = 0

static STACK_WORDS: Int = 1024
unsafe static var STACK_W: [UInt64; STACK_WORDS] = [0; STACK_WORDS]

static BYTES_PER_WORD: UInt = 8
static STACK_ALIGN: UInt = 16

/// The key the initial thread attaches under, and expects back.
static ATTACH_KEY: UInt = 77

/// What the worker signals: a count, because the shared event is a counting one
/// and five is a number no bit pattern in this file could produce by accident.
static SIGNAL_TIMES: Int = 5
static ONE: UInt = 1

static WORKER_ROLE: UInt = 1
static WORKER_EXIT: UInt = 99

static YES: UInt = 1
static NO: UInt = 0
static NO_VALUE: UInt = 0xDEAD

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

func flag(b: Bool) -> UInt {
    if b { YES } else { NO }
}

/// The word the WAIT reported, out of the record the kernel copied into this
/// process's memory while this thread was parked — which is the interesting
/// part: the writer was the OTHER thread's signal, and this buffer is on the
/// parked thread's own stack.
func at_wait(r: &WaitResult) -> UInt {
    match r.what {
        case Event(word) -> word,
        case Interrupt(_) -> panic("this program attached no interrupt"),
        case Timer(_) -> panic("this program attached no timer"),
        case Process(_) -> panic("this program attached no process"),
    }
}

func stack_top(base: UInt) -> UInt {
    let top = base + (STACK_WORDS as UInt) * BYTES_PER_WORD
    top - (top % STACK_ALIGN)
}

func worker_stack_top() unsafe -> UInt {
    stack_top(((&var STACK_W) as UnsafePointer<UInt64>) as UInt)
}

func park_boot_handle(word: UInt) unsafe {
    BOOT_HANDLE = word
}

func parked_boot_handle() unsafe -> UInt {
    BOOT_HANDLE
}

/// Park the address of the OWNER's Event. The owner keeps it; this records only
/// where it is.
func park_event(e: &Event) unsafe {
    SHARED_EVENT_AT = ((&e) as UnsafePointer<Event>) as UInt
}

/// Signal the shared Event, borrowed through the parked address.
///
/// The borrow is sound because of WHERE the owner is when this runs: the initial
/// thread is parked inside `waiter.wait()`, so its frame — and the `Event` in it
/// — is alive for the whole of the worker's life. A status is discarded here for
/// the reason `signal` cannot meaningfully fail: §2.4 says accumulating never
/// blocks and never runs out of room.
func signal_shared(bits: UInt) unsafe {
    let at = SHARED_EVENT_AT as UnsafePointer<Event>
    let _ = at[0].signal(bits)
}

/// The worker: say so, signal, leave.
///
/// It derives its own authority off the parked boot handle rather than being
/// handed any — `System(boot_handle:)` -> `process_self()` -> `thread_self()` —
/// and reaches the Event out of the process's own memory.
func worker() {
    let system = System(boot_handle: parked_boot_handle())
    let proc = try system.process_self() catch { return }
    let me = try proc.thread_self() catch { return }

    let _ = system.debug_print("SOS wake: worker signalling\n")

    var n = 0
    while n < SIGNAL_TIMES {
        // §2.4: signalling NEVER blocks, whether or not anyone is parked. The
        // first of these is the one that wakes the sleeper — and the wake TAKES
        // it — so the rest accumulate from zero, which is what makes the word
        // left behind four and not five.
        signal_shared(ONE)
        n = n + 1
    }

    let _ = me.exit(WORKER_EXIT)
}

/// The initial thread: build the wait set, start the worker, park.
func initial(boot_handle: UInt) {
    park_boot_handle(boot_handle)

    let system = System(boot_handle: boot_handle)
    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS wake: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let waiter = try proc.waiter_create() catch {
        print("SOS wake: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let event = try proc.event_create(mode: EventMode.SaturatingSum) catch {
        print("SOS wake: no event: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = waiter.add(&event, ATTACH_KEY)
    // The OWNER stays here, in this frame, for the whole run; the worker is told
    // only where it is.
    park_event(&event)

    let w = try proc.thread_create(stack_top: worker_stack_top(),
                                   arg: WORKER_ROLE) catch {
        print("SOS wake: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = w.start()

    // `start` makes the worker RUNNABLE; it does not switch to it. So this line
    // is printed by a thread that still holds the processor, and the worker
    // cannot say anything until this thread gives it up — which the wait below
    // is the only thing here that does.
    let _ = system.debug_print("SOS wake: worker started, parking\n")

    let report = try waiter.wait() catch {
        print("SOS wake: wait failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let left: UInt = match event.receive() {
        case Ok(v) -> v,
        case Err(_) -> NO_VALUE,
    }
    print("SOS wake: woke key={} at-wait={} after={}\n",
          report.key, at_wait(&report), left)

    // The worker exited on its way out of `signal`, so this join answers out of
    // its slot rather than parking again.
    let code: UInt = match w.join() {
        case Ok(v) -> v,
        case Err(_) -> NO_VALUE,
    }
    print("SOS wake: joined worker={}\n", code)

    let _ = proc.exit(EXIT_OK)
}

@export("_start")
func _start(arg: UInt) {
    if parked_boot_handle() == 0 {
        initial(arg)
    } else {
        worker()
    }
}
