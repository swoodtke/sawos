// Child that reaches for a right its keep mask left out.
//
// `root-server-oversteps` is this program one privilege level up: a process
// that tries something it was not given, so the refusal can be read rather
// than assumed. The difference is what stops it. Root oversteps into the
// kernel's memory and the hardware refuses; this child oversteps into an
// authority and the rights word refuses.
//
//   SOS childover: I can print, so Debug travelled
//   SOS childover: now trying to stop the machine
//   SOS: process fault: access denied process=1     <- the child, not root
//   SOS: process teardown ... process=1
//
// The first line is half the claim. A keep mask is a set, not a wall around a
// process: `Debug` was named, so this program has a voice, and being able to
// announce what it is about to try is the positive half of the attenuation.
// A case that only showed the refusal could not tell "the mask worked" from
// "the handle was broken".
//
// The fault names process 1. Overstepping ends the process that overstepped
// (a rights bit that was masked off rather than never minted) and the machine
// keeps running, which lets the launcher print its own line afterwards. A
// kernel that stopped on any process's death would end the run here.
//
// It names no architecture and builds for either profile unchanged.

import sos.{System, SosStatus}

@export("_start")
func _start(boot_handle: UInt) {
    // The same adoption root writes. Only the rights word behind the handle
    // differs: this one is a sibling a launcher minted through a mask.
    let system = System(boot_handle: boot_handle)

    let _ = system.debug_print("SOS childover: I can print, so Debug travelled\n")
    let _ = system.debug_print("SOS childover: now trying to stop the machine\n")

    // Refused, and it does not return. `Shutdown` was absent from the keep
    // mask, and a masked bit is not recoverable by any sequence of ops: a
    // mint's result is a subset of its source.
    let _ = system.shutdown(0)

    // Unreachable. A child that somehow got past the line above has nowhere to
    // go, so it spins inside its own granted region and the harness catches it
    // as a timeout rather than as a pass.
    while { }
}
