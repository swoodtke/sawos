// SOS M4 unit 3: THE COMPOSED BLOCKING SENDS (sawos design 15; spec §2.1's
// ratified client API; `designs/010` ruling 4).
//
// **§2.1's `send(msg)` AND `send(msg, timeout:)` HAVE BEEN RATIFIED SINCE JULY
// AND HAD NOTHING TO PARK ON UNTIL NOW.** They are LIBRARY compositions over
// ops that already shipped — post, attach, wait, plus a Timer on the same
// Waiter — which is what keeps the kernel from ever learning what a timeout is
// (ruling 4). This is the only case in the unit whose threads genuinely BLOCK.
//
//   SOS childserver: replied         the child parked on its outlet, was woken
//                                    by root's post, took, and answered
//   SOS: process exit: code=4        ...and ended
//   SOS sendblock: send got len=4 b=80,79,78,71
//                                    root's `send` parked on the claim and woke
//                                    with `PONG` IN THE WAIT RECORD — no
//                                    `resolve` anywhere on this path (ruling
//                                    11(a) deleted that leg)
//   SOS sendblock: timed out         a second connection nobody serves: the
//                                    Timer won, and the claim came back LIVE
//   SOS sendblock: after cancel ...  ...and dropping that live claim is §2.1's
//                                    cancellation primitive, which the server's
//                                    later `reply` is told about
//
// **THE ORDER IS THE PROOF.** Root's `send` cannot complete before the child
// runs, and the child cannot run before root parks, so the transcript's
// interleaving is what says two threads in two processes each woke the other
// exactly once. A polling implementation of either half would print the same
// bytes with none of that.
//
// **THE TIMEOUT ARM IS THE `TimedOut(pending:)` SHAPE, EXERCISED.** A timeout
// does not cancel anything — the server may still be working — so the error
// payload carries the STILL-LIVE claim and the caller decides. Here the caller
// drops it, which is the cancellation primitive, and the connection's own outlet
// is then used to show that the server learns.
//
// ONE PHASE PER FUNCTION, on design 14 finding 3's stack ceiling.

import sos.{System, Process, Clock, ClockType, Timer, Waiter, PipeInlet,
            PipeOutlet, PipeReply, PipeRequest, PipeClient, SendOutcome,
            ReplyDelivery, SosStatus, SystemRight, PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// ROOT'S CONFIG, and the whole of the contract with the child. `child-server`
/// expects exactly these words; the kernel supplies no meaning for either.
static TAG_BOOT: UInt = 7
static TAG_OUTLET: UInt = 12

/// What a child of this launcher may ask its System object for: print, learn its
/// own Process object, and pass a handle on. `Transfer` is in the mask for the
/// reason `give-boot-drain` records — it is the ticket the give itself checks.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// The request's length and bytes: `PING`.
static PING_LEN: UInt = 4

/// The unserved connection's one-byte message length.
///
/// **A `static` AND NOT A LITERAL, and the reason is an overload set.** `send`
/// has two members, so a bare `len: 1` is not resolved against a single `UInt`
/// parameter and does not adopt the width — the call is refused with
/// ``argument 2 expects `UInt` but got `Int` ``. Naming the number types it once
/// and reads better than a suffix would; recorded as sawos design 15's finding
/// on bare literals at overloaded call sites.
static TIMEOUT_MSG_LEN: UInt = 1

/// Five milliseconds. Long enough that a working machine never trips it on the
/// SERVED connection, short enough that the unserved one gives up promptly.
static TIMEOUT_NS: UInt64 = 5_000_000

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS sendblock: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    try round_trip(&system, &proc) catch {
        print("SOS sendblock: round trip failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try timed_out(&system, &proc) catch {
        print("SOS sendblock: timeout arm failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    print("SOS sendblock: done\n")
    let _ = proc.exit(EXIT_OK)
}

/// **THE BLOCKING ROUND TRIP, ACROSS A PROCESS BOUNDARY.**
///
/// Root creates the connection, GIVES the server end to a child, and then calls
/// `send` — which posts, attaches its claim and parks. Nothing else in root is
/// runnable, so the kernel runs the child; the child parks on its outlet, is
/// woken by the post that already happened (level-triggered, so the order does
/// not matter), takes, and replies. That reply is what wakes root, and the bytes
/// are in the record it wakes with.
func round_trip(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var image = try proc.boot_handle_next()
    var dest = try proc.boot_handle_next()
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem, memory: &dest_mem)

    let pair = try proc.pipe_create()
    let (inlet, outlet) = move pair
    let waiter = try proc.waiter_create()

    let for_child = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move for_child, tag: TAG_BOOT)
    // THE SERVER END LEAVES ROOT ENTIRELY. Root keeps the inlet and nothing
    // else, so the only way it can learn anything is from the child's reply.
    try child.give(outlet: move outlet, tag: TAG_OUTLET)
    let _ = system.debug_print("SOS sendblock: gave the outlet\n")

    try child.start(boot_tag: TAG_BOOT)

    // **THE WRAPPER OWNS THE WAITER** (ruling 4: "blocking a reply requires a
    // Waiter, which the wrapper owns"). From here the composition is one call.
    let client = PipeClient(over: move inlet, using: move waiter)

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 80
    msg[1] = 73
    msg[2] = 78
    msg[3] = 71

    // THIS BLOCKS. It returns when the child answers, and what it returns is the
    // answer itself.
    let answer = try client.send(body: &msg, len: PING_LEN)
    print("SOS sendblock: send got len={} b={},{},{},{}\n", delivery_len(&answer),
          delivery_byte(&answer, 0), delivery_byte(&answer, 1),
          delivery_byte(&answer, 2), delivery_byte(&answer, 3))
    return
}

/// **NOBODY SERVES THIS CONNECTION, SO THE TIMER WINS** — and the claim comes
/// back alive.
///
/// Root holds both ends and never takes, so the reply level can never rise; the
/// Timer on the same Waiter is what ends the wait, which is the whole of what
/// ruling 4 says a timeout is. `TimedOut(pending:)` then carries the claim,
/// which is §2.1's ratified shape and the reason the outcome is an enum rather
/// than a status.
///
/// Dropping that claim is the cancellation primitive. The outlet is still root's,
/// so the second half of the phase plays the server and is told what §2.1
/// ratifies it should be told.
func timed_out(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    let pair = try proc.pipe_create()
    let (inlet, outlet) = move pair
    let waiter = try proc.waiter_create()
    let clock = try system.clock_get(type: ClockType.Monotonic)
    let timer = try clock.timer_create()

    let client = PipeClient(over: move inlet, using: move waiter)

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    var buf: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 1

    let outcome = try client.send(body: &msg, len: TIMEOUT_MSG_LEN,
                                  timeout: &timer,
                                  after_ns: TIMEOUT_NS)
    match outcome {
        case Replied(_) -> {
            let _ = system.debug_print("SOS sendblock: an unserved pipe replied\n")
            return SosStatus.Revoked
        },
        case TimedOut(pending) -> {
            let _ = system.debug_print("SOS sendblock: timed out\n")
            // **THE CANCELLATION.** The claim is live and it is ours; dropping
            // it is how §2.1 says a client gives up, and it needs no verb.
            let _ = move pending
        },
    }

    // Now play the server on the connection the client gave up on. The message
    // is still staged — abandoning a claim does not un-send what was sent — so
    // the take succeeds and the reply is what carries the news.
    let got = try outlet.take(into: &var buf)
    guard let (_, request) = move got else { return SosStatus.Revoked }
    var obligation = move request
    match obligation.reply(body: &msg, len: TIMEOUT_MSG_LEN) {
        case Ok(_) -> {
            let _ = system.debug_print("SOS sendblock: a cancelled claim took a reply\n")
            return SosStatus.Revoked
        },
        case Err(e) -> { print("SOS sendblock: after cancel {}\n", e) },
    }
    return
}

/// How many bytes this delivery carries.
func delivery_len(d: &ReplyDelivery) -> UInt {
    match d {
        case Data(msg) -> msg.len,
        case PeerClosed -> 0,
    }
}

/// Byte `i` of it, read through a borrow — which is what makes `PipeMsg` being
/// `NoCopy` cost a caller nothing.
func delivery_byte(d: &ReplyDelivery, i: Int) -> UInt {
    match d {
        case Data(msg) -> msg.bytes[i] as UInt,
        case PeerClosed -> 0,
    }
}
