// A destination held by nothing but its child's stack row stays out of its
// pool until the child's death (spec §2.5, §5.6, §2.10).
//
//   SOS stackheld: a child in its destination, the handle released
//   SOS stackheld: while the child lives, its destination held=1
//   SOS-H                                          the child
//   SOS stackheld: the child exited from its image
//   SOS stackheld: after its death the destination came home=1
//
// The child is used in place in its image blob, so no segment of it is copied
// into its destination and the one grant row the destination's bytes carry is
// the stack the kernel grants at its top. Root allocates the destination off
// the front of the destination row, typed as a pool, creates the child in it
// and releases its only handle before starting it. The row is a reference on
// the destination, so the release leaves a husk and `available` is what it was
// while the allocation was out (`held=1`). The child then runs, prints and
// exits; its teardown removes the row and the destination's bytes come home,
// the pool whole again (`home=1`).

import sos.{System, Process, Memory, Pool, SosStatus, SystemRight}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.Unknown

/// The destination: more than the stack the kernel takes off its top.
static DEST_LEN: UInt = 0x8000

static TAG_BOOT: UInt = 21
static KEY_DEATH: UInt = 6

/// What the child may ask its System object for: printing and its own Process
/// handle; `Transfer` is what lets root give it.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// The status word of the child's exit with its own code, 0x48: `Exited` in
/// the high half and the code in the low.
static EXITED_MARK: UInt = 65608

static_assert((1 * 65536) + 0x48 == 65608,
              "an exit's status word is Exited in the high bits and the code")

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS stackheld: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&system, &proc) catch {
        print("SOS stackheld: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS stackheld: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func flag(b: Bool) -> UInt {
    if b { 1 } else { 0 }
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var blob_rec = try proc.boot_handle_next()
    var dest_rec = try proc.boot_handle_next()
    guard let image = blob_rec.take_memory() else { return BUG }
    guard let pool = dest_rec.take_pool() else { return BUG }

    let fresh = try pool.available()
    let dest = try pool.allocate(len: DEST_LEN)
    let lent = try pool.available()
    let child = try system.process_create(image: &image, memory: &dest)
    let _ = move dest
    let _ = system.debug_print(
        "SOS stackheld: a child in its destination, the handle released\n")
    let held = try pool.available()
    print("SOS stackheld: while the child lives, its destination held={}\n",
          flag(held.total == lent.total && held.largest == lent.largest))

    try start(&system, &child)
    try wait_exit(&proc, &child)
    let _ = system.debug_print(
        "SOS stackheld: the child exited from its image\n")
    let home = try pool.available()
    print("SOS stackheld: after its death the destination came home={}\n",
          flag(home.total == fresh.total && home.largest == fresh.largest))
    return
}

func start(system: &System, child: &Process) -> Result<Void, SosStatus> {
    let boot = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move boot, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try child.start(boot_tag: TAG_BOOT)
    return
}

func wait_exit(proc: &Process, child: &Process) -> Result<Void, SosStatus> {
    let waiter = try proc.waiter_create()
    try waiter.add(process: &child, key: KEY_DEATH)
    let wake = try waiter.wait()
    let (key, what) = (move wake).open()
    match what {
        case Process(status) -> {
            if key != KEY_DEATH { return BUG }
            if status != EXITED_MARK {
                print("SOS stackheld: the child ended with status {}\n", status)
                return BUG
            }
        },
        case _ -> { return BUG },
    }
    return
}
