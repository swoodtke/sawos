// SOS M4 unit 4.5: RESOLVE PARKS (sawos design 22; `designs/010` ruling 12(b);
// spec §2.1).
//
// **THE WAITER-FREE BLOCKING RECEIVE.** Root posts and then RESOLVES, with no
// Waiter, no attachment and no poll loop — and the resolve finds the exchange
// pending, so it parks the calling thread on the claim's ready level inside the
// kernel. A child server takes the message and replies, and that reply is what
// wakes root, inside its own syscall, with the bytes in its own buffer.
//
// **REACHING THE END IS THE PROOF.** Through unit 4 a pending resolve answered
// `WouldBlock` and consumed nothing, so this exact program would have fallen
// through with no reply and failed its own length check. There is nothing else
// in root that could have produced the answer: no Waiter exists in this process
// at all.
//
// **THE ORDER IS THE SECOND HALF OF IT.** `SOS childserver: replied` comes
// BEFORE root's row, because root parked with nothing else runnable and the
// kernel had to go find the child; the child parked on its OUTLET and was woken
// by root's post; its reply is what woke root. A polling implementation of
// either half would print the same bytes with none of that interleaving.
//
// **AND THE TWO SPELLINGS ARE MEASURED SIDE BY SIDE** (sawos design 16's
// bracket, `pipe-send-manual`'s own arithmetic). The same exchange, the same
// server, the same four bytes each way:
//
//   SOS resolvepark: ops resolve=2 fused=1
//
// TWO against ONE. `post` + `resolve` is the composition a client writes when it
// wants a HANDLE on the exchange — one it could have given away, or attached, or
// dropped as a cancellation — and `PipeInlet.send` is the fused path for a client
// that wants none of that. Unit 3's `post + attach + wait` was THREE for the same
// answer, which is what ruling 12(b) took a trap out of.
//
// ONE PHASE PER FUNCTION, on design 14 finding 3's stack ceiling.

import sos.{System, Process, PipeInlet, PipeOutlet, PipeReply, SosStatus,
            SystemRight, PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// ROOT'S CONFIG, and the whole of the contract with the child. `child-server`
/// expects exactly these words; the kernel supplies no meaning for either.
static TAG_BOOT: UInt = 7
static TAG_OUTLET: UInt = 12

/// What a child of this launcher may ask its System object for: print, learn its
/// own Process object, and pass a handle on.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// The request's length and bytes: `PING`. The reply is `PONG`, which is
/// `child-server`'s.
static PING_LEN: UInt = 4

static BUG: SosStatus = SosStatus.Revoked

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS resolvepark: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    try round_trip(&system, &proc) catch {
        print("SOS resolvepark: round trip failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    print("SOS resolvepark: done\n")
    let _ = proc.exit(EXIT_OK)
}

/// **POST, PARK IN THE RESOLVE, WAKE WITH THE ANSWER — and then the same
/// exchange fused, for the arithmetic.**
///
/// Root creates the connection, GIVES the server end to a child, and keeps the
/// inlet and nothing else: the only way it can learn anything is from the
/// child's reply.
func round_trip(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var image = try proc.boot_handle_next()
    var dest = try proc.boot_handle_next()
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem, memory: &dest_mem)

    let pair = try proc.pipe_create()
    let (inlet, outlet) = move pair

    let for_child = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move for_child, tag: TAG_BOOT)
    try child.give(outlet: move outlet, tag: TAG_OUTLET)
    let _ = system.debug_print("SOS resolvepark: gave the outlet\n")

    try child.start(boot_tag: TAG_BOOT)

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 80
    msg[1] = 73
    msg[2] = 78
    msg[3] = 71

    // **THE MEASURED WINDOW OPENS HERE** (sawos design 16). Two calls, nothing
    // else inside the brackets: every printed byte is an `ecall`, so a window
    // with a `print` in it would count the prose instead of the composition.
    let before = try proc.stats()

    // 1. POST. The ring is fresh, so it cannot refuse.
    let claim = try inlet.post(body: &msg, len: PING_LEN)

    // 2. RESOLVE. **THIS BLOCKS**, and there is no Waiter anywhere in this
    //    process to have blocked on: the claim's own ready level is what the
    //    kernel parks the thread against, and the wake arm that answers it is
    //    the fused call's, generalized (`designs/010` ruling 12(b)). The move is
    //    the typed half — the claim is spent on every path this can return
    //    through, so the binding is dead past this expression.
    let answer = try (move claim).resolve()

    // **AND CLOSES HERE, WITH ITS OWN TRAP INSIDE THE COUNT.** `ktrap` charges
    // the syscall column at trap entry, ahead of the dispatch, so this reading
    // includes the call that took it:
    //
    //     delta = post + resolve + this read = 2 + 1 = 3
    let after = try proc.stats()

    if answer.len != PING_LEN { return BUG }
    print("SOS resolvepark: reply len={} b={},{},{},{}\n", answer.len,
          answer.bytes[0], answer.bytes[1], answer.bytes[2], answer.bytes[3])

    // **THE SAME EXCHANGE THE OTHER WAY.** Same connection, same server, same
    // four bytes each way — the only thing that differs is the spelling.
    // `child-server` answers twice for exactly this reason and nothing about the
    // server side differs between the two turns.
    let fused_before = try proc.stats()
    let fused = try inlet.send(body: &msg, len: PING_LEN)
    let fused_after = try proc.stats()

    if fused.len != PING_LEN { return BUG }
    print("SOS resolvepark: fused reply len={} b={},{},{},{}\n", fused.len,
          fused.bytes[0], fused.bytes[1], fused.bytes[2], fused.bytes[3])

    // **THE COMPANION ROW.** Each delta carries its own closing `stats()` trap,
    // so subtracting one from each leaves the OPS the caller wrote: post +
    // resolve against `send`. Two against one, measured by the same process
    // against the same server in the same boot.
    //
    // The fused call also mints NOTHING, which the trap count does not show: the
    // composition holds a `PipeReply` entry for the length of the exchange and
    // the fused path holds no table row at all. What the composition buys for
    // that row is a NAME on the exchange — one it could have given away,
    // attached, or dropped as §2.1's cancellation.
    print("SOS resolvepark: ops resolve={} fused={}\n",
          (after.syscalls - before.syscalls) - 1,
          (fused_after.syscalls - fused_before.syscalls) - 1)
    return
}
