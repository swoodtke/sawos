// Resolve parks (spec §2.1).
//
// The waiter-free blocking receive. Root posts and then resolves, with no
// Waiter, no attachment and no poll loop. The resolve finds the exchange
// pending, so it parks the calling thread on the claim's ready level inside the
// kernel. A child server takes the message and replies, and that reply wakes
// root, inside its own syscall, with the bytes in its own buffer.
//
// Reaching the end is the proof. A resolve that answered `WouldBlock` on a
// pending exchange would return an error and end this program with no reply,
// and nothing else in root could have produced the answer: no Waiter exists in
// this process at all.
//
// The order is the second half of it. `SOS childserver: replied` comes before
// root's row, because root parked with nothing else runnable and the kernel had
// to go find the child; the child ran, took the message already waiting on its
// outlet and replied; that reply is what woke root. A polling implementation
// would print the same bytes with none of that blocking.
//
// The two spellings are measured side by side: the same exchange, the same
// server, the same four bytes each way.
//
//   SOS resolvepark: ops resolve=2 fused=1
//
// `post` + `resolve` (two) is the composition a client writes when it wants a
// handle on the exchange, one it could give away, attach, or drop as a
// cancellation. `PipeInlet.send` (one) is the fused path for a client that
// wants none of that. Post + attach + wait would be three for the same answer.
//
// One phase per function, because of the stack ceiling.

import sos.{System, Process, PipeInlet, PipeOutlet, PipeReply, SosStatus,
            SystemRight, PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// Root's config, and the whole of the contract with the child. `child-server`
/// expects exactly these words; the kernel supplies no meaning for either.
static TAG_BOOT: UInt = 7
static TAG_OUTLET: UInt = 12

/// What a child of this launcher may ask its System object for: print, learn its
/// own Process object, and pass a handle on.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// The request's length and bytes: `PING`. The reply is `PONG`, which is
/// `child-server`'s.
static PING_LEN: UInt = 4

static BUG: SosStatus = SosStatus.Revoked

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS resolvepark: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    try round_trip(&system, &proc) catch {
        print("SOS resolvepark: round trip failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    print("SOS resolvepark: done\n")
    let _ = proc.exit(EXIT_OK)
}

/// Post, park in the resolve, wake with the answer, and then the same exchange
/// fused, for the arithmetic.
///
/// Root creates the connection, gives the server end to a child, and keeps the
/// inlet and nothing else: the only way it can learn anything is from the
/// child's reply.
func round_trip(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var image = try proc.boot_handle_next()
    var dest = try proc.boot_handle_next()
    let image_mem = image.take_memory()!
    let dest_mem = dest.take_memory()!

    let child = try system.process_create(image: &image_mem, memory: &dest_mem)

    let pair = try proc.pipe_create()
    let (inlet, outlet) = move pair

    let for_child = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try child.give(outlet: move outlet, tag: TAG_OUTLET) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let _ = system.debug_print("SOS resolvepark: gave the outlet\n")

    try child.start(boot_tag: TAG_BOOT)

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 80
    msg[1] = 73
    msg[2] = 78
    msg[3] = 71

    // The measured window opens here. Two calls, nothing else inside the
    // brackets: every printed byte is a syscall, so a window with a `print` in
    // it would count the prose instead of the composition.
    let before = try proc.stats()

    // 1. Post. The ring is fresh, so it cannot refuse.
    let claim = try inlet.post(body: &msg, len: PING_LEN)

    // 2. Resolve. This blocks, and there is no Waiter anywhere in this process
    //    to have blocked on: the kernel parks the thread against the claim's
    //    own ready level, and the wake that answers it is the fused call's. The
    //    move is the typed half: the claim is spent on every path this can
    //    return through, so the binding is dead past this expression.
    let answer = try (move claim).resolve()

    // The window closes here, with its own trap inside the count. `ktrap`
    // charges the syscall column at trap entry, ahead of the dispatch, so this
    // reading includes the call that took it:
    //
    //     delta = post + resolve + this read = 2 + 1 = 3
    let after = try proc.stats()

    if answer.len != PING_LEN { return BUG }
    print("SOS resolvepark: reply len={} b={},{},{},{}\n", answer.len,
          answer.bytes[0], answer.bytes[1], answer.bytes[2], answer.bytes[3])

    // The same exchange the other way. Same connection, same server, same four
    // bytes each way; only the spelling differs. `child-server` answers twice
    // for exactly this reason and nothing about the server side differs
    // between the two turns.
    let fused_before = try proc.stats()
    let fused = try inlet.send(body: &msg, len: PING_LEN)
    let fused_after = try proc.stats()

    if fused.len != PING_LEN { return BUG }
    print("SOS resolvepark: fused reply len={} b={},{},{},{}\n", fused.len,
          fused.bytes[0], fused.bytes[1], fused.bytes[2], fused.bytes[3])

    // The companion row. Each delta carries its own closing `stats()` trap, so
    // subtracting one from each leaves the ops the caller wrote: post + resolve
    // against `send`. Two against one, measured by the same process against the
    // same server in the same boot.
    //
    // The fused call also mints nothing, which the trap count does not show:
    // the composition holds a `PipeReply` entry for the length of the exchange
    // and the fused path holds no table row at all. What the composition buys
    // for that row is a name on the exchange, one it could give away, attach,
    // or drop as §2.1's cancellation.
    print("SOS resolvepark: ops resolve={} fused={}\n",
          (after.syscalls - before.syscalls) - 1,
          (fused_after.syscalls - fused_before.syscalls) - 1)
    return
}
