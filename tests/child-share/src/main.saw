// SOS CHILD: THE FAR END OF A SHARED PAGE (sawos design 9 D-3) —
// `share-double-map`'s other half.
//
// **IT HOLDS NO `Memory` HANDLE, AND ITS BOOT SET IS EMPTY.** The only thing
// this process was ever given is a masked System handle, delivered in its first
// argument register and CONSUMED by the start that named its tag — so
// `boot_handle_next` would answer `Drained` and this program never calls it.
// The page it reads and writes below is in its domain for exactly one reason:
// its launcher installed a protection row there, spending `MemoryRight.Map` on a
// region THE LAUNCHER still holds and `ProcessRight.Map` on this process.
//
// That is ACCESS WITHOUT POSSESSION, and it is the deliberate contrast with the
// unit's driver child, which was GIVEN its window and mapped it itself. Here
// there is nothing this program could unmap, nothing it could split, and nothing
// it could hand on — it can read and write one page, which is all a shared
// buffer's consumer needs to be able to do.
//
// **AND IT CANNOT EXECUTE FROM IT**, without anyone having to check: the row its
// launcher installed asked for `Read | Write` and no more, and this process
// holds no region object it could ask for anything else with.
//
// THE EXIT CODE IS THE BYTE IT SAW, which is what lets its launcher assert the
// first direction of the round trip through the §8 status word as well as
// through this program's console line — and the byte it WROTE is what the
// launcher reads back out of the page afterwards, which is the second.

import sos.{System, Process, SosStatus}

extern "C" {
    func sos_test_pool_base() -> UInt
}

static EXIT_FAILED: UInt = 1

/// What the launcher wrote, and what this child writes back. Two numbers that
/// appear nowhere else in any transcript.
static ROOT_MARK: UInt8 = 0xA5
static CHILD_MARK: UInt8 = 0x5A

func poke(addr: UInt, value: UInt8) unsafe {
    UnsafeMemory<UInt8, Normal>(addr).write(value)
}

func peek(addr: UInt) unsafe -> UInt8 {
    UnsafeMemory<UInt8, Normal>(addr).read()
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = match system.process_self() {
        case Ok(p) -> p,
        case Err(e) -> {
            print("SOS childshare: no process handle: {}\n", e)
            return
        },
    }

    // THE SHARED PAGE. Nothing in this process's own boot set names it, and
    // nothing in this process's handle table does either — the address comes
    // from the build's config, exactly as a driver's `UART_BASE` does, and the
    // ACCESS comes from a row somebody else installed.
    let page = sos_test_pool_base()
    let seen = peek(page)
    poke(page, CHILD_MARK)
    print("SOS childshare: saw {} wrote {}\n", seen as Int, CHILD_MARK as Int)

    if seen != ROOT_MARK {
        let _ = proc.exit(EXIT_FAILED)
        return
    }
    // The byte it SAW travels out as the status word, so the launcher reads the
    // same fact twice through two unrelated paths.
    let _ = proc.exit(seen as UInt)
}
