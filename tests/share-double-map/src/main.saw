// Shared memory: one region mapped into two address spaces (spec §2.5, the
// shared-memory primitive).
//
// Root maps one page into itself and into a child, and the two processes then
// talk through it in both directions with no copy anywhere that could be faking
// it.
//
// Transcript, in order:
//
//   SOS sharemap: created
//   SOS sharemap: mapped into both        <- two rows, one region, two domains
//   SOS sharemap: wrote 165               <- 0xA5, through root's row
//   SOS sharemap: started
//   SOS childshare: saw 165 wrote 90      <- the child, through its own row
//   SOS: process exit: code=...
//   SOS sharemap: root observed child status=65701
//   SOS sharemap: read back 90            <- 0x5A, back through root's row
//   SOS sharemap: done
//
// Each direction is proved twice. The child saw root's byte: it says so on the
// console and carries it out as its exit code, which root reads through the §8
// status word (65701 is `Exited`(1) << 16 | 165). Root then reads the child's
// byte back out of the same page: `read back 90` is root loading the address
// the child stored to.
//
// Root installs the child's row and the child holds no `Memory` handle at all.
// Contrast `driver-child`:
//
//   driver-child   root gives the capability; the child maps it into itself.
//                  Spends `IoMemoryRight.Transfer` at the give and
//                  `ProcessRight.Map` on the child's own handle at the map.
//   share-double-map
//                  root keeps the capability and maps it into the child.
//                  Spends `MemoryRight.Map` on the region and
//                  `ProcessRight.Map` on the child's handle: holding the
//                  page is not enough to install it in another domain.
//
// Which one a launcher wants is a policy question (hand over authority, or hand
// over access).
//
// The child's row is RW and not executable by omission. Root asks for `Read |
// Write`, so no `MapAccess.Execute` bit is in the word and the exec gate is
// never consulted. A launcher that wanted to be sure the child could never make
// an executable row of its own would withhold `MemoryRight.MapExecute` at a
// mint (see `map-exec-gated`); here the child is never given a region object to
// map.

import sos.{System, Process, Memory, Pool, Mapping, MapAccess, Waiter,
            WaitResult, WaitPayload, SosStatus, SystemRight}

extern "C" {
    func sos_test_pool_base() -> UInt
}

/// One page of the pool, which is the smallest thing either profile grants.
static CHUNK: UInt = 0x1000

/// Read and write, in both domains. The same access word for both rows;
/// asymmetric access would only blur this case.
static RW: UInt32 = MapAccess.Read | MapAccess.Write

/// The byte root writes, and the byte the child writes. Two numbers that appear
/// nowhere else in any transcript, so a line carrying one can only have come
/// from the program that wrote it.
static ROOT_MARK: UInt8 = 0xA5
static CHILD_MARK: UInt8 = 0x5A

/// The key this launcher attaches the child's Process handle under.
static KEY: UInt = 55

/// Root's config: the tag the child's System handle travels under.
static TAG_BOOT: UInt = 41

/// What a child of this launcher may ask its System object for: print, and
/// learn its own Process object (the handle its `exit` goes through).
/// `Transfer` is in the mask because `give` checks it on the thing being given;
/// every other right is absent.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

func poke(addr: UInt, value: UInt8) unsafe {
    UnsafeMemory<UInt8, Normal>(addr).write(value)
}

func peek(addr: UInt) unsafe -> UInt8 {
    UnsafeMemory<UInt8, Normal>(addr).read()
}

/// The §8 status word out of the record the kernel copied into this process's
/// memory while the thread was parked. The other three arms panic: this program
/// attached exactly one thing.
func status_of(r: &WaitResult) -> UInt {
    match r.what {
        case Process(status) -> status,
        case _ -> panic("this launcher attached only a Process"),
    }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS sharemap: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The boot set, in the build's row order: the child's image blob, the RAM
    // it will run in, and the pool the shared page is allocated from.
    var image = try proc.boot_handle_next() catch {
        print("SOS sharemap: no image region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        print("SOS sharemap: no destination region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var pool_record = try proc.boot_handle_next() catch {
        print("SOS sharemap: no pool region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let image_mem = image.take_memory() else {
        let _ = system.debug_print("SOS sharemap: image record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let dest_mem = dest.take_memory() else {
        let _ = system.debug_print("SOS sharemap: dest record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let pool = pool_record.take_pool() else {
        let _ = system.debug_print("SOS sharemap: pool record is not a pool\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        print("SOS sharemap: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS sharemap: created\n")

    // One region, two maps, two domains. The region object is the same in both
    // calls (`&shared` is borrowed, not consumed, because a map moves no handle
    // word); only the receiver differs: `proc` is this process, `child` the
    // other. Two rows exist afterwards and two Mapping handles name them;
    // §2.5's refcount clause keeps the page alive for as long as either does.
    let shared = try pool.allocate(len: CHUNK) catch {
        print("SOS sharemap: allocation failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _here = try proc.map(memory: &shared, access: RW) catch {
        print("SOS sharemap: map into self failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _there = try child.map(memory: &shared, access: RW) catch {
        print("SOS sharemap: map into child failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS sharemap: mapped into both\n")

    // Root's half of the conversation. The child is `Created` and has no
    // thread, so the ordering is forced rather than raced.
    let page = sos_test_pool_base()
    poke(page, ROOT_MARK)
    print("SOS sharemap: wrote {}\n", ROOT_MARK as Int)

    // Furnish the child, and attach it to a waiter: the child's ending is the
    // only thing that can wake this process, so no timer is armed.
    let waiter = try proc.waiter_create() catch {
        print("SOS sharemap: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try waiter.add(process: &child, key: KEY) catch {
        print("SOS sharemap: attach failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let for_child = try system.mint(rights: CHILD_SYSTEM) catch {
        print("SOS sharemap: mint failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        print("SOS sharemap: give failed: {}\n", error.0)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try child.start(boot_tag: TAG_BOOT) catch {
        print("SOS sharemap: start failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS sharemap: started\n")

    let record = try waiter.wait() catch {
        print("SOS sharemap: wait failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS sharemap: root observed child status={}\n", status_of(&record))

    // The other direction. The child is gone and its domain, with the second
    // row, went with it, but the page is root's as much as it ever was, because
    // root's own row was never the child's to take. This load is the byte the
    // child stored, through a region neither process copied.
    let seen = peek(page)
    print("SOS sharemap: read back {}\n", seen as Int)
    if seen != CHILD_MARK {
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    print("SOS sharemap: done\n")
    let _ = proc.exit(EXIT_OK)
}
