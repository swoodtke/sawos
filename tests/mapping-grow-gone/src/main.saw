// A Mapping whose target died cannot grow (spec §2.5, §2.10).
//
//   SOS growgone: mapped a page into the child and extended it
//   SOS growgone: the child ended: status=65543
//   SOS growgone: grow: what this call was waiting for is gone
//   SOS growgone: grow off the grain
//   SOS: process fault: argument outside its domain process=0
//
// Root takes a page from the front of its pool, maps it into a child it has
// created, and extends the page by another, so the allocation holds the bytes
// a growth would take. The child ends at once. Its row went with its domain,
// so root's growth of the Mapping is `Revoked`, a status: root did not cause
// the death. A growth of a length off the grain through the same Mapping is
// still the `BadArg` fault, which ends root: the caller's own argument is
// judged before the target's death is.

import sos.{System, Process, Pool, AllocateFrom, MapAccess, SosStatus,
            SystemRight}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

static TAG_BOOT: UInt = 31
static TAG_ROLE: UInt = 32

static KEY_DEATH: UInt = 6

/// `child-grow-leg`'s role that ends at once.
static ROLE_EXIT: UInt = 1

static PAGE: UInt = 0x1000
/// Two bytes: off a four-byte grain and off a page.
static OFF_GRAIN: UInt = 2
static RW: UInt32 = MapAccess.Read | MapAccess.Write

static CHILD_SYSTEM: UInt32 = (SystemRight.Transfer | SystemRight.ProcessSelf
                               | SystemRight.Debug)

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS growgone: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&system, &proc) catch {
        print("SOS growgone: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS growgone: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var image_rec = try proc.boot_handle_next()
    var dest_rec = try proc.boot_handle_next()
    var pool_rec = try proc.boot_handle_next()
    guard let image = image_rec.take_memory() else { return BUG }
    guard let dest = dest_rec.take_memory() else { return BUG }
    guard let pool = pool_rec.take_pool() else { return BUG }

    let child = try system.process_create(image: &image, memory: &dest)
    let page = try pool.allocate(len: PAGE, from: AllocateFrom.Front)
    let view = try child.map(memory: &page, access: RW)
    try page.extend(len: PAGE)
    print("SOS growgone: mapped a page into the child and extended it\n")

    let ev = try proc.event_create()
    try ev.signal(bits: ROLE_EXIT)
    try child.give(event: move ev, tag: TAG_ROLE) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let boot = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move boot, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let waiter = try proc.waiter_create()
    try waiter.add(process: &child, key: KEY_DEATH)
    try child.start(boot_tag: TAG_BOOT)
    let wake = try waiter.wait()
    let (key, what) = (move wake).open()
    match what {
        case Process(status) -> {
            if key != KEY_DEATH { return BUG }
            print("SOS growgone: the child ended: status={}\n", status)
        },
        case _ -> { return BUG },
    }

    try view.grow(len: PAGE) catch {
        print("SOS growgone: grow: {}\n", error)
        print("SOS growgone: grow off the grain\n")
        try view.grow(len: OFF_GRAIN) catch {
            print("SOS growgone: off the grain: {}\n", error)
            return
        }
        print("SOS growgone: off the grain: ok\n")
        return
    }
    print("SOS growgone: grow: ok\n")
    return
}
