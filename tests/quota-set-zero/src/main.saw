// A limit of zero is a limit (spec §2.7): for a kind the child holds none of,
// `QuotaSet` takes it, the row reads it back, and the first object of the kind
// made through the child's handle is refused by the child's quota.
//
//   SOS quotazero: event limit 0 taken, reads limit=0 used=0
//   SOS quotazero: an event through the child: this process is at its quota
//   SOS quotazero: done

import sos.{System, QuotaKind, SosStatus}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)
    try run(&system) catch {
        print("SOS quotazero: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS quotazero: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System) -> Result<Void, SosStatus> {
    let proc = try system.process_self()
    var image_rec = try proc.boot_handle_next()
    var ram_rec = try proc.boot_handle_next()
    guard let image = image_rec.take_memory() else { return BUG }
    guard let ram = ram_rec.take_memory() else { return BUG }
    let child = try system.process_create(image: &image, memory: &ram)

    try child.quota_set(kind: QuotaKind.Event, limit: 0)
    let row = try child.quota_get(kind: QuotaKind.Event)
    print("SOS quotazero: event limit 0 taken, reads limit={} used={}\n",
          row.limit, row.used)
    match child.event_create() {
        case Ok(e) -> {
            print("SOS quotazero: UNEXPECTED an event was made\n")
            let _ = move e
            return BUG
        },
        case Err(why) -> {
            print("SOS quotazero: an event through the child: {}\n", why)
        },
    }
    return
}
