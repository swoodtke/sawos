// The console claim (spec §9a). Root claims the console, which its System
// handle's every right allows, and launches `child-ends` once per role, one at
// a time, waiting for each to end:
//
//   - its own debug print answers `Claimed`;
//   - a child that panics: its two lines are held back, and its death record
//     keeps the text and says the kernel did not print them;
//   - a child that traps, and one whose lock wait names root's thread: their
//     lines are held back too;
//   - a child given `Console` claims while root holds it: `Claimed`;
//   - a child releases a claim it does not hold: the `BadState` fault;
//   - a child claims without the right: the `AccessDenied` fault.
//
// Root prints nothing while it holds the claim. It releases, and the kernel's
// one line says what it held back: two lines for each death and three for
// the lock wait's, and the one byte root's debug print was refused. The case
// asserts that line straight after root's last line before the claim, so
// nothing was written between. Then root prints what it recorded.
//
// Then a child given `Console` claims, prints and claims again, and its fault
// ends the claim: the kernel writes the held-back line (no lines, its one
// byte) and then its own fault and teardown lines, and records that it printed
// them. Root then claims and releases, which a claim surviving its claimant's
// death would refuse.
//
// Then a child given `Console` claims and parks, and root, its own debug
// print refused, kills it: the kill's teardown ends the claim, the kernel
// writes the held-back line and the teardown line, and records that it
// printed them. Root's claim and release answer `Ok` again.
//
// Then four claimants, each given `Console`: one releases through a sibling
// of its System handle without the right, which needs none, and claims and
// releases again; three have a byte refused and then exit, trap or panic
// holding the claim. Each end gives the console back, so the kernel writes
// the held-back line (one byte) and then the end's own lines, and records
// that it printed them.
//
// Last, a child given `Console` claims and parks, and root, its byte refused,
// panics while the child holds the claim: a stop takes the console back over
// the claimant's head, so the held-back line comes first, then root's panic
// line with its text, and the machine stops with the panic status.

import sos.{System, Process, Memory, SosStatus, SystemRight, DeathCause,
            ProcessDeath, sos_panic, sos_thread_id}

static EXIT_FAILED: UInt = 1
/// The release failed, and nothing can be printed to say so.
static EXIT_NOT_RELEASED: UInt = 2

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

static TAG_BOOT: UInt = 31
static TAG_ROLE: UInt = 40
static TAG_ARG: UInt = 41

static ROLE_TRAP: UInt = 4
static ROLE_PANIC: UInt = 5
static ROLE_LOCK: UInt = 6
static ROLE_CLAIM_HELD: UInt = 7
static ROLE_RELEASE_UNHELD: UInt = 8
static ROLE_CLAIM_DENIED: UInt = 9
static ROLE_CLAIM_TWICE: UInt = 10
static ROLE_CLAIM_PARK: UInt = 14
static ROLE_CLAIM_WEAK: UInt = 18
static ROLE_CLAIM_EXIT: UInt = 19
static ROLE_CLAIM_TRAP: UInt = 20
static ROLE_CLAIM_PANIC: UInt = 21

/// The code root kills the parked claimant with.
static KILL_CODE: UInt = 0x2B

static KEY_DEATH: UInt = 6

/// What every child may ask its System object for, and the same with the
/// console claim.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)
static CLAIMANT_SYSTEM: UInt32 = CHILD_SYSTEM | SystemRight.Console
/// A claimant that mints a narrower sibling of its System handle.
static MINTING_CLAIMANT_SYSTEM: UInt32 = CLAIMANT_SYSTEM | SystemRight.Mint

/// What root's own debug print offers under the claim.
static PROBE_BYTE: UInt8 = 0x78

/// What happened while root held the claim, printed once it is released.
struct Held {
    print_answer: String,
    panicked: ProcessDeath,
    trapped: UInt,
    locked: UInt,
    second_claimant: UInt,
    unheld_release: UInt,
    no_right: UInt,
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS consoleclaim: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var img_rec = try proc.boot_handle_next() catch {
        print("SOS consoleclaim: no image: {}", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var ram_rec = try proc.boot_handle_next() catch {
        print("SOS consoleclaim: no region: {}", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let img = img_rec.take_memory() else {
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let ram = ram_rec.take_memory() else {
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    print("SOS consoleclaim: claiming")
    try system.console_claim() catch {
        print("SOS consoleclaim: the claim answered {}", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    // Nothing prints until the release: a print would be refused and
    // counted.
    let held = held_phase(&system, &proc, &img, &ram)
    try system.console_release() catch {
        let _ = system.shutdown(EXIT_NOT_RELEASED)
        return
    }
    let h = try held catch {
        print("SOS consoleclaim: refused under the claim: {}", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    report(&h)

    try twice(&system, &proc, &img, &ram) catch {
        print("SOS consoleclaim: refused: {}", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try killed(&system, &proc, &img, &ram) catch {
        print("SOS consoleclaim: refused: {}", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try claimant_ends(&system, &proc, &img, &ram) catch {
        print("SOS consoleclaim: refused: {}", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS consoleclaim: done")
    try panic_claimed(&system, &proc, &img, &ram) catch {
        print("SOS consoleclaim: refused: {}", error)
    }
    let _ = system.shutdown(EXIT_FAILED)
}

/// What happens while root holds the claim.
func held_phase(system: &System, proc: &Process, img: &Memory,
                ram: &Memory) -> Result<Held, SosStatus> {
    let print_answer = match system.debug_print_byte(PROBE_BYTE) {
        case Ok(_) -> "printed",
        case Err(why) -> why.describe(),
    }
    let panicker = try make(&system, &proc, &img, &ram, ROLE_PANIC,
                            CHILD_SYSTEM)
    try panicker.start(boot_tag: TAG_BOOT)
    try ended(&proc, &panicker)
    let panicked = try panicker.death()

    let trapper = try make(&system, &proc, &img, &ram, ROLE_TRAP,
                           CHILD_SYSTEM)
    let told = try proc.event_create()
    try trapper.give(event: move told, tag: TAG_ARG) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try trapper.start(boot_tag: TAG_BOOT)
    try ended(&proc, &trapper)
    let trapped = try trapper.get_status()

    let waiter = try make(&system, &proc, &img, &ram, ROLE_LOCK, CHILD_SYSTEM)
    let owner = try proc.event_create()
    try owner.signal(bits: sos_thread_id())
    try waiter.give(event: move owner, tag: TAG_ARG) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try waiter.start(boot_tag: TAG_BOOT)
    try ended(&proc, &waiter)
    let locked = try waiter.get_status()

    let second_claimant = try ends_with(&system, &proc, &img, &ram,
                                        ROLE_CLAIM_HELD, CLAIMANT_SYSTEM)
    let unheld_release = try ends_with(&system, &proc, &img, &ram,
                                       ROLE_RELEASE_UNHELD, CHILD_SYSTEM)
    let no_right = try ends_with(&system, &proc, &img, &ram,
                                 ROLE_CLAIM_DENIED, CHILD_SYSTEM)
    return Held(print_answer: print_answer, panicked: panicked,
                trapped: trapped, locked: locked,
                second_claimant: second_claimant,
                unheld_release: unheld_release, no_right: no_right)
}

/// Print what happened while root held the claim.
func report(h: &Held) {
    print("SOS consoleclaim: the debug print under the claim: {}",
          h.print_answer)
    let d = h.panicked
    print("SOS consoleclaim: a panic under the claim: status={} cause={} printed={}",
          d.status, cause_name(d.cause), flag(d.printed))
    print("SOS consoleclaim: its teardown: handles={} threads={} events={} waiters={} interrupts={} timers={}",
          d.handles, d.threads, d.events, d.waiters, d.interrupts, d.timers)
    print("SOS consoleclaim: its text, kept: {} bytes beginning {}",
          d.text_len, prefix(&d))
    print("SOS consoleclaim: a trap under the claim: status={}", h.trapped)
    print("SOS consoleclaim: a lock wait under the claim: status={}",
          h.locked)
    print("SOS consoleclaim: a second claimant: status={}", h.second_claimant)
    print("SOS consoleclaim: a release without the claim: status={}",
          h.unheld_release)
    print("SOS consoleclaim: a claim without the right: status={}", h.no_right)
}

/// A claimant whose second claim faults: its end gives the console back.
func twice(system: &System, proc: &Process, img: &Memory,
           ram: &Memory) -> Result<Void, SosStatus> {
    let child = try make(&system, &proc, &img, &ram, ROLE_CLAIM_TWICE,
                         CLAIMANT_SYSTEM)
    try child.start(boot_tag: TAG_BOOT)
    try ended(&proc, &child)
    let d = try child.death()
    print("SOS consoleclaim: a claimant that claimed twice: status={} cause={} printed={}",
          d.status, cause_name(d.cause), flag(d.printed))
    try system.console_claim()
    try system.console_release()
    print("SOS consoleclaim: a claim after the claimant's death: Ok")
    return
}

/// A claimant killed while it holds the claim: the kill's teardown gives the
/// console back.
func killed(system: &System, proc: &Process, img: &Memory,
            ram: &Memory) -> Result<Void, SosStatus> {
    let child = try make(&system, &proc, &img, &ram, ROLE_CLAIM_PARK,
                         CLAIMANT_SYSTEM)
    try child.start(boot_tag: TAG_BOOT)
    // Nothing ticks: the yield returns once the child has claimed and parked.
    let me = try proc.thread_self()
    let _ = me.yield_now()
    let answer = match system.debug_print_byte(PROBE_BYTE) {
        case Ok(_) -> "printed",
        case Err(why) -> why.describe(),
    }
    try child.kill(code: KILL_CODE)
    let d = try child.death()
    print("SOS consoleclaim: the debug print beside the parked claimant: {}",
          answer)
    print("SOS consoleclaim: a claimant killed holding the claim: status={} cause={} printed={}",
          d.status, cause_name(d.cause), flag(d.printed))
    try system.console_claim()
    try system.console_release()
    print("SOS consoleclaim: a claim after the kill: Ok")
    return
}

/// Claimants that release through a sibling without `Console`, and that
/// exit, trap or panic holding the claim.
func claimant_ends(system: &System, proc: &Process, img: &Memory,
                   ram: &Memory) -> Result<Void, SosStatus> {
    let weak = try ends_with(&system, &proc, &img, &ram, ROLE_CLAIM_WEAK,
                             MINTING_CLAIMANT_SYSTEM)
    print("SOS consoleclaim: a release through a handle without Console: status={}",
          weak)
    try claimant_end(&system, &proc, &img, &ram, ROLE_CLAIM_EXIT, "exits")
    try claimant_end(&system, &proc, &img, &ram, ROLE_CLAIM_TRAP, "traps")
    try claimant_end(&system, &proc, &img, &ram, ROLE_CLAIM_PANIC, "panics")
    return
}

/// A claimant in `role` that ends holding the claim, and what its record
/// says.
func claimant_end(system: &System, proc: &Process, img: &Memory, ram: &Memory,
                  role: UInt, how: String) -> Result<Void, SosStatus> {
    let child = try make(&system, &proc, &img, &ram, role, CLAIMANT_SYSTEM)
    let told = try proc.event_create()
    try child.give(event: move told, tag: TAG_ARG) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try child.start(boot_tag: TAG_BOOT)
    try ended(&proc, &child)
    let d = try child.death()
    print("SOS consoleclaim: a claimant that {} holding the claim: status={} cause={} printed={}",
          how, d.status, cause_name(d.cause), flag(d.printed))
    try system.console_claim()
    try system.console_release()
    return
}

/// Start a claimant, have a byte refused, and panic while it holds the
/// claim.
func panic_claimed(system: &System, proc: &Process, img: &Memory,
                   ram: &Memory) unsafe -> Result<Void, SosStatus> {
    let child = try make(&system, &proc, &img, &ram, ROLE_CLAIM_PARK,
                         CLAIMANT_SYSTEM)
    try child.start(boot_tag: TAG_BOOT)
    let me = try proc.thread_self()
    let _ = me.yield_now()
    let _ = system.debug_print_byte(PROBE_BYTE)
    let text = "SOS consoleclaim: root panics while a child holds the claim"
    sos_panic(text.c_string()!, text.len() as UInt)
}

// -----------------------------------------------------------------------------
// Parts
// -----------------------------------------------------------------------------

/// A `child-ends` process from `img` and `ram`, told `role` and given a
/// System handle with `rights` under its boot tag. It is not started.
func make(system: &System, proc: &Process, img: &Memory, ram: &Memory,
          role: UInt, rights: UInt32) -> Result<Process, SosStatus> {
    let child = try system.process_create(image: &img, memory: &ram)
    let told = try proc.event_create()
    try told.signal(bits: role)
    try child.give(event: move told, tag: TAG_ROLE) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let boot = try system.mint(rights: rights)
    try child.give(system: move boot, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    return move child
}

/// Launch a child in `role` and answer the status word it ends with.
func ends_with(system: &System, proc: &Process, img: &Memory, ram: &Memory,
               role: UInt, rights: UInt32) -> Result<UInt, SosStatus> {
    let child = try make(&system, &proc, &img, &ram, role, rights)
    try child.start(boot_tag: TAG_BOOT)
    try ended(&proc, &child)
    return try child.get_status()
}

/// Wait for `child` to end.
func ended(proc: &Process, child: &Process) -> Result<Void, SosStatus> {
    let waiter = try proc.waiter_create()
    try waiter.add(process: &child, key: KEY_DEATH)
    let wake = try waiter.wait()
    let _ = move wake
    return
}

/// The first bytes of a kept panic text, as a string.
func prefix(d: &ProcessDeath) -> String {
    var out = StringBuilder()
    var i = 0
    while i < d.text_len && i < 26 {
        try! out.append(Byte(d.text[i]))
        i = i + 1
    }
    out.build()
}

func cause_name(cause: DeathCause) -> String {
    match cause {
        case Exited -> "Exited",
        case Killed -> "Killed",
        case Fault -> "Fault",
        case Trap -> "Trap",
        case Panic -> "Panic",
        case LockOwner -> "LockOwner",
    }
}

func flag(b: Bool) -> Int {
    if b { 1 } else { 0 }
}
