// Unmap, and the live-domain rule (spec §2.5). Root maps a region into itself,
// writes and reads it, unmaps it, and touches it again, and the touch has to
// die. A missing fault would mean not a slow revocation but no revocation:
// `run_thread` reloads a protection domain only when the process changes, so an
// `unmap` that edited the grant record without reloading would leave the row
// installed for as long as this process kept the processor, which for a root
// server that never yields is forever. `domain_changed(p)` is the one helper
// that closes it, and this program asserts it ran.
//
// The shape is root-into-itself because it is deterministic: there is no
// scheduling race anywhere in the sequence, the fault lands on a known
// instruction in a known process, and the live-domain rule is exercised in its
// hardest case rather than its easiest (a child's domain is not the installed
// one, so mapping into a child would reload nothing and prove nothing about the
// reload).
//
// The transcript reads as an order:
//
//   SOS mapunmap: wrote 0x77 read 119    <- the row was installed (119 is
//                                           0x77; the byte renders as decimal)
//   SOS mapunmap: unmapped               <- the op returned Ok
//   SOS: fault ...                       <- and the row is gone, now
//
// The last line is the kernel's hardware-fault report; its tag and cause differ
// per machine (a store/load access fault on one, a data abort on the other), so
// what is asserted is that one was taken and that root died of it.

import sos.{System, Process, Memory, Mapping, MapAccess, SosStatus}

extern "C" {
    func sos_test_pool_base() -> UInt
}

static CHUNK: UInt = 0x1000

static RW: UInt32 = MapAccess.Read | MapAccess.Write

static EXIT_FAILED: UInt = 1

func poke(addr: UInt, value: UInt8) unsafe {
    UnsafeMemory<UInt8, Normal>(addr).write(value)
}

func peek(addr: UInt) unsafe -> UInt8 {
    UnsafeMemory<UInt8, Normal>(addr).read()
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS mapunmap: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    var record = try proc.boot_handle_next() catch {
        print("SOS mapunmap: no pool region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let pool = record.take_memory() else {
        let _ = system.debug_print("SOS mapunmap: boot record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let base = sos_test_pool_base()

    let chunk = try pool.split(len: CHUNK) catch {
        print("SOS mapunmap: split failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let mapping = try proc.map(memory: &chunk, access: RW) catch {
        print("SOS mapunmap: map failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    poke(base, 0x77)
    print("SOS mapunmap: wrote 0x77 read {}\n", peek(base) as Int)

    // The revocation. Only a Mapping unmaps (§2.5), which is why this op is on
    // this object and not on the region.
    try mapping.unmap() catch {
        print("SOS mapunmap: unmap failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS mapunmap: unmapped\n")

    // The touch dies here. The read's value is printed rather than discarded,
    // deliberately: a load nobody uses is a load an optimiser may delete, and a
    // deleted load takes no fault. The print never runs.
    print("SOS mapunmap: UNREACHABLE {}\n", peek(base) as Int)

    let _ = system.shutdown(EXIT_FAILED)
}
