//! The `pwm_bad_config` and `pwm_refused_config` cases' servos: a frame of a
//! second, past the longest the timer's arithmetic allows, so the driver
//! refuses this before it maps anything.

import esp32s3io.{Servo}

/// The frame every channel shares, in microseconds.
public static FRAME_US: UInt32 = 1_000_000

/// One entry per servo: its LEDC channel, its pad, and the pulse range it may
/// be commanded to.
public static SERVOS: [Servo; 2] = [
    Servo(channel: 0, pin: 41, min_us: 500, max_us: 2500),
    Servo(channel: 1, pin: 42, min_us: 500, max_us: 2500),
]
