//! The `gpio_bad_config` case's pins: pin 30 is the SPI flash bus's, which no
//! image may drive, so the driver refuses this before it maps anything.

import esp32s3io.{GpioPin, PinMode}

/// The pins the driver serves, in the order it configures them.
public func pins() -> [GpioPin; 2] {
    [
        GpioPin(pin: 21, mode: PinMode.InputPullUp, level: 0),
        GpioPin(pin: 30, mode: PinMode.Output, level: 0),
    ]
}
