//! The GPIO board cases' pins: pin 14 is its own loopback, so a level it is
//! driven to raises the interrupt with nothing wired, and pin 21 is the
//! switch's, pulled up. Pin 2 is a plain output wired to nothing, to read back
//! what it is driven to.

import esp32s3io.{GpioPin, PinMode}

/// The pins the driver serves, in the order it configures them.
public func pins() -> [GpioPin; 3] {
    [
        GpioPin(pin: 14, mode: PinMode.OutputLoopback, level: 0),
        GpioPin(pin: 21, mode: PinMode.InputPullUp, level: 0),
        GpioPin(pin: 2, mode: PinMode.Output, level: 0),
    ]
}
