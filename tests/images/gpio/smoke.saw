//! The `gpio_service` case's pins: one of each mode the driver serves.

import esp32s3io.{GpioPin, PinMode}

/// The pins the driver serves, in the order it configures them.
public func pins() -> [GpioPin; 5] {
    [
        GpioPin(pin: 21, mode: PinMode.InputPullUp, level: 0),
        GpioPin(pin: 14, mode: PinMode.InputPullDown, level: 0),
        GpioPin(pin: 1, mode: PinMode.InputFloating, level: 0),
        GpioPin(pin: 2, mode: PinMode.Output, level: 1),
        GpioPin(pin: 47, mode: PinMode.OutputLoopback, level: 0),
    ]
}
