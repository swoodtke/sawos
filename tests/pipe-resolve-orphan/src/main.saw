// SOS M4 unit 4.5: THE ORPHANED-CLAIM ARM, AT A HANDLE-BACKED CLAIM (sawos
// design 22; `designs/010` ruling 12(b)'s `end_process` mirror).
//
// **`pipe-call-orphan` WITH THE OTHER SPELLING, AND THAT IS THE WHOLE CLAIM.**
// A fused `Call`'s claim is a reference no handle table holds, which is what
// made design 17 D-2's teardown arm necessary. A parked `resolve`'s claim WAS a
// table row until the op took it — `park_resolve` unbinds the caller's entry and
// KEEPS its reference, which is `consume_entry` with the unref left out — so
// from the moment it parks the two shapes are indistinguishable: one reference
// on the claim column, `PIPE_CALLER` naming the thread, and nothing on any list.
//
//   SOS resolveorphan: two resolves in flight
//   SOS resolveorphan: answered one
//   SOS: process exit: code=0x…47 process=0x…01
//   SOS resolveorphan: the orphaned claim answers the other end of this
//                      connection is gone
//
// The last row is the arm, and the point of the case is that reaching it needed
// NO KERNEL CODE: `release_pending_calls` walks threads with a claim tie and
// drops the reference, and it never asks which op put it there. A kernel that
// had grown a second teardown path for the second park would pass this case too;
// what it would not have is the ONE arm the census argues for.
//
// # WHY A SIBLING CASE RATHER THAN AN ARM ON `pipe-call-orphan`
//
// The proof requires the ORPHANED thread to be the shape under test, and one
// two-thread child can orphan only one shape: whichever thread the launcher
// answers exits the process and the other is the orphan. `child-orphan`'s two
// threads are interchangeable ON PURPOSE — that symmetry is what makes the case
// deterministic without the launcher knowing which thread it is talking to — so
// making them differ would have traded a fact for a scan order. Two cases, one
// spelling each, keeps both proofs and both symmetries.
//
// Everything else — how a process is made to die with a thread parked, why root
// never polls, and why the outlet is detached before the death wait — is
// `pipe-call-orphan`'s and is written out there.
//
// ONE PHASE PER FUNCTION, on design 14 finding 3's 16 KiB stack ceiling.

import sos.{System, Process, Waiter, WaitResult, WaitPayload, PipeInlet,
            PipeOutlet, PipeRequest, PipeInletRight, OutletLevel, SosStatus,
            SystemRight, PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status the kernel can never hand this program, so meeting it in the error
/// channel means an assertion in THIS file failed rather than a call did.
static BUG: SosStatus = SosStatus.Revoked

/// `Exited`(1) << 16 | 71 — the code `child-resolver`'s answered thread ends
/// with.
static CHILD_STATUS: UInt = 65607

static_assert((1 * 65536) + 71 == 65607,
              "the child's status word is Exited in the high bits and its code")

/// One byte each way.
static PAYLOAD_LEN: UInt = 1

static KEY_OUTLET: UInt = 91
static KEY_DEATH: UInt = 92

/// The three tags. **THE TWO INLETS GO FIRST**: the boot set is a FIFO, so
/// records 0 and 1 are the two client ends and each of the child's threads
/// drains one for itself.
static TAG_INLET_A: UInt = 15
static TAG_INLET_B: UInt = 16
static TAG_BOOT: UInt = 17

/// What a child of this launcher may ask its System object for. This child
/// prints nothing, so no `Debug`; it makes a thread, which is a `Process` right
/// on a handle it derives for itself and costs nothing here.
static CHILD_SYSTEM: UInt32 = (SystemRight.ProcessSelf | SystemRight.Transfer)

/// **WHAT THE SECOND CLIENT END MAY DO.** A sibling minted through this mask can
/// post and nothing else — it may not be handed on again and may not mint a
/// third. `Transfer` IS present, because `give` checks that bit on the thing
/// being given and the whole purpose of this handle is to be given.
static SECOND_INLET: UInt32 = (PipeInletRight.Transfer | PipeInletRight.Post)

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS resolveorphan: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    try run(&system, &proc) catch {
        print("SOS resolveorphan: failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let _ = proc.exit(EXIT_OK)
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var image = try proc.boot_handle_next()
    var dest = try proc.boot_handle_next()
    guard let image_mem = image.take_memory() else { return BUG }
    guard let dest_mem = dest.take_memory() else { return BUG }

    let child = try system.process_create(image: &image_mem, memory: &dest_mem)

    // ONE CONNECTION, TWO CLIENT ENDS — design 13 D-1's `dup` precedent, which
    // is what lets two threads of one process each hold an end without either
    // handing the other a handle word.
    let pair = try proc.pipe_create()
    let (inlet, outlet) = move pair
    let second = try inlet.mint(rights: SECOND_INLET)

    let waiter = try proc.waiter_create()
    try waiter.add(outlet: &outlet, key: KEY_OUTLET)
    try waiter.add(process: &child, key: KEY_DEATH)

    try child.give(inlet: move inlet, tag: TAG_INLET_A)
    try child.give(inlet: move second, tag: TAG_INLET_B)
    let for_child = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move for_child, tag: TAG_BOOT)
    try child.start(boot_tag: TAG_BOOT)

    try collect_and_orphan(&outlet, &waiter)
    return
}

/// **TAKE BOTH MESSAGES, ANSWER ONE, AND ASK THE OTHER AFTERWARDS.**
///
/// The two obligations are held together across the child's death, which is the
/// only arrangement in which the arm is observable at all: the second one has to
/// still exist when the teardown runs, so that root can ask it a question
/// afterwards and be told what the teardown decided.
func collect_and_orphan(outlet: &PipeOutlet,
                        waiter: &Waiter) -> Result<Void, SosStatus> {
    var out: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    out[0] = 2

    // THE FIRST THREAD'S EXCHANGE.
    let first = try waiter.wait()
    if first.key != KEY_OUTLET || not readable_msg(&first) {
        return BUG
    }
    let got_a = try outlet.take()
    let (_, request_a) = move got_a
    let answered = move request_a

    // THE SECOND THREAD'S. This wait PARKS — nothing is staged until the sibling
    // runs — so the interleaving is the kernel's rather than a poll's.
    let second = try waiter.wait()
    if second.key != KEY_OUTLET || not readable_msg(&second) {
        return BUG
    }
    let got_b = try outlet.take()
    let (_, request_b) = move got_b
    let orphaned = move request_b

    print("SOS resolveorphan: two resolves in flight\n")

    // Detached BEFORE the death, so the wait below has exactly one thing that
    // can answer it — `pipe-call-orphan`'s own reasoning.
    try waiter.remove(KEY_OUTLET)

    // ANSWER ONE. Whichever thread this reaches wakes up inside its own
    // `resolve`, takes the reply, and ends the process — leaving the other one
    // parked. That wake is `wake_call_reply`, unchanged: the answer is the
    // reply's length in the value register with the record copied into the
    // caller's buffer, which is what a fused `Call` gets too.
    try (move answered).reply(body: &out, len: PAYLOAD_LEN)
    print("SOS resolveorphan: answered one\n")

    let ended = try waiter.wait()
    if ended.key != KEY_DEATH {
        return BUG
    }
    if process_status(&ended) != CHILD_STATUS {
        return BUG
    }

    // **THE ARM.** The orphaned claim was abandoned by the teardown, so this
    // discharges the obligation and is told there is nobody left to hear it. A
    // `match` rather than the tree's guard shape, deliberately: this is a
    // negative assertion on a SPECIFIC status.
    match (move orphaned).reply(body: &out, len: PAYLOAD_LEN) {
        case Ok(_) -> {
            print("SOS resolveorphan: the orphaned claim took a reply\n")
            return BUG
        },
        case Err(status) -> {
            print("SOS resolveorphan: the orphaned claim answers {}\n", status)
        },
    }
    return
}

/// Whether a record says a message is STAGED. The other arms panic because this
/// program checks the KEY first, so any other shape would mean the kernel
/// reported an attachment nobody made.
func readable_msg(r: &WaitResult) -> Bool {
    match r.what {
        case Readable(level) -> {
            match level {
                case Msg -> true,
                case PeerGone -> false,
            }
        },
        case _ -> panic("this record was supposed to be the outlet's"),
    }
}

/// The §8 status word out of a wait record.
func process_status(r: &WaitResult) -> UInt {
    match r.what {
        case Process(status) -> status,
        case _ -> panic("this record was supposed to be the child's"),
    }
}
