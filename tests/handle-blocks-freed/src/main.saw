// A child's handle blocks go back to their slab at its teardown, and the
// body it ran in goes back with no table past its entries (spec §2.7,
// §2.10).
//
// The image holds two blocks. Child A's row goes to 64, taking both; A runs
// and exits (`child-bye`). Child B is made after A's teardown, in the body A
// ran in, and its row of 48 takes one of the blocks A gave back. Its table
// is the body's 32 entries and that one block, so 33 records fit: a body
// that kept A's count of blocks would read past its links. Child C's row of
// 48 takes the other block, and child D's then finds none:
//
//   SOS blocksfreed: A limit 64 taken
//   SOS bye: exiting
//   SOS blocksfreed: A ended status=65541    <- Exited << 16 | 5
//   SOS blocksfreed: B limit 48 taken
//   SOS blocksfreed: gave B 33 records
//   SOS blocksfreed: C limit 48 taken
//   SOS blocksfreed: D limit 48: no room for what was asked
//   SOS blocksfreed: done

import sos.{System, QuotaKind, AttachMode, SosStatus, SystemRight}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A's row: two blocks past the body's entries.
static ROW: UInt16 = 64

/// The other children's row: one block past the body's entries.
static ONE_BLOCK: UInt16 = 48

/// The records B is given: one past the body's entries.
static PAST_BODY: UInt = 33

/// Root's config: the tag A's System travels under.
static TAG_BOOT: UInt = 1

/// The key root watches A's death under.
static KEY: UInt = 7

/// What a child may ask its System object for: print, and learn its own Process
/// object; and `Transfer`, which the give spends.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)
    try run(&system) catch {
        print("SOS blocksfreed: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS blocksfreed: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System) -> Result<Void, SosStatus> {
    let proc = try system.process_self()
    // Rows: each child's image, then the RAM of each.
    var a_image_rec = try proc.boot_handle_next()
    var b_image_rec = try proc.boot_handle_next()
    var c_image_rec = try proc.boot_handle_next()
    var d_image_rec = try proc.boot_handle_next()
    var a_ram_rec = try proc.boot_handle_next()
    var b_ram_rec = try proc.boot_handle_next()
    var c_ram_rec = try proc.boot_handle_next()
    var d_ram_rec = try proc.boot_handle_next()
    guard let a_image = a_image_rec.take_memory() else { return BUG }
    guard let b_image = b_image_rec.take_memory() else { return BUG }
    guard let c_image = c_image_rec.take_memory() else { return BUG }
    guard let d_image = d_image_rec.take_memory() else { return BUG }
    guard let a_ram = a_ram_rec.take_memory() else { return BUG }
    guard let b_ram = b_ram_rec.take_memory() else { return BUG }
    guard let c_ram = c_ram_rec.take_memory() else { return BUG }
    guard let d_ram = d_ram_rec.take_memory() else { return BUG }

    let a = try system.process_create(image: &a_image, memory: &a_ram)
    try a.quota_set(kind: QuotaKind.Handle, limit: ROW)
    print("SOS blocksfreed: A limit {} taken\n", ROW)
    let for_a = try system.mint(rights: CHILD_SYSTEM)
    try a.give(system: move for_a, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let waiter = try proc.waiter_create()
    try waiter.add(process: &a, key: KEY, mode: AttachMode.OneShot)
    try a.start(boot_tag: TAG_BOOT)
    let _ = try waiter.wait()
    let status = try a.get_status()
    print("SOS blocksfreed: A ended status={}\n", status)

    let b = try system.process_create(image: &b_image, memory: &b_ram)
    try b.quota_set(kind: QuotaKind.Handle, limit: ONE_BLOCK)
    print("SOS blocksfreed: B limit {} taken\n", ONE_BLOCK)
    var given: UInt = 0
    while given < PAST_BODY {
        let s = try system.mint(rights: CHILD_SYSTEM)
        try b.give(system: move s, tag: given + 1) catch {
            let (why, back) = move error
            let _ = move back
            return why
        }
        given = given + 1
    }
    print("SOS blocksfreed: gave B {} records\n", PAST_BODY)
    let c = try system.process_create(image: &c_image, memory: &c_ram)
    try c.quota_set(kind: QuotaKind.Handle, limit: ONE_BLOCK)
    print("SOS blocksfreed: C limit {} taken\n", ONE_BLOCK)
    let d = try system.process_create(image: &d_image, memory: &d_ram)
    match d.quota_set(kind: QuotaKind.Handle, limit: ONE_BLOCK) {
        case Ok(_) -> print("SOS blocksfreed: D limit {} taken\n", ONE_BLOCK),
        case Err(why) -> print("SOS blocksfreed: D limit {}: {}\n", ONE_BLOCK,
                               why),
    }
    return
}
