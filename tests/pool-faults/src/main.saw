// What a pool refuses, and how; the rights it hands down; and a pool given to
// a child (spec §2.5, §2.7, §3).
//
// Root launches `child-pool-leg` once per role, gives it a pool sibling (its
// rights narrowed by the give's keep mask where the role needs it) and one
// allocation out of the pool, and reads how the child ended. A fault is
// `Faulted` (2) in the high half and the reason in the low; a child that ran
// its role to the end exits with 7 (65543).
//
//   SOS poolfaults: allocate without Allocate: status=131075     AccessDenied
//   SOS poolfaults: available without Allocate: status=131075
//   SOS poolfaults: allocate of zero bytes: status=131081        BadArg
//   SOS poolfaults: allocate off the grain: status=131081
//   SOS poolfaults: allocate at another granularity: status=131081
//   SOS poolfaults: available at another granularity: status=131081
//   SOS poolfaults: allocate at the grain with bit 0 set: status=131081
//   SOS poolfaults: available at the grain with bit 0 set: status=131081
//   SOS poolfaults: available with a short record: status=131081
//   SOS poolfaults: available into read-only data: status=131083 BadBuffer
//   SOS poolfaults: a pool as an image: status=131073            BadHandle
//   SOS poolfaults: a pool as a destination: status=131073
//   SOS poolfaults: a pool attached to a Waiter: status=131080   NotWaitable
//   SOS poolfaults: execute, through a pool without MapExecute: status=131075
//   SOS poolfaults: give, through a pool without Transfer: status=131075
//   SOS poolfaults: give, through a whole pool: status=131077    BadState
//   SOS poolleg: kinds pool=15 given=8 own=8
//   SOS poolleg: capped rights pool=67075 allocation=515
//   SOS poolleg: all it holds: ok; one unit more: <NoMemory>
//   SOS poolleg: at its quota, more than the pool holds: <QuotaExceeded>
//   SOS poolleg: at its handle budget (<QuotaExceeded>), the slab full:
//                <NoResource>
//   SOS poolfaults: donate a pool with an allocation out: status=131077
//   SOS poolfaults: the allocation went home to the pool
//   SOS poolfaults: donate the allocation it runs in: status=131077
//   SOS poolfaults: done
//
// The rights legs read in pairs. An allocation carries no bit the pool handle
// it came through lacked: through a pool without `MapExecute` an executable
// map is refused, and through one without `Transfer` the allocation cannot be
// given, where the same give through a whole pool gets past that test and is
// refused only because a running process takes no give. The caller's `Memory`
// ceiling caps what `allocate` mints, under the pool's own rights.
//
// A granularity must be a single bit of the set: the grain with bit 0 set
// as well holds the set's bit and is still refused.
//
// The pool is root's, shared with the child through a sibling, and every
// allocation from it comes home at the child's teardown, so each role starts
// from the same pool. A child holding the pool can take all it holds and no
// more, and a child at its `Memory` quota is answered `QuotaExceeded` before
// the pool is asked. With the Memory slab full (root fills it with pages
// staged in messages on a connection nobody takes from) and the child at its
// handle budget, an allocation is `NoResource`: the slab is asked before the
// mint, where the handle budget would answer `QuotaExceeded`.
//
// The last two roles donate. The child is given the only handle onto root's
// pool while root keeps an allocation out of it, and then the only handle
// onto the allocation it runs in, whose bytes its own rows grant. Each
// donation is `BadState`: a pool cannot be the kernel's while something it
// lent is out, and an allocation cannot while a row grants it. The pool was
// not taken, so root's allocation goes home to it; a pool the kernel had
// absorbed would not be there to take it back.
//
// Each child's destination is allocated from a pool that is the child's
// destination row, and comes home at the child's teardown, so every trial's
// destination is at the address the child is linked at.

import sos.{System, Process, Memory, Pool, PoolRight, PipeInlet, PipeHandles,
            SosStatus, SystemRight, ALL_RIGHTS, PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

static TAG_BOOT: UInt = 31
static TAG_ROLE: UInt = 32
static TAG_POOL: UInt = 33
static TAG_MEM: UInt = 34

static KEY_DEATH: UInt = 6

/// The roles `child-pool-leg` knows.
static ROLE_ALLOCATE: UInt = 1
static ROLE_AVAILABLE: UInt = 2
static ROLE_ALLOCATE_ZERO: UInt = 3
static ROLE_ALLOCATE_OFF_GRAIN: UInt = 4
static ROLE_ALLOCATE_OTHER_BIT: UInt = 5
static ROLE_AVAILABLE_OTHER_BIT: UInt = 6
static ROLE_AVAILABLE_SHORT: UInt = 7
static ROLE_AVAILABLE_READ_ONLY: UInt = 8
static ROLE_CREATE_POOL_IMAGE: UInt = 9
static ROLE_CREATE_POOL_DESTINATION: UInt = 10
static ROLE_WAIT_POOL: UInt = 11
static ROLE_MAP_EXECUTE: UInt = 12
static ROLE_GIVE: UInt = 13
static ROLE_KINDS: UInt = 14
static ROLE_CEILING: UInt = 15
static ROLE_BUDGET: UInt = 16
static ROLE_QUOTA_FIRST: UInt = 17
static ROLE_ALLOCATE_TWO_BITS: UInt = 18
static ROLE_AVAILABLE_TWO_BITS: UInt = 19
static ROLE_DONATE_POOL: UInt = 20
static ROLE_DONATE_ALLOCATION: UInt = 21
static ROLE_SLAB_FULL: UInt = 22

static CHILD_SYSTEM: UInt32 = (SystemRight.Transfer | SystemRight.ProcessSelf
                               | SystemRight.Debug | SystemRight.ProcessCreate
                               | SystemRight.SlabDonate)

/// A pool handle without `Allocate`.
static NO_ALLOCATE: UInt32 = (PoolRight.Transfer | PoolRight.Mint
                              | PoolRight.Map | PoolRight.MapExecute)
/// A pool handle without `MapExecute`.
static NO_EXECUTE: UInt32 = (PoolRight.Transfer | PoolRight.Mint
                             | PoolRight.Allocate | PoolRight.Map)
/// A pool handle without `Transfer`.
static NO_TRANSFER: UInt32 = (PoolRight.Mint | PoolRight.Allocate
                              | PoolRight.Map | PoolRight.MapExecute)

/// The child's destination: the whole of its region, which is this long on
/// every profile this case runs on.
static REGION_LEN: UInt = 0x4_0000

static PAGE: UInt = 0x1000

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS poolfaults: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&system, &proc) catch {
        print("SOS poolfaults: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS poolfaults: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var image_rec = try proc.boot_handle_next()
    var dests_rec = try proc.boot_handle_next()
    var pool_rec = try proc.boot_handle_next()
    guard let image = image_rec.take_memory() else { return BUG }
    guard let dests = dests_rec.take_pool() else { return BUG }
    guard let pool = pool_rec.take_pool() else { return BUG }

    try leg(&system, &proc, &image, &dests, &pool,
            "allocate without Allocate", ROLE_ALLOCATE, NO_ALLOCATE)
    try leg(&system, &proc, &image, &dests, &pool,
            "available without Allocate", ROLE_AVAILABLE, NO_ALLOCATE)
    try leg(&system, &proc, &image, &dests, &pool,
            "allocate of zero bytes", ROLE_ALLOCATE_ZERO, ALL_RIGHTS)
    try leg(&system, &proc, &image, &dests, &pool,
            "allocate off the grain", ROLE_ALLOCATE_OFF_GRAIN, ALL_RIGHTS)
    try leg(&system, &proc, &image, &dests, &pool,
            "allocate at another granularity", ROLE_ALLOCATE_OTHER_BIT,
            ALL_RIGHTS)
    try leg(&system, &proc, &image, &dests, &pool,
            "available at another granularity", ROLE_AVAILABLE_OTHER_BIT,
            ALL_RIGHTS)
    try leg(&system, &proc, &image, &dests, &pool,
            "allocate at the grain with bit 0 set", ROLE_ALLOCATE_TWO_BITS,
            ALL_RIGHTS)
    try leg(&system, &proc, &image, &dests, &pool,
            "available at the grain with bit 0 set", ROLE_AVAILABLE_TWO_BITS,
            ALL_RIGHTS)
    try leg(&system, &proc, &image, &dests, &pool,
            "available with a short record", ROLE_AVAILABLE_SHORT, ALL_RIGHTS)
    try leg(&system, &proc, &image, &dests, &pool,
            "available into read-only data", ROLE_AVAILABLE_READ_ONLY,
            ALL_RIGHTS)
    try leg(&system, &proc, &image, &dests, &pool,
            "a pool as an image", ROLE_CREATE_POOL_IMAGE, ALL_RIGHTS)
    try leg(&system, &proc, &image, &dests, &pool,
            "a pool as a destination", ROLE_CREATE_POOL_DESTINATION,
            ALL_RIGHTS)
    try leg(&system, &proc, &image, &dests, &pool,
            "a pool attached to a Waiter", ROLE_WAIT_POOL, ALL_RIGHTS)
    try leg(&system, &proc, &image, &dests, &pool,
            "execute, through a pool without MapExecute", ROLE_MAP_EXECUTE,
            NO_EXECUTE)
    try leg(&system, &proc, &image, &dests, &pool,
            "give, through a pool without Transfer", ROLE_GIVE, NO_TRANSFER)
    try leg(&system, &proc, &image, &dests, &pool,
            "give, through a whole pool", ROLE_GIVE, ALL_RIGHTS)
    try leg(&system, &proc, &image, &dests, &pool, "kinds", ROLE_KINDS,
            ALL_RIGHTS)
    try leg(&system, &proc, &image, &dests, &pool, "a capped allocation",
            ROLE_CEILING, ALL_RIGHTS)
    try leg(&system, &proc, &image, &dests, &pool, "a budget", ROLE_BUDGET,
            ALL_RIGHTS)
    try leg(&system, &proc, &image, &dests, &pool, "a quota", ROLE_QUOTA_FIRST,
            ALL_RIGHTS)
    try leg(&system, &proc, &image, &dests, &pool, "the slab full",
            ROLE_SLAB_FULL, ALL_RIGHTS)

    // The pool's only handle goes to the child, with a page of it out here.
    let page = try pool.allocate(len: PAGE)
    let gave_pool = try donor_of_pool(&system, &proc, &image, &dests,
                                      move pool)
    print("SOS poolfaults: {}: status={}\n",
          "donate a pool with an allocation out", gave_pool)
    let _ = move page
    let _ = system.debug_print(
        "SOS poolfaults: the allocation went home to the pool\n")

    // The only handle onto the allocation the child runs in.
    let gave_dst = try donor_of_destination(&system, &proc, &image, &dests)
    print("SOS poolfaults: {}: status={}\n",
          "donate the allocation it runs in", gave_dst)
    return
}

/// Run one trial and print how the child ended.
func leg(system: &System, proc: &Process, image: &Memory, dests: &Pool,
         pool: &Pool, what: String, role: UInt,
         keep: UInt32) -> Result<Void, SosStatus> {
    let status = try trial(&system, &proc, &image, &dests, &pool, role, keep)
    print("SOS poolfaults: {}: status={}\n", what, status)
    return
}

/// Fill the Memory slab with pages out of `pool`, each staged in a message on
/// `inlet`, until an allocation answers `NoResource`; any other refusal is
/// returned. The pages go back when the connection closes.
func fill(pool: &Pool, inlet: &PipeInlet) -> Result<Void, SosStatus> {
    let body: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    var going = true
    while going {
        match pool.allocate(len: PAGE) {
            case Ok(piece) -> {
                var carrier = PipeHandles.none()
                carrier.put(at: 0, memory: move piece)
                let claim = try inlet.post_with(body: &body, len: 0,
                                                handles: &var carrier)
                let _ = move claim
            },
            case Err(why) -> {
                match why {
                    case NoResource -> { going = false },
                    case _ -> { return why },
                }
            },
        }
    }
    return
}

/// Launch the child with `role`, a pool sibling narrowed by `keep` and one
/// allocation, and answer the §8 status word it ends with. For the slab-full
/// role root fills the Memory slab before the child starts, and empties it
/// once the child has ended.
func trial(system: &System, proc: &Process, image: &Memory, dests: &Pool,
           pool: &Pool, role: UInt, keep: UInt32) -> Result<UInt, SosStatus> {
    let dst = try dests.allocate(len: REGION_LEN)
    let child = try system.process_create(image: &image, memory: &dst)
    let _ = move dst
    let ev = try proc.event_create()
    try ev.signal(bits: role)
    try child.give(event: move ev, tag: TAG_ROLE) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let sibling = try pool.mint()
    try child.give(pool: move sibling, tag: TAG_POOL, keep: keep) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let mem = try pool.allocate(len: PAGE)
    try child.give(memory: move mem, tag: TAG_MEM) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let boot = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move boot, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let pipe = try proc.pipe_create()
    let (inlet, outlet) = move pipe
    if role == ROLE_SLAB_FULL {
        try fill(&pool, &inlet)
    }
    let status = try outlive(&proc, &child)
    let _ = move outlet
    let _ = move inlet
    return status
}

/// Launch the child with the donating role and the only handle onto `pool`,
/// and answer the §8 status word it ends with.
func donor_of_pool(system: &System, proc: &Process, image: &Memory,
                   dests: &Pool, pool: Pool) -> Result<UInt, SosStatus> {
    let dst = try dests.allocate(len: REGION_LEN)
    let child = try system.process_create(image: &image, memory: &dst)
    let _ = move dst
    try furnish(&system, &proc, &child, ROLE_DONATE_POOL)
    try child.give(pool: move pool, tag: TAG_POOL) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    return outlive(&proc, &child)
}

/// `donor_of_pool` for the allocation the child runs in: its copied segments
/// and its stack are rows that grant it, for as long as the child lives.
func donor_of_destination(system: &System, proc: &Process, image: &Memory,
                          dests: &Pool) -> Result<UInt, SosStatus> {
    let dst = try dests.allocate(len: REGION_LEN)
    let child = try system.process_create(image: &image, memory: &dst)
    try furnish(&system, &proc, &child, ROLE_DONATE_ALLOCATION)
    try child.give(memory: move dst, tag: TAG_MEM) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    return outlive(&proc, &child)
}

/// Give the child its role and its System sibling.
func furnish(system: &System, proc: &Process, child: &Process,
             role: UInt) -> Result<Void, SosStatus> {
    let ev = try proc.event_create()
    try ev.signal(bits: role)
    try child.give(event: move ev, tag: TAG_ROLE) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let boot = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move boot, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    return
}

/// Start the child and answer the §8 status word it ends with.
func outlive(proc: &Process, child: &Process) -> Result<UInt, SosStatus> {
    let waiter = try proc.waiter_create()
    try waiter.add(process: &child, key: KEY_DEATH)
    try child.start(boot_tag: TAG_BOOT)
    let wake = try waiter.wait()
    let (key, what) = (move wake).open()
    match what {
        case Process(status) -> {
            if key != KEY_DEATH { return BUG }
            return status
        },
        case _ -> { return BUG },
    }
}
