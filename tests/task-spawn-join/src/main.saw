// A task spawned in `main` and joined there (spec §10.1). The spawn keeps the
// thread's executor record in the executor word of the main thread's block,
// and the join runs the task:
//
//   SOS taskjoin: joined 42

import sosmain

func work(n: Int) -> Int {
    n * 2
}

func main() {
    let task = Task.spawn(work(21))
    print("SOS taskjoin: joined {}", task.join())
}
