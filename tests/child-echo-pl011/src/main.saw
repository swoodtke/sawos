// Test child: the userspace UART echo driver, run as a child process, for the
// PL011 board (spec.md §2.5, §9, §12).
//
// The program is the ns16550 child package's (`child-echo-ns16550`), which
// carries the full description of the child-driver cycle. This file covers what
// is specific to this chip: 32-bit sparsely placed registers, a receive-empty
// flag that reads the opposite way, a mask register instead of an enable bit,
// and a control register the driver must turn on. `uart-echo-pl011` explains
// each.
//
// It differs from a root driver in the first two ways its twin lists, neither
// of them about the device: the window arrives by give rather than as a boot
// region row (the drain call is identical), and it ends with `Process.exit`
// because a driver child holds no `SystemRight.Shutdown`.
//
// The window keeps its device memory attribute (nGnRE, uncached, no merging)
// across the handover. The attribute is a property of the `IoMemory` kind,
// which can only produce device-attribute rows, so giving a window away cannot
// turn it into cacheable memory.

import sos.{System, Process, Interrupt, Mapping, Waiter, WaitResult,
            WaitPayload}

// The scalar-to-byte rule, shared with the kernel's own console so a banner
// written through the granted window and one written through a System op agree
// about what a non-ASCII scalar becomes.
import sosrt.{ascii_byte}

// =============================================================================
// The board
// =============================================================================

/// The console UART's register page: where the window this driver is handed
/// lives, and the same number the kernel's board description carries. A mapped
/// device window sits at its physical address, whoever handed it over: the
/// board's `map_place` returns the hardware address for a device window.
static UART_BASE: UInt = 0x0900_0000

/// The interrupt line this board wires the console to: the first shared
/// peripheral line, which this controller numbers after its thirty-two
/// per-core ones.
static UART_IRQ: UInt = 33

/// The key this driver attaches under — its own word, handed back unread.
static ECHO_KEY: UInt = 0x5541

/// How many bytes the driver echoes before it stops.
static ECHO_BYTES: Int = 4

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

// =============================================================================
// The PL011, through the granted window
// =============================================================================

/// The register block. Declaration order is the layout, so the holes between
/// registers are spelled out as fields rather than computed; a gap in a
/// register block is a field like any other.
struct Pl011Regs {
    dr: UInt32,              // +0x00  data
    rsr: UInt32,             // +0x04  receive status / error clear
    reserved0: UInt32,       // +0x08
    reserved1: UInt32,       // +0x0C
    reserved2: UInt32,       // +0x10
    reserved3: UInt32,       // +0x14
    fr: ReadOnly<UInt32>,    // +0x18  flags
    reserved4: UInt32,       // +0x1C
    ilpr: UInt32,            // +0x20  IrDA low-power counter
    ibrd: UInt32,            // +0x24  integer baud rate
    fbrd: UInt32,            // +0x28  fractional baud rate
    lcr_h: UInt32,           // +0x2C  line control
    cr: UInt32,              // +0x30  control
    ifls: UInt32,            // +0x34  interrupt FIFO level select
    imsc: UInt32,            // +0x38  interrupt mask set/clear
    ris: ReadOnly<UInt32>,   // +0x3C  raw interrupt status
    mis: ReadOnly<UInt32>,   // +0x40  masked interrupt status
    icr: WriteOnly<UInt32>,  // +0x44  interrupt clear
}

static_assert(sizeof<Pl011Regs>() == 0x48,
              "the PL011 register block runs to the interrupt-clear register")

/// FR bit 4: the receive FIFO is empty, so data is waiting when it is clear.
/// This is the opposite sense to the other profile's data-ready bit.
static FR_RX_EMPTY: UInt32 = 0x10
/// FR bit 5: the transmit FIFO is full.
static FR_TX_FULL: UInt32 = 0x20

/// IMSC/ICR bit 4: the receive interrupt.
static INT_RX: UInt32 = 0x10
/// Every interrupt this device has, for the clear register.
static INT_ALL: UInt32 = 0x7FF

/// CR: enable the device, its transmitter and its receiver.
static CR_ENABLE_RX_TX: UInt32 = 0x301

/// The driver. A safe type (unsafety is not transitive).
struct Pl011 {
    regs: UnsafeMemory<Pl011Regs, Device>,
}

extension Pl011 {
    init(at: UInt) unsafe -> Pl011 {
        Pl011(regs: UnsafeMemory<Pl011Regs, Device>(at))
    }

    /// Turn the device on and let it raise its line when a byte arrives.
    ///
    /// Nothing is cleared first. The obvious bring-up sequence (enable, clear
    /// stale status, unmask) loses a byte on this chip: its receive interrupt
    /// is a latch set when the FIFO level crosses the trigger, not a level read
    /// off the FIFO. A byte that arrived before the driver existed has already
    /// set that latch, and clearing it destroys the only edge that byte will
    /// produce; nothing re-raises it until something reads. The driver would
    /// then park forever holding a byte.
    ///
    /// There is nothing stale to clear anyway: this driver owns the device from
    /// reset (the kernel writes only the data register, and only to transmit).
    /// A driver inheriting a device from firmware would have to clear, and
    /// drain immediately afterwards.
    func listen(&self) unsafe {
        self.regs.cr.write(CR_ENABLE_RX_TX)
        self.regs.imsc.write(INT_RX)
    }

    func has_byte(&self) unsafe -> Bool {
        (self.regs.fr.read() & FR_RX_EMPTY) == 0
    }

    /// Take the waiting byte. Reading the data register is also what lowers the
    /// device's assertion once the receiver is empty.
    func take_byte(&self) unsafe -> UInt8 {
        UInt8.from(truncating: self.regs.dr.read())
    }

    func put_byte(&self, b: UInt8) unsafe {
        while (self.regs.fr.read() & FR_TX_FULL) != 0 { }
        self.regs.dr.write(b as UInt32)
    }

    func put_str(&self, msg: String) unsafe {
        for scalar in msg.scalars() {
            self.put_byte(ascii_byte(scalar))
        }
    }

    /// Drain everything the receiver holds, echoing each byte, and report how
    /// many.
    ///
    /// Nothing is written to the clear register here: reading the data register
    /// lowers this device's receive interrupt, and a clear on the way out would
    /// race a byte that arrived between the last `has_byte` and the write,
    /// clearing the latch it had just set (the lost byte described on
    /// `listen`).
    func echo_available(&self) unsafe -> Int {
        var n = 0
        while self.has_byte() {
            self.put_byte(self.take_byte())
            n = n + 1
        }
        n
    }
}

// =============================================================================
// The driver
// =============================================================================

/// The line a wait answered with. An Event answer would mean the kernel
/// reported an attachment this process never made, which is a bug in the pair
/// rather than a condition to handle.
func woke_on_line(r: &WaitResult) -> UInt {
    match r.what {
        case Interrupt(line) -> line,
        case _ -> panic("this driver attached only an Interrupt"),
    }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    // A child bootstraps exactly as root does (spec.md §12). A failure here
    // cannot report through `exit`, because `exit` is the op on the handle that
    // just failed to arrive.
    let proc = try system.process_self() catch {
        print("SOS echo: no process handle: {}\n", error)
        return
    }

    // Step 0, obtain the window. Identical to the ns16550 child package's:
    // acquiring a device window is not a per-device act, and a window received
    // from a launcher is received the same way as one from the kernel. The
    // record was queued by `ProcessOp.Give`; nothing in this call can tell.
    var record = try proc.boot_handle_next() catch {
        print("SOS echo: no device window: {}\n", error)
        let _ = proc.exit(EXIT_FAILED)
        return
    }
    guard let window = record.take_iomemory() else {
        let _ = system.debug_print("SOS echo: boot record is not a window\n")
        let _ = proc.exit(EXIT_FAILED)
        return
    }
    let _mapping = try proc.map(iomemory: &window) catch {
        print("SOS echo: map failed: {}\n", error)
        let _ = proc.exit(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS echo: window mapped\n")

    let irq = try proc.interrupt_bind(line: UART_IRQ) catch {
        print("SOS echo: no interrupt: {}\n", error)
        let _ = proc.exit(EXIT_FAILED)
        return
    }
    let waiter = try proc.waiter_create() catch {
        print("SOS echo: no waiter: {}\n", error)
        let _ = proc.exit(EXIT_FAILED)
        return
    }
    try waiter.add(&irq, ECHO_KEY) catch {
        print("SOS echo: attach failed: {}\n", error)
        let _ = proc.exit(EXIT_FAILED)
        return
    }

    // From here on every console byte goes out through the granted window, not
    // through a System op.
    let uart = Pl011(at: UART_BASE)
    uart.listen()
    uart.put_str("SOS echo: driver up\n")

    var echoed = 0
    var line: UInt = 0        // a line number, which is what `woke_on_line` answers
    var wakes = 0
    while echoed < ECHO_BYTES {
        let answer = try waiter.wait() catch {
            print("SOS echo: wait failed: {}\n", error)
            let _ = proc.exit(EXIT_FAILED)
            return
        }
        line = woke_on_line(&answer)
        wakes = wakes + 1
        if answer.key != ECHO_KEY {
            print("SOS echo: woke on key {}, not {}\n", answer.key, ECHO_KEY)
            let _ = proc.exit(EXIT_FAILED)
            return
        }

        // Everything that touches the device happens before the ack (spec.md
        // §9's release rule).
        echoed = echoed + uart.echo_available()
        try irq.ack() catch {
            print("SOS echo: ack failed: {}\n", error)
            let _ = proc.exit(EXIT_FAILED)
            return
        }
    }

    // The wake count is reported, not asserted. Every byte is echoed and at
    // least one interrupt was serviced (the line number came out of the wait
    // record), but how many wakes it took depends on how fast the host feeds
    // the port relative to the guest.
    print("\nSOS echo: done {} bytes on line {} after {} wakes\n",
          echoed, line, wakes)

    // It exits rather than stopping the machine. Its launcher is parked on this
    // process's death and takes the machine down afterwards.
    let _ = proc.exit(EXIT_OK)
}
