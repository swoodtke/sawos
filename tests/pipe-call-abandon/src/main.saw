// A parked fused call is never silently doomed (spec §2.1).
//
// The park a fused `Call` makes is on no list. A `Waiter.wait` puts its thread
// on the Waiter's `blocked` chain and a `Join` puts it on the target's joiner
// list; a fused call involves no Waiter and no thread, so the only thing that
// can ever reach the parked caller is the exchange it is tied to. That makes
// the two arms below the sharpest test of the peer-gone rule:
//
//   SOS callabandon: dropped the obligation      the server took the message
//                                                and then dropped the request
//   SOS callabandon: closed the server end       the server end went away with
//                                                the message still staged
//   SOS callabandon: child said both were closed
//
// Each kills the exchange a different way and each must produce the same answer
// at the client, `SosStatus.PeerClosed` (`resolve`'s own convention), through
// the same wake arm, `kcore.refs.notify_claim`.
//
// The child's exit code is the assertion. Root cannot see what its client was
// told; the client can, and `EXIT_BOTH_CLOSED` is reachable only if both calls
// came back with that exact status. So root reads, out of the status word, a
// conjunction it could not have observed for itself.
//
// The order is deterministic, not lucky. The child is single-threaded and its
// calls park, so it cannot reach its second connection until root has answered
// its first. Root is likewise parked on its Waiter between the two, and the
// child's `send` is what wakes it. Each turn of the transcript is one process
// being unblocked by the other; a poll loop anywhere would have printed the
// same lines without that.
//
// The second arm takes two steps. Dropping the outlet is what raises the level,
// but an attachment is a reference: root's own `add(outlet:)` holds the server
// end open, so the handle going is not the column reaching zero. Root has to
// `remove` its subscription first. Hanging up means destroying the subscription
// as well as the handle.
//
// Each phase is its own function to stay under root's stack size
// (`hal.ROOT_STACK_LEN`).

import sos.{System, Process, Waiter, WaitResult, WaitPayload, PipeInlet,
            PipeOutlet, PipeRequest, OutletLevel, SosStatus, SystemRight,
            PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status the kernel can never hand this program, so meeting it in the error
/// channel means an assertion in this file failed rather than a call.
static BUG: SosStatus = SosStatus.Revoked

/// `Exited`(1) << 16 | 51: `child-caller`'s verdict that both fused calls came
/// back `PeerClosed`.
static CHILD_STATUS: UInt = 65587

static_assert((1 * 65536) + 51 == 65587,
              "the child's status word is Exited in the high bits and its code")

/// The three keys. Distinct words that appear nowhere else, so a record naming
/// one names an attachment this program made.
static KEY_DROPPED: UInt = 81
static KEY_CLOSING: UInt = 82
static KEY_DEATH: UInt = 83

/// The three tags. The two inlets go first, which is the contract
/// `child-caller` reads: the boot set is a FIFO, so records 0 and 1 are the two
/// client ends and the System handle sits behind them.
static TAG_DROPPED: UInt = 11
static TAG_CLOSING: UInt = 12
static TAG_BOOT: UInt = 13

/// What a child of this launcher may ask its System object for. It prints one
/// line, so `Debug` is here; `Transfer` is the bit `give` checks on the thing
/// being given.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS callabandon: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    try run(&system, &proc) catch {
        print("SOS callabandon: failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let _ = proc.exit(EXIT_OK)
}

/// Launch the client, then kill each of its two calls a different way.
func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var image = try proc.boot_handle_next()
    var dest = try proc.boot_handle_next()
    guard let image_mem = image.take_memory() else { return BUG }
    guard let dest_mem = dest.take_memory() else { return BUG }

    let child = try system.process_create(image: &image_mem, memory: &dest_mem)

    // Two connections, one per arm. Each exists to be destroyed a different
    // way.
    let first = try proc.pipe_create()
    let (inlet_a, outlet_a) = move first
    let second = try proc.pipe_create()
    let (inlet_b, outlet_b) = move second

    let waiter = try proc.waiter_create()
    try waiter.add(outlet: &outlet_a, key: KEY_DROPPED)
    try waiter.add(outlet: &outlet_b, key: KEY_CLOSING)
    try waiter.add(process: &child, key: KEY_DEATH)

    try child.give(inlet: move inlet_a, tag: TAG_DROPPED) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try child.give(inlet: move inlet_b, tag: TAG_CLOSING) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let for_child = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try child.start(boot_tag: TAG_BOOT)

    try drop_the_obligation(&outlet_a, &waiter)
    try close_the_server_end(move outlet_b, &waiter)

    // The verdict. Only the death is still attached by now, so this wait can
    // answer nothing else.
    let ended = try waiter.wait()
    if ended.key != KEY_DEATH {
        return BUG
    }
    let status = process_status(&ended)
    if status != CHILD_STATUS {
        print("SOS callabandon: child status={} wanted {}\n", status,
              CHILD_STATUS)
        return BUG
    }
    print("SOS callabandon: child said both were closed\n")
    return
}

/// Arm one: the server takes the message and then drops the obligation.
///
/// This is §2.1's abandonment reaching a caller that is parked rather than
/// polling. The obligation's last reference goes when `request` falls out of
/// scope (RAII over a kernel handle), and that decrement raises the claim's
/// level, which `kcore.refs.notify_claim` turns into a woken thread carrying
/// `PeerClosed`.
///
/// The attachment is left in place; the level it would raise is never asked
/// about again.
func drop_the_obligation(outlet: &PipeOutlet,
                         waiter: &Waiter) -> Result<Void, SosStatus> {
    var buf: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]

    let woke = try waiter.wait()
    if woke.key != KEY_DROPPED {
        return BUG
    }
    if not readable_msg(&woke) {
        return BUG
    }

    let got = try outlet.take()
    let (_, request) = move got
    // The drop is the whole arm. `obligation` is never replied to and never
    // given away; it goes out of scope here, its `deinit` releases the handle,
    // the exchange's request column reaches zero, and the parked caller is told.
    let obligation = move request
    let _ = move obligation

    print("SOS callabandon: dropped the obligation\n")
    return
}

/// Arm two: the server end itself goes, with the message still staged.
///
/// Nothing is ever taken on this connection, so the exchange is `Staged` when
/// its future ends, a different state from arm one's `Taken`, reached by a
/// different column falling and answered by the same word. One arm proves the
/// obligation's zero raises the level; this one proves the connection's does.
///
/// The remove is not bookkeeping. An attachment is a counted reference on the
/// end it watches, so root's own subscription holds the server end open;
/// dropping the handle with the subscription still live would leave the column
/// at one and the client parked. Hanging up is destroying the subscription too
/// (spec §2.1).
func close_the_server_end(outlet: PipeOutlet,
                          waiter: &Waiter) -> Result<Void, SosStatus> {
    var owned = move outlet

    let woke = try waiter.wait()
    if woke.key != KEY_CLOSING {
        return BUG
    }
    if not readable_msg(&woke) {
        return BUG
    }

    try waiter.remove(KEY_CLOSING)
    // Now the last reference goes.
    let _ = move owned

    print("SOS callabandon: closed the server end\n")
    return
}

/// Whether a record says a message is staged. The other arms panic because this
/// program attaches exactly two outlets and one Process and asks each question
/// of the record whose key it has already checked, so any other shape would
/// mean the kernel reported an attachment nobody made.
func readable_msg(r: &WaitResult) -> Bool {
    match r.what {
        case Readable(level) -> {
            match level {
                case Msg -> true,
                case PeerGone -> false,
            }
        },
        case _ -> panic("this record was supposed to be an outlet's"),
    }
}

/// The §8 status word out of a wait record.
func process_status(r: &WaitResult) -> UInt {
    match r.what {
        case Process(status) -> status,
        case _ -> panic("this record was supposed to be the child's"),
    }
}
