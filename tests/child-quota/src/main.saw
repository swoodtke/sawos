// Child that meets its own budget: it is refused by policy, not by the
// machine.
//
// `NoResource` is a machine refusal: a slab with nothing left, an edge nothing
// the caller does can move. This child meets `QuotaExceeded` instead, a policy
// refusal, and the difference is not cosmetic: it releases something it
// already holds and the very next creation succeeds, which `NoResource` could
// never promise.
//
// What the line says:
//
//   SOS childquota: made=4 quota=1 resumed=1
//                        ^      ^        ^
//                        |      |        the release credited the row, and the
//                        |      |        next create was served
//                        |      the refusal at limit+1 was the policy one
//                        |      (`SosStatus.QuotaExceeded`), not the machine's
//                        the child's whole allowance, `DEFAULT_QUOTA_EVENTS`
//
// The slab is never the limit that trips. `MAX_EVENTS` exceeds this child's
// allowance, `DEFAULT_QUOTA_EVENTS`; root creates no events in this case, so at
// the refusal the kernel's Event slab still has free slots. A `quota=1`
// therefore cannot be a machine edge wearing a policy name: if the two were
// confused, the fifth create would have succeeded.
//
// `made=4` is asserted as a number rather than compared against a constant
// this program declares: the child does not know its own allowance and has no
// op to ask for it. It counts what it got, which is the only thing a process
// can honestly say.
//
// The four events are held in four named bindings because there is no
// allocator here and no way to keep a Vector of NoCopy wrappers. Writing them
// out also makes the release below spellable: `let _ = move first` is the
// typed layer's only spelling for an early release, and it needs a name to
// consume.

import sos.{System, Process, Event, SosStatus}

/// What it ends with when the kernel's answers were not the shape this case
/// claims. A number that could not be a count, so the transcript's `code=`
/// field distinguishes the two outcomes on sight.
static EXIT_MISMATCH: UInt = 98

/// The report's flag values, so a reader sees a claim rather than a number.
static YES: UInt = 1
static NO: UInt = 0

func flag(b: Bool) -> UInt {
    if b { YES } else { NO }
}

/// Was this refusal the policy one?
///
/// It matches the case rather than comparing a number, so the claim survives a
/// renumbering of `SosStatus`: the tag is ABI, but this program is written
/// against the name.
func is_quota(status: SosStatus) -> Bool {
    match status {
        case QuotaExceeded -> true,
        case _ -> false,
    }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        print("SOS childquota: no process handle: {}\n", error)
        return
    }

    // Four, which is the allowance. Each is a real Event with a real handle;
    // nothing here is a probe.
    let first = try proc.event_create() catch {
        print("SOS childquota: create 1 failed: {}\n", error)
        let _ = proc.exit(EXIT_MISMATCH)
        return
    }
    let second = try proc.event_create() catch {
        print("SOS childquota: create 2 failed: {}\n", error)
        let _ = proc.exit(EXIT_MISMATCH)
        return
    }
    let third = try proc.event_create() catch {
        print("SOS childquota: create 3 failed: {}\n", error)
        let _ = proc.exit(EXIT_MISMATCH)
        return
    }
    let fourth = try proc.event_create() catch {
        print("SOS childquota: create 4 failed: {}\n", error)
        let _ = proc.exit(EXIT_MISMATCH)
        return
    }
    var made: UInt = 4

    // The fifth, which is the point. `case Ok(_)` would drop the event it was
    // handed, so a kernel that wrongly served this call leaves nothing behind
    // to confuse the arms below; the flag carries the verdict.
    let quota = match proc.event_create() {
        case Ok(_) -> {
            made = made + 1
            false
        },
        case Err(status) -> is_quota(status),
    }

    // The credit. One release, and the row that was full has room. This is the
    // half `NoResource` cannot have: a machine edge does not move because one
    // process let go of something.
    let _ = move first

    let resumed = match proc.event_create() {
        case Ok(_) -> true,
        case Err(_) -> false,
    }

    print("SOS childquota: made={} quota={} resumed={}\n",
          made, flag(quota), flag(resumed))

    // The three still-held events and this thread go back at the teardown,
    // which is the launcher's next line. The exit code is the count, so root
    // reads the same fact through the §8 status word that the console line
    // states.
    let as_promised = (quota && resumed)
    if not as_promised {
        let _ = proc.exit(EXIT_MISMATCH)
    }
    let _ = proc.exit(made)
}
