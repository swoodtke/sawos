// Test child: the userspace UART echo driver, run as a child process, for the
// board whose console is an NS16550A (spec.md §2.5, §9, §12).
//
// It is not root. A launcher (`driver-child`) created it; it received its
// authority in its first argument register like every SOS process (§12), and
// the console's register page reached it as an `IoMemory` the launcher gave it
// under a tag.
//
// The driver body is the same as the root-as-driver twin's (`uart-echo-
// ns16550`): same register block, addresses, enable bit, drain loop and console
// lines. Three things differ, all about being a child:
//
//   1. The window arrives by give rather than as a boot region row. The drain
//      call is identical (`boot_handle_next` + `take_iomemory`): the receiver
//      cannot tell whether the kernel or a launcher queued the record.
//   2. It ends with `Process.exit`, not `System.shutdown`. Its System handle is
//      a masked sibling of root's (`Debug | ProcessSelf | ClockGet |
//      Transfer`), so it cannot stop the machine.
//   3. It is linked at a child base address, because with no translation two
//      processes cannot both live at root's address.
//
// The kernel's part is routing the line and waking this thread; it does not
// grant the window, a process does.
//
// The cycle, spec.md §9 from the driver's side:
//
//   0. obtain the window      drain the boot set for the `IoMemory` its
//                             launcher gave it and `Process.map(iomemory:)` it
//                             into this process
//   1. bind the line          `Process.interrupt_bind(line:)`
//   2. watch it               `Waiter.add(&interrupt, key)`
//   3. enable the device      write its own interrupt-enable register; the
//                             kernel never touches it, because the register is
//                             behind the window and the window is this
//                             process's
//   4. park                   `Waiter.wait()`, which answers with the key and
//                             the line
//   5. service                drain the receiver and echo each byte, all of it
//                             before the ack (§9's release rule)
//   6. `interrupt.ack()`      unmask; a device still asserting fires again
//
// This file names a device, unlike the arch-free processes around it, because a
// driver is its device. The two profiles have different UARTs, so there are two
// packages, named for the chip rather than the machine. Its launcher names no
// device.
//
// The echoed bytes are the test. The harness feeds a known short string into
// the emulator's serial input and asserts it comes back out after the kernel's
// handover marker, i.e. out of a process root created, through a device root
// gave away.

import sos.{System, Process, Interrupt, Mapping, Waiter, WaitResult,
            WaitPayload}

// The scalar-to-byte rule, shared with the kernel's own console so a banner
// written through the granted window and one written through a System op agree
// about what a non-ASCII scalar becomes.
import sosrt.{ascii_byte}

// =============================================================================
// The board
// =============================================================================

/// The console UART's register page: where the window this driver is handed
/// lives, and the same number the kernel's board description carries.
///
/// This board does not translate (spec.md §5.5), so a mapped window is where
/// the hardware is, whoever handed it over. The address is a fact about the
/// device, so the driver's constant does not depend on how the window arrived.
static UART_BASE: UInt = 0x1000_0000

/// The interrupt line this board wires the console to.
static UART_IRQ: UInt = 10

/// The key this driver attaches under. It is the driver's own word (the kernel
/// stores it and hands it back unread), so a dispatcher watching several
/// devices tells them apart by it. The wait answer is checked against it
/// anyway, because a wrong key is a bug this program could not otherwise see.
static ECHO_KEY: UInt = 0x5541

/// How many bytes the driver echoes before it stops. The harness feeds exactly
/// this many; a byte lost anywhere leaves this loop parked and the case fails
/// on the emulator's timeout rather than passing quietly.
static ECHO_BYTES: Int = 4

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

// =============================================================================
// The NS16550A, through the granted window
// =============================================================================

/// The register block. Registers are byte-spaced; declaration order is the
/// layout, so each field sits at its hardware offset. `ReadOnly<T>` exposes
/// only `.read()`.
struct UartRegs {
    thr: UInt8,             // +0  transmit holding / receive buffer
    ier: UInt8,             // +1  interrupt enable
    iir: UInt8,             // +2  interrupt id / FIFO control
    lcr: UInt8,             // +3  line control
    mcr: UInt8,             // +4  modem control
    lsr: ReadOnly<UInt8>,   // +5  line status
    msr: ReadOnly<UInt8>,   // +6  modem status
    scr: UInt8,             // +7  scratch
}

static_assert(sizeof<UartRegs>() == 8,
              "the 16550 register block is eight byte-wide registers")

/// IER bit 0: interrupt when the receiver holds a byte. This is the one bit
/// that makes the device assert its line; the driver writes it, since the
/// kernel unmasked the line at the controller and stopped there.
static IER_RX_READY: UInt8 = 0x01

/// LSR bit 0: a byte is waiting. LSR bit 5: the transmitter will take one.
static LSR_DATA_READY: UInt8 = 0x01
static LSR_TX_EMPTY: UInt8 = 0x20

/// The driver. A safe type (unsafety is not transitive): only the methods
/// reaching through `regs` carry the `unsafe` effect.
struct Uart {
    regs: UnsafeMemory<UartRegs, Device>,
}

extension Uart {
    init(at: UInt) unsafe -> Uart {
        Uart(regs: UnsafeMemory<UartRegs, Device>(at))
    }

    /// Let the device raise its line when a byte arrives.
    func listen(&self) unsafe {
        self.regs.ier.write(IER_RX_READY)
    }

    func has_byte(&self) unsafe -> Bool {
        (self.regs.lsr.read() & LSR_DATA_READY) != 0
    }

    /// Take the waiting byte. Reading the register also clears the device's
    /// assertion, which is why nothing else has to.
    func take_byte(&self) unsafe -> UInt8 {
        self.regs.thr.read()
    }

    func put_byte(&self, b: UInt8) unsafe {
        while (self.regs.lsr.read() & LSR_TX_EMPTY) == 0 { }
        self.regs.thr.write(b)
    }

    func put_str(&self, msg: String) unsafe {
        for scalar in msg.scalars() {
            self.put_byte(ascii_byte(scalar))
        }
    }

    /// Drain everything the receiver holds, echoing each byte, and report how
    /// many. Draining rather than taking one byte per interrupt turns a burst
    /// into one wake; the line is level-triggered, so either would work.
    func echo_available(&self) unsafe -> Int {
        var n = 0
        while self.has_byte() {
            self.put_byte(self.take_byte())
            n = n + 1
        }
        n
    }
}

// =============================================================================
// The driver
// =============================================================================

/// The line a wait answered with. An Event answer would mean the kernel
/// reported an attachment this process never made, which is a bug in the pair
/// rather than a condition to handle.
func woke_on_line(r: &WaitResult) -> UInt {
    match r.what {
        case Interrupt(line) -> line,
        case _ -> panic("this driver attached only an Interrupt"),
    }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    // A child bootstraps exactly as root does: System in the first argument
    // register, its own Process handle derived from it (§12). The handle is a
    // masked sibling of its launcher's, and nothing below can tell.
    //
    // A failure here cannot report through `exit`, because `exit` is the op on
    // the handle that failed to arrive. It returns instead, which ends this
    // process the way a child with no authority always ends.
    let proc = try system.process_self() catch {
        print("SOS echo: no process handle: {}\n", error)
        return
    }

    // Step 0, obtain the window. The record was queued by `ProcessOp.Give` from
    // a launcher rather than by the kernel from a device row of the region
    // table, but the drain is the same. The tag is the giver's word and this
    // driver never reads it, because its launcher's config gave it exactly one.
    //
    // The mapping is held for the program's life. Dropping it would release the
    // handle and not the row (spec.md §2.5: a mapping dropped without an unmap
    // is permanent), so the registers would stay reachable either way, but a
    // driver that means to keep its device keeps the capability `unmap` would
    // need.
    var record = try proc.boot_handle_next() catch {
        print("SOS echo: no device window: {}\n", error)
        let _ = proc.exit(EXIT_FAILED)
        return
    }
    guard let window = record.take_iomemory() else {
        let _ = system.debug_print("SOS echo: boot record is not a window\n")
        let _ = proc.exit(EXIT_FAILED)
        return
    }
    // The child maps the window into itself. This spends `IoMemoryRight.Map` on
    // the window its launcher moved here and `ProcessRight.Map` on this
    // process's own handle: two rights on two objects, neither of them root's.
    let _mapping = try proc.map(iomemory: &window) catch {
        print("SOS echo: map failed: {}\n", error)
        let _ = proc.exit(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS echo: window mapped\n")

    // Bind the interrupt: the line becomes an object, and the object is
    // waitable. The kernel unmasks the line here; the device is still quiet,
    // because its own enable bit is set below. This spends
    // `ProcessRight.InterruptBind`, which arrived on the handle `ProcessSelf`
    // minted, not from the launcher; see `driver-child`.
    let irq = try proc.interrupt_bind(line: UART_IRQ) catch {
        print("SOS echo: no interrupt: {}\n", error)
        let _ = proc.exit(EXIT_FAILED)
        return
    }
    let waiter = try proc.waiter_create() catch {
        print("SOS echo: no waiter: {}\n", error)
        let _ = proc.exit(EXIT_FAILED)
        return
    }
    try waiter.add(&irq, ECHO_KEY) catch {
        print("SOS echo: attach failed: {}\n", error)
        let _ = proc.exit(EXIT_FAILED)
        return
    }

    // From here on every console byte goes out through the granted window, not
    // through a System op.
    let uart = Uart(at: UART_BASE)
    uart.listen()
    uart.put_str("SOS echo: driver up\n")

    var echoed = 0
    var line: UInt = 0        // a line number, which is what `woke_on_line` answers
    var wakes = 0
    while echoed < ECHO_BYTES {
        let answer = try waiter.wait() catch {
            print("SOS echo: wait failed: {}\n", error)
            let _ = proc.exit(EXIT_FAILED)
            return
        }
        line = woke_on_line(&answer)
        wakes = wakes + 1
        if answer.key != ECHO_KEY {
            print("SOS echo: woke on key {}, not {}\n", answer.key, ECHO_KEY)
            let _ = proc.exit(EXIT_FAILED)
            return
        }

        // Everything that touches the device happens before the ack (spec.md
        // §9's release rule). After the ack the line is live again and a
        // second fire may be delivered, so a register read moved below it
        // would race the next byte.
        echoed = echoed + uart.echo_available()
        try irq.ack() catch {
            print("SOS echo: ack failed: {}\n", error)
            let _ = proc.exit(EXIT_FAILED)
            return
        }
    }

    // The last line goes through the runtime seam instead: the kernel writes it
    // because it was asked to.
    //
    // The wake count is reported, not asserted. Every byte is echoed and at
    // least one interrupt was serviced (the line number came out of the wait
    // record), but how many wakes it took depends on how fast the host feeds
    // the port relative to the guest.
    print("\nSOS echo: done {} bytes on line {} after {} wakes\n",
          echoed, line, wakes)

    // It exits rather than stopping the machine: this driver holds no
    // `SystemRight.Shutdown`, so that op does not exist for it. Its launcher is
    // parked on this process's death and takes the machine down afterwards.
    let _ = proc.exit(EXIT_OK)
}
