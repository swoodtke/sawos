// What growing in place refuses as a fault (spec §2.5). Root launches
// `child-grow-leg` once per role and prints the §8 word the child ends with:
// `Faulted` (2) in the high half and the reason in the low.
//
//   SOS growfaults: extend a page from the back: status=131075   AccessDenied
//   SOS growfaults: extend by zero: status=131081                BadArg
//   SOS growfaults: extend off the grain: status=131081
//   SOS growfaults: extend off the grain, the frontier elsewhere: status=131081
//   SOS growfaults: grow through a mapping without Grow: status=131075
//   SOS growfaults: grow by zero: status=131081
//   SOS growfaults: grow off the grain: status=131081
//   SOS growfaults: grow off the grain, past the allocation: status=131081
//   SOS growfaults: grow a device row: status=131081
//   SOS growfaults: grow an unmapped mapping: status=131077      BadState
//   SOS growfaults: map with room off the grain: status=131081
//   SOS growfaults: len through a mapping without Base: status=131075
//   SOS growfaults: len of an unmapped mapping: status=131077
//   SOS growfaults: done
//
// An allocation from the back never carries `Extend`, and a Mapping minted
// without `Grow` cannot grow: each is the `AccessDenied` an unspent right
// answers. A length of zero, or off the grain, is `BadArg` for both ops, as
// is a room off the grain at `map`. A device window's row grants no
// allocation and has no next bytes to grow over (`BadArg`), and a Mapping
// its holder unmapped is `BadState`, as its second `unmap` is. `len` answers
// `base`'s refusals: a Mapping minted without `Base` is `AccessDenied` and an
// unmapped one `BadState`. A length off
// the grain is the fault even where the pool could not serve the extension or
// the growth would pass the allocation's end: the caller's own argument is
// judged before the status either would answer. Every role sets up from a
// fresh pool sibling, so the faulting call is the one under test; a child
// whose call returned would end `Exited` with 8 instead, and one refused a
// status `Exited` with 97.
//
// Each child runs in the same destination, which comes home at the child's
// teardown, and its allocations go back to root's pool then too.

import sos.{System, Process, Memory, Pool, IoMemory, SosStatus, SystemRight}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

static TAG_BOOT: UInt = 31
static TAG_ROLE: UInt = 32
static TAG_POOL: UInt = 33
static TAG_DEVICE: UInt = 34

static KEY_DEATH: UInt = 6

/// The roles `child-grow-leg` knows.
static ROLE_EXTEND_BACK: UInt = 2
static ROLE_EXTEND_ZERO: UInt = 3
static ROLE_EXTEND_OFF_GRAIN: UInt = 4
static ROLE_GROW_UNGRANTED: UInt = 5
static ROLE_GROW_ZERO: UInt = 6
static ROLE_GROW_OFF_GRAIN: UInt = 7
static ROLE_GROW_DEVICE: UInt = 8
static ROLE_GROW_HUSK: UInt = 9
static ROLE_ROOM_OFF_GRAIN: UInt = 10
static ROLE_EXTEND_BLOCKED_OFF_GRAIN: UInt = 11
static ROLE_GROW_WHOLE_OFF_GRAIN: UInt = 12
static ROLE_LEN_UNGRANTED: UInt = 13
static ROLE_LEN_HUSK: UInt = 14

static CHILD_SYSTEM: UInt32 = (SystemRight.Transfer | SystemRight.ProcessSelf
                               | SystemRight.Debug)

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS growfaults: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&system, &proc) catch {
        print("SOS growfaults: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS growfaults: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var image_rec = try proc.boot_handle_next()
    var dest_rec = try proc.boot_handle_next()
    var pool_rec = try proc.boot_handle_next()
    var device_rec = try proc.boot_handle_next()
    guard let image = image_rec.take_memory() else { return BUG }
    guard let dest = dest_rec.take_memory() else { return BUG }
    guard let pool = pool_rec.take_pool() else { return BUG }
    guard let device = device_rec.take_iomemory() else { return BUG }

    try leg(&system, &proc, &image, &dest, &pool, &device,
            "extend a page from the back", ROLE_EXTEND_BACK)
    try leg(&system, &proc, &image, &dest, &pool, &device,
            "extend by zero", ROLE_EXTEND_ZERO)
    try leg(&system, &proc, &image, &dest, &pool, &device,
            "extend off the grain", ROLE_EXTEND_OFF_GRAIN)
    try leg(&system, &proc, &image, &dest, &pool, &device,
            "extend off the grain, the frontier elsewhere",
            ROLE_EXTEND_BLOCKED_OFF_GRAIN)
    try leg(&system, &proc, &image, &dest, &pool, &device,
            "grow through a mapping without Grow", ROLE_GROW_UNGRANTED)
    try leg(&system, &proc, &image, &dest, &pool, &device,
            "grow by zero", ROLE_GROW_ZERO)
    try leg(&system, &proc, &image, &dest, &pool, &device,
            "grow off the grain", ROLE_GROW_OFF_GRAIN)
    try leg(&system, &proc, &image, &dest, &pool, &device,
            "grow off the grain, past the allocation",
            ROLE_GROW_WHOLE_OFF_GRAIN)
    try leg(&system, &proc, &image, &dest, &pool, &device,
            "grow a device row", ROLE_GROW_DEVICE)
    try leg(&system, &proc, &image, &dest, &pool, &device,
            "grow an unmapped mapping", ROLE_GROW_HUSK)
    try leg(&system, &proc, &image, &dest, &pool, &device,
            "map with room off the grain", ROLE_ROOM_OFF_GRAIN)
    try leg(&system, &proc, &image, &dest, &pool, &device,
            "len through a mapping without Base", ROLE_LEN_UNGRANTED)
    try leg(&system, &proc, &image, &dest, &pool, &device,
            "len of an unmapped mapping", ROLE_LEN_HUSK)
    return
}

/// Launch the child with `role`, a pool sibling and, for the device role, a
/// sibling of the device window, and print the §8 word it ends with.
func leg(system: &System, proc: &Process, image: &Memory, dest: &Memory,
         pool: &Pool, device: &IoMemory, what: String,
         role: UInt) -> Result<Void, SosStatus> {
    let child = try system.process_create(image: &image, memory: &dest)
    let ev = try proc.event_create()
    try ev.signal(bits: role)
    try child.give(event: move ev, tag: TAG_ROLE) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let sibling = try pool.mint()
    try child.give(pool: move sibling, tag: TAG_POOL) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    if role == ROLE_GROW_DEVICE {
        let window = try device.mint()
        try child.give(iomemory: move window, tag: TAG_DEVICE) catch {
            let (why, back) = move error
            let _ = move back
            return why
        }
    }
    let boot = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move boot, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let waiter = try proc.waiter_create()
    try waiter.add(process: &child, key: KEY_DEATH)
    try child.start(boot_tag: TAG_BOOT)
    let wake = try waiter.wait()
    let (key, what_woke) = (move wake).open()
    match what_woke {
        case Process(status) -> {
            if key != KEY_DEATH { return BUG }
            print("SOS growfaults: {}: status={}\n", what, status)
            return
        },
        case _ -> { return BUG },
    }
}
