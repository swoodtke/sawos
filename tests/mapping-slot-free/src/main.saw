// The mapping slot comes back, and so do the bytes (spec §2.5).
//
// The transcript proves two halves:
//
//   SOS mapfree: rounds=12 refused=0     <- map, unmap, drop recycles past the
//                                           slab. `MAX_MAPPINGS` is below
//                                           the round count, so the last round
//                                           could not have been served out of
//                                           fresh slots, and root's row
//                                           allowance is smaller still, so the
//                                           quota came back too
//   SOS mapfree: husk wrote 94 read 94   <- every handle on the region is gone
//                                           and its bytes are still there: the
//                                           slot survives the handle drop while
//                                           a row counts against it
//   SOS mapfree: recycled read 94        <- the range went back to the pool at
//                                           the last unmap, and a fresh
//                                           allocation produced the same bytes
//   SOS mapfree: done
//
// A Mapping dropped without an unmap frees its slot and leaves its row
// (§2.5's "permanent, safe-but-leaked"). The range returns to its pool only
// when the last reference of either kind drops, handles and installed rows, so
// the interesting husk is the region's. This program makes one deliberately: it
// maps a region, marks its bytes, and then destroys every handle onto it. A
// kernel that counted only handles would have freed the slot and given the
// range to the next `Allocate` while a protection row was still reaching those
// very bytes.
//
// The third line is the second zero arriving. The unmap takes the last row,
// which is the last reference, so the range goes back onto the pool's free
// list, where it is adjacent to the unspent frontier and folds straight into
// it, leaving the pool exactly as it was at boot. The next `allocate(CHUNK)`
// therefore hands out the same `[base, base + CHUNK)` it handed out the first
// time, and the marker written through the first mapping is read back through
// the second. Nothing zeroes an allocated range, so identical bytes at an
// identical address is what "the same memory came back" looks like from
// userspace, where a region has no bounds reader to ask.
//
// A kernel without pool returns fails this by faulting, not by printing a wrong
// number: its cursor would have moved past the first chunk, the second one
// would hand out the next page, and the read at `base` would touch an address
// no row grants any more.

import sos.{System, Process, Memory, Pool, Mapping, MapAccess, SosStatus}

// The address of this program's first mapping: its config, per architecture, in
// C because Saw cannot name an address. See `tests/poolbase_riscv32.c`.
extern "C" {
    func sos_test_pool_base() -> UInt
}

/// One protection unit's worth on either profile.
static CHUNK: UInt = 0x1000

/// Read and write, which is what a scratch region wants.
static RW: UInt32 = MapAccess.Read | MapAccess.Write

/// How many map/unmap/drop rounds the loop runs. Past `MAX_MAPPINGS` on
/// purpose: root's row budget is smaller still, so completing this many rounds
/// is possible only with both the slot and the quota row coming back each
/// time.
static ROUNDS: Int = 12

/// The byte this program writes through the first mapping and reads back
/// through a mapping of the recycled range. A number that appears nowhere else
/// in this transcript.
static MARK: UInt8 = 0x5E

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// Write one byte through a mapping. `unsafe` because it names a pointer type,
/// and confined to one line.
func poke(addr: UInt, value: UInt8) unsafe {
    UnsafeMemory<UInt8, Normal>(addr).write(value)
}

/// Read one byte back.
func peek(addr: UInt) unsafe -> UInt8 {
    UnsafeMemory<UInt8, Normal>(addr).read()
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS mapfree: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The boot set carries one row: the RAM pool, tag 0 because it is the only
    // one.
    var record = try proc.boot_handle_next() catch {
        print("SOS mapfree: no pool region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let pool = record.take_pool() else {
        let _ = system.debug_print("SOS mapfree: boot record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let chunk = try pool.allocate(len: CHUNK) catch {
        print("SOS mapfree: allocation failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let base = sos_test_pool_base()

    // ===== Round trips: map, unmap, drop =====
    //
    // The mapping wrapper is bound by the arm so it can be unmapped (`unmap` is
    // a method on the object) and then dies at the arm's end, which releases
    // the only handle and takes the count to zero. Both halves are needed and
    // do different things: the unmap returns the row (to the hardware and to
    // the ledger), the drop returns the slot.
    var rounds = 0
    var refused: UInt = 0
    while rounds < ROUNDS && refused == 0 {
        match proc.map(memory: &chunk, access: RW) {
            case Ok(m) -> {
                try m.unmap() catch { refused = 2 }
                rounds = rounds + 1
            },
            case Err(_) -> { refused = 1 },
        }
    }
    print("SOS mapfree: rounds={} refused={}\n", rounds, refused)

    // ===== The region husk: no handles, and a row still counting =====
    //
    // The order is the point. The row goes in, the bytes are marked, and then
    // every handle on the region is destroyed (`chunk` was the only one),
    // leaving an object nothing can name and something is still using.
    let held = try proc.map(memory: &chunk, access: RW) catch {
        print("SOS mapfree: husk map failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    poke(base, MARK)
    let _ = move chunk

    print("SOS mapfree: husk wrote {} read {}\n", MARK as Int, peek(base) as Int)

    // ===== The second zero: the last row goes, and the range comes home =====
    //
    // Nothing else in this program can reach those bytes after this line: the
    // handles are gone and the row is being taken away. That is precisely when
    // the pool may have them back.
    try held.unmap() catch {
        print("SOS mapfree: unmap failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // And the same bytes come back out. A first-fit allocation from a pool
    // whose only hole folded into its frontier is the frontier again, so this
    // region is
    // `[base, base + CHUNK)` for the second time, and the marker is still in
    // it, because a returned range is bytes rather than a promise.
    let again = try pool.allocate(len: CHUNK) catch {
        print("SOS mapfree: re-allocation failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _again_map = try proc.map(memory: &again, access: RW) catch {
        print("SOS mapfree: re-map failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS mapfree: recycled read {}\n", peek(base) as Int)

    let _ = system.debug_print("SOS mapfree: done\n")
    let _ = proc.exit(EXIT_OK)
    let _ = system.shutdown(EXIT_FAILED)
}
