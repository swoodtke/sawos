// SOS M5 unit 5: THE MAPPING SLOT COMES BACK, AND SO DO THE BYTES (sawos design
// 28, on design 25 D-5; M3 unit 5's design 7 D-1/D-2; §2.5).
//
// **THIS CASE WAS RETARGETED BY DESIGN 28**, which is authorized by that brief
// by name, and the two halves it now proves are one sentence apart:
//
//   SOS mapfree: rounds=12 refused=0     <- MAP, UNMAP, DROP recycles past the
//                                           slab. `MAX_MAPPINGS` is 8, so a
//                                           twelfth round could not have been
//                                           served out of fresh slots — and
//                                           root's ROW allowance is smaller
//                                           still, so the quota came back too
//   SOS mapfree: husk wrote 94 read 94   <- EVERY HANDLE ON THE REGION IS GONE
//                                           and its bytes are still there: the
//                                           slot SURVIVES the handle drop while
//                                           a row counts against it
//   SOS mapfree: recycled read 94        <- the range went back to the pool at
//                                           the LAST UNMAP, and a fresh split
//                                           produced THE SAME BYTES
//   SOS mapfree: done
//
// **WHAT THE SECOND LINE USED TO CLAIM, AND WHY IT CHANGED.** It read the same
// numbers and meant something narrower: a MAPPING dropped without an unmap frees
// its slot and leaves its row, so §2.5's "permanent, safe-but-leaked" was
// mechanical rather than described. That is still true and is still what happens
// to the Mapping object here. What design 25 D-5 ruled is the other side of it —
// the RANGE returns to its pool only when the LAST reference of EITHER kind
// drops, handles AND installed rows — so the interesting husk is now the
// REGION's. This program makes one deliberately: it maps a region, marks its
// bytes, and then destroys every handle onto it. A kernel that counted only
// handles would have freed the slot and given the range to the next `Split`
// while a protection row was still reaching those very bytes.
//
// **AND THE THIRD LINE IS THE SECOND ZERO ARRIVING.** The unmap takes the last
// row, which is the last reference, so the range goes back onto the pool root's
// free list — where it is adjacent to the unspent frontier and folds straight
// into it, leaving the pool exactly as it was at boot. The next `split(CHUNK)`
// therefore hands out the same `[base, base + CHUNK)` it handed out the first
// time, and the marker written through the FIRST mapping is read back through
// the SECOND. Nothing zeroes a split range, so identical bytes at an identical
// address is what "the same memory came back" looks like from userspace, which
// is the only place a region has no bounds reader to ask.
//
// A KERNEL WITHOUT POOL RETURNS FAILS THIS BY FAULTING, not by printing a wrong
// number: its cursor would have moved past the first chunk, the second split
// would hand out the NEXT page, and the read at `base` would touch an address no
// row grants any more.

import sos.{System, Process, Memory, Mapping, MapAccess, SosStatus}

// WHERE THE POOL IS — this program's config, per architecture, in C because Saw
// cannot name an address (DF-172a). See `tests/poolbase_riscv32.c`.
extern "C" {
    func sos_test_pool_base() -> UInt
}

/// One protection unit's worth on either profile.
static CHUNK: UInt = 0x1000

/// Read and write, which is what a scratch region wants.
static RW: UInt32 = MapAccess.Read | MapAccess.Write

/// How many map/unmap/drop rounds the loop runs. **PAST `MAX_MAPPINGS` ON
/// PURPOSE** — the kernel's Mapping slab holds eight and root's row budget is
/// smaller still, so twelve completed rounds could not be served without both
/// the slot and the quota row coming back each time.
static ROUNDS: Int = 12

/// The byte this program writes through the first mapping and reads back
/// through a mapping of the RECYCLED range. A number that appears nowhere else
/// in this transcript.
static MARK: UInt8 = 0x5E

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// Write one byte through a mapping. `unsafe` because it names a pointer type,
/// and confined to one line for design 136's reason.
func poke(addr: UInt, value: UInt8) unsafe {
    UnsafeMemory<UInt8, Normal>(addr).write(value)
}

/// Read one byte back.
func peek(addr: UInt) unsafe -> UInt8 {
    UnsafeMemory<UInt8, Normal>(addr).read()
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS mapfree: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The boot set carries one row: the RAM POOL, tag 0 because it is the only
    // one. Root's config is what says so.
    var record = try proc.boot_handle_next() catch {
        print("SOS mapfree: no pool region: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let pool = record.take_memory() else {
        let _ = system.debug_print("SOS mapfree: boot record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let chunk = try pool.split(len: CHUNK) catch {
        print("SOS mapfree: split failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let base = sos_test_pool_base()

    // ===== ROUND TRIPS: map, unmap, drop =====
    //
    // The mapping wrapper is bound BY THE ARM so it can be UNMAPPED — `unmap`
    // is a method on the object — and then dies at the arm's end, which
    // releases the only handle and takes the count to zero. Both halves are
    // needed and they do different things: the unmap returns the ROW (to the
    // hardware and to the ledger), the drop returns the SLOT.
    var rounds = 0
    var refused: UInt = 0
    while rounds < ROUNDS && refused == 0 {
        match proc.map(memory: &chunk, access: RW) {
            case Ok(m) -> {
                try m.unmap() catch { refused = 2 }
                rounds = rounds + 1
            },
            case Err(_) -> { refused = 1 },
        }
    }
    print("SOS mapfree: rounds={} refused={}\n", rounds, refused)

    // ===== THE REGION HUSK: no handles, and a row still counting =====
    //
    // The order is the whole point. The row goes in, the bytes are marked, and
    // then EVERY HANDLE on the region is destroyed — `chunk` was the only one —
    // leaving an object nothing can name and something is still using.
    let held = try proc.map(memory: &chunk, access: RW) catch {
        print("SOS mapfree: husk map failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    poke(base, MARK)
    let _ = move chunk

    print("SOS mapfree: husk wrote {} read {}\n", MARK as Int, peek(base) as Int)

    // ===== THE SECOND ZERO: the last row goes, and the range comes home =====
    //
    // Nothing else in this program can reach those bytes after this line: the
    // handles are gone and the row is being taken away. That is precisely when
    // the pool may have them back.
    try held.unmap() catch {
        print("SOS mapfree: unmap failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // AND THE SAME BYTES COME BACK OUT. A first-fit split of a pool whose only
    // hole folded into its frontier is the frontier again, so this region is
    // `[base, base + CHUNK)` for the second time — and the marker is still in
    // it, because a returned range is bytes rather than a promise.
    let again = try pool.split(len: CHUNK) catch {
        print("SOS mapfree: re-split failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _again_map = try proc.map(memory: &again, access: RW) catch {
        print("SOS mapfree: re-map failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    print("SOS mapfree: recycled read {}\n", peek(base) as Int)

    let _ = system.debug_print("SOS mapfree: done\n")
    let _ = proc.exit(EXIT_OK)
    let _ = system.shutdown(EXIT_FAILED)
}
