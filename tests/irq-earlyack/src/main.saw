// Acking an interrupt that has not fired faults the process (spec §9's
// at-most-one-unacked-fire, and the faults rule, §5.7).
//
// Why a fault rather than a no-op: §9 allows at most one unacked fire per
// Interrupt, and a driver learns about a fire only by being told, through a
// wait it made. So an ack with nothing pending is a driver that acked twice for
// one fire, or acked before it ever waited; in both cases the next fire gets
// acked by a servicer that never serviced it, and the symptom is a dropped byte
// or a wedged device downstream with nothing to point at. Tolerating it here
// would make that bug silent.
//
// The line is one both boards have and neither raises on its own, so one source
// serves both profiles and nothing can fire between the bind and the ack.

import sos.{System, Process, Interrupt}

/// A line both machines wire and neither asserts unasked.
static QUIET_LINE: UInt = 5

static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS earlyack: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let irq = try system.interrupt_bind(line: QUIET_LINE) catch {
        print("SOS earlyack: no interrupt: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let _ = system.debug_print("SOS earlyack: bound, acking without a fire\n")

    // Does not return: the kernel terminates this process.
    let _ = irq.ack()

    let _ = system.debug_print("SOS earlyack: still alive, which is the bug\n")
    let _ = system.shutdown(EXIT_FAILED)
}
