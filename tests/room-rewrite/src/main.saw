// The args record of a call parked for room is read again at the resume, and
// what it says then is held to the rules the call was held to (spec §2.1).
//
// Root launches `child-room-rewrite` once per trial. Its first thread makes a
// fused call on a ring root has filled, so the call parks with its record in
// the child's own data; its second thread then rewrites the record and tells
// root, and root takes one message, which is the room the call was waiting for:
//
//   SOS roomrewrite: length past a slot: the process ended with BadArg
//   SOS roomrewrite: length past a slot: the ring is whole
//   SOS roomrewrite: shorter length: the message carries the new length
//   SOS roomrewrite: shorter length: the call was answered
//   SOS roomrewrite: done
//
// A length past `PIPE_BODY_BYTES` is the fault it would have been at the call,
// and nothing of the message reaches the ring. A record rewritten into another
// legal message is the message: the kernel copies the record once at the
// resume and acts on that copy.

import sos.{System, Process, Memory, Pool, Waiter, PipeInlet, PipeOutlet,
            PipeInletRight, SosStatus, SystemRight, PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.BadImage

static TAG_BOOT: UInt = 31
static TAG_ROLE: UInt = 32
static TAG_INLET: UInt = 35
static TAG_EVENT: UInt = 37

static KEY_DEATH: UInt = 6
static KEY_EVENT: UInt = 7

/// The roles `child-room-rewrite` knows.
static ROLE_OVERSIZE: UInt = 1
static ROLE_SHORTER: UInt = 2

/// The length role 2 rewrites the record to.
static SHORTER_BYTES: UInt = 4

static CHILD_SYSTEM: UInt32 = (SystemRight.ProcessSelf | SystemRight.Transfer)
static POST_ONLY: UInt32 = PipeInletRight.Post

/// The child's destination: the whole of its region, allocated from the pool
/// that is its destination row, and home again at the child's teardown.
static REGION_LEN: UInt = 0x4_0000

/// The §8 status word of a process ended with `BadArg`: `Faulted` in the high
/// half and the reason (9) in the low.
static BAD_ARG: UInt = 131081

static_assert((2 * 65536) + 9 == 131081,
              "a fault word is Faulted in the high bits, then the reason")

/// The status word of a child that exited with the code 7, which it does when
/// its call was answered: `Exited` in the high half.
static TAKEN: UInt = 65543

static_assert((1 * 65536) + 7 == 65543,
              "an exit word is Exited in the high bits, then the code")

/// The most messages a fill posts before it gives up.
static MAX_FILL: Int = 256

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS roomrewrite: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&system, &proc) catch {
        print("SOS roomrewrite: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS roomrewrite: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var image_rec = try proc.boot_handle_next()
    var dests_rec = try proc.boot_handle_next()
    guard let image = image_rec.take_memory() else { return BUG }
    guard let dests = dests_rec.take_pool() else { return BUG }

    try oversize(&system, &proc, &image, &dests)
    try shorter(&system, &proc, &image, &dests)
    return
}

func say(line: String) {
    print("SOS roomrewrite: {}\n", line)
}

/// Give `child` an Event that carries `value`, under `tag`.
func tell(proc: &Process, child: &Process, tag: UInt,
          value: UInt) -> Result<Void, SosStatus> {
    let ev = try proc.event_create()
    try ev.signal(bits: value)
    try child.give(event: move ev, tag: tag) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    return
}

/// Post empty messages through `inlet` until the ring is full, dropping each
/// claim, and answer how many it took.
func fill(inlet: &PipeInlet) -> Result<Int, SosStatus> {
    var body: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    var staged: Int = 0
    while staged < MAX_FILL {
        match inlet.post(body: &body, len: 0) {
            case Ok(claim) -> {
                let _ = move claim
                staged = staged + 1
            },
            case Err(why) -> {
                match why {
                    case WouldBlock -> { return staged },
                    case _ -> { return why },
                }
            },
        }
    }
    return BUG
}

/// Take and drop `count` messages, requests included.
func drain(outlet: &PipeOutlet, count: Int) -> Result<Void, SosStatus> {
    var n: Int = 0
    while n < count {
        let got = try outlet.take()
        let (_, request) = move got
        let _ = move request
        n = n + 1
    }
    return
}

/// Require the ring behind `inlet` to take as many messages as a fresh one.
func ring_whole(proc: &Process, inlet: &PipeInlet) -> Result<Bool, SosStatus> {
    let pair = try proc.pipe_create()
    let (fresh_inlet, fresh_outlet) = move pair
    let fresh = try fill(&fresh_inlet)
    let _ = move fresh_outlet
    let now = try fill(&inlet)
    return now == fresh
}

/// Wait for the child to end and require the status word `want`.
func ended_with(proc: &Process, child: &Process,
                want: UInt) -> Result<Void, SosStatus> {
    let waiter = try proc.waiter_create()
    try waiter.add(process: &child, key: KEY_DEATH)
    let wake = try waiter.wait()
    let (key, what) = (move wake).open()
    match what {
        case Process(status) -> {
            if key != KEY_DEATH { return BUG }
            if status != want {
                print("SOS roomrewrite: the child ended with status {}\n",
                      status)
                return BUG
            }
        },
        case _ -> { return BUG },
    }
    return
}

/// A child in a destination allocated from `dests`, with its role and the
/// client end of a ring root has filled, started and parked: its first thread
/// in the call, its second gone once it has rewritten the record and
/// signalled. Answers the child, the server end, a post-only sibling of the
/// client end, and how many messages the fill staged.
func parked_child(system: &System, proc: &Process, image: &Memory,
                  dests: &Pool,
                  role: UInt) -> Result<(Process, PipeOutlet, PipeInlet, Int),
                                        SosStatus> {
    let dst = try dests.allocate(len: REGION_LEN)
    let child = try system.process_create(image: &image, memory: &dst)
    let _ = move dst
    try tell(&proc, &child, TAG_ROLE, role)

    let pair = try proc.pipe_create()
    let (inlet, outlet) = move pair
    let spare = try inlet.mint(rights: POST_ONLY)
    let full = try fill(&spare)
    if full == 0 { return BUG }
    try child.give(inlet: move inlet, tag: TAG_INLET) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }

    // The child's second thread signals this once the first has parked.
    let ev = try proc.event_create()
    let rewritten = try ev.mint(rights: 0xFFFF_FFFF)
    try child.give(event: move rewritten, tag: TAG_EVENT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let boot = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move boot, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let waiter = try proc.waiter_create()
    try waiter.add(event: &ev, key: KEY_EVENT)
    try child.start(boot_tag: TAG_BOOT)
    let wake = try waiter.wait()
    let (key, _) = (move wake).open()
    if key != KEY_EVENT { return BUG }

    let parts = (move child, move outlet, move spare, full)
    return move parts
}

/// The rewritten length is past what one message may carry.
func oversize(system: &System, proc: &Process, image: &Memory,
              dests: &Pool) -> Result<Void, SosStatus> {
    let parts = try parked_child(&system, &proc, &image, &dests, ROLE_OVERSIZE)
    let (child, outlet, spare, full) = move parts

    // One exchange settles, which is the room the parked call waits for.
    try drain(&outlet, 1)
    try ended_with(&proc, &child, BAD_ARG)
    say("length past a slot: the process ended with BadArg")

    try drain(&outlet, full - 1)
    let whole = try ring_whole(&proc, &spare)
    if not whole { return BUG }
    say("length past a slot: the ring is whole")
    return
}

/// The rewritten length is a shorter one, which is still a message.
func shorter(system: &System, proc: &Process, image: &Memory,
             dests: &Pool) -> Result<Void, SosStatus> {
    let parts = try parked_child(&system, &proc, &image, &dests, ROLE_SHORTER)
    let (child, outlet, spare, full) = move parts
    let _ = move spare

    // The fill's messages first, then the call's, staged at the resume.
    try drain(&outlet, full)
    let got = try outlet.take()
    let (msg, request) = move got
    if msg.len != SHORTER_BYTES {
        print("SOS roomrewrite: the message carries {} bytes\n", msg.len)
        return BUG
    }
    say("shorter length: the message carries the new length")

    var answer: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    try (move request).reply(body: &answer, len: 0)
    try ended_with(&proc, &child, TAKEN)
    say("shorter length: the call was answered")
    return
}
