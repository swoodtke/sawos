// A process that reads a UART it cannot reach.
//
// The asymmetry is the demonstration. Its sibling holds the console's register
// page, its interrupt line and a mapping onto both. This process holds one pipe
// inlet and a masked System handle, and that is its whole estate: no
// `IoMemory`, no `Mapping`, no `Interrupt`, no address it could dereference.
// Every byte it reads and writes crosses a process boundary through
// `uartproto`.
//
// It holds a sibling inlet, not the inlet. Root minted this one off the
// connection it created and kept the other, so two processes are clients of one
// service over one connection at the same time. Sibling inlets are per-client
// authority (the reason an endpoint keeps `Mint`), and each request carries its
// own reply obligation, so the driver's completion-queue loop routes every
// answer to the right claim with no correlation on the wire.
//
// The loop, `ROUNDS` times:
//
//   READ   a fused `Call` (one trap) that parks until a byte exists. There is
//          no timeout, poll or retry: the driver holds the obligation until its
//          interrupt delivers something, and this thread sleeps on the kernel's
//          own reply path meanwhile.
//   WRITE  a tell: post the byte back, drop the claim, never look. The echo the
//          harness sees is this process's writes coming out of its sibling's
//          transmitter.
//
// It prints nothing. Its launcher asserts a transcript whose ordering depends
// on which process wrote which byte, so a line from here would be one more
// thing to order. The verdict travels in the §8 exit code.

import sos.{System, Process, PipeInlet, PipeMsg, SosStatus, PIPE_BODY_BYTES}
import uartproto.{UartOp, UartBody}

/// How many bytes this client echoes. The harness feeds one more than this:
/// root takes the first byte through its own retained inlet and this process
/// takes the rest, which makes the routing observable (two claims, two
/// processes, one connection).
static ROUNDS: Int = 3

/// Every round read a byte and wrote it back.
static EXIT_ECHOED: UInt = 61
/// A call was refused, or answered a length no read can produce.
static EXIT_MISMATCH: UInt = 62
/// The boot set held no inlet where its launcher's config says one is.
static EXIT_NO_INLET: UInt = 63

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        // Nothing to exit with and nothing to say it on. Returning from the
        // entry faults this process, so the launcher reads `Faulted` where it
        // expected `Exited`.
        return
    }

    var record = try proc.boot_handle_next() catch {
        let _ = proc.exit(EXIT_NO_INLET)
        return
    }
    guard let inlet = record.take_inlet() else {
        let _ = proc.exit(EXIT_NO_INLET)
        return
    }

    let verdict = echo(&inlet)
    let _ = proc.exit(verdict)
}

/// The loop, in its own frame. This body must contain no print, and keeping it
/// apart from the entry makes that visible at a glance.
func echo(inlet: &PipeInlet) -> UInt {
    var req = UartBody.empty()

    var round: Int = 0
    while round < ROUNDS {
        // The blocking read, composed out of shipped parts. `send` is the fused
        // `Call`: it stages the request and parks this thread on a claim the
        // kernel keeps internally, so no handle is minted and no table row is
        // spent however long the wait is. The driver holds this obligation
        // until a device interrupt makes an answer possible; the kernel, which
        // routes all of it, has never heard of a UART.
        let n = req.bare(UartOp.Read)
        let answer = try inlet.send(body: &req.bytes, len: n) catch {
            return EXIT_MISMATCH
        }
        // A read answers exactly one byte: the reply's own `len` is the length
        // prefix, so a wrong length is a protocol violation rather than a short
        // read to loop over.
        if answer.len != 1 {
            return EXIT_MISMATCH
        }
        let b = answer.bytes[0]
        let _ = move answer

        // The tell: post and drop the claim (§2.1's payload-carrying one-way).
        // Nothing comes back and nothing is waited for; the proof it arrived is
        // the byte appearing on the console, written by a process that is not
        // this one.
        let m = req.one(UartOp.Write, b)
        let claim = try inlet.post(body: &req.bytes, len: m) catch {
            return EXIT_MISMATCH
        }
        let _ = move claim

        round = round + 1
    }

    // Flush before exiting. A `Write` is a tell: it returns as soon as the
    // message is staged, so this process can reach `exit` with its last byte
    // still in a ring slot. Take-at-post makes a staged message outlive its
    // sender, so it is still written, but after the kernel's own exit line;
    // without this the console can read `Zq7`, then two teardown rows, then
    // `#`.
    //
    // `Sync` is the barrier: a connection's ring is FIFO, so an answered `Sync`
    // proves every message posted before it has been served.
    let s = req.bare(UartOp.Sync)
    let settled = try inlet.send(body: &req.bytes, len: s) catch {
        return EXIT_MISMATCH
    }
    if settled.len != 0 {
        return EXIT_MISMATCH
    }
    let _ = move settled

    EXIT_ECHOED
}
