// Cutting an image's region under a child that runs from it (spec §2.5,
// §5.6): the child's rows used in place go with the bytes they grant.
//
// The case's one child is hand-assembled (`tests/<arch>/child_inplace.S`):
// its code is used in place in the image, which root cuts off the front of
// the blob as a region of its own and launches the child from. The child is
// started and has not run yet when root cuts that region:
//
//   SOS imagesplit: a cut through the child's code: out of kernel objects
//                                       the cut ends inside the code's row
//   SOS imagesplit: the whole image cut off carries the child's code
//                   then released, the piece holds the bytes: the next cut
//                   of the blob is filler, not the image
//   SOS-H                               the child, run from the image
//   SOS imagesplit: the child exited from its image
//   SOS imagesplit: after its death the image's bytes came back
//
// Last, a second child is created from the image that came back, the whole
// image is cut off again with that child's code row in it, and root donates
// that piece: a region a row still grants is no donation, and the kernel
// ends root (`BadState`; on a board whose blobs are flash, the region rule's
// `BadArg` comes first).

import sos.{System, Process, SlabKind, SosStatus, SystemRight}

static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.Unknown

/// The front of the blob that holds the image (`child_inplace.S`), and a cut
/// that ends inside the image's code, which starts behind the 0x30 bytes of
/// header and segment table.
static PIECE: UInt = 0x100
static THROUGH_CODE: UInt = 0x40

static TAG_BOOT: UInt = 21
static KEY_DEATH: UInt = 6

/// What the child may ask its System object for; `Transfer` is what lets root
/// give it.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

/// The status word of the child's exit with its own code, 0x48.
static EXITED_MARK: UInt = 65608

static_assert((1 * 65536) + 0x48 == 65608,
              "an exit's status word is Exited in the high bits and the code")

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS imagesplit: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&system, &proc) catch {
        print("SOS imagesplit: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS imagesplit: the donation was taken\n")
    let _ = system.shutdown(EXIT_FAILED)
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var blob_rec = try proc.boot_handle_next()
    var ram_rec = try proc.boot_handle_next()
    guard let blob = blob_rec.take_memory() else { return BUG }
    guard let ram = ram_rec.take_memory() else { return BUG }

    let image = try blob.split(len: PIECE)
    let child = try system.process_create(image: &image, memory: &ram)
    try start(&system, &child)

    match image.split(len: THROUGH_CODE) {
        case Ok(_) -> {
            let _ = system.debug_print(
                "SOS imagesplit: a cut through the child's code was taken\n")
            return BUG
        },
        case Err(e) -> {
            print("SOS imagesplit: a cut through the child's code: {}\n", e)
        },
    }

    // The whole image, with the child's code row in it, goes to the piece,
    // and releasing the piece leaves the row holding the bytes. Were they
    // back in the pool, the blob's free list would serve them to this cut.
    let whole = try image.split(len: PIECE)
    let _ = move whole
    let next = try blob.split(len: PIECE)
    match system.process_create(image: &next, memory: &ram) {
        case Ok(_) -> {
            let _ = system.debug_print(
                "SOS imagesplit: the released piece's bytes were free\n")
            return BUG
        },
        case Err(e) -> {
            if e != SosStatus.BadImage { return e }
        },
    }
    let _ = system.debug_print(
        "SOS imagesplit: the whole image cut off carries the child's code\n")

    try wait_exit(&proc, &child)
    let _ = system.debug_print(
        "SOS imagesplit: the child exited from its image\n")

    // `next` is still held, so the free list has only the image to give.
    let back = try blob.split(len: PIECE)
    let again = try system.process_create(image: &back, memory: &ram)
    let _ = system.debug_print(
        "SOS imagesplit: after its death the image's bytes came back\n")

    let held = try back.split(len: PIECE)
    try system.slab_donate(kind: SlabKind.Waiters, memory: move held) catch {
        let (why, back_piece) = move error
        let _ = move back_piece
        print("SOS imagesplit: the donation answered {}\n", why)
        return BUG
    }
    let _ = move again
    let _ = move next
    return
}

/// Give `child` a System handle it may print and exit through, and start it.
func start(system: &System, child: &Process) -> Result<Void, SosStatus> {
    let boot = try system.mint(rights: CHILD_SYSTEM)
    try child.give(system: move boot, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try child.start(boot_tag: TAG_BOOT)
    return
}

/// Wait for `child` to end and require that it exited with its own code.
func wait_exit(proc: &Process, child: &Process) -> Result<Void, SosStatus> {
    let waiter = try proc.waiter_create()
    try waiter.add(process: &child, key: KEY_DEATH)
    let wake = try waiter.wait()
    let (key, what) = (move wake).open()
    match what {
        case Process(status) -> {
            if key != KEY_DEATH || status != EXITED_MARK {
                print("SOS imagesplit: the child ended with status {}\n",
                      status)
                return BUG
            }
        },
        case _ -> { return BUG },
    }
    return
}
