// Binding a line the machine does not have faults the process (spec §9 and the
// faults rule, §5.7).
//
// A line number is the caller's own word, which puts this on the fault side of
// the cut: a driver reads its device's line out of the device's description, so
// a number outside the board's range is a mistake the process could have
// checked. The kernel terminates the process, reports the reason, and stays up
// to report the teardown.
//
// This is a root server rather than a hand-written payload because the typed
// layer makes most caller errors unspellable (you cannot name a handle you were
// not given, and `wait` supplies its own buffer), but a line is an ordinary
// integer the caller chooses, so no type can catch it and the check has to be
// the kernel's. The test therefore lives at the altitude a real driver would
// hit it from.
//
// The number is above both machines' line spaces, so one source serves both
// profiles: one board wires ninety-six sources and the other reports its own
// count, and neither reaches this.

import sos.{System, Interrupt}

/// A line no board in this tree has.
static ABSENT_LINE: UInt = 4000

static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let _ = system.debug_print("SOS badline: binding a line this board lacks\n")

    // Does not return: the kernel terminates this process.
    let _ = system.interrupt_bind(line: ABSENT_LINE)

    let _ = system.debug_print("SOS badline: still alive, which is the bug\n")
    let _ = system.shutdown(EXIT_FAILED)
}
