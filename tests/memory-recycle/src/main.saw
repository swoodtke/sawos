// Spent bytes come back (spec §2.5, §5.9). `memory_split` proves a dropped
// region returns its slab slot; a pool walked to its end would stay walked
// unless the range itself returns to the pool. This proves the range. Two legs,
// and each fails loudly on a kernel without pool returns rather than printing a
// wrong number:
//
//   SOS recycle: quarters=4            <- the pool is taken to its last byte,
//                                         in `PIECES` equal pieces
//   SOS recycle: whole=1               <- given back out of order, the four
//                                         pieces come out again as one
//                                         range the size of the pool. That
//                                         single number is the free list, the
//                                         coalescing and the frontier fold at
//                                         once: a cursor that had not absorbed
//                                         all four could not serve it
//   SOS childtouch: wrote 60 read 60   <- a child writes its mark in a page
//                                         mapped into it out of that same pool
//   SOS recycle: reused read 60        <- the child is dead, and the page came
//                                         home. A fresh split of the same size
//                                         is the same bytes, carrying the mark
//                                         the child left in them
//   SOS recycle: done
//
// Leg 1 is the allocator's arithmetic. Four quarters is the whole pool, so the
// fifth byte does not exist; the pieces are then released 0, 2, 1, 3, out of
// order on purpose, because releasing them in reverse would fold each one
// straight back into the frontier and never build a list at all. This order
// makes a hole (q0), a second disjoint hole (q2), a merge of three into one (q1
// joining them), and finally a fold of the whole pool back into the cursor
// when q3 arrives adjacent to it. The pool ends as it began, which is what
// `whole=1` says: one region, the size of the entire pool.
//
// Leg 2 is the second zero across a process boundary: the range is released
// only when the last reference of either kind drops. Root splits a page, maps
// it into a child, and then destroys both objects on its own side: the Memory
// handle and the Mapping object. Nothing in the system can name that region
// afterwards; the only thing left holding it is the protection row in the
// child's domain, §2.5's second kind of reference. A kernel that counted only
// handles would have put those bytes back on the free list while the child was
// still writing to them. This one waits for the child to die: its teardown
// drops the row, the row was the last reference, and the range goes home. The
// proof is the child's own byte, read back by root through a mapping of a
// region split out after the child was gone.
//
// A kernel without pool returns fails leg 1 at `whole=1` (a `split` that big is
// a `BadArg` fault, so the run dies there) and, if it got past, fails leg 2 by
// faulting on the read: its cursor would have moved on and the second page
// would be somewhere else entirely.
//
// This program is three functions and not one because root's stack is small
// (`hal.ROOT_STACK_LEN`, both profiles) and every `print` with format
// arguments assembles its message in stack scratch, and the scratch of
// different sites does not overlap within one frame. A single `_start` would
// hold every leg's scratch in one frame and can overflow root's stack (arm64
// frames are the wider of the two). So each leg is a function whose frame
// pops, and every diagnostic that is not an assertion is a plain `debug_print`
// of a literal rather than a formatted line. Don't merge the legs: the shape
// looks like taste and is not.

import sos.{System, Process, Memory, Mapping, MapAccess, ClockType,
            Timer, Waiter, SosStatus, SystemRight}

// The address of this program's first mapping, and the pool's size: its config,
// per architecture, in C because Saw cannot name an address. See
// `tests/poolbase_riscv32.c`.
extern "C" {
    func sos_test_pool_base() -> UInt
    func sos_test_pool_len() -> UInt
}

/// One protection unit's worth on either profile.
static CHUNK: UInt = 0x1000

/// How many pieces leg 1 cuts the pool into. The pieces are equal and together
/// are the whole pool, which makes "there is nothing left" a fact of this
/// program's own arithmetic rather than a refusal it would have to survive.
static PIECES: UInt = 4

/// Read and write, which is what a scratch region wants.
static RW: UInt32 = MapAccess.Read | MapAccess.Write

/// The key this case attaches its park timer under, a number that appears
/// nowhere else in the transcript.
static KEY: UInt = 93

/// Twenty milliseconds: three orders of magnitude more than the child needs to
/// be scheduled, touch a page, print and exit. See `map_into_child`.
static PARK_NS: UInt64 = 20_000_000

/// Root's config: the tag the child's System handle travels under.
static TAG_BOOT: UInt = 11

/// What a child of this launcher may ask its System object for: print and
/// learn its own Process object. `Transfer` is the bit `give` checks on the
/// thing being given.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.Transfer)

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// Read one byte back. `unsafe` because it names a pointer type, and confined to
/// one line.
func peek(addr: UInt) unsafe -> UInt8 {
    UnsafeMemory<UInt8, Normal>(addr).read()
}

/// Leg 1: the pool is spent to its last byte and comes back whole.
///
/// The four pieces are separate bindings because the order they are released in
/// is the experiment: 0, 2, 1, 3 makes a hole, a second disjoint hole, a merge
/// of three into one, and then a fold of everything back into the frontier.
func pool_comes_back(system: &System, pool: &Memory, pool_bytes: UInt) -> Bool {
    let quarter = pool_bytes / PIECES
    let q0 = try pool.split(len: quarter) catch {
        let _ = system.debug_print("SOS recycle: quarter split failed\n")
        return false
    }
    let q1 = try pool.split(len: quarter) catch {
        let _ = system.debug_print("SOS recycle: quarter split failed\n")
        return false
    }
    let q2 = try pool.split(len: quarter) catch {
        let _ = system.debug_print("SOS recycle: quarter split failed\n")
        return false
    }
    let q3 = try pool.split(len: quarter) catch {
        let _ = system.debug_print("SOS recycle: quarter split failed\n")
        return false
    }
    print("SOS recycle: quarters={}\n", PIECES)

    // Out of order, which is what builds a list. `let _ = move x` is the
    // release, at the line it is written on rather than at the end of a scope.
    let _ = move q0
    let _ = move q2
    let _ = move q1
    let _ = move q3

    // And out it comes as one range. There is no bounds reader to ask, so the
    // size of the region the kernel is willing to mint is the measurement.
    let whole = try pool.split(len: pool_bytes) catch {
        let _ = system.debug_print("SOS recycle: the pool did not come back\n")
        return false
    }
    let _ = system.debug_print("SOS recycle: whole=1\n")
    let _ = move whole
    true
}

/// Leg 2, first half: give a page to a child, drop everything, and wait for
/// the child to die.
///
/// Both of root's objects go before the child even starts (the Memory handle
/// and the Mapping), so the child's protection row is the only reference left
/// to that region while it runs.
func lend_page_and_wait(system: &System, proc: &Process, child: &Process,
                        pool: &Memory) -> Bool {
    let page = try pool.split(len: CHUNK) catch {
        let _ = system.debug_print("SOS recycle: page split failed\n")
        return false
    }
    let page_map = try child.map(memory: &page, access: RW) catch {
        let _ = system.debug_print("SOS recycle: map failed\n")
        return false
    }
    let _ = move page
    let _ = move page_map

    let for_child = try system.mint(rights: CHILD_SYSTEM) catch {
        let _ = system.debug_print("SOS recycle: mint failed\n")
        return false
    }
    try child.give(system: move for_child, tag: TAG_BOOT) catch {
        let _ = system.debug_print("SOS recycle: give failed\n")
        return false
    }
    try child.start(boot_tag: TAG_BOOT) catch {
        let _ = system.debug_print("SOS recycle: start failed\n")
        return false
    }

    // Park, so the child gets the processor. Everything after this call happens
    // once the child has marked its page, printed, exited and been torn down;
    // its teardown is what gives the page back.
    let clock = try system.clock_get(type: ClockType.Monotonic) catch {
        let _ = system.debug_print("SOS recycle: no clock\n")
        return false
    }
    let waiter = try proc.waiter_create() catch {
        let _ = system.debug_print("SOS recycle: no waiter\n")
        return false
    }
    let timer = try clock.timer_create() catch {
        let _ = system.debug_print("SOS recycle: no timer\n")
        return false
    }
    try waiter.add(&timer, KEY) catch {
        let _ = system.debug_print("SOS recycle: attach failed\n")
        return false
    }
    try timer.arm(after_ns: PARK_NS) catch {
        let _ = system.debug_print("SOS recycle: arm failed\n")
        return false
    }
    try waiter.wait() catch {
        let _ = system.debug_print("SOS recycle: wait failed\n")
        return false
    }
    true
}

/// Leg 2, second half: the same bytes, asked for again.
func page_came_home(system: &System, proc: &Process, pool: &Memory,
                    base: UInt) -> Bool {
    let again = try pool.split(len: CHUNK) catch {
        let _ = system.debug_print("SOS recycle: the page did not come back\n")
        return false
    }
    let _again_map = try proc.map(memory: &again, access: RW) catch {
        let _ = system.debug_print("SOS recycle: re-map failed\n")
        return false
    }
    print("SOS recycle: reused read {}\n", peek(base) as Int)
    true
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS recycle: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // The boot set, in the build's row order: the child's image blob, the RAM it
    // will run in, and the pool this launcher allocates out of.
    var image = try proc.boot_handle_next() catch {
        let _ = system.debug_print("SOS recycle: no image region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var dest = try proc.boot_handle_next() catch {
        let _ = system.debug_print("SOS recycle: no destination region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    var pool_record = try proc.boot_handle_next() catch {
        let _ = system.debug_print("SOS recycle: no pool region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let image_mem = image.take_memory() else {
        let _ = system.debug_print("SOS recycle: image record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let dest_mem = dest.take_memory() else {
        let _ = system.debug_print("SOS recycle: dest record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    guard let pool = pool_record.take_memory() else {
        let _ = system.debug_print("SOS recycle: pool record is not a region\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    if not pool_comes_back(&system, &pool, sos_test_pool_len()) {
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let child = try system.process_create(image: &image_mem,
                                          memory: &dest_mem) catch {
        let _ = system.debug_print("SOS recycle: create failed\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    if not lend_page_and_wait(&system, &proc, &child, &pool) {
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    if not page_came_home(&system, &proc, &pool, sos_test_pool_base()) {
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let _ = system.debug_print("SOS recycle: done\n")
    let _ = proc.exit(EXIT_OK)
    let _ = system.shutdown(EXIT_FAILED)
}
