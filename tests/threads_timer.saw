// The kernel that arms a timer before loading root.
//
// The real kernel (`kernel/main.saw`) arms its tick as the last step before
// root's first entry to user mode, and only when the image's boot flags allow
// it. The preemption case wants it armed before the load and its report on, so
// this entry is the ordinary boot with its own seam calls in front of it, and
// it passes the loader no period of its own.
//
// It names no architecture: which controller and which timer are `hal`'s. What
// is here is the policy, that the tick exists at all and how often. The HAL
// owns a counter and a comparator; the kernel owns the period and composes the
// tick with whatever Timer deadlines processes have armed.

import kcore.{console, load_root_and_enter, start_tick,
    enable_tick_report}
import hal

/// A millisecond, the same period the interrupt cases use. With the scheduler's
/// one-tick slice that is also the timeslice, which is what makes the
/// preemption transcript interleave at a human-readable rate.
static TICK_PERIOD_US: UInt = 1000

@export("kmain")
func kmain() {
    let uart = console()
    uart.write_str("SOS M2: preemptive kernel up on ")
    uart.write_str(hal.arch_name())
    uart.write_str("\n")

    hal.intc_init()
    enable_tick_report()
    start_tick(TICK_PERIOD_US)

    load_root_and_enter()
}
