// SOS M4 unit 4.5: AN OBLIGATION HAS ONE NAME (sawos design 22; `designs/010`
// ruling 12(c); spec §3).
//
// **THE ONE-NAME PROOF ON THE SERVER HALF**, and `pipe-dead-claim` is its mirror
// on the client half. `pipe_request_rights()` withholds the universal `Mint`
// bit, so an obligation cannot be given a second name — and §3's attenuation is
// monotonic, so no sequence of ops can put the bit back:
//
//   SOS noreply: minting a sibling of an obligation
//   SOS: process fault: access denied
//
// **WHY A ONE-SHOT IS THE EXCEPTION TO THE UNIFORM LEAN.** Every other kind
// mints, because a second NAME for an object that outlives one act is a
// perfectly ordinary thing to want. A one-shot is spent by ONE op, so its
// sibling is not a second way to use the object: it is a handle whose only
// possible answer is `PeerClosed`, and it undermines the compile-time single use
// that `consumes` on `reply`/`reply_wait`/`resolve` now delivers.
//
// **DELEGATION IS UNTOUCHED, WHICH IS THE DISTINCTION THE RULE RESTS ON.**
// §2.1's zero-copy example hands a request handle to a third party who answers
// the original client — that is `Transfer` MOVING the one name, which
// `pipe-delegate` and `pipe-delegate-msg` both prove, and which needs no sibling
// at all. Narrowing what a delegate may do is `give`'s KEEP MASK
// (`tests/give-keep-mask`), applied to the name being handed over.
//
// **IT IS A FAULT AND NOT A STATUS** (design 178's faults ruling): a process
// knows which rights it holds, so spending one it was not given is a mistake it
// could have checked. The kernel terminates it and stays up to say so.
//
// WHAT THIS CASE USED TO PROVE was the `Reply` bit itself, through a sibling
// minted without it. That spelling died with the `Mint` bit; the `Reply` gate is
// now reachable only through a `give` keep mask into another process, which is a
// two-process case this unit did not take on — recorded as a follow-up in
// `designs/todo.md` rather than left silent.

import sos.{System, Process, PipeInlet, PipeOutlet, PipeReply, PipeRequest,
            SosStatus, PIPE_BODY_BYTES}

static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS noreply: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let pair = try proc.pipe_create() catch {
        print("SOS noreply: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (inlet, outlet) = move pair

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 1

    let claim = try inlet.post(body: &msg, len: 1) catch {
        print("SOS noreply: post failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let taken = try outlet.take() catch {
        print("SOS noreply: take failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (_, request) = move taken

    // **AND THIS ENDS THE PROCESS.** The obligation's rights word came out of
    // `pipe_request_rights()`, which does not carry `Mint`; asking for a sibling
    // spends a bit that was never granted and never could be.
    let _ = system.debug_print("SOS noreply: minting a sibling of an obligation\n")
    let _ = request.mint()

    // UNREACHABLE: the line above does not return, because the kernel ends this
    // process at the rights check. Written so the refusal reads as a refusal
    // rather than as a missing case.
    let _ = system.debug_print("SOS noreply: an obligation minted a sibling\n")
    let _ = system.shutdown(EXIT_FAILED)
}
