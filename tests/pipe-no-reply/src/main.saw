// An obligation has one name (spec §3).
//
// The one-name proof on the server half; `pipe-dead-claim` is its mirror on the
// client half. `pipe_request_rights()` withholds the universal `Mint` bit, so
// an obligation cannot be given a second name, and attenuation is monotonic, so
// no sequence of ops can put the bit back:
//
//   SOS noreply: minting a sibling of an obligation
//   SOS: process fault: access denied
//
// A one-shot is the exception to the rule that every kind mints. Every other
// kind outlives any one act, so a second name for it is ordinary. A one-shot is
// spent by one op, so its sibling is not a second way to use the object: it is
// a handle whose only possible answer is `PeerClosed`, and it undermines the
// compile-time single use that `consumes` on `reply`/`reply_wait`/`resolve`
// delivers.
//
// Delegation is untouched, which is the distinction the rule rests on. §2.1's
// zero-copy example hands a request handle to a third party who answers the
// original client. That is `Transfer` moving the one name, which
// `pipe-delegate` and `pipe-delegate-msg` both prove, and it needs no sibling.
// Narrowing what a delegate may do is `give`'s keep mask
// (`tests/give-keep-mask`), applied to the name being handed over.
//
// Spending the missing right is a fault and not a status: a process knows
// which rights it holds, so the mistake is one it could have checked. The
// kernel terminates the process and stays up to say so.

import sos.{System, Process, PipeInlet, PipeOutlet, PipeReply, PipeRequest,
            SosStatus, PIPE_BODY_BYTES}

static EXIT_FAILED: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS noreply: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let pair = try proc.pipe_create() catch {
        print("SOS noreply: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (inlet, outlet) = move pair

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 1

    let claim = try inlet.post(body: &msg, len: 1) catch {
        print("SOS noreply: post failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let taken = try outlet.take() catch {
        print("SOS noreply: take failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (_, request) = move taken

    // This ends the process. The obligation's rights word came out of
    // `pipe_request_rights()`, which does not carry `Mint`; asking for a
    // sibling spends a bit that was never granted and never could be.
    let _ = system.debug_print("SOS noreply: minting a sibling of an obligation\n")
    let _ = request.mint()

    // Unreachable: the kernel ends this process at the rights check. Written
    // so the refusal reads as a refusal rather than as a missing case.
    let _ = system.debug_print("SOS noreply: an obligation minted a sibling\n")
    let _ = system.shutdown(EXIT_FAILED)
}
