// A dead read cannot wedge a driver (spec §2.1, abandonment).
//
// Cancellation has no op. Root asks the UART service for a byte on a console
// nobody is typing at. The driver cannot answer, so it holds the obligation,
// and root gives up: a Timer on its own Waiter fires first, root drops its
// claim, and that release is the entire cancellation. The kernel has no notion
// of a timeout; the driver learns only that the request was abandoned, through
// the level it was already watching while it held the obligation.
//
// The transcript, in order:
//
//   SOS uartcancel: read posted        <- a read with no input behind it
//   SOS uartcancel: timed out          <- the Timer, not the claim
//   SOS uartcancel: claim dropped      <- the cancellation, spelled as a drop
//   SOS uartcancel: root wrote this line through the driver
//                                      <- the loop served the next request
//   SOS uartsvc drv: served=5 abandoned=1
//
// The order is forced, not raced. Root yields after posting, and this image
// arms no scheduler tick, so the yield returns only once the driver has taken
// the request and parked in `wait` with nothing else to do. When root's timer
// is ready, whenever that is, the release that abandons the claim wakes the
// driver there, with that record, before anything else is posted. Root's next
// message cannot overtake a delivery that has already happened. The deadline
// is the case's subject and orders nothing: a Timer whose expiry has passed
// answers the wait at once.
//
// The guest gets no serial input, so the device raises its line only for its
// transmitter, and the driver's trap accounting counts each of those
// interrupts.
//
// The driver claims the console when it first runs and releases it at its
// end, and while it holds the claim the kernel's debug print answers
// `Claimed`. So root's lines from its yield to the driver's end go through
// the driver, and the rest wait for the release.

import sos.{System, Process, Memory, IoMemory, PipeInlet, PipeOutlet, PipeReply,
            PipeMsg, Clock, ClockType, Timer, Waiter, WaitResult, WaitPayload,
            SystemRight, SosStatus, PIPE_BODY_BYTES}
import uartproto.{UartOp, UartBody, Uart, UartError}
import uartpipe.{PipeTransport, uart}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.Revoked

/// Root's config: the driver's boot set, in the order it drains.
static TAG_BOOT: UInt = 21
static TAG_WINDOW: UInt = 22
static TAG_OUTLET: UInt = 23
static TAG_LINE: UInt = 24

// The console UART's interrupt line on the board this image runs on, answered
// by the target's own C file (`tests/irq-lines`).
extern "C" {
    func driver_irq_line() -> UInt
}

/// The keys. Three distinct words on one Waiter, which is what §2.2's key
/// uniqueness is for.
static KEY_CLAIM: UInt = 81
static KEY_TIMER: UInt = 82
static KEY_DRIVER: UInt = 83

/// Root's deadline on the read. Nothing depends on how long it is: the driver
/// holds the request before root looks at the clock.
static PARK_NS: UInt64 = 20_000_000

/// What a child of this launcher may ask its System object for: the console
/// claim among it, which the driver takes while it serves.
static CHILD_SYSTEM: UInt32 = (SystemRight.Debug | SystemRight.ProcessSelf
                               | SystemRight.ClockGet | SystemRight.Transfer
                               | SystemRight.Console)

/// `Exited`(1) << 16 | 0: the driver's clean ending.
static DRIVER_STATUS: UInt = 65536

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS uartcancel: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    try run(&system, &proc) catch {
        print("SOS uartcancel: failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS uartcancel: done\n")
    let _ = system.shutdown(EXIT_OK)
}

/// Launch the service, ask it something it cannot answer, give up, and prove
/// the next request is served.
///
/// One phase per function, to stay under `hal.ROOT_STACK_LEN`.
func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var img_rec = try proc.boot_handle_next()
    var ram_rec = try proc.boot_handle_next()
    var window_rec = try proc.boot_handle_next()
    guard let img = img_rec.take_memory() else { return BUG }
    guard let ram = ram_rec.take_memory() else { return BUG }
    guard let window = window_rec.take_iomemory() else { return BUG }

    let driver = try system.process_create(image: &img, memory: &ram)
    let _ = move img
    let _ = move ram

    let pair = try proc.pipe_create()
    let (inlet, outlet) = move pair

    let for_child = try system.mint(rights: CHILD_SYSTEM)
    try driver.give(system: move for_child, tag: TAG_BOOT) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try driver.give(iomemory: move window, tag: TAG_WINDOW) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try driver.give(outlet: move outlet, tag: TAG_OUTLET) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    let line = try system.interrupt_bind(line: driver_irq_line())
    try driver.give(interrupt: move line, tag: TAG_LINE) catch {
        let (why, back) = move error
        let _ = move back
        return why
    }
    try driver.start(boot_tag: TAG_BOOT)
    let _ = system.debug_print("SOS uartcancel: driver started\n")

    // The read nobody can answer: the guest gets no serial input, so the
    // driver holds this obligation for as long as root leaves it outstanding.
    var req = UartBody.empty()
    let n = req.bare(UartOp.Read)
    let claim = try inlet.post(body: &req.bytes, len: n)
    let _ = system.debug_print("SOS uartcancel: read posted\n")

    // Let the driver run until it has taken the request and parked. Nothing
    // ticks in this image, so a yield returns once the driver has nothing left
    // to do.
    let me = try proc.thread_self()
    let _ = me.yield_now()

    // The deadline is root's own. A Waiter holds two things, the claim and a
    // Timer, and whichever is ready first is the answer. The pipe surface has
    // no duration argument; this composition replaces it.
    let clock = try system.clock_get(type: ClockType.Monotonic)
    let waiter = try proc.waiter_create()
    let timer = try clock.timer_create()
    try waiter.add(&claim, KEY_CLAIM)
    try waiter.add(&timer, KEY_TIMER)
    try timer.arm(after_ns: PARK_NS)

    let woke = try waiter.wait()
    if woke.key != KEY_TIMER {
        // The claim answered, which on a console nobody is typing at would mean
        // the driver invented a byte.
        print("SOS uartcancel: woke on key {}, not the timer\n", woke.key)
        return BUG
    }
    let _ = move woke

    // The cancellation, spelled as a drop. There is no `cancel()` verb: the
    // claim's last reference going is the whole of saying "never mind", and
    // deterministic destruction makes the timing of the signal deterministic
    // too. The subscription is a reference like any other, so it goes first:
    // hanging up destroys the subscription as well as the handle (§2.1).
    try waiter.remove(KEY_CLAIM)
    let _ = move claim

    // The loop serves the next request. Everything below is an ordinary round
    // with the ordinary driver: the lines come out of a transmitter root does
    // not own, and the `Sync` that follows is answered, which it could not be
    // if one dead read had wedged the server. The driver holds the console,
    // so root says what it saw through it too.
    var u = uart(move inlet)
    try say_cancelled(&var u) catch {
        print("SOS uartcancel: root's report: {}\n", error)
        return BUG
    }
    try own_round(&var u) catch {
        print("SOS uartcancel: root's round: {}\n", error)
        return BUG
    }

    try waiter.add(process: &driver, key: KEY_DRIVER)
    let _ = move u
    let gone = try waiter.wait()
    if gone.key != KEY_DRIVER { return BUG }
    let status = status_of(&gone)
    let _ = move gone
    if status != DRIVER_STATUS {
        print("SOS uartcancel: driver status={} wanted {}\n", status,
              DRIVER_STATUS)
        return BUG
    }
    let _ = move timer
    let _ = move driver
    return
}

/// `Mark`, two `Write` tells and a `Sync`: the same round `uart-service` runs,
/// with the same measured window on the driver's side.
/// What root saw, through the driver: the Timer answered first, and the
/// claim is gone.
func say_cancelled(u: &var Uart<PipeTransport>) -> Result<Void, UartError> {
    try u.write("SOS uartcancel: timed out\n")
    try u.write("SOS uartcancel: claim dropped\n")
    return
}

func own_round(u: &var Uart<PipeTransport>) -> Result<Void, UartError> {
    try u.mark()
    try u.write("SOS uartcancel: root wrote this line through the driver\n")
    try u.write("SOS uartcancel: one dead read did not wedge it\n")
    try u.sync()
    return
}

/// The §8 status word out of a wait record.
func status_of(r: &WaitResult) -> UInt {
    match r.what {
        case Process(status) -> status,
        case _ -> panic("this record was supposed to be the driver's"),
    }
}
