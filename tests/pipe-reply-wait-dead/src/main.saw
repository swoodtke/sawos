// The reply leg of `reply_wait` fires, and it does not park (spec §2.1's
// abandonment paragraph). Expected: the transcript below, then exit 0.
//
//   SOS replywaitdead: the client let its claim go
//   SOS replywaitdead: reply_wait says the reply did not land: the other end of
//                      this connection is gone
//   SOS replywaitdead: done
//
// A dead client must not stall a server loop. `reply_wait` does two things in
// one trap, so it has two ways to fail, and the order matters: if the reply leg
// fails the op returns at once, without reaching the wait. Otherwise a server
// whose client had already given up would park on a Waiter it entered by
// accident, and one abandoned exchange would take the loop down with it.
//
// The empty Waiter is the assertion. Nothing is attached to the Waiter this
// program hands the op, so a park here has nothing that could ever wake it: the
// case would end `SOS: process fault: every thread blocked`, the same report
// `wait-deadlock` pins. Reaching the `done` line is therefore the proof that no
// park happened.
//
// The error names its leg. `Err(Reply(s))` says the reply did not land and the
// obligation is discharged all the same, so the loop's next act is its own
// `waiter.wait()`; `Err(Wait(s))` would mean the exchange completed and the
// wait broke, which waiting again cannot fix. This case asserts the first and
// refuses the second by name, with a `match` because it is a negative test
// asserting a specific error value.
//
// A second use of the spent obligation is not tested here: `reply` and
// `reply_wait` both consume their receiver, so it is a compile error, and the
// kernel's `BadHandle` check only matters to a raw-altitude caller.
//
// Root plays both sides (post, take, abandon, answer), so nothing here parks
// and the whole case is one thread.

import sos.{System, Process, Waiter, PipeInlet, PipeOutlet, PipeReply,
            PipeRequest, ReplyWaitError, SosStatus, PIPE_BODY_BYTES}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// One byte each way.
static PAYLOAD_LEN: UInt = 1

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS replywaitdead: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    // Empty, and it stays empty. Nothing is ever attached to it (see the
    // header): a park on this Waiter is the failure this case catches.
    let waiter = try proc.waiter_create() catch {
        print("SOS replywaitdead: no waiter: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let pair = try proc.pipe_create() catch {
        print("SOS replywaitdead: create failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (inlet, outlet) = move pair

    var msg: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    var buf: [UInt8; PIPE_BODY_BYTES] = [0; PIPE_BODY_BYTES]
    msg[0] = 1

    let claim = try inlet.post(body: &msg, len: PAYLOAD_LEN) catch {
        print("SOS replywaitdead: post failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }

    let got = try outlet.take() catch {
        print("SOS replywaitdead: take failed: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let (_, request) = move got
    let obligation = move request

    // Drop is the cancellation. There is no `cancel()` verb: releasing the
    // claim is the whole of saying "never mind", and deterministic destruction
    // makes the timing of the signal deterministic too. The server has already
    // taken the message, so this is a client that gave up mid-exchange.
    let _ = move claim
    let _ = system.debug_print("SOS replywaitdead: the client let its claim go\n")

    // The fused answer, into nobody. The reply leg cannot land, so the op comes
    // straight back and the wait leg never runs, which is why the empty Waiter
    // above is harmless and why an abandoned exchange cannot stall a loop.
    match (move obligation).reply_wait(body: &msg, len: PAYLOAD_LEN,
                                       waiter: &waiter) {
        case Ok(_) -> {
            let _ = system.debug_print("SOS replywaitdead: a reply landed on nobody\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
        case Err(e) -> {
            // The error renders itself, leg and status both, out of the two
            // enums' own `describe` arms, so a case added to either without a
            // describe would not compile and a renumbering of the wire table
            // would not move this transcript. The `match` asserts which leg,
            // not the words.
            match e {
                case Reply(_) -> {
                    print("SOS replywaitdead: reply_wait says {}\n", e)
                },
                // The wrong leg would mean the reply landed, which is the one
                // thing an abandoned claim rules out, so it is a failure and
                // not another arm of the same story.
                case Wait(_) -> {
                    print("SOS replywaitdead: the WAIT leg answered: {}\n", e)
                    let _ = system.shutdown(EXIT_FAILED)
                    return
                },
            }
        },
    }

    let _ = system.debug_print("SOS replywaitdead: done\n")
    let _ = system.shutdown(EXIT_OK)
}
