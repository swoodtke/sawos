// Echo child echo0: a process that proves it is real by ending distinctly.
//
// Three of these are alive at once. `MAX_PROCESSES` counts root, so the
// compiled floor does not hold three children; the third concurrent child
// lives in a slot that only exists because the deployment donated one.
// Each child derives its own Process object out of the masked System handle
// its launcher gave it, says one line (which witnesses scheduling, a syscall
// and a handle table), and exits with its own code, so the §8 status word its
// launcher reads says which of the three ended, not merely that one did.
//
// The codes are 41/42/43 and the distinctness is what matters, not the values:
// `Exited`(1) << 16 | code is a word no fault could produce, so a launcher
// asserting it is asserting the kind of death as well as the identity.
//
// A child that cannot reach its own Process object still dies, and says so by
// dying differently: it falls off `_start`, whose link register is zero (§8),
// so the kernel faults it and the launcher reads `Faulted` where it expected
// `Exited`. This is `child-bye`'s reasoning.

import sos.{System}

/// This child's ending. See the header for why distinctness is the property.
static EXIT_CODE: UInt = 41

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        print("SOS echo0: no process handle: {}\n", error)
        return
    }

    let _ = system.debug_print("SOS echo0: alive\n")
    let _ = proc.exit(EXIT_CODE)
}
