// A destination is memory the profile can grant at the addresses the child
// sees it at (spec §2.7, §5.6): `process_create` refuses one whose rows the
// profile cannot install, with `BadImage`, and takes nothing.
//
// Root writes one image, a code segment of two grains at the link base, into
// a page out of its pool, and creates from it:
//
//   SOS destwin: a destination of two MiB and a grain: <what it answered>
//   SOS destwin: the same room after it, for processes and for handles
//   SOS destwin: a destination of two MiB: loaded
//   SOS destwin: done
//
// arm64 links every image at one canonical base (`hal.USER_IMAGE_BASE`) and
// grants a process's RAM rows only inside a page-granular window that ends
// two MiB above it, so there a destination of two MiB is the longest one
// whose stack grant (its top) the profile can install, and one a grain longer
// is `BadImage`. The riscv32 profiles link an image where its destination is
// and can grant any RAM, so there the longer one loads.
//
// The room is counted on each side of that create: how many processes root
// can create, holding each, until one is refused, and how many siblings of
// its System handle it can mint, holding each, until one is refused. A
// refused create that had taken a record, a body or a handle would leave less
// room after it. The counts depend on the build's tables, so the case prints
// only whether they match.
//
// The images carry the architecture's tag and its grain, by the word size:
// a 64-bit word is arm64, whose grain is a page, and a 32-bit word is
// riscv32, whose grain is four bytes.

import sos.{System, Process, Memory, Pool, Mapping, MapAccess, SosStatus,
            SystemRight}

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

/// A status no arm of this case can produce honestly.
static BUG: SosStatus = SosStatus.Unknown

static RW: UInt32 = MapAccess.Read | MapAccess.Write

/// The image's page, the destination the room is counted with, and the two
/// destinations either side of arm64's bound.
static IMAGE_LEN: UInt = 0x1000
static SMALL_LEN: UInt = 0x8000
static TWO_MIB: UInt = 0x20_0000

/// The sosimg format as `imgformat` lays it out: a 24-byte header and a
/// 24-byte record per segment, little-endian.
static MAGIC: UInt32 = 0x4953_4F53
static VERSION: UInt32 = 3
static PRIO: UInt32 = 0x0101_0100
static HEADER_BYTES: UInt = 24
static ARCH_RISCV32: UInt32 = 1
static ARCH_ARM64: UInt32 = 2

/// `SegFlag`'s bits.
static READ: UInt32 = 1
static EXECUTE: UInt32 = 4
static RX_FLAGS: UInt32 = READ | EXECUTE

/// arm64's canonical link base, `hal.USER_IMAGE_BASE`.
static ARM64_LINK_BASE: UInt = 0x4020_0000

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = try system.process_self() catch {
        let _ = system.debug_print("SOS destwin: no process handle\n")
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    try run(&system, &proc) catch {
        print("SOS destwin: refused: {}\n", error)
        let _ = system.shutdown(EXIT_FAILED)
        return
    }
    let _ = system.debug_print("SOS destwin: done\n")
    let _ = system.shutdown(EXIT_OK)
}

func run(system: &System, proc: &Process) -> Result<Void, SosStatus> {
    var pool_rec = try proc.boot_handle_next()
    guard let pool = pool_rec.take_pool() else { return BUG }
    let wide = sizeof<UInt>() == 8
    let grain: UInt = if wide { 0x1000 } else { 4 }

    let image = try pool.allocate(len: IMAGE_LEN)
    let view = try proc.map(memory: &image, access: RW)
    let at = try view.base()

    // Both destinations are allocated before the room is counted, so the
    // handles they take are on both sides of the count.
    let small = try pool.allocate(len: SMALL_LEN)
    let past = try pool.allocate(len: TWO_MIB + grain)
    write_image(at, wide, try link_of(&proc, &small, wide), grain)
    let processes_before = try process_room(&system, &image, &small)
    let handles_before = try handle_room(&system)

    write_image(at, wide, try link_of(&proc, &past, wide), grain)
    let answer = try create_answer(&system, &image, &past)
    print("SOS destwin: a destination of two MiB and a grain: {}\n", answer)

    write_image(at, wide, try link_of(&proc, &small, wide), grain)
    let processes_after = try process_room(&system, &image, &small)
    let handles_after = try handle_room(&system)
    if processes_after == processes_before && handles_after == handles_before {
        say("the same room after it, for processes and for handles")
    } else {
        print("SOS destwin: room for processes {} then {}, for handles {} then {}\n",
              processes_before, processes_after, handles_before, handles_after)
    }

    let bound = try pool.allocate(len: TWO_MIB)
    write_image(at, wide, try link_of(&proc, &bound, wide), grain)
    let child = try system.process_create(image: &image, memory: &bound)
    say("a destination of two MiB: loaded")
    let _ = move child
    try view.unmap()
    return
}

func say(line: String) {
    print("SOS destwin: {}\n", line)
}

/// Is `status` a create or a mint meeting a wall: a full table, or the
/// caller's quota?
func is_full(status: SosStatus) -> Bool {
    match status {
        case NoResource -> true,
        case QuotaExceeded -> true,
        case _ -> false,
    }
}

/// How many processes can be created from `image` into `dest`, each held
/// while the next is asked for, before one is refused. Every one is released
/// on the way back, and a process never started is torn down at the release
/// of its last handle, so the room is whole again on return.
func process_room(system: &System, image: &Memory,
                  dest: &Memory) -> Result<Int, SosStatus> {
    let child = try system.process_create(image: &image, memory: &dest) catch {
        if is_full(error) {
            return 0
        }
        return error
    }
    let more = try process_room(&system, &image, &dest)
    let _ = move child
    return more + 1
}

/// How many siblings of `system` can be minted, each held while the next is
/// asked for, before one is refused; every one is released on the way back.
func handle_room(system: &System) -> Result<Int, SosStatus> {
    let sibling = try system.mint(rights: SystemRight.Debug as UInt32) catch {
        if is_full(error) {
            return 0
        }
        return error
    }
    let more = try handle_room(&system)
    let _ = move sibling
    return more + 1
}

/// What a create from `image` into `dest` answers: `loaded`, or `BadImage`.
/// A process it makes is released at once.
func create_answer(system: &System, image: &Memory,
                   dest: &Memory) -> Result<String, SosStatus> {
    match system.process_create(image: &image, memory: &dest) {
        case Ok(child) -> {
            let _ = move child
            return "loaded"
        },
        case Err(why) -> {
            match why {
                case BadImage -> { return "BadImage" },
                case _ -> { return why },
            }
        },
    }
}

/// Where an image created into `dest` is linked: arm64's canonical base, or
/// on riscv32 the destination's own address, which mapping it answers.
func link_of(proc: &Process, dest: &Memory,
             wide: Bool) -> Result<UInt, SosStatus> {
    if wide {
        return ARM64_LINK_BASE
    }
    let probe = try proc.map(memory: &dest, access: RW)
    let link = try probe.base()
    try probe.unmap()
    return link
}

func poke(at: UInt, value: UInt32) unsafe {
    UnsafeMemory<UInt32, Device>(at).write(value)
}

/// The image at `at`: one code segment of two grains at `link`, where the
/// entry is.
func write_image(at: UInt, wide: Bool, link: UInt, grain: UInt) unsafe {
    let arch = if wide { ARCH_ARM64 } else { ARCH_RISCV32 }
    poke(at, MAGIC)
    poke(at + 4, VERSION | (1 << 16) | (arch << 24))
    poke(at + 8, PRIO)
    poke(at + 12, 0)
    poke(at + 16, link as UInt32)
    poke(at + 20, 0)
    let seg = at + HEADER_BYTES
    poke(seg, link as UInt32)
    poke(seg + 4, 0)
    poke(seg + 8, 0)
    poke(seg + 12, 0)
    poke(seg + 16, (2 * grain) as UInt32)
    poke(seg + 20, RX_FLAGS)
}
