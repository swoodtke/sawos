//! The stock root (spec §12): it launches an image's processes as the image's
//! plan says. The image builder writes the plan for each image, the module
//! `imageplan` in `bootplan`'s terms; this file holds no device code, no
//! address and no interrupt line of its own, and every one it uses is the
//! plan's.
//!
//! The steps, in order (the launch convention, spec §12):
//!
//!   derive     `sosmain`'s start-up adopts its System, derives its Process
//!              handle and its main thread's own Thread handle and drains its
//!              rows into a BootSet, which root takes;
//!   create     create every child from its image blob and destination, and
//!              release both rows;
//!   setup      make each `[[setup]]` write: carve the register's window from
//!              its device row, map it, write the register (reading it first
//!              for a `set` or a `clear`), unmap it and release both;
//!   quota      set each child's declared quota rows;
//!   bands      set the band map of a child whose plan carries a map other
//!              than the simple one (`band_map`), which every created process
//!              has until then;
//!   ceilings   narrow each rights ceiling of a child whose plan lists them
//!              to the plan's word (`restrict_rights`), so that nothing it
//!              mints afterwards holds more; a child with none keeps root's;
//!   give       give each child its records under their tags, in its declared
//!              order: a System sibling keeping the rights the plan names
//!              for the child, a row or a sibling of one, a carve of
//!              one, an interrupt line it binds, a connection's server end or
//!              an inlet minted from it, each keeping the record's keep word;
//!              then each of its heaps' pools, keeping `HEAP_POOL_KEEP`;
//!   start      start every child with its System record's tag;
//!   supervise  make a Waiter and attach every child to it, release every row
//!              and connection end root still holds, and wait for the
//!              children's ends.
//!
//! Root is written with `main`: it reaches its System and Process through
//! `sosmain.context()`, and has no console record, so its lines go through the
//! debug print. It stops the machine itself rather than returning from
//! `main`, which would exit through its Process and add the kernel's teardown
//! line to every transcript.
//!
//! A refusal at `derive` is the start-up's panic, which names it. A later step
//! that fails prints `root: STEP WHO: STATUS` (WHO is the child, with the
//! record's tag for a give; the register for a setup write; or `root`) and
//! stops the machine with status 1. A child's end is reported as
//! `root: NAME ended status=WORD`, the §8 status word. Root stops the machine
//! when a child whose image entry says `on-exit = "shutdown"` ends, with its
//! exit code if it exited and 1 if it did not, and with 0 when every child has
//! ended.
//!
//! A plan that gives one connection's server end twice, names a row root's
//! boot set does not hold, or holds as another kind, or uses a row after
//! giving it whole, is a skew between the plan and the region table the
//! builder wrote beside it, and root panics naming it.
//!
//! Root's heap holds the plan and its own bookkeeping (its children, the
//! connections' ends and the device rows it holds as windows), each vector
//! made once at the length the plan gives it. Nothing else allocates, the
//! start-up's drain and a stop's message included, and the builder links root
//! with an arena of exactly that sum and a margin (`sosimage.plan.root_arena`).
//! So a count the plan has short is a panic naming it, and a bookkeeping
//! vector that would grow is a panic too (`Exact`), never arena the builder
//! did not size.

import sos.{System, Process, Memory, IoMemory, PipeInlet, PipeOutlet,
            WaitResult, BootSet, BootHandle, SosStatus, SystemRight,
            PipeInletRight, PoolRight, QuotaKind}
import bootplan.{Plan, Child, Record, Source, Setup, SetupOp, QuotaName, RightName, CeilingKind,
                 setup_word, reads_first, PROCESS_WORDS, ENDS_WORDS, ROW_TAG_WORDS,
                 ROW_WINDOW_WORDS, SIMPLE_BANDS}
import imageplan
import sosmain
import std.alloc.{GlobalAllocator}

/// The machine's status when every child has ended.
static EXIT_OK: UInt = 0
/// The machine's status when a step fails, or a `shutdown` child ends other
/// than by exiting.
static EXIT_STOPPED: UInt = 1

/// A client's inlet: it may post and hand the end on.
static CLIENT_INLET: UInt32 = (PipeInletRight.Post | PipeInletRight.Transfer)

/// A heap's pool, as the launch convention gives it (spec §12): the runtime
/// allocates and maps its heap from it, extends the heap in place, and cuts
/// shares a program may mint and give; nothing it allocates may be mapped
/// executable.
static HEAP_POOL_KEEP: UInt32 = (PoolRight.Allocate | PoolRight.Map | PoolRight.Transfer
                                 | PoolRight.Mint | PoolRight.Extend)

/// The §8 status word's reason for a process that exited, in its high half.
static REASON_EXITED: UInt = 1
static REASON_SHIFT: UInt = 16
static CODE_MASK: UInt = 0xFFFF

// The bookkeeping's elements, held to the words the builder sizes the arena
// with (`bootplan`).
static_assert(sizeof<Process>() <= PROCESS_WORDS * sizeof<UInt>(),
              "a Process fits PROCESS_WORDS")
static_assert(sizeof<Ends>() <= ENDS_WORDS * sizeof<UInt>(), "an Ends fits ENDS_WORDS")
static_assert(sizeof<UInt>() <= ROW_TAG_WORDS * sizeof<UInt>(), "a tag fits ROW_TAG_WORDS")
static_assert(sizeof<IoMemory?>() <= ROW_WINDOW_WORDS * sizeof<UInt>(),
              "a window fits ROW_WINDOW_WORDS")

/// Whether `exact` is making a vector, the only time `Exact` serves.
unsafe static var MAKING: Bool = false

/// The allocator of root's bookkeeping: it serves the one block `exact` makes
/// each vector with, and refuses by name any later request, which only a
/// vector growing past the length the plan gave it would make.
struct Exact {}

extension Exact: Allocator {
    func alloc(&self, size: Int, align: Int) unsafe -> UnsafePointer<Int8>? {
        if not MAKING {
            panic("root: a vector of root's would grow past the length its plan gave it")
        }
        GlobalAllocator().alloc(size, align)
    }

    func dealloc(&self, ptr: UnsafePointer<Int8>, size: Int, align: Int) unsafe {
        GlobalAllocator().dealloc(ptr, size, align)
    }
}

/// A vector with room for `count` elements, which never grows.
func exact<T>(count: Int) unsafe -> Vector<T, Exact> {
    MAKING = true
    let made = try! Vector<T, Exact>(capacity: count)
    MAKING = false
    move made
}

/// Panics, naming `what`, when a vector the plan gives room for `room`
/// elements holds them all already: the plan's count is short.
func room_for(held: Int, room: Int, what: String) {
    if held >= room {
        panic("root: the plan makes room for {} {}, and root takes one more", room, what)
    }
}

/// A step that failed: which, for whom, the record when it was a give, and
/// the status it answered.
struct Stop {
    step: String
    who: String
    record: UInt?
    status: SosStatus
}

func main() -> Result<Void, SosStatus> {
    let plan = imageplan.plan()
    borrow let system = sosmain.context().system() {
        borrow let proc = sosmain.context().process() {
            let code = try run(&system, &proc, &plan) catch {
                if let tag = error.record {
                    print("root: {} {} record {}: {}", error.step, error.who, tag,
                          error.status)
                } else {
                    print("root: {} {}: {}", error.step, error.who, error.status)
                }
                EXIT_STOPPED
            }
            try system.shutdown(code)
        }
    }
    return
}

func stop(step: String, who: String, status: SosStatus) -> Stop {
    Stop(step: step, who: who, record: None, status: status)
}

/// Every step after `derive`; answers the machine's status.
func run(system: &System, proc: &Process, plan: &Plan) -> Result<UInt, Stop> {
    var rows = Rows(set: sosmain.take_boot_set(), room: plan.windows,
                    tags: exact<UInt>(plan.windows),
                    windows: exact<IoMemory?>(plan.windows))

    var children = exact<Process>(plan.children.len())
    var i = 0
    while i < plan.children.len() {
        borrow let c = plan.children[i] {
            let child = try create(&system, &var rows, &c) catch {
                return stop("create", c.name, error)
            }
            room_for(children.len(), plan.children.len(), "children")
            try! children.push(move child)
        }
        i = i + 1
    }

    i = 0
    while i < plan.setup.len() {
        borrow let s = plan.setup[i] {
            try setup_write(&proc, &var rows, &s) catch {
                return stop("setup", s.register, error)
            }
        }
        i = i + 1
    }

    var ends = exact<Ends>(plan.connections)
    i = 0
    while i < plan.connections {
        room_for(ends.len(), plan.connections, "connections")
        try! ends.push(Ends(inlet: None, outlet: None))
        i = i + 1
    }
    i = 0
    while i < plan.children.len() {
        borrow let c = plan.children[i] {
            borrow let child = children[i] {
                try set_quota(&child, &c) catch {
                    return stop("quota", c.name, error)
                }
                if c.bands != SIMPLE_BANDS {
                    try child.band_map(c.bands) catch {
                        return stop("bands", c.name, error)
                    }
                }
                try restrict(&child, &c) catch {
                    return stop("ceilings", c.name, error)
                }
                let keep = system_mask(&c)
                var r = 0
                while r < c.records.len() {
                    borrow let record = c.records[r] {
                        try give(&system, &proc, &child, &var rows, &var ends, &record, keep) catch {
                            return Stop(step: "give", who: c.name, record: record.tag,
                                        status: error)
                        }
                    }
                    r = r + 1
                }
            }
        }
        i = i + 1
    }
    i = 0
    while i < plan.children.len() {
        borrow let c = plan.children[i] {
            borrow let child = children[i] {
                try child.start(boot_tag: c.start) catch {
                    return stop("start", c.name, error)
                }
            }
        }
        i = i + 1
    }

    let code = try supervise(&proc, &plan, &children, move rows, move ends) catch {
        return stop("supervise", "root", error)
    }
    return code
}

/// Root's rows: the boot set, and the device rows taken out of it, each kept
/// while a later record or write still carves or mints from it, of which the
/// plan makes room for `room`.
struct Rows {
    set: BootSet
    room: Int
    tags: Vector<UInt, Exact>
    windows: Vector<IoMemory?, Exact>
}

extension Rows: NoCopy {}

extension Rows {
    /// The record of the row `tag`, taken out of the set.
    func take(&var self, tag: UInt) -> BootHandle {
        guard let record = self.set.take(tag) else {
            panic("root: the plan names row {}, which root's boot set does not hold", tag)
        }
        move record
    }

    /// The allocation of the row `tag`, taken out of the set.
    func allocation(&var self, tag: UInt) -> Memory {
        var record = self.take(tag)
        guard let memory = record.take_memory() else {
            panic("root: the plan names row {} as an allocation, and it is not one", tag)
        }
        move memory
    }

    /// The index in `windows` of the device row `tag`, or -1 when it was
    /// never taken out of the set.
    func find(&self, tag: UInt) -> Int {
        var k = 0
        while k < self.tags.len() {
            if (self.tags.get(k) ?? 0) == tag {
                return k
            }
            k = k + 1
        }
        -1
    }

    /// The index in `windows` of the device row `tag`, taken out of the set
    /// the first time it is asked for.
    func window(&var self, tag: UInt) -> Int {
        let k = self.find(tag)
        if k >= 0 {
            self.held(k, tag)
            return k
        }
        var record = self.take(tag)
        guard let w = record.take_iomemory() else {
            panic("root: the plan names row {} as a device's, and it is not one", tag)
        }
        room_for(self.tags.len(), self.room, "windows")
        try! self.tags.push(tag)
        try! self.windows.push(move w)
        self.tags.len() - 1
    }
}

extension Rows {
    /// Panics when the device row `tag`, at `k` in `windows`, was given
    /// whole already.
    func held(&self, k: Int, tag: UInt) {
        if self.windows[k].is_none() {
            panic("root: the plan uses row {} after giving it whole", tag)
        }
    }
}

/// One child, created from its rows; both rows are released.
func create(system: &System, rows: &var Rows, c: &Child) -> Result<Process, SosStatus> {
    let blob = rows.allocation(c.image)
    let memory = rows.allocation(c.destination)
    system.process_create(image: &blob, memory: &memory)
}

/// A register's word, as a mapped device window shows it.
struct Word {
    v: UInt32,
}

/// One setup write.
func setup_write(proc: &Process, rows: &var Rows, s: &Setup) -> Result<Void, SosStatus> {
    let k = rows.window(s.row)
    let part = try rows.windows[k]!.carve(offset: s.offset, len: s.len)
    let mapping = try proc.map(iomemory: &part)
    let base = try mapping.base()
    write_register(base + s.at, s.op, s.value)
    try mapping.unmap()
    return
}

/// Write the register at `address` as `op` says.
func write_register(address: UInt, op: SetupOp, value: UInt32) unsafe {
    let register = UnsafeMemory<Word, Device>(address)
    var old: UInt32 = 0
    if reads_first(op) {
        old = register.v.read()
    }
    register.v.write(setup_word(op, old, value))
}

/// `sos`'s name for a plan's quota kind.
func quota_kind(name: QuotaName) -> QuotaKind {
    match name {
        case Thread -> QuotaKind.Thread,
        case Event -> QuotaKind.Event,
        case Waiter -> QuotaKind.Waiter,
        case Timer -> QuotaKind.Timer,
        case Memory -> QuotaKind.Memory,
        case IoMemory -> QuotaKind.IoMemory,
        case Mapping -> QuotaKind.Mapping,
        case Handle -> QuotaKind.Handle,
        case Pipe -> QuotaKind.Pipe
    }
}

/// A child's declared quota rows.
func set_quota(child: &Process, c: &Child) -> Result<Void, SosStatus> {
    var q = 0
    while q < c.quota.len() {
        let row = c.quota.get(q)!
        try child.quota_set(quota_kind(row.kind), row.limit)
        q = q + 1
    }
    return
}

/// A child's rights ceilings, narrowed to the plan's: each kind it lists, to
/// the word it gives. A kind the kernel cannot restrict is a skew between the
/// plan and the kernel, which `RestrictRights` answers as a fault.
func restrict(child: &Process, c: &Child) -> Result<Void, SosStatus> {
    var k = 0
    while k < c.ceilings.len() {
        let ceiling = c.ceilings.get(k)!
        let word = ceiling.rights
        match ceiling.kind {
            case Process -> { try child.restrict_rights(process: word) },
            case Thread -> { try child.restrict_rights(thread: word) },
            case Event -> { try child.restrict_rights(event: word) },
            case Waiter -> { try child.restrict_rights(waiter: word) },
            case Interrupt -> { try child.restrict_rights(interrupt: word) },
            case Clock -> { try child.restrict_rights(clock: word) },
            case Timer -> { try child.restrict_rights(timer: word) },
            case Memory -> { try child.restrict_rights(memory: word) },
            case IoMemory -> { try child.restrict_rights(iomemory: word) },
            case Mapping -> { try child.restrict_rights(mapping: word) },
            case Pool -> { try child.restrict_rights(pool: word) },
            case PipeInlet -> { try child.restrict_rights(inlet: word) },
            case PipeOutlet -> { try child.restrict_rights(outlet: word) },
            case PipeReply -> { try child.restrict_rights(reply: word) },
            case PipeRequest -> { try child.restrict_rights(request: word) }
        }
        k = k + 1
    }
    return
}

/// `sos`'s bit for a plan's System right.
func system_right(name: RightName) -> UInt32 {
    match name {
        case Debug -> SystemRight.Debug as UInt32,
        case ProcessSelf -> SystemRight.ProcessSelf as UInt32,
        case ClockGet -> SystemRight.ClockGet as UInt32,
        case Transfer -> SystemRight.Transfer as UInt32
    }
}

/// The keep mask of a child's System sibling: the rights its plan names and
/// none other, so a System right the plan cannot name is withheld.
func system_mask(c: &Child) -> UInt32 {
    var keep: UInt32 = 0
    var k = 0
    while k < c.rights.len() {
        keep = keep | system_right(c.rights.get(k)!)
        k = k + 1
    }
    keep
}

/// A connection's two ends, while root holds them: made at the first record
/// that needs one, the server end given to the server, and an inlet minted
/// from root's for each client.
struct Ends {
    inlet: PipeInlet?
    outlet: PipeOutlet?
}

extension Ends: NoCopy {}

/// Connection `index`'s ends, made if they are not yet.
func connection(proc: &Process, ends: &var Vector<Ends, Exact>, index: Int) -> Result<Void, SosStatus> {
    borrow var e = ends[index] {
        if e.inlet.is_none() && e.outlet.is_none() {
            let (inlet, outlet) = try proc.pipe_create()
            e.inlet = move inlet
            e.outlet = move outlet
        }
    }
    return
}

/// One record, made as its source says and given under its tag; a System
/// record keeps the rights in `system_keep`, and every other the record's own
/// keep word.
func give(system: &System, proc: &Process, child: &Process, rows: &var Rows,
          ends: &var Vector<Ends, Exact>, r: &Record,
          system_keep: UInt32) -> Result<Void, SosStatus> {
    match r.source {
        case System -> {
            // The give checks `Transfer` on the sibling, and its own keep mask
            // is what the child receives.
            let sibling = try system.mint(rights: system_keep | (SystemRight.Transfer as UInt32))
            try child.give(system: move sibling, tag: r.tag, keep: system_keep) catch {
                return error.0
            }
        },
        case Row -> {
            let k = rows.find(r.from)
            if k >= 0 {
                rows.held(k, r.from)
                let w = rows.windows[k].take()!
                try child.give(iomemory: move w, tag: r.tag, keep: r.keep) catch {
                    return error.0
                }
            } else {
                var record = rows.take(r.from)
                try give_row(&child, &var record, r.tag, r.keep)
            }
        },
        case Sibling -> {
            let k = rows.window(r.from)
            let sibling = try rows.windows[k]!.mint()
            try child.give(iomemory: move sibling, tag: r.tag, keep: r.keep) catch {
                return error.0
            }
        },
        case Carve -> {
            let k = rows.window(r.from)
            let part = try rows.windows[k]!.carve(offset: r.offset, len: r.len)
            try child.give(iomemory: move part, tag: r.tag, keep: r.keep) catch {
                return error.0
            }
        },
        case Line -> {
            let line = try system.interrupt_bind(line: r.from)
            try child.give(interrupt: move line, tag: r.tag, keep: r.keep) catch {
                return error.0
            }
        },
        case Outlet -> {
            let index = r.from as Int
            try connection(&proc, &var ends, index)
            borrow var e = ends[index] {
                guard let outlet = e.outlet.take() else {
                    panic("root: the plan gives connection {}'s server end twice", index)
                }
                try child.give(outlet: move outlet, tag: r.tag, keep: r.keep) catch {
                    return error.0
                }
            }
        },
        case Inlet -> {
            let index = r.from as Int
            try connection(&proc, &var ends, index)
            borrow let e = ends[index] {
                let minted = try e.inlet!.mint(rights: CLIENT_INLET)
                try child.give(inlet: move minted, tag: r.tag, keep: r.keep) catch {
                    return error.0
                }
            }
        },
        case Heap -> {
            var record = rows.take(r.from)
            guard let pool = record.take_pool() else {
                panic("root: the plan gives row {} as a heap's pool, and it is not a pool", r.from)
            }
            try child.give(pool: move pool, tag: r.tag, keep: HEAP_POOL_KEEP) catch {
                return error.0
            }
        }
    }
    return
}

/// A whole row given as it is, keeping `keep` of it: a device's window, a pool
/// or an allocation.
func give_row(child: &Process, record: &var BootHandle, tag: UInt,
              keep: UInt32) -> Result<Void, SosStatus> {
    match record.kind {
        case IoMemory -> {
            try child.give(iomemory: record.take_iomemory()!, tag: tag, keep: keep) catch {
                return error.0
            }
        },
        case Pool -> {
            try child.give(pool: record.take_pool()!, tag: tag, keep: keep) catch {
                return error.0
            }
        },
        case Memory -> {
            try child.give(memory: record.take_memory()!, tag: tag, keep: keep) catch {
                return error.0
            }
        },
        case _ -> panic("root: the plan gives row {}, which is not a row's kind", record.tag)
    }
    return
}

/// Wait for the children's ends, reporting each; answers the machine's
/// status.
func supervise(proc: &Process, plan: &Plan, children: &Vector<Process, Exact>, rows: Rows,
             ends: Vector<Ends, Exact>) -> Result<UInt, SosStatus> {
    let waiter = try proc.waiter_create()
    var i = 0
    while i < children.len() {
        borrow let child = children[i] {
            try waiter.add(process: &child, key: i as UInt)
        }
        i = i + 1
    }
    // What root still holds of the rows and the connections is no child's:
    // releasing it leaves each connection to the ends its children hold. A
    // child that ended before it was attached is still reported: attaching
    // a dead Process answers its death at the first wait.
    let _ = move rows
    let _ = move ends
    var ended = 0
    while ended < children.len() {
        let record = try waiter.wait()
        let index = record.key as Int
        let word = status_of(&record)
        let _ = move record
        try waiter.remove(index as UInt)
        borrow let c = plan.children[index] {
            print("root: {} ended status={}", c.name, word)
            if c.shutdown {
                if (word >> REASON_SHIFT) == REASON_EXITED {
                    return word & CODE_MASK
                }
                return EXIT_STOPPED
            }
        }
        ended = ended + 1
    }
    return EXIT_OK
}

/// The §8 status word out of a wait record: root attaches only Processes.
func status_of(r: &WaitResult) -> UInt {
    match r.what {
        case Process(status) -> status,
        case _ -> panic("root attached only Processes"),
    }
}
