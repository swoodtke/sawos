// Hexadecimal text, in the spellings the builder's messages share with
// Python's `{:#x}` and `{:#010x}`.

import sosimage.hex.{hex, hex_padded}

func main() {
    assert(hex(0).equals("0x0"), "zero")
    assert(hex(0x1060).equals("0x1060"), "no padding")
    assert(hex(0x4210_0060).equals("0x42100060"), "an address")
    assert(hex(0xFFFF_FFFF_FFFF_FFFF).equals("0xffffffffffffffff"), "the whole word")
    assert(hex_padded(0xAEDB_041D, 8).equals("0xaedb041d"), "lowercase")
    assert(hex_padded(5, 8).equals("0x00000005"), "padded")
    assert(hex_padded(0x1_0000_0000, 8).equals("0x100000000"), "longer than the padding")
}
