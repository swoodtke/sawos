// `sosimage build` refuses an image whose processes' regions run past the
// board's process range at the process's line, before any package's image is
// looked for or the kernel is compiled. It compiles the riscv32 HAL's
// numbers with the compiler `SAWC` names, as `blade test` runs. The test runs
// in the package's directory, two below the tree's top.

import std.env.{Env}
import std.file.{File}
import std.path.{Path}
import sosimage.build.{ensure_directory}
import sosimage.product.{build_image}
import sosimage.profile.{Profile}
import sosimage.tool.{write_lines}

func sawc_argv() -> String {
    let named = try Env.get("SAWC") catch { None }
    guard let sawc = named else {
        panic("the test compiles the HAL's numbers with the compiler SAWC names, and SAWC is not set")
    }
    let words = try! sawc.split(" ")
    var quoted = Vector<String>()
    var i = 0
    while i < words.len() {
        let w = words.get(i) ?? ""
        if not w.is_empty() {
            try! quoted.push("\"{w}\"")
        }
        i = i + 1
    }
    quoted.join(", ")
}

func main() {
    let profile = try! Profile.parse("\{\"version\": 1, \"triple\": \"riscv32-unknown-none-elf\", \"word_bytes\": 4, \"sawc\": [{sawc_argv()}], \"clang\": \"/bin/clang\", \"lld\": \"/bin/ld.lld\", \"cc_args\": [\"-march=rv32imac_zicsr\", \"-mabi=ilp32\"], \"features\": \"+m,+a,+c\", \"module_paths\": [\"kcore=../../kernel/core\", \"hal=../../hal/riscv32/kernel\", \"imgformat=../../.sawlang/libs/imgformat/src\", \"sosrt=../../rt/common/src\", \"sosabi=../../kernel/abi/src\", \"rv32core=../../hal/riscv32-common/kernel\"], \"linker_script\": \"../../hal/riscv32/kernel/virt.ld\"\}", "p.json")
    let dir = "../../.build/sosimage-tests/many"
    try! ensure_directory(dir)

    // 504 processes: root's region and 503 more fill riscv32-virt's process
    // range, so the last one's runs past it.
    var lines = Vector<String>()
    try! lines.push("format = 1")
    try! lines.push("[image]")
    try! lines.push("name = \"many\"")
    try! lines.push("board = \"riscv32-virt\"")
    try! lines.push("tick = false")
    try! lines.push("[root]")
    try! lines.push("package = \"sawos:tests/uart-service\"")
    var i = 0
    while i < 504 {
        try! lines.push("[[process]]")
        try! lines.push("name = \"p{i}\"")
        try! lines.push("package = \"sawos:tests/no-such-package\"")
        i = i + 1
    }
    let image = "{dir}/many.toml"
    try! write_lines(image, &lines)
    let out = "{dir}/out"
    let refused = match build_image(&profile, "../..", "../..", image, out) {
        case Ok(_) -> "",
        case Err(e) -> e.message
    }
    assert(refused.equals("{image}: line 1518, column 1: the process p503's region, 0x40000 bytes at 0x88000000, runs past the board's ram range, which ends at 0x88000000"),
           "the region refusal: {refused}")
    assert(not File.exists(Path(s: "{out}/kernel-main.o")), "nothing compiled but the HAL's numbers")
}
