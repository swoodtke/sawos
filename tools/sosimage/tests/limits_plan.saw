// An image's limits: what they come to against a kernel's numbers, and each
// refusal by its message, since the message is what reaches the runner's
// report. The kernel here is riscv32's, its numbers written out as
// `sosimage slabs` prints them for that board's kernel object.

import sosimage.failure.{BuildError}
import sosimage.fields.{Fields}
import sosimage.kernel.{KernelFacts}
import sosimage.limits.{ImageLimits, PlanNeeds, SlabPlan, plan_limits}
import sosimage.regions.{encode_block}
import std.json.{JsonValue}

func ints(values: &[Int]) -> Vector<Int> {
    var out = Vector<Int>()
    var i = 0
    while i < values.len() {
        try! out.push(values[i])
        i = i + 1
    }
    move out
}

func kernel() -> KernelFacts {
    let floors: [Int; 14] = [8, 4, 4, 32, 8, 16, 8, 8, 32, 8, 4, 3, 12, 0]
    let defaults: [Int; 9] = [4, 4, 2, 4, 4, 2, 2, 16, 2]
    let units: [Int; 14] = [24, 20, 20, 24, 48, 56, 20, 20, 16, 556, 3480, 1276, 104, 516]
    let aligns: [Int; 14] = [16, 16, 16, 16, 16, 16, 16, 16, 16, 512, 16, 16, 16, 16]
    KernelFacts(word: 4, capacity: 1 << 20, thread_slab: 4095, extents: 4, records_per_body: 4,
                handles: 32, image_rows: 4, budget: 8, domains: 256,
                stride: 512, inflight: 16, handle_block: 16, table_blocks: 6,
                boot_set: 64, floors: ints(&floors),
                defaults: ints(&defaults), units: ints(&units),
                aligns: ints(&aligns))
}

// The limits a `limits` object states.
func stated(text: String) -> ImageLimits {
    let doc = try! JsonValue.parse(text)
    var fields = try! Fields(move doc, "limits")
    try! ImageLimits.read(&var fields)
}

// The message `text`'s limits are refused with, or "" when they are taken.
func refusal(text: String) -> String {
    let facts = kernel()
    let limits = stated(text)
    match plan_limits(&facts, &limits, &PlanNeeds.none(), "img", 2, 1) {
        case Ok(_) -> "",
        case Err(e) -> e.message
    }
}

func expect_refusal(text: String, message: String) {
    let got = refusal(text)
    if not got.equals(message) {
        print("expected: {message}")
        print("got:      {got}")
    }
    assert(got.equals(message), "the refusal's message")
}

func plan(text: String) -> SlabPlan {
    let facts = kernel()
    let limits = stated(text)
    try! plan_limits(&facts, &limits, &PlanNeeds.none(), "img", 2, 1)
}

// What a stock root's plan asks: root holds at most `held` handles, first at
// `step`, and the children `names` have these `Handle` rows and boot sets.
func needs_of(held: Int, step: String, names: &[String], rows: &[Int],
              records: &[Int]) -> PlanNeeds {
    var n = Vector<String>()
    var i = 0
    while i < names.len() {
        try! n.push(names[i])
        i = i + 1
    }
    PlanNeeds(stock: true, console: false, held: held, step: step, names: move n,
              rows: ints(&rows), records: ints(&records),
              summed: Vector<Int>())
}

// A stock root's plan with no children that holds `held` handles at most.
func root_needs(held: Int) -> PlanNeeds {
    let none: [String; 0] = []
    let zero: [Int; 0] = []
    needs_of(held, "give radio record 12", &none, &zero, &zero)
}

// The message `text`'s limits are refused with against `needs`, with
// `memory_rows` Memory rows and no IoMemory rows, on `facts`; "" when they
// are taken.
func refusal_of(facts: &KernelFacts, text: String, needs: &PlanNeeds,
                memory_rows: Int) -> String {
    let limits = stated(text)
    match plan_limits(&facts, &limits, &needs, "img", memory_rows, 0) {
        case Ok(_) -> "",
        case Err(e) -> e.message
    }
}

func expect_refusal_of(facts: &KernelFacts, text: String, needs: &PlanNeeds,
                       memory_rows: Int, message: String) {
    let got = refusal_of(&facts, text, &needs, memory_rows)
    if not got.equals(message) {
        print("expected: {message}")
        print("got:      {got}")
    }
    assert(got.equals(message), "the refusal's message")
}

// The plan `text`'s limits come to against `needs`.
func plan_needing(text: String, needs: &PlanNeeds) -> SlabPlan {
    let facts = kernel()
    let limits = stated(text)
    try! plan_limits(&facts, &limits, &needs, "img", 2, 1)
}

// A stock root's plan of `count` children, each with a `Handle` row of `row`.
func same_children(count: Int, row: Int) -> PlanNeeds {
    var needs = root_needs(5)
    var c = 0
    while c < count {
        try! needs.names.push("p{c}")
        try! needs.rows.push(row)
        try! needs.records.push(1)
        c = c + 1
    }
    move needs
}

// The HandleBlocks slots `plan` links; 0 for no area.
func block_slots(plan: &SlabPlan) -> Int {
    var i = 0
    while i < plan.areas.len() {
        if plan.areas.get(i)!.kind == 13 {
            return plan.areas.get(i)!.slots
        }
        i = i + 1
    }
    0
}

// What a stock root's plan asks of the tables: root's table from the most it
// holds, the blocks from the children's rows, and each boot set.
func stock_derivations() {
    // Root's table is the most the plan holds at any step, in whole blocks.
    let held45 = plan_needing("\{\}", &root_needs(45))
    assert(held45.root_blocks == 1 && block_slots(&held45) == 1,
           "45 held: a table of 48, one block")
    assert(plan_needing("\{\}", &root_needs(33)).root_blocks == 1, "33 held: one block")
    assert(plan_needing("\{\}", &root_needs(48)).root_blocks == 1, "48 held: one block")
    assert(plan_needing("\{\}", &root_needs(49)).root_blocks == 2, "49 held: two blocks")
    assert(plan_needing("\{\}", &root_needs(128)).root_blocks == 6, "128 held: six blocks")
    let held32 = plan_needing("\{\}", &root_needs(32))
    assert(held32.root_blocks == 0 && block_slots(&held32) == 0,
           "32 held: the body's table, no blocks")
    assert(plan_needing("\{\}", &root_needs(5)).root_blocks == 0, "5 held: no blocks")

    // Past the longest table, naming the step.
    let facts = kernel()
    expect_refusal_of(&facts, "\{\}", &root_needs(129), 2,
                      "img: the stock root would hold 129 handles at `give radio record 12`, past the longest handle table (128)")

    // A stated table raises the derivation and never lowers it.
    let stated_up = plan_needing("\{\"root-handles\": 64\}", &root_needs(45))
    assert(stated_up.root_blocks == 2, "64 stated over 45 held: two blocks")
    let stated_same = plan_needing("\{\"root-handles\": 48\}", &root_needs(45))
    assert(stated_same.root_blocks == 1, "48 stated over 45 held: one block")
    let stated_rounded = plan_needing("\{\"root-handles\": 40\}", &root_needs(45))
    assert(stated_rounded.root_blocks == 1, "40 stated rounds up to the 48 held needs")
    expect_refusal_of(&facts, "\{\"root-handles\": 32\}", &root_needs(45), 2,
                      "img: the image's root handle table is 32, below 48: the stock root would hold 45 handles at `give radio record 12`")
    expect_refusal_of(&facts, "\{\"root-handles\": 129\}", &root_needs(45), 2,
                      "img: the image's root handle table is 129, past the longest handle table (128)")

    // The blocks are root's and each child's, for its `Handle` row past the
    // body's table.
    let names: [String; 3] = ["radio", "gpio", "log"]
    let rows: [Int; 3] = [64, 20, 33]
    let records: [Int; 3] = [20, 5, 1]
    let box = needs_of(45, "give radio record 12", &names, &rows, &records)
    let blocks = plan_needing("\{\}", &box)
    assert(blocks.root_blocks == 1 && block_slots(&blocks) == 4,
           "root's one, the radio's two and the log's one")
    let radio_names: [String; 1] = ["radio"]
    let radio_rows: [Int; 1] = [64]
    let radio_records: [Int; 1] = [20]
    let radio = needs_of(45, "give radio record 12", &radio_names, &radio_rows, &radio_records)
    assert(block_slots(&plan_needing("\{\}", &radio)) == 3, "root's one and the radio's two")
    let at_body: [Int; 1] = [32]
    let body = needs_of(5, "derive", &radio_names, &at_body, &radio_records)
    assert(block_slots(&plan_needing("\{\}", &body)) == 0, "a row at the body's table: none")
    let one_past: [Int; 1] = [33]
    let past_body = needs_of(5, "derive", &radio_names, &one_past, &radio_records)
    assert(block_slots(&plan_needing("\{\}", &past_body)) == 1, "a row one past it: one")
    let at_longest: [Int; 1] = [128]
    let longest_row = needs_of(5, "derive", &radio_names, &at_longest, &radio_records)
    assert(block_slots(&plan_needing("\{\}", &longest_row)) == 6, "the longest row: six")
    var not_stock = radio.copy()
    not_stock.stock = false
    assert(block_slots(&plan_needing("\{\}", &not_stock)) == 0,
           "a root that is not the stock root asks nothing")

    // A stated total is taken above the derivation and refused below it.
    let above = plan_needing("\{\"slabs\": \{\"handle-blocks\": 5\}\}", &radio)
    assert(block_slots(&above) == 5, "five stated over three")
    let exact = plan_needing("\{\"slabs\": \{\"handle-blocks\": 3\}\}", &radio)
    assert(block_slots(&exact) == 3, "three stated over three")
    expect_refusal_of(&facts, "\{\"slabs\": \{\"handle-blocks\": 2\}\}", &radio, 2,
                      "img: the image's handle-blocks come to 2, below 3: root's handle table of 48 takes 1 and the processes' Handle rows 2")

    // The derivation past MAX_SLAB_CAPACITY, as every kind is: eleven
    // children at the longest row take 66 blocks of a machine whose slabs
    // hold 64, and ten take 60.
    var small = kernel()
    small.capacity = 64
    let many = same_children(11, 128)
    expect_refusal_of(&small, "\{\}", &many, 2,
                      "img: the image's handle-blocks come to 66, past MAX_SLAB_CAPACITY (64)")
    let ten = same_children(10, 128)
    assert(refusal_of(&small, "\{\}", &ten, 2).is_empty(), "60 blocks of 64 are taken")

    // Root's boot handles against the table the plan gives it.
    let rows_raised = "\{\"slabs\": \{\"memories\": 40\}\}"
    expect_refusal_of(&facts, rows_raised, &root_needs(40), 46,
                      "img: root holds 49 handles at boot, its System, Process and Thread and one for each of the region table's 46 rows, past root's handle table (48)")
    assert(refusal_of(&facts, rows_raised, &root_needs(48), 45).is_empty(),
           "45 rows fill a table of 48")

    // Each boot set against the most a `BootSet` holds: root's rows and each
    // child's records.
    let wide = "\{\"slabs\": \{\"memories\": 49\}\}"
    assert(refusal_of(&facts, wide, &root_needs(70), 64).is_empty(), "root's 64 rows")
    expect_refusal_of(&facts, wide, &root_needs(70), 65,
                      "img: root's boot set holds 65 records, one for each of the region table's rows, past BOOT_SET_CAPACITY (64)")
    let full_records: [Int; 1] = [64]
    let full = needs_of(45, "derive", &radio_names, &radio_rows, &full_records)
    assert(refusal_of(&facts, "\{\}", &full, 2).is_empty(), "a child's 64 records")
    let over_records: [Int; 1] = [65]
    let over = needs_of(45, "derive", &radio_names, &radio_rows, &over_records)
    expect_refusal_of(&facts, "\{\}", &over, 2,
                      "img: the process radio's boot set holds 65 records, past BOOT_SET_CAPACITY (64): its declared records, the console's inlet and its heaps' pools")

    // The loops over the children reach the second one.
    let two_names: [String; 2] = ["log", "radio"]
    let two_rows: [Int; 2] = [20, 64]
    let two_over: [Int; 2] = [1, 65]
    let second = needs_of(45, "derive", &two_names, &two_rows, &two_over)
    expect_refusal_of(&facts, "\{\}", &second, 2,
                      "img: the process radio's boot set holds 65 records, past BOOT_SET_CAPACITY (64): its declared records, the console's inlet and its heaps' pools")
    let two_body: [Int; 2] = [20, 33]
    let two_ok: [Int; 2] = [1, 1]
    assert(needs_of(5, "derive", &two_names, &two_body, &two_ok).wants_blocks(&facts), "the second child's row")

    // A hand-written root's boot set is its own to drain, past the `BootSet`.
    var hand_over = over.copy()
    hand_over.stock = false
    assert(refusal_of(&facts, "\{\}", &hand_over, 2).is_empty(), "a hand-written child's records")
    let hand_wide = "\{\"slabs\": \{\"memories\": 49\}, \"root-handles\": 128\}"
    assert(refusal_of(&facts, hand_wide, &PlanNeeds.none(), 65).is_empty(),
           "a hand-written root's 65 rows")

    // What a plan wants of the blocks.
    assert(root_needs(33).wants_blocks(&facts), "root past the body's table")
    assert(not root_needs(32).wants_blocks(&facts), "root within it")
    assert(past_body.wants_blocks(&facts), "a child's row past it, root within")
    assert(not body.wants_blocks(&facts), "every row within it")
    assert(not not_stock.wants_blocks(&facts), "no plan")
    assert(not PlanNeeds.none().wants_blocks(&facts), "none")
}

// A stock root's plan whose children's rows add up to `n` slots of slab
// `kind` and to nothing in any other.
func summing(kind: Int, n: Int) -> PlanNeeds {
    var needs = root_needs(5)
    var k = 0
    while k < 14 {
        try! needs.summed.push(if k == kind { n } else { 0 })
        k = k + 1
    }
    move needs
}

// The slots `plan` links of slab `kind`; 0 for no area.
func slots_of(plan: &SlabPlan, kind: Int) -> Int {
    var i = 0
    while i < plan.areas.len() {
        if plan.areas.get(i)!.kind == kind {
            return plan.areas.get(i)!.slots
        }
        i = i + 1
    }
    0
}

// The slots of slab `kind` the limits `text` come to against `needs`.
func slots_in(text: String, needs: &PlanNeeds, kind: Int) -> Int {
    slots_of(&plan_needing(text, &needs), kind)
}

// The limits object that raises slab `kind` by `n`.
func raising(kind: String, n: Int) -> String {
    "\{\"slabs\": \{\"{kind}\": {n}\}\}"
}

// The message a total of `got` for slab `kind`, below its sum, is refused
// with; `why` is what the sum is made of.
func below(kind: String, got: Int, sum: Int, why: String) -> String {
    "img: the image's {kind} come to {got}, below {sum}: {why}"
}

// `below`, for a kind whose sum is root's own `own` and the rows' `rows`.
func below_own(kind: String, got: Int, own: Int, rows: Int) -> String {
    below(kind, got, own + rows,
          "root's own {own} and the processes' rows {rows}")
}

// What a stock root's plan asks of the slabs: root's own objects and the sum
// of each child's rows, each kind's total at least that, a stated total never
// below it. The kernel's floors: 8 events, 4 waiters, 8 timers, 16 memories,
// 8 iomemories, 8 mappings, 8 threads and 4 pipes, with three process bodies.
// A kind's `SlabKind` value is its argument to `summing` and `slots_in`.
func summed_rows() {
    let facts = kernel()
    let none = "\{\}"
    // Each kind's total is the sum, in slots above its floor.
    assert(slots_in(none, &summing(0, 20), 0) == 12, "events: 20 over 8")
    assert(slots_in(none, &summing(1, 10), 1) == 7, "waiters: 1 and 10 over 4")
    assert(slots_in(none, &summing(4, 30), 4) == 22, "timers: 30 over 8")
    assert(slots_in(none, &summing(6, 20), 6) == 12, "iomemories: 20 over 8")
    assert(slots_in(none, &summing(10, 9), 10) == 5, "pipes: 9 over 4")
    assert(slots_in(none, &summing(9, 9), 9) == 2, "threads: 1 and 9 over 8")
    // Memory: the region table's 2 rows are root's own, each counted once.
    assert(slots_in(none, &summing(5, 20), 5) == 6, "memories: 2, 20 over 16")
    // Mapping: the larger of the sum and four per body.
    assert(slots_in(none, &summing(7, 40), 7) == 32, "mappings: 40 over 8")
    assert(slots_in(none, &summing(7, 6), 7) == 4, "mappings: four per body")
    // What the sums raise, the derivations that follow take up: 30 timers,
    // 8 events, 4 interrupts and 12 records are 54 attachments over 32.
    assert(slots_in(none, &summing(4, 30), 3) == 22, "attachments follow")

    // A sum at or under the floor raises nothing.
    assert(slots_in(none, &summing(0, 8), 0) == 0, "events at the floor")
    assert(slots_in(none, &summing(0, 0), 0) == 0, "no rows, no events")

    // A stated total is taken at the sum and above it, and refused below it,
    // naming the kind, the sum and the image's total.
    let at = raising("events", 12)
    assert(slots_in(at, &summing(0, 20), 0) == 12, "events: 20 stated over 20")
    let over = raising("events", 30)
    assert(slots_in(over, &summing(0, 20), 0) == 30, "events: 38 over 20")
    expect_refusal_of(&facts, raising("events", 11), &summing(0, 20), 2,
                      below_own("events", 19, 0, 20))
    expect_refusal_of(&facts, raising("waiters", 6), &summing(1, 10), 2,
                      below_own("waiters", 10, 1, 10))
    expect_refusal_of(&facts, raising("timers", 21), &summing(4, 30), 2,
                      below_own("timers", 29, 0, 30))
    expect_refusal_of(&facts, raising("iomemories", 11), &summing(6, 20), 2,
                      below_own("iomemories", 19, 0, 20))
    expect_refusal_of(&facts, raising("pipes", 4), &summing(10, 9), 2,
                      below_own("pipes", 8, 0, 9))
    expect_refusal_of(&facts, raising("mappings", 31), &summing(7, 40), 2,
                      below_own("mappings", 39, 0, 40))
    expect_refusal_of(&facts, raising("memories", 5), &summing(5, 20), 2,
                      below_own("memories", 21, 2, 20))
    let why = "root's main thread and the processes' Thread rows"
    expect_refusal_of(&facts, raising("threads", 1), &summing(9, 9), 2,
                      below("threads", 9, 10, why))
    // Bodies past the plan's threads: the larger decides.
    let bodies = "\{\"slabs\": \{\"threads\": 0, \"processes\": 7\}\}"
    expect_refusal_of(&facts, bodies, &summing(9, 2), 2,
                      below("threads", 8, 10,
                            "a main thread for each of 10 process bodies"))

    // In an image that names a console, root's own objects hold its
    // console's watchdog too: a thread, its Waiter and Timer and an Event.
    var watched_waiters = summing(1, 10)
    watched_waiters.console = true
    assert(slots_in(none, &watched_waiters, 1) == 8, "waiters: 2 and 10 over 4")
    expect_refusal_of(&facts, raising("waiters", 7), &watched_waiters, 2,
                      below_own("waiters", 11, 2, 10))
    var watched_events = summing(0, 20)
    watched_events.console = true
    assert(slots_in(none, &watched_events, 0) == 13, "events: 1 and 20 over 8")
    expect_refusal_of(&facts, raising("events", 12), &watched_events, 2,
                      below_own("events", 20, 1, 20))
    var watched_timers = summing(4, 30)
    watched_timers.console = true
    expect_refusal_of(&facts, raising("timers", 22), &watched_timers, 2,
                      below_own("timers", 30, 1, 30))
    var watched_threads = summing(9, 9)
    watched_threads.console = true
    assert(slots_in(none, &watched_threads, 9) == 3, "threads: 2 and 9 over 8")
    expect_refusal_of(&facts, raising("threads", 2), &watched_threads, 2,
                      below("threads", 10, 11,
                            "root's main thread, its console's watchdog and the processes' Thread rows"))

    // A root that is not the stock root has no plan to sum.
    var hand = summing(0, 20)
    hand.stock = false
    assert(slots_in(none, &hand, 0) == 0, "a hand-written root: nothing")
    assert(refusal_of(&facts, raising("events", 1), &hand, 2).is_empty(),
           "and refuses nothing")
}

func main() {
    summed_rows()
    stock_derivations()

    // A process body raised: the derived totals follow it, each area in kind
    // order, each length whole slots of its unit.
    let p = plan("\{\"slabs\": \{\"processes\": 1, \"waiters\": 1\}\}")
    assert(p.block, "a block")
    assert(p.areas.len() == 5, "waiters, attachments, mappings, processes, records")
    let w = p.areas.get(0)!
    assert(w.kind == 1 && w.slots == 1 && w.bytes == 20 && w.align == 16, "waiters")
    let a = p.areas.get(1)!
    assert(a.kind == 3 && a.slots == 4, "attachments: one per waitable, 36")
    let m = p.areas.get(2)!
    assert(m.kind == 7 && m.slots == 8, "mappings: four per body, 16")
    let b = p.areas.get(3)!
    assert(b.kind == 11 && b.slots == 1 && b.bytes == 1276, "a body")
    let r = p.areas.get(4)!
    assert(r.kind == 12 && r.slots == 4, "records: four per body, 16")
    assert(p.defaults.get(1)! == 4, "an unstated default is the compiled one")

    // A thread area is aligned to the frame stride. It follows the Mapping
    // area the builder sizes at four per body.
    let t = plan("\{\"slabs\": \{\"threads\": 2\}\}")
    let ta = t.areas.get(1)!
    assert(ta.kind == 9 && ta.bytes == 2 * 556 && ta.align == 512, "threads")

    // Handle blocks, whose floor is zero: the area is the blocks stated, in
    // the record's bytes for one, and it reads back under its own name.
    let blocks = plan("\{\"slabs\": \{\"handle-blocks\": 3\}\}")
    let hb = blocks.areas.get(blocks.areas.len() - 1)!
    assert(hb.kind == 13 && hb.slots == 3 && hb.bytes == 3 * 516 && hb.align == 16,
           "handle blocks")
    let blocks_stated = stated("\{\"slabs\": \{\"handle-blocks\": 3\}\}")
    assert(blocks_stated.json().equals("\{\"slabs\": \{\"handle-blocks\": 3\}, \"quotas\": \{\}\}"),
           "handle blocks read back: {blocks_stated.json()}")

    // Root's handle table, rounded up to a whole block: the block's header
    // carries root's blocks, and the HandleBlocks total is derived to hold
    // them. A table at the body's length takes none.
    let root48 = plan("\{\"root-handles\": 48\}")
    assert(root48.root_blocks == 1, "48 entries: one block")
    let rb = root48.areas.get(root48.areas.len() - 1)!
    assert(rb.kind == 13 && rb.slots == 1, "the HandleBlocks area holds root's")
    let root48_fields = try! encode_block(&root48, 4)
    assert(root48_fields.get(11)!.bytes == 4 && root48_fields.get(11)!.value == 1,
           "the header word is root's block count")
    assert(plan("\{\"root-handles\": 33\}").root_blocks == 1, "33: one block")
    assert(plan("\{\"root-handles\": 49\}").root_blocks == 2, "49: two blocks")
    assert(plan("\{\"root-handles\": 128\}").root_blocks == 6,
           "the longest table: six blocks")
    let root32 = plan("\{\"root-handles\": 32\}")
    assert(root32.root_blocks == 0
           && root32.areas.get(root32.areas.len() - 1)!.kind != 13,
           "the body's table: no blocks and no HandleBlocks area")
    let root_unstated = plan("\{\}")
    assert(root_unstated.root_blocks == 0, "unstated: no blocks")
    let blocks_above = plan("\{\"slabs\": \{\"handle-blocks\": 3\}, \"root-handles\": 48\}")
    assert(blocks_above.root_blocks == 1
           && blocks_above.areas.get(blocks_above.areas.len() - 1)!.slots == 3,
           "blocks stated above root's are taken as stated")
    let root_stated = stated("\{\"root-handles\": 48\}")
    assert(root_stated.json().equals("\{\"slabs\": \{\}, \"quotas\": \{\}, \"root-handles\": 48\}"),
           "root's table read back: {root_stated.json()}")

    // A derived total stated above its derivation is taken as stated.
    let above = plan("\{\"slabs\": \{\"processes\": 1, \"process_records\": 10\}\}")
    let rec = above.areas.get(above.areas.len() - 1)!
    assert(rec.kind == 12 && rec.slots == 10, "records stated above")

    // Quota defaults at each edge their bounds allow.
    let edge = plan("\{\"quotas\": \{\"event\": 7, \"handle\": 31, \"mapping\": 4\}\}")
    assert(edge.defaults.get(1)! == 7 && edge.defaults.get(7)! == 31
           && edge.defaults.get(6)! == 4, "the edges")

    // The block's bytes: the header with every default, then each area, its
    // base left to the linker.
    let fields = try! encode_block(&p, 4)
    assert(fields.len() == 12 + 5 * 5, "a header of 12 fields, 5 an area")
    let head = fields.get(0)!
    assert(head.bytes == 4 && head.value == 0x4241_4C53, "the magic")
    assert(fields.get(1)!.value == 5, "the area count")
    var q = 0
    while q < 9 {
        let d = fields.get(2 + q)!
        assert(d.bytes == 4 && d.value == (p.defaults.get(q)! as UInt64),
               "each quota default")
        q = q + 1
    }
    assert(fields.get(11)!.bytes == 4 && fields.get(11)!.value == 0,
           "root's handle blocks: none stated")
    assert(fields.get(12)!.value == 1, "area 0's kind")
    assert(fields.get(14)!.symbol.equals("_sos_slab1_start"), "area 0's base")
    assert(fields.get(15)!.bytes == 4 && fields.get(15)!.value == 0,
           "a 32-bit base's high half")
    assert(fields.get(16)!.bytes == 8 && fields.get(16)!.value == 20,
           "area 0's length")
    let wide = try! encode_block(&p, 8)
    assert(wide.len() == 12 + 5 * 4, "a 64-bit base is one field")
    assert(wide.get(14)!.bytes == 8, "the base's 8 bytes")

    // Every bound's edge is taken: a total at the ceiling, pipes whose
    // exchanges reach it exactly, bodies filling the domain pool, derived
    // totals stated at their derivation, a default at the compiled one, and
    // the region table's rows filling both slabs.
    let at_ceiling = plan("\{\"slabs\": \{\"waiters\": 1048572\}\}")
    assert(at_ceiling.areas.get(0)!.slots == 1048572, "waiters to the ceiling")
    let pipes = plan("\{\"slabs\": \{\"pipes\": 65532\}\}")
    assert(pipes.areas.len() == 2, "pipes to the exchanges' ceiling, and mappings")
    let full = plan("\{\"slabs\": \{\"processes\": 253\}\}")
    assert(full.areas.get(full.areas.len() - 2)!.slots == 253, "bodies to the pool")
    let exact = plan("\{\"slabs\": \{\"processes\": 1, \"process_records\": 4, \"threads\": 0, \"attachments\": 4\}, \"quotas\": \{\"thread\": 4\}\}")
    assert(exact.defaults.get(0)! == 4, "a default at the compiled one")
    let eight = plan("\{\"slabs\": \{\"processes\": 5, \"threads\": 0\}\}")
    assert(eight.block, "threads stated at exactly the bodies")
    let stated_mappings = plan("\{\"slabs\": \{\"processes\": 1, \"mappings\": 0\}\}")
    var i = 0
    while i < stated_mappings.areas.len() {
        assert(stated_mappings.areas.get(i)!.kind != 7,
               "a Mapping slab the image states is not sized for it")
        i = i + 1
    }
    let facts_rows = kernel()
    let quiet_rows = stated("\{\}")
    let filled = try! plan_limits(&facts_rows, &quiet_rows, &PlanNeeds.none(), "img", 16, 8)
    assert(filled.block, "rows filling both slabs")

    // Each quota kind's bound is its own slab's capacity. Over slabs raised so
    // that no two share a capacity (threads 9, events 10, timers 11,
    // iomemories 13, mappings 14, pipes 5, waiters 6, memories 17, beside
    // interrupts 7, records 12, free ranges 32 and attachments 40), a
    // default at its slab's capacity is refused naming that capacity, and a
    // bound read from any other slab would name another or take it.
    let raised = "\"slabs\": \{\"threads\": 1, \"events\": 2, \"timers\": 3, \"iomemories\": 5, \"mappings\": 6, \"pipes\": 1, \"waiters\": 2, \"memories\": 1, \"interrupts\": 3\}"
    expect_refusal("\{{raised}, \"quotas\": \{\"thread\": 9\}\}",
                   "img: the image's thread quota default is 9, not below its slab's capacity (9)")
    expect_refusal("\{{raised}, \"quotas\": \{\"event\": 10\}\}",
                   "img: the image's event quota default is 10, not below its slab's capacity (10)")
    expect_refusal("\{{raised}, \"quotas\": \{\"waiter\": 6\}\}",
                   "img: the image's waiter quota default is 6, not below its slab's capacity (6)")
    expect_refusal("\{{raised}, \"quotas\": \{\"timer\": 11\}\}",
                   "img: the image's timer quota default is 11, not below its slab's capacity (11)")
    expect_refusal("\{{raised}, \"quotas\": \{\"memory\": 17\}\}",
                   "img: the image's memory quota default is 17, not below its slab's capacity (17)")
    expect_refusal("\{{raised}, \"quotas\": \{\"iomemory\": 13\}\}",
                   "img: the image's iomemory quota default is 13, not below its slab's capacity (13)")
    expect_refusal("\{{raised}, \"quotas\": \{\"mapping\": 14\}\}",
                   "img: the image's mapping quota default is 14, not below its slab's capacity (14)")
    expect_refusal("\{{raised}, \"quotas\": \{\"pipe\": 5\}\}",
                   "img: the image's pipe quota default is 5, not below its slab's capacity (5)")

    // Each refusal, by name.
    expect_refusal("\{\"slabs\": \{\"waiters\": 1048576\}\}",
                   "img: the image's waiters come to 1048580, past MAX_SLAB_CAPACITY (1048576)")
    expect_refusal("\{\"slabs\": \{\"waiters\": 1048577\}\}",
                   "img: the image raises waiters by 1048577, past MAX_SLAB_CAPACITY (1048576)")
    expect_refusal("\{\"slabs\": \{\"waiters\": 1048573\}\}",
                   "img: the image's waiters come to 1048577, past MAX_SLAB_CAPACITY (1048576)")
    // The thread ID's index field holds the thread slab: 4095 threads are
    // taken, and one more is refused naming the field.
    expect_refusal("\{\"slabs\": \{\"threads\": 4087\}\}", "")
    expect_refusal("\{\"slabs\": \{\"threads\": 4088\}\}",
                   "img: the image's threads come to 4096, past the thread ID's index field (4095)")
    expect_refusal("\{\"slabs\": \{\"pipes\": 65533\}\}",
                   "img: the image's 65537 pipes need 1048592 exchanges, past MAX_SLAB_CAPACITY (1048576)")
    expect_refusal("\{\"slabs\": \{\"processes\": 1, \"process_records\": 3\}\}",
                   "img: the image's process_records come to 15, below 16: 4 records per process body, for 4 bodies")
    expect_refusal("\{\"slabs\": \{\"processes\": 6, \"threads\": 0\}\}",
                   "img: the image's threads come to 8, below 9: a main thread for each of 9 process bodies")
    expect_refusal("\{\"slabs\": \{\"events\": 1, \"attachments\": 0\}\}",
                   "img: the image's attachments come to 32, below 33: one for each event, interrupt, timer and record")
    expect_refusal("\{\"slabs\": \{\"processes\": 254\}\}",
                   "img: the image's 257 process bodies pass this board's domain pool (256)")
    expect_refusal("\{\"quotas\": \{\"event\": 3\}\}",
                   "img: the image's event quota default is 3, below the compiled default (4)")
    expect_refusal("\{\"quotas\": \{\"event\": 65535\}\}",
                   "img: the image's event quota default is 65535, which the ledger's row cannot hold below its unlimited mark (65535)")
    expect_refusal("\{\"quotas\": \{\"event\": 8\}\}",
                   "img: the image's event quota default is 8, not below its slab's capacity (8)")
    expect_refusal("\{\"quotas\": \{\"handle\": 32\}\}",
                   "img: the image's handle quota default is 32, not below MAX_HANDLES (32)")
    expect_refusal("\{\"root-handles\": 129\}",
                   "img: the image's root handle table is 129, past the longest handle table (128)")
    expect_refusal("\{\"slabs\": \{\"handle-blocks\": 1\}, \"root-handles\": 49\}",
                   "img: the image's handle-blocks come to 1, below 2: root's handle table of 64 takes 2 and the processes' Handle rows 0")
    let negative_doc = try! JsonValue.parse("\{\"root-handles\": -1\}")
    var negative_fields = try! Fields(move negative_doc, "limits")
    let negative = match ImageLimits.read(&var negative_fields) {
        case Ok(_) -> "",
        case Err(e) -> e.message
    }
    assert(negative.equals("the image's `limits`: `root-handles` is negative (-1)"),
           "a negative root table: {negative}")
    expect_refusal("\{\"quotas\": \{\"mapping\": 5\}\}",
                   "img: the image's mapping quota default is 5, past the 4 grant rows an image leaves of this board's 8")

    // The rows the region table mints are held against the image's slabs.
    let facts = kernel()
    let quiet = stated("\{\}")
    let rows = match plan_limits(&facts, &quiet, &PlanNeeds.none(), "img", 17, 0) {
        case Ok(_) -> "",
        case Err(e) -> e.message
    }
    assert(rows.equals("img: the region table mints 17 Memory objects at boot, past the image's 16"),
           "the Memory rows")
    let devices = match plan_limits(&facts, &quiet, &PlanNeeds.none(), "img", 0, 9) {
        case Ok(_) -> "",
        case Err(e) -> e.message
    }
    assert(devices.equals("img: the region table mints 9 IoMemory objects at boot, past the image's 8"),
           "the IoMemory rows")

    // Root's handle table holds its three boot handles and one per row: with
    // the Memory slab raised past the table, 29 rows fill it and 30 are
    // refused, whichever slab they mint into.
    let memories_raised = stated("\{\"slabs\": \{\"memories\": 17\}\}")
    let full_table = try! plan_limits(&facts, &memories_raised, &PlanNeeds.none(), "img", 29, 0)
    assert(full_table.block, "29 rows beside root's three handles")
    let mixed = try! plan_limits(&facts, &memories_raised, &PlanNeeds.none(), "img", 25, 4)
    assert(mixed.block, "25 Memory and 4 IoMemory rows")
    let past = match plan_limits(&facts, &memories_raised, &PlanNeeds.none(), "img", 30, 0) {
        case Ok(_) -> "",
        case Err(e) -> e.message
    }
    assert(past.equals("img: root holds 33 handles at boot, its System, Process and Thread and one for each of the region table's 30 rows, past MAX_HANDLES (32)"),
           "30 rows: {past}")
    let past_mixed = match plan_limits(&facts, &memories_raised, &PlanNeeds.none(), "img", 25, 5) {
        case Ok(_) -> "",
        case Err(e) -> e.message
    }
    assert(past_mixed.equals("img: root holds 33 handles at boot, its System, Process and Thread and one for each of the region table's 30 rows, past MAX_HANDLES (32)"),
           "25 and 5 rows: {past_mixed}")

    // Root's rows against root's table, the blocks its image gives it
    // included: 45 rows fill a table of 48 and 46 are refused, naming it.
    let longer = stated("\{\"slabs\": \{\"memories\": 40\}, \"root-handles\": 48\}")
    let longer_full = try! plan_limits(&facts, &longer, &PlanNeeds.none(), "img", 45, 0)
    assert(longer_full.root_blocks == 1, "45 rows beside root's three handles")
    let longer_past = match plan_limits(&facts, &longer, &PlanNeeds.none(), "img", 46, 0) {
        case Ok(_) -> "",
        case Err(e) -> e.message
    }
    assert(longer_past.equals("img: root holds 49 handles at boot, its System, Process and Thread and one for each of the region table's 46 rows, past root's handle table (48)"),
           "46 rows: {longer_past}")
}
