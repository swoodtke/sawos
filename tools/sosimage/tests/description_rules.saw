// The rules every description follows, read directly: names, the device
// reference grammar, sizes in bytes and the board's word.

import toml.{TomlPosition}
import sosimage.rules.{check_path, fits_board_word, fits_space, grouped_hex, is_name,
                       parse_description, parse_ref, size, word_count}

func ref_refusal(text: String) -> String {
    match parse_ref(text, "f.toml", TomlPosition(line: 2, column: 5)) {
        case Ok(_) -> "",
        case Err(e) -> e.message
    }
}

func size_refusal(text: String, word: Int) -> String {
    let doc = try parse_description(text, "s.toml") catch {
        return error.message
    }
    borrow let root = doc.root() {
        match size(&root, "len", word, "s.toml", "the top level") {
            case Ok(_) -> { return "" },
            case Err(e) -> { return e.message }
        }
    }
}

func main() {
    // Names: a letter, then letters, digits, `_` and `-`; no `.`.
    assert(is_name("UART0") && is_name("esp32s3-uart") && is_name("out_sel"), "names")
    assert(not is_name("") && not is_name("0x") && not is_name("_a") && not is_name("a.b")
           && not is_name("a b"), "not names")

    // The reference grammar.
    let whole = try! parse_ref("UART0", "f.toml", TomlPosition(line: 1, column: 1))
    assert(whole.device.equals("UART0") && whole.member.is_empty(), "a whole device")
    let register = try! parse_ref("SYSTEM.PERIP_CLK_EN0", "f.toml", TomlPosition(line: 1, column: 1))
    assert(register.member.equals("PERIP_CLK_EN0") && not register.indexed, "a register")
    let one = try! parse_ref("GPIO.out_sel[41]", "f.toml", TomlPosition(line: 1, column: 1))
    assert(one.indexed && one.first == 41 && one.last == 41, "one element")
    let range = try! parse_ref("IO_MUX.pad[41..=42]", "f.toml", TomlPosition(line: 1, column: 1))
    assert(range.first == 41 && range.last == 42, "an inclusive range")
    assert(ref_refusal("GPIO.out_sel[41..42]").equals("f.toml: line 2, column 5: `GPIO.out_sel[41..42]`: write `..=`, an inclusive range"), "`..` refused")
    let grammar = "is not a device reference: write DEVICE, DEVICE.REGISTER, DEVICE.ARRAY[i] or DEVICE.ARRAY[i..=j]"
    assert(ref_refusal("GPIO.out_sel[41").equals("f.toml: line 2, column 5: `GPIO.out_sel[41` {grammar}"), "an open bracket")
    assert(ref_refusal("GPIO.out_sel[]").equals("f.toml: line 2, column 5: `GPIO.out_sel[]` {grammar}"), "no index")
    assert(ref_refusal("GPIO.out_sel[0x2]").equals("f.toml: line 2, column 5: `GPIO.out_sel[0x2]` {grammar}"), "a decimal index")
    assert(ref_refusal("GPIO.out.sel").equals("f.toml: line 2, column 5: `GPIO.out.sel` {grammar}"), "two dots")
    assert(ref_refusal("[1]").equals("f.toml: line 2, column 5: `[1]` {grammar}"), "no device")

    // Sizes: integers in bytes, held to the word.
    assert(size_refusal("len = 0xFFFF_FFFF\n", 4).is_empty(), "the largest 32-bit length")
    assert(size_refusal("len = 0x1_0000_0000\n", 8).is_empty(), "past 32 bits on a 64-bit board")
    assert(size_refusal("len = 0x1_0000_0000\n", 4).equals("s.toml: line 1, column 1: `len` in the top level is 0x100000000, past what this board's 32-bit word holds (0xffffffff)"), "past a 32-bit word")
    assert(size_refusal("len = \"144K\"\n", 4).equals("s.toml: line 1, column 1: `len` in the top level is the string \"144K\": a size or an address is a TOML integer in bytes: write 0x2_4000"), "a suffixed size")
    assert(size_refusal("len = -1\n", 4).equals("s.toml: line 1, column 7: `len` in the top-level table is -1, which is negative"), "a negative size")
    assert(size_refusal("len = 1.5\n", 4).equals("s.toml: line 1, column 7: floats are not supported yet: libs/toml reads TOML 1.0 except multi-line strings, floats and date-times"), "a float is toml's refusal, with the file")
    assert(grouped_hex(0x8_0000).equals("0x8_0000") && grouped_hex(0x1000).equals("0x1000")
           && grouped_hex(0x20_0000).equals("0x20_0000"), "grouped hexadecimal")

    // More of the grammar: a second `..=`, a device part that is no name, an
    // index past what an integer holds.
    assert(ref_refusal("GPIO.out_sel[1..=2..=3]").equals("f.toml: line 2, column 5: `GPIO.out_sel[1..=2..=3]` {grammar}"), "two ranges")
    assert(ref_refusal("0GPIO.out_sel[1]").equals("f.toml: line 2, column 5: `0GPIO.out_sel[1]` {grammar}"), "a device that is no name")
    assert(ref_refusal("GPIO.out_sel[99999999999999999999]").equals("f.toml: line 2, column 5: `GPIO.out_sel[99999999999999999999]`: the index 99999999999999999999 is too large"), "an index too large")
    let single = try! parse_ref("GPIO.out_sel[3..=3]", "f.toml", TomlPosition(line: 1, column: 1))
    assert(single.ranged && single.first == 3 && single.last == 3, "a range of one element is a range")

    // A range may end at the end of a 32-bit space, and not one byte past.
    assert(space_refusal(0xFFFF_F000, 0x1000).is_empty(), "a range ending at 2^32")
    assert(space_refusal(0xFFFF_F000, 0x1001).equals("f.toml: line 1, column 1: r runs from 0xfffff000 for 0x1001 bytes, past the end of this board's address space"), "one byte past")

    // A count is never negative; a tag or a line fits the word.
    assert(count_refusal("tag = -1\n", 4).equals("c.toml: line 1, column 1: `tag` in t is -1, which is negative"), "a negative count")
    assert(count_refusal("tag = 0xFFFF_FFFF\n", 4).is_empty(), "the largest 32-bit tag")
    assert(count_refusal("tag = 0x1_0000_0000\n", 4).equals("c.toml: line 1, column 1: `tag` in t is 0x100000000, past what this board's 32-bit word holds (0xffffffff)"), "a tag past a 32-bit word")
    assert(count_refusal("tag = 0x1_0000_0000\n", 8).is_empty(), "the same tag on a 64-bit board")
    assert(word_refusal(0x1_0000_0000).equals("f.toml: line 1, column 1: `arena` is 0x100000000, past what the 32-bit word of the board b holds (0xffffffff)"), "a declaration's number on a board")

    // Paths.
    assert(path_refusal("config/x.saw").is_empty() && path_refusal("sawos:drivers/x").is_empty(), "paths")
    assert(path_refusal("").equals("f.toml: line 1, column 1: p is \"\", which names no path"), "an empty path")
    assert(path_refusal("sawos:").equals("f.toml: line 1, column 1: p is \"sawos:\", which names no path"), "an empty sawos path")
    assert(path_refusal("/etc").equals("f.toml: line 1, column 1: p is \"/etc\", an absolute path: a path is relative to the directory its file names it from"), "an absolute path")
    assert(path_refusal("sawos:../../x").equals("f.toml: line 1, column 1: p is \"sawos:../../x\", which climbs out with `..`: a path stays under the directory it is relative to"), "a path climbing out of the tree")
    assert(path_refusal("a/../../b").equals("f.toml: line 1, column 1: p is \"a/../../b\", which climbs out with `..`: a path stays under the directory it is relative to"), "a path with `..`")
}

func space_refusal(base: UInt64, len: UInt64) -> String {
    match fits_space(base, len, 4, "f.toml", TomlPosition(line: 1, column: 1), "r") {
        case Ok(_) -> "",
        case Err(e) -> e.message
    }
}

func word_refusal(value: UInt64) -> String {
    match fits_board_word(value, "b", 4, "f.toml", TomlPosition(line: 1, column: 1), "`arena`") {
        case Ok(_) -> "",
        case Err(e) -> e.message
    }
}

func path_refusal(path: String) -> String {
    match check_path(path, "f.toml", TomlPosition(line: 1, column: 1), "p") {
        case Ok(_) -> "",
        case Err(e) -> e.message
    }
}

func count_refusal(text: String, word: Int) -> String {
    let doc = try parse_description(text, "c.toml") catch {
        return error.message
    }
    borrow let root = doc.root() {
        match word_count(&root, "tag", word, "c.toml", "t") {
            case Ok(_) -> { return "" },
            case Err(e) -> { return e.message }
        }
    }
}
