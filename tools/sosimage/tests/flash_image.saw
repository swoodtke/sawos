// The flash image built from a linked ELF32: each loadable segment lands at
// the flash offset of its load address, and the image is refused when it
// lacks the direct-boot magic in either word, would begin with an esptool
// header's byte, or holds a segment that does not fit the flash window.

import std.data.{Data}
import sosimage.flash.{flash_image}
import sosimage.profile.{FlashLayout}

static IBUS: UInt64 = 0x4200_0000
static MAGIC: UInt64 = 0xAEDB_041D

func layout() -> FlashLayout {
    FlashLayout(bytes: 0x800, instruction_window: IBUS,
                data_window: 0x3C00_0000, window_bytes: 0x200_0000,
                magic_offset: 0x400, magic: MAGIC)
}

func put(elf: &var Data, at: Int, value: UInt64, bytes: Int) {
    var rest = value
    var i = 0
    while i < bytes {
        try! elf.set(at + i, (rest & 0xFF) as UInt8)
        rest = rest >> 8
        i = i + 1
    }
}

// One loadable segment: `paddr` is where it loads, and its `len` bytes are
// `first`, `first + 1`, ... or, for a magic segment, the words `word` and
// `word2`, little-endian.
struct Seg {
    paddr: UInt64
    first: UInt8
    len: Int
    word: UInt64
    word2: UInt64
    is_magic: Bool
}

func seg(paddr: UInt64, first: UInt8, len: Int) -> Seg {
    Seg(paddr: paddr, first: first, len: len, word: 0, word2: 0, is_magic: false)
}

// The two words at the direct-boot magic's offset.
func magic_seg(word: UInt64, word2: UInt64) -> Seg {
    Seg(paddr: IBUS + 0x400, first: 0, len: 8, word: word, word2: word2,
        is_magic: true)
}

func byte_of(s: Seg, b: Int) -> UInt8 {
    if s.is_magic {
        let w = if b < 4 { s.word } else { s.word2 }
        return ((w >> (((b % 4) * 8) as UInt64)) & 0xFF) as UInt8
    }
    s.first + (b as UInt8)
}

// An ELF32 holding only the fields `flash_image` reads: the program header
// table at 52, each segment's bytes from 0x100 on, 0x40 apart.
func elf_of(segs: &Vector<Seg>) -> Data {
    var elf = Data()
    var n = 0
    while n < 0x300 {
        try! elf.push(0)
        n = n + 1
    }
    put(&var elf, 28, 52, 4)
    put(&var elf, 44, segs.len() as UInt64, 2)
    var i = 0
    while i < segs.len() {
        let s = segs.get(i)!
        let ph = 52 + 32 * i
        let at = 0x100 + 0x40 * i
        put(&var elf, ph, 1, 4)
        put(&var elf, ph + 4, at as UInt64, 4)
        put(&var elf, ph + 12, s.paddr, 4)
        put(&var elf, ph + 16, s.len as UInt64, 4)
        var b = 0
        while b < s.len {
            try! elf.set(at + b, byte_of(s, b))
            b = b + 1
        }
        i = i + 1
    }
    move elf
}

// The message the image is refused with, or "" when it is built.
func refusal(segs: &Vector<Seg>) -> String {
    let elf = elf_of(&segs)
    let l = layout()
    match flash_image(&elf, &l, "case", "case.ld") {
        case Ok(_) -> "",
        case Err(e) -> e.message
    }
}

func expect(got: String, want: String) {
    if not got.equals(want) {
        print("expected: {want}")
        print("got:      {got}")
    }
    assert(got.equals(want), "the refusal's message")
}

func main() {
    // Code at flash 0, and the magic where the ROM reads it: built, with the
    // segments' bytes in place, the rest erased, and the two figures a board
    // is told.
    var good = Vector<Seg>()
    try! good.push(seg(IBUS, 1, 4))
    try! good.push(magic_seg(MAGIC, MAGIC))
    let elf = elf_of(&good)
    let l = layout()
    let made = try! flash_image(&elf, &l, "case", "case.ld")
    assert(made.image.len() == 0x800, "the flash's size")
    assert(made.used == 12, "the bytes the ELF placed")
    assert(made.end == 0x408, "one past the last placed byte")
    assert(made.image.get(0)! == 1 && made.image.get(3)! == 4, "the first segment's bytes")
    assert(made.image.get(4)! == 0xFF && made.image.get(0x3FF)! == 0xFF, "erased between segments")
    assert(made.image.get(0x400)! == 0x1D && made.image.get(0x403)! == 0xAE, "the first magic word")
    assert(made.image.get(0x404)! == 0x1D && made.image.get(0x407)! == 0xAE, "the second magic word")
    assert(made.image.get(0x408)! == 0xFF, "erased past the end")

    // No segment at the magic's offset: erased flash is read there.
    var bare = Vector<Seg>()
    try! bare.push(seg(IBUS, 1, 4))
    expect(refusal(&bare), "case: flash image lacks the direct-boot magic (read 0xffffffff 0xffffffff, want 0xaedb041d twice) — check .magic in case.ld")

    // A magic that is not the board's: both words wrong, then either one.
    var wrong = Vector<Seg>()
    try! wrong.push(seg(IBUS, 1, 4))
    try! wrong.push(magic_seg(0xAEDB_041E, 0xAEDB_041E))
    expect(refusal(&wrong), "case: flash image lacks the direct-boot magic (read 0xaedb041e 0xaedb041e, want 0xaedb041d twice) — check .magic in case.ld")
    var second = Vector<Seg>()
    try! second.push(seg(IBUS, 1, 4))
    try! second.push(magic_seg(MAGIC, 0xAEDB_041E))
    expect(refusal(&second), "case: flash image lacks the direct-boot magic (read 0xaedb041d 0xaedb041e, want 0xaedb041d twice) — check .magic in case.ld")
    var first = Vector<Seg>()
    try! first.push(seg(IBUS, 1, 4))
    try! first.push(magic_seg(0xAEDB_041E, MAGIC))
    expect(refusal(&first), "case: flash image lacks the direct-boot magic (read 0xaedb041e 0xaedb041d, want 0xaedb041d twice) — check .magic in case.ld")

    // A segment that starts in the flash window and runs past its end, and
    // one below its base, are refused by name, not read out of range.
    var past = Vector<Seg>()
    try! past.push(seg(IBUS + 0x7FE, 1, 4))
    expect(refusal(&past), "case: a segment loads at 0x420007fe, outside the flash window")
    var below = Vector<Seg>()
    try! below.push(seg(IBUS - 0x10, 1, 4))
    expect(refusal(&below), "case: a segment loads at 0x41fffff0, outside the flash window")

    // The magic in place, but byte 0 is an esptool image header's.
    var esp = Vector<Seg>()
    try! esp.push(seg(IBUS, 0xE9, 4))
    try! esp.push(magic_seg(MAGIC, MAGIC))
    expect(refusal(&esp), "case: flash byte 0 is 0xE9, an esptool image header; the ROM would not direct-boot it")
}
