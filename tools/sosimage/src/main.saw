//! sosimage: builds an SOS kernel image.
//!
//!     sosimage native PROFILE
//!         compiles the profile's native units, each to its object
//!     sosimage kernel PROFILE ENTRY OUTPUT
//!         compiles the kernel entry ENTRY to the object OUTPUT
//!     sosimage link PROFILE IMAGE
//!         stitches root's image, the child images and the region table into
//!         the kernel and links the image IMAGE describes; for a flash board
//!         it then writes the flash image and prints
//!         `flash used=USED end=END`, the bytes the ELF placed in it and the
//!         offset one past the last of them
//!     sosimage package PROFILE PROCESS
//!         builds the package the process description PROCESS names, linked
//!         for the placement it states, through a script the builder writes
//!         (`sosimage.package`), and prints `image PATH`, the image it made
//!     sosimage slabs KERNEL
//!         prints what the kernel object KERNEL says an image's limits are
//!         sized and checked against (`sosimage.kernel`): for each slab kind
//!         `NAME kind=K floor=F unit=U align=A` (its value, its floor, the
//!         bytes one unit of an area takes, the alignment the builder links
//!         an area at), for each quota kind `quota NAME kind=K default=D`,
//!         and one `limits ...` line of the kernel's other numbers
//!     sosimage board PROFILE SAWOS BOARD STAGING
//!         reads the board description BOARD (a `board.toml` of the sawos tree
//!         SAWOS) and holds it to PROFILE, to its linker script and to the
//!         board's HAL, compiled in STAGING; `sosimage.boardcheck` lists
//!         what is held. Prints nothing when they agree
//!     sosimage defaults KERNEL BOARD
//!         plans the board description BOARD's `[limits.default]` against
//!         the kernel object KERNEL as an image that states no limits of its
//!         own is planned, refusing a default that breaks a derivation or a
//!         bound (`sosimage.product.board_defaults`), and prints them as the
//!         `limits` object of an image description (`sosimage.image`), or
//!         `null` for a board that states none
//!     sosimage build PROFILE SAWOS PRODUCT IMAGE OUT
//!         builds the image the hand-written description IMAGE states, for
//!         the board it names, into the directory OUT (`sosimage.product`):
//!         SAWOS is the sawos tree, which holds the boards and every `sawos:`
//!         path, and PRODUCT the directory the image's other paths are from;
//!         for a flash board it prints `flash used=USED end=END` as `link`
//!         does, and a line with each process's and each pool's addresses
//!
//! PROFILE, the IMAGE `link` reads and the PROCESS `package` reads are JSON
//! files: `sosimage.profile`, `sosimage.image` and `sosimage.package` state
//! their schemas. A board description, a process
//! declaration and a hand-written image are TOML: `sosimage.board`,
//! `sosimage.declaration` and `sosimage.imagefile` state theirs. A failure
//! prints `error: ` and its reason on standard output and exits 1.

import std.env.{Env}
import sosimage.board.{Board}
import sosimage.boardcheck.{check_board, hal_facts}
import sosimage.build.{build_kernel, build_native, link}
import sosimage.package.{ProcessSpec, build_process}
import sosimage.product.{board_defaults, build_image}
import sosimage.failure.{BuildError}
import sosimage.image.{ImageSpec}
import sosimage.kernel.{KernelFacts, QUOTA_KINDS, SLAB_KINDS, quota_kind_name,
                       slab_kind_name}
import sosimage.profile.{Profile}
import sosimage.tool.{read_text}

// The reason is printed here rather than returned from `main`, whose error
// path cuts a long message short, and a failed tool's reason carries
// everything the tool printed.
func main() -> Int {
    try run() catch {
        print("error: {error}")
        return 1
    }
    0
}

func run() -> Result<Void, BuildError> {
    let args = try Env.args() catch {
        return BuildError(message: "could not read the arguments: {error}")
    }
    let command = args.get(1) ?? ""
    if command.equals("native") && args.len() == 3 {
        let profile = try load_profile(args.get(2) ?? "")
        return build_native(&profile)
    }
    if command.equals("kernel") && args.len() == 5 {
        let profile = try load_profile(args.get(2) ?? "")
        return build_kernel(&profile, args.get(3) ?? "", args.get(4) ?? "")
    }
    if command.equals("slabs") && args.len() == 3 {
        let facts = try KernelFacts.read(args.get(2) ?? "")
        var k = 0
        while k < SLAB_KINDS {
            print("{slab_kind_name(k)} kind={k} floor={facts.floors.get(k) ?? 0} unit={facts.units.get(k) ?? 0} align={facts.aligns.get(k) ?? 0}")
            k = k + 1
        }
        var q = 0
        while q < QUOTA_KINDS {
            print("quota {quota_kind_name(q)} kind={q} default={facts.defaults.get(q) ?? 0}")
            q = q + 1
        }
        print("limits capacity={facts.capacity} extents={facts.extents} records_per_body={facts.records_per_body} handles={facts.handles} image_rows={facts.image_rows} budget={facts.budget} domains={facts.domains} stride={facts.stride} inflight={facts.inflight}")
        return
    }
    if command.equals("link") && args.len() == 4 {
        let profile = try load_profile(args.get(2) ?? "")
        let path = args.get(3) ?? ""
        let spec = try ImageSpec.parse(try read_text(path), path)
        let linked = try link(&profile, &spec)
        if not linked.flash.is_empty() {
            print("flash used={linked.used} end={linked.end}")
        }
        return
    }
    if command.equals("package") && args.len() == 4 {
        let profile = try load_profile(args.get(2) ?? "")
        let path = args.get(3) ?? ""
        let spec = try ProcessSpec.parse(try read_text(path), path)
        let built = try build_process(&profile, spec.name, spec.package, spec.out, &spec.placement)
        print("image {built.image}")
        return
    }
    if command.equals("board") && args.len() == 6 {
        let profile = try load_profile(args.get(2) ?? "")
        let path = args.get(4) ?? ""
        let board = try Board.parse(try read_text(path), path)
        let facts = try hal_facts(&profile, args.get(5) ?? "")
        return check_board(&board, &profile, &facts, args.get(3) ?? "")
    }
    if command.equals("defaults") && args.len() == 4 {
        let facts = try KernelFacts.read(args.get(2) ?? "")
        let path = args.get(3) ?? ""
        let board = try Board.parse(try read_text(path), path)
        let limits = try board_defaults(&board, &facts)
        if board.has_limits {
            print(limits.json())
        } else {
            print("null")
        }
        return
    }
    if command.equals("build") && args.len() == 7 {
        let profile = try load_profile(args.get(2) ?? "")
        let linked = try build_image(&profile, args.get(3) ?? "", args.get(4) ?? "",
                                     args.get(5) ?? "", args.get(6) ?? "")
        if not linked.flash.is_empty() {
            print("flash used={linked.used} end={linked.end}")
        }
        return
    }
    return BuildError(message: "usage: sosimage native PROFILE | kernel PROFILE ENTRY OUTPUT | link PROFILE IMAGE | package PROFILE PROCESS | slabs KERNEL | board PROFILE SAWOS BOARD STAGING | defaults KERNEL BOARD | build PROFILE SAWOS PRODUCT IMAGE OUT")
}

func load_profile(path: String) -> Result<Profile, BuildError> {
    Profile.parse(try read_text(path), path)
}
