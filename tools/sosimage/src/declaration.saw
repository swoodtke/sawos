//! A process's declaration: `process.toml`, beside the `Saw.toml` of each
//! package the stock root launches.
//!
//!     format = 1
//!     arena = 0x1000                     optional: the built-in heap's size
//!     ram = "fast"                       optional: it needs fast memory
//!     bands = "full"                     optional: "simple" (the default)
//!                                        or "full"
//!
//!     [[boot]]                           in the order the launcher gives them
//!     name = "system"
//!     kind = "system"
//!     tag = 1
//!     rights = ["debug", "clock-get"]    optional
//!
//!     [[boot]]
//!     name = "uart"
//!     kind = "window"                    system, window, line, serve, client
//!     type = "esp32s3-uart"              or memory
//!     tag = 2
//!
//!     [ceilings]                         optional; complete when present
//!     process = ["thread-create", "exit", "boot-handles", "thread-self"]
//!     event = ["signal", "receive", "wait"]
//!
//!     [quota]                            optional, each key optional
//!     handles = 8
//!     waiters = 1
//!
//!     [build]                            optional
//!     inputs = ["uartpins", "uartconfig"]
//!     defaults = { uartconfig = "config/default.saw" }
//!
//!     [heap.default]                     optional: the global allocator's
//!     len = 0x2_0000                     the pool: the heap and its shares
//!     ram = "fast"                       optional: the pool in fast memory
//!
//!     [heap.data]                        a named heap, `sos.Heap<1>`
//!     slot = 1
//!     len = 0x4_0000
//!
//! By kind, a record also has: `system`, an optional `rights` (exactly one
//! record, whose tag is the start tag); `window`, `type` and an optional
//! `part = true` (a register range of the device will do, and the image names
//! it); `line`, `type`; `serve` and `client`, `protocol`, the protocol
//! package's name; `memory`, nothing (the image binds it to a pool). Each of
//! them but `system` may also have `rights`, which is the rights it is given
//! with (below). A path is relative to the package's directory.
//!
//! `bands` asks the launcher for the process's band map (spec §7): `simple`,
//! the default, is the map every created process has, and `full` is the
//! identity map, each band at the level of its own rank. The value is a mode,
//! and the stock root grants it (`Declaration.full_bands`, `sosimage.plan`).
//!
//! `[ceilings]` narrows, per kind of handle, the rights of the handles the
//! kernel mints into the process's table below the launcher's (spec §2.7: a
//! ceiling does not cap a handle the process is sent in a message). A key is
//! a kind in kebab case (`process`, `thread`, `event`, `waiter`, `interrupt`, `clock`, `timer`, `memory`, `iomemory`,
//! `mapping`, `pool`, `pipe-inlet`, `pipe-outlet`, `pipe-reply`,
//! `pipe-request`; `sosimage.rights` is the table), and its value lists the
//! rights of that kind the process may hold, each by its name in the kind's
//! rights enum in kebab case (`map-execute`). The table is complete when
//! present: a kind it does not list gets no rights, and without the table the
//! process keeps the launcher's ceilings but for the opt-in rights
//! (`sosimage.rights.is_opt_in`), which it asks for here and its image must
//! grant (`Declaration.within_image`). The System rights
//! are not among them: they stay on the `system` record.
//!
//! A record's `rights` is its give's keep mask, a list of its kind's rights
//! (a window's are `iomemory`'s, a line's `interrupt`'s, a serve's
//! `pipe-outlet`'s, a client's `pipe-inlet`'s, a `memory` record's `pool`'s).
//! With `[ceilings]` they lie within the kind's ceiling, and a record with
//! none is given with the whole of it; without `[ceilings]` a record with
//! none is given with every right its source holds but the opt-in ones
//! (`Declaration.keep_word`).
//! A `[ceilings]` that withholds a right the program's runtime spends is
//! refused by name (`check_runtime`), and so is an image's `ceilings` that
//! leaves it one that does (`Declaration.within_image`).
//!
//! A `system` record's `rights` names the `SystemRight`s its System handle
//! keeps, each by its name in kebab case, and the process gets exactly those:
//! an empty list gives it none. A record with no `rights` gets the image's
//! default (`sosimage.imagefile`'s `[system]`). When the image states none,
//! that is the launch convention's four (spec §12), `debug`, `process-self`,
//! `clock-get` and `transfer`, or in an image that names a console the three
//! without `debug` (`console_rights`): there a program written with `main`
//! prints through the console, so `debug` is for a process that writes
//! through the kernel's debug print, the console's driver among them, and it
//! names it. The four are also every right an image may name, and with
//! `console` every right a declaration may name, since any other System right
//! is the launcher's to give. `console` (`SystemRight.Console`, the console
//! claim) is the console's driver's: the stock root gives it only to the
//! process serving its image's `[image] console`, and the builder refuses a
//! declaration naming it in any other process (`sosimage.imagefile.bind`) and
//! in an image with a hand-written root
//! (`sosimage.product.refuse_console_right`).
//!
//! Beyond the rules of `sosimage.rules`, a declaration is refused by name
//! for: a `[ceilings]` key that is no kind, is `system`, or lists a right the
//! kind does not have or one twice; a `bands` that is not `simple` or `full`;
//! a record's `rights` that names a right its kind does not have, or one
//! outside the kind's ceiling, an opt-in right included when `[ceilings]` does
//! not ask for it; a `count` on a record (the list form,
//! reserved); a tag in the range
//! the runtime reserves (`bootplan.RESERVED_TAG_FIRST` up, whose first is
//! `CONSOLE_TAG`); a right in `rights` that is not one of the four or
//! `console`, or one named twice; a tag given twice;
//! not exactly one `system` record; a name given twice within its family
//! (device needs; endpoints, a serve and a client sharing one set of names;
//! memory), where a window and a line of one type under one name are one
//! need; two names for one type, which would be two devices of one type
//! (reserved); an input whose name is no Saw identifier (it has a `-`),
//! since the program imports the input by it; a `defaults` key that is not
//! an input, or whose value is not a path; a `ram` other than `fast`; a
//! `threads` of 0, since a process's first thread is charged to it; and a
//! declared `handles` below what the process holds when it starts (one per
//! record, its Process handle, one Mapping per window, and for a program
//! written with `main` its main thread's own Thread handle) and once its heaps
//! have grown (`heap_handles`).
//!
//! `arena` sizes the process's built-in heap, which is linked into its image;
//! with none, the image's `[image] arena` sizes it, and with neither it is
//! 4 KiB (`sosimage.product.process_arena`). Each `[heap.NAME]` is a heap over
//! a pool the launcher gives the process under the heap's slot's tag
//! (`bootplan.HEAP_TAG` and up), for the runtime to grow the heap into from
//! the pool's front and to take shares from its back: `default` is slot 0,
//! which the global allocator asks before the built-in heap, and a named heap
//! states the slot its program names it by (`sos.Heap<SLOT>`). Heaps are kept
//! in slot order. A heap is refused by name for a name that is no Saw
//! identifier, a `slot` on `default`, a named heap without one or with one of
//! 0 or of `bootplan.MAX_HEAPS` or more, a slot two heaps take, and a `ram`
//! other than `fast`. Its `len` is held to the board's word by
//! `check_against`, and to the board's grain and RAM where the image binds it
//! (`sosimage.imagefile.bind`).
//!
//! A program written with `main` is one whose `Saw.toml`, beside its
//! `process.toml`, depends on `sosmain`: that package's start-up mints the
//! main thread's handle before `main` runs (`Declaration.load`).
//!
//! A declaration does not know its image, so its floor leaves out the record
//! an image that names a console gives the process; the plan adds it
//! (`sosimage.plan`).
//!
//! Against a board (`check_against`), a process is also refused for an
//! `arena`, a heap's `len` or a tag the board's word cannot hold, a type the
//! board has no device of, a board input of a type it needs (other than
//! through a `part` window alone) that its `inputs` does not list, and a
//! default for any board input of a type it needs: the board input's value
//! follows the device.

import std.path.{Path}
import toml.{TomlDoc, TomlKind, TomlPosition, TomlTable}
import sosimage.board.{Board, NamedCount, expect_table, quota_keys, read_counts,
                       require_table}
import bootplan.{KEEP_ALL, MAX_HEAPS, RESERVED_TAG_FIRST, RESERVED_TAG_LAST, is_reserved_tag}
import sosimage.failure.{BuildError}
import sosimage.hex.{hex}
import sosimage.rights.{CEILING_KINDS, CeilingKindInfo, ceiling_keys, ceiling_kind,
                        ceiling_kind_at, has_right, is_opt_in, names_in, opt_in_word,
                        right_names, right_word, rights_word}
import sosimage.tool.{read_text}
import sosimage.rules.{
    check_format, check_input_name, check_name, check_path, count, element_at, fits_board_word, flag, holds,
    is_name, name_list, only_keys, optional_size, parse_description, refused, size, text,
    toml_refused, where_is,
}

/// The handles each heap holds once it has grown: its pool, its `Memory` and
/// its `Mapping`, which the runtime keeps for the process's life.
public static HEAP_HANDLES: Int = 3

/// The default heap's slot: the global allocator's.
public static DEFAULT_HEAP_SLOT: Int = 0

/// What a boot record is.
public enum RecordKind {
    case System,
    case Window,
    case Line,
    case Serve,
    case Client,
    case Memory
}

@synthesize
extension RecordKind: Equatable {}

/// The kind named `word`.
public func record_kind(word: String) -> RecordKind? {
    if word.equals("system") { return RecordKind.System }
    if word.equals("window") { return RecordKind.Window }
    if word.equals("line") { return RecordKind.Line }
    if word.equals("serve") { return RecordKind.Serve }
    if word.equals("client") { return RecordKind.Client }
    if word.equals("memory") { return RecordKind.Memory }
    None
}

/// The kind of handle a record is given, as `[ceilings]` names it; none for
/// the `system` record, whose rights are System's.
public func ceiling_key_of(kind: RecordKind) -> String? {
    match kind {
        case System -> None,
        case Window -> "iomemory",
        case Line -> "interrupt",
        case Serve -> "pipe-outlet",
        case Client -> "pipe-inlet",
        case Memory -> "pool"
    }
}

/// A kind's word, as a declaration writes it.
public func kind_word(kind: RecordKind) -> String {
    match kind {
        case System -> "system",
        case Window -> "window",
        case Line -> "line",
        case Serve -> "serve",
        case Client -> "client",
        case Memory -> "memory"
    }
}

/// One `[[boot]]` record.
public struct BootRecord {
    name: String
    kind: RecordKind
    tag: Int
    tag_at: TomlPosition
    /// A window's or a line's device type; empty for the other kinds.
    type_name: String
    /// A window that a register range of its device will do for.
    part: Bool
    /// A serve's or a client's protocol package; empty for the other kinds.
    protocol: String
    /// The rights it is given with, as a mask of its kind's rights; none when
    /// it states none. Always none for a `system` record.
    rights: UInt32?
    at: TomlPosition
}

/// One `[ceilings]` key: a kind and the rights word its ceiling is narrowed
/// to.
public struct CeilingRow {
    /// The kind's name in the declaration.
    key: String
    rights: UInt32
    at: TomlPosition
}

/// One kind of one process's `ceilings` in an image description: the rights
/// its list names, as a word.
public struct ImageCeiling {
    process: String
    key: String
    rights: UInt32
    at: TomlPosition
}

/// The `ceilings` entry of `process` for the kind `key`; none when the image
/// lists none.
func image_ceiling(listed: &Vector<ImageCeiling>, process: String,
                   key: String) -> ImageCeiling? {
    var i = 0
    while i < listed.len() {
        let entry = listed.get(i)!
        if entry.process.equals(process) && entry.key.equals(key) {
            return entry
        }
        i = i + 1
    }
    None
}

/// One `[heap.NAME]`: a heap over a pool the launcher gives.
public struct HeapDecl {
    name: String
    /// `DEFAULT_HEAP_SLOT` for `default`, a named heap's `slot` otherwise.
    slot: Int
    /// The pool's bytes: the heap and its shares together.
    len: UInt64
    len_at: TomlPosition
    /// `ram = "fast"`: the pool must lie in a fast range.
    fast: Bool
    at: TomlPosition
}

/// An input's default, and the file it names.
public struct InputDefault {
    input: String
    path: String
    at: TomlPosition
}

/// A process, as its declaration states it.
public struct Declaration {
    /// The file, as it was named.
    file: String
    /// The package's directory: the file's.
    dir: String
    /// The built-in heap's size; none when the declaration states none, and
    /// the image's or the default applies.
    arena: UInt64?
    arena_at: TomlPosition
    /// `ram = "fast"`.
    fast: Bool
    /// `bands = "full"`: the process asks for the full band map; otherwise it
    /// has the simple one.
    full_bands: Bool
    /// A program written with `main`, whose start-up holds one handle more.
    main: Bool
    records: Vector<BootRecord>
    /// The rights its `system` record names; none when it has no `rights`,
    /// and the image's default applies (`system_rights_or`).
    system_rights: Vector<String>?
    /// `[ceilings]`'s keys; empty when it has none.
    ceilings: Vector<CeilingRow>
    /// Whether the declaration has a `[ceilings]`.
    has_ceilings: Bool
    quota: Vector<NamedCount>
    inputs: Vector<String>
    inputs_at: TomlPosition
    defaults: Vector<InputDefault>
    /// `[heap]`, in slot order.
    heaps: Vector<HeapDecl>
}

@synthesize
extension Declaration: ExplicitCopy {}

/// The build inputs of `d`, as `sosimage declared` prints them: `input NAME`
/// each, in the declaration's order.
public func input_lines(d: &Declaration) -> Vector<String> {
    var out = Vector<String>()
    var i = 0
    while i < d.inputs.len() {
        try! out.push("input {d.inputs.get(i)!}")
        i = i + 1
    }
    move out
}

/// Whether a record is a device need: a window or a line.
public func is_need(kind: RecordKind) -> Bool {
    kind == RecordKind.Window || kind == RecordKind.Line
}

/// The System rights a declaration or an image may name, as they name them,
/// in the launch convention's order: every right the stock root gives a
/// process, and what one keeps when neither its declaration nor its image
/// names any.
public func child_rights() -> Vector<String> {
    ["debug", "process-self", "clock-get", "transfer"]
}

/// What a process keeps when neither its declaration nor its image names any
/// rights, in an image that names a console: the launch convention's four
/// less `debug`, since a program written with `main` prints through the
/// console there.
public func console_rights() -> Vector<String> {
    ["process-self", "clock-get", "transfer"]
}

/// The System right a declaration may name beside `child_rights()`: the
/// console claim, which the stock root gives only to the image's console.
public func console_right_name() -> String {
    "console"
}

/// The System rights a declaration may name: `child_rights()` and
/// `console_right_name()`.
public func declared_rights() -> Vector<String> {
    var out = child_rights()
    try! out.push(console_right_name())
    move out
}

/// The list `rights` in `t`, each one of `allowed`; `place` says where the
/// key is for a refusal (empty, or ` in [TABLE]`) and `owner` what states it.
public func read_rights(t: &TomlTable, file: String, place: String, owner: String,
                        allowed: &Vector<String>) -> Result<Vector<String>, BuildError> {
    let rights = try name_list(&t, "rights", file, "a System right's name")
    var i = 0
    while i < rights.len() {
        let name = rights.get(i) ?? ""
        if not holds(&allowed, name) {
            let most = if holds(&allowed, console_right_name()) {
                "a process's System record keeps at most `debug`, `process-self`, `clock-get`, `transfer` and, in the image's console, `console`;"
            } else {
                "an image's default keeps at most `debug`, `process-self`, `clock-get` and `transfer`; `console` is named only by the declaration of the image's console, and"
            }
            return refused(file, element_at(&t, "rights", i),
                           "`rights`{place} names `{name}`, which {owner} may not name: {most} any other System right is its launcher's to give")
        }
        i = i + 1
    }
    return move rights
}

/// The family a record's name is unique in.
func family(kind: RecordKind) -> Int {
    match kind {
        case Window -> 0,
        case Line -> 0,
        case Serve -> 1,
        case Client -> 1,
        case System -> 2,
        case Memory -> 3
    }
}

extension Declaration {
    /// Reads the declaration at `file`, a `process.toml`, and whether its
    /// package is a program written with `main` from the `Saw.toml` beside
    /// it.
    public static func load(file: String) -> Result<Declaration, BuildError> {
        let dir = Path(s: file).parent()?.as_string() ?? "."
        let main = try is_main_program(dir)
        Declaration.parse(try read_text(file), file, main: main)
    }

    /// Reads a declaration from its text; `file` names it, and its directory
    /// is the package's. `main` says the package is a program written with
    /// `main` rather than one exporting its own `_start`.
    public static func parse(text: String, file: String,
                             main: Bool = false) -> Result<Declaration, BuildError> {
        let doc = try parse_description(text, file)
        borrow let root = doc.root() {
            return Declaration.read(&root, file, main)
        }
    }

    /// Reads a declaration's top-level table.
    public static func read(root: &TomlTable, file: String,
                            main: Bool) -> Result<Declaration, BuildError> {
        let top_keys: Vector<String> = ["format", "arena", "ram", "boot", "ceilings", "quota",
                                        "build", "heap", "bands"]
        try only_keys(&root, &top_keys, file, "a process declaration")
        try check_format(&root, file)
        let arena = try optional_size(&root, "arena", 8, file, "the declaration")
        var fast = false
        if root.contains("ram") {
            let ram = try text(&root, "ram", file)
            if not ram.equals("fast") {
                return refused(file, where_is(&root, "ram"),
                               "`ram` is \"{ram}\": a declaration's `ram` is \"fast\", for a program that needs fast memory, or absent")
            }
            fast = true
        }

        var full_bands = false
        if root.contains("bands") {
            let mode = try text(&root, "bands", file)
            if mode.equals("full") {
                full_bands = true
            } else if not mode.equals("simple") {
                return refused(file, where_is(&root, "bands"),
                               "`bands` is \"{mode}\": a declaration's `bands` is \"simple\", the default, or \"full\"")
            }
        }

        var heaps = Vector<HeapDecl>()
        try expect_table(&root, "heap", file)
        if let h = root.table("heap") {
            heaps = try read_heaps(&h, file)
        }

        try root.require("boot", TomlKind.Array) catch {
            return toml_refused(file, error)
        }
        var records = Vector<BootRecord>()
        var system_rights: Vector<String>? = None
        if let boot = root.array("boot") {
            var i = 0
            while i < boot.len() {
                if let r = boot.table(i) {
                    let record = try read_record(&r, file)
                    if record.kind == RecordKind.System && r.contains("rights") {
                        let allowed = declared_rights()
                        system_rights = try read_rights(&r, file, "", "a process's declaration",
                                                        &allowed)
                    }
                    try! records.push(record)
                } else {
                    return refused(file, boot.position(i) ?? boot.defined_at(),
                                   "`boot` is an array of tables: write each record as [[boot]]")
                }
                i = i + 1
            }
        }
        try check_records(&records, file, where_is(&root, "boot"))

        var ceilings = Vector<CeilingRow>()
        var has_ceilings = false
        try expect_table(&root, "ceilings", file)
        if let c = root.table("ceilings") {
            has_ceilings = true
            ceilings = try read_ceilings(&c, file, "[ceilings]")
        }
        try check_record_rights(&records, &ceilings, has_ceilings, file)
        if has_ceilings {
            try check_runtime(&ceilings, main, heaps.len(), file, where_is(&root, "ceilings"),
                              "[ceilings]")
        }

        var quota = Vector<NamedCount>()
        try expect_table(&root, "quota", file)
        if let q = root.table("quota") {
            let keys = quota_keys()
            quota = try read_counts(&q, &keys, file, "[quota]")
            var r = 0
            while r < quota.len() {
                let row = quota.get(r)!
                if row.name.equals("threads") && row.value == 0 {
                    return refused(file, where_is(&q, "threads"),
                                   "`threads` in [quota] is 0: a process's first thread is charged to its row, and with none it cannot start")
                }
                r = r + 1
            }
            try check_handles(&records, main, heaps.len(), &quota, file, where_is(&q, "handles"))
        }

        var inputs = Vector<String>()
        var inputs_at = root.defined_at()
        var defaults = Vector<InputDefault>()
        try expect_table(&root, "build", file)
        if let b = root.table("build") {
            let build_keys: Vector<String> = ["inputs", "defaults"]
            try only_keys(&b, &build_keys, file, "[build]")
            inputs = try name_list(&b, "inputs", file, "an input's name")
            inputs_at = where_is(&b, "inputs")
            var n = 0
            while n < inputs.len() {
                try check_input_name(inputs.get(n) ?? "", file, element_at(&b, "inputs", n))
                n = n + 1
            }
            try expect_table(&b, "defaults", file)
            if let d = b.table("defaults") {
                let names = try! d.keys()
                var i = 0
                while i < names.len() {
                    let input = names.get(i) ?? ""
                    i = i + 1
                    let at = where_is(&d, input)
                    if not holds(&inputs, input) {
                        return refused(file, at, "`{input}` has a default and is not one of [build] inputs")
                    }
                    if d.kind(input) == TomlKind.Array {
                        return refused(file, at, "the default for `{input}` is a list: an input takes one value, and the list form is reserved")
                    }
                    let path = try text(&d, input, file)
                    try check_path(path, file, at, "the default for `{input}`")
                    try! defaults.push(InputDefault(input: input, path: path, at: at))
                }
            }
        }

        let dir = Path(s: file).parent()?.as_string() ?? "."
        return Declaration(file: file, dir: dir, arena: arena, arena_at: where_is(&root, "arena"), fast: fast,
                           full_bands: full_bands,
                           main: main, records: move records, system_rights: move system_rights,
                           ceilings: move ceilings, has_ceilings: has_ceilings,
                           quota: move quota,
                           inputs: move inputs, inputs_at: inputs_at,
                           defaults: move defaults, heaps: move heaps)
    }

    /// Whether its `system` record names `console`, the console claim.
    public func names_console(&self) -> Bool {
        match self.system_rights {
            case Some(own) -> holds(&own, console_right_name()),
            case None -> false
        }
    }

    /// Its `system` record, which a declaration has exactly one of.
    public func system_record(&self) -> BootRecord {
        var i = 0
        while i < self.records.len() {
            let r = self.records.get(i)!
            if r.kind == RecordKind.System {
                return r
            }
            i = i + 1
        }
        panic("{}: internal: a declaration with no system record was read", self.file)
    }

    /// The rights its System record keeps: those it names, or the image's
    /// default, `image_default`, when it names none.
    public func system_rights_or(&self, image_default: &Vector<String>) -> Vector<String> {
        match self.system_rights {
            case Some(own) -> own.copy(),
            case None -> image_default.copy()
        }
    }

    /// The word `[ceilings]` narrows the ceiling of the kind `key` to: none
    /// for a kind it does not list, and for every kind when the declaration
    /// has none, which leaves the ceiling alone (`has_ceilings`).
    public func ceiling_word(&self, key: String) -> UInt32 {
        var i = 0
        while i < self.ceilings.len() {
            let row = self.ceilings.get(i)!
            if row.key.equals(key) {
                return row.rights
            }
            i = i + 1
        }
        0
    }

    /// This declaration's process under its image's `ceilings` (`listed`,
    /// the whole image's, of which `process`'s are the ones read), as a
    /// declaration whose `[ceilings]` is the effective one, a row for every
    /// kind: the declaration's word, or every right but the opt-in ones when
    /// it has no `[ceilings]`, intersected with the image's word for each
    /// kind the image lists. `at` is the process's position in the image
    /// `file`, where a refusal that is the image's is placed.
    ///
    /// An opt-in right must be in both: the declaration's `[ceilings]` asks
    /// for it and the image grants it, on each kind that has one. Refused by
    /// name, the process, the kind and the right: an ask the image does not
    /// grant, a grant the declaration does not ask for, a right of a record's
    /// own `rights` that the image's list removes, and a right the program's
    /// runtime spends that the effective ceiling lacks (`check_runtime`).
    public func within_image(&self, process: String, listed: &Vector<ImageCeiling>,
                             file: String, at: TomlPosition) -> Result<Declaration, BuildError> {
        var rows = Vector<CeilingRow>()
        var i = 0
        while i < CEILING_KINDS {
            let info = ceiling_kind_at(i)
            i = i + 1
            let opt_in = opt_in_word(&info)
            var word = KEEP_ALL & ~opt_in
            var asked: UInt32 = 0
            if self.has_ceilings {
                word = self.ceiling_word(info.key)
                asked = word & opt_in
            }
            var granted: UInt32 = 0
            var row_at = at
            if let image = image_ceiling(&listed, process, info.key) {
                granted = image.rights & opt_in
                word = word & image.rights
                row_at = image.at
            }
            let unasked = granted & ~asked
            if unasked != 0 {
                let right = names_in(&info, unasked).get(0) ?? ""
                return refused(file, row_at,
                               "the image grants `{right}` on `{info.key}` to the process {process}, whose declaration does not ask for it")
            }
            let ungranted = asked & ~granted
            if ungranted != 0 {
                let right = names_in(&info, ungranted).get(0) ?? ""
                return refused(file, at,
                               "the process {process} asks for `{right}` on `{info.key}` in its declaration, and the image does not grant it: add it to the process's `ceilings` in the image")
            }
            try! rows.push(CeilingRow(key: info.key, rights: word, at: row_at))
        }
        var r = 0
        while r < self.records.len() {
            let record = self.records.get(r)!
            r = r + 1
            guard let own = record.rights else {
                continue
            }
            guard let key = ceiling_key_of(record.kind) else {
                continue
            }
            var kept: UInt32 = 0
            var row_at = at
            var k = 0
            while k < rows.len() {
                let row = rows.get(k)!
                if row.key.equals(key) {
                    kept = row.rights
                    row_at = row.at
                }
                k = k + 1
            }
            let stripped = own & ~kept
            if stripped != 0 {
                let info = ceiling_kind(key)!
                let right = names_in(&info, stripped).get(0) ?? ""
                return refused(file, row_at,
                               "the image's `{key}` ceiling for the process {process} removes `{right}`, which its record `{record.name}` keeps")
            }
        }
        try check_runtime(&rows, self.main, self.heaps.len(), file, at,
                          "the effective ceilings of the process {process}")
        var out = self.copy()
        out.ceilings = move rows
        out.has_ceilings = true
        return move out
    }

    /// The rights the record `r` is given with, a mask of its kind's rights:
    /// the ones it names, else its kind's whole ceiling when the declaration
    /// has one, else every right its source holds (`bootplan.KEEP_ALL`) but
    /// its kind's opt-in ones. A `system` record keeps its System rights
    /// instead, and this answers `KEEP_ALL` for it.
    public func keep_word(&self, r: &BootRecord) -> UInt32 {
        if let own = r.rights {
            return own
        }
        guard let key = ceiling_key_of(r.kind) else {
            return KEEP_ALL
        }
        if self.has_ceilings {
            return self.ceiling_word(key)
        }
        KEEP_ALL & ~opt_in_word(&(ceiling_kind(key)!))
    }

    /// The handles the process holds when it starts, and once its heaps have
    /// grown: one per record, its Process handle, one Mapping per window, for
    /// a program written with `main` its main thread's own Thread handle, and
    /// its heaps' (`heap_handles`).
    public func handle_floor(&self) -> Int {
        handles_at_start(&self.records, self.main) + heap_handles(self.heaps.len())
    }

    /// The window records: each a Mapping row the process spends when it maps
    /// its window.
    public func window_count(&self) -> Int {
        windows_of(&self.records)
    }

    /// The device needs, each named once, with its type: the first record of
    /// each.
    public func needs(&self) -> Vector<BootRecord> {
        var out = Vector<BootRecord>()
        var i = 0
        while i < self.records.len() {
            let r = self.records.get(i)!
            i = i + 1
            if not is_need(r.kind) {
                continue
            }
            var seen = false
            var j = 0
            while j < out.len() {
                if (out.get(j)!).name.equals(r.name) {
                    seen = true
                }
                j = j + 1
            }
            if not seen {
                try! out.push(r)
            }
        }
        move out
    }

    /// Whether `name` is one of the device needs.
    public func has_need(&self, name: String) -> Bool {
        var i = 0
        while i < self.records.len() {
            let r = self.records.get(i)!
            if is_need(r.kind) && r.name.equals(name) {
                return true
            }
            i = i + 1
        }
        false
    }

    /// Whether the need `name` is met by a register range alone: every record
    /// of it is a `part` window.
    public func need_is_part(&self, name: String) -> Bool {
        var i = 0
        while i < self.records.len() {
            let r = self.records.get(i)!
            if is_need(r.kind) && r.name.equals(name) && not (r.kind == RecordKind.Window && r.part) {
                return false
            }
            i = i + 1
        }
        true
    }

    /// The record of `kind` named `name`.
    public func record(&self, kind: RecordKind, name: String) -> BootRecord? {
        var i = 0
        while i < self.records.len() {
            if let r = self.records.get(i) {
                if r.kind == kind && r.name.equals(name) {
                    return r
                }
            }
            i = i + 1
        }
        None
    }

    /// This input's default.
    public func default_for(&self, input: String) -> InputDefault? {
        var i = 0
        while i < self.defaults.len() {
            if let d = self.defaults.get(i) {
                if d.input.equals(input) {
                    return d
                }
            }
            i = i + 1
        }
        None
    }

    /// Refuses the declaration on `board` for an `arena` or a tag its word
    /// cannot hold, a type the board has no device of, a board input of a
    /// needed type that `inputs` does not list (a need met by a part window
    /// alone owes none), and a default for any board input of a needed type.
    public func check_against(&self, board: &Board) -> Result<Void, BuildError> {
        if let arena = self.arena {
            try fits_board_word(arena, board.name, board.word, self.file, self.arena_at,
                                "`arena`")
        }
        var h = 0
        while h < self.heaps.len() {
            let heap = self.heaps.get(h)!
            try fits_board_word(heap.len, board.name, board.word, self.file, heap.len_at,
                                "`len` in [heap.{heap.name}]")
            h = h + 1
        }
        var t = 0
        while t < self.records.len() {
            let r = self.records.get(t)!
            try fits_board_word(r.tag as UInt64, board.name, board.word, self.file, r.tag_at,
                                "the tag of `{r.name}`")
            t = t + 1
        }
        let needs = self.needs()
        var i = 0
        while i < needs.len() {
            let need = needs.get(i)!
            i = i + 1
            if board.instances(need.type_name).len() == 0 {
                return refused(self.file, need.at,
                               "the {kind_word(need.kind)} `{need.name}` needs a device of the type `{need.type_name}`, and the board {board.name} has none")
            }
            let board_inputs = board.board_inputs(need.type_name)
            var j = 0
            while j < board_inputs.len() {
                let input = board_inputs.get(j) ?? ""
                j = j + 1
                if let d = self.default_for(input) {
                    return refused(self.file, d.at,
                                   "`{input}` is a board input of the type `{need.type_name}` on the board {board.name}, and a driver's default for it would be a guess at wiring: its value comes from the image or the device")
                }
                if not holds(&self.inputs, input) && not self.need_is_part(need.name) {
                    return refused(self.file, self.inputs_at,
                                   "`{input}` is a board input of the type `{need.type_name}` on the board {board.name}, and [build] inputs does not list it")
                }
            }
        }
        return
    }
}

/// Whether the package in `dir` is a program written with `main`: its
/// `Saw.toml` depends on `sosmain`.
public func is_main_program(dir: String) -> Result<Bool, BuildError> {
    let manifest = "{dir}/Saw.toml"
    let doc = try TomlDoc.parse(try read_text(manifest)) catch {
        return BuildError(message: "{manifest}: {error}")
    }
    borrow let root = doc.root() {
        if let deps = root.table("dependencies") {
            return deps.contains("sosmain")
        }
        return false
    }
}

/// The handles a process with `records` holds when it starts, `main` saying
/// it is a program written with `main`.
func handles_at_start(records: &Vector<BootRecord>, main: Bool) -> Int {
    let main_thread = if main { 1 } else { 0 }
    records.len() + 1 + windows_of(&records) + main_thread
}

/// The window records among `records`.
func windows_of(records: &Vector<BootRecord>) -> Int {
    var windows = 0
    var i = 0
    while i < records.len() {
        if (records.get(i)!).kind == RecordKind.Window {
            windows = windows + 1
        }
        i = i + 1
    }
    windows
}

/// The handles `heaps` heaps hold once each has grown: `HEAP_HANDLES` each,
/// and one for the Process handle they map through, which the runtime mints
/// at the first adoption.
public func heap_handles(heaps: Int) -> Int {
    if heaps == 0 {
        return 0
    }
    HEAP_HANDLES * heaps + 1
}

/// `[heap]`: a table per heap, kept in slot order.
func read_heaps(h: &TomlTable, file: String) -> Result<Vector<HeapDecl>, BuildError> {
    var out = Vector<HeapDecl>()
    let names = try! h.keys()
    var i = 0
    while i < names.len() {
        let name = names.get(i) ?? ""
        i = i + 1
        let at = where_is(&h, name)
        if not is_name(name) || name.contains("-") {
            return refused(file, at, "`{name}` is not a heap's name: a heap is named as a Saw identifier is, a letter, then letters, digits and `_`")
        }
        try require_table(&h, name, file)
        if let t = h.table(name) {
            let heap = try read_heap(&t, name, file, at)
            var j = 0
            while j < out.len() {
                let other = out.get(j)!
                if other.slot == heap.slot {
                    return refused(file, where_is(&t, "slot"), "[heap.{name}] takes slot {heap.slot}, which [heap.{other.name}] takes at {other.at}: a slot is one heap's")
                }
                j = j + 1
            }
            try! out.push(heap)
            var k = out.len() - 1
            while k > 0 && (out.get(k - 1)!).slot > (out.get(k)!).slot {
                out.swap(k - 1, k)
                k = k - 1
            }
        }
    }
    return move out
}

/// One `[heap.NAME]`, at `at`.
func read_heap(t: &TomlTable, name: String, file: String,
               at: TomlPosition) -> Result<HeapDecl, BuildError> {
    let what = "[heap.{name}]"
    let heap_keys: Vector<String> = ["len", "slot", "ram"]
    try only_keys(&t, &heap_keys, file, what)
    let len = try size(&t, "len", 8, file, what)
    var slot = DEFAULT_HEAP_SLOT
    if name.equals("default") {
        if t.contains("slot") {
            return refused(file, where_is(&t, "slot"),
                           "[heap.default] has a `slot`: the default heap is slot {DEFAULT_HEAP_SLOT}, the global allocator's, and only a named heap states one")
        }
    } else {
        if not t.contains("slot") {
            return refused(file, at,
                           "[heap.{name}] has no `slot`: a named heap states the slot its program names it by, 1 to {MAX_HEAPS - 1}")
        }
        slot = try count(&t, "slot", file, what)
        if slot == DEFAULT_HEAP_SLOT || slot >= MAX_HEAPS {
            return refused(file, where_is(&t, "slot"),
                           "`slot` in [heap.{name}] is {slot}: a named heap's slot is 1 to {MAX_HEAPS - 1}, below MAX_HEAPS ({MAX_HEAPS}), and slot {DEFAULT_HEAP_SLOT} is [heap.default]'s")
        }
    }
    var fast = false
    if t.contains("ram") {
        let ram = try text(&t, "ram", file)
        if not ram.equals("fast") {
            return refused(file, where_is(&t, "ram"),
                           "`ram` in [heap.{name}] is \"{ram}\": a heap's `ram` is \"fast\", for a pool that must lie in fast memory, or absent")
        }
        fast = true
    }
    return HeapDecl(name: name, slot: slot, len: len, len_at: where_is(&t, "len"), fast: fast,
                    at: at)
}

/// One `[[boot]]` record.
func read_record(r: &TomlTable, file: String) -> Result<BootRecord, BuildError> {
    if r.contains("count") {
        return refused(file, where_is(&r, "count"),
                       "`count` on a [[boot]] record is the list form, which is reserved: a record is one instance")
    }
    let kind_text = try text(&r, "kind", file)
    guard let kind = record_kind(kind_text) else {
        return refused(file, where_is(&r, "kind"),
                       "`kind` in [[boot]] is \"{kind_text}\", not one of \"system\", \"window\", \"line\", \"serve\", \"client\", \"memory\"")
    }
    let what = "a [[boot]] record of kind {kind_text}"
    let known: Vector<String> = match kind {
        case Window -> ["name", "kind", "tag", "type", "part", "rights"],
        case Line -> ["name", "kind", "tag", "type", "rights"],
        case Serve -> ["name", "kind", "tag", "protocol", "rights"],
        case Client -> ["name", "kind", "tag", "protocol", "rights"],
        case System -> ["name", "kind", "tag", "rights"],
        case _ -> ["name", "kind", "tag", "rights"]
    }
    try only_keys(&r, &known, file, what)
    let name = try text(&r, "name", file)
    try check_name(name, file, where_is(&r, "name"), "a record's name")
    let tag = try count(&r, "tag", file, "[[boot]]")
    if is_reserved_tag(tag as UInt) {
        return refused(file, where_is(&r, "tag"),
                       "the tag {hex(tag as UInt64)} of `{name}` is one the runtime reserves, {hex(RESERVED_TAG_FIRST as UInt64)} to {hex(RESERVED_TAG_LAST as UInt64)}, for records it is given itself (the console's, under CONSOLE_TAG): a declaration's tags lie below the range")
    }
    var type_name = ""
    if is_need(kind) {
        type_name = try text(&r, "type", file)
        try check_name(type_name, file, where_is(&r, "type"), "a device type")
    }
    var protocol = ""
    if kind == RecordKind.Serve || kind == RecordKind.Client {
        protocol = try text(&r, "protocol", file)
        try check_name(protocol, file, where_is(&r, "protocol"), "a protocol package's name")
    }
    let part = try flag(&r, "part", false, file)
    var rights: UInt32? = None
    if kind != RecordKind.System && r.contains("rights") {
        rights = try read_record_rights(&r, kind, name, file)
    }
    return BootRecord(name: name, kind: kind, tag: tag, tag_at: where_is(&r, "tag"),
                      type_name: type_name, part: part,
                      protocol: protocol, rights: rights, at: r.defined_at())
}

/// Refuses a tag given twice, not exactly one system record, a name given
/// twice in its family, and two names for one device type.
func check_records(records: &Vector<BootRecord>, file: String, at: TomlPosition) -> Result<Void, BuildError> {
    var systems = 0
    var i = 0
    while i < records.len() {
        let r = records.get(i)!
        if r.kind == RecordKind.System {
            systems = systems + 1
        }
        var j = 0
        while j < i {
            let o = records.get(j)!
            j = j + 1
            if o.tag == r.tag {
                return refused(file, r.at, "the tag {r.tag} is given twice, here and at {o.at}: a tag is unique in a declaration")
            }
            if family(o.kind) == family(r.kind) && o.name.equals(r.name) {
                if is_need(r.kind) && o.kind != r.kind && o.type_name.equals(r.type_name) {
                    continue
                }
                if is_need(r.kind) && o.kind != r.kind {
                    return refused(file, r.at, "the device need `{r.name}` is of the type `{r.type_name}` here and `{o.type_name}` at {o.at}: one need is one device")
                }
                if o.kind != r.kind {
                    return refused(file, r.at, "`{r.name}` names a {kind_word(o.kind)} record at {o.at} and a {kind_word(r.kind)} record here: a serve and a client share one set of names")
                }
                return refused(file, r.at, "`{r.name}` names two {kind_word(r.kind)} records, here and at {o.at}")
            }
            if is_need(r.kind) && is_need(o.kind) && r.type_name.equals(o.type_name) {
                return refused(file, r.at, "`{r.name}` and `{o.name}` (at {o.at}) are two device needs of the type `{r.type_name}`: two devices of one type is the list form, which is reserved")
            }
        }
        i = i + 1
    }
    if systems != 1 {
        return refused(file, at, "the declaration has {systems} system records; a process has exactly one")
    }
    return
}

/// Refuses a declared `handles` below what the process holds when it starts
/// and once its `heaps` heaps have grown.
func check_handles(records: &Vector<BootRecord>, main: Bool, heaps: Int,
                   quota: &Vector<NamedCount>, file: String,
                   at: TomlPosition) -> Result<Void, BuildError> {
    var i = 0
    while i < quota.len() {
        let q = quota.get(i)!
        i = i + 1
        if not q.name.equals("handles") {
            continue
        }
        let floor = handles_at_start(&records, main) + heap_handles(heaps)
        if q.value < floor && heaps > 0 {
            return refused(file, at, "`handles` in [quota] is {q.value}, below the {floor} the process holds once its heaps have grown: one per [[boot]] record, its Process handle, one Mapping per window, its main thread's own Thread handle if it is written with `main`, and {HEAP_HANDLES} for each of its {heaps} heaps (its pool, its Memory and its Mapping) with the one Process handle they map through")
        }
        if q.value < floor {
            if main {
                return refused(file, at, "`handles` in [quota] is {q.value}, below the {floor} the process holds when it starts: one per [[boot]] record, its Process handle, one Mapping per window and its main thread's own Thread handle, which `sosmain`'s start-up holds for a program written with `main`")
            }
            return refused(file, at, "`handles` in [quota] is {q.value}, below the {floor} the process holds when it starts: one per [[boot]] record, its Process handle and one Mapping per window")
        }
    }
    return
}

/// The kinds a `[ceilings]` key may name, for a refusal.
func kinds_listed() -> String {
    let keys = ceiling_keys()
    var out = ""
    var i = 0
    while i < keys.len() {
        if i > 0 {
            out = "{out}, "
        }
        out = "{out}`{keys.get(i) ?? ""}`"
        i = i + 1
    }
    out
}

/// The rights of `info`'s kind, for a refusal.
func rights_listed(info: &CeilingKindInfo) -> String {
    let names = right_names(&info)
    var out = ""
    var i = 0
    while i < names.len() {
        if i > 0 {
            out = "{out}, "
        }
        out = "{out}`{names.get(i) ?? ""}`"
        i = i + 1
    }
    out
}

/// The `rights` of a record of `kind` named `name`: each a right of its kind,
/// as the mask they make.
func read_record_rights(r: &TomlTable, kind: RecordKind, name: String,
                        file: String) -> Result<UInt32, BuildError> {
    let info = ceiling_kind(ceiling_key_of(kind) ?? "")!
    let names = try name_list(&r, "rights", file, "a right's name")
    var i = 0
    while i < names.len() {
        let right = names.get(i) ?? ""
        if not has_right(&info, right) {
            return refused(file, element_at(&r, "rights", i),
                           "`rights` of the {kind_word(kind)} `{name}` names `{right}`, which is not a right of {info.article}: it is one of {rights_listed(&info)}")
        }
        i = i + 1
    }
    return rights_word(&info, &names)
}

/// A `ceilings` table, a declaration's `[ceilings]` or the `ceilings` of an
/// image's process: a kind each key, and the rights its value lists. `scope`
/// says which it is, for a refusal.
public func read_ceilings(c: &TomlTable, file: String,
                          scope: String) -> Result<Vector<CeilingRow>, BuildError> {
    var out = Vector<CeilingRow>()
    let keys = try! c.keys()
    var i = 0
    while i < keys.len() {
        let key = keys.get(i) ?? ""
        i = i + 1
        let at = where_is(&c, key)
        if key.equals("system") {
            return refused(file, at, "`system` in {scope} is not a kind it narrows: a process's System rights are its `system` record's `rights`, which the launch convention bounds")
        }
        guard let info = ceiling_kind(key) else {
            return refused(file, at, "`{key}` in {scope} is not a kind of handle with a rights ceiling: it is one of {kinds_listed()}")
        }
        let names = try name_list(&c, key, file, "a right's name")
        var n = 0
        while n < names.len() {
            let right = names.get(n) ?? ""
            if not has_right(&info, right) {
                return refused(file, element_at(&c, key, n),
                               "`{right}` in {scope} `{key}` is not a right of {info.article}: it is one of {rights_listed(&info)}")
            }
            n = n + 1
        }
        try! out.push(CeilingRow(key: key, rights: rights_word(&info, &names), at: at))
    }
    return move out
}

/// Refuses a record whose `rights` lie outside its kind's ceiling: the one
/// `[ceilings]` states, else the default, every right but the opt-in ones
/// (`has_ceilings` says which).
func check_record_rights(records: &Vector<BootRecord>, ceilings: &Vector<CeilingRow>,
                         has_ceilings: Bool, file: String) -> Result<Void, BuildError> {
    var i = 0
    while i < records.len() {
        let r = records.get(i)!
        i = i + 1
        guard let own = r.rights else {
            continue
        }
        let key = ceiling_key_of(r.kind) ?? ""
        let info = ceiling_kind(key)!
        var ceiling: UInt32 = KEEP_ALL & ~opt_in_word(&info)
        if has_ceilings {
            ceiling = 0
        }
        var k = 0
        while k < ceilings.len() {
            let row = ceilings.get(k)!
            if row.key.equals(key) {
                ceiling = row.rights
            }
            k = k + 1
        }
        let outside = own & ~ceiling
        if outside != 0 {
            let names = names_in(&info, outside)
            let first = names.get(0) ?? ""
            if is_opt_in(first) && not has_ceilings {
                return refused(file, r.at,
                               "`rights` of the {kind_word(r.kind)} `{r.name}` names `{first}`, an opt-in right, which `{key}` in [ceilings] must ask for first")
            }
            return refused(file, r.at,
                           "`rights` of the {kind_word(r.kind)} `{r.name}` names `{first}`, which the `{key}` ceiling in [ceilings] does not give: a record is given within its kind's ceiling")
        }
    }
    return
}

/// Refuses `ceilings`, which `scope` names in the refusal, when they withhold
/// a right the program's runtime spends, naming the right and its use: `main`
/// says the program is written with `main` (`sosmain`), and `heaps` how many
/// heaps it has. The runtime reads its Process handle's and its heaps' rights
/// at its start, and spends the rest on the first growth of a heap.
func check_runtime(ceilings: &Vector<CeilingRow>, main: Bool, heaps: Int, file: String,
                   at: TomlPosition, scope: String) -> Result<Void, BuildError> {
    if main {
        let own = "`sosmain`'s start-up"
        try needs(&ceilings, "process", "boot-handles", "{own} drains the boot set through its Process handle", file, at, scope)
        try needs(&ceilings, "process", "thread-self", "{own} derives the main thread's own Thread handle through its Process handle", file, at, scope)
        try needs(&ceilings, "process", "exit", "{own} ends the process through its Process handle", file, at, scope)
        try needs(&ceilings, "thread", "control", "{own} yields through the main thread's own Thread handle", file, at, scope)
    }
    if heaps > 0 {
        let own = "the runtime's heap"
        try needs(&ceilings, "process", "boot-handles", "{own} is adopted while the boot set is drained, which a Process handle without it cannot do", file, at, scope)
        try needs(&ceilings, "process", "mint", "{own} mints its `Map`-only Process handle from the process's own", file, at, scope)
        try needs(&ceilings, "process", "map", "{own} maps its memory through that Process handle", file, at, scope)
        try needs(&ceilings, "memory", "map", "{own} maps the `Memory` it cuts from its pool", file, at, scope)
        try needs(&ceilings, "memory", "extend", "{own} extends the `Memory` it cuts from its pool", file, at, scope)
        try needs(&ceilings, "mapping", "grow", "{own} grows its row", file, at, scope)
        try needs(&ceilings, "mapping", "base", "{own} reads where its row landed", file, at, scope)
        let pool = "the launch convention gives a heap's pool with it, and the runtime's heap reads it at its adoption"
        try needs(&ceilings, "pool", "allocate", pool, file, at, scope)
        try needs(&ceilings, "pool", "map", pool, file, at, scope)
        try needs(&ceilings, "pool", "transfer", pool, file, at, scope)
        try needs(&ceilings, "pool", "mint", pool, file, at, scope)
        try needs(&ceilings, "pool", "extend", pool, file, at, scope)
    }
    return
}

/// Refuses `ceilings` unless the `right` of `key`'s kind is in it, for the
/// `use` the runtime has for it.
func needs(ceilings: &Vector<CeilingRow>, key: String, right: String, use: String,
           file: String, at: TomlPosition, scope: String) -> Result<Void, BuildError> {
    let info = ceiling_kind(key)!
    let want = right_word(&info, right) ?? 0
    var i = 0
    while i < ceilings.len() {
        let row = ceilings.get(i)!
        i = i + 1
        if row.key.equals(key) {
            if (row.rights & want) == 0 {
                return refused(file, row.at,
                               "`{key}` in {scope} lacks `{right}`: {use}")
            }
            return
        }
    }
    return refused(file, at,
                   "{scope} lists no `{key}`, which gives it no rights, and the process needs `{right}`: {use}")
}
