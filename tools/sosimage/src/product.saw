//! An image built from its hand-written description (`sosimage.imagefile`),
//! the board it names (`sosimage.board`) and, for the stock root, its
//! processes' declarations (`sosimage.declaration`).
//!
//! The board is the one whose `board.toml`, in a directory under the sawos
//! tree's `hal/`, has the image's `board` as its name. It is held to the
//! profile and its HAL (`sosimage.boardcheck`) before the image is read.
//! The kernel is compiled at the build keys the image's `[keys]` states
//! (`keyed_profile`), and an image that states any prints them before
//! anything is built, in the order it states them:
//!
//!     keys NAME=VALUE ...
//!
//! A package is `sawos:PATH` in the sawos tree, or a path from the product's
//! root. The builder builds every process's package itself, each instance
//! its own link named for its process (`sosimage.package`), at the addresses
//! it assigns (`sosimage.layout`): root's region is the HAL's and root's
//! slot the board's; each other process is linked once where it would go
//! first, its RAM measured from that link, and linked again where the
//! regions put it when that is elsewhere. A process whose package has a
//! `process.toml` that declares `ram = "fast"` is placed in a fast range, or
//! refused by name on a board with none (`declares_fast`, `choose_range`); a
//! hand-written root's process names no range, and no other part of its
//! declaration is read. Every address is printed, a line per process, per
//! pool and per heap's pool:
//!
//!     process NAME region=BASE+LEN slot=BASE+LEN
//!     pool NAME region=BASE+LEN
//!     heap PROCESS.HEAP region=BASE+LEN
//!
//! `slot` only on an in-place board. An image with more processes besides
//! root than the board has slots is refused before anything is built, and a
//! region or a pool that runs past its range once the processes are measured,
//! naming it and the range, before the kernel is compiled. A heap's pool is
//! placed after the image's pools, in its range (`sosimage.imagefile.bind`).
//! On a board that translates, a process's region and its heaps' pools are
//! held to the space its rows have above its link address
//! (`sosimage.layout.check_window`).
//!
//! A hand-written root's region table's rows are, in order: one image blob per
//! process, one destination per process (its region), then `[rows] devices`,
//! then `[rows] pools`, each its pool's region (`image_rows`). The image's `[limits]` over the board's
//! `[limits.default]`, each a total, become the slots each kind is raised by
//! above the kernel's floor; a total below the floor is refused, since an
//! image raises and never lowers.
//!
//! An image with the stock root reads every process's declaration and binds
//! it (`sosimage.imagefile.bind`), which places each process in a range, and
//! prints what binding found. Its plan (`sosimage.plan`) is checked against
//! the kernel, which is compiled first for its numbers, before any package is
//! built. Each process is linked with its built-in heap (`process_arena`) and
//! its inputs: each input's file, from the image's root, the board's HAL
//! directory or the package's directory by where its value came from, is
//! the module of its name (`OUT/NAME.inputs/INPUT/lib.saw`). The stock root
//! (`root/`) is linked with the plan written as its module `imageplan`
//! (`OUT/root.imageplan/`). The region table's rows are the plan's: an image
//! blob and a destination per process, then its device rows, then its pools',
//! then its heaps' pools.
//!
//! On a board that runs an image in place and whose protection grain is
//! coarser than 16 bytes, each child's blob is placed on and padded to the
//! grain, since a root maps an image it runs in place (`blob_align`).

import std.directory.{Directory}
import std.file.{File}
import std.path.{Path}
import sosimage.board.{Board, LimitsSpec, NamedCount, Span}
import sosimage.boardcheck.{HalFacts, check_board, hal_facts}
import sosimage.build.{Linked, build_kernel, ensure_directory, link}
import sosimage.flash.{load_segments}
import sosimage.layout.{Ask, Placement, check_window, child_slots, choose_range,
                        first_placement, place, ram_span, region_align}
import sosimage.package.{Extras, ModulePath, build_process, stock_root_extras, write_input}
import sosimage.plan.{ImagePlan, PlanSlabs, check_plan, plan_image, quota_of}
import sosimage.declaration.{Declaration}
import sosimage.failure.{BuildError}
import sosimage.hex.{hex}
import sosimage.image.{BLOB_ALIGN, FlashOutput, ImageSpec, RowSpec}
import sosimage.imagefile.{Bindings, ImageFile, InputSource, ProcessEntry, bind, image_board}
import sosimage.kernel.{
    ATTACHMENTS, EVENTS, INTERRUPTS, IOMEMORIES, KernelFacts, MAPPINGS, MEMORIES,
    PIPES, PROCESSES, PROCESS_RECORDS, QUOTA_KINDS, THREADS, TIMERS, WAITERS,
}
import sosimage.limits.{ImageLimits, plan_limits}
import sosimage.profile.{Profile}
import sosimage.regions.{BOOT_FLAG_NO_TICK, RegionKind}
import sosimage.tool.{read_file, read_text}

/// The built-in heap a process is linked with when neither its declaration
/// nor its image sizes it: the user scripts' own default, which the builder
/// writes rather than leaves to the script.
public static DEFAULT_ARENA: UInt64 = 0x1000

/// The board under `<sawos>/hal/` whose description names `name`.
public func find_board(sawos: String, name: String) -> Result<Board, BuildError> {
    let hal = "{sawos}/hal"
    var entries = try Directory.list(Path(s: hal)) catch {
        return BuildError(message: "could not list {hal}: {error}")
    }
    var dirs = Vector<String>()
    var i = 0
    while i < entries.len() {
        try! dirs.push((entries.get(i)!).as_string())
        i = i + 1
    }
    dirs.sort()
    var names = Vector<String>()
    i = 0
    while i < dirs.len() {
        let file = "{dirs.get(i) ?? ""}/board.toml"
        i = i + 1
        if not File.exists(Path(s: file)) {
            continue
        }
        let board = try Board.parse(try read_text(file), file)
        if board.name.equals(name) {
            return move board
        }
        try! names.push(board.name)
    }
    return BuildError(message: "no board.toml under {hal} names the board {name}; the boards are {names.join(", ")}")
}

/// The directory a package path names: `sawos:PATH` in the sawos tree, or a
/// path from the product's root.
public func package_dir(package: String, sawos: String, product: String) -> String {
    if package.starts_with("sawos:") {
        return "{sawos}/{package.substring(6, package.len())}"
    }
    "{product}/{package}"
}

/// The declarations of a stock-root image's processes, in its order: each
/// package's `process.toml`, read with the `Saw.toml` beside it
/// (`Declaration.load`), each package from the product's root `product`.
public func image_declarations(image: &ImageFile, sawos: String,
                               product: String) -> Result<Vector<Declaration>, BuildError> {
    var decls = Vector<Declaration>()
    var i = 0
    while i < image.processes.len() {
        let process = image.processes.get(i)!
        i = i + 1
        let file = "{package_dir(process.package, sawos, product)}/process.toml"
        try! decls.push(try Declaration.load(file))
    }
    return move decls
}

/// The `SlabKind` a `[limits]` key totals.
func slab_of(key: String) -> Int {
    if key.equals("processes") { return PROCESSES }
    if key.equals("threads") { return THREADS }
    if key.equals("events") { return EVENTS }
    if key.equals("waiters") { return WAITERS }
    if key.equals("interrupts") { return INTERRUPTS }
    if key.equals("timers") { return TIMERS }
    if key.equals("memories") { return MEMORIES }
    if key.equals("iomemories") { return IOMEMORIES }
    if key.equals("pipes") { return PIPES }
    if key.equals("records") { return PROCESS_RECORDS }
    if key.equals("attachments") { return ATTACHMENTS }
    MAPPINGS
}

/// The limits `stated` (the board's defaults, then the image's over them)
/// come to against the kernel `facts`: each total as the slots it raises its
/// kind by, each quota as stated. A total below its floor is refused.
public func image_limits(stated: &Vector<LimitsSpec>, facts: &KernelFacts,
                         name: String) -> Result<ImageLimits, BuildError> {
    var limits = ImageLimits.none()
    var s = 0
    while s < stated.len() {
        borrow let spec = stated[s] {
            var i = 0
            while i < spec.totals.len() {
                let total = spec.totals.get(i)!
                i = i + 1
                let kind = slab_of(total.name)
                let floor = facts.floors.get(kind) ?? 0
                if total.value < floor {
                    return BuildError(message: "{name}: `{total.name}` is {total.value}, below the kernel's floor of {floor}: an image raises a limit and never lowers one")
                }
                limits.raise[kind] = total.value - floor
            }
            var q = 0
            while q < spec.quota.len() {
                let quota = spec.quota.get(q)!
                q = q + 1
                limits.quota[quota_of(quota.name)] = quota.value
            }
        }
        s = s + 1
    }
    return move limits
}

/// What the board's `[limits.default]` comes to against the kernel `facts`:
/// the limits an image that states none of its own is given, each total as
/// the slots it raises its kind by, each quota as stated. They are planned as
/// such an image's would be (`sosimage.limits.plan_limits`), so a default
/// below its floor or breaking a derivation (a derived total below it, a
/// quota default at or past its bound, more bodies than the domain pool) is
/// refused here, naming the file. A board with no `[limits.default]` states
/// nothing, and an image on it that states nothing carries no limits at all
/// (`Board.has_limits`).
public func board_defaults(board: &Board, facts: &KernelFacts) -> Result<ImageLimits, BuildError> {
    let what = "{board.file}: [limits.default]"
    var stated = Vector<LimitsSpec>()
    try! stated.push(board.limits.copy())
    let limits = try image_limits(&stated, &facts, what)
    let _ = try plan_limits(&facts, &limits, what, 0, 0)
    return move limits
}

/// Builds the image the description at `path` states, for the board its
/// profile is, into `out`: each process's package as the module's header
/// lays out (`sosimage.package`, root's as `root`), `<out>/kernel-main.o`,
/// then `<out>/<name>.elf` and, for a board with a flash,
/// `<out>/<name>.flash.bin`; the generated files go in `<out>/<name>.image/`.
/// A board image (`for_board`) is linked with the profile's
/// `board_link_args` after the image's own (`sosimage.board_image`).
public func build_image(profile: &Profile, sawos: String, product: String, path: String,
                        out: String, for_board: Bool) -> Result<Linked, BuildError> {
    let text = try read_text(path)
    let board_name = try image_board(text, path)
    let board = try find_board(sawos, board_name)
    try ensure_directory(out)
    let facts = try hal_facts(&profile, "{out}/hal")
    try check_board(&board, &profile, &facts, sawos)
    let image = try ImageFile.parse(text, path, &board, facts.grain)
    // Everything below is built at the image's build keys.
    let profile = try keyed_profile(&profile, &board, &image)
    if image.keys.len() > 0 {
        print(key_line(&image))
    }

    // Every refusal that needs no build, before anything is built.
    let count = image.processes.len()
    var slots = Vector<Span>()
    var root_slot: Span? = None
    if let flash = board.flash {
        slots = try child_slots(flash.slots, flash.slot_count, count, path)
        root_slot = flash.root_slot
    }
    let align = region_align(facts.grain, board.placement)
    let root_region = Span(base: facts.root_base, len: facts.root_top - facts.root_base)
    let stack = facts.stack_len
    var stated = Vector<LimitsSpec>()
    if board.has_limits {
        try! stated.push(board.limits.copy())
    }
    if image.has_limits {
        try! stated.push(image.limits.copy())
    }

    let kernel = "{out}/kernel-main.o"
    var limits = ImageLimits.none()
    var extras = Vector<Extras>()
    var root_extras = Extras.none()
    var plan_rows = Vector<RowSpec>()
    var root_dir = ""
    var heap_asks = Vector<Ask>()
    var heap_bytes = Vector<UInt64>()
    if image.stock {
        let decls = try image_declarations(&image, sawos, product)
        let bound = try bind(&image, &board, &decls, facts.grain)
        var n = 0
        while n < bound.notes.len() {
            print(bound.notes.get(n) ?? "")
            n = n + 1
        }
        let plan = try plan_image(&image, &board, &decls, &bound, facts.grain)

        // The plan's checks need the kernel's numbers.
        try build_kernel(&profile, "{sawos}/kernel/main.saw", kernel)
        let kernel_facts = try KernelFacts.read(kernel)
        if stated.len() > 0 {
            limits = try image_limits(&stated, &kernel_facts, image.name)
        }
        let defaults = quota_defaults(&limits, &kernel_facts)
        let slabs = plan_slabs(&limits, &kernel_facts)
        try check_plan(&plan, &kernel_facts, &defaults, &slabs, path)

        var i = 0
        while i < count {
            let process = image.processes.get(i)!
            borrow let d = decls[i] {
                try! extras.push(try process_extras(&d, &bound, &board, process.name,
                                                    process_arena(&d, &image), sawos,
                                                    product, out))
            }
            var bytes: UInt64 = 0
            var h = 0
            while h < bound.heaps.len() {
                let b = bound.heaps.get(h)!
                h = h + 1
                if b.process.equals(process.name) {
                    bytes = bytes + b.heap.len
                    try! heap_asks.push(Ask(name: "{b.process}.{b.heap.name}", range: b.range,
                                            bytes: b.heap.len, pool: true, at: process.at))
                }
            }
            try! heap_bytes.push(bytes)
            i = i + 1
        }
        root_extras = try stock_root_extras(&plan, profile.word_bytes, out, "root", image.name)
        plan_rows = stock_rows(&plan)
        root_dir = "{sawos}/root"
    } else {
        var i = 0
        while i < count {
            try! extras.push(Extras.none())
            i = i + 1
        }
        root_dir = package_dir(image.root_package, sawos, product)
    }

    let root = try build_process(&profile, "root", root_dir, out,
                                 &Placement(region: root_region, stack: stack, slot: root_slot),
                                 &root_extras)

    // Each process linked where it would go first, and measured.
    var asks = Vector<Ask>()
    var firsts = Vector<Placement>()
    var i = 0
    while i < count {
        let process = image.processes.get(i)!
        let range_name = try process_range(&board, &process, package_dir(process.package, sawos, product),
                                           path)
        let first = try first_placement(&board, root_region, align, stack, range_name,
                                        slots.get(i), process.name, path, process.at)
        borrow let x = extras[i] {
            let built = try build_process(&profile, process.name, package_dir(process.package, sawos, product),
                                          out, &first, &x)
            let elf = try read_file(built.elf)
            let segments = try load_segments(&elf, built.elf)
            let bytes = try ram_span(&segments, board.placement, "the process {process.name}'s image {built.elf}")
            try! asks.push(Ask(name: process.name, range: range_name, bytes: bytes, pool: false,
                               at: process.at))
        }
        try! firsts.push(first)
        i = i + 1
    }
    var p = 0
    while p < image.pools.len() {
        let pool = image.pools.get(p)!
        p = p + 1
        let range_name = if pool.ram.is_empty() { board.default_pool } else { pool.ram }
        try! asks.push(Ask(name: pool.name, range: range_name, bytes: pool.len, pool: true,
                           at: pool.at))
    }
    try! asks.append(&heap_asks)
    let regions = try place(&board, root_region, align, stack, &asks, path)
    try check_windows(&board, &facts, &image, &regions, &heap_bytes, path)

    // Each process linked again where its region is, unless that is where it
    // was first linked; a translated board links every image at one base.
    var children = Vector<String>()
    i = 0
    while i < count {
        let process = image.processes.get(i)!
        let region = regions.get(i)!
        let final_ = Placement(region: region, stack: stack, slot: slots.get(i))
        let first = firsts.get(i)!
        var line = "process {process.name} region={hex(region.base)}+{hex(region.len)}"
        if let slot = final_.slot {
            line = "{line} slot={hex(slot.base)}+{hex(slot.len)}"
        }
        print(line)
        if not board.placement.equals("translated") && region.base != first.region.base {
            borrow let x = extras[i] {
                let _ = try build_process(&profile, process.name, package_dir(process.package, sawos, product),
                                          out, &final_, &x)
            }
        }
        try! children.push("{out}/{process.name}.sosimg")
        i = i + 1
    }
    p = 0
    while p < image.pools.len() {
        let region = regions.get(count + p)!
        print("pool {(image.pools.get(p)!).name} region={hex(region.base)}+{hex(region.len)}")
        p = p + 1
    }
    var h = 0
    while h < heap_asks.len() {
        let region = regions.get(count + image.pools.len() + h)!
        print("heap {(heap_asks.get(h)!).name} region={hex(region.base)}+{hex(region.len)}")
        h = h + 1
    }

    var rows = Vector<RowSpec>()
    if image.stock {
        rows = stock_region_rows(&image, &plan_rows, &regions)
    } else {
        rows = image_rows(&image, &regions)
        try build_kernel(&profile, "{sawos}/kernel/main.saw", kernel)
        if stated.len() > 0 {
            let kernel_facts = try KernelFacts.read(kernel)
            limits = try image_limits(&stated, &kernel_facts, image.name)
        }
    }

    var spec = described_spec(&image, kernel, out, root.image, move children, move rows,
                              stated.len() > 0, move limits, profile.flash != None,
                              facts.grain, board.placement)
    if for_board {
        var a = 0
        while a < profile.board_link_args.len() {
            try! spec.link_args.push(profile.board_link_args.get(a) ?? "")
            a = a + 1
        }
    }
    link(&profile, &spec)
}

/// Refuses, on a board that translates, a process of `image` whose region in
/// `regions` and heaps' pools of `heap_bytes` bytes (both by process, in image
/// order) pass the space its rows have above its link address: from root's
/// region's base, where every process links, to `USER_RAM_TOP`, the end of
/// the window its rows lie in (`sosimage.layout.check_window`). On any other
/// board a row lies at its own bytes' address, which `place` holds.
public func check_windows(board: &Board, facts: &HalFacts, image: &ImageFile,
                          regions: &Vector<Span>, heap_bytes: &Vector<UInt64>,
                          file: String) -> Result<Void, BuildError> {
    if not board.placement.equals("translated") {
        return
    }
    var i = 0
    while i < heap_bytes.len() {
        let process = image.processes.get(i)!
        try check_window(process.name, (regions.get(i)!).len, heap_bytes.get(i) ?? 0,
                         facts.user_ram_top - facts.root_base, file, process.at)
        i = i + 1
    }
    return
}

/// `profile` with the module of each build key `image` states mapped to the
/// directory of the value it states (`sosimage.board.BuildKey`), from the
/// board's HAL directory as `board` names it; a module whose key the image
/// does not state keeps the profile's directory.
public func keyed_profile(profile: &Profile, board: &Board,
                          image: &ImageFile) -> Result<Profile, BuildError> {
    var out = profile.copy()
    var k = 0
    while k < image.keys.len() {
        let choice = image.keys.get(k)!
        k = k + 1
        guard let key = board.key(choice.key) else {
            return BuildError(message: "{image.file}: internal: the build key {choice.key} is not the board {board.name}'s")
        }
        var mapped = false
        var p = 0
        while p < out.module_paths.len() {
            if (out.module_paths.get(p) ?? "").starts_with("{key.module}=") {
                out.module_paths[p] = "{key.module}={board.dir}/{key.prefix}{choice.value}"
                mapped = true
            }
            p = p + 1
        }
        if not mapped {
            return BuildError(message: "{image.file}: internal: the profile maps no module {key.module}")
        }
    }
    return move out
}

/// The line `sosimage build` prints for an image that states build keys:
/// `keys NAME=VALUE ...`, in the order `[keys]` states them.
public func key_line(image: &ImageFile) -> String {
    var parts = Vector<String>()
    var k = 0
    while k < image.keys.len() {
        let choice = image.keys.get(k)!
        try! parts.push("{choice.key}={choice.value}")
        k = k + 1
    }
    "keys {parts.join(" ")}"
}

/// The image description `link` reads for the image `image` describes, built
/// into `out` from the kernel object `kernel`, root's image, the children's
/// and the region table's `rows`, with its limits when `has_limits`, a flash
/// image when `flash`, and each child's blob placed as a board whose grain is
/// `grain` and whose placement is `placement` needs (`blob_align`).
public func described_spec(image: &ImageFile, kernel: String, out: String, root_image: String,
                           children: Vector<String>, rows: Vector<RowSpec>, has_limits: Bool,
                           limits: ImageLimits, flash: Bool, grain: UInt64,
                           placement: String) -> ImageSpec {
    var written: FlashOutput? = None
    if flash {
        written = FlashOutput(output: "{out}/{image.name}.flash.bin", check: true)
    }
    ImageSpec(name: image.name, kernel: kernel, staging: "{out}/{image.name}.image",
              output: "{out}/{image.name}.elf", asm: "", child_asm: "",
              root_image: root_image, children: move children, has_regions: true,
              flags: if image.tick { 0 } else { BOOT_FLAG_NO_TICK }, rows: move rows,
              has_limits: has_limits, limits: move limits, link_args: Vector<String>(),
              flash: written, blob_align: blob_align(grain, placement))
}

/// The quota rows an image's children start with, by `QuotaKind` value:
/// each one its limits (the board's defaults, then its own) state, else the
/// kernel's compiled one.
public func quota_defaults(limits: &ImageLimits, facts: &KernelFacts) -> Vector<Int> {
    var out = Vector<Int>()
    var q = 0
    while q < QUOTA_KINDS {
        let stated = limits.quota.get(q) ?? -1
        try! out.push(if stated >= 0 { stated } else { facts.defaults.get(q) ?? 0 })
        q = q + 1
    }
    move out
}

/// The objects an image's slabs hold of each kind a stock root's plan makes
/// (`sosimage.plan.PlanSlabs`), each its slab's total (`slab_total`).
public func plan_slabs(limits: &ImageLimits, facts: &KernelFacts) -> PlanSlabs {
    PlanSlabs(processes: slab_total(&limits, &facts, PROCESSES),
              pipes: slab_total(&limits, &facts, PIPES),
              interrupts: slab_total(&limits, &facts, INTERRUPTS),
              iomemories: slab_total(&limits, &facts, IOMEMORIES),
              memories: slab_total(&limits, &facts, MEMORIES))
}

/// How many objects an image's slab of `kind` (a `SlabKind` value) holds:
/// the kernel's floor, raised by its limits.
public func slab_total(limits: &ImageLimits, facts: &KernelFacts, kind: Int) -> Int {
    let floor = facts.floors.get(kind) ?? 0
    let raised = limits.raise.get(kind) ?? -1
    if raised > 0 { floor + raised } else { floor }
}

/// What a child's blob is placed on and padded to on a board whose grain is
/// `grain` and whose `placement` is the board's: the grain on a board that
/// runs an image in place, where a blob is mapped and a mapping covers whole
/// grains, when that is coarser than 16 bytes; 16 bytes otherwise.
public func blob_align(grain: UInt64, placement: String) -> Int {
    let g = grain as Int
    if placement.equals("in-place") && g > BLOB_ALIGN {
        return g
    }
    BLOB_ALIGN
}

/// The built-in heap a stock-root process whose declaration is `d` is linked
/// with in `image`: its declaration's `arena`, else the image's, else
/// `DEFAULT_ARENA`.
public func process_arena(d: &Declaration, image: &ImageFile) -> UInt64 {
    if let own = d.arena {
        return own
    }
    image.arena ?? DEFAULT_ARENA
}

/// What a stock-root process's build takes beyond its placement: its built-in
/// heap of `arena` bytes (`process_arena`), and each of its inputs as a
/// module, the file its value names copied to `OUT/NAME.inputs/INPUT/lib.saw`.
/// An image's value is a path from `product`, a device's from the board's HAL
/// directory in `sawos`, and a driver's default from its package's directory.
public func process_extras(d: &Declaration, bound: &Bindings, board: &Board, process: String,
                           arena: UInt64, sawos: String, product: String,
                           out: String) -> Result<Extras, BuildError> {
    var modules = Vector<ModulePath>()
    var i = 0
    while i < bound.inputs.len() {
        let value = bound.inputs.get(i)!
        i = i + 1
        if not value.process.equals(process) {
            continue
        }
        let from = input_path(value.source, value.path, d.dir, board.hal, sawos, product)
        try! modules.push(try write_input(out, process, value.input, from))
    }
    return Extras(arena: arena, modules: move modules)
}

/// Where an input's value `path` is, by where it came from: an image's from
/// the product's root, a device's from the board's HAL directory (`hal`, a
/// path in the sawos tree), a driver's from its package's directory (`dir`).
public func input_path(source: InputSource, path: String, dir: String, hal: String,
                       sawos: String, product: String) -> String {
    match source {
        case Image -> "{product}/{path}",
        case Board -> "{sawos}/{hal}/{path}",
        case Driver -> "{dir}/{path}"
    }
}

/// The rows after the blobs and destinations, as `plan` lays them out: a pool
/// row's base and length are its region's, filled in once the pools are
/// placed.
func stock_rows(plan: &ImagePlan) -> Vector<RowSpec> {
    var rows = Vector<RowSpec>()
    var r = 0
    while r < plan.rows.len() {
        let row = plan.rows.get(r)!
        let what = if row.kind != RegionKind.Pool { "{row.what}'s window" } else if row.heap.is_empty() {
            row.pool
        } else {
            row.heap
        }
        try! rows.push(RowSpec(what: what, kind: row.kind, blob: None, base: row.base,
                               len: row.len))
        r = r + 1
    }
    move rows
}

/// A stock-root image's region table: an image blob and a destination per
/// process, each process's region in `regions`, then the plan's `rows`
/// (`stock_rows`), each pool row its region: the pools' regions follow the
/// processes' in `regions`, in the order of the pool rows, the image's pools'
/// and then the heaps'.
public func stock_region_rows(image: &ImageFile, rows: &Vector<RowSpec>,
                              regions: &Vector<Span>) -> Vector<RowSpec> {
    var out = blob_and_destination_rows(&image, &regions)
    var pools = 0
    var r = 0
    while r < rows.len() {
        var row = rows.get(r)!
        if row.kind == RegionKind.Pool {
            let region = regions.get(image.processes.len() + pools)!
            row.base = region.base
            row.len = region.len
            pools = pools + 1
        }
        try! out.push(row)
        r = r + 1
    }
    move out
}

/// The index of the pool `name` among the image's pools.
func pool_index(image: &ImageFile, name: String) -> Int {
    var k = 0
    while k < image.pools.len() && not (image.pools.get(k)!).name.equals(name) {
        k = k + 1
    }
    k
}

/// The range a hand-written root's process is placed in: the one its image
/// names, else one its package's declaration allows (`declares_fast`,
/// `choose_range`); `dir` is the package's directory and `file` the image's.
public func process_range(board: &Board, process: &ProcessEntry, dir: String,
                          file: String) -> Result<String, BuildError> {
    let fast = try declares_fast(dir)
    choose_range(&board, process.ram, fast, process.name, file, process.at)
}

/// Whether the package in `dir` declares `ram = "fast"` in a `process.toml`
/// beside its manifest; a package with none declares nothing.
public func declares_fast(dir: String) -> Result<Bool, BuildError> {
    let file = "{dir}/process.toml"
    if not File.exists(Path(s: file)) {
        return false
    }
    let d = try Declaration.parse(try read_text(file), file)
    return d.fast
}

/// A hand-written root's region table, from its image and the `regions`
/// placed for it (each process's, in order, then each pool's): an image blob
/// per process, a destination per process, then `[rows] devices`, then
/// `[rows] pools`, each pool's row its own region.
public func image_rows(image: &ImageFile, regions: &Vector<Span>) -> Vector<RowSpec> {
    var rows = blob_and_destination_rows(&image, &regions)
    var i = 0
    while i < image.row_devices.len() {
        let row = image.row_devices.get(i)!
        try! rows.push(RowSpec(what: "{row.window.device}'s window", kind: RegionKind.Device,
                               blob: None, base: row.window.base, len: row.window.len))
        i = i + 1
    }
    i = 0
    while i < image.row_pools.len() {
        let name = image.row_pools.get(i) ?? ""
        i = i + 1
        let region = regions.get(image.processes.len() + pool_index(&image, name))!
        try! rows.push(RowSpec(what: "the pool {name}", kind: RegionKind.Pool,
                               blob: None, base: region.base, len: region.len))
    }
    move rows
}

/// An image blob per process, then a destination per process, each its
/// region in `regions`.
func blob_and_destination_rows(image: &ImageFile, regions: &Vector<Span>) -> Vector<RowSpec> {
    let count = image.processes.len()
    var rows = Vector<RowSpec>()
    var i = 0
    while i < count {
        let process = image.processes.get(i)!
        try! rows.push(RowSpec(what: "{process.name}'s image blob", kind: RegionKind.Ram,
                               blob: i, base: 0, len: 0))
        i = i + 1
    }
    i = 0
    while i < count {
        let process = image.processes.get(i)!
        let region = regions.get(i)!
        try! rows.push(RowSpec(what: "{process.name}'s destination RAM", kind: RegionKind.Ram,
                               blob: None, base: region.base, len: region.len))
        i = i + 1
    }
    move rows
}
