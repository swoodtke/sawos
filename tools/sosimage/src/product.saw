//! An image built from its hand-written description (`sosimage.imagefile`),
//! the board it names (`sosimage.board`) and, for the stock root, its
//! processes' declarations (`sosimage.declaration`).
//!
//! The board is the one whose `board.toml`, in a directory under the sawos
//! tree's `hal/`, has the image's `board` as its name. It is held to the
//! profile and its HAL (`sosimage.boardcheck`) before the image is read.
//!
//! A package is `sawos:PATH` in the sawos tree, or a path from the product's
//! root. The builder builds every process's package itself, each instance
//! its own link named for its process (`sosimage.package`), at the addresses
//! it assigns (`sosimage.layout`): root's region is the HAL's and root's
//! slot the board's; each other process is linked once where it would go
//! first, its RAM measured from that link, and linked again where the
//! regions put it when that is elsewhere. A process whose package has a
//! `process.toml` that declares `ram = "fast"` is placed in a fast range, or
//! refused by name on a board with none (`declares_fast`, `choose_range`); a
//! hand-written root's process names no range, and no other part of its
//! declaration is read. Every address is printed, a line per process and per
//! pool:
//!
//!     process NAME region=BASE+LEN slot=BASE+LEN
//!     pool NAME region=BASE+LEN
//!
//! `slot` only on an in-place board. An image with more processes besides
//! root than the board has slots is refused before anything is built, and a
//! region or a pool that runs past its range once the processes are measured,
//! naming it and the range, before the kernel is compiled.
//!
//! A hand-written root's region table's rows are, in order: one image blob per
//! process, one destination per process (its region), then `[rows] devices`,
//! then `[rows] pools`, each its pool's region (`image_rows`). The image's `[limits]` over the board's
//! `[limits.default]`, each a total, become the slots each kind is raised by
//! above the kernel's floor; a total below the floor is refused, since an
//! image raises and never lowers.
//!
//! An image with the stock root is read and bound, which places each process
//! in a range (`bind`), and what binding found is printed; building it is
//! refused, since the stock root is not part of this builder.

import std.directory.{Directory}
import std.file.{File}
import std.path.{Path}
import sosimage.board.{Board, LimitsSpec, NamedCount, Span}
import sosimage.boardcheck.{HalFacts, check_board, hal_facts}
import sosimage.build.{Linked, build_kernel, ensure_directory, link}
import sosimage.flash.{load_segments}
import sosimage.layout.{Ask, Placement, child_slots, choose_range, first_placement, place,
                        ram_span, region_align}
import sosimage.package.{build_process}
import sosimage.declaration.{Declaration}
import sosimage.failure.{BuildError}
import sosimage.hex.{hex}
import sosimage.image.{FlashOutput, ImageSpec, RowSpec}
import sosimage.imagefile.{ImageFile, ProcessEntry, bind, image_board}
import sosimage.kernel.{
    ATTACHMENTS, EVENTS, INTERRUPTS, IOMEMORIES, KernelFacts, MAPPINGS, MEMORIES,
    PIPES, PROCESSES, PROCESS_RECORDS, THREADS, TIMERS, WAITERS,
}
import sosimage.limits.{ImageLimits, plan_limits}
import sosimage.profile.{Profile}
import sosimage.regions.{BOOT_FLAG_NO_TICK, RegionKind}
import sosimage.tool.{read_file, read_text}

/// The board under `<sawos>/hal/` whose description names `name`.
public func find_board(sawos: String, name: String) -> Result<Board, BuildError> {
    let hal = "{sawos}/hal"
    var entries = try Directory.list(Path(s: hal)) catch {
        return BuildError(message: "could not list {hal}: {error}")
    }
    var dirs = Vector<String>()
    var i = 0
    while i < entries.len() {
        try! dirs.push((entries.get(i)!).as_string())
        i = i + 1
    }
    dirs.sort()
    var names = Vector<String>()
    i = 0
    while i < dirs.len() {
        let file = "{dirs.get(i) ?? ""}/board.toml"
        i = i + 1
        if not File.exists(Path(s: file)) {
            continue
        }
        let board = try Board.parse(try read_text(file), file)
        if board.name.equals(name) {
            return move board
        }
        try! names.push(board.name)
    }
    return BuildError(message: "no board.toml under {hal} names the board {name}; the boards are {names.join(", ")}")
}

/// The directory a package path names: `sawos:PATH` in the sawos tree, or a
/// path from the product's root.
public func package_dir(package: String, sawos: String, product: String) -> String {
    if package.starts_with("sawos:") {
        return "{sawos}/{package.substring(6, package.len())}"
    }
    "{product}/{package}"
}

/// The `SlabKind` a `[limits]` key totals.
func slab_of(key: String) -> Int {
    if key.equals("processes") { return PROCESSES }
    if key.equals("threads") { return THREADS }
    if key.equals("events") { return EVENTS }
    if key.equals("waiters") { return WAITERS }
    if key.equals("interrupts") { return INTERRUPTS }
    if key.equals("timers") { return TIMERS }
    if key.equals("memories") { return MEMORIES }
    if key.equals("iomemories") { return IOMEMORIES }
    if key.equals("pipes") { return PIPES }
    if key.equals("records") { return PROCESS_RECORDS }
    if key.equals("attachments") { return ATTACHMENTS }
    MAPPINGS
}

/// The `QuotaKind` a quota key names.
func quota_of(key: String) -> Int {
    if key.equals("threads") { return 0 }
    if key.equals("events") { return 1 }
    if key.equals("waiters") { return 2 }
    if key.equals("timers") { return 3 }
    if key.equals("memories") { return 4 }
    if key.equals("iomemories") { return 5 }
    if key.equals("mappings") { return 6 }
    if key.equals("handles") { return 7 }
    8
}

/// The limits `stated` (the board's defaults, then the image's over them)
/// come to against the kernel `facts`: each total as the slots it raises its
/// kind by, each quota as stated. A total below its floor is refused.
public func image_limits(stated: &Vector<LimitsSpec>, facts: &KernelFacts,
                         name: String) -> Result<ImageLimits, BuildError> {
    var limits = ImageLimits.none()
    var s = 0
    while s < stated.len() {
        borrow let spec = stated[s] {
            var i = 0
            while i < spec.totals.len() {
                let total = spec.totals.get(i)!
                i = i + 1
                let kind = slab_of(total.name)
                let floor = facts.floors.get(kind) ?? 0
                if total.value < floor {
                    return BuildError(message: "{name}: `{total.name}` is {total.value}, below the kernel's floor of {floor}: an image raises a limit and never lowers one")
                }
                limits.raise[kind] = total.value - floor
            }
            var q = 0
            while q < spec.quota.len() {
                let quota = spec.quota.get(q)!
                q = q + 1
                limits.quota[quota_of(quota.name)] = quota.value
            }
        }
        s = s + 1
    }
    return move limits
}

/// What the board's `[limits.default]` comes to against the kernel `facts`:
/// the limits an image that states none of its own is given, each total as
/// the slots it raises its kind by, each quota as stated. They are planned as
/// such an image's would be (`sosimage.limits.plan_limits`), so a default
/// below its floor or breaking a derivation (a derived total below it, a
/// quota default at or past its bound, more bodies than the domain pool) is
/// refused here, naming the file. A board with no `[limits.default]` states
/// nothing, and an image on it that states nothing carries no limits at all
/// (`Board.has_limits`).
public func board_defaults(board: &Board, facts: &KernelFacts) -> Result<ImageLimits, BuildError> {
    let what = "{board.file}: [limits.default]"
    var stated = Vector<LimitsSpec>()
    try! stated.push(board.limits.copy())
    let limits = try image_limits(&stated, &facts, what)
    let _ = try plan_limits(&facts, &limits, what, 0, 0)
    return move limits
}

/// Builds the image the description at `path` states, for the board its
/// profile is, into `out`: each process's package as the module's header
/// lays out (`sosimage.package`, root's as `root`), `<out>/kernel-main.o`,
/// then `<out>/<name>.elf` and, for a board with a flash,
/// `<out>/<name>.flash.bin`; the generated files go in `<out>/<name>.image/`.
public func build_image(profile: &Profile, sawos: String, product: String, path: String,
                        out: String) -> Result<Linked, BuildError> {
    let text = try read_text(path)
    let board_name = try image_board(text, path)
    let board = try find_board(sawos, board_name)
    try ensure_directory(out)
    let facts = try hal_facts(&profile, "{out}/hal")
    try check_board(&board, &profile, &facts, sawos)
    let image = try ImageFile.parse(text, path, &board, facts.grain)

    if image.stock {
        var decls = Vector<Declaration>()
        var i = 0
        while i < image.processes.len() {
            let process = image.processes.get(i)!
            i = i + 1
            let file = "{package_dir(process.package, sawos, product)}/process.toml"
            try! decls.push(try Declaration.parse(try read_text(file), file))
        }
        let bound = try bind(&image, &board, &decls, facts.grain)
        var n = 0
        while n < bound.notes.len() {
            print(bound.notes.get(n) ?? "")
            n = n + 1
        }
        return BuildError(message: "{path}: an image with the stock root is read and bound, and this builder does not build the stock root")
    }

    // Every refusal that needs no build, before anything is built.
    let count = image.processes.len()
    var slots = Vector<Span>()
    var root_slot: Span? = None
    if let flash = board.flash {
        slots = try child_slots(flash.slots, flash.slot_count, count, path)
        root_slot = flash.root_slot
    }
    let align = region_align(facts.grain, board.placement)
    let root_region = Span(base: facts.root_base, len: facts.root_top - facts.root_base)
    let stack = facts.stack_len

    let root = try build_process(&profile, "root", package_dir(image.root_package, sawos, product),
                                 out, &Placement(region: root_region, stack: stack, slot: root_slot))

    // Each process linked where it would go first, and measured.
    var asks = Vector<Ask>()
    var firsts = Vector<Placement>()
    var i = 0
    while i < count {
        let process = image.processes.get(i)!
        let range_name = try process_range(&board, &process, package_dir(process.package, sawos, product),
                                           path)
        let first = try first_placement(&board, root_region, align, stack, range_name,
                                        slots.get(i), process.name, path, process.at)
        let built = try build_process(&profile, process.name, package_dir(process.package, sawos, product),
                                      out, &first)
        let elf = try read_file(built.elf)
        let segments = try load_segments(&elf, built.elf)
        let bytes = try ram_span(&segments, board.placement, "the process {process.name}'s image {built.elf}")
        try! asks.push(Ask(name: process.name, range: range_name, bytes: bytes, pool: false,
                           at: process.at))
        try! firsts.push(first)
        i = i + 1
    }
    var p = 0
    while p < image.pools.len() {
        let pool = image.pools.get(p)!
        p = p + 1
        let range_name = if pool.ram.is_empty() { board.default_pool } else { pool.ram }
        try! asks.push(Ask(name: pool.name, range: range_name, bytes: pool.len, pool: true,
                           at: pool.at))
    }
    let regions = try place(&board, root_region, align, stack, &asks, path)

    // Each process linked again where its region is, unless that is where it
    // was first linked; a translated board links every image at one base.
    var children = Vector<String>()
    i = 0
    while i < count {
        let process = image.processes.get(i)!
        let region = regions.get(i)!
        let final_ = Placement(region: region, stack: stack, slot: slots.get(i))
        let first = firsts.get(i)!
        var line = "process {process.name} region={hex(region.base)}+{hex(region.len)}"
        if let slot = final_.slot {
            line = "{line} slot={hex(slot.base)}+{hex(slot.len)}"
        }
        print(line)
        if not board.placement.equals("translated") && region.base != first.region.base {
            let _ = try build_process(&profile, process.name, package_dir(process.package, sawos, product),
                                      out, &final_)
        }
        try! children.push("{out}/{process.name}.sosimg")
        i = i + 1
    }
    p = 0
    while p < image.pools.len() {
        let region = regions.get(count + p)!
        print("pool {(image.pools.get(p)!).name} region={hex(region.base)}+{hex(region.len)}")
        p = p + 1
    }

    let rows = image_rows(&image, &regions)

    let kernel = "{out}/kernel-main.o"
    try build_kernel(&profile, "{sawos}/kernel/main.saw", kernel)

    var stated = Vector<LimitsSpec>()
    if board.has_limits {
        try! stated.push(board.limits.copy())
    }
    if image.has_limits {
        try! stated.push(image.limits.copy())
    }
    var limits = ImageLimits.none()
    if stated.len() > 0 {
        let kernel_facts = try KernelFacts.read(kernel)
        limits = try image_limits(&stated, &kernel_facts, image.name)
    }

    var flash: FlashOutput? = None
    if profile.flash != None {
        flash = FlashOutput(output: "{out}/{image.name}.flash.bin", check: true)
    }
    let spec = ImageSpec(name: image.name, kernel: kernel,
                         staging: "{out}/{image.name}.image",
                         output: "{out}/{image.name}.elf", asm: "", child_asm: "",
                         root_image: root.image, children: move children,
                         has_regions: true, flags: if image.tick { 0 } else { BOOT_FLAG_NO_TICK },
                         rows: move rows, has_limits: stated.len() > 0,
                         limits: move limits, link_args: Vector<String>(), flash: flash)
    link(&profile, &spec)
}

/// The range a hand-written root's process is placed in: the one its image
/// names, else one its package's declaration allows (`declares_fast`,
/// `choose_range`); `dir` is the package's directory and `file` the image's.
public func process_range(board: &Board, process: &ProcessEntry, dir: String,
                          file: String) -> Result<String, BuildError> {
    let fast = try declares_fast(dir)
    choose_range(&board, process.ram, fast, process.name, file, process.at)
}

/// Whether the package in `dir` declares `ram = "fast"` in a `process.toml`
/// beside its manifest; a package with none declares nothing.
public func declares_fast(dir: String) -> Result<Bool, BuildError> {
    let file = "{dir}/process.toml"
    if not File.exists(Path(s: file)) {
        return false
    }
    let d = try Declaration.parse(try read_text(file), file)
    return d.fast
}

/// A hand-written root's region table, from its image and the `regions`
/// placed for it (each process's, in order, then each pool's): an image blob
/// per process, a destination per process, then `[rows] devices`, then
/// `[rows] pools`, each pool's row its own region.
public func image_rows(image: &ImageFile, regions: &Vector<Span>) -> Vector<RowSpec> {
    let count = image.processes.len()
    var rows = Vector<RowSpec>()
    var i = 0
    while i < count {
        let process = image.processes.get(i)!
        try! rows.push(RowSpec(what: "{process.name}'s image blob", kind: RegionKind.Ram,
                               blob: i, base: 0, len: 0))
        i = i + 1
    }
    i = 0
    while i < count {
        let process = image.processes.get(i)!
        let region = regions.get(i)!
        try! rows.push(RowSpec(what: "{process.name}'s destination RAM", kind: RegionKind.Ram,
                               blob: None, base: region.base, len: region.len))
        i = i + 1
    }
    i = 0
    while i < image.row_devices.len() {
        let row = image.row_devices.get(i)!
        try! rows.push(RowSpec(what: "{row.window.device}'s window", kind: RegionKind.Device,
                               blob: None, base: row.window.base, len: row.window.len))
        i = i + 1
    }
    i = 0
    while i < image.row_pools.len() {
        let name = image.row_pools.get(i) ?? ""
        i = i + 1
        var k = 0
        while k < image.pools.len() && not (image.pools.get(k)!).name.equals(name) {
            k = k + 1
        }
        let region = regions.get(count + k)!
        try! rows.push(RowSpec(what: "the pool {name}", kind: RegionKind.Pool,
                               blob: None, base: region.base, len: region.len))
    }
    move rows
}
