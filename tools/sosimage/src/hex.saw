//! Hexadecimal text for addresses and words, in the two spellings the
//! builder's messages use.

static NIBBLE_BITS: UInt64 = 4
static NIBBLE_MASK: UInt64 = 0xF

/// `value` in lowercase hexadecimal with a `0x` prefix and no padding:
/// `0x42100060`, `0x0`.
public func hex(value: UInt64) -> String {
    hex_padded(value, 1)
}

/// `value` in lowercase hexadecimal with a `0x` prefix, zero-padded to at
/// least `digits` digits: `hex_padded(0xAEDB041D, 8)` is `0xaedb041d`.
public func hex_padded(value: UInt64, digits: Int) -> String {
    var reversed = Vector<UInt8>()
    var rest = value
    while rest != 0 || reversed.len() < digits {
        let digit = (rest & NIBBLE_MASK) as Int
        try! reversed.push("0123456789abcdef".byte_at(digit))
        rest = rest >> NIBBLE_BITS
    }
    var out = StringBuilder()
    try! out.append("0x")
    var i = reversed.len()
    while i > 0 {
        i = i - 1
        try! out.append(reversed.get(i) ?? 0)
    }
    out.build()
}
