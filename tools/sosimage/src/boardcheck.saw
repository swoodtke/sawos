//! A board description held to the other places its facts live: the profile
//! the runner writes for the board (its toolchain's view), the board's linker
//! script, and the board's HAL, compiled.
//!
//! The HAL's numbers are read by compiling a generated module that exports
//! them (`hal_facts`) with the profile's compiler and module paths, as the
//! kernel is compiled, and reading the record out of the object
//! (`read_hal_facts`): the values are the HAL's own, whatever expression
//! states them. `check_board` refuses, naming both values:
//!
//! - against the tree: a `hal` that is not the file's own directory;
//! - against the profile: another triple; other C flags; a `hal` module or a
//!   module of `modules` the profile maps elsewhere or not at all; a module
//!   the profile maps that `modules` does not name (all but the kernel's
//!   own, `KERNEL_MODULES`); a flash whose length, bus windows, window
//!   length, root's slot or slot range differ from the profile's layout, or a
//!   flash on one side only;
//! - against the linker script, on an in-place board: a `[flash]` whose base
//!   is not 0, where the flash image starts; a length other than the
//!   script's `FLASH_BYTES`, bus bases other than its `FLASH_IBUS` and
//!   `FLASH_DBUS`. The slots are not the script's: the builder writes them
//!   for each image (`sosimage.layout.image_slots`);
//! - against the HAL: a console (`kernel = true`) whose window is not
//!   `DEVICE_GRANT_BASE` for `DEVICE_GRANT_LEN`, or no console; a device
//!   window off `PROT_GRAIN`; a kernel range that does not begin at
//!   `KERNEL_RAM_BASE`, or does not end where root's region begins
//!   (`ROOT_LOAD_BASE`); a range that runs past `RAM_TOP`; root's
//!   region (`ROOT_LOAD_BASE` to `ROOT_REGION_TOP`) empty, or not inside the
//!   default process range.
//!
//! A keyed module, one whose directory is chosen per image from several
//! (the ESP32-S3's clock and stall keys), is written in `modules` with a
//! trailing `*`: `s3clock=keys/clock-*` is any directory beside `keys/` whose
//! name starts with `clock-`.

import std.path.{Path}
import sosimage.board.{Board}
import sosimage.build.{build_kernel, ensure_directory}
import sosimage.failure.{BuildError}
import sosimage.hex.{hex}
import sosimage.kernel.{exported_words}
import sosimage.profile.{Profile}
import sosimage.tool.{read_text, write_lines}

/// The layout version of the record `hal_facts` reads, its first word, and
/// its length in words.
public static HAL_FACTS_VERSION: UInt64 = 3
public static HAL_FACTS_WORDS: Int = 9

/// The record's symbol.
public func facts_symbol() -> String { "sosimage_hal_facts" }

/// The modules every kernel compiles against, which a profile maps and a
/// board does not name: the arch-free kernel, its runtime and ABI, the image
/// format, and the HAL itself, which `hal` names.
public func kernel_modules() -> Vector<String> {
    ["kcore", "sosrt", "sosabi", "imgformat", "hal"]
}

/// The HAL's numbers a board description is checked against and an image is
/// laid out by.
public struct HalFacts {
    /// Root's region: where its image loads, and one past its stack's top.
    root_base: UInt64
    root_top: UInt64
    /// The protection grain.
    grain: UInt64
    /// The console's window, which the kernel hands over.
    console_base: UInt64
    console_len: UInt64
    /// Where the kernel's own RAM begins, and where the board's RAM ends.
    kernel_base: UInt64
    ram_top: UInt64
    /// The stack at the top of every process's region.
    stack_len: UInt64
}

/// The HAL's numbers, read by compiling a module that exports them with the
/// profile's compiler and module paths; the module and its object are
/// written into `staging`.
public func hal_facts(profile: &Profile, staging: String) -> Result<HalFacts, BuildError> {
    try ensure_directory(staging)
    let source = "{staging}/hal_facts.saw"
    let object = "{staging}/hal_facts.o"
    var lines = Vector<String>()
    try! lines.push("//! Generated by sosimage: the HAL's numbers a board description is")
    try! lines.push("//! checked against, in the order `sosimage.boardcheck` reads them.")
    try! lines.push("")
    try! lines.push("import hal")
    try! lines.push("")
    try! lines.push("@export(\"{facts_symbol()}\")")
    try! lines.push("static FACTS: [UInt; {HAL_FACTS_WORDS}] = [")
    try! lines.push("    {HAL_FACTS_VERSION},")
    try! lines.push("    hal.ROOT_LOAD_BASE,")
    try! lines.push("    hal.ROOT_REGION_TOP,")
    try! lines.push("    hal.PROT_GRAIN,")
    try! lines.push("    hal.DEVICE_GRANT_BASE,")
    try! lines.push("    hal.DEVICE_GRANT_LEN,")
    try! lines.push("    hal.KERNEL_RAM_BASE,")
    try! lines.push("    hal.RAM_TOP,")
    try! lines.push("    hal.ROOT_STACK_LEN,")
    try! lines.push("]")
    try write_lines(source, &lines)
    try build_kernel(&profile, source, object)
    read_hal_facts(object)
}

/// The record `hal_facts`' module exports, read out of its `object`.
public func read_hal_facts(object: String) -> Result<HalFacts, BuildError> {
    let words = try exported_words(object, facts_symbol(), HAL_FACTS_WORDS)
    let version = words.get(0) ?? 0
    if version != HAL_FACTS_VERSION {
        return BuildError(message: "{object}: `{facts_symbol()}` is version {version}; this builder reads version {HAL_FACTS_VERSION}")
    }
    return HalFacts(root_base: words.get(1) ?? 0, root_top: words.get(2) ?? 0,
                    grain: words.get(3) ?? 0, console_base: words.get(4) ?? 0,
                    console_len: words.get(5) ?? 0, kernel_base: words.get(6) ?? 0,
                    ram_top: words.get(7) ?? 0, stack_len: words.get(8) ?? 0)
}

/// Refuses a board description that disagrees with the sawos tree at
/// `sawos`, with `profile`, with the profile's linker script, or with the
/// HAL's `facts`, naming both values.
public func check_board(board: &Board, profile: &Profile, facts: &HalFacts,
                        sawos: String) -> Result<Void, BuildError> {
    let file = board.file
    let own = try canonical(board.dir, "{file}: its directory")
    let named = try Path(s: "{sawos}/{board.hal}").canonical() catch {
        return BuildError(message: "{file}: `hal` is \"{board.hal}\", which names no directory of the tree {sawos}")
    }
    if not named.as_string().equals(own) {
        return BuildError(message: "{file}: `hal` is \"{board.hal}\", which is {named.as_string()}, and the description is in {own}: `hal` names the board's own HAL directory")
    }
    try check_profile(&board, &profile)
    if board.flash != None {
        try check_script(&board, &profile)
    }
    try check_hal(&board, &facts)
    return
}

/// The profile's view: the triple, the C flags, the modules, the flash.
func check_profile(board: &Board, profile: &Profile) -> Result<Void, BuildError> {
    let file = board.file
    if not board.triple.equals(profile.triple) {
        return BuildError(message: "{file}: the board's triple is {board.triple}, and the profile's is {profile.triple}")
    }
    let flags = board.cflags.join(" ")
    let args = profile.cc_args.join(" ")
    if not flags.equals(args) {
        return BuildError(message: "{file}: the board's cflags are `{flags}`, and the profile's cc_args are `{args}`")
    }
    try module_in_profile(&board, &profile, "hal", "{board.dir}/kernel")
    var m = 0
    while m < board.modules.len() {
        let module = board.modules.get(m) ?? ""
        m = m + 1
        let eq = module.index_of(61) ?? 0
        try module_in_profile(&board, &profile, module.substring(0, eq),
                              "{board.dir}/{module.substring(eq + 1, module.len())}")
    }
    let own = kernel_modules()
    var p = 0
    while p < profile.module_paths.len() {
        let mapping = profile.module_paths.get(p) ?? ""
        p = p + 1
        let name = mapping.substring(0, mapping.index_of(61) ?? 0)
        if holds_name(&own, name) || board_names(&board, name) {
            continue
        }
        return BuildError(message: "{file}: the profile maps the module {name}, and the board's `modules` does not name it")
    }
    if let flash = board.flash {
        guard let layout = profile.flash else {
            return BuildError(message: "{file}: the board is in-place and has a [flash], and the profile has no flash layout")
        }
        if flash.len != layout.bytes || flash.ibus.base != layout.instruction_window ||
           flash.dbus.base != layout.data_window || flash.ibus.len != layout.window_bytes ||
           flash.dbus.len != layout.window_bytes {
            return BuildError(message: "{file}: [flash] is {hex(flash.len)} bytes, ibus {hex(flash.ibus.base)} and dbus {hex(flash.dbus.base)} for {hex(flash.ibus.len)} and {hex(flash.dbus.len)}; the profile's flash is {hex(layout.bytes)} bytes, windows {hex(layout.instruction_window)} and {hex(layout.data_window)} for {hex(layout.window_bytes)}")
        }
        if flash.root_slot.base != layout.root_slot.base || flash.root_slot.len != layout.root_slot.len ||
           flash.slots.base != layout.slots.base || flash.slots.len != layout.slots.len ||
           flash.slot_count != layout.slot_count {
            return BuildError(message: "{file}: [flash] root-slot is {hex(flash.root_slot.len)} bytes at {hex(flash.root_slot.base)} and slots {flash.slot_count} in {hex(flash.slots.len)} bytes at {hex(flash.slots.base)}; the profile's are {hex(layout.root_slot.len)} bytes at {hex(layout.root_slot.base)} and {layout.slot_count} in {hex(layout.slots.len)} bytes at {hex(layout.slots.base)}")
        }
    } else if profile.flash != None {
        return BuildError(message: "{file}: the profile has a flash layout, and the board describes no flash")
    }
    return
}

/// An in-place board's `[flash]` against the numbers its linker script
/// assigns.
func check_script(board: &Board, profile: &Profile) -> Result<Void, BuildError> {
    let file = board.file
    guard let flash = board.flash else {
        return
    }
    let script = profile.linker_script
    let text = try read_text(script)
    if flash.base != 0 {
        return BuildError(message: "{file}: [flash] base is {hex(flash.base)}, and the flash image starts at offset 0")
    }
    try script_agrees(file, script, &text, "FLASH_BYTES", "[flash] len", flash.len)
    try script_agrees(file, script, &text, "FLASH_IBUS", "[flash] ibus base", flash.ibus.base)
    try script_agrees(file, script, &text, "FLASH_DBUS", "[flash] dbus base", flash.dbus.base)
    return
}

/// Refuses `value`, which `what` names in `file`, when the script assigns
/// `symbol` another number, or none this reader can read.
func script_agrees(file: String, script: String, text: &String, symbol: String, what: String,
                   value: UInt64) -> Result<Void, BuildError> {
    guard let stated = script_number(&text, symbol) else {
        return BuildError(message: "{script} assigns `{symbol}` no number this builder reads (`{symbol} = 0x...;`, or a decimal with K or M), and {file} is checked against it")
    }
    if stated != value {
        return BuildError(message: "{file}: {what} is {hex(value)}, and {script} has {symbol} = {hex(stated)}")
    }
    return
}

/// The number a linker script assigns `symbol` in a statement of its own,
/// `SYMBOL = NUMBER;`, NUMBER hexadecimal or decimal, a decimal with a `K` or
/// `M` suffix; `None` when it assigns none so.
public func script_number(text: &String, symbol: String) -> UInt64? {
    let lines = try! text.split("\n")
    var i = 0
    while i < lines.len() {
        let line = (lines.get(i) ?? "").trim()
        i = i + 1
        if not line.starts_with(symbol) || not line.ends_with(";") {
            continue
        }
        let rest = line.substring(symbol.len(), line.len() - 1).trim()
        if not rest.starts_with("=") {
            continue
        }
        let value = rest.substring(1, rest.len()).trim()
        if value.starts_with("0x") || value.starts_with("0X") {
            guard let n = value.substring(2, value.len()).to_uint(16) else {
                return None
            }
            return n as UInt64
        }
        var unit: UInt64 = 1
        var digits = value
        if value.ends_with("K") {
            unit = 0x400
            digits = value.substring(0, value.len() - 1)
        } else if value.ends_with("M") {
            unit = 0x10_0000
            digits = value.substring(0, value.len() - 1)
        }
        guard let n = digits.to_uint() else {
            return None
        }
        return (n as UInt64) * unit
    }
    None
}

/// The HAL's numbers: the console, the grain, the RAM's bounds, the kernel
/// range's end and root's region.
func check_hal(board: &Board, facts: &HalFacts) -> Result<Void, BuildError> {
    let file = board.file
    var console = false
    var d = 0
    while d < board.devices.len() {
        let device = board.devices.get(d)!
        d = d + 1
        if device.base % facts.grain != 0 || device.len % facts.grain != 0 {
            return BuildError(message: "{file}: [devices.{device.name}] is {hex(device.len)} bytes at {hex(device.base)}, off the HAL's grain ({facts.grain} bytes)")
        }
        if device.kernel {
            if device.base != facts.console_base || device.len != facts.console_len {
                return BuildError(message: "{file}: [devices.{device.name}] is the kernel's, {hex(device.len)} bytes at {hex(device.base)}, and the HAL's console window (DEVICE_GRANT_BASE, DEVICE_GRANT_LEN) is {hex(facts.console_len)} bytes at {hex(facts.console_base)}")
            }
            console = true
        }
    }
    if not console {
        return BuildError(message: "{file}: no device has kernel = true, and the HAL's console window is {hex(facts.console_len)} bytes at {hex(facts.console_base)}")
    }
    var r = 0
    while r < board.ram.len() {
        let range = board.ram.get(r)!
        r = r + 1
        if range.kernel && range.base != facts.kernel_base {
            return BuildError(message: "{file}: [ram.{range.name}], the kernel's, begins at {hex(range.base)}, and the HAL's kernel RAM begins at {hex(facts.kernel_base)} (KERNEL_RAM_BASE)")
        }
        if range.kernel && range.base + range.len != facts.root_base {
            return BuildError(message: "{file}: [ram.{range.name}], the kernel's, runs from {hex(range.base)} to {hex(range.base + range.len)}, and root's region begins at {hex(facts.root_base)} (ROOT_LOAD_BASE): the kernel range ends where root's region begins")
        }
        if range.base + range.len > facts.ram_top {
            return BuildError(message: "{file}: [ram.{range.name}] runs from {hex(range.base)} to {hex(range.base + range.len)}, past the end of the HAL's RAM at {hex(facts.ram_top)} (RAM_TOP)")
        }
    }
    guard let range = board.range(board.default_process) else {
        return BuildError(message: "{file}: internal: the default process range vanished")
    }
    if facts.root_base >= facts.root_top || facts.root_base < range.base ||
       facts.root_top > range.base + range.len {
        return BuildError(message: "{file}: root's region (ROOT_LOAD_BASE to ROOT_REGION_TOP, {hex(facts.root_base)} to {hex(facts.root_top)}) is not inside the default process range {range.name}, {hex(range.base)} to {hex(range.base + range.len)}")
    }
    return
}

/// `path` resolved, or a refusal naming `what`.
func canonical(path: String, what: String) -> Result<String, BuildError> {
    let p = try Path(s: path).canonical() catch {
        return BuildError(message: "{what}, {path}, cannot be resolved: {error}")
    }
    return p.as_string()
}

func holds_name(list: &Vector<String>, name: String) -> Bool {
    var i = 0
    while i < list.len() {
        if (list.get(i) ?? "").equals(name) {
            return true
        }
        i = i + 1
    }
    false
}

/// Whether the board's `modules` names the module `name`.
func board_names(board: &Board, name: String) -> Bool {
    var i = 0
    while i < board.modules.len() {
        let module = board.modules.get(i) ?? ""
        if module.substring(0, module.index_of(61) ?? 0).equals(name) {
            return true
        }
        i = i + 1
    }
    false
}

/// Refuses a module the board names that the profile maps elsewhere, or not
/// at all. A `dir` ending in `*` is a keyed module's: the profile's directory
/// must be one beside the `*`'s whose name starts with what precedes it.
func module_in_profile(board: &Board, profile: &Profile, name: String,
                       dir: String) -> Result<Void, BuildError> {
    var i = 0
    while i < profile.module_paths.len() {
        let mapping = profile.module_paths.get(i) ?? ""
        i = i + 1
        let eq = mapping.index_of(61) ?? 0
        if not mapping.substring(0, eq).equals(name) {
            continue
        }
        let given = mapping.substring(eq + 1, mapping.len())
        let found = try canonical(given, "the profile's module {name}")
        if dir.ends_with("*") {
            let slash = dir.last_index_of(47) ?? 0
            let parent = try canonical(dir.substring(0, slash), "{board.file}: the keyed module {name}'s directory")
            let prefix = "{parent}/{dir.substring(slash + 1, dir.len() - 1)}"
            let rest = if found.starts_with(prefix) { found.substring(prefix.len(), found.len()) } else { "/" }
            if rest.is_empty() || rest.contains("/") {
                return BuildError(message: "{board.file}: the board's keyed module {name} is {prefix}*, and the profile maps it to {found}")
            }
            return
        }
        let wanted = try canonical(dir, "{board.file}: the module {name}")
        if not found.equals(wanted) {
            return BuildError(message: "{board.file}: the board's module {name} is {wanted}, and the profile maps it to {found}")
        }
        return
    }
    return BuildError(message: "{board.file}: the board names the module {name}, and the profile maps no module of that name")
}
