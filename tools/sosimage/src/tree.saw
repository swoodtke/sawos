//! Every description in the sawos tree, held to its rules and to the boards
//! (`sosimage check-tree`).
//!
//! The tree's descriptions are each board's `hal/*/board.toml`, each
//! process's `process.toml` beside a package directly under `drivers/` or
//! `tests/`, and each hand-written image under `tests/images/`. The products
//! the tree holds, `templates/product/` and `tests/product/`, are read as a
//! product is (`product_roots`): each process's `process.toml` beside a
//! package directly under the product's root, held as the tree's are, and
//! each image under its `images/`, whose paths are from the product's root
//! and whose `sawos:` paths are from the tree's (`image_dirs`).
//!
//! `read_tree` reads every board and every declaration (each format's own
//! rules). A declaration runs on the boards that have a device of each type
//! it needs, and it is refused when no board does; on each it runs on it is
//! held to the board (`Declaration.check_against`: its board's word, the
//! board inputs of its types). `runs_on` says which boards each runs on. An
//! image is refused when the board it names is none of the tree's, since no
//! board's check would read it.
//!
//! Against one board and its compiled kernel, `check_tree_board` holds every
//! declaration that runs on the board to the kernel's numbers
//! (`hold_quota`), and reads every image for the board at its protection
//! grain, binding a stock-root image's processes to their declarations. The
//! gate checks each board it boots: the three gate profiles' in `sos-test`,
//! the ESP32-C3's and the ESP32-S3's in their smokes.

import std.directory.{Directory}
import std.file.{File}
import std.path.{Path}
import sosimage.board.{Board}
import sosimage.declaration.{Declaration}
import sosimage.failure.{BuildError}
import sosimage.imagefile.{ImageFile, bind, image_board}
import sosimage.kernel.{KernelFacts, QUOTA_HANDLE, QUOTA_MAPPING}
import sosimage.limits.{QUOTA_UNLIMITED}
import sosimage.plan.{quota_of}
import sosimage.product.{image_declarations}
import sosimage.tool.{read_text}


/// A declaration of the tree, and the boards it runs on.
public struct TreeProcess {
    decl: Declaration
    boards: Vector<String>
}

@synthesize
extension TreeProcess: ExplicitCopy {}

/// The tree's boards and declarations, read.
public struct Tree {
    boards: Vector<Board>
    processes: Vector<TreeProcess>
}

@synthesize
extension Tree: ExplicitCopy {}

/// The entries of the directory `dir`, sorted; none when it does not exist.
func listed(dir: String) -> Result<Vector<String>, BuildError> {
    var out = Vector<String>()
    if not File.exists(Path(s: dir)) {
        return move out
    }
    let entries = try Directory.list(Path(s: dir)) catch {
        return BuildError(message: "could not list {dir}: {error}")
    }
    var i = 0
    while i < entries.len() {
        try! out.push((entries.get(i)!).as_string())
        i = i + 1
    }
    out.sort()
    return move out
}

/// The roots of the products the tree at `sawos` holds.
func product_roots(sawos: String) -> Vector<String> {
    ["{sawos}/templates/product", "{sawos}/tests/product"]
}

/// A directory of hand-written images, and the product root their paths are
/// from.
public struct ImageDir {
    dir: String
    product: String
}

/// Where the tree at `sawos` keeps hand-written images: `tests/images/`,
/// whose paths are from the tree's top, then each product's `images/`.
public func image_dirs(sawos: String) -> Vector<ImageDir> {
    var out: Vector<ImageDir> = [ImageDir(dir: "{sawos}/tests/images", product: sawos)]
    let roots = product_roots(sawos)
    var r = 0
    while r < roots.len() {
        let root = roots.get(r) ?? ""
        try! out.push(ImageDir(dir: "{root}/images", product: root))
        r = r + 1
    }
    move out
}

/// A hand-written image, and the product root its paths are from.
struct ImageAt {
    file: String
    product: String
}

/// The image descriptions in the directories `image_dirs` names, each with
/// the product root its paths are from.
func image_files(sawos: String) -> Result<Vector<ImageAt>, BuildError> {
    var out = Vector<ImageAt>()
    let dirs = image_dirs(sawos)
    var d = 0
    while d < dirs.len() {
        let at = dirs.get(d)!
        d = d + 1
        let files = try listed(at.dir)
        var i = 0
        while i < files.len() {
            let file = files.get(i) ?? ""
            i = i + 1
            if file.ends_with(".toml") {
                try! out.push(ImageAt(file: file, product: at.product))
            }
        }
    }
    return move out
}

/// Reads every board and every declaration of the tree at `sawos`, and holds
/// each declaration to every board it runs on; refuses a declaration no board
/// can run.
public func read_tree(sawos: String) -> Result<Tree, BuildError> {
    var boards = Vector<Board>()
    let hal = try listed("{sawos}/hal")
    var i = 0
    while i < hal.len() {
        let file = "{hal.get(i) ?? ""}/board.toml"
        i = i + 1
        if File.exists(Path(s: file)) {
            try! boards.push(try Board.parse(try read_text(file), file))
        }
    }
    var processes = Vector<TreeProcess>()
    var parents: Vector<String> = ["{sawos}/drivers", "{sawos}/tests"]
    try! parents.append(&product_roots(sawos))
    var p = 0
    while p < parents.len() {
        let dirs = try listed(parents.get(p) ?? "")
        p = p + 1
        var d = 0
        while d < dirs.len() {
            let file = "{dirs.get(d) ?? ""}/process.toml"
            d = d + 1
            if not File.exists(Path(s: file)) {
                continue
            }
            let decl = try Declaration.load(file)
            let runs = try boards_for(&decl, &boards)
            try! processes.push(TreeProcess(decl: move decl, boards: move runs))
        }
    }
    try images_on_boards(sawos, &boards)
    return Tree(boards: move boards, processes: move processes)
}

/// Refuses an image of the tree (`image_files`) whose board is none of
/// `boards`.
func images_on_boards(sawos: String, boards: &Vector<Board>) -> Result<Void, BuildError> {
    var names = Vector<String>()
    var b = 0
    while b < boards.len() {
        borrow let board = boards[b] {
            try! names.push(board.name)
        }
        b = b + 1
    }
    let images = try image_files(sawos)
    var i = 0
    while i < images.len() {
        let file = (images.get(i)!).file
        i = i + 1
        let board = try image_board(try read_text(file), file)
        var known = false
        var n = 0
        while n < names.len() {
            if (names.get(n) ?? "").equals(board) {
                known = true
            }
            n = n + 1
        }
        if not known {
            return BuildError(message: "{file}: the image is for the board {board}, and no board.toml under hal/ names it; the boards are {names.join(", ")}")
        }
    }
    return
}

/// The names of the boards among `boards` that have a device of each type
/// `decl` needs, each holding it (`check_against`); refused when there are
/// none.
func boards_for(decl: &Declaration,
                boards: &Vector<Board>) -> Result<Vector<String>, BuildError> {
    let needs = decl.needs()
    var out = Vector<String>()
    var names = Vector<String>()
    var b = 0
    while b < boards.len() {
        borrow let board = boards[b] {
            try! names.push(board.name)
            var has = true
            var n = 0
            while n < needs.len() {
                if board.instances((needs.get(n)!).type_name).len() == 0 {
                    has = false
                }
                n = n + 1
            }
            if has {
                try decl.check_against(&board)
                try! out.push(board.name)
            }
        }
        b = b + 1
    }
    if out.len() == 0 {
        var types = Vector<String>()
        var n = 0
        while n < needs.len() {
            try! types.push((needs.get(n)!).type_name)
            n = n + 1
        }
        return BuildError(message: "{decl.file}: no board has a device of each type it needs (`{types.join("`, `")}`); the boards are {names.join(", ")}")
    }
    return move out
}

/// A line per declaration: `FILE runs on BOARD, BOARD`.
public func runs_on(tree: &Tree) -> Vector<String> {
    var out = Vector<String>()
    var i = 0
    while i < tree.processes.len() {
        borrow let p = tree.processes[i] {
            try! out.push("{p.decl.file} runs on {p.boards.join(", ")}")
        }
        i = i + 1
    }
    move out
}

/// Holds `decl`'s declared quota rows, and the handles it holds when it
/// starts, to the kernel of the board `board` (`facts`): `handles` within the
/// handle table, `mappings` within the grant rows an image leaves, every
/// other row within the most an image can raise its slab to, and none at the
/// ledger's unlimited mark.
public func hold_quota(decl: &Declaration, board: String,
                       facts: &KernelFacts) -> Result<Void, BuildError> {
    let floor = decl.handle_floor()
    if floor > facts.handles {
        return BuildError(message: "{decl.file}: the process holds {floor} handles when it starts, past the {facts.handles} the board {board}'s handle table holds")
    }
    var q = 0
    while q < decl.quota.len() {
        let row = decl.quota.get(q)!
        q = q + 1
        let kind = quota_of(row.name)
        if row.value >= QUOTA_UNLIMITED {
            return BuildError(message: "{decl.file}: `{row.name}` in [quota] is {row.value}, which the ledger's row cannot hold below its unlimited mark ({QUOTA_UNLIMITED})")
        }
        if kind == QUOTA_HANDLE {
            if row.value > facts.handles {
                return BuildError(message: "{decl.file}: `handles` in [quota] is {row.value}, past the {facts.handles} the board {board}'s handle table holds")
            }
            continue
        }
        if kind == QUOTA_MAPPING {
            let rows = facts.budget - facts.image_rows
            if row.value > rows {
                return BuildError(message: "{decl.file}: `mappings` in [quota] is {row.value}, past the {rows} grant rows an image leaves of the board {board}'s {facts.budget}")
            }
            continue
        }
        if row.value > facts.capacity {
            return BuildError(message: "{decl.file}: `{row.name}` in [quota] is {row.value}, past the {facts.capacity} an image on the board {board} can raise any slab to")
        }
    }
    return
}

/// Holds the tree to `board` and its kernel (`facts`): every declaration
/// that runs on the board to the kernel's numbers (`hold_quota`), and every
/// image for the board (`check_images`).
public func check_tree_board(tree: &Tree, sawos: String, board: &Board,
                        facts: &KernelFacts,
                        grain: UInt64) -> Result<Void, BuildError> {
    var i = 0
    while i < tree.processes.len() {
        borrow let p = tree.processes[i] {
            var on = false
            var b = 0
            while b < p.boards.len() {
                if (p.boards.get(b) ?? "").equals(board.name) {
                    on = true
                }
                b = b + 1
            }
            if on {
                try hold_quota(&p.decl, board.name, &facts)
            }
        }
        i = i + 1
    }
    let _ = try check_images(sawos, &board, grain)
    return
}

/// Reads every image of the tree (`image_files`) for `board` at its
/// protection grain `grain`, binding a stock-root image's processes to their
/// declarations, each package from its image's product root; answers the
/// images it read.
public func check_images(sawos: String, board: &Board,
                         grain: UInt64) -> Result<Vector<String>, BuildError> {
    var read = Vector<String>()
    let images = try image_files(sawos)
    var i = 0
    while i < images.len() {
        let at = images.get(i)!
        let file = at.file
        i = i + 1
        let text = try read_text(file)
        if not (try image_board(text, file)).equals(board.name) {
            continue
        }
        let image = try ImageFile.parse(text, file, &board, grain)
        try! read.push(file)
        if not image.stock {
            continue
        }
        let decls = try image_declarations(&image, sawos, at.product)
        let _ = try bind(&image, &board, &decls, grain)
    }
    return move read
}
