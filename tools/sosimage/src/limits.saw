//! An image's limits: the slab kinds it raises and the quota defaults its
//! children start with, checked against the kernel's numbers and turned into
//! the areas the build links and the block after the region table's rows
//! (spec §2.8, §12).
//!
//! An image raises a kind by a number of slots above its floor and never
//! lowers one. Some totals are derived from others, and the builder computes
//! them: records are `records_per_body` per process body, threads at least the
//! bodies, attachments at least events + interrupts + timers + records. An
//! image may state a derived total above its derivation and never below it.
//! The Mapping slab is sized at four per process body when the image states
//! none, or the sum below when that is larger; that is how the builder sizes a
//! default, and nothing checks it.
//!
//! For a stock root the Thread, Event, Waiter, Timer, Mapping, Pipe, Memory
//! and IoMemory slabs are also derived from the plan: each total is at least
//! root's own objects of the kind plus each child's row of it, a declaration's
//! or the image's, so the rows the children state always fit the slab they
//! draw from. Root's own are its main thread, its one Waiter and the Memory
//! objects of the region table; a child that states no row of a kind counts
//! nothing of it, except a Thread, which counts its main thread, and a
//! Memory, which counts at least its heaps. An image may state such a total
//! above its sum and never below it.
//!
//! Each quota default an image states is at least the compiled one, below its
//! slab's capacity at boot (the `handle` default below the handle table), fits
//! the ledger's 16-bit row without reading as unlimited, and for `mapping`
//! leaves the rows an image spends before it runs. A default the image does
//! not state is the compiled one.
//!
//! Root's handle table is `MAX_HANDLES` entries and the handle blocks the image
//! gives it, which the slab block carries and the kernel attaches before root's
//! first handle. An image states root's table as `root-handles`, rounded up to
//! a whole block, at most the longest table. For a stock root the builder reads
//! the table off the plan (`PlanNeeds`): the most root holds at any step of it,
//! rounded up to a block, which a stated `root-handles` may raise and never
//! lower. The `handle-blocks` total is at least root's blocks, which are taken
//! first, and each child's, for its `Handle` row past `MAX_HANDLES`. A
//! hand-written root has no plan: the image or its board's `[limits.default]`
//! states the table and the total, and with none root's table is `MAX_HANDLES`
//! and the machine holds no blocks. Each boot set of a stock root's plan,
//! root's rows and each child's records, is held to `BOOT_SET_CAPACITY`, the
//! most a `BootSet` holds.
//!
//! The region table's rows are held against the image's Memory and IoMemory
//! capacities, and against root's handle table: the kernel mints root's
//! System, Process and Thread handles and then one handle for every row
//! (`kcore.process`'s `start_process` and `mint_boot_regions`, spec §12), so
//! root holds `ROOT_BOOT_HANDLES` plus the rows before it runs, and more than
//! its table holds stops the boot. An image that raises neither slab cannot
//! reach it: `kcore.limits` asserts the body's table holds the floors' rows
//! beside five handles.

import sosimage.failure.{BuildError}
import sosimage.fields.{Fields}
import sosimage.kernel.{
    ATTACHMENTS, EVENTS, HANDLE_BLOCKS, INTERRUPTS, IOMEMORIES, KernelFacts,
    MAPPINGS, MEMORIES, PIPES, PROCESSES, PROCESS_RECORDS, QUOTA_HANDLE,
    QUOTA_KINDS, QUOTA_MAPPING, SLAB_KINDS, THREADS, TIMERS, WAITERS,
    quota_kind_name, slab_kind_name,
}

/// The handles root holds at boot before its rows' (spec §12): System,
/// Process and Thread.
static ROOT_BOOT_HANDLES: Int = 3

/// The Mapping slab's size per process body when an image states none.
static MAPPINGS_PER_BODY: Int = 4

/// The ledger's unlimited marker, which no quota row may reach: a row is 16
/// bits wide (`kernel/abi/src/ops.saw`'s `QUOTA_UNLIMITED`).
public static QUOTA_UNLIMITED: Int = 0xFFFF

/// What an image description asks for, by kind value, and root's handle
/// table; -1 is not stated.
public struct ImageLimits {
    raise: Vector<Int>
    quota: Vector<Int>
    root_handles: Int
}

@synthesize
extension ImageLimits: ExplicitCopy {}

extension ImageLimits {
    /// Limits that state nothing.
    public static func none() -> ImageLimits {
        var raise = Vector<Int>()
        var quota = Vector<Int>()
        var k = 0
        while k < SLAB_KINDS {
            try! raise.push(-1)
            k = k + 1
        }
        var q = 0
        while q < QUOTA_KINDS {
            try! quota.push(-1)
            q = q + 1
        }
        ImageLimits(raise: move raise, quota: move quota, root_handles: -1)
    }

    /// Reads the description's `limits` object: `slabs`, the slots each named
    /// kind is raised by, `quotas`, each named default, and `root-handles`,
    /// root's handle table. Each may be left out; an unknown name is refused.
    public static func read(limits: &var Fields) -> Result<ImageLimits, BuildError> {
        let empty = ImageLimits.none()
        var raise = empty.raise.copy()
        var quota = empty.quota.copy()
        var k = 0
        var q = 0
        if var slabs = try limits.object("slabs", "the image's `limits.slabs`") {
            k = 0
            while k < SLAB_KINDS {
                let name = slab_kind_name(k)
                if slabs.has(name) {
                    let n = try slabs.integer(name)
                    if n < 0 {
                        return BuildError(message: "the image's `limits.slabs`: `{name}` is negative ({n}); an image raises a limit and never lowers one")
                    }
                    raise[k] = n
                }
                k = k + 1
            }
            try slabs.finish()
        }
        if var quotas = try limits.object("quotas", "the image's `limits.quotas`") {
            q = 0
            while q < QUOTA_KINDS {
                let name = quota_kind_name(q)
                if quotas.has(name) {
                    let n = try quotas.integer(name)
                    if n < 0 {
                        return BuildError(message: "the image's `limits.quotas`: `{name}` is negative ({n})")
                    }
                    quota[q] = n
                }
                q = q + 1
            }
            try quotas.finish()
        }
        var root_handles = -1
        if limits.has("root-handles") {
            root_handles = try limits.integer("root-handles")
            if root_handles < 0 {
                return BuildError(message: "the image's `limits`: `root-handles` is negative ({root_handles})")
            }
        }
        try limits.finish()
        return ImageLimits(raise: move raise, quota: move quota,
                           root_handles: root_handles)
    }

    /// The `limits` object of an image description that `read` reads back as
    /// these limits: each stated kind under `slabs`, each stated default under
    /// `quotas`, in kind order, and root's table when it is stated.
    public func json(&self) -> String {
        var slabs = Vector<String>()
        var k = 0
        while k < SLAB_KINDS {
            let n = self.raise.get(k) ?? -1
            if n >= 0 {
                try! slabs.push("\"{slab_kind_name(k)}\": {n}")
            }
            k = k + 1
        }
        var quotas = Vector<String>()
        var q = 0
        while q < QUOTA_KINDS {
            let n = self.quota.get(q) ?? -1
            if n >= 0 {
                try! quotas.push("\"{quota_kind_name(q)}\": {n}")
            }
            q = q + 1
        }
        let root = if self.root_handles >= 0 {
            ", \"root-handles\": {self.root_handles}"
        } else {
            ""
        }
        "\{\"slabs\": \{{slabs.join(", ")}\}, \"quotas\": \{{quotas.join(", ")}\}{root}\}"
    }
}

/// What a stock root's plan asks of the machine's handle tables and boot
/// sets and slabs, as `check_plan` finds it: the most handles root holds at
/// any step and the first step it holds them at, each child's name, `Handle`
/// row and the records its boot set is given, and `summed`, by `SlabKind`
/// value, what the children's rows add up to in each slab (see
/// `plan_limits`). An image whose root is not the stock root has no plan to
/// read, and `PlanNeeds.none()` asks nothing.
public struct PlanNeeds {
    stock: Bool
    held: Int
    step: String
    names: Vector<String>
    rows: Vector<Int>
    records: Vector<Int>
    summed: Vector<Int>
}

@synthesize
extension PlanNeeds: ExplicitCopy {}

extension PlanNeeds {
    /// The needs of an image with no plan to read.
    public static func none() -> PlanNeeds {
        PlanNeeds(stock: false, held: 0, step: "", names: Vector<String>(),
                  rows: Vector<Int>(), records: Vector<Int>(),
                  summed: Vector<Int>())
    }

    /// Whether the plan needs handle blocks beyond the body's `MAX_HANDLES`
    /// entries, for root's table or for a child's row.
    public func wants_blocks(&self, facts: &KernelFacts) -> Bool {
        if not self.stock {
            return false
        }
        if self.held > facts.handles {
            return true
        }
        var c = 0
        while c < self.rows.len() {
            if (self.rows.get(c) ?? 0) > facts.handles {
                return true
            }
            c = c + 1
        }
        false
    }
}

/// One area the build links: the kind it raises, by how many slots, how many
/// bytes that is, and the alignment its base needs.
public struct SlabArea {
    kind: Int
    slots: Int
    bytes: Int
    align: Int
}

/// What an image's limits come to: whether it carries a block at all, the
/// areas, in kind order, every quota default, by kind value, and the handle
/// blocks root's table takes.
public struct SlabPlan {
    block: Bool
    areas: Vector<SlabArea>
    defaults: Vector<Int>
    root_blocks: Int
}

@synthesize
extension SlabPlan: ExplicitCopy {}

extension SlabPlan {
    /// The plan of an image that states no limits: no block, no areas.
    public static func none() -> SlabPlan {
        SlabPlan(block: false, areas: Vector<SlabArea>(),
                 defaults: Vector<Int>(), root_blocks: 0)
    }
}

/// The totals and the areas `limits` asks of the kernel `facts` describes,
/// for an image of `name` whose region table mints `memory_rows` Memory
/// objects and `device_rows` IoMemory objects at boot, and whose stock root's
/// plan asks `needs`. Every refusal names the image, the number and the bound
/// it breaks.
public func plan_limits(facts: &KernelFacts, limits: &ImageLimits, needs: &PlanNeeds,
                        name: String, memory_rows: Int,
                        device_rows: Int) -> Result<SlabPlan, BuildError> {
    var total = Vector<Int>()
    var k = 0
    while k < SLAB_KINDS {
        let floor = facts.floors.get(k) ?? 0
        let stated = limits.raise.get(k) ?? -1
        if stated > facts.capacity {
            return BuildError(message: "{name}: the image raises {slab_kind_name(k)} by {stated}, past MAX_SLAB_CAPACITY ({facts.capacity})")
        }
        try! total.push(if stated < 0 { floor } else { floor + stated })
        k = k + 1
    }

    // Root's table is the body's entries, or what the plan holds at its
    // fullest, or what the image states, whichever is longest, in whole
    // blocks.
    let longest = facts.handles + facts.table_blocks * facts.handle_block
    if limits.root_handles > longest {
        return BuildError(message: "{name}: the image's root handle table is {limits.root_handles}, past the longest handle table ({longest})")
    }
    if needs.stock && needs.held > longest {
        return BuildError(message: "{name}: the stock root would hold {needs.held} handles at `{needs.step}`, past the longest handle table ({longest})")
    }
    let derived = if needs.stock { table_of(&facts, needs.held) } else { facts.handles }
    let stated_table = table_of(&facts, limits.root_handles)
    if limits.root_handles >= 0 && stated_table < derived {
        return BuildError(message: "{name}: the image's root handle table is {limits.root_handles}, below {derived}: the stock root would hold {needs.held} handles at `{needs.step}`")
    }
    let root_table = if stated_table > derived { stated_table } else { derived }
    let root_blocks = (root_table - facts.handles) / facts.handle_block
    var child_blocks = 0
    var n = 0
    while needs.stock && n < needs.rows.len() {
        child_blocks = child_blocks + blocks_of(&facts, needs.rows.get(n) ?? 0)
        n = n + 1
    }
    try derive(&var total, &limits, HANDLE_BLOCKS, root_blocks + child_blocks, name,
               "root's handle table of {root_table} takes {root_blocks} and the processes' Handle rows {child_blocks}")

    // A stock root's slabs hold root's own objects and what each child's rows
    // ask: each kind's total is their sum, which a stated total may exceed.
    // Root has its main thread, its one Waiter and the region table's Memory
    // objects, and a child with no row of a kind counts nothing of it.
    var threads = 0
    if needs.stock {
        threads = 1 + (needs.summed.get(THREADS) ?? 0)
        try sum_kind(&var total, &limits, &needs, EVENTS, 0, name)
        try sum_kind(&var total, &limits, &needs, WAITERS, 1, name)
        try sum_kind(&var total, &limits, &needs, TIMERS, 0, name)
        try sum_kind(&var total, &limits, &needs, MAPPINGS, 0, name)
        try sum_kind(&var total, &limits, &needs, PIPES, 0, name)
        try sum_kind(&var total, &limits, &needs, MEMORIES, memory_rows, name)
        try sum_kind(&var total, &limits, &needs, IOMEMORIES, 0, name)
    }

    let bodies = total.get(PROCESSES) ?? 0
    try derive(&var total, &limits, PROCESS_RECORDS,
               facts.records_per_body * bodies, name,
               "{facts.records_per_body} records per process body, for {bodies} bodies")
    if threads > bodies {
        try derive(&var total, &limits, THREADS, threads, name,
                   "root's main thread and the processes' Thread rows")
    } else {
        try derive(&var total, &limits, THREADS, bodies, name,
                   "a main thread for each of {bodies} process bodies")
    }
    let waitables = ((total.get(EVENTS) ?? 0) + (total.get(INTERRUPTS) ?? 0)
                     + (total.get(TIMERS) ?? 0) + (total.get(PROCESS_RECORDS) ?? 0))
    try derive(&var total, &limits, ATTACHMENTS, waitables, name,
               "one for each event, interrupt, timer and record")
    if (limits.raise.get(MAPPINGS) ?? -1) < 0 {
        let sized = MAPPINGS_PER_BODY * bodies
        if sized > (total.get(MAPPINGS) ?? 0) {
            total[MAPPINGS] = sized
        }
    }

    k = 0
    while k < SLAB_KINDS {
        let t = total.get(k) ?? 0
        if t > facts.capacity {
            return BuildError(message: "{name}: the image's {slab_kind_name(k)} come to {t}, past MAX_SLAB_CAPACITY ({facts.capacity})")
        }
        k = k + 1
    }
    let thread_total = total.get(THREADS) ?? 0
    if thread_total > facts.thread_slab {
        return BuildError(message: "{name}: the image's threads come to {thread_total}, past the thread ID's index field ({facts.thread_slab})")
    }
    let pipes = total.get(PIPES) ?? 0
    if pipes * facts.inflight > facts.capacity {
        return BuildError(message: "{name}: the image's {pipes} pipes need {pipes * facts.inflight} exchanges, past MAX_SLAB_CAPACITY ({facts.capacity})")
    }
    if bodies > facts.domains {
        return BuildError(message: "{name}: the image's {bodies} process bodies pass this board's domain pool ({facts.domains})")
    }
    let memories = total.get(MEMORIES) ?? 0
    if memory_rows > memories {
        return BuildError(message: "{name}: the region table mints {memory_rows} Memory objects at boot, past the image's {memories}")
    }
    let iomemories = total.get(IOMEMORIES) ?? 0
    if device_rows > iomemories {
        return BuildError(message: "{name}: the region table mints {device_rows} IoMemory objects at boot, past the image's {iomemories}")
    }
    let boot_handles = ROOT_BOOT_HANDLES + memory_rows + device_rows
    if boot_handles > root_table {
        let bound = if root_blocks == 0 {
            "MAX_HANDLES ({facts.handles})"
        } else {
            "root's handle table ({root_table})"
        }
        return BuildError(message: "{name}: root holds {boot_handles} handles at boot, its System, Process and Thread and one for each of the region table's {memory_rows + device_rows} rows, past {bound}")
    }
    if needs.stock {
        let rows = memory_rows + device_rows
        if rows > facts.boot_set {
            return BuildError(message: "{name}: root's boot set holds {rows} records, one for each of the region table's rows, past BOOT_SET_CAPACITY ({facts.boot_set})")
        }
        var c = 0
        while c < needs.records.len() {
            let records = needs.records.get(c) ?? 0
            let who = needs.names.get(c) ?? ""
            if records > facts.boot_set {
                return BuildError(message: "{name}: the process {who}'s boot set holds {records} records, past BOOT_SET_CAPACITY ({facts.boot_set}): its declared records, the console's inlet and its heaps' pools")
            }
            c = c + 1
        }
    }

    var defaults = Vector<Int>()
    var q = 0
    while q < QUOTA_KINDS {
        let compiled = facts.defaults.get(q) ?? 0
        let stated = limits.quota.get(q) ?? -1
        if stated < 0 {
            try! defaults.push(compiled)
            q = q + 1
            continue
        }
        let label = quota_kind_name(q)
        if stated < compiled {
            return BuildError(message: "{name}: the image's {label} quota default is {stated}, below the compiled default ({compiled})")
        }
        if stated >= QUOTA_UNLIMITED {
            return BuildError(message: "{name}: the image's {label} quota default is {stated}, which the ledger's row cannot hold below its unlimited mark ({QUOTA_UNLIMITED})")
        }
        if q == QUOTA_HANDLE {
            if stated >= facts.handles {
                return BuildError(message: "{name}: the image's handle quota default is {stated}, not below MAX_HANDLES ({facts.handles})")
            }
        } else {
            let slab = quota_slab(q)
            let cap = total.get(slab) ?? 0
            if stated >= cap {
                return BuildError(message: "{name}: the image's {label} quota default is {stated}, not below its slab's capacity ({cap})")
            }
        }
        if q == QUOTA_MAPPING && stated > facts.budget - facts.image_rows {
            return BuildError(message: "{name}: the image's mapping quota default is {stated}, past the {facts.budget - facts.image_rows} grant rows an image leaves of this board's {facts.budget}")
        }
        try! defaults.push(stated)
        q = q + 1
    }

    var areas = Vector<SlabArea>()
    k = 0
    while k < SLAB_KINDS {
        let slots = (total.get(k) ?? 0) - (facts.floors.get(k) ?? 0)
        if slots > 0 {
            try! areas.push(SlabArea(kind: k, slots: slots,
                                     bytes: slots * (facts.units.get(k) ?? 0),
                                     align: facts.aligns.get(k) ?? 0))
        }
        k = k + 1
    }
    return SlabPlan(block: true, areas: move areas, defaults: move defaults,
                    root_blocks: root_blocks)
}

/// The handle table that holds `count` entries: the body's, and as many
/// whole blocks as the rest takes.
func table_of(facts: &KernelFacts, count: Int) -> Int {
    facts.handles + blocks_of(&facts, count) * facts.handle_block
}

/// The handle blocks a table of `count` entries takes beyond the body's.
func blocks_of(facts: &KernelFacts, count: Int) -> Int {
    if count <= facts.handles {
        return 0
    }
    (count - facts.handles + facts.handle_block - 1) / facts.handle_block
}

/// Settle slab `kind`'s total against `own` objects of root's and the sum of
/// the children's rows `needs` holds for it.
func sum_kind(total: &var Vector<Int>, limits: &ImageLimits, needs: &PlanNeeds,
              kind: Int, own: Int, name: String) -> Result<Void, BuildError> {
    let rows = needs.summed.get(kind) ?? 0
    try derive(&var total, &limits, kind, own + rows, name,
               "root's own {own} and the processes' rows {rows}")
    return
}

/// Settle derived kind `kind`'s total against `derivation`: the derivation
/// when the image states none, the stated total when it is at least that, and
/// a refusal naming `why` when it is below.
func derive(total: &var Vector<Int>, limits: &ImageLimits, kind: Int,
            derivation: Int, name: String, why: String) -> Result<Void, BuildError> {
    let t = total.get(kind) ?? 0
    if (limits.raise.get(kind) ?? -1) < 0 {
        if derivation > t {
            total[kind] = derivation
        }
        return
    }
    if t < derivation {
        return BuildError(message: "{name}: the image's {slab_kind_name(kind)} come to {t}, below {derivation}: {why}")
    }
    return
}

/// The slab a quota kind draws from, by `SlabKind` value. `handle` has none.
public func quota_slab(q: Int) -> Int {
    match q {
        case 0 -> THREADS,
        case 1 -> EVENTS,
        case 2 -> WAITERS,
        case 3 -> TIMERS,
        case 4 -> MEMORIES,
        case 5 -> IOMEMORIES,
        case 6 -> MAPPINGS,
        case 8 -> PIPES,
        case _ -> -1,
    }
}
