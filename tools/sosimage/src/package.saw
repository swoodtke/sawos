//! A process's package, built by Blade for one placement.
//!
//! The builder writes the process's own script (`sosimage.layout`'s
//! `process_script`), which assigns the placement's symbols and INCLUDEs the
//! script the package's manifest names for the triple, and has Blade link the
//! package through it into a directory of the process's own:
//!
//!     OUT/NAME.ld          the process's script
//!     OUT/NAME/            Blade's output: the object, the ELF, the sosimg
//!     OUT/NAME.sosimg      the image, named for the process
//!
//! Each instance of a package is its own link, named for its process, so two
//! instances of one package are two images.
//!
//! The runner states a test image's placements in a process description, a
//! JSON object `sosimage package` reads:
//!
//!     {
//!       "version": 1,
//!       "name": "child0",
//!       "package": "/path/to/tests/child-bye",
//!       "out": "/path/to/tests/child-bye/.build/riscv32-unknown-none-elf",
//!       "region": {"base": 2149842944, "len": 262144},
//!       "stack": 16384,
//!       "slot": {"base": 1572864, "len": 131072},
//!       "plan": {"children": [], "connections": 0},
//!       "inputs": [{"name": "stockconfig", "path": "/path/to/config.saw"}]
//!     }
//!
//! `slot` is an in-place board's, and absent on any other. `plan` is a stock
//! root's: the builder writes it as the module `imageplan`
//! (`sosimage.plan.plan_module`) into `OUT/NAME.imageplan/` and builds the
//! package with it and the arena the plan needs (`sosimage.plan.root_arena`),
//! unchecked, so a case can hand the stock root a plan the builder would
//! refuse. `inputs` are the process's build inputs: each file is
//! the module of its name (`write_input`). `plan` and `inputs` may be left
//! out; every other key is required, and an unknown key is refused.
//!
//! A child's image header carries the default band map and no realtime bands
//! (`check_header_bands`): the header's maps are root's, which the kernel
//! applies verbatim, and nothing reads a child's, so a child asks for its
//! bands in its declaration.

import std.data.{Data}
import std.file.{File}
import std.path.{Path}
import std.json.{JsonValue}
import toml.{TomlDoc, TomlPosition}
import sosimage.board.{Span}
import sosimage.build.{ensure_directory}
import sosimage.failure.{BuildError}
import sosimage.fields.{Fields}
import sosimage.hex.{hex}
import sosimage.layout.{Placement, process_script}
import sosimage.plan.{ImagePlan, plan_module, root_arena}
import sosimage.profile.{Profile}
import sosimage.rules.{refused}
import sosimage.tool.{read_file, read_text, run_tool, write_file, write_lines}

public static PROCESS_VERSION: Int = 1

/// A process to build, as a process description states it.
public struct ProcessSpec {
    name: String
    package: String
    out: String
    placement: Placement
    plan: ImagePlan?
    inputs: Vector<InputFile>
}

/// A build input a process description gives: the file that is the module
/// `name`.
public struct InputFile {
    name: String
    path: String
}

@synthesize
extension ProcessSpec: ExplicitCopy {}

/// A module a process's build hands the compiler beside its package's own:
/// `name` is the directory `dir`, which holds its `lib.saw`.
public struct ModulePath {
    name: String
    dir: String
}

/// What a process's build takes beyond its placement: the arena its
/// declaration states, or a stock root's plan needs, and the modules the
/// image gives it (its inputs, or a stock root's plan).
public struct Extras {
    arena: UInt64?
    modules: Vector<ModulePath>
}

@synthesize
extension Extras: ExplicitCopy {}

extension Extras {
    /// Nothing beyond the placement.
    public static func none() -> Extras {
        Extras(arena: None, modules: Vector<ModulePath>())
    }
}

/// What a process's build made: its image and the ELF it was made from.
public struct Built {
    image: String
    elf: String
}

extension ProcessSpec {
    /// Reads a process description from its JSON text; `origin` names it in
    /// messages.
    public static func parse(text: String, origin: String) -> Result<ProcessSpec, BuildError> {
        let doc = try JsonValue.parse(text) catch {
            return BuildError(message: "{origin} is not JSON: {error}")
        }
        var top = try Fields(move doc, "the process {origin}")
        let version = try top.integer("version")
        if version != PROCESS_VERSION {
            return BuildError(message: "the process {origin} is version {version}; this builder reads version {PROCESS_VERSION}")
        }
        let name = try top.text("name")
        let package = try top.text("package")
        let out = try top.text("out")
        guard var r = try top.object("region", "the process's `region`") else {
            return BuildError(message: "the process {origin} has no `region`")
        }
        let region = Span(base: try r.word("base"), len: try r.word("len"))
        try r.finish()
        let stack = try top.word("stack")
        var slot: Span? = None
        if var s = try top.object("slot", "the process's `slot`") {
            slot = Span(base: try s.word("base"), len: try s.word("len"))
            try s.finish()
        }
        var plan: ImagePlan? = None
        if var given = try top.object("plan", "the process's `plan`") {
            plan = try ImagePlan.read(&var given)
        }
        var inputs = Vector<InputFile>()
        var given = try top.objects_or_empty("inputs", "input")
        var i = 0
        while i < given.len() {
            borrow var f = given[i] {
                try! inputs.push(InputFile(name: try f.text("name"), path: try f.text("path")))
                try f.finish()
            }
            i = i + 1
        }
        try top.finish()
        if stack > region.len {
            return BuildError(message: "the process {origin}: its {stack}-byte stack is longer than its {region.len}-byte region")
        }
        return ProcessSpec(name: name, package: package, out: out,
                           placement: Placement(region: region, stack: stack, slot: slot),
                           plan: move plan, inputs: move inputs)
    }
}

/// The package's name, as the `Saw.toml` in `dir` gives it.
public func package_name(dir: String) -> Result<String, BuildError> {
    let manifest = "{dir}/Saw.toml"
    let doc = try TomlDoc.parse(try read_text(manifest)) catch {
        return BuildError(message: "{manifest}: {error}")
    }
    borrow let root = doc.root() {
        if let p = root.table("package") {
            let name = try p.string("name") catch {
                return BuildError(message: "{manifest}: {error}")
            }
            return name
        }
        return BuildError(message: "{manifest} has no [package]")
    }
}

/// The script the `Saw.toml` in `dir` names for `triple`, as a path from the
/// package's directory.
public func manifest_script(dir: String, triple: String) -> Result<String, BuildError> {
    let manifest = "{dir}/Saw.toml"
    let doc = try TomlDoc.parse(try read_text(manifest)) catch {
        return BuildError(message: "{manifest}: {error}")
    }
    borrow let root = doc.root() {
        if let sos = root.table("sos") {
            if let target = sos.table(triple) {
                let script = try target.string("linker-script") catch {
                    return BuildError(message: "{manifest}: {error}")
                }
                return script
            }
            return BuildError(message: "{manifest} has no [sos.{triple}]: the package builds no image for {triple}")
        }
        return BuildError(message: "{manifest} has no [sos]: the package builds no process image")
    }
}

/// `path`, which exists, as an absolute path with no `.` or `..` in it.
public func absolute(path: String, what: String) -> Result<String, BuildError> {
    let p = try Path(s: path).canonical() catch {
        return BuildError(message: "{what} {path} cannot be resolved: {error}")
    }
    return p.as_string()
}

/// Writes `plan` as the module `imageplan` into `OUT/NAME.imageplan/`, for
/// the stock root built as the process `name` of the image `image`; answers
/// the module's path.
public func write_plan(plan: &ImagePlan, out: String, name: String,
                       image: String) -> Result<ModulePath, BuildError> {
    let dir = "{out}/{name}.imageplan"
    try ensure_directory(dir)
    let lines = plan_module(&plan, image)
    try write_lines("{dir}/lib.saw", &lines)
    return ModulePath(name: "imageplan", dir: try absolute(dir, "the plan's directory"))
}

/// What the stock root's build takes for `plan`, built as the process `name`
/// of the image `image` on a word of `word` bytes: the module `imageplan`,
/// written into `OUT/NAME.imageplan/` (`write_plan`), and the arena the plan
/// needs (`sosimage.plan.root_arena`). Both of the builder's paths to a stock
/// root take it: a test image's (`sosimage package`) and a described one's
/// (`sosimage.product`).
public func stock_root_extras(plan: &ImagePlan, word: Int, out: String, name: String,
                              image: String) -> Result<Extras, BuildError> {
    var extras = Extras.none()
    extras.arena = root_arena(&plan, word)
    try! extras.modules.push(try write_plan(&plan, out, name, image))
    return move extras
}

/// Writes the file `from` as the module `input` of the process `name`, into
/// `OUT/NAME.inputs/INPUT/lib.saw`; answers the module's path.
public func write_input(out: String, name: String, input: String,
                        from: String) -> Result<ModulePath, BuildError> {
    let dir = "{out}/{name}.inputs/{input}"
    try ensure_directory(dir)
    try write_file("{dir}/lib.saw", try read_file(from))
    // Blade runs in the package's directory, so the module's is named whole.
    return ModulePath(name: input, dir: try absolute(dir, "the input's directory"))
}

/// Builds the package in `package` as the process `name` placed at `p`, into
/// `out` (the module's header lays the directory out), with `extras`. The
/// image a previous build left is removed first, so a build that fails
/// leaves none to be taken for this one's.
public func build_process(profile: &Profile, name: String, package: String, out: String,
                          p: &Placement, extras: &Extras) -> Result<Built, BuildError> {
    if profile.blade.is_empty() {
        return BuildError(message: "the profile names no Blade (`blade`), and the process {name} is built by one")
    }
    let dir = try absolute(package, "the package of the process {name},")
    let pkg = try package_name(dir)
    let manifest_named = try manifest_script(dir, profile.triple)
    let included = if manifest_named.starts_with("/") { manifest_named } else { "{dir}/{manifest_named}" }
    let script_named = try absolute(included, "the script {dir}/Saw.toml names,")
    try ensure_directory(out)
    let at = try absolute(out, "the output directory")
    let script = "{at}/{name}.ld"
    let lines = try process_script(name, &p, extras.arena, script_named)
    try write_lines(script, &lines)
    let image = "{at}/{name}.sosimg"
    if File.exists(Path(s: image)) {
        try File.remove(Path(s: image)) catch {
            return BuildError(message: "could not remove the previous image {image}: {error}")
        }
    }
    let blade_out = "{at}/{name}"
    // Blade builds the package in its own directory, and the builder cannot
    // start a program in another, so a shell changes into it first.
    var argv = Vector<String>()
    try! argv.push("/bin/sh")
    try! argv.push("-c")
    try! argv.push("cd \"$0\" && exec \"$@\"")
    try! argv.push(dir)
    try! argv.push(profile.blade)
    try! argv.push("build")
    try! argv.push("--force")
    try! argv.push("--target")
    try! argv.push(profile.triple)
    try! argv.push("--linker-script")
    try! argv.push(script)
    try! argv.push("--out-dir")
    try! argv.push(blade_out)
    var m = 0
    while m < extras.modules.len() {
        let module = extras.modules.get(m)!
        try! argv.push("--module-path")
        try! argv.push("{module.name}={module.dir}")
        m = m + 1
    }
    try run_tool(&argv)
    let made = "{blade_out}/{pkg}.sosimg"
    if not File.exists(Path(s: made)) {
        return BuildError(message: "Blade built {dir} as the process {name} and left no {made}")
    }
    try write_file(image, try read_file(made))
    return Built(image: image, elf: "{blade_out}/{pkg}.elf")
}

/// The header's `prio_map` and `rt_map`, by offset (`imgformat`'s
/// `SosimgHeader`).
static HEADER_PRIO_MAP: Int = 8
static HEADER_RT_MAP: Int = 12
/// The map a manifest with no `[sos] priorities` writes: one byte a band, low
/// byte first, background at 0 and the others at 1.
static DEFAULT_PRIO_MAP: UInt32 = 0x0101_0100

/// Refuses a child whose built image, `image`, carries a header band map
/// other than the default, or any realtime band (a nonzero `rt_map`, which
/// makes the image one the create door refuses): the maps are root's, and
/// nothing reads a child's.
public func check_header_bands(image: &Data, process: String, file: String,
                               at: TomlPosition) -> Result<Void, BuildError> {
    let map = try header_word(&image, HEADER_PRIO_MAP, process)
    if map != DEFAULT_PRIO_MAP {
        return refused(file, at, "the package of the process {process} states a band map of {hex(map as UInt64)} in its `Saw.toml` `[sos] priorities`, which is root's band map and is not read for a child: a child asks for bands in its process.toml")
    }
    let rt = try header_word(&image, HEADER_RT_MAP, process)
    if rt != 0 {
        return refused(file, at, "the package of the process {process} states realtime bands of {hex(rt as UInt64)} in its `Saw.toml` `[sos] priorities`, which are root's and are not read for a child: a child asks for bands in its process.toml")
    }
    return
}

/// The header's little-endian word at `at` in `image`, the image of the
/// process `process`.
func header_word(image: &Data, at: Int, process: String) -> Result<UInt32, BuildError> {
    var word: UInt32 = 0
    var b = 3
    while b >= 0 {
        guard let byte = image.get(at + b) else {
            return BuildError(message: "the image of the process {process} is truncated before its header's band maps")
        }
        word = (word << 8) | (byte as UInt32)
        b = b - 1
    }
    return word
}
