// The byte code under every frame: big-endian words, the Internet checksum
// and the text of addresses.

import std.data.{Data}
import netpeer.wire.{byte_at, be16, be32, put8, put16, put32, put_mac, mac_at,
                     put_from, sum16, checksum, hex_byte, mac_text, ip_text}

func check(ok: Bool, what: String) {
    if not ok {
        print("failed: {what}")
    }
    assert(ok, what)
}

func main() {
    var d = Data()
    put8(&var d, 0x12)
    put16(&var d, 0x3456)
    put32(&var d, 0x789A_BCDE)
    put8(&var d, 0x1FF)
    check(d.len() == 8, "eight bytes")
    check(byte_at(&d, 0) == 0x12, "a byte")
    check(be16(&d, 1) == 0x3456, "a 16-bit word, big-endian")
    check(be32(&d, 3) == 0x789A_BCDE, "a 32-bit word, big-endian")
    check(byte_at(&d, 7) == 0xFF, "a byte is the low eight bits")
    check(byte_at(&d, 8) == 0, "past the end reads 0")

    var m = Data()
    put_mac(&var m, 0x5255_0A00_0202)
    check(m.len() == 6, "six bytes of MAC")
    check(mac_at(&m, 0) == 0x5255_0A00_0202, "a MAC round trip")
    check(byte_at(&m, 0) == 0x52 && byte_at(&m, 5) == 0x02, "MAC byte order")

    var c = Data()
    put_from(&var c, &d, 1, 3)
    check(c.len() == 3 && byte_at(&c, 0) == 0x34, "a copied range")

    // The example of RFC 1071: the words 0001 f203 f4f5 f6f7 sum to ddf2
    // before the complement.
    var r = Data()
    put16(&var r, 0x0001)
    put16(&var r, 0xF203)
    put16(&var r, 0xF4F5)
    put16(&var r, 0xF6F7)
    check(sum16(&r, 0, 8) == 0xDDF2, "RFC 1071's sum")
    check(checksum(&r, 0, 8) == 0x220D, "and its checksum")
    put16(&var r, 0x220D)
    check(sum16(&r, 0, 10) == 0xFFFF, "a good checksum sums to all ones")

    // An odd length pads its last byte with a zero on the right.
    var o = Data()
    put8(&var o, 0x01)
    put8(&var o, 0x02)
    put8(&var o, 0x03)
    check(sum16(&o, 0, 3) == 0x0102 + 0x0300, "an odd last byte is high")
    check(sum16(&o, 1, 2) == 0x0203, "from an offset")

    check(hex_byte(0x0A) == "0a", "two digits, lowercase")
    check(hex_byte(0xF0) == "f0", "the high nibble")
    check(mac_text(0x5254_0012_3456) == "52:54:00:12:34:56", "a MAC as text")
    check(mac_text(0x0000_0000_0001) == "00:00:00:00:00:01", "leading zeros")
    check(ip_text(0x0A00_020F) == "10.0.2.15", "an IP as text")
    check(ip_text(0xFF00_0001) == "255.0.0.1", "every octet")
}
