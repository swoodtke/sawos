//! Memory: a range of physical memory, and the ops it owns (spec §2.5).
//!
//! It imports the floor and no other `sos` module. `map` is not here, because
//! it needs a `Process`, and `Process` is declared in `sos.system`, which
//! imports this file. See `Process.map` there for the shape that cycle forces.
//! `extend` is here: it names nothing but the allocation.
//!
//! A region is authority over bytes, not a description of them: `map` names a
//! target and answers with a capability rather than a number. The one way to
//! read a Memory's base and length is `pin`, which spends a right a process
//! holds only when its launcher grants it, and pins the allocation so that the
//! address can never come to name somebody else's bytes.

import sosabi.{SosStatus, MemoryHandle, MINT_OP, NO_HANDLE,
               MEMORY_PIN_RECORD_WORDS, MEMORY_PIN_BASE_WORD,
               MEMORY_PIN_LEN_WORD, memory_pin_record_bytes}

import sos.floor.{ALL_RIGHTS, call_value, checked, sos_handle_release,
                  sos_memory_extend, sos_memory_pin, sos_memory_unpin,
                  handle_rights}

/// A handle to a Memory: an allocation, a sealed range of physical memory.
///
/// §2.5's RAM in use. A process allocates one out of a `Pool`, or receives one
/// at boot through `Process.boot_handle_next` (a child's image blob and its
/// destination are allocations), installs it with `Process.map`, passes it to
/// `System.process_create` as an image or a destination, gives it and donates
/// it. It is never cut: it is used whole and it goes back whole. An
/// allocation from the front of its pool's frontier can grow in place
/// (`extend`).
///
/// What a caller names is a target (`map`), and what it gets back is another
/// capability, whose `len()` says how many bytes its row grants. The bounds
/// themselves are read only by `pin`.
///
/// Dropping the last handle gives back the slot and the bytes: the release
/// that takes a region's last reference to zero returns its kernel slab slot,
/// credits its creator's Memory quota row, and returns its whole range to the
/// free list of the pool it was allocated from, where it coalesces with its
/// free neighbours and, if it touches the unspent frontier, folds back into
/// it. An allocation minted at boot came from no pool, and its bytes go
/// nowhere. A range that touches neither a free neighbour nor the frontier
/// needs a free-list node, and when none is left it is lost to the pool, which
/// `Pool.available`'s total shows by falling.
///
/// The last reference is not always the last handle. §2.5 frees a region when
/// the last reference of either kind drops, and an installed row is the other
/// kind: a region that is still mapped somewhere, or that a child's image
/// rows grant, keeps its bytes after every handle onto it is gone, and they
/// come home at the last `unmap` (or at the death of the process whose domain
/// holds the row). Dropping a region you have mapped into a child is
/// therefore safe.
///
/// Built by `Pool.allocate`, `Process.boot_handle_next`, `mint`, a
/// message's handle decode in `sos.pipe`, and a refused `System.slab_donate`
/// handing the region back: no word constructor, no word extractor.
///
/// `NoCopy`, and dropping it releases the handle. A move-only handle's drop
/// does something, which is the enforcement the discipline needs. See
/// `BootHandle` in `sos.system`: its `Memory` is an optional the caller takes,
/// not a field it would have to partially move out of.
public struct Memory {
    public(package) handle: MemoryHandle,
}

/// Where an allocation is: what `Memory.pin` answers. `base` is a physical
/// address, the one a device is given, and `len` the allocation's length in
/// bytes.
public struct PhysicalRange {
    base: UInt,
    len: UInt,
}

extension Memory: NoCopy {
    /// Drop is release; see `System`'s deinit for the sentinel and the discard.
    func deinit(&var self) {
        if self.handle != NO_HANDLE {
            let _ = sos_handle_release(self.handle)
        }
    }
}

extension Memory {
    /// This handle's rights word, read from the kernel (`INFO_OP`), to test
    /// against `MemoryRight` bits. It is the handle's own word, so a sibling
    /// from `mint(rights:)` or a handle received with a keep mask reports the
    /// narrowed set. No right gates it, and it answers for a handle to an
    /// invalid object too, since it describes the handle and not the object. A
    /// live handle resolves, so the error channel carries only a kernel skew
    /// (`SosStatus.Unknown`).
    public func rights(&self) -> Result<UInt32, SosStatus> {
        handle_rights(self.handle)
    }

    /// Grow this allocation in place by `len` bytes, over the bytes after it
    /// in its pool. Requires `MemoryRight.Extend`.
    ///
    /// Only an allocation from the front of its pool's frontier
    /// (`AllocateFrom.Front`) carries the right, and it never leaves the
    /// process that allocated it, so its growth spends that process's pool and
    /// nobody else's. The `len` bytes must be the front of the pool's unspent
    /// frontier: when another allocation, from the front or from the back,
    /// lies after this one, or the pool has fewer free bytes there, the answer
    /// is `Err(SosStatus.NoMemory)` and nothing changes.
    ///
    /// It makes nothing and charges no quota: the bytes are the pool's, and
    /// they go home with the rest of the allocation, all at once. A row that
    /// maps the allocation keeps its bounds, so the new bytes are not
    /// reachable until the row grows over them (`Mapping.grow(len:)`).
    ///
    /// A `len` of zero or off the allocation's granularity terminates the
    /// caller.
    public func extend(&self, len: UInt) -> Result<Void, SosStatus> {
        checked(sos_memory_extend(self.handle, len))
    }

    /// Pin this allocation for a device, and answer where it is. Requires
    /// `MemoryRight.Physical`.
    ///
    /// The pin is the allocation's one hardware reference: until `unpin`, the
    /// allocation returns to no pool, even once every handle onto it and every
    /// row that maps it is gone, so the address answered here never comes to
    /// name somebody else's bytes. A holder that dies without unpinning leaves
    /// the bytes out of its pool for good. A driver pins each allocation
    /// before any address in it reaches its device, and unpins it only once
    /// the device is known to have stopped.
    ///
    /// It answers only for an allocation made contiguous
    /// (`Pool.allocate(contiguous: true)`, or minted at boot) in memory the
    /// board can give a process, and `Err(SosStatus.NoResource)`, pinning
    /// nothing, for any other: a boot allocation in flash an image is used
    /// from in place, say. An
    /// allocation already pinned terminates the caller with `BadState`: there
    /// is one pin per allocation.
    public func pin(&self) -> Result<PhysicalRange, SosStatus> {
        pin_into_frame(self.handle)
    }

    /// Drop this allocation's pin. Requires `MemoryRight.Physical`.
    ///
    /// The pin is the allocation's, not a handle's, so any handle carrying the
    /// right unpins it, whoever pinned. An allocation that is not pinned
    /// terminates the caller with `BadState`.
    public func unpin(&self) -> Result<Void, SosStatus> {
        checked(sos_memory_unpin(self.handle))
    }

    /// Mint a sibling of this region handle, narrowed by a keep mask: the
    /// universal `MINT_OP`, on `System.mint`'s exact terms. Requires the
    /// universal `MemoryRight.Mint` on this handle.
    ///
    /// This is where a launcher's memory policy is written. A region's default
    /// set is permissive (`memory_rights()` carries `Transfer | Mint | Map |
    /// MapExecute | Physical`, because attenuation is monotonic and a bit not
    /// minted at boot could never appear later), so what a child may do with
    /// the RAM it is handed is decided here, once, by the mask the launcher
    /// writes:
    ///
    /// ```saw
    /// let for_child = pool_page.mint(rights: MemoryRight.Transfer
    ///                                        | MemoryRight.Map)!
    /// child.give(memory: move for_child, tag: RAM)
    /// ```
    ///
    /// That child can install its page and read and write it, and can never
    /// execute from it, not because the kernel asks who is calling but because
    /// nothing it holds carries `MapExecute`.
    ///
    /// The mask must keep `Transfer` if the sibling is to be given: `give`
    /// checks that bit on the handle being given. What arrives need not keep
    /// it, because `give`'s own keep mask narrows the child's entry (see
    /// `Process.give(memory:)`).
    ///
    /// Everything else `System.mint` says holds unchanged: the rights are this
    /// handle's intersected with the mask (so no-amplification is structural
    /// and naming an absent right is a no-op), `Mint` is itself maskable, and
    /// the sibling is independent (its own slot, generation and release) and is
    /// a second name onto one region, not a second region. A caller at its
    /// handle quota gets `SosStatus.QuotaExceeded` and a full handle table is
    /// `SosStatus.NoResource`; a handle without `Mint` terminates the caller.
    public func mint(&self,
                     rights: UInt32 = ALL_RIGHTS) -> Result<Memory, SosStatus> {
        let raw = try call_value(self.handle, MINT_OP, rights as UInt, 0, 0)
        return Memory(handle: MemoryHandle(raw))
    }
}

/// The `unsafe` half of `Memory.pin`, confined to one small named helper. The
/// record buffer's address never leaves it.
public(package) func pin_into_frame(
    handle: MemoryHandle
) unsafe -> Result<PhysicalRange, SosStatus> {
    var buf: [UInt; MEMORY_PIN_RECORD_WORDS] = [0; MEMORY_PIN_RECORD_WORDS]
    try checked(sos_memory_pin(handle, (&var buf) as UnsafePointer<UInt>,
                               memory_pin_record_bytes() as UInt))
    return PhysicalRange(base: buf[MEMORY_PIN_BASE_WORD],
                         len: buf[MEMORY_PIN_LEN_WORD])
}
