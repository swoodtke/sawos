//! Clock: a granted time source, and the thing that mints Timers (spec §2).
//!
//! It answers two questions and holds no state: what time is it, and give me
//! something that fires at a time. The second is why it imports `sos.timer`
//! (`timer_create` constructs one); `sos.system`, where a process is granted
//! the clock at all, imports this module.

import sosabi.{SosStatus, ClockOp, ClockHandle, TimerHandle, NO_HANDLE,
               CLOCK_NOW_RECORD_DOUBLEWORDS, CLOCK_NOW_TIME_SLOT,
               clock_now_record_bytes}

import sos.floor.{call_value, checked, sos_clock_now, sos_handle_release}
import sos.timer.{Timer}

/// A handle to a Clock, a granted time source.
///
/// It answers two questions and holds no state: what time is it, and give me
/// something that fires at a time. There is no way to set one; a monotonic
/// clock that could be set would not be monotonic.
///
/// Built by `System.clock_get` and by nothing else: no word constructor, no
/// word extractor.
///
/// `NoCopy`, and dropping it releases the handle. A Clock is kernel-eternal and
/// owned by nobody, so releasing one gives back only a handle-table entry, and
/// `System.clock_get` mints a fresh handle on every call.
public struct Clock {
    public(package) handle: ClockHandle,
}

extension Clock: NoCopy {
    /// Drop is release; see `System`'s deinit for the sentinel and the discard.
    func deinit(&var self) {
        if self.handle != NO_HANDLE {
            let _ = sos_handle_release(self.handle)
        }
    }
}

extension Clock {
    /// Nanoseconds on this clock. Requires `ClockRight.Read`.
    ///
    /// The epoch is not published and must not be relied on: `Monotonic` counts
    /// from whenever the machine started counting, so two readings are
    /// comparable and one reading means nothing on its own. It never steps and
    /// never goes backwards, which is what a duration measurement and a timeout
    /// need.
    ///
    /// The out-buffer is this frame's and a caller never sees it, as with
    /// `Waiter.wait`: the kernel answers 64 bits through a copy-out record
    /// because one profile's registers are 32 wide, and supplying the bytes
    /// here keeps a raw address out of the typed surface.
    public func now(&self) -> Result<UInt64, SosStatus> {
        now_into_frame(self.handle)
    }

    /// Make a Timer that measures against this clock for its whole life.
    /// Requires `ClockRight.TimerCreate`.
    ///
    /// It comes back disarmed: attaching it to a Waiter before arming it parks
    /// rather than reporting. A caller at its Timer or handle quota gets
    /// `SosStatus.QuotaExceeded`; a full timer slab or handle table comes back
    /// as `SosStatus.NoResource`, which the caller could not have known.
    public func timer_create(&self) -> Result<Timer, SosStatus> {
        let raw = try call_value(self.handle, ClockOp.TimerCreate as UInt, 0, 0, 0)
        return Timer(handle: TimerHandle(raw))
    }
}

/// The `unsafe` half of `Clock.now`, confined to one small named helper. The
/// buffer's address never leaves it.
func now_into_frame(handle: ClockHandle) unsafe -> Result<UInt64, SosStatus> {
    var buf: [UInt64; CLOCK_NOW_RECORD_DOUBLEWORDS] = [0; CLOCK_NOW_RECORD_DOUBLEWORDS]
    try checked(sos_clock_now(handle, (&var buf) as UnsafePointer<UInt64>,
                              clock_now_record_bytes() as UInt))
    return buf[CLOCK_NOW_TIME_SLOT]
}
