//! Event: the accumulating non-blocking notification (spec §2.4).
//!
//! Bits go in through `signal` and come out through `receive`, and a non-zero
//! word is what "ready" means to a Waiter. The Waiter is the other door onto
//! the same word and lives in `sos.waiter`, which imports this module, so the
//! attachment that joins the two is written there.

import sosabi.{SosStatus, EventOp, EventHandle, NO_HANDLE}

import sos.floor.{call_value, checked, sos_event_signal, sos_handle_release}

/// A handle to an Event, the accumulating non-blocking notification.
///
/// Bits go in through `signal` and never block; one `receive` takes them all
/// out and resets the word. A non-zero word is what "ready" means to a Waiter,
/// which is the only other thing that looks at it.
///
/// Both doors empty the word: `receive` polls without parking, and a
/// `Waiter.wait` on this event hands the same word back in its record and
/// clears it. A value is delivered exactly once, so pick the door by whether
/// you want to block.
///
/// Built by `Process.event_create`, and handed back by a refused
/// `Waiter.give(event:)`: no word constructor, no word extractor.
///
/// `NoCopy`, and dropping it releases the handle. The Event is freed at its
/// last reference, which is its last handle unless a Waiter attachment still
/// holds it; freeing returns the slab slot and credits the quota row.
public struct Event {
    public(package) handle: EventHandle,
}

extension Event: NoCopy {
    /// Drop is release; see `System`'s deinit for the sentinel and the discard.
    func deinit(&var self) {
        if self.handle != NO_HANDLE {
            let _ = sos_handle_release(self.handle)
        }
    }
}

extension Event {
    /// Accumulate `bits`. Never blocks and never fails for want of room: under
    /// OR the word saturates by being idempotent, and under counting it
    /// saturates by refusing to wrap. Requires `EventRight.Signal`.
    ///
    /// Signalling zero is a no-op: it cannot make an event ready, because zero
    /// is "not ready".
    public func signal(&self, bits: UInt) -> Result<Void, SosStatus> {
        checked(sos_event_signal(self.handle, bits))
    }

    /// Drain the accumulated word and reset it to zero, in one operation.
    /// Answers zero for an event nothing has signalled; it does not park (that
    /// is the Waiter's job). Requires `EventRight.Receive`.
    ///
    /// The other door is a `Waiter.wait` on this event, whose record carries
    /// the same word and empties it the same way, so calling this right after a
    /// wake answers zero unless a signal landed in between.
    public func receive(&self) -> Result<UInt, SosStatus> {
        call_value(self.handle, EventOp.Receive as UInt, 0, 0, 0)
    }
}
