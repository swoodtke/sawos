//! IoMemory: a range of device registers, and the one op it owns (spec §2.5).
//!
//! It is a distinct kind from `Memory`, not a flag on one. An IoMemory can only
//! ever produce device-attribute rows, so a driver cannot obtain a cacheable
//! view of a register block by any spelling; this follows from which methods
//! exist. It is why `Process.map(iomemory:)` takes no access argument while
//! `Process.map(memory:)` requires one.
//!
//! The lifetime differs too, and `carve` is where a reader meets it: MMIO is
//! pinned, so a carve hands out a view and leaves the parent whole (§2.5: "a
//! fixed region may be handed out many times"), which is exactly what a
//! `Pool.allocate` must not do.
//!
//! It sits beside `sos.memory` in the module order: it names only the floor, so
//! `sos.system` can name it.

import sosabi.{SosStatus, IoMemoryHandle, IoMemoryOp, NO_HANDLE, MINT_OP}

import sos.floor.{call_value, sos_handle_release, ALL_RIGHTS, handle_rights}

/// A handle to an IoMemory, a range of memory-mapped device registers.
///
/// A driver receives one at boot through `Process.boot_handle_next` (a device
/// row of the build's region table mints one), narrows it with `carve` if its
/// hardware has sub-blocks worth separating, and installs it with
/// `Process.map`. From then on the registers are at their own addresses (a
/// mapped window is where the hardware is), and the driver reaches them through
/// `UnsafeMemory<_, Device>`.
///
/// There is no way to read the bounds, on `Memory`'s terms and for the same
/// reason. What a driver knows about its device's address it knows from the
/// device's own description, which is where a board fact belongs.
///
/// Built by `Process.boot_handle_next`, by `carve`, and by a message's handle
/// decode in `sos.pipe`.
///
/// `NoCopy`, and dropping it releases the handle. Dropping it does not close
/// any mapping made from it: a Mapping is its own object with its own handle
/// (§2.5: only the Mapping handle can unmap).
public struct IoMemory {
    public(package) handle: IoMemoryHandle,
}

extension IoMemory: NoCopy {
    /// Drop is release; see `System`'s deinit for the sentinel and the discard.
    func deinit(&var self) {
        if self.handle != NO_HANDLE {
            let _ = sos_handle_release(self.handle)
        }
    }
}

extension IoMemory {
    /// This handle's rights word, read from the kernel (`INFO_OP`), to test
    /// against `IoMemoryRight` bits. It is the handle's own word, so a sibling
    /// from `mint(rights:)` or a handle received with a keep mask reports the
    /// narrowed set. No right gates it, and it answers for a handle to an
    /// invalid object too, since it describes the handle and not the object. A
    /// live handle resolves, so the error channel carries only a kernel skew
    /// (`SosStatus.Unknown`).
    public func rights(&self) -> Result<UInt32, SosStatus> {
        handle_rights(self.handle)
    }

    /// Take a sub-window and leave this one whole. Requires
    /// `IoMemoryRight.Carve`.
    ///
    /// `offset` is relative to this window, so a driver can name a sub-block
    /// without learning an address: "the second page of what I hold", not
    /// "0x0900_1000".
    ///
    /// The parent is unchanged, which is the difference from `Pool.allocate`.
    /// Registers are pinned and shared by nature (several drivers may
    /// legitimately hold windows onto one peripheral), so a carve is
    /// non-exclusive and carving the same range twice succeeds twice. There is
    /// no cursor and nothing is spent.
    ///
    /// The machine's granularity is checked here, where the caller chose the
    /// numbers: a window that could never be installed is a capability that
    /// lies about itself, and a refusal deferred to the map would arrive one op
    /// after the mistake. (`Process.map(iomemory:)` checks it again, for the
    /// one window no carve ever saw: a boot root.)
    ///
    /// The rule is per-profile (one machine grants a device window as a single
    /// naturally-aligned power-of-two protection entry, the other by page), so
    /// the same carve can be legal on one and refused on the other, and both
    /// refusals terminate the caller. A range past this window's end is the
    /// same fault.
    ///
    /// A caller at its IoMemory or handle quota gets `SosStatus.QuotaExceeded`;
    /// a full slab or handle table is `SosStatus.NoResource`.
    public func carve(&self, offset: UInt,
                      len: UInt) -> Result<IoMemory, SosStatus> {
        let raw = try call_value(self.handle, IoMemoryOp.Carve as UInt, offset,
                                 len, 0)
        return IoMemory(handle: IoMemoryHandle(raw))
    }

    /// Mint a sibling of this IoMemory handle, narrowed by a keep mask: the
    /// universal `MINT_OP`, on `System.mint`'s exact terms. Requires the
    /// universal `IoMemoryRight.Mint` on this handle.
    ///
    /// `rights` is what the sibling may keep: its rights are this handle's
    /// intersected with the mask, so the default (all ones) is "the same
    /// rights", and naming a right this handle does not hold is a no-op.
    /// The mask is where a holder writes policy for a device
    /// window: a sibling that keeps `Map` and not `Carve` can be
    /// installed and cannot be cut into further windows.
    ///
    /// `Mint` is itself maskable. The sibling is independent (its own slot,
    /// generation and release) and names the same object. A caller at its
    /// handle quota gets `SosStatus.QuotaExceeded` and a full handle table is
    /// `SosStatus.NoResource`; a handle without `Mint` terminates the caller.
    public func mint(&self,
                     rights: UInt32 = ALL_RIGHTS) -> Result<IoMemory, SosStatus> {
        let raw = try call_value(self.handle, MINT_OP, rights as UInt, 0, 0)
        return IoMemory(handle: IoMemoryHandle(raw))
    }
}
