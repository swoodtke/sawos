//! Timer: a deadline on the Clock that made it, and the process-sleep primitive
//! (spec §2).
//!
//! `sos.clock` imports this module, because the dependency runs the way
//! construction runs: `Clock.timer_create` names `Timer`, and a Timer names no
//! Clock. Its schedule is measured against the clock it was made by, which is
//! kernel state rather than a field here.

import sosabi.{SosStatus, TimerHandle, NO_HANDLE, TIMER_ARM_RECORD_DOUBLEWORDS,
               TIMER_ARM_AFTER_SLOT, TIMER_ARM_INTERVAL_SLOT,
               timer_arm_record_bytes, MINT_OP}

import sos.floor.{checked, sos_handle_release, sos_timer_arm, sos_timer_disarm,
                  ALL_RIGHTS, call_value}

/// A handle to a Timer, a deadline on the Clock that made it.
///
/// The process-sleep primitive: attach one to a Waiter, arm it, and the wait
/// returns when it fires.
///
/// Spec §2's cycle, from the holder's side:
///
///   1. `arm(after_ns:)` for a one-shot, or `arm(after_ns:interval_ns:)` for a
///      repeating schedule;
///   2. a `Waiter.wait` answers with this attachment's key and a fire count;
///   3. there is no ack. A periodic timer has already re-armed itself, and the
///      wait that reported the fires consumed them.
///
/// The count is why step 3 is safe. A consumer descheduled across several
/// periods is told how many expired rather than losing them, so a slow consumer
/// degrades into coarser reporting instead of falling permanently behind. The
/// re-arm is drift-free: each deadline is measured from the previous deadline,
/// not from when the kernel got round to it.
///
/// Built by `Clock.timer_create`, handed back by a refused
/// `Waiter.give(timer:)` or `Process.give(timer:)`, and delivered by a message
/// as `PipeHandle.Timer` or a boot record through `BootHandle.take_timer`: no
/// word constructor, no word extractor.
///
/// `NoCopy`, and dropping it releases the handle. Release does not disarm: an
/// armed timer keeps its deadline while another handle or a Waiter attachment
/// still holds it. At its last reference the timer is freed, the comparator
/// is reprogrammed without it, and the quota row is credited.
///
/// A Timer is bound to the process that created it (§2.10). When that process
/// dies, a Timer still named elsewhere is disarmed for good: an attachment on
/// it reports one last record with a fire count of zero, and keeps reporting
/// it until it is removed, and `arm`, `disarm` and `mint` answer
/// `Err(SosStatus.Revoked)`.
public struct Timer {
    public(package) handle: TimerHandle,
}

extension Timer: NoCopy {
    /// Drop is release; see `System`'s deinit for the sentinel and the discard.
    func deinit(&var self) {
        if self.handle != NO_HANDLE {
            let _ = sos_handle_release(self.handle)
        }
    }
}

extension Timer {
    /// Fire once `after_ns` nanoseconds from now, and then every `interval_ns`
    /// after that. Requires `TimerRight.Arm`.
    ///
    /// `interval_ns` defaults to zero, a one-shot: the timer fires once and
    /// disarms itself.
    ///
    /// `after_ns` is relative to now, not an absolute time, so a caller never
    /// has to read the clock first and race between two syscalls.
    ///
    /// Arming an armed timer replaces its schedule and discards any fires it
    /// had not yet delivered. This is how a timeout is changed, not an error. A
    /// caller who wants the outstanding fires reads them with a wait first.
    ///
    /// The arguments cross as a copy-in record out of this frame, because two
    /// 64-bit times are four words on a 32-bit profile and an op has three
    /// argument registers. A caller never sees the buffer, for the reason
    /// `Waiter.wait` gives about its own.
    ///
    /// A schedule finer than the machine can serve is not refused: fires
    /// coalesce into the count, so an interval below the kernel's resolution
    /// reports many fires per wake rather than wedging the machine.
    public func arm(&self, after_ns: UInt64,
                    interval_ns: UInt64 = 0) -> Result<Void, SosStatus> {
        arm_from_frame(self.handle, after_ns, interval_ns)
    }

    /// Stop this timer and discard any fires it had not delivered. Requires
    /// `TimerRight.Arm`.
    ///
    /// Disarming a timer that is not armed is a no-op, the opposite of
    /// `Interrupt.ack`, which faults when nothing has fired. The difference is
    /// whether the caller could have known: an extra ack is provably a bug, but
    /// a one-shot disarms itself, so whether a timer is still armed is kernel
    /// state that changed without the caller acting. Cancelling a timeout that
    /// has just expired is the ordinary race in every select-with-timeout, and
    /// faulting it would make the safe idiom unwritable.
    public func disarm(&self) -> Result<Void, SosStatus> {
        checked(sos_timer_disarm(self.handle))
    }

    /// Mint a sibling of this Timer handle, narrowed by a keep mask: the
    /// universal `MINT_OP`, on `System.mint`'s exact terms. Requires the
    /// universal `TimerRight.Mint` on this handle.
    ///
    /// `rights` is what the sibling may keep: its rights are this handle's
    /// intersected with the mask, so the default (all ones) is "the same
    /// rights", and naming a right this handle does not hold is a no-op.
    /// The mask is where a holder writes policy for a deadline: a
    /// sibling that keeps `Wait` and not `Arm` can be waited on and
    /// never re-armed.
    ///
    /// `Mint` is itself maskable. The sibling is independent (its own slot,
    /// generation and release) and names the same object. A caller at its
    /// handle quota gets `SosStatus.QuotaExceeded` and a full handle table is
    /// `SosStatus.NoResource`; a handle without `Mint` terminates the caller.
    public func mint(&self,
                     rights: UInt32 = ALL_RIGHTS) -> Result<Timer, SosStatus> {
        let raw = try call_value(self.handle, MINT_OP, rights as UInt, 0, 0)
        return Timer(handle: TimerHandle(raw))
    }
}

/// The `unsafe` half of `Timer.arm`, confined to one small named helper. The
/// record's address never leaves it.
func arm_from_frame(handle: TimerHandle, after_ns: UInt64,
                    interval_ns: UInt64) unsafe -> Result<Void, SosStatus> {
    var buf: [UInt64; TIMER_ARM_RECORD_DOUBLEWORDS] = [0; TIMER_ARM_RECORD_DOUBLEWORDS]
    buf[TIMER_ARM_AFTER_SLOT] = after_ns
    buf[TIMER_ARM_INTERVAL_SLOT] = interval_ns
    checked(sos_timer_arm(handle, (&var buf) as UnsafePointer<UInt64>,
                          timer_arm_record_bytes() as UInt))
}
