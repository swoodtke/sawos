//! BootSet: a process's whole boot set, drained at once and taken by tag.
//!
//! A launcher that follows the launch convention (spec §12) gives a child
//! its records in the order its declaration lists them, each under the tag
//! the declaration names. A child that knows its records by tag has no use
//! for that order: it drains everything here and takes each record by its
//! tag, so a record it does not ask for is released with the set.
//!
//! The drain allocates nothing, so a process with no heap can drain its set.
//! Every record names a handle in the process's own table, so a drain meets
//! at most `MAX_HANDLES` records, and the kernel holds that number under
//! `BOOT_SET_CAPACITY` (`kcore.limits`). The set keeps each record as the
//! kernel wrote it, its three words, in an inline array that many records
//! long, and makes the record's wrapper only when it is taken.

import sosabi.{SosStatus, BootHandleKind, BOOT_SET_CAPACITY,
               BOOT_HANDLE_RECORD_WORDS, BOOT_HANDLE_TAG_WORD,
               BOOT_HANDLE_KIND_WORD, BOOT_HANDLE_HANDLE_WORD,
               boot_handle_record_bytes, NO_HANDLE}
import sos.system.{Process, BootHandle, decode_boot_handle}
import sos.floor.{checked, sos_handle_release, sos_process_boot_handle_next}

/// The words the set's records fill when the set is full.
static BOOT_SET_WORDS: Int = BOOT_SET_CAPACITY * BOOT_HANDLE_RECORD_WORDS

/// One record of a drained set, as the drain met it: its tag and its kind.
public struct BootEntry {
    tag: UInt
    kind: BootHandleKind
}

/// Every record of a process's boot set, in the order the drain answered
/// them: a child's in the order its launcher gave them, root's in row order.
///
/// `NoCopy`: it owns every record not yet taken, and dropping it releases
/// them. A taken record's handle word reads `NO_HANDLE`.
///
/// The records are raw handle words, so both fields are private: a record's
/// word leaves the set only inside the wrapper `take` builds, and `len`,
/// `entry(at:)` and `entries` read the rest.
public struct BootSet {
    private records: [UInt; BOOT_SET_WORDS]
    private count: Int
}

extension BootSet: NoCopy {
    /// Release every handle word not taken: the release each record's
    /// wrapper would make on its drop.
    func deinit(&var self) {
        var i: Int = 0
        while i < self.count {
            let word = self.records[i * BOOT_HANDLE_RECORD_WORDS
                                    + BOOT_HANDLE_HANDLE_WORD]
            if word != NO_HANDLE {
                let _ = sos_handle_release(word)
            }
            i = i + 1
        }
    }
}

extension BootSet {
    /// Drain `process`'s boot set to its end. Requires
    /// `ProcessRight.BootHandles`, and `process` must be the caller's own
    /// (`boot_handle_next`'s terms). A drain that ends other than by
    /// `SosStatus.Drained` answers that status, and the records drained
    /// before it are released.
    ///
    /// More records than `BOOT_SET_CAPACITY` panic, naming the capacity: the
    /// kernel's table cannot hold them, so only a kernel built past its own
    /// assert could answer one.
    ///
    /// A pool given under a heap tag leaves the set: it becomes the pool of
    /// its slot's heap (`Heap`), and a right adoption needs that is missing
    /// panics, naming it (see `adopt_heaps`).
    public init(process: &Process) -> Result<BootSet, SosStatus> {
        var set = BootSet(records: [0; BOOT_SET_WORDS], count: 0)
        while {
            let record = try next_record(&process) catch {
                if error == SosStatus.Drained {
                    break
                }
                return error
            }
            if set.count == BOOT_SET_CAPACITY {
                panic("sos: the boot set holds more than {} records",
                      BOOT_SET_CAPACITY)
            }
            let kind = kind_of(record.1)
            let at = set.count * BOOT_HANDLE_RECORD_WORDS
            set.records[at + BOOT_HANDLE_TAG_WORD] = record.0
            set.records[at + BOOT_HANDLE_KIND_WORD] = kind as UInt
            set.records[at + BOOT_HANDLE_HANDLE_WORD] = record.2
            set.count = set.count + 1
        }
        adopt_heaps(&process, &var set)
        return move set
    }

    /// How many records the drain met, taken or not.
    public func len(&self) -> Int {
        self.count
    }

    /// The tag and kind of record `at`, in drain order, taken or not. It
    /// allocates nothing. An `at` outside `0 ..< len()` panics: the length is
    /// published, so the caller could have checked.
    public func entry(&self, at: Int) -> BootEntry {
        if at < 0 || at >= self.count {
            panic("BootSet.entry: index out of range: {} (len {})", at,
                  self.count)
        }
        let base = at * BOOT_HANDLE_RECORD_WORDS
        BootEntry(tag: self.records[base + BOOT_HANDLE_TAG_WORD],
                  kind: kind_of(self.records[base + BOOT_HANDLE_KIND_WORD]))
    }

    /// The tag and kind of every record, in drain order, taken or not. The
    /// vector is allocated, and a failure to allocate it panics.
    public func entries(&self) -> Vector<BootEntry> {
        var all = Vector<BootEntry>()
        var i: Int = 0
        while i < self.count {
            try! all.push(self.entry(at: i))
            i = i + 1
        }
        return move all
    }

    /// Take the record given under `tag`, leaving the set without it. `None`
    /// when no record has that tag or it was taken already: a tag is the
    /// giver's word, and asking for one it did not give is a question with an
    /// answer.
    public func take(&var self, tag: UInt) -> BootHandle? {
        var i: Int = 0
        while i < self.count {
            let at = i * BOOT_HANDLE_RECORD_WORDS
            if self.records[at + BOOT_HANDLE_TAG_WORD] == tag {
                let word = self.records[at + BOOT_HANDLE_HANDLE_WORD]
                if word == NO_HANDLE {
                    return None
                }
                self.records[at + BOOT_HANDLE_HANDLE_WORD] = NO_HANDLE
                let kind = self.records[at + BOOT_HANDLE_KIND_WORD]
                return decode_boot_handle(tag, kind, word)
            }
            i = i + 1
        }
        None
    }
}

/// A record's kind word, decoded. An unknown word panics, on
/// `decode_boot_handle`'s terms: the kernel wrote it out of the declaration
/// this reads, so a word that does not decode is a skew between the two.
func kind_of(word: UInt) -> BootHandleKind {
    guard let kind = BootHandleKind.from(raw: word) else {
        panic("sos: kernel wrote boot handle kind {}, which this build cannot name",
              word)
    }
    kind
}

/// The next record of `process`'s boot set, as its tag, kind and handle
/// words: the `unsafe` half of the drain, confined to one helper so the
/// buffer's address never leaves it.
func next_record(process: &Process) unsafe -> Result<(UInt, UInt, UInt), SosStatus> {
    var buf: [UInt; BOOT_HANDLE_RECORD_WORDS] = [0; BOOT_HANDLE_RECORD_WORDS]
    try checked(sos_process_boot_handle_next(process.handle,
                                             (&var buf) as UnsafePointer<UInt>,
                                             boot_handle_record_bytes() as UInt))
    return (buf[BOOT_HANDLE_TAG_WORD], buf[BOOT_HANDLE_KIND_WORD],
            buf[BOOT_HANDLE_HANDLE_WORD])
}

// -----------------------------------------------------------------------------
// Adopting the heaps
// -----------------------------------------------------------------------------
//
// A launcher gives a process one pool per heap, under the heap's slot's tag
// (`bootplan`'s `HEAP_TAG`). The drain adopts each one as its slot's heap
// before the set is handed over, so the program's first allocation can grow
// the heap. Adoption allocates nothing and maps nothing: a heap the program
// never allocates from spends no `Memory`, no `Mapping` and no slot.
//
// Each right a heap will spend is read before the program runs, and a missing
// one panics, naming it: otherwise it would be the kernel's fault inside an
// allocation, with no text. These are a heap's only panics, and none is
// raised with a heap's lock held.

import bootplan.{HEAP_TAG, MAX_HEAPS}
import sosrt.{HEAP_SLOTS, adopt_heap}
import sosabi.{PoolRight, ProcessRight, PoolHandle}
import sos.floor.{handle_rights, sos_handle_mint}
import sos.pool.{available_into_frame}

static_assert(MAX_HEAPS == HEAP_SLOTS,
              "bootplan's heap slots must be the runtime's table")

/// The rights a heap's pool must carry: `Allocate` and `Map` for the heap,
/// `Extend` for its growth, `Mint` to tell its quota refusals apart, and
/// `Transfer` and `Mint`, which a share carries.
static HEAP_POOL_RIGHTS: [PoolRight; 5] = [PoolRight.Allocate, PoolRight.Map,
                                           PoolRight.Transfer, PoolRight.Mint,
                                           PoolRight.Extend]

/// The Process sibling every heap maps through, minted once per process, or
/// `NO_HANDLE` before the first heap is adopted.
unsafe static var HEAP_PROCESS: UInt = 0

/// Adopt every pool in `set` under a heap tag as its slot's heap, taking it
/// out of the set.
///
/// For each: the pool's rights are read, and one of `Allocate`, `Map`,
/// `Transfer`, `Mint` or `Extend` missing panics; the first adoption mints a
/// `Map`-only sibling of `process`, which needs `Mint` on `process` and
/// panics without it, or when the mint is refused, or when the sibling lacks
/// `Map` (the Process ceiling); then the pool's free bytes and its grain are
/// read, and the heap is installed with no memory.
func adopt_heaps(process: &Process, set: &var BootSet) unsafe {
    var i: Int = 0
    while i < set.count {
        let at = i * BOOT_HANDLE_RECORD_WORDS
        let tag = set.records[at + BOOT_HANDLE_TAG_WORD]
        let word = set.records[at + BOOT_HANDLE_HANDLE_WORD]
        if (tag >= HEAP_TAG && tag - HEAP_TAG < (MAX_HEAPS as UInt)
            && word != NO_HANDLE) {
            let slot = (tag - HEAP_TAG) as Int
            let kind = set.records[at + BOOT_HANDLE_KIND_WORD]
            if kind != (BootHandleKind.Pool as UInt) {
                panic("sos: heap {}'s record is not a pool", slot)
            }
            adopt(slot, word, &process)
            set.records[at + BOOT_HANDLE_HANDLE_WORD] = NO_HANDLE
        }
        i = i + 1
    }
}

/// Adopt the pool `word` as heap `slot`'s.
func adopt(slot: Int, word: UInt, process: &Process) unsafe {
    let rights = try handle_rights(word) catch {
        panic("sos: heap {}'s pool's rights cannot be read: {}", slot, error)
    }
    var r: Int = 0
    while r < 5 {
        let right = HEAP_POOL_RIGHTS[r]
        if (rights & (right as UInt32)) == 0 {
            panic("sos: heap {}'s pool lacks {}", slot, pool_right_name(right))
        }
        r = r + 1
    }
    let sibling = heap_process(&process)
    let free = try available_into_frame(PoolHandle(word), 0) catch {
        panic("sos: heap {}'s pool cannot be read: {}", slot, error)
    }
    let grains = free.granularities
    adopt_heap(slot, word, sibling, free.total, grains & (0 &- grains))
}

/// The `Map`-only sibling of `process` every heap maps its row through,
/// minted on the first call.
func heap_process(process: &Process) unsafe -> UInt {
    if HEAP_PROCESS != NO_HANDLE {
        return HEAP_PROCESS
    }
    let rights = try process.rights() catch {
        panic("sos: the Process handle's rights cannot be read: {}", error)
    }
    if (rights & (ProcessRight.Mint as UInt32)) == 0 {
        panic("sos: the Process handle lacks Mint, so no heap can be adopted")
    }
    var sibling: UInt = NO_HANDLE
    let minted = sos_handle_mint(process.handle, ProcessRight.Map as UInt,
                                 (&var sibling) as UnsafePointer<UInt>)
    try checked(minted) catch {
        panic("sos: no handle for the heaps: {}", error)
    }
    let kept = try handle_rights(sibling) catch {
        panic("sos: the heaps' Process handle's rights cannot be read: {}",
              error)
    }
    if (kept & (ProcessRight.Map as UInt32)) == 0 {
        panic("sos: the heaps' Process handle lacks Map (the Process ceiling)")
    }
    HEAP_PROCESS = sibling
    sibling
}

/// A pool right's name, for adoption's panic.
func pool_right_name(right: PoolRight) -> String {
    match right {
        case Allocate -> "Allocate",
        case Map -> "Map",
        case Transfer -> "Transfer",
        case Mint -> "Mint",
        case Extend -> "Extend",
        case MapExecute -> "MapExecute",
    }
}
