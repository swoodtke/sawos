//! The runtime's three hooks, process side.
//!
//! `sosrt` implements the frozen `__saw_rt_*` seams over three per-side hooks:
//! where a byte goes, how the machine stops, and which thread asks. The kernel
//! HAL answers "the UART" and "the board's stop". A process owns no device, so
//! it answers "a System op" to both. If `panic()` could reach a UART from
//! userspace, the user/kernel split would be claimed rather than real. The
//! third it answers from the thread register (the foot of this file).
//!
//! They live here, not in `hal/<arch>/user/`, because they name no architecture
//! (a byte reaches the console through a System op, the same op on every
//! profile; the thread register is read through the user HAL's accessors) and
//! belong to whoever owns the System object.
//!
//! This is the top of the module order because the first two hooks are written
//! over a System op: the byte goes out through `sos_system_debug_print` and the
//! machine stops through `sos_system_shutdown`. The handle they use is parked
//! at the floor by `System(boot_handle:)`, which neither hook can do for
//! itself.

import sos.floor.{SYSTEM_HANDLE, sos_system_debug_print, sos_system_shutdown}

/// Write `len` bytes at `ptr` to the debug console. This is the panic path's
/// writer.
///
/// Check-free by construction, on the same terms as the kernel HAL's writer: it
/// runs while a panic is being reported, so a bounds or overflow check that
/// tripped here would re-enter `__saw_rt_panic` and hang or garble the one
/// diagnostic that matters. So: no indexing (raw `UnsafeMemory` reads), no
/// allocation, no `String`, and a cursor that advances with wrapping arithmetic
/// (`&+` / `&-`) so even a nonsensical length cannot raise an overflow trap.
///
/// A per-byte status is dropped on purpose. There is nowhere to report it (the
/// console is the thing that would have failed), and a second channel for "the
/// console is broken" is how a panic path stops being one.
@export("sos_rt_write")
func rt_write(ptr: UnsafePointer<Int8>, len: UInt) unsafe {
    if SYSTEM_HANDLE == 0 {
        return
    }
    var addr = ptr as UInt
    var left = len
    while left != 0 {
        let byte = UnsafeMemory<UInt8, Normal>(addr).read()
        let _ = sos_system_debug_print(SYSTEM_HANDLE, byte as UInt)
        addr = addr &+ 1
        left = left &- 1
    }
}

/// Stop the machine with `code`, for the common runtime.
///
/// `-> Never` is what `sosrt` declares this hook to be, and it holds twice
/// over: `shutdown` does not return when it succeeds, and when it is refused
/// (no handle was ever parked, or the right was stripped) there is nothing left
/// to try, so the loop keeps a failed abort from running off the end of the
/// granted region.
@export("sos_rt_abort")
func rt_abort(code: UInt32) unsafe -> Never {
    let _ = sos_system_shutdown(SYSTEM_HANDLE, code as UInt)
    while { }
}

// The calling thread's own word: the thread register, read and written by the
// user HAL (`hal/<arch>/user/syscall.c`). The kernel keeps it per thread and
// starts every thread with it zero.
extern "C" {
    func sos_thread_word() -> UInt
    func sos_set_thread_word(word: UInt)
}

/// The last thread identity this process handed out; zero names none.
static LAST_OWNER: Atomic<Int> = Atomic(0)

/// Which thread is asking, for `sosrt`'s lock-owner seam: nonzero, and
/// distinct between any two threads of this process.
///
/// A thread's first call takes the next number and keeps it in its thread
/// register; every later call reads it back. It allocates nothing and cannot
/// panic. A program that writes the thread register itself changes the
/// answer. Two processes number their threads independently, so a lock in
/// memory two processes share is not told apart by it. The count is a word, so
/// on a 32-bit profile it wraps after 2^32 first asks in one process and
/// numbers repeat from there.
@export("sos_rt_lock_owner")
func rt_lock_owner() unsafe -> Int {
    let word = sos_thread_word()
    if word != 0 {
        return Int.from(truncating: word)
    }
    let fresh = LAST_OWNER.fetch_add(1) &+ 1
    sos_set_thread_word(UInt.from(truncating: fresh))
    fresh
}
