//! The runtime's four hooks, process side.
//!
//! `sosrt` implements the frozen `__saw_rt_*` seams over four per-side hooks:
//! where a byte goes, how a run ends with a text, which thread asks, and how a
//! thread waiting for the output lock gives the processor up. The kernel HAL
//! answers "the UART" and "write the text, stop the board". A process owns no
//! device, so it answers with kernel ops: a byte goes to the console's driver
//! over a pipe, or out through a System op in a process with no console (the
//! console's section, at the end), and the end is the kernel's panic op,
//! which puts the text on its fault line and ends the process. If `panic()`
//! could reach a UART from userspace, the user/kernel split would be claimed
//! rather than real. The last two it
//! answers from the thread register, whose layout this file also keeps: the
//! blocks, and the start record of a thread `thread_create(run:)` makes.
//!
//! They live here, not in `hal/<arch>/user/`, because they name no
//! architecture: the System op and the panic op are the same ops on every
//! profile, and the thread register is read through the user HAL's accessors.
//!
//! This sits above the floor because the hooks are written over the floor's
//! ops, and below `sos.system`, whose `thread_create(run:)` makes its threads
//! at the entry this file keeps. With no console the byte goes out through
//! `sos_system_debug_print`, on the handle `System(boot_handle:)` parks at the
//! floor, which the hook cannot do for itself; the end goes through
//! `sos_panic`, which needs no handle.

import sos.floor.{SYSTEM_HANDLE, PRINT_ANSWER, PRINT_UNASKED, PRINT_DEBUG,
                  PRINT_SILENT, sos_handle_info, sos_system_debug_print,
                  sos_panic, sos_thread_yield}
import sos.thread.{Thread}
import sosabi.{PANIC_TEXT_BYTES, NO_HANDLE, ThreadHandle, HandleInfo,
               HandleKind, SystemRight}

/// Write `len` bytes at `ptr` to the console: `print`'s writer.
///
/// Once a console is adopted the bytes go to its driver (`console_write`).
/// Until then, and in a process with none, they go out through the kernel's
/// debug print when the parked handle is a System holding `Debug`, and are
/// dropped otherwise, so a process without the right prints nothing rather
/// than faulting (`may_print`).
///
/// Check-free by construction, on the same terms as the kernel HAL's writer: no
/// indexing (raw `UnsafeMemory` reads), no allocation, no `String`, and a
/// cursor that advances with wrapping arithmetic (`&+` / `&-`), so even a
/// nonsensical length cannot raise an overflow trap inside `print`.
///
/// A per-byte status is dropped on purpose: there is nowhere to report it, and
/// the console is the thing that would have failed.
@export("sos_rt_write")
func rt_write(ptr: UnsafePointer<Int8>, len: UInt) unsafe {
    if CONSOLE != NO_HANDLE {
        console_write(ptr as UInt, len)
        return
    }
    if not may_print() {
        return
    }
    var addr = ptr as UInt
    var left = len
    while left != 0 {
        let byte = UnsafeMemory<UInt8, Normal>(addr).read()
        let _ = sos_system_debug_print(SYSTEM_HANDLE, byte as UInt)
        addr = addr &+ 1
        left = left &- 1
    }
}

/// Whether the parked handle prints: a System whose rights hold `Debug`.
///
/// A handle of `NO_HANDLE` answers no without a call. Otherwise the first
/// write asks the kernel for the handle's kind and rights (`INFO_OP`, which no
/// right gates) and keeps the answer until a handle is parked again. Two
/// threads that ask at once each ask, and keep the same answer.
///
/// The kind is asked first because a launcher may start a process on a word of
/// any kind, and another kind's rights word gives the bit `Debug` sits at a
/// meaning of its own.
func may_print() unsafe -> Bool {
    let handle = SYSTEM_HANDLE
    if handle == NO_HANDLE {
        return false
    }
    let known = PRINT_ANSWER.load()
    if known != PRINT_UNASKED {
        return known == PRINT_DEBUG
    }
    let answer = if holds_debug(handle) { PRINT_DEBUG } else { PRINT_SILENT }
    PRINT_ANSWER.store(answer)
    answer == PRINT_DEBUG
}

/// Whether `handle` names a System and its rights hold `Debug`.
func holds_debug(handle: UInt) unsafe -> Bool {
    var kind: UInt = 0
    let _ = sos_handle_info(handle, HandleInfo.Kind as UInt,
                            (&var kind) as UnsafePointer<UInt>)
    if kind != (HandleKind.System as UInt) {
        return false
    }
    var rights: UInt = 0
    let _ = sos_handle_info(handle, HandleInfo.Rights as UInt,
                            (&var rights) as UnsafePointer<UInt>)
    (rights & (SystemRight.Debug as UInt)) != 0
}

/// The words of the buffer a panic's text is copied into: the kernel's bound,
/// which is a whole number of words on every profile.
static PANIC_COPY_WORDS: Int = PANIC_TEXT_BYTES / sizeof<UInt>()

static_assert(PANIC_TEXT_BYTES % sizeof<UInt>() == 0,
              "the panic text's bound is a whole number of words")

/// What a cut copy ends with, and how many of it: `...`.
static CUT_MARK: UInt8 = 0x2Eu8
static CUT_MARK_BYTES: UInt = 3

/// End this process as a panic, for the common runtime: `len` bytes at `ptr`
/// become the text of the kernel's fault line.
///
/// The text is copied first into a word-aligned buffer on this stack, because
/// the kernel reads it through the copy-in door, which takes only a
/// word-aligned buffer, and the text's own source need not be one: the
/// compiler's message scratch, or a literal in read-only data.
/// At most `PANIC_TEXT_BYTES` are copied. A longer text is cut there and its
/// last bytes become `...`, so the line shows the cut, where the kernel's own
/// cut would end it silently.
///
/// `code` is not read: the reason in the status word and the kernel's line say
/// it all, and the text says which end it was. No handle is read either, so a
/// process started with none, or on a word that is not a System, ends the same
/// way.
///
/// Check-free by construction, on `rt_write`'s terms: raw `UnsafeMemory` reads
/// and writes, and wrapping arithmetic.
@export("sos_rt_abort")
func rt_abort(ptr: UnsafePointer<Int8>, len: UInt,
              code: UInt32) unsafe -> Never {
    var buf: [UInt; PANIC_COPY_WORDS] = [0; PANIC_COPY_WORDS]
    let dst = ((&var buf) as UnsafePointer<UInt>) as UInt
    let bound = UInt.from(truncating: PANIC_TEXT_BYTES)
    var n = len
    if n > bound {
        n = bound
    }
    let src = ptr as UInt
    var i: UInt = 0
    while i != n {
        let byte = UnsafeMemory<UInt8, Normal>(src &+ i).read()
        UnsafeMemory<UInt8, Normal>(dst &+ i).write(byte)
        i = i &+ 1
    }
    if len > bound {
        var at = n &- CUT_MARK_BYTES
        while at != n {
            UnsafeMemory<UInt8, Normal>(dst &+ at).write(CUT_MARK)
            at = at &+ 1
        }
    }
    sos_panic(dst as UnsafePointer<Int8>, n)
}

// The calling thread's own word: the thread register, read and written by the
// user HAL (`hal/<arch>/user/syscall.c`). The kernel keeps it per thread and
// starts every thread with it zero.
//
// Its low bit says what it holds. Zero is nothing yet. An odd word is a
// number the lock-owner hook below handed out. An even word that is not zero
// is the address of the thread's block (`ThreadBlock`), which the thread
// wrote before it took its first lock. A thread's word is written once and
// never changes after, so a lock never sees its holder's identity change. A
// program that writes the register itself breaks all of this.
extern "C" {
    func sos_thread_word() -> UInt
    func sos_set_thread_word(word: UInt)
}

/// The last thread number this process handed out; zero names none.
static LAST_OWNER: Atomic<Int> = Atomic(0)

/// Which thread is asking, for `sosrt`'s lock-owner seam: nonzero, and
/// distinct between any two threads of this process.
///
/// A thread's word is its identity when it has one: its block's address, or a
/// number an earlier call gave it. A thread with none takes the next number,
/// made odd so that no number equals a block's address, and keeps it in its
/// thread register. It allocates nothing and cannot panic. Two processes
/// number their threads independently, so a lock in memory two processes
/// share is not told apart by it. The count is a word, so on a 32-bit profile
/// it wraps after 2^31 first asks in one process and numbers repeat from
/// there.
@export("sos_rt_lock_owner")
func rt_lock_owner() unsafe -> Int {
    let word = sos_thread_word()
    if word != 0 {
        return Int.from(truncating: word)
    }
    let number = LAST_OWNER.fetch_add(1) &+ 1
    let fresh = (UInt.from(truncating: number) << 1) | 1
    sos_set_thread_word(fresh)
    Int.from(truncating: fresh)
}

/// Give the processor up while the output lock is held by another thread: the
/// output lock's yield hook.
///
/// It yields through the calling thread's own Thread handle, which its block
/// holds. A thread with no block, or a block holding no handle yet, does
/// nothing, and its wait spins until a tick moves it. That cannot hang: a
/// holder parks inside the lock only on a console's ring, and only a thread
/// with a block writes to one.
@export("sos_rt_yield")
func rt_yield() unsafe {
    let word = sos_thread_word()
    if word == 0 || (word & 1) != 0 {
        return
    }
    let thread = UnsafeMemory<ThreadBlock, Normal>(word).read().thread
    if thread == NO_HANDLE {
        return
    }
    let _ = sos_thread_yield(thread)
}

/// A thread's block: the per-thread place its thread register names, holding
/// the thread's own Thread handle, through which the output lock's wait
/// yields.
///
/// The block lives for its thread's life wherever the thread put it: the main
/// thread's in `sosmain`'s start-up frame, and a `thread_create(run:)`
/// thread's at the head of its start record, at the top of its stack. Its
/// address is word-aligned and nonzero, so it serves as the thread's
/// lock-owner identity as it is.
public struct ThreadBlock {
    private thread: UInt,
}

extension ThreadBlock {
    /// A block holding no handle yet.
    public init() -> ThreadBlock {
        ThreadBlock(thread: NO_HANDLE)
    }

    /// Keep `thread`, the calling thread's own handle, for the rest of the
    /// process's life: the wrapper is given up without a release, and the
    /// process's end releases the handle.
    public func keep(&var self, thread: Thread) {
        var own = move thread
        self.thread = own.handle
        own.handle = ThreadHandle(NO_HANDLE)
    }
}

/// Make `block` the calling thread's block: write its address into the
/// thread register.
///
/// It is made once per thread, before the thread takes its first lock, so the
/// thread's lock-owner identity is the block's address from the start; and
/// `block` stays where it is for the rest of the thread's life.
public func enter_thread_block(block: UnsafePointer<ThreadBlock>) unsafe {
    sos_set_thread_word(block as UInt)
}

// -----------------------------------------------------------------------------
// A thread's real entry
// -----------------------------------------------------------------------------
//
// `Process.thread_create(run:arg:stack_top:)` makes every thread at one
// entry, the trampoline below, and hands it the address of a start record
// written just below the stack top: the entry to run, its argument, the
// thread's own handle and an abandon flag. The trampoline's first act makes
// the record the thread's block, so the record stays where it is for the
// thread's life and its head is the `ThreadBlock` the output lock's yield
// reads.

import sosabi.{SosStatus, ProcessOp, ThreadRight}
import sos.floor.{call_value, checked, handle_rights, sos_handle_mint,
                  sos_thread_start, sos_thread_exit}

/// A thread's start record. The block comes first: the thread register
/// names the record, and a reader of a block reads it there.
struct StartRecord {
    block: ThreadBlock,
    /// The address of the `run` the thread calls.
    entry: UInt,
    arg: UInt,
    /// Nonzero for a thread made only to be unwound: it exits at once,
    /// without calling `run`.
    abandon: UInt,
}

/// The grain the stack given to the kernel is rounded down to: every profile
/// wants a 16-byte-aligned stack pointer.
static STACK_GRAIN: UInt = 16

/// The rights the created thread's handle must hold: `Start` to start it,
/// `Mint` for the thread's own handle, and `Control`, through which the
/// thread yields and exits.
static ENTRY_RIGHTS: UInt32 = ((ThreadRight.Start as UInt32)
                               | (ThreadRight.Mint as UInt32)
                               | (ThreadRight.Control as UInt32))

/// Make a thread of the process `process` names, which is the caller's own,
/// that runs `entry(arg)` on the stack below `stack_top`:
/// `Process.thread_create(run:arg:stack_top:)`'s body.
///
/// The start record is written once the kernel has made the thread, so a
/// stack top the kernel refuses is refused before anything is written below
/// it. The thread's own handle is a `Control`-only sibling of the created
/// one. A refused mint is unwound by starting the thread on an abandoned
/// record holding the created handle's word: the thread exits through that
/// word at once, which releases it, and an exited thread with no handle left
/// is freed, so its Thread and Handle rows come back once it has run.
public(package) func create_thread(process: UInt, entry: UInt, arg: UInt,
                                   stack_top: UInt) unsafe -> Result<Thread, SosStatus> {
    let below = stack_top &- (sizeof<StartRecord>() as UInt)
    let at = below & ~(STACK_GRAIN &- 1)
    let trampoline: FuncPointer<(UInt) sync -> Never> = thread_entry
    let created = try call_value(process, ProcessOp.ThreadCreate as UInt,
                                 trampoline.address(), at, at)
    let rights = try handle_rights(created) catch {
        panic("sos: the new thread's rights cannot be read: {}", error)
    }
    if (rights & ENTRY_RIGHTS) != ENTRY_RIGHTS {
        panic("sos: thread_create(run:) needs Start, Mint and Control on the new thread's handle")
    }
    let record = UnsafeMemory<StartRecord, Normal>(at)
    var own: UInt = 0
    let minted = sos_handle_mint(created, ThreadRight.Control as UInt,
                                 (&var own) as UnsafePointer<UInt>)
    try checked(minted) catch {
        record.write(StartRecord(block: ThreadBlock(thread: created),
                                 entry: entry, arg: arg, abandon: 1))
        try checked(sos_thread_start(created)) catch {
            panic("sos: the unwound thread's start was refused: {}", error)
        }
        return error
    }
    record.write(StartRecord(block: ThreadBlock(thread: own), entry: entry,
                             arg: arg, abandon: 0))
    return Thread(handle: ThreadHandle(created))
}

/// The entry of every thread `create_thread` makes: `at` is its start
/// record's address.
func thread_entry(at: UInt) sync -> Never {
    run_thread(at)
}

/// Make the start record the calling thread's block before anything can take
/// a lock, call the entry it names with its argument, and exit with what the
/// entry returns, through the thread's own handle, which the exit releases.
/// An abandoned record exits at once with 0.
func run_thread(at: UInt) unsafe sync -> Never {
    sos_set_thread_word(at)
    let record = UnsafeMemory<StartRecord, Normal>(at).read()
    var code: UInt = 0
    if record.abandon == 0 {
        let run = FuncPointer<(UInt) sync -> UInt>.from_raw(
            record.entry as UnsafePointer<UInt8>)
        code = run(record.arg)
    }
    try checked(sos_thread_exit(record.block.thread, code)) catch {
        panic("sos: the thread's exit was refused: {}", error)
    }
    while { }
}

// -----------------------------------------------------------------------------
// The console
// -----------------------------------------------------------------------------
//
// A process's console is a client inlet of a `uartproto` driver's
// connection, which the runtime adopts once and holds until the process ends
// (`adopt_console`). Every write is a `Write` message, the write op byte
// followed by the bytes, built on the writer's stack. The runtime speaks the
// wire at this floor rather than through a typed client, because the writer
// runs inside a panic report, where nothing may allocate or trip a check. The
// op bytes come from the caller, so this package names no driver protocol.
//
// A write is posted, a tell, and the claim the post mints is released at
// once, so a piece costs two traps and never waits for the driver. A post
// refused for room (a full ring, or no row in the caller's table for the
// claim) is sent as a call instead, which mints no claim and parks until the
// driver answers: a client that fills the ring waits for the driver, which is
// when the driver runs, and a client with no handle to spare prints all the
// same. A driver that is gone takes nothing, and the bytes are dropped; the
// loss is kept, so the next `console_sync` meets the gone driver and says so.
//
// The output lock guards the unsynced flag: every write comes here under it,
// and `console_sync` takes it.

import sos.pipe.{PipeInlet}
import sos.floor.{sos_pipe_inlet_post, sos_pipe_inlet_call, sos_handle_release}
import sosabi.{PIPE_BODY_BYTES, PIPE_MSG_HANDLES, PipeSendRecord,
               PipeMsgRecord, PipeMsgMeta, PipeInletHandle,
               pipe_send_record_bytes}
import sosrt.{LINE_CHUNK, rt_output_lock, rt_output_unlock}

static_assert(LINE_CHUNK == PIPE_BODY_BYTES - 1,
              "a line's piece is a pipe body less the op byte")

/// The console's inlet once it is adopted, and `NO_HANDLE` before that and in
/// a process with none.
unsafe static var CONSOLE: UInt = 0

/// The protocol's op bytes for a write and a sync, given at the adoption.
unsafe static var CONSOLE_WRITE_OP: UInt8 = 0
unsafe static var CONSOLE_SYNC_OP: UInt8 = 0

/// Whether a write was posted, or dropped, since the last answered `Sync`.
unsafe static var CONSOLE_UNSYNCED: Bool = false

/// A message body's length in doublewords: a `[UInt64; N]` local is
/// eight-aligned on every profile, which the copy-in door's word alignment
/// needs.
static CONSOLE_BODY_DWORDS: Int = 16

static_assert(CONSOLE_BODY_DWORDS * 8 == PIPE_BODY_BYTES,
              "the body buffer covers exactly one pipe body")

/// Adopt `inlet` as this process's console: from here on `print` writes to
/// the driver at its far end, with `write_op` and `sync_op` the protocol's
/// op bytes for a write and a sync.
///
/// The runtime holds the handle until the process ends and nothing releases
/// it, so the driver serves this process for its whole life. A process has
/// one console: a second adoption panics.
///
/// It allocates nothing.
public func adopt_console(inlet: PipeInlet, write_op: UInt8,
                          sync_op: UInt8) unsafe {
    if CONSOLE != NO_HANDLE {
        panic("sos: a console is adopted already")
    }
    var own = move inlet
    CONSOLE_WRITE_OP = write_op
    CONSOLE_SYNC_OP = sync_op
    CONSOLE = own.handle
    own.handle = PipeInletHandle(NO_HANDLE)
}

/// Make every write posted so far reach the console before what follows: a
/// `Sync`, sent when a write was posted or dropped since the last one was
/// answered. It answers at once otherwise, and in a process with no console.
/// A connection's ring is first in, first out, so the answer means the driver
/// has served every earlier message.
///
/// The `Sync` is a call, which parks until the driver answers: a driver that
/// has stopped serving without its connection going parks it for good.
/// `Err(SosStatus.PeerClosed)` is a driver that is gone: a write it dropped,
/// or one posted that it never served, did not reach the console. Every call
/// after that answers the same, since what was lost stays lost.
public func console_sync() unsafe -> Result<Void, SosStatus> {
    rt_output_lock()
    let synced = sync_posted()
    rt_output_unlock()
    synced
}

func sync_posted() unsafe -> Result<Void, SosStatus> {
    if CONSOLE == NO_HANDLE || not CONSOLE_UNSYNCED {
        return
    }
    var body: [UInt64; CONSOLE_BODY_DWORDS] = [0; CONSOLE_BODY_DWORDS]
    let at = ((&var body) as UnsafePointer<UInt64>) as UInt
    let len = console_body(at, CONSOLE_SYNC_OP, 0, 0)
    try checked(console_call(at, len))
    CONSOLE_UNSYNCED = false
    return
}

/// Write `len` bytes at `at` to the console, as consecutive `Write` messages
/// of at most `LINE_CHUNK` bytes each.
///
/// Check-free by construction, on `rt_write`'s terms.
func console_write(at: UInt, len: UInt) unsafe {
    let most = UInt.from(truncating: LINE_CHUNK)
    var addr = at
    var left = len
    while left != 0 {
        let n = if left < most { left } else { most }
        console_send(addr, n)
        addr = addr &+ n
        left = left &- n
    }
}

/// Send one `Write` of the `n` bytes at `src`: a post whose claim is released
/// at once, or a call when the post is refused for room. A write neither
/// takes, the driver being gone, is marked unsynced, so the next sync reports
/// it.
func console_send(src: UInt, n: UInt) unsafe {
    var body: [UInt64; CONSOLE_BODY_DWORDS] = [0; CONSOLE_BODY_DWORDS]
    let at = ((&var body) as UnsafePointer<UInt64>) as UInt
    let len = console_body(at, CONSOLE_WRITE_OP, src, n)
    var args = PipeSendRecord(body: at, len: len,
                              handles: [NO_HANDLE; PIPE_MSG_HANDLES])
    var claim: UInt = 0
    let raw = sos_pipe_inlet_post(CONSOLE,
                                  (&var args) as UnsafePointer<UInt>,
                                  UInt.from(truncating: pipe_send_record_bytes()),
                                  (&var claim) as UnsafePointer<UInt>)
    if raw == (SosStatus.Ok as UInt) {
        let _ = sos_handle_release(claim)
        CONSOLE_UNSYNCED = true
        return
    }
    if refused_for_room(raw) {
        let answer = console_call(at, len)
        if answer == (SosStatus.Ok as UInt) {
            return
        }
    }
    CONSOLE_UNSYNCED = true
}

/// Whether a post's status is a refusal a call does not meet: a full ring
/// (`WouldBlock`), or no room for the claim a post mints (`QuotaExceeded` at
/// the caller's quota, `NoResource` with its table full).
func refused_for_room(raw: UInt) -> Bool {
    (raw == (SosStatus.WouldBlock as UInt)
     || raw == (SosStatus.QuotaExceeded as UInt)
     || raw == (SosStatus.NoResource as UInt))
}

/// Write a message into the body buffer at `at`: the op byte `op`, then the
/// `n` bytes at `src`. Answers the message's length.
func console_body(at: UInt, op: UInt8, src: UInt, n: UInt) unsafe -> UInt {
    UnsafeMemory<UInt8, Normal>(at).write(op)
    var i: UInt = 0
    while i != n {
        let byte = UnsafeMemory<UInt8, Normal>(src &+ i).read()
        UnsafeMemory<UInt8, Normal>(at &+ 1 &+ i).write(byte)
        i = i &+ 1
    }
    n &+ 1
}

/// Send the `len`-byte message at `at` to the console as a call, and answer
/// the call's status word. The reply's bytes are not read.
///
/// The reply buffer is a whole delivered-message record, because the kernel
/// checks it against `pipe_msg_record_bytes()` and writes that much.
func console_call(at: UInt, len: UInt) unsafe -> UInt {
    var args = PipeSendRecord(body: at, len: len,
                              handles: [NO_HANDLE; PIPE_MSG_HANDLES])
    var reply = PipeMsgRecord(meta: PipeMsgMeta(len: 0,
                                                kinds: [0; PIPE_MSG_HANDLES]),
                              handles: [NO_HANDLE; PIPE_MSG_HANDLES],
                              sender: 0,
                              bytes: [0; PIPE_BODY_BYTES])
    var value: UInt = 0
    sos_pipe_inlet_call(CONSOLE, (&var args) as UnsafePointer<UInt>,
                        UInt.from(truncating: pipe_send_record_bytes()),
                        (&var reply) as UnsafePointer<UInt>,
                        (&var value) as UnsafePointer<UInt>)
}
