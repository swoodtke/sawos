//! Waiter: §2.2's generic wait aggregator.
//!
//! `add` is one overload per kind, so this file imports `Event`, `Interrupt`
//! and `Timer`, and none of those modules imports this one.
//!
//! The `add` overloads for kinds declared in modules that import this one live
//! beside those kinds, as `extension Waiter` (visible at the call site through
//! the facade's `public import`): `Process`'s in `sos.system` and the pipe
//! kinds' `add`/`give` overloads in `sos.pipe`. An overload written here would
//! make this module import its own importer, a cycle. For the same reason
//! `wait` and the decode of the record the kernel copies back live in
//! `sos.pipe`: a delivery may carry handles, which are owning wrappers
//! (`PipeReply`, `Memory`) this module cannot import.
//!
//! What stays here is what a Waiter is: the object, the attach modes, the
//! subscription verbs and the one wire call under them.

import sosabi.{SosStatus, WaiterHandle, NO_HANDLE, EventHandle,
               TimerHandle, WAITER_ADD_CONSUMING,
               WAITER_ADD_ONESHOT, MINT_OP}

import sos.floor.{checked, sos_handle_release, sos_waiter_add,
                  sos_waiter_remove, ALL_RIGHTS, call_value, handle_rights}
import sos.event.{Event}
import sos.interrupt.{Interrupt}
import sos.timer.{Timer}

/// What an attachment does at delivery.
///
/// One-shot is a property of the attachment, the attacher's choice like the
/// key, so it is a defaulted trailing parameter on every `add` rather than a
/// second method per kind.
///
/// It is not the other axis. Whether the attach consumes the caller's handle is
/// spelled by a different verb (`give`), not a third case here: consuming
/// changes what the call does to its argument, and a runtime flag can change
/// neither a return type nor a Saw function's effect. Don't add an
/// `OneShotConsuming` case: it conflates the two axes.
public enum AttachMode: UInt {
    /// Stay subscribed. The attachment lives until `remove(key)` or until the
    /// Waiter does (§2.2's default).
    case Persistent = 0,
    /// Detach when a record for this key is copied out, never at mere
    /// readiness. A blocked poster's room-wait, a request-abandoned watcher and
    /// a wait-once death supervisor all stop owing a trailing `remove`.
    case OneShot = 1,
}

/// The flag bit `mode` becomes at the wire. A `match` rather than a cast: the
/// enum's numbers are the typed surface's own and the wire's are `sosabi`'s,
/// and the two are allowed to differ.
public(package) func mode_flag(mode: AttachMode) -> UInt {
    match mode {
        case Persistent -> 0,
        case OneShot -> WAITER_ADD_ONESHOT,
    }
}

// The decode of the delivery record and `Waiter.wait` live in `sos.pipe`; see
// the module docstring.

/// A handle to a Waiter, §2.2's generic wait aggregator (epoll/Port-style).
///
/// Attachments are persistent by default: `add` once, and the handle stays
/// watched until `remove`. `AttachMode.OneShot` opts into detaching at the
/// delivery. Readiness is level-triggered either way, so a signal that lands
/// before anyone waits is still there when the wait arrives.
///
/// The one-shot footgun is stated rather than guarded: attach one-shot, take
/// the delivery, and `wait()` again on a Waiter with nothing left attached, and
/// the thread parks forever, which the kernel reports as a deadlock, as for
/// any empty Waiter. A subscription that ends itself is one you have to re-arm.
///
/// Several threads may park on one Waiter (§2.2), and a ready handle wakes one
/// of them. An object is attached to at most one Waiter, whichever handle
/// names it, and attaching one that is already attached terminates the
/// process. Holders of one object must agree which of them attaches it.
///
/// `NoCopy`, and dropping it releases the handle. Attachments belong to the
/// Waiter object, not to the handle, so releasing one handle detaches nothing
/// while another still names the Waiter. When the last handle goes the Waiter
/// is freed: every attachment is released, and every thread parked on it
/// wakes with `SosStatus.Revoked`.
///
/// A Waiter is bound to the process that created it (§2.10). When that process
/// dies, a Waiter still named elsewhere loses its attachments the same way,
/// its parked threads wake with `SosStatus.Revoked`, and every later `add`,
/// `remove`, `wait` and `mint` answers `Err(SosStatus.Revoked)`. It is built by
/// `Process.waiter_create`, handed back by a refused `Process.give(waiter:)`,
/// and delivered by a message as `PipeHandle.Waiter` or a boot record through
/// `BootHandle.take_waiter`.
public struct Waiter {
    public(package) handle: WaiterHandle,
}

extension Waiter: NoCopy {
    /// Drop is release; see `System`'s deinit for the sentinel and the discard.
    func deinit(&var self) {
        if self.handle != NO_HANDLE {
            let _ = sos_handle_release(self.handle)
        }
    }
}

extension Waiter {
    /// This handle's rights word, read from the kernel (`INFO_OP`), to test
    /// against `WaiterRight` bits. It is the handle's own word, so a sibling
    /// from `mint(rights:)` or a handle received with a keep mask reports the
    /// narrowed set. No right gates it, and it answers for a handle to an
    /// invalid object too, since it describes the handle and not the object. A
    /// live handle resolves, so the error channel carries only a kernel skew
    /// (`SosStatus.Unknown`).
    public func rights(&self) -> Result<UInt32, SosStatus> {
        handle_rights(self.handle)
    }

    /// Attach `event` under `key`, which `wait` hands back when it becomes
    /// ready. Requires `WaiterRight.Attach` here and `EventRight.Wait` there.
    ///
    /// Keys are unique per Waiter: `key` must not already name an attachment on
    /// this Waiter, and reusing one terminates the process. `remove` and the
    /// wait answer both rest on that; with two attachments under one key,
    /// neither could say which it meant.
    ///
    /// It takes a `&Event`, not a handle word: there is no way to spell a
    /// handle you were not given, so an attachment names an object this process
    /// holds by construction. The field access below is same-package (each
    /// waitable's `handle` is `public(package)`), so no accessor is owed.
    ///
    /// There is one method per waitable kind, on purpose. Don't introduce a
    /// `Waitable` trait: a public trait with a handle-producing requirement is
    /// a forged-handle door under the orphan rule, and Saw has no sealed
    /// traits. Kinds are a list, so overloads are a list; modes are what
    /// multiply, which is why `event_create` takes its mode as a value. Each
    /// overload is two lines delegating to one internal, so the wire call has
    /// one caller.
    public func add(&self, event: &Event, key: UInt,
                    mode: AttachMode = AttachMode.Persistent) -> Result<Void, SosStatus> {
        self.attach(event.handle, key, mode_flag(mode))
    }

    /// Attach an Interrupt under `key`, which `wait` hands back with the line
    /// when it fires. Requires `WaiterRight.Attach` here and
    /// `InterruptRight.Wait` there.
    ///
    /// Every rule the Event overload states holds unchanged: keys are unique
    /// per Waiter, an object is attached to at most one Waiter, and readiness
    /// is level-triggered, so an Interrupt that fired before it was attached is
    /// reported by this call. A driver hits that ordering when the device was
    /// already asserting at bring-up.
    ///
    /// There is no `give(interrupt:)`: an Interrupt's handle is its one name
    /// and the only thing that can `ack` it, so it is borrowed, never consumed.
    /// The attachment does not keep the Interrupt alive. If the handle is
    /// released while the attachment stands, the Interrupt is destroyed (its
    /// line is unbound and bindable again) and the attachment reports it as a
    /// wait record whose line is the board's no-line value and never a real
    /// one. The level is terminal: every wait reports it until the attachment
    /// is removed (§2.10).
    public func add(&self, interrupt: &Interrupt, key: UInt,
                    mode: AttachMode = AttachMode.Persistent) -> Result<Void, SosStatus> {
        self.attach(interrupt.handle, key, mode_flag(mode))
    }

    /// Attach a Timer under `key`, which `wait` hands back with the fire count
    /// when it comes due. Requires `WaiterRight.Attach` here and
    /// `TimerRight.Wait` there.
    ///
    /// Every rule the Event overload states holds unchanged: keys are unique
    /// per Waiter, an object is attached to at most one Waiter, and readiness
    /// is level-triggered, so a Timer that fired before it was attached is
    /// reported by this call rather than lost.
    ///
    /// A disarmed Timer is never ready, so attaching one and waiting parks
    /// until somebody arms it. "Arm, then wait" and "attach, then arm" both
    /// work.
    public func add(&self, timer: &Timer, key: UInt,
                    mode: AttachMode = AttachMode.Persistent) -> Result<Void, SosStatus> {
        self.attach(timer.handle, key, mode_flag(mode))
    }

    // The Process overload is declared in `sos.system`; see the module
    // docstring.

    /// The one call the per-kind overloads share. `public(package)`, not
    /// `public`: a raw handle word crosses here and nowhere else, and the
    /// no-forged-handles rule rests on this form being unreachable from user
    /// code. Package width exists for the overloads in `sos.pipe` and
    /// `sos.system`, whose argument types cannot be named here.
    public(package) func attach(&self, target: UInt, key: UInt,
                                flags: UInt) -> Result<Void, SosStatus> {
        checked(sos_waiter_add(self.handle, target, key, flags))
    }

    /// The consuming attach's one call, shared by every `give` overload:
    /// `attach` with the consuming bit set. What makes `give` a different verb
    /// rather than a different argument is what it does to the caller's value,
    /// which each overload's signature spells.
    ///
    /// `public(package)` for `attach`'s reason: the `give` overloads for kinds
    /// declared in modules that import this one live beside those kinds and
    /// call in from `sos.pipe` and `sos.system`.
    public(package) func attach_consuming(&self, target: UInt, key: UInt,
                                          mode: AttachMode) -> Result<Void, SosStatus> {
        self.attach(target, key, mode_flag(mode) | WAITER_ADD_CONSUMING)
    }

    /// Hand an Event to this Waiter, and stop holding it.
    ///
    /// `give` is the tree's one verb for "ownership leaves through this
    /// receiver": `Process.give` hands a handle to a process, `Waiter.give` to
    /// a subscription. A distinct name rather than a by-value overload of
    /// `add`, so the consuming semantic is visible at the call site and
    /// overload resolution never hinges on a sigil.
    ///
    /// Same verb, different gate: give-to-process hands a handle to another
    /// process and spends the `Transfer` right; give-to-waiter hands the object
    /// to an attachment, and no handle onto it is ever minted out of one, so it
    /// spends the `Wait` right alone, as `add` does.
    ///
    /// The refusal hands the object back. A full attachment table is a resource
    /// condition, not a bug, so the caller keeps what it had; as with
    /// `TimedOut(pending:)`, the error payload carries the live thing. A
    /// refused add consumes nothing kernel-side, so the word is still good.
    ///
    /// The funnel contract: the body disarms before the syscall (no path can
    /// leave two owners of one word), and a refused add is a status, so the
    /// error arm builds a fresh wrapper around the word the kernel provably did
    /// not consume. The old husk is dead on every path.
    ///
    /// It defaults to `OneShot` where `add` defaults to `Persistent`: a caller
    /// that has given the object away usually has no handle left to `remove`
    /// with, so the subscription that ends itself reads right. Pass
    /// `Persistent` explicitly for an attachment-owned supervisor.
    public func give(&self, event: Event, key: UInt,
                     mode: AttachMode = AttachMode.OneShot
    ) -> Result<Void, (SosStatus, Event)> {
        var owned = move event
        let word: UInt = owned.handle
        owned.handle = EventHandle(NO_HANDLE)
        try self.attach_consuming(word, key, mode) catch {
            let back: (SosStatus, Event) = (error, Event(handle: EventHandle(word)))
            return move back
        }
        return
    }

    /// Hand a Timer to this Waiter. Everything `give(event:)` says holds. With
    /// `Persistent`, a periodic timer nobody holds a handle to still fires, and
    /// its subscription ends when the Waiter does.
    public func give(&self, timer: Timer, key: UInt,
                     mode: AttachMode = AttachMode.OneShot
    ) -> Result<Void, (SosStatus, Timer)> {
        var owned = move timer
        let word: UInt = owned.handle
        owned.handle = TimerHandle(NO_HANDLE)
        try self.attach_consuming(word, key, mode) catch {
            let back: (SosStatus, Timer) = (error, Timer(handle: TimerHandle(word)))
            return move back
        }
        return
    }

    /// Stop watching whatever is attached under `key`. A key this Waiter does
    /// not use terminates the process. Requires `WaiterRight.Attach`.
    ///
    /// The key names an attachment, not the waitable: detaching edits this
    /// Waiter's own table and never touches the object on the other end, so it
    /// needs no handle and no right over it.
    public func remove(&self, key: UInt) -> Result<Void, SosStatus> {
        checked(sos_waiter_remove(self.handle, key))
    }

    /// Mint a sibling of this Waiter handle, narrowed by a keep mask: the
    /// universal `MINT_OP`, on `System.mint`'s exact terms. Requires the
    /// universal `WaiterRight.Mint` on this handle.
    ///
    /// `rights` is what the sibling may keep: its rights are this handle's
    /// intersected with the mask, so the default (all ones) is "the same
    /// rights", and naming a right this handle does not hold is a no-op.
    /// The mask is where a holder writes policy for a Waiter: a
    /// sibling that keeps `Wait` and not `Attach` can park on what
    /// is already attached and add nothing.
    ///
    /// `Mint` is itself maskable. The sibling is independent (its own slot,
    /// generation and release) and names the same object. A caller at its
    /// handle quota gets `SosStatus.QuotaExceeded` and a full handle table is
    /// `SosStatus.NoResource`; a handle without `Mint` terminates the caller.
    public func mint(&self,
                     rights: UInt32 = ALL_RIGHTS) -> Result<Waiter, SosStatus> {
        let raw = try call_value(self.handle, MINT_OP, rights as UInt, 0, 0)
        return Waiter(handle: WaiterHandle(raw))
    }
}
