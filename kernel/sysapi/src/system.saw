//! System, Process, and the boot-set record: the authority objects, and the one
//! module in this package that holds more than one of them.
//!
//! The three cannot be separated. Every pair of them names the other:
//!
//!   - `System.process_self` and `System.process_create` construct a `Process`,
//!     so System is above Process;
//!   - `Process.give(system:)` takes a `System` by value (the courier funnel
//!     the launch flow turns on), so Process is above System;
//!   - `BootHandle` carries a `Memory?`, a `Process?` and a `System?`, and
//!     `Process.boot_handle_next` answers with one, so the record is above all
//!     three and below Process at the same time.
//!
//! An import cycle is a compile error naming the loop, so these cannot be
//! three files. They are one module, and the sections below keep the three
//! seams visibly apart.
//!
//! Everything else this file names comes from modules it imports: the floor's
//! raw seams, the regions, the pipe types, and the objects a Process mints.

import sosabi.{SosStatus, SystemOp, ProcessOp, MemoryOp, IoMemoryOp, MINT_OP,
               SlabKind,
               SystemHandle, ProcessHandle, ThreadHandle, EventHandle,
               WaiterHandle, InterruptHandle, ClockHandle, MemoryHandle,
               IoMemoryHandle, MappingHandle, TimerHandle,
               PipeInletHandle, PipeOutletHandle, PipeReplyHandle,
               PipeRequestHandle,
               NO_HANDLE, BootTagForm, EventMode, ClockType, ProtectionTier,
               BootHandleKind,
               BOOT_HANDLE_RECORD_WORDS, BOOT_HANDLE_TAG_WORD,
               BOOT_HANDLE_KIND_WORD, BOOT_HANDLE_HANDLE_WORD,
               boot_handle_record_bytes,
               PIPE_CREATE_RECORD_WORDS, PIPE_CREATE_INLET_WORD,
               PIPE_CREATE_OUTLET_WORD, pipe_create_record_bytes,
               PROCESS_STATS_RECORD_DOUBLEWORDS, PROCESS_STATS_SYSCALLS_SLOT,
               PROCESS_STATS_INTERRUPTS_SLOT, PROCESS_STATS_FAULTS_SLOT,
               process_stats_record_bytes,
               StatsRow, StatsRegionHeader, STATS_REGION_VERSION,
               STATS_REGION_MAP_RECORD_WORDS, STATS_REGION_MAP_ROW_WORD,
               stats_region_map_record_bytes}

// The `sosabi.` qualifier, for the one encoding this module names without
// binding bare: `sosabi.ENTRY_IMAGE`, the sentinel a process passes when it has
// no way to compute an entry address (see `thread_create` below). A selective
// import binds its list and no qualifier, so the reach is written rather than
// inherited. It is an ordinary import, so it re-exports nothing.
import sosabi

// The scalar-to-console-byte rule, shared with the kernel's own console so the
// two cannot disagree about what a non-ASCII scalar becomes.
import sosrt.{ascii_byte}

import sos.floor.{ALL_RIGHTS, call_value, checked, park_system_handle,
                  sos_handle_release, sos_process_boot_handle_next,
                  sos_process_exit, sos_process_give, sos_process_pipe_create,
                  sos_process_start, sos_process_stats,
                  sos_system_debug_print, sos_system_shutdown,
                  sos_system_slab_donate, sos_waiter_add}
import sos.memory.{Memory}
import sos.iomemory.{IoMemory}
import sos.mapping.{Mapping}
import sos.pipe.{PipeInlet, PipeOutlet, PipeReply, PipeRequest}
// Qualified, alone among these imports: `std.task` publishes a prelude
// `Thread<T>`, and a bare imported `Thread` ties with it. `thread.Thread` says
// which, wherever `Process` names one; the facade re-exports the bare spelling
// a process writes.
import sos.thread
import sos.event.{Event}
import sos.interrupt.{Interrupt}
import sos.clock.{Clock}
import sos.timer.{Timer}
import sos.waiter.{AttachMode, Waiter, mode_flag}

// =============================================================================
// System (spec §12)
// =============================================================================

/// A handle to the kernel's System object, the root of a process's authority
/// (§12's boot handle set).
///
/// The field is a `SystemHandle`, not a `UInt`: one kind of handle cannot be
/// built from a raw word or from another kind's handle, so handle-kind
/// confusion is not expressible here. It costs nothing: the alias flows to
/// `UInt` implicitly at the stub, so the calls below pass `self.handle` with no
/// cast.
///
/// `NoCopy`, and dropping it releases the handle. A `System` is a capability
/// instance, not a description of one, so it cannot be duplicated and its scope
/// is its life.
///
/// Root's own `System` normally dies in the kernel's teardown, not here: a root
/// server's last act is `shutdown()` or `exit()`, neither of which returns, so
/// the deinit below is never reached and the process teardown closes the handle
/// with everything else. The deinit covers the cases that do fall out of a
/// scope.
public struct System {
    handle: SystemHandle,
}

extension System: NoCopy {
    /// Drop is release. The word field doubles as the disarm flag because
    /// `NO_HANDLE` cannot name a live handle at any generation; a transfer
    /// funnel writes it there before handing the word to the kernel, and this
    /// deinit then has nothing to do.
    ///
    /// The status is discarded because there is nobody to report it to: a
    /// deinit runs at a point no source construct names, so it has no error
    /// channel and needs none. The only way this call fails is a word that does
    /// not resolve, which the kernel answers by ending the process rather than
    /// by returning.
    func deinit(&var self) {
        if self.handle != NO_HANDLE {
            let _ = sos_handle_release(self.handle)
        }
    }
}

extension System {
    /// Adopt the boot handle the kernel passed in the first argument register.
    ///
    /// The parameter is a raw `UInt` because that is what a register holds and
    /// what the ABI specifies. It is the one public constructor that takes a
    /// raw word into a typed handle.
    ///
    /// Every process comes through here, not just root (§12's symmetry). Root's
    /// word is the one the kernel minted at boot; a child's is a masked sibling
    /// its launcher minted and gave under the tag it was started with. Neither
    /// can tell the difference, and neither needs to: what a process may do
    /// with the handle is the rights word. From here both bootstrap
    /// identically: derive the Process object, drain the boot set.
    ///
    /// A word arriving here is one the kernel resolved, never one anybody
    /// guessed, and it can be adopted at most once: `start(boot_tag:)` consumes
    /// the record it resolved, so the drain can never hand the same word back a
    /// second time and there is no way to end up with two wrappers over one
    /// handle.
    public init(boot_handle: UInt) -> System {
        // The runtime's panic path prints through this same handle, so it has
        // to be parked where the seams below can reach it before any Saw code
        // can fail.
        park_system_handle(boot_handle)
        System(handle: SystemHandle(boot_handle))
    }

    /// Mint a sibling of this System handle, narrowed by a keep mask: the
    /// universal `MINT_OP`. Requires the universal `SystemRight.Mint` on this
    /// handle.
    ///
    /// `rights` is what the sibling may keep: its rights are this handle's
    /// intersected with the mask, so the default (all ones) is "the same
    /// rights" and anything narrower attenuates. Naming a right this handle
    /// does not hold is a no-op: the intersection makes no-amplification
    /// structural rather than checked, so there is nothing to fault on and
    /// nothing to introspect first.
    ///
    /// This is how a child gets a System handle, and the mask is the whole of
    /// the policy:
    ///
    /// ```saw
    /// let for_child = system.mint(rights: SystemRight.Debug
    ///                                     | SystemRight.ProcessSelf
    ///                                     | SystemRight.ClockGet
    ///                                     | SystemRight.Transfer)!
    /// child.give(system: move for_child, tag: BOOT)
    /// ```
    ///
    /// Everything not named is absent by silence. A keep mask fails closed when
    /// a later change adds a System right, where a removal mask would hand
    /// every future capability to every child a launcher had ever configured.
    /// Write a complement (`~(SystemRight.Transfer as UInt32) & 0xFFFF_FFFF`)
    /// when subtractive intent is what you mean, so the fail-open choice reads
    /// at the call site.
    ///
    /// `Mint` is itself maskable. A sibling minted through a mask that left it
    /// out cannot mint again, so proliferation stops where the mask says.
    ///
    /// A process at its handle quota gets `SosStatus.QuotaExceeded`; a full
    /// handle table is `SosStatus.NoResource`. A handle without `Mint`
    /// terminates the caller.
    public func mint(&self,
                     rights: UInt32 = ALL_RIGHTS) -> Result<System, SosStatus> {
        let raw = try call_value(self.handle, MINT_OP, rights as UInt, 0, 0)
        return System(handle: SystemHandle(raw))
    }

    /// Write one byte to the debug console.
    public func debug_print_byte(&self, byte: UInt8) -> Result<Void, SosStatus> {
        checked(sos_system_debug_print(self.handle, byte as UInt))
    }

    /// Write an ASCII string. Stops at the first failure and reports it; a
    /// partial write is surfaced, never swallowed.
    public func debug_print(&self, msg: String) -> Result<Void, SosStatus> {
        for scalar in msg.scalars() {
            try self.debug_print_byte(ascii_byte(scalar))
        }
        return
    }

    /// Stop the machine with `status`. Does not return when it succeeds; a
    /// refusal (no `SystemRight.Shutdown`, say) comes back as an error.
    public func shutdown(&self, status: UInt) -> Result<Void, SosStatus> {
        checked(sos_system_shutdown(self.handle, status))
    }

    /// This process's own Process object (§3's derivation rule: a handle is
    /// obtained through a handle already held). Requires
    /// `SystemRight.ProcessSelf`.
    ///
    /// Each call mints a fresh handle: two calls are two capability instances
    /// of one authority, each independently owned and released, which is what
    /// makes the `NoCopy` wrapper an owner rather than a name. It amplifies
    /// nothing: a mint carries the kind's default rights and
    /// `SystemRight.ProcessSelf` gates the minting. It can therefore fail: a
    /// process at its handle quota gets `SosStatus.QuotaExceeded`, and a full
    /// handle table is `SosStatus.NoResource`.
    ///
    /// `keep` is a keep mask with `mint(rights:)`'s semantics (an intersection,
    /// total, fail-closed, all ones by default). The derived Process handle
    /// carries the default set intersected with it. The mask is the deriving
    /// process's own: a launcher's mask on the System handle it gave does not
    /// reach the handle a child derives here, and only the child can narrow
    /// that one (spec §9).
    ///
    /// ```saw
    /// let proc = try system.process_self(keep: ProcessRight.ThreadCreate
    ///                                          | ProcessRight.Exit)
    /// ```
    public func process_self(&self,
                             keep: UInt32 = ALL_RIGHTS) -> Result<Process, SosStatus> {
        let raw = try call_value(self.handle, SystemOp.ProcessSelf as UInt,
                                 keep as UInt, 0, 0)
        return Process(handle: ProcessHandle(raw))
    }

    /// Phase one of the two-phase lifecycle: load `image` into `memory` and
    /// answer with a process that exists and is not running. Requires
    /// `SystemRight.ProcessCreate`.
    ///
    /// It is asked of the System object: process-scoped objects are minted by
    /// your Process, but processes are minted by the System. A process table is
    /// a machine-global resource bounded by machine facts, so its refusals are
    /// System answers.
    ///
    /// The caller supplies capabilities and no numbers. `image` is the
    /// read-only region holding a process image; `memory` is the RAM the child
    /// will run in. The kernel copies each segment to the address the image was
    /// linked at, checks that every one lands inside `memory`, and grants a
    /// stack at that region's top, so where the child's stack is and how big is
    /// the kernel's answer. The kernel applies the same rule to itself when it
    /// loads root.
    ///
    /// What comes back is inert: an address space, an entry and a stack
    /// recorded, and no thread. Nothing runs until `Process.start()`, so "hand
    /// the child its handles, then run it" needs no synchronization; the start
    /// call is the barrier.
    ///
    /// A malformed image is `SosStatus.BadImage`, a value, not a fault: image
    /// bytes are data the launcher was handed, and a launcher that cannot
    /// report a bad image cannot launch anything else either. Passing a handle
    /// that names nothing, or something that is not a region, is a fault: the
    /// caller chose which handles to pass. A full process table or handle table
    /// comes back as `SosStatus.NoResource`, and a caller at its handle quota
    /// gets `SosStatus.QuotaExceeded`.
    ///
    /// The two regions must be disjoint, so the same region cannot serve as
    /// both. Nothing is copied until every check has passed, so a refusal
    /// leaves `memory` exactly as it was.
    public func process_create(&self, image: &Memory,
                               memory: &Memory) -> Result<Process, SosStatus> {
        let raw = try call_value(self.handle, SystemOp.ProcessCreate as UInt,
                                 image.handle, memory.handle, 0)
        return Process(handle: ProcessHandle(raw))
    }

    /// Give the kernel `memory` to back the slab `kind` names, for good.
    /// Requires `SystemRight.SlabDonate`.
    ///
    /// This is how a deployment sizes the machine. Every `MAX_<KIND>` in the
    /// kernel is a compiled floor: the image boots on its static arrays, and a
    /// boot server that wants more events, timers or regions than the build
    /// chose donates the storage for them, up to each kind's machine-wide
    /// ceiling. `SosStatus.NoResource` from a create op afterwards means the
    /// slab is full, at whatever size the deployment set.
    ///
    /// It consumes the region and nothing gives it back: the bytes become
    /// kernel object storage, the capability is spent, and no op returns the
    /// range to a pool. The kernel refuses, by ending the caller, a region
    /// it cannot safely absorb: one that any other handle still names, one with
    /// a mapping row installed, or a pool root with pieces still on loan. The
    /// caller created those conditions and can see them, so they fault rather
    /// than answer.
    ///
    /// On a refusal the region comes back in the error, as with `Waiter.give`.
    /// The refusals that are statuses are all `SosStatus.NoResource`: a region
    /// too small to hold one slot of that kind, a slab whose extent chain is
    /// full, and a donation that would take the kind past its machine-wide
    /// ceiling. They consume nothing, so the caller still owns its memory and
    /// is handed it back rather than left holding a disarmed wrapper.
    public func slab_donate(&self, kind: SlabKind,
                            memory: Memory) -> Result<Void, (SosStatus, Memory)> {
        var region = move memory
        let word: UInt = region.handle
        region.handle = MemoryHandle(NO_HANDLE)
        try checked(sos_system_slab_donate(self.handle, kind as UInt, word)) catch {
            let back: (SosStatus, Memory) = (error, Memory(handle: MemoryHandle(word)))
            return move back
        }
        return
    }

    /// This process's Clock for `type`, a granted time source. Requires
    /// `SystemRight.ClockGet`.
    ///
    /// Time is a capability, which is why this is an op rather than a free
    /// function. A process that was not granted the right cannot read the
    /// machine's clock at all, so handing a child a virtual clock later is a
    /// substitution with no code change on either side: the child asks its
    /// System object for a Clock exactly as it does now.
    ///
    /// Each call mints a fresh handle onto the one Clock, so two asks are two
    /// owned handles. It amplifies nothing (`SystemRight.ClockGet` gates the
    /// minting and every mint carries the kind's default rights) and it is
    /// fallible on repetition: a process at its handle quota gets
    /// `SosStatus.QuotaExceeded`, and a full handle table is
    /// `SosStatus.NoResource`.
    /// `ClockType.Monotonic` is the only domain declared; it counts nanoseconds
    /// from an unpublished epoch, never steps and never goes backwards, so two
    /// readings are comparable and one means nothing alone.
    ///
    /// The label is `type:` and it is a label, not a declaration: `type` is a
    /// contextual keyword in Saw, reserved only where an alias begins.
    public func clock_get(&self,
                          type: ClockType = ClockType.Monotonic) -> Result<Clock, SosStatus> {
        let raw = try call_value(self.handle, SystemOp.ClockGet as UInt,
                                 type as UInt, 0, 0)
        return Clock(handle: ClockHandle(raw))
    }

    /// Bind IRQ `line` to an Interrupt (spec §2's row and §9's delivery).
    /// Requires `SystemRight.InterruptBind`.
    ///
    /// A line is a machine-wide resource, so binding is a System answer and its
    /// faults land on this process. The line is a number the caller chooses,
    /// so it is spelled as one, as for `event_create`'s mode. A launcher knows
    /// its board's lines from the board's own description; the kernel checks
    /// the number against the board and terminates the caller for a line this
    /// machine does not have, the timer's line, or one already bound. All three
    /// are caller-checkable. A full Interrupt slab is
    /// `SosStatus.NoResource`. The handle is charged to the caller's `Handle`
    /// row like any mint; there is no Interrupt row.
    ///
    /// The Interrupt has one name, the handle returned here: it cannot be
    /// minted from, and releasing it unbinds the line and makes it bindable
    /// again at once. A launcher gives it to the driver that services the line
    /// (`Process.give(interrupt:)`), so the driver holds the lines it was given
    /// and no authority to bind another.
    ///
    /// The line comes back unmasked, which is §9's starting state: the object
    /// exists, the controller will deliver, and the first fire masks it until
    /// an `ack`. The kernel does not touch the device's own interrupt-enable
    /// register; that is behind the driver's granted window and is the driver's
    /// to write.
    public func interrupt_bind(&self, line: UInt) -> Result<Interrupt, SosStatus> {
        let raw = try call_value(self.handle, SystemOp.InterruptBind as UInt,
                                 line, 0, 0)
        return Interrupt(handle: InterruptHandle(raw))
    }

    /// What this platform can deny: `Isolated` or `Flat`, and nothing else.
    /// Requires `SystemRight.TierGet`.
    ///
    /// Ask it once, at startup, and only if you rely on isolation. The tier is
    /// fixed for the life of the machine, so a program that re-reads it per
    /// operation has misunderstood what it is for: it is a platform fact you
    /// decide whether to run on, not a per-call permission check.
    ///
    /// ```saw
    /// let tier = try system.tier() catch { return }
    /// match tier {
    ///     case Isolated -> { },
    ///     case Flat -> {
    ///         let _ = system.debug_print("vault: refusing to run on a flat platform\n")
    ///         let _ = system.shutdown(EXIT_FAILED)
    ///     },
    /// }
    /// ```
    ///
    /// What `Flat` does not mean: it does not mean `map` lies. On flat hardware
    /// `map`'s contract ("make this region accessible with at least these
    /// rights") is trivially true, so the call succeeds honestly and the
    /// mapping is real. Handles, rights, quotas and lifetimes are checked on
    /// every syscall at every tier. What `Flat` means is that the hardware
    /// denies nothing: `unmap` revokes nothing it will enforce, a peer process
    /// can reach your memory, and any process can write the kernel's own
    /// memory and so bypass every check the syscall path makes.
    ///
    /// An unknown word panics, on `decode_boot_handle`'s reasoning: the kernel
    /// wrote it out of the same `ProtectionTier` declaration this function
    /// reads, so a value that does not decode is a skew between the kernel and
    /// the `sos` module it exports, not a runtime condition a caller could act
    /// on.
    public func tier(&self) -> Result<ProtectionTier, SosStatus> {
        let raw = try call_value(self.handle, SystemOp.TierGet as UInt, 0, 0, 0)
        guard let word = ProtectionTier.from(raw: raw) else {
            panic("sos: kernel wrote protection tier {}, which this build cannot name",
                  raw)
        }
        return word
    }

    /// Map the machine's trap counters read-only into this process: the shared
    /// stats region. Requires `SystemRight.StatsRegionMap`.
    ///
    /// This is a `top` that costs no syscalls. Call it once; every sample
    /// afterwards is a load out of this process's own address space. The
    /// alternative, `Process.stats()`, costs one trap per process per sample
    /// and needs a handle onto each process; this costs one trap ever and
    /// covers every live process the machine has, a row per process body.
    ///
    /// ```saw
    /// let region = try system.stats_region_map() catch { return }
    /// let mine = region.row(region.self_row)
    /// print("syscalls={}\n", mine.syscalls)
    /// ```
    ///
    /// The mapping is read-only, and a write faults where the hardware can say
    /// so. The columns are the kernel's; a process that could write them could
    /// lie to every supervisor on the machine. On the `Flat` tier the tier word
    /// already disclaims hardware denial (`tier()` above): the row is installed
    /// read-only either way, and only one tier enforces it.
    ///
    /// The numbers can tear on a 32-bit profile, which is documented rather
    /// than locked. A column is 64 bits and a 32-bit profile's registers are
    /// 32, so a read can land between the two halves of a carry. The columns
    /// only ever increase, so a torn read yields a value between two true
    /// readings, never a number the counter never held, and the high word moves
    /// once per 2^32 traps. A `top` is exactly the consumer that can live with
    /// that. A caller that needs an exact reading uses `Process.stats()`, whose
    /// copy-out is made with interrupts masked.
    ///
    /// It mints no `Memory`. The region is kernel storage, not allocatable RAM:
    /// what you are granted is the access and nothing that owns it. The
    /// `Mapping` inside the returned value is what takes the access back
    /// (`unmap()`), and dropping the value releases the handle without removing
    /// the row, as for any `Mapping`.
    ///
    /// A version this build cannot read panics, on `tier()`'s reasoning: the
    /// kernel wrote the word out of the same declaration this module reads, so
    /// a mismatch is a skew between the kernel and the `sos` it exported, not a
    /// runtime condition a caller could act on.
    public func stats_region_map(&self) -> Result<StatsRegion, SosStatus> {
        let answer = try stats_region_into_frame(self.handle)
        var mapping = Mapping(handle: MappingHandle(answer.0))
        let base = try mapping.base()
        let head = read_stats_header(base)
        if head.version != STATS_REGION_VERSION {
            panic("sos: kernel published stats region version {}, which this build cannot read",
                  head.version)
        }
        return StatsRegion(mapping: move mapping, base: base,
                           rows: head.rows as Int,
                           rows_offset: head.rows_offset as UInt,
                           row_bytes: head.row_bytes as UInt,
                           self_row: answer.1)
    }
}

/// The `unsafe` half of `System.stats_region_map`, confined to one small named
/// helper. The record buffer's address never leaves it.
///
/// It answers the pair the op answers: the Mapping handle out of the value
/// register, and the caller's own row index out of the copy-out record.
func stats_region_into_frame(handle: UInt) unsafe -> Result<(UInt, Int), SosStatus> {
    var buf: [UInt; STATS_REGION_MAP_RECORD_WORDS] = [0; STATS_REGION_MAP_RECORD_WORDS]
    let raw = try call_value(handle, SystemOp.StatsRegionMap as UInt,
                             ((&var buf) as UnsafePointer<UInt>) as UInt,
                             stats_region_map_record_bytes() as UInt, 0)
    let pair: (UInt, Int) = (raw, buf[STATS_REGION_MAP_ROW_WORD] as Int)
    return pair
}

/// Read the region's published header. The layout is declared once in `sosabi`
/// and read by field name, so a layout edit that skewed the offsets would be a
/// compile error rather than a silent misread.
///
/// `unsafe` because it names an `UnsafeMemory`; the contact stops here. It
/// cannot fail (the page is mapped by the time it is called), so it carries no
/// error channel to make every caller unwrap.
func read_stats_header(base: UInt) unsafe -> StatsRegionHeader {
    UnsafeMemory<StatsRegionHeader, Normal>(base).read()
}

/// Read one row, the same way.
func read_stats_row(at: UInt) unsafe -> StatsRow {
    UnsafeMemory<StatsRow, Normal>(at).read()
}

// =============================================================================
// Process (spec §2, §7, §8)
// =============================================================================

/// What a process has cost the machine, in traps: the answer `Process.stats()`
/// gives.
///
/// Three columns, not one number, because the split is what makes any of it
/// usable. A single total would mix a quantity a program determines with one
/// the machine determines, so nothing could be asserted about it:
///
///   `syscalls`    every trap this process took through the syscall
///                 instruction: one per call, whatever the op, whatever the
///                 answer, and one for a call that parked for a millisecond.
///                 Deterministic for a given program path, so this is the
///                 column a test asserts on.
///   `interrupts`  every timer or device interrupt taken while this process was
///                 the running one. It moves with the machine, so print it and
///                 never assert it.
///   `faults`      every other exception (an access fault, a misaligned access,
///                 an illegal instruction). Normally zero, because a fault ends
///                 the process; the interesting reader is a supervisor holding
///                 the dead child's handle.
///
/// A bad syscall is a syscall. Spending a right you were not given ends the
/// process, but the trap arrived through the syscall instruction and the
/// columns are keyed by how the machine entered the kernel. Keying on the
/// outcome would make `syscalls` unpredictable, since a caller cannot know in
/// advance which call the kernel will refuse.
///
/// The reading includes the call that took it. `syscalls` is charged at trap
/// entry, before the op runs, so a process reading its own stats sees the
/// `stats()` call already counted. A column that excluded the observer would be
/// wrong by one at exactly the moment anyone looked. It means a delta between
/// two readings includes the second reading's own trap; subtract it where the
/// window is what you are measuring.
///
/// Plain data: three integers, no handle, nothing owned. It is on the automatic
/// `Copy` tier and needs no policy; a reading is a fact you took, not a
/// capability you hold.
///
/// `UInt64` on every profile: a count is a property of the quantity rather than
/// of the machine, so every profile answers with the same width, as for a
/// nanosecond reading.
public struct ProcessStats {
    public syscalls: UInt64,
    public interrupts: UInt64,
    public faults: UInt64,
}

/// A handle to a Process: an address-space domain, a handle table and threads.
///
/// A process reaches its own through `System.process_self`. Holding somebody
/// else's is supervision: a launcher keeps the handle `System.process_create`
/// gave it, `give`s and `start`s through it, reads `get_status` through it, and
/// attaches it to a Waiter to be woken by the death (`Waiter.add(process:)`,
/// declared at the bottom of this file).
///
/// There is no way to build one from a word and no way to get a word back out.
/// The field is private, the only constructors are this module's own op
/// wrappers, and the derivation chain starts at `System(boot_handle:)`, so a
/// `Process` in hand is one the kernel handed over, not an integer somebody
/// guessed. See the two-layer rule in the `sos` module docstring (`lib.saw`).
///
/// `NoCopy`, and dropping it releases the handle. `System.process_self()` mints
/// a fresh instance on every call, so two calls give two independently owned
/// handles.
///
/// Dropping a child's handle is how its record comes back. A dead child's body
/// went back when it died, and its record is held only by the §8 status word
/// and final counters somebody might still read, so the last reference onto it
/// going away (its last handle, or a Waiter attachment watching it) frees it.
/// Letting a supervisor's `Process` fall out of scope is a real reclamation,
/// not mere tidiness: dead records still held are what fill the record table.
///
/// The factory methods (`thread_create`, `event_create`, `waiter_create`,
/// `pipe_create`) act on the process the handle names,
/// whether or not that is the caller: that process is charged and its table
/// receives the new handles. On a handle onto another process the returned
/// words belong to that process's table, so in the caller's table the
/// wrappers they come back in name nothing, or a different object.
public struct Process {
    handle: ProcessHandle,
}

extension Process: NoCopy {
    /// Drop is release; see `System`'s deinit for the sentinel and the discard.
    func deinit(&var self) {
        if self.handle != NO_HANDLE {
            let _ = sos_handle_release(self.handle)
        }
    }
}

extension Process {
    /// Make a thread at `entry`, ready to be started. Requires
    /// `ProcessRight.ThreadCreate`.
    ///
    /// The thread runs with `stack_top` as its stack pointer and `arg` in its
    /// first argument register, and it must not return: its link register is
    /// zero, so returning faults and the fault ends the process (spec §8).
    ///
    /// The kernel acts on the process this handle names, which is the caller
    /// only on its own handle: an entry or a stack outside that process
    /// terminates it, the thread is charged to its Thread quota, and the
    /// handle is minted into its table. That process at its Thread or handle
    /// quota is `SosStatus.QuotaExceeded`; a full thread slab or handle table
    /// comes back as `SosStatus.NoResource`.
    public func thread_create(&self, entry: UInt, stack_top: UInt,
                              arg: UInt) -> Result<thread.Thread, SosStatus> {
        let raw = try call_value(self.handle, ProcessOp.ThreadCreate as UInt,
                                 entry, stack_top, arg)
        return thread.Thread(handle: ThreadHandle(raw))
    }

    /// Make a thread that starts at this process's own image entry (the entry
    /// the kernel took out of the image header), with `arg` in its first
    /// argument register, so the entry can tell which thread it is running as.
    ///
    /// This overload exists because Saw cannot name the address of a function:
    /// `extern` declares functions, an extern function is not usable as a
    /// value, and `@export` on a static emits a definition. A process written
    /// entirely in Saw therefore cannot compute an entry address, and this is
    /// the one entry it can ask for by name. A process with a C leaf that can
    /// produce an address uses the overload above.
    public func thread_create(&self, stack_top: UInt,
                              arg: UInt) -> Result<thread.Thread, SosStatus> {
        self.thread_create(entry: sosabi.ENTRY_IMAGE, stack_top: stack_top,
                           arg: arg)
    }

    /// The calling thread's own Thread object. Requires
    /// `ProcessRight.ThreadSelf`.
    ///
    /// This is how a thread reaches the handle it needs to exit or yield: it is
    /// handed its process, and asks the process which thread it is.
    public func thread_self(&self) -> Result<thread.Thread, SosStatus> {
        let raw = try call_value(self.handle, ProcessOp.ThreadSelf as UInt, 0, 0, 0)
        return thread.Thread(handle: ThreadHandle(raw))
    }

    /// End this process with `status`. Every thread stops with it and the
    /// kernel closes every handle it held (spec §2's Process row); a handle
    /// another process holds onto one of its threads then joins as `Revoked`,
    /// or with the exit code if that thread had already exited. Does not return
    /// when it succeeds. Requires `ProcessRight.Exit`. Only the calling process
    /// can exit: through a handle naming another process the kernel faults the
    /// caller.
    public func exit(&self, status: UInt) -> Result<Void, SosStatus> {
        checked(sos_process_exit(self.handle, status))
    }

    /// This process's §8 status word: kind in the high bits, code in the low
    /// ones. Requires `ProcessRight.Wait`.
    ///
    /// This is the polling door. `Waiter.add(process:, key:)`, declared at the
    /// bottom of this file, is the blocking one onto the same word.
    public func get_status(&self) -> Result<UInt, SosStatus> {
        call_value(self.handle, ProcessOp.GetStatus as UInt, 0, 0, 0)
    }

    /// Make an Event accumulating in `mode`, §2.4's per-Event property, fixed
    /// for the object's life. Requires `ProcessRight.EventCreate`.
    ///
    /// `EventMode.Or` is the flag set, "which of these events occurred since
    /// last drain", and is the default because it is the signal use case.
    /// `EventMode.SaturatingSum` is the counting semaphore, "how many times",
    /// and it saturates rather than wrapping, so a producer faster than its
    /// consumer loses count but never wraps back to zero, the value that means
    /// "not ready".
    ///
    /// One method takes the mode rather than one per mode: the mode is a value
    /// the caller chooses, so it is spelled as one. See the `sos` module
    /// docstring (`lib.saw`) for which enums are public API.
    public func event_create(&self,
                             mode: EventMode = EventMode.Or) -> Result<Event, SosStatus> {
        let raw = try call_value(self.handle, ProcessOp.EventCreate as UInt,
                                 mode as UInt, 0, 0)
        return Event(handle: EventHandle(raw))
    }

    /// Make a Waiter, §2.2's generic wait aggregator. Requires
    /// `ProcessRight.WaiterCreate`.
    public func waiter_create(&self) -> Result<Waiter, SosStatus> {
        let raw = try call_value(self.handle, ProcessOp.WaiterCreate as UInt,
                                 0, 0, 0)
        return Waiter(handle: WaiterHandle(raw))
    }

    /// Phase two: run this process, handing it nothing in its first argument
    /// register. Requires `ProcessRight.Start`, a right on the child's handle
    /// (the one `process_create` handed back).
    ///
    /// It mints the first thread at the entry and stack recorded at create, so
    /// the caller supplies neither: a launcher never parses an image, and there
    /// is no address it could get wrong. The thread starts with `NO_HANDLE` in
    /// its first argument register. A child that was given nothing, or that was
    /// given handles but no boot tag to find one of them by, is a fully
    /// sandboxed compute process.
    ///
    /// The caller keeps running. The child becomes runnable and the scheduler
    /// picks it up, as with `Thread.start`.
    ///
    /// A second `start()` terminates the caller: it is broken code, since the
    /// caller started it the first time. The same state word freezes the boot
    /// set: a `give` after this call is the same fault, which is the ordering
    /// the whole launch flow rests on.
    ///
    /// A child at its thread quota is `SosStatus.QuotaExceeded` (the first
    /// thread is charged to the child), and a full thread slab is
    /// `SosStatus.NoResource`. Either refusal leaves the child `Created` and
    /// its boot set as it was.
    public func start(&self) -> Result<Void, SosStatus> {
        checked(sos_process_start(self.handle, BootTagForm.Absent as UInt, 0))
    }

    /// Phase two, with the child's first handle in its first argument register.
    /// The kernel resolves `boot_tag` against this process's boot set and puts
    /// the child-side word in the child's first argument register, so
    /// `_start(boot_handle)` is unchanged and the launcher never sees a
    /// child-relative word at any point.
    ///
    /// That is why `give` never hands back the word it minted: that word means
    /// nothing on this side, and the one place it means anything is the
    /// register the child wakes up with. The launcher speaks tags, which are
    /// its own words handed back unread; the kernel is a courier, and what a
    /// tag means is config the launcher and the child agree on.
    ///
    /// Resolution takes the tagged record: the child's drain steps over it, so
    /// the word is delivered once, in the register, and never again by
    /// `boot_handle_next`.
    ///
    /// A tag that names no given record terminates the caller: a config error,
    /// and the caller wrote both halves of it. So does a second start, as for
    /// `start()`. The quota and slab statuses are `start()`'s.
    public func start(&self, boot_tag: UInt) -> Result<Void, SosStatus> {
        checked(sos_process_start(self.handle, BootTagForm.Present as UInt,
                                  boot_tag))
    }

    // -------------------------------------------------------------------------
    // The give funnels
    // -------------------------------------------------------------------------
    //
    // One funnel per givable wrapper kind, each consuming its wrapper. They are
    // label-distinguished overloads of one verb (`child.give(memory: move r,
    // tag: 3)`) because `give` is one operation over one op number and only the
    // typed thing crossing varies.
    //
    // Each is the transfer-funnel contract: take the wrapper by value so the
    // caller cannot keep it, read the word, write `NO_HANDLE` into the field
    // before the syscall, and let the disarmed value drop. The local `var`
    // exists because a by-value parameter is a `let` and the disarm is a write.
    // A refusal builds a fresh wrapper around the word and hands it back.
    //
    // The errors, the refusal and the keep mask are stated once, on
    // `give(memory:)`.
    //
    // A handle can be given only if its rights word carries the universal
    // `Transfer` bit. The default sets that carry it belong to System, Process,
    // Memory, IoMemory, Event, Thread, Waiter, Timer, Interrupt, the pipe ends
    // and the pipe one-shots. Clock and Mapping handles therefore cannot be
    // given, and a funnel for one would be a method whose every call is an
    // `AccessDenied` fault. There is no `give(process:)` funnel: a launcher
    // keeps the child's Process handle to supervise with. A kind that must
    // travel gets its default set ruled on and a funnel added beside these.
    //
    // `give(system:)` is the one the launch flow turns on: a launcher mints a
    // masked sibling of its own System handle and gives that, which is how a
    // child gets a voice, a clock and its own Process handle without the
    // machine's off switch.

    /// Give a memory region to this process under `tag`, consuming the wrapper.
    /// Requires `ProcessRight.Give` here and `MemoryRight.Transfer` on the
    /// region, which every boot region carries.
    ///
    /// The contract every `give` overload shares: the child's entry carries the
    /// given handle's rights intersected with `keep` (all ones keeps them all).
    /// The child must still be `Created` and `tag` must be new in its boot set.
    ///
    /// The refusal hands the object back. A full child table or boot set is
    /// `SosStatus.NoResource` and a child at its handle quota is
    /// `SosStatus.QuotaExceeded`: resource conditions, not bugs, so the caller
    /// keeps what it had, and the error payload carries the live wrapper. Every
    /// status this op answers is a refusal that left the caller's entry in
    /// place (the kernel binds into the child before it unbinds here), so the
    /// word is still good. Every other failure is a caller error that faults:
    /// the process ends, and teardown covers everything it held.
    ///
    /// The funnel contract: the body disarms before the syscall (no path can
    /// leave two owners of one word), and a refused give is a status, so the
    /// error arm builds a fresh wrapper around the word the kernel provably did
    /// not consume. The old husk is dead on every path.
    public func give(&self, memory: Memory, tag: UInt,
                     keep: UInt32 = ALL_RIGHTS) -> Result<Void, (SosStatus, Memory)> {
        var region = move memory
        let word: UInt = region.handle
        region.handle = MemoryHandle(NO_HANDLE)
        try checked(sos_process_give(self.handle, word, tag, keep as UInt)) catch {
            let back: (SosStatus, Memory) = (error, Memory(handle: MemoryHandle(word)))
            return move back
        }
        return
    }

    /// Give a device window to this process under `tag`, consuming the wrapper.
    /// Requires `ProcessRight.Give` here and `IoMemoryRight.Transfer` on the
    /// window, which every boot window and every carved sub-window carries.
    ///
    /// This is the handover a driver child is made of. A window that arrives as
    /// a capability is a window somebody can hand over, where a window declared
    /// in a driver's own manifest could only ever be granted to the one process
    /// the kernel loads.
    ///
    /// The child maps it, not the launcher. The launcher gives the window and
    /// stops there; the child drains the record, takes the `IoMemory` and calls
    /// `Process.map(iomemory:)` on its own Process handle. What crosses the
    /// boundary is authority over a device, and where the row goes is then the
    /// holder's own business. (A launcher installing a row in a child it
    /// created is `Process.map` below.)
    ///
    /// The funnel contract and the refusal that hands the window back are
    /// `give(memory:)`'s. What the launcher gives away it cannot map anywhere.
    public func give(&self, iomemory: IoMemory,
                     tag: UInt,
                     keep: UInt32 = ALL_RIGHTS) -> Result<Void, (SosStatus, IoMemory)> {
        var window = move iomemory
        let word: UInt = window.handle
        window.handle = IoMemoryHandle(NO_HANDLE)
        try checked(sos_process_give(self.handle, word, tag, keep as UInt)) catch {
            let back: (SosStatus, IoMemory) = (error, IoMemory(handle: IoMemoryHandle(word)))
            return move back
        }
        return
    }

    /// Give a System handle to this process under `tag`, consuming the wrapper.
    ///
    /// A launcher does not give away the System handle it holds; it mints a
    /// masked sibling (`System.mint(rights:)`) and gives that, so what a child
    /// receives was narrowed before it left. Pair it with `start(boot_tag:)`
    /// naming the same tag and the child wakes up holding it, which is how
    /// every process bootstraps: System in the first argument register, its own
    /// Process handle derived from it, its boot set drained from there (§12).
    ///
    /// The sibling's mask is the whole of the policy. `Debug | ProcessSelf |
    /// ClockGet | Transfer` gives a child a voice, an identity and a clock;
    /// `Shutdown`, `ProcessCreate` and `Mint` are absent by silence, so the
    /// child cannot stop the machine, cannot spawn and cannot widen what it
    /// holds. A mint's result is a subset of its source, so no sequence of ops
    /// recovers a masked bit.
    ///
    /// The sibling's mask must keep `Transfer`, the bit this op checks on the
    /// thing being given. What the child receives need not: a `keep` that
    /// leaves `Transfer` out delivers a handle without it.
    public func give(&self, system: System, tag: UInt,
                     keep: UInt32 = ALL_RIGHTS) -> Result<Void, (SosStatus, System)> {
        var authority = move system
        let word: UInt = authority.handle
        authority.handle = SystemHandle(NO_HANDLE)
        try checked(sos_process_give(self.handle, word, tag, keep as UInt)) catch {
            let back: (SosStatus, System) = (error, System(handle: SystemHandle(word)))
            return move back
        }
        return
    }

    /// Give the client end of a connection to this process under `tag`,
    /// consuming the wrapper. Requires `ProcessRight.Give` here and
    /// `PipeInletRight.Transfer` on the end, which every end
    /// `Process.pipe_create` mints carries.
    ///
    /// This is what a pair is for. A launcher creates the connection, keeps or
    /// gives the outlet, and hands the inlet to whoever is to be the client.
    /// The two processes are then joined by a capability neither could have
    /// named otherwise.
    ///
    /// The count does not change. A give is a move: the connection's inlet
    /// column is exactly what it was on both sides of this call, so handing an
    /// end over is never the event that tells the far end anything. Only the
    /// last holder of an end dropping it is news, so a launcher can route an
    /// end through itself without the peer ever seeing peer-gone.
    ///
    /// The funnel contract and the refusal that hands the end back are
    /// `give(memory:)`'s. What you give away you cannot post through.
    public func give(&self, inlet: PipeInlet,
                     tag: UInt,
                     keep: UInt32 = ALL_RIGHTS) -> Result<Void, (SosStatus, PipeInlet)> {
        var client = move inlet
        let word: UInt = client.handle
        client.handle = PipeInletHandle(NO_HANDLE)
        try checked(sos_process_give(self.handle, word, tag, keep as UInt)) catch {
            let back: (SosStatus, PipeInlet) = (error, PipeInlet(handle: PipeInletHandle(word)))
            return move back
        }
        return
    }

    /// Give the server end of a connection to this process under `tag`,
    /// consuming the wrapper. Requires `ProcessRight.Give` here and
    /// `PipeOutletRight.Transfer` on the end.
    ///
    /// The mirror of `give(inlet:)`, for when the child is the server: the
    /// launcher creates the pair, gives the child the outlet and keeps the
    /// inlet, and the child's loop is a `take` poll.
    public func give(&self, outlet: PipeOutlet,
                     tag: UInt,
                     keep: UInt32 = ALL_RIGHTS) -> Result<Void, (SosStatus, PipeOutlet)> {
        var server = move outlet
        let word: UInt = server.handle
        server.handle = PipeOutletHandle(NO_HANDLE)
        try checked(sos_process_give(self.handle, word, tag, keep as UInt)) catch {
            let back: (SosStatus, PipeOutlet) = (error, PipeOutlet(handle: PipeOutletHandle(word)))
            return move back
        }
        return
    }

    /// Give a claim on a reply to this process under `tag`, consuming the
    /// wrapper. Requires `ProcessRight.Give` here and `PipeReplyRight.Transfer`
    /// on the claim.
    ///
    /// §2.1 makes both one-shots transferable, and this is the client side: it
    /// hands the right to read one answer to somebody else. A client that has
    /// asked a question and wants a third party to collect the reply gives the
    /// claim away; the obligation still names the same ring slot, and whoever
    /// holds the claim when the reply is written is who gets it.
    ///
    /// The funnel contract and the refusal that hands the claim back are
    /// `give(memory:)`'s.
    public func give(&self, reply: PipeReply,
                     tag: UInt,
                     keep: UInt32 = ALL_RIGHTS) -> Result<Void, (SosStatus, PipeReply)> {
        var claim = move reply
        let word: UInt = claim.handle
        claim.handle = PipeReplyHandle(NO_HANDLE)
        try checked(sos_process_give(self.handle, word, tag, keep as UInt)) catch {
            let back: (SosStatus, PipeReply) = (error, PipeReply(handle: PipeReplyHandle(word)))
            return move back
        }
        return
    }

    /// Give an obligation to reply to this process under `tag`, consuming the
    /// wrapper. Requires `ProcessRight.Give` here and
    /// `PipeRequestRight.Transfer` on the obligation.
    ///
    /// This is §2.1's delegation primitive in one call. A filesystem receives a
    /// read, forwards the request handle to the flash driver, and the driver
    /// replies with the hardware bytes straight to the original client; the
    /// payload never transits the middle process. Single use survives the
    /// transfer, because it is a property of the exchange rather than of who
    /// holds the handle: one reply may be written, wherever it is written from.
    ///
    /// A request handle can also travel in a message, which makes the
    /// delegation a protocol rather than launch-time wiring.
    public func give(&self, request: PipeRequest,
                     tag: UInt,
                     keep: UInt32 = ALL_RIGHTS) -> Result<Void, (SosStatus, PipeRequest)> {
        var obligation = move request
        let word: UInt = obligation.handle
        obligation.handle = PipeRequestHandle(NO_HANDLE)
        try checked(sos_process_give(self.handle, word, tag, keep as UInt)) catch {
            let back: (SosStatus, PipeRequest) = (error, PipeRequest(handle: PipeRequestHandle(word)))
            return move back
        }
        return
    }

    /// Give an Event to this process under `tag`, consuming the wrapper.
    /// Requires `ProcessRight.Give` here and `EventRight.Transfer` on the
    /// Event.
    ///
    /// An Event is a shared kind: the child's handle keeps it live after the
    /// giver releases its own, or dies (§2.10). `keep` narrows what the child
    /// holds, so a producer end is `EventRight.Signal` alone.
    ///
    /// A full-rights give hands over the right to attach, and an object is
    /// attached to at most one Waiter whichever handle names it, so a giver
    /// that attaches the Event itself withholds `EventRight.Wait` in `keep`.
    ///
    /// The funnel contract and the refusal that hands the Event back are
    /// `give(memory:)`'s.
    public func give(&self, event: Event,
                     tag: UInt,
                     keep: UInt32 = ALL_RIGHTS) -> Result<Void, (SosStatus, Event)> {
        var owned = move event
        let word: UInt = owned.handle
        owned.handle = EventHandle(NO_HANDLE)
        try checked(sos_process_give(self.handle, word, tag, keep as UInt)) catch {
            let back: (SosStatus, Event) = (error, Event(handle: EventHandle(word)))
            return move back
        }
        return
    }

    /// Give a Thread to this process under `tag`, consuming the wrapper.
    /// Requires `ProcessRight.Give` here and `ThreadRight.Transfer` on the
    /// Thread.
    ///
    /// A Thread is bound to the process it runs in, not to whoever holds its
    /// handle: the child's handle joins it as the giver's would have. If the
    /// thread's process dies, a thread that had already exited still answers
    /// `join` with its exit code, and one that had not answers
    /// `Err(SosStatus.Revoked)` (§2.10).
    ///
    /// The funnel contract and the refusal that hands the Thread back are
    /// `give(memory:)`'s.
    public func give(&self, thread: thread.Thread,
                     tag: UInt,
                     keep: UInt32 = ALL_RIGHTS) -> Result<Void, (SosStatus, thread.Thread)> {
        var owned = move thread
        let word: UInt = owned.handle
        owned.handle = ThreadHandle(NO_HANDLE)
        try checked(sos_process_give(self.handle, word, tag, keep as UInt)) catch {
            let back = (error, thread_of(word))
            return move back
        }
        return
    }

    /// Give a Waiter to this process under `tag`, consuming the wrapper.
    /// Requires `ProcessRight.Give` here and `WaiterRight.Transfer` on the
    /// Waiter.
    ///
    /// A Waiter is bound to the process that created it, not to whoever holds
    /// its handle. While that process lives, the child's handle attaches to and
    /// parks on the Waiter as the giver's would. If it dies, every thread
    /// parked on the Waiter wakes with `Err(SosStatus.Revoked)`, what was
    /// attached to it is detached, and every later `add`, `remove`, `wait` and
    /// `mint` answers `Err(SosStatus.Revoked)` (§2.10).
    ///
    /// The funnel contract and the refusal that hands the Waiter back are
    /// `give(memory:)`'s.
    public func give(&self, waiter: Waiter,
                     tag: UInt,
                     keep: UInt32 = ALL_RIGHTS) -> Result<Void, (SosStatus, Waiter)> {
        var owned = move waiter
        let word: UInt = owned.handle
        owned.handle = WaiterHandle(NO_HANDLE)
        try checked(sos_process_give(self.handle, word, tag, keep as UInt)) catch {
            let back: (SosStatus, Waiter) = (error, Waiter(handle: WaiterHandle(word)))
            return move back
        }
        return
    }

    /// Give a Timer to this process under `tag`, consuming the wrapper.
    /// Requires `ProcessRight.Give` here and `TimerRight.Transfer` on the
    /// Timer.
    ///
    /// A Timer is bound to the process that created it. If that process dies,
    /// the Timer is disarmed for good, an attachment on it fires once more with
    /// a fire count of zero and keeps reporting that until it is removed, and
    /// every later `arm`, `disarm` and `mint` answers `Err(SosStatus.Revoked)`
    /// (§2.10).
    ///
    /// The funnel contract and the refusal that hands the Timer back are
    /// `give(memory:)`'s.
    public func give(&self, timer: Timer,
                     tag: UInt,
                     keep: UInt32 = ALL_RIGHTS) -> Result<Void, (SosStatus, Timer)> {
        var owned = move timer
        let word: UInt = owned.handle
        owned.handle = TimerHandle(NO_HANDLE)
        try checked(sos_process_give(self.handle, word, tag, keep as UInt)) catch {
            let back: (SosStatus, Timer) = (error, Timer(handle: TimerHandle(word)))
            return move back
        }
        return
    }

    /// Give an Interrupt to this process under `tag`, consuming the wrapper.
    /// Requires `ProcessRight.Give` here and `InterruptRight.Transfer` on the
    /// Interrupt.
    ///
    /// This is how a driver gets its line: a launcher holding
    /// `SystemRight.InterruptBind` binds it (`System.interrupt_bind`) and gives
    /// the one handle to the process that services it, which holds that line
    /// and no authority to bind another (§9). The give moves the Interrupt's
    /// one name and unbinds nothing; `keep` narrows what the driver holds
    /// (`InterruptRight.Wait` and `.Ack`).
    ///
    /// The funnel contract and the refusal that hands the Interrupt back are
    /// `give(memory:)`'s: a refused give leaves the line bound and the
    /// returned wrapper usable.
    public func give(&self, interrupt: Interrupt,
                     tag: UInt,
                     keep: UInt32 = ALL_RIGHTS) -> Result<Void, (SosStatus, Interrupt)> {
        var owned = move interrupt
        let word: UInt = owned.handle
        owned.handle = InterruptHandle(NO_HANDLE)
        try checked(sos_process_give(self.handle, word, tag, keep as UInt)) catch {
            let back: (SosStatus, Interrupt) = (error, Interrupt(handle: InterruptHandle(word)))
            return move back
        }
        return
    }

    /// Make a connection in this process and receive both of its ends (spec
    /// §2.1). Requires `ProcessRight.PipeCreate`.
    ///
    /// The factory is on the Process object, not on System. Pipes are IPC and
    /// carry nothing system-shaped. The bit narrows a handle, not a process: a
    /// Process handle without it cannot make a connection, but a process whose
    /// System handle carries `SystemRight.ProcessSelf` can derive one that can
    /// (`process_self` mints the default set intersected with its own mask on
    /// every call). `EventCreate` and `WaiterCreate` are the precedents;
    /// `ProcessCreate` goes the other way because a process is machine-global
    /// and a pipe is not.
    ///
    /// Both ends come back at once. An op returns one word and a connection has
    /// two ends, so the kernel answers with a two-word copy-out record (the
    /// funnel `Clock.now` uses), decoded here into the two owning wrappers. A
    /// caller never sees the record or a word.
    ///
    /// The creator holds both and wires them outward with `give`: `let (inlet,
    /// outlet) = try proc.pipe_create()`, then `child.give(inlet: move inlet,
    /// tag: ...)` and keep the outlet, or the mirror.
    ///
    /// A process at its pipe or handle quota is `SosStatus.QuotaExceeded` (one
    /// pipe charge covers the pair), and a full slab or handle table is
    /// `SosStatus.NoResource`. Either way nothing was created and neither table
    /// moved.
    public func pipe_create(&self) -> Result<(PipeInlet, PipeOutlet), SosStatus> {
        pipe_create_into_frame(self.handle)
    }

    // -------------------------------------------------------------------------
    // The map funnels
    // -------------------------------------------------------------------------
    //
    // The receiver is the process being mapped into, which the module order
    // forces: `BootHandle` carries a `Memory?` and an `IoMemory?`, so
    // `sos.memory` and `sos.iomemory` are below this module, and a `map`
    // written there naming `Process` would be an import cycle. The funnels read
    // like `give` one section up (`child.map(memory: &region, access: RW)`
    // beside `child.give(memory: move region, tag: 3)`). The syscall's own
    // receiver is still the region handle; every one of these methods passes
    // `self.handle` as the target argument.
    //
    // Nothing is consumed and there is no disarm, unlike the give funnels: a
    // map moves no handle word. The region stays in the caller's table, the
    // target Process handle stays the caller's, and what comes back is a new
    // capability naming a row. There is no word that left, so there is nothing
    // to write `NO_HANDLE` over. The borrows say it in the signature:
    // `&Memory`, `&IoMemory`, `&self`.

    /// Install `memory` in this process's address space, and answer with the
    /// Mapping that names the row. Requires `ProcessRight.Map` here and
    /// `MemoryRight.Map` on the region.
    ///
    /// Two rights on two objects, because possession of bytes must not imply
    /// authority over somebody's address space. A launcher handed a region
    /// without `Map` on the child's handle has memory it cannot install
    /// anywhere, which a single right could not express.
    ///
    /// The caller supplies no address; the kernel chooses. Read the result with
    /// `Mapping.base()`. This keeps a Memory a capability rather than a
    /// description and is why this method answers with a Mapping instead of a
    /// number.
    ///
    /// `access` is a mask of `MapAccess` bits, and a property of this mapping
    /// rather than of the region, so one region can be mapped read-only in one
    /// place and read-write in another. A double map is allowed: two rows, two
    /// Mappings.
    ///
    /// Write without read, no access at all, a bit outside the three, and a
    /// range this machine cannot grant all terminate the caller. The target's
    /// mapping quota is capped at the protection rows its domain has left
    /// (on one profile a fixed number of hardware regions), so a domain with no
    /// row left is `SosStatus.QuotaExceeded`; so is a caller at its handle
    /// quota. No address space left for the range in the target's domain, a
    /// full mapping slab or a full handle table is `SosStatus.NoResource`.
    ///
    /// It works before `start()` and after it. A mapping is not a boot record:
    /// the give-freeze (§12's "the boot set freezes at start") does not apply,
    /// because a row is not a handle in the child's table and installing one
    /// answers no question the child has already asked. Mapping into a
    /// `Created` child is how a launcher hands over memory the child's image
    /// never declared.
    ///
    /// It does not work on a dead process: the answer is
    /// `Err(SosStatus.Revoked)` (a body is gone, and the mapper did not cause
    /// that). A supervisor's handle onto a dead child outlives it on purpose
    /// (reading how it died is what the handle is for).
    public func map(&self, memory: &Memory,
                    access: UInt32) -> Result<Mapping, SosStatus> {
        let raw = try call_value(memory.handle, MemoryOp.Map as UInt,
                                 self.handle, access as UInt, 0)
        return Mapping(handle: MappingHandle(raw))
    }

    /// Install `iomemory` in this process's address space: a device window,
    /// with device memory attributes. Requires `ProcessRight.Map` here and
    /// `IoMemoryRight.Map` on the window.
    ///
    /// There is no `access:` argument. An IoMemory can only ever produce a
    /// device-attribute row (read-write, never executable, never cacheable), so
    /// a driver cannot get a cached view of a register block by any spelling
    /// available to it. The guarantee is which method exists, not a check
    /// somebody runs.
    ///
    /// A driver receives its window as a capability and maps it into itself
    /// with this call. Because the window is something a launcher hands over, a
    /// driver child is possible at all.
    public func map(&self, iomemory: &IoMemory) -> Result<Mapping, SosStatus> {
        let raw = try call_value(iomemory.handle, IoMemoryOp.Map as UInt,
                                 self.handle, 0, 0)
        return Mapping(handle: MappingHandle(raw))
    }

    /// Take the next handle out of the calling process's boot set (spec §12),
    /// whichever process this handle names. Requires
    /// `ProcessRight.BootHandles`.
    ///
    /// §12 keeps the boot set one handle wide at the entry register (the System
    /// handle), so everything else the kernel minted before the process ran is
    /// collected rather than passed. This is that collection, one record at a
    /// time, and a launcher's first loop is built on it.
    ///
    /// Exhaustion is `Err(SosStatus.Drained)`, and it is the loop's exit, not a
    /// failure to report: a drain ends by meeting the end. It stays drained, so
    /// asking again is safe and answers the same.
    ///
    /// Each record carries a tag. In root's set it is the ordinal of the boot
    /// region the record names; in a child's it is the tag its launcher gave
    /// the handle under. The kernel assigns no meaning to either (which image,
    /// which destination, which device); the meaning is config.
    public func boot_handle_next(&self) -> Result<BootHandle, SosStatus> {
        boot_handle_into_frame(self.handle)
    }

    /// Mint a sibling of this Process handle, narrowed by a keep mask: the
    /// universal `MINT_OP`, on `System.mint`'s terms exactly (see it for the
    /// fail-closed polarity and the maskable `Mint` bit). Requires
    /// `ProcessRight.Mint` on this handle.
    ///
    /// This is where withholding `ProcessRight.Stats` is written: "you may
    /// learn my child died, and not watch it work". A launcher supervising a
    /// child through a sibling minted here holds exactly the authority its mask
    /// names.
    ///
    /// The mask cannot reach what the child derives for itself: a child derives
    /// its own Process handle from its System handle through `process_self()`,
    /// which takes its own keep mask. So this narrows what a supervisor may ask
    /// about a child, not what the child may ask about itself.
    ///
    /// A process at its handle quota gets `SosStatus.QuotaExceeded`; a full
    /// handle table is `SosStatus.NoResource`. A handle without `Mint`
    /// terminates the caller.
    public func mint(&self,
                     rights: UInt32 = ALL_RIGHTS) -> Result<Process, SosStatus> {
        let raw = try call_value(self.handle, MINT_OP, rights as UInt, 0, 0)
        return Process(handle: ProcessHandle(raw))
    }

    /// How many traps this process has taken, split by kind. Requires
    /// `ProcessRight.Stats`.
    ///
    /// Read `ProcessStats` for what each column counts and which one is worth
    /// asserting on. At a call site:
    ///
    ///   - The receiver is whose counters come back. `process_self()` then
    ///     `stats()` is self-inspection; the same call on a child's handle is
    ///     supervision, and it reads a dead child's columns perfectly well,
    ///     which is the only way to see the `faults` column move, since a
    ///     faulting process is not there to ask.
    ///   - This call is itself a syscall and is counted before it answers. A
    ///     delta between two readings therefore includes the second reading's
    ///     own trap; subtract that one where the measured window is what
    ///     matters.
    ///
    /// The answer rides the copy-out funnel (`Clock.now`'s) because three
    /// 64-bit columns fit no value register on any profile. It allocates
    /// nothing and charges no quota, so a correct caller meets no failure here
    /// at all.
    public func stats(&self) -> Result<ProcessStats, SosStatus> {
        process_stats_into_frame(self.handle)
    }
}

// The `Waiter.add(process:, key:)` overload lives here because it reads
// `process.handle`, so it must sit where `Process` is declared. Extension
// lookup follows the facade's `public import`, so callers see it as a member of
// `Waiter`.
extension Waiter {
    /// Watch a process die: attach it under `key`, which a `wait()` hands back
    /// with the §8 status word when it ends, whatever ended it (spec §8).
    /// Requires `ProcessRight.Wait` there and `WaiterRight.Attach` here. It is
    /// the same bit `get_status` spends, because being woken by a death and
    /// asking whether one happened are one question at two tempos.
    ///
    /// Every rule the other overloads state holds unchanged: keys are unique
    /// per Waiter, an object is attached to at most one Waiter, readiness is
    /// level-triggered. What is new is that death is a terminal level. An
    /// Event's word and a Timer's fire count are consumed by the wait that
    /// reports them; a death is not. A process that was already dead when you
    /// attached still wakes you, so there is no window in which a death can be
    /// missed, and a second `wait()` on the same attachment answers the same
    /// word. Nothing un-dies.
    ///
    /// The process is borrowed and nothing is consumed: an attachment is a
    /// subscription the Waiter owns, so the handle stays yours, and dropping it
    /// detaches nothing (`remove(key)` does). The attachment is also a
    /// reference: a dead process's record lives until both its last handle
    /// and its attachment are gone, which keeps the status word readable for
    /// as long as anybody is watching.
    public func add(&self, process: &Process, key: UInt,
                    mode: AttachMode = AttachMode.Persistent) -> Result<Void, SosStatus> {
        self.attach(process.handle, key, mode_flag(mode))
    }

    /// Hand a process handle to this Waiter, and stop holding it: `give`'s
    /// Process overload, declared here for the reason `add`'s is.
    ///
    /// Everything `Waiter.give(event:)` says holds word for word. The wait-once
    /// death supervisor is the shape it serves: a launcher that only wants to
    /// be told a child ended gives the handle to its Waiter and holds nothing,
    /// with no `remove` to write and no handle to release. The process
    /// record's last reader is the subscription, which keeps the §8 status
    /// word readable until it is delivered.
    ///
    /// The default `OneShot` is right here as nowhere else: nothing un-dies, so
    /// a persistent subscription to a death could never fire twice.
    public func give(&self, process: Process, key: UInt,
                     mode: AttachMode = AttachMode.OneShot
    ) -> Result<Void, (SosStatus, Process)> {
        var owned = move process
        let word: UInt = owned.handle
        owned.handle = ProcessHandle(NO_HANDLE)
        try self.attach_consuming(word, key, mode) catch {
            let back: (SosStatus, Process) = (error, Process(handle: ProcessHandle(word)))
            return move back
        }
        return
    }
}

// =============================================================================
// The boot set's record (spec §12)
// =============================================================================

/// One entry of a process's boot set, decoded.
///
/// It is declared here and not in `sosabi` because it carries owning
/// wrappers: what a process receives for a boot handle is a `Memory` (or
/// another wrapper) and never a number, and `sosabi` cannot name those types.
/// `WaitResult` lives in `sos.pipe` for the same reason. The three-word wire
/// layout is still declared exactly once, in `sosabi`.
///
/// Exactly one wrapper per word is the constraint the owning tier puts on this
/// record. The record is `NoCopy`, because a copyable record holding a `Memory`
/// would be two owners of one handle. The region is an `Optional` behind
/// `take_memory` rather than a public field, because a `NoCopy` field cannot be
/// moved out of a struct (there are no partial moves in Saw). `Optional.take`
/// writes `None` into the place and hands the payload over owned.
///
/// A record whose region was never taken releases it when the record drops. An
/// iterator entry a launcher looked at and did not want is a capability it
/// declined.
///
/// Don't make the record copyable with a `memory()` method minting a wrapper:
/// two copies would mint two owners for one word, and the second drop would be
/// a fault the program did nothing to deserve.
public struct BootHandle {
    /// The giver's own word, handed back unread. For root's boot set the kernel
    /// is the giver and this is a region ordinal: row `n` of the build's region
    /// table is tag `n`. For a child's set the launcher is the giver and this
    /// is whatever it chose at `Process.give(..., tag:)`. Either way the kernel
    /// assigns it no meaning: the tag is the identity, and identities are the
    /// only cross-process vocabulary there is.
    public tag: UInt,
    /// What kind of object was minted, so a caller knows which accessor to
    /// reach for. A caller that asserts this is asserting the giver gave what
    /// its config says it gave.
    public kind: BootHandleKind,
    /// The region itself, until somebody takes it. Private on purpose: the only
    /// way out is `take_memory`, which is what makes the one-owner rule hold.
    memory: Memory?,
    /// The Process handle, on the same terms; `take_process` is its one door.
    process: Process?,
    /// The System handle, on the same terms; `take_system` is its one door. A
    /// record has one object, so at most one of these slots is ever occupied
    /// and `kind` says which. They are separate fields rather than an enum
    /// payload because asking the wrong one must be harmless: an enum would
    /// have to be taken out of the record to be matched, and a mismatch would
    /// then drop a capability the caller still wanted.
    system: System?,
    /// The device window, on the same terms; `take_iomemory` is its one door. A
    /// device row of the build's region table mints an `IoMemory`, and a
    /// driver's first act is to drain it.
    iomemory: IoMemory?,
    /// The client end of a connection, on the same terms; `take_inlet` is its
    /// one door. A launcher creates a pair and gives one end across, and the
    /// child drains it as it drains a region.
    inlet: PipeInlet?,
    /// The server end, on the same terms; `take_outlet` is its one door. Which
    /// end a child receives is entirely its launcher's config, so both
    /// spellings exist and a record carries at most one of them.
    outlet: PipeOutlet?,
    /// A claim on one reply, on the same terms; `take_reply` is its one door.
    /// §2.1 makes both one-shots transferable, so any holder may hand one
    /// across, and a child collects it as it collects a region.
    reply: PipeReply?,
    /// An obligation to reply, on the same terms; `take_request` is its one
    /// door. §2.1 calls it the delegation primitive: a child that receives one
    /// answers a question it was never asked, and its bytes go straight to
    /// whoever asked it.
    request: PipeRequest?,
    /// A notification, on the same terms; `take_event` is its one door. A
    /// launcher hands a child an Event, often narrowed to the producer or the
    /// consumer end, and the child drains it as it drains a region.
    event: Event?,
    /// A Thread, on the same terms; `take_thread` is its one door. A launcher
    /// hands a child the thread it is to join.
    thread: thread.Thread?,
    /// A Waiter, on the same terms; `take_waiter` is its one door.
    waiter: Waiter?,
    /// A Timer, on the same terms; `take_timer` is its one door.
    timer: Timer?,
    /// An Interrupt, on the same terms; `take_interrupt` is its one door. A
    /// launcher binds a line and hands the driver that services it the one
    /// handle.
    interrupt: Interrupt?,
}

extension BootHandle: NoCopy {}

extension BootHandle {
    /// Take the region out of this record, leaving it empty.
    ///
    /// It answers `None` on the second call, and `None` on a record that is not
    /// a region at all. Neither is an error condition to dress up: a record has
    /// one object, and asking for the wrong kind or asking twice is asking for
    /// a capability this record does not have. Callers that know better write
    /// `!`. It never disturbs the other slots, which makes asking the wrong
    /// question harmless.
    ///
    /// `&var self` because taking writes the record, which makes the transfer
    /// visible in the type rather than in a convention.
    public func take_memory(&var self) -> Memory? {
        self.memory.take()
    }

    /// Take the Process handle out of this record, leaving it empty. Same terms
    /// as `take_memory`.
    ///
    /// A record left holding one releases it when it drops. A handle that was
    /// the child's boot tag never reaches this accessor: `start(boot_tag:)`
    /// takes that record, so the drain never hands the same word back.
    public func take_process(&var self) -> Process? {
        self.process.take()
    }

    /// Take the System handle out of this record. Same terms as `take_memory`.
    ///
    /// A launcher's masked sibling arrives as one of these when it is given
    /// under a tag the child drains. When it is given as the child's boot tag
    /// (the ordinary shape) the child never meets this accessor: the register
    /// is the delivery and the record is consumed by it.
    public func take_system(&var self) -> System? {
        self.system.take()
    }

    /// Take the device window out of this record. Same terms as `take_memory`.
    ///
    /// A driver's first act: the window is a capability its boot set carries,
    /// and `Process.map(iomemory:)` is what installs it.
    public func take_iomemory(&var self) -> IoMemory? {
        self.iomemory.take()
    }

    /// Take the client end of a connection out of this record. Same terms as
    /// `take_memory`.
    ///
    /// A child that is to be a client drains this and posts through it. Asking
    /// for the wrong end is `None` and disturbs nothing, which is why separate
    /// slots are the right shape rather than an enum payload.
    public func take_inlet(&var self) -> PipeInlet? {
        self.inlet.take()
    }

    /// Take the server end of a connection out of this record. Same terms as
    /// `take_memory`.
    public func take_outlet(&var self) -> PipeOutlet? {
        self.outlet.take()
    }

    /// Take a claim on a reply out of this record. Same terms as `take_memory`.
    ///
    /// A record left holding one releases it when it drops, which for a claim
    /// is not merely tidy: releasing the last claim on an exchange tells the
    /// server its client has abandoned the question.
    public func take_reply(&var self) -> PipeReply? {
        self.reply.take()
    }

    /// Take an obligation to reply out of this record. Same terms as
    /// `take_memory`, and the same sentence as `take_reply` from the other
    /// side: a record left holding one releases it, which tells the client that
    /// nobody will answer.
    public func take_request(&var self) -> PipeRequest? {
        self.request.take()
    }

    /// Take an Event out of this record. Same terms as `take_memory`. A record
    /// left holding one releases it when it drops.
    public func take_event(&var self) -> Event? {
        self.event.take()
    }

    /// Take a Thread out of this record. Same terms as `take_memory`. A record
    /// left holding one releases it when it drops.
    public func take_thread(&var self) -> thread.Thread? {
        self.thread.take()
    }

    /// Take a Waiter out of this record. Same terms as `take_memory`. A record
    /// left holding one releases it when it drops.
    public func take_waiter(&var self) -> Waiter? {
        self.waiter.take()
    }

    /// Take a Timer out of this record. Same terms as `take_memory`. A record
    /// left holding one releases it when it drops.
    public func take_timer(&var self) -> Timer? {
        self.timer.take()
    }

    /// Take an Interrupt out of this record. Same terms as `take_memory`.
    ///
    /// A record left holding one releases it when it drops, and an Interrupt
    /// has one name, so that destroys it: the line is unbound and bindable
    /// again.
    public func take_interrupt(&var self) -> Interrupt? {
        self.interrupt.take()
    }
}

/// A `Thread` around `word`. `give(thread:)` builds its hand-back through this
/// because its parameter is named `thread`, which hides the module qualifier
/// inside its body.
func thread_of(word: UInt) -> thread.Thread {
    thread.Thread(handle: ThreadHandle(word))
}

/// Decode a record the kernel copied out into a `BootHandle`.
///
/// An unknown kind panics, for the reason `decode_wait`'s unknown tag does: the
/// kernel wrote it out of the same `BootHandleKind` declaration this function
/// reads, so a kind that does not decode is a skew between the kernel and the
/// `sos` module it exports, not a runtime condition a caller could act on.
func decode_boot_handle(tag: UInt, kind: UInt, handle: UInt) -> BootHandle {
    guard let what = BootHandleKind.from(raw: kind) else {
        panic("sos: kernel wrote boot handle kind {}, which this build cannot name",
              kind)
    }
    match what {
        case Memory -> BootHandle(tag: tag, kind: what,
                                  memory: Memory(handle: MemoryHandle(handle)),
                                  process: None, system: None, iomemory: None,
                                  inlet: None, outlet: None, reply: None,
                                  request: None, event: None, thread: None,
                                  waiter: None, timer: None, interrupt: None),
        case Process -> BootHandle(tag: tag, kind: what, memory: None,
                                   process: Process(handle: ProcessHandle(handle)),
                                   system: None, iomemory: None, inlet: None,
                                   outlet: None, reply: None, request: None,
                                   event: None, thread: None, waiter: None,
                                   timer: None, interrupt: None),
        case System -> BootHandle(tag: tag, kind: what, memory: None,
                                  process: None,
                                  system: System(handle: SystemHandle(handle)),
                                  iomemory: None, inlet: None, outlet: None,
                                  reply: None, request: None, event: None,
                                  thread: None, waiter: None, timer: None, interrupt: None),
        case IoMemory -> BootHandle(tag: tag, kind: what, memory: None,
                                    process: None, system: None,
                                    iomemory: IoMemory(handle: IoMemoryHandle(handle)),
                                    inlet: None, outlet: None, reply: None,
                                    request: None, event: None, thread: None,
                                    waiter: None, timer: None, interrupt: None),
        case PipeInlet -> BootHandle(tag: tag, kind: what, memory: None,
                                     process: None, system: None,
                                     iomemory: None,
                                     inlet: PipeInlet(handle: PipeInletHandle(handle)),
                                     outlet: None, reply: None, request: None,
                                     event: None, thread: None, waiter: None,
                                     timer: None, interrupt: None),
        case PipeOutlet -> BootHandle(tag: tag, kind: what, memory: None,
                                      process: None, system: None,
                                      iomemory: None, inlet: None,
                                      outlet: PipeOutlet(handle: PipeOutletHandle(handle)),
                                      reply: None, request: None, event: None,
                                      thread: None, waiter: None, timer: None, interrupt: None),
        case PipeReply -> BootHandle(tag: tag, kind: what, memory: None,
                                     process: None, system: None,
                                     iomemory: None, inlet: None, outlet: None,
                                     reply: PipeReply(handle: PipeReplyHandle(handle)),
                                     request: None, event: None, thread: None,
                                     waiter: None, timer: None, interrupt: None),
        case PipeRequest -> BootHandle(tag: tag, kind: what, memory: None,
                                       process: None, system: None,
                                       iomemory: None, inlet: None,
                                       outlet: None, reply: None,
                                       request: PipeRequest(handle: PipeRequestHandle(handle)),
                                       event: None, thread: None, waiter: None,
                                       timer: None, interrupt: None),
        case Event -> BootHandle(tag: tag, kind: what, memory: None,
                                 process: None, system: None, iomemory: None,
                                 inlet: None, outlet: None, reply: None,
                                 request: None,
                                 event: Event(handle: EventHandle(handle)),
                                 thread: None, waiter: None, timer: None, interrupt: None),
        case Thread -> BootHandle(tag: tag, kind: what, memory: None,
                                  process: None, system: None, iomemory: None,
                                  inlet: None, outlet: None, reply: None,
                                  request: None, event: None,
                                  thread: thread.Thread(handle: ThreadHandle(handle)),
                                  waiter: None, timer: None, interrupt: None),
        case Waiter -> BootHandle(tag: tag, kind: what, memory: None,
                                  process: None, system: None, iomemory: None,
                                  inlet: None, outlet: None, reply: None,
                                  request: None, event: None, thread: None,
                                  waiter: Waiter(handle: WaiterHandle(handle)),
                                  timer: None, interrupt: None),
        case Timer -> BootHandle(tag: tag, kind: what, memory: None,
                                 process: None, system: None, iomemory: None,
                                 inlet: None, outlet: None, reply: None,
                                 request: None, event: None, thread: None,
                                 waiter: None,
                                 timer: Timer(handle: TimerHandle(handle)),
                                 interrupt: None),
        case Interrupt -> BootHandle(tag: tag, kind: what, memory: None,
                                     process: None, system: None,
                                     iomemory: None, inlet: None, outlet: None,
                                     reply: None, request: None, event: None,
                                     thread: None, waiter: None, timer: None,
                                     interrupt: Interrupt(handle: InterruptHandle(handle))),
    }
}

/// The `unsafe` half of `Process.pipe_create`, confined to one small named
/// helper. The record buffer's address never leaves it.
///
/// The tuple is the right answer here, where the boot record needed an
/// `Optional` per slot and a `take_*` per Optional. A `BootHandle` carries at
/// most one of its kinds and a caller must be able to ask the wrong question
/// harmlessly, so its slots have to survive being looked at. A pipe-create
/// answer always carries exactly two wrappers and the caller always wants both,
/// so a destructuring `let` moves each into its own binding and there is no
/// husk to leave behind.
func pipe_create_into_frame(handle: ProcessHandle) unsafe -> Result<(PipeInlet, PipeOutlet), SosStatus> {
    var buf: [UInt; PIPE_CREATE_RECORD_WORDS] = [0; PIPE_CREATE_RECORD_WORDS]
    try checked(sos_process_pipe_create(handle,
                                        (&var buf) as UnsafePointer<UInt>,
                                        pipe_create_record_bytes() as UInt))
    let inlet = PipeInlet(handle: PipeInletHandle(buf[PIPE_CREATE_INLET_WORD]))
    let outlet = PipeOutlet(handle: PipeOutletHandle(buf[PIPE_CREATE_OUTLET_WORD]))
    return (move inlet, move outlet)
}

/// The `unsafe` half of `Process.stats`, confined to one small named helper.
/// The record buffer's address never leaves it.
///
/// The buffer is `[UInt64; N]`, not `[UInt; N]`, unlike the two helpers beside
/// it: the columns are counts and a count is sixty-four bits on every profile,
/// so the slots `sosabi` publishes are doubleword indices. `sos.clock`'s
/// reading buffer is the precedent, one doubleword wide.
func process_stats_into_frame(handle: ProcessHandle) unsafe -> Result<ProcessStats, SosStatus> {
    var buf: [UInt64; PROCESS_STATS_RECORD_DOUBLEWORDS] = [0; PROCESS_STATS_RECORD_DOUBLEWORDS]
    try checked(sos_process_stats(handle, (&var buf) as UnsafePointer<UInt64>,
                                  process_stats_record_bytes() as UInt))
    return ProcessStats(syscalls: buf[PROCESS_STATS_SYSCALLS_SLOT],
                        interrupts: buf[PROCESS_STATS_INTERRUPTS_SLOT],
                        faults: buf[PROCESS_STATS_FAULTS_SLOT])
}

/// The `unsafe` half of `Process.boot_handle_next`, confined to one small named
/// helper. The buffer's address never leaves it.
func boot_handle_into_frame(handle: ProcessHandle) unsafe -> Result<BootHandle, SosStatus> {
    var buf: [UInt; BOOT_HANDLE_RECORD_WORDS] = [0; BOOT_HANDLE_RECORD_WORDS]
    try checked(sos_process_boot_handle_next(handle,
                                             (&var buf) as UnsafePointer<UInt>,
                                             boot_handle_record_bytes() as UInt))
    return decode_boot_handle(buf[BOOT_HANDLE_TAG_WORD],
                              buf[BOOT_HANDLE_KIND_WORD],
                              buf[BOOT_HANDLE_HANDLE_WORD])
}

// =============================================================================
// StatsRegion: the mapped view of the machine's trap counters
// =============================================================================

/// The machine's trap counters, in this process's own address space. Built by
/// `System.stats_region_map` and by nothing else.
///
/// It owns the access, not the bytes. The `Mapping` inside is the installed
/// protection row; the page underneath is the kernel's and is never anybody's
/// to own. That is why there is no `Memory` here and no way to obtain one:
/// splitting or donating the page the kernel counts traps into could mean
/// nothing.
///
/// `NoCopy`, and dropping it releases the handle without unmapping, as for
/// `Mapping`, inherited by containment. A `StatsRegion` that falls out of scope
/// leaves its row installed: permanent, safe but leaked, never a dangling read.
/// Call `unmap()` where revocation is meant.
///
/// The three layout numbers are read once, out of the header the kernel
/// published, and kept: the header is written at boot and never again.
public struct StatsRegion {
    /// The row's owner. Package-private: a holder reaches it through `unmap()`,
    /// which is the only thing a caller has any business doing with it.
    public(package) mapping: Mapping,
    /// Where the region starts in this process's address space: the kernel's
    /// answer, read from `Mapping.base()` and never assumed.
    public base: UInt,
    /// How many rows the region publishes: one per process body this machine
    /// can ever hand out.
    public rows: Int,
    /// Bytes from `base` to row 0, as published.
    public(package) rows_offset: UInt,
    /// Bytes per row, as published.
    public(package) row_bytes: UInt,
    /// Which row is the caller's own. Rows are indexed by process body and
    /// body numbering is kernel-internal, so this is the number that makes the
    /// table addressable to the process reading it.
    public self_row: Int,
}

extension StatsRegion: NoCopy {}

extension StatsRegion {
    /// Row `index`'s three columns, read out of the mapped page with no syscall
    /// at all.
    ///
    /// The numbers mean exactly what `Process.stats()` means (see
    /// `ProcessStats`) and come from the same storage, so the two surfaces
    /// cannot disagree. A row belonging to a body no process currently occupies
    /// reads as whatever its last occupant left, until a create zeroes it:
    /// `rows` is a capacity, not a census, and the region publishes no liveness
    /// column.
    ///
    /// A 32-bit reader can tear; see `System.stats_region_map` for the whole
    /// statement. The short version is that a torn column is a value between
    /// two true readings and never one the counter never held.
    ///
    /// An out-of-range `index` panics: a direct indexed accessor on a safe type
    /// is checked and faults loudly rather than clamping or answering nonsense.
    public func row(&self, index: Int) -> ProcessStats {
        if index < 0 || index >= self.rows {
            panic("StatsRegion.row: index out of range: {} (rows {})",
                  index, self.rows)
        }
        let at = self.base + self.rows_offset + (index as UInt) * self.row_bytes
        let raw = read_stats_row(at)
        ProcessStats(syscalls: raw.syscalls, interrupts: raw.interrupts,
                     faults: raw.faults)
    }

    /// This process's own row, `row(self.self_row)`. It is named because it is
    /// what most readers want, and spelling it out invites a caller to
    /// re-derive a number the kernel already answered.
    public func mine(&self) -> ProcessStats {
        self.row(self.self_row)
    }

    /// Take the row back out of this process's domain. The page becomes
    /// unreachable at once, on `Mapping.unmap`'s terms exactly, including the
    /// live-domain rule, since the target is the caller itself.
    ///
    /// Unmapping twice terminates the caller, which is `Mapping.unmap`'s own
    /// refusal and is caller-checkable.
    public func unmap(&self) -> Result<Void, SosStatus> {
        self.mapping.unmap()
    }
}
