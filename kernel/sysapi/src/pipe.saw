//! THE PAIR — `PipeInlet` and `PipeOutlet`, the two ends of a connection (spec
//! §2.1; sawos design 10 D-1, built by design 13).
//!
//! **ONE FILE FOR TWO TYPES, BECAUSE THE PAIR IS ONE OBJECT.** Every other
//! module here is one file per §2 row, and this one is two rows — deliberately:
//! an inlet and an outlet are two counted KINDS over one connection, so every
//! sentence that explains either explains it by contrast with the other. Neither
//! type names the other (an inlet has no way to reach its outlet, and that is the
//! capability model working), so the module graph did not force this; readability
//! did, which is the placement rule the facade's header states now that extension
//! lookup follows `public import` (sawlang 0.2.0, SL-7 closed).
//!
//! It sits one step above the floor and names nothing else, exactly as `memory`
//! does: the FACTORY is `Process.pipe_create`, because it needs a `Process` and
//! `Process` is declared in `sos.system`, which imports this file. See there for
//! the shape that ordering forces — it is the same one `Process.map` has.
//!
//! **FOUR TYPES SINCE M4 UNIT 2** (sawos design 14), and the pair-explains-the-
//! pair reason applies twice: `PipeReply` is the CLIENT's claim on one reply and
//! `PipeRequest` is the SERVER's obligation to send it, so the file holds two
//! pairs and every sentence about either half of either pair reads by contrast
//! with its opposite. They are §2.1's ratified `PipeReplyHandle` /
//! `PipeRequestHandle` under the tree's own convention — a §2 object name renders
//! short at the typed tier, exactly as `MemoryObject` renders as `Memory`.
//!
//! **EVERYTHING POLLS.** Unit 2 still has no waitability and nothing parks, so a
//! full ring, an empty one and a reply that has not been written yet are all "not
//! right now" — and at THIS tier that is not an error: `post` answers
//! `Ok(Some(claim))` or `Ok(None)`, `take` answers `Ok(Some((len, request)))` or
//! `Ok(None)`, and `resolve` answers `Ok(Some(len))` or `Ok(None)`, on design 234
//! §4's two-channel shape, so a poll loop never matches an error case for a
//! condition that clears itself. What IS an error is a peer that is gone, and it
//! is terminal.
//!
//! **SINGLE USE IS RAII HERE AND A LEDGER IN THE KERNEL.** `resolve` and `reply`
//! CONSUME the capability they are called through, and the wrappers say so by
//! disarming their own word — so a used-up one-shot drops to nothing, and reaching
//! for it again is the ordinary `BadHandle` fault design 3's generations exist to
//! draw. The disarm is the transfer-funnel contract (`floor`'s own block) with one
//! documented difference: a `resolve` that answers `Ok(None)` consumed NOTHING, so
//! the disarm is decided by the ANSWER rather than written before the syscall.

import sosabi.{SosStatus, PipeInletHandle, PipeInletOp, PipeOutletHandle,
               PipeOutletOp, PipeReplyHandle, PipeRequestHandle, MINT_OP,
               NO_HANDLE, PIPE_BODY_BYTES, PIPE_TAKE_RECORD_WORDS,
               PIPE_TAKE_LEN_WORD, PIPE_TAKE_REQUEST_WORD, PipeMsg,
               ReplyDelivery, WaitPayload, WaitResult,
               pipe_take_record_bytes}

import sos.floor.{ALL_RIGHTS, call_value, checked, polled_ok, polled_value,
                  sos_handle_release, sos_pipe_inlet_post,
                  sos_pipe_outlet_take, sos_pipe_reply_resolve,
                  sos_pipe_request_reply}
import sos.timer.{Timer}
import sos.waiter.{AttachMode, Waiter, mode_flag}

/// A handle to a PipeInlet — the CLIENT end of a connection, where requests flow
/// IN (spec §2.1; the names are design 10 ruling 2's).
///
/// **A ROLE IS AN OBJECT, NOT A RIGHTS MASK** (design 10 D-1). The kernel does
/// not carry one symmetric pipe object with read and write rights on it, because
/// a parked receiver is itself a holder and a write-capable count on such a thing
/// could never reach zero — the socket-`shutdown()` hole. The bidirectionality
/// dissolves instead: holding one of these means you are the client, and "the
/// writers went to zero" is "every PipeInlet handle onto this connection is
/// gone", which the ordinary reference ledger answers.
///
/// Built by `Process.pipe_create` and by `BootHandle.take_inlet`, and by nothing
/// else — no word constructor, no word extractor, the module docstring's rule.
///
/// **`NoCopy`, AND DROPPING IT RELEASES THE HANDLE** (sawos design 3 D-5). What
/// makes that interesting here rather than merely tidy: dropping the LAST inlet
/// is what tells the far end that no request will ever arrive again. Release is
/// the only way to say it, and RAII is what makes saying it the default —
/// `let _ = move inlet` is a deliberate close, and letting one fall out of scope
/// is the same act written by the language.
public struct PipeInlet {
    public(package) handle: PipeInletHandle,
}

extension PipeInlet: NoCopy {
    /// Drop is release; see `System`'s deinit for the sentinel and the discard.
    func deinit(&var self) {
        if self.handle != NO_HANDLE {
            let _ = sos_handle_release(self.handle)
        }
    }
}

extension PipeInlet {
    /// **STAGE A MESSAGE FOR THE FAR END.** Requires `PipeInletRight.Post`.
    ///
    /// `Ok(Some(claim))` the message is staged; `Ok(None)` THE RING IS FULL and
    /// nothing was staged — call again once an exchange has settled. The absence
    /// is not a failure and does not belong in the error channel: design 234 §4's
    /// rule, that a poll loop must be able to tell "not yet" from "broken", read
    /// at the sending end.
    ///
    /// **IT NEVER BLOCKS AND NEVER WILL** (design 10 ruling 4): `post` is the
    /// ONE kernel primitive on the client side, and blocking send,
    /// `send(timeout:)`, TELL and cancel are all compositions over it plus the
    /// Timer and Waiter machinery — which is what keeps the kernel from ever
    /// learning what a timeout is. Those compositions arrive with waitability in
    /// unit 3; until then this is the whole client surface.
    ///
    /// `len` may be ZERO — a data-free message is §2.1's own option — and a
    /// zero-length post reads no buffer at all. A `len` above `PIPE_BODY_BYTES`
    /// TERMINATES the caller: the maximum is published, and the caller chose the
    /// number.
    ///
    /// `Err(SosStatus.PeerClosed)` means every outlet handle onto this
    /// connection is gone, so nobody can ever take what you would send. It is
    /// TERMINAL — nothing un-closes — so a caller may stop rather than retry.
    ///
    /// **AND IT ANSWERS THE CLAIM** (sawos design 14; §2.1's `send` yields a
    /// `PipeReplyHandle`, and this is it). `Ok(Some(claim))` is a staged message
    /// AND the client's claim on the one reply it is owed; hold it and `resolve`
    /// it, hand it on with `give`, or DROP it — dropping is §2.1's cancellation
    /// primitive and the TELL idiom's second half, and the server is told by its
    /// `reply` answering `PeerClosed`.
    ///
    /// **A CLAIM HOLDS A RING SLOT UNTIL THE EXCHANGE SETTLES**, which is what
    /// makes `Ok(None)` mean more than it did in unit 1: a full ring counts
    /// AWAITING-REPLY exchanges now, not merely untaken messages, so a client
    /// that never resolves will meet its own in-flight budget.
    public func post(&self, body: &[UInt8; PIPE_BODY_BYTES],
                     len: UInt) -> Result<PipeReply?, SosStatus> {
        post_body(self.handle, &body, len)
    }

    /// **MINT A SIBLING of this inlet, narrowed by a KEEP MASK** — the universal
    /// `MINT_OP`, on `Memory.mint`'s exact terms. Requires the universal
    /// `PipeInletRight.Mint` on THIS handle.
    ///
    /// **THIS IS WHERE A LAUNCHER'S PIPE POLICY IS WRITTEN.** An endpoint's
    /// default set is permissive — `Transfer | Mint | Post`, and it has to be,
    /// because attenuation is monotonic and a bit not minted at creation could
    /// never appear later — so what a child may do with the end it is handed is
    /// decided here, once, by the mask:
    ///
    /// ```saw
    /// let for_child = inlet.mint(rights: PipeInletRight.Transfer
    ///                                    | PipeInletRight.Post)!
    /// child.give(inlet: move for_child, tag: REQUESTS)
    /// ```
    ///
    /// That child can post and can hand the end on, and can never mint a
    /// narrower sibling of its own.
    ///
    /// **A SIBLING IS A SECOND NAME AND THEREFORE A SECOND REFERENCE** on this
    /// connection's INLET column, which is what makes D-1's v1 rule — any handle
    /// to an end holds that end open, the Unix `dup` precedent — true by
    /// construction. Dropping one of two siblings tells the far end nothing;
    /// only the last one going is news.
    public func mint(&self,
                     rights: UInt32 = ALL_RIGHTS) -> Result<PipeInlet, SosStatus> {
        let raw = try call_value(self.handle, MINT_OP, rights as UInt, 0, 0)
        return PipeInlet(handle: PipeInletHandle(raw))
    }
}

/// The `unsafe` half of `PipeInlet.post`, confined to one small named helper
/// (design 136). The body's address never leaves it.
///
/// The word the kernel answers with is a HANDLE, and this is the one place it is
/// ever seen as a number: the wrapper is built here and everything above this
/// line owns a `PipeReply` instead.
func post_body(handle: PipeInletHandle, body: &[UInt8; PIPE_BODY_BYTES],
               len: UInt) unsafe -> Result<PipeReply?, SosStatus> {
    var value: UInt = 0
    let raw = sos_pipe_inlet_post(handle, (&body) as UnsafePointer<UInt8>, len,
                                  (&var value) as UnsafePointer<UInt>)
    let word = try polled_value(raw, value)
    guard let staged = word else { return None }
    let claim: PipeReply? = PipeReply(handle: PipeReplyHandle(staged))
    return move claim
}

/// A handle to a PipeOutlet — the SERVER end of a connection, where requests
/// come OUT (spec §2.1; design 10 ruling 2).
///
/// The mirror of `PipeInlet` in every respect but two: which reference column it
/// counts on, and which op it carries. Everything that type's docstring says
/// about roles-as-objects, about `NoCopy` and about what dropping the last one
/// means holds here with the direction reversed — a dropped last OUTLET tells
/// the client that nothing it sends can ever be read, which is the same peer-gone
/// doctrine seen from the other side.
///
/// Built by `Process.pipe_create` and by `BootHandle.take_outlet`, and by
/// nothing else.
public struct PipeOutlet {
    public(package) handle: PipeOutletHandle,
}

extension PipeOutlet: NoCopy {
    /// Drop is release; see `System`'s deinit for the sentinel and the discard.
    func deinit(&var self) {
        if self.handle != NO_HANDLE {
            let _ = sos_handle_release(self.handle)
        }
    }
}

extension PipeOutlet {
    /// **TAKE THE OLDEST STAGED MESSAGE** into `into`, and answer how many bytes
    /// of it are real **AND THE OBLIGATION TO REPLY TO IT**. Requires
    /// `PipeOutletRight.Take`.
    ///
    /// `Ok(Some((n, request)))` a message arrived, its first `n` bytes are yours,
    /// and `request` is the server's obligation to send exactly one reply;
    /// `Ok(None)` NOTHING IS STAGED — call again. The `None` is design 234 §4's
    /// two-channel shape, and the reason it is not an error is that reason
    /// exactly: a server polling an idle connection is not a server meeting a
    /// failure, and a shape that could not tell those apart would make the poll
    /// loop unwritable.
    ///
    /// **THE OBLIGATION IS THE HALF M4 UNIT 2 ADDED** (sawos design 14): discharge
    /// it with `reply`, hand it on with `give` — §2.1's delegation primitive, and
    /// the reply then goes STRAIGHT to the original client — or drop it, which
    /// tells the client `PeerClosed` at its next `resolve`. Dropping is a
    /// legitimate answer; what is not available is forgetting it, because the ring
    /// slot behind it is held until the exchange settles.
    ///
    /// `n` MAY BE ZERO, and that is a message rather than an absence — §2.1
    /// makes a data-free message an option, so the two are genuinely different
    /// answers and the `Optional` is what keeps them apart.
    ///
    /// **THE BUFFER IS A WHOLE SLOT, NOT A MESSAGE.** It is
    /// `PIPE_BODY_BYTES` wide because a caller cannot size a buffer against a
    /// length it has not been told yet, which is the same published-minimum rule
    /// `Waiter.wait`'s record follows.
    ///
    /// **IT NEVER PARKS**, and unit 2 has no waitability to park with; unit 3 is
    /// where an outlet becomes attachable and a blocking receive becomes a
    /// composition over this call plus a wait.
    ///
    /// `Err(SosStatus.PeerClosed)` means the ring is EMPTY *and* every inlet
    /// handle is gone. **THE ORDER IS THE CONTRACT AND IT IS DRAIN-FIRST**
    /// (design 230's close-drains-first rule): everything the departed client
    /// staged is handed over before this is ever answered, so a sender exiting
    /// mid-conversation loses nothing. Afterwards it is TERMINAL — no new sender
    /// can appear, because attenuation is monotonic and a column at zero has no
    /// handle left to mint from — so every later take answers the same.
    public func take(
        &self,
        into: &var [UInt8; PIPE_BODY_BYTES]
    ) -> Result<(UInt, PipeRequest)?, SosStatus> {
        take_into(self.handle, &var into)
    }

    /// **MINT A SIBLING of this outlet, narrowed by a KEEP MASK.** Everything
    /// `PipeInlet.mint` says holds here with `Take` in `Post`'s place — including
    /// the part that matters for the connection: a sibling is a second reference
    /// on the OUTLET column, so a server that mints one and hands it to a helper
    /// has two names on one end and the client is told nothing until both are
    /// gone.
    public func mint(&self,
                     rights: UInt32 = ALL_RIGHTS) -> Result<PipeOutlet, SosStatus> {
        let raw = try call_value(self.handle, MINT_OP, rights as UInt, 0, 0)
        return PipeOutlet(handle: PipeOutletHandle(raw))
    }
}

/// The `unsafe` half of `PipeOutlet.take`, confined to one small named helper
/// (design 136). Neither address leaves it.
///
/// **THE TUPLE IS THE ANSWER, on `Process.pipe_create`'s own reasoning** (design
/// 13 finding 4): a take that succeeds always carries EXACTLY TWO things and the
/// caller always wants both, so a destructuring `if let (n, request) = got` moves
/// each into its own binding with no husk left behind — where a `BootHandle`
/// needed an `Optional` per slot because it carries at most one of several kinds
/// and asking the wrong question must be harmless.
func take_into(
    handle: PipeOutletHandle,
    into: &var [UInt8; PIPE_BODY_BYTES]
) unsafe -> Result<(UInt, PipeRequest)?, SosStatus> {
    var rec: [UInt; PIPE_TAKE_RECORD_WORDS] = [0; PIPE_TAKE_RECORD_WORDS]
    let raw = sos_pipe_outlet_take(handle,
                                   (&var rec) as UnsafePointer<UInt>,
                                   pipe_take_record_bytes() as UInt,
                                   (&var into) as UnsafePointer<UInt8>)
    let staged = try polled_ok(raw)
    if not staged {
        return None
    }
    let request = PipeRequest(handle: PipeRequestHandle(rec[PIPE_TAKE_REQUEST_WORD]))
    let got: (UInt, PipeRequest)? = (rec[PIPE_TAKE_LEN_WORD], move request)
    return move got
}

/// A handle to a PipeReply — the CLIENT's claim on ONE reply (spec §2.1's
/// ratified `PipeReplyHandle`; sawos design 14).
///
/// **IT IS WHAT A POST ANSWERS WITH**, and holding it is what makes
/// request/reply a PRIMITIVE rather than a convention: the reply capability is
/// unforgeable, single-use, and cannot be confused with any other exchange on the
/// same connection, because it names a RING SLOT rather than a pipe.
///
/// **`NoCopy`, AND DROPPING IT IS THE CANCELLATION PRIMITIVE** (§2.1). There is
/// no `cancel()` verb: a client that has given up releases the claim, and the
/// server learns of it when its own `reply` answers `PeerClosed`. Abandonment is
/// INFORMATION, NOT AN IMPERATIVE — whether it cancels anything is the protocol's
/// decision, and a tell-style message ignores the signal entirely. Deterministic
/// destruction is what makes the timing of the signal deterministic too.
///
/// Built by `PipeInlet.post`, by `PipeReply.mint` and by `BootHandle.take_reply`,
/// and by nothing else — no word constructor, no word extractor.
public struct PipeReply {
    public(package) handle: PipeReplyHandle,
}

extension PipeReply: NoCopy {
    /// Drop is release; see `System`'s deinit for the sentinel and the discard.
    /// A claim that has already been resolved holds the sentinel, so this is a
    /// no-op on it — single use, spelled in the value rather than checked.
    func deinit(&var self) {
        if self.handle != NO_HANDLE {
            let _ = sos_handle_release(self.handle)
        }
    }
}

extension PipeReply {
    /// **TAKE THE REPLY, IF IT HAS BEEN WRITTEN.** Requires
    /// `PipeReplyRight.Resolve`.
    ///
    /// `Ok(Some(n))` the reply is here and its first `n` bytes are yours — and
    /// THE CLAIM IS SPENT: this value disarms itself, so dropping it does nothing
    /// and calling `resolve` again is the ordinary `BadHandle` fault. `Ok(None)`
    /// the exchange is still pending — nobody has replied yet, the claim is
    /// untouched, ask again. `n` may be ZERO, which is a reply that carries no
    /// data rather than an absence.
    ///
    /// **IT NEVER PARKS.** The blocking `send(msg)` and `send(msg, timeout:)`
    /// §2.1 ratifies are LIBRARY compositions over post + wait + resolve (design
    /// 10 ruling 4), and they arrive with waitability in unit 3; until then this
    /// is the whole of the client's back half and a caller polls.
    ///
    /// `Err(SosStatus.PeerClosed)` means the server side abandoned it — the
    /// obligation was dropped without a reply, or the connection's server end went
    /// away before the message could ever be taken. It SPENDS the claim too:
    /// there is nothing left to wait for, so holding it would be holding a ring
    /// slot for an answer that can never come.
    public func resolve(&var self,
                        into: &var [UInt8; PIPE_BODY_BYTES]) -> Result<UInt?, SosStatus> {
        resolve_into(&var self, &var into)
    }

    /// **MINT A SIBLING of this claim, narrowed by a KEEP MASK** — the universal
    /// `MINT_OP`, on `PipeInlet.mint`'s exact terms.
    ///
    /// A sibling is a second NAME and therefore a second reference on the
    /// exchange's reply column, and single use survives it: the op consumes an
    /// ENTRY, and the exchange's own state is what allows exactly one successful
    /// resolve. The sibling that asks second is told `PeerClosed`, which is the
    /// same answer an abandoned peer gets and for the same reason — there is no
    /// reply left for it.
    public func mint(&self,
                     rights: UInt32 = ALL_RIGHTS) -> Result<PipeReply, SosStatus> {
        let raw = try call_value(self.handle, MINT_OP, rights as UInt, 0, 0)
        return PipeReply(handle: PipeReplyHandle(raw))
    }
}

/// The `unsafe` half of `PipeReply.resolve`, confined to one small named helper
/// (design 136). The buffer's address never leaves it.
///
/// **THE DISARM IS DECIDED BY THE ANSWER, and that is this file's one departure
/// from the transfer-funnel contract** (`floor`'s block: disarm BEFORE the
/// syscall, because every failure of such a syscall is a fault). A resolve has a
/// third outcome the funnels do not — `Ok(None)`, which consumed nothing — so
/// disarming first would throw away a live claim on every poll. The rule is exact
/// and it is the kernel's: the caller's entry is consumed unless the answer is a
/// would-block.
func resolve_into(claim: &var PipeReply,
                  into: &var [UInt8; PIPE_BODY_BYTES]) unsafe -> Result<UInt?, SosStatus> {
    var value: UInt = 0
    let raw = sos_pipe_reply_resolve(claim.handle,
                                     (&var into) as UnsafePointer<UInt8>,
                                     PIPE_BODY_BYTES as UInt,
                                     (&var value) as UnsafePointer<UInt>)
    let got = try polled_value(raw, value) catch {
        claim.handle = PipeReplyHandle(NO_HANDLE)
        return error
    }
    if let _ = got {
        claim.handle = PipeReplyHandle(NO_HANDLE)
    }
    return got
}

/// A handle to a PipeRequest — the SERVER's obligation to send ONE reply (spec
/// §2.1's ratified `PipeRequestHandle`; sawos design 14).
///
/// **IT IS WHAT A TAKE ANSWERS WITH BESIDE THE MESSAGE**, and it is the reason
/// §2.1 calls request/reply a primitive: the server does not have to know who
/// asked, or over which connection, or how to address an answer. It holds the
/// obligation, and the obligation knows.
///
/// **IT IS THE DELEGATION PRIMITIVE** (§2.1, ratified): `Transfer` is minted, so
/// a server may `give` this handle to a third party who replies STRAIGHT to the
/// original client — the filesystem forwarding a read to the flash driver, whose
/// bytes never transit the filesystem's address space. Single use is preserved
/// through the transfer, because it is a property of the exchange rather than of
/// whoever holds the handle.
///
/// **`NoCopy`, AND DROPPING IT WITHOUT REPLYING IS ALSO AN ANSWER**: the client's
/// `resolve` is told `PeerClosed`. Nothing is stranded, which is the peer-gone
/// doctrine reaching the last object in M4 that could have stranded anybody.
public struct PipeRequest {
    public(package) handle: PipeRequestHandle,
}

extension PipeRequest: NoCopy {
    /// Drop is release. A discharged obligation holds the sentinel, so this is a
    /// no-op on it.
    func deinit(&var self) {
        if self.handle != NO_HANDLE {
            let _ = sos_handle_release(self.handle)
        }
    }
}

extension PipeRequest {
    /// **SEND THE REPLY, AND DISCHARGE THE OBLIGATION.** Requires
    /// `PipeRequestRight.Reply`.
    ///
    /// It CONSUMES this capability whatever it answers — the value disarms itself
    /// before the syscall, which is the transfer-funnel contract exactly — so a
    /// second reply through the same wrapper is the ordinary `BadHandle` fault.
    /// `len` may be ZERO: a reply that carries no data is still an answer, and it
    /// is how the TELL idiom's server side discharges
    /// (`let _ = request.reply(...)`).
    ///
    /// `Err(SosStatus.PeerClosed)` means the client abandoned its claim and the
    /// reply went nowhere — §2.1's ratified answer, never a silent success. THE
    /// OBLIGATION IS DISCHARGED EITHER WAY, which is what makes ignoring it with
    /// `let _ =` correct rather than careless.
    public func reply(&var self, body: &[UInt8; PIPE_BODY_BYTES],
                      len: UInt) -> Result<Void, SosStatus> {
        reply_body(&var self, &body, len)
    }

    /// **MINT A SIBLING of this obligation, narrowed by a KEEP MASK.** Everything
    /// `PipeReply.mint` says holds here with `Reply` in `Resolve`'s place: one
    /// reply may be written however many names the obligation has, and the sibling
    /// that writes second is told `PeerClosed`.
    public func mint(&self,
                     rights: UInt32 = ALL_RIGHTS) -> Result<PipeRequest, SosStatus> {
        let raw = try call_value(self.handle, MINT_OP, rights as UInt, 0, 0)
        return PipeRequest(handle: PipeRequestHandle(raw))
    }
}

/// The `unsafe` half of `PipeRequest.reply`, confined to one small named helper
/// (design 136). The body's address never leaves it.
///
/// **DISARM BEFORE THE SYSCALL**, the transfer-funnel contract verbatim: a reply
/// consumes the caller's entry on every answer it can give, and its only other
/// outcome is a fault that ends the process. So there is no path on which a
/// disarmed-but-unspent word leaks, and `PipeReply.resolve`'s conditional disarm
/// is the departure rather than this.
func reply_body(request: &var PipeRequest, body: &[UInt8; PIPE_BODY_BYTES],
                len: UInt) unsafe -> Result<Void, SosStatus> {
    let word: UInt = request.handle
    request.handle = PipeRequestHandle(NO_HANDLE)
    return checked(sos_pipe_request_reply(word,
                                          (&body) as UnsafePointer<UInt8>, len))
}

// =============================================================================
// WAITABILITY — the four pipe arms, and the consuming attach (spec §2.2's
// waitable list; `designs/010` rulings 8, 9 and 11; sawos design 15, M4 unit 3)
// =============================================================================
//
// **THE EIGHT OVERLOADS LIVE HERE AND NOT IN `sos.waiter`, ON DESIGN 8's OWN
// PRECEDENT.** `Waiter.add` reads its argument's handle field, so an overload
// must sit where the argument's type is declared; `sos.waiter` is BELOW this
// file (this file names `Waiter`, because the composed sends park on one), so
// an overload naming `PipeInlet` written there would import downward into its
// own importer — the cycle DF-232e does not diagnose. It is exactly the shape
// `Waiter.add(process:)` has had in `sos.system` since M3 unit 5.5, and since
// sawlang 0.2.0 extension lookup follows the facade's `public import`, so the
// split is invisible at the call site: `waiter.add(outlet:, key:)` reads as one
// more member of the one list.
//
// **THE 2x2 IS SPELLED BY THE VERB AND THE MODE** (ruling 11(c)): `add` borrows
// and `give` consumes, `AttachMode.Persistent` stays subscribed and
// `AttachMode.OneShot` detaches at delivery. Four combinations, two axes, and
// no `OneShotConsuming` anywhere — the axes are orthogonal, and consuming is an
// EFFECT change that a runtime flag may not make.

extension Waiter {
    /// **WATCH A CONNECTION'S SERVER END FOR TRAFFIC**: attach it under `key`,
    /// which a `wait()` hands back with an `OutletLevel` when a message is
    /// staged or the client end is gone (spec §2.2's readable arm). Requires
    /// `PipeOutletRight.Wait` there and `WaiterRight.Attach` here.
    ///
    /// **THIS IS WHAT TURNS UNIT 2's POLL LOOP INTO A PARK.** A server holding
    /// several outlets on one Waiter is §2.2's whole shape — the key says which
    /// connection woke it, and `take` is what it does next.
    ///
    /// `OutletLevel.PeerGone` is DRAIN-THEN-TERMINAL and arrives only once the
    /// ring is dry: everything the departed client staged is handed over first,
    /// which is design 230's close-drains-first rule and the same order
    /// `take`'s own `PeerClosed` follows. Nothing un-closes.
    public func add(&self, outlet: &PipeOutlet, key: UInt,
                    mode: AttachMode = AttachMode.Persistent) -> Result<Void, SosStatus> {
        self.attach(outlet.handle, key, mode_flag(mode))
    }

    /// **WATCH A CONNECTION'S CLIENT END FOR ROOM**: attach it under `key`,
    /// which a `wait()` hands back with an `InletLevel` while the staging ring
    /// has a free slot or the server end is gone (`designs/010` ruling 8).
    /// Requires `PipeInletRight.Wait` there.
    ///
    /// **IT EXISTS BECAUSE `post` CAN NEVER BLOCK.** Ruling 4 made post the one
    /// kernel primitive on the client side and gave it no park, so a refused
    /// poster needed something better than a poll loop — this is it, and it is
    /// the missing leg of the composed blocking `send`.
    ///
    /// A PLAIN LEVEL, NOT A TERMINAL ONE: consuming it clears nothing, and the
    /// level's end is the poster's own next post. So an attachment left
    /// `Persistent` on a connection with room reports ready every time it is
    /// asked, exactly as an Interrupt's emptiness does.
    public func add(&self, inlet: &PipeInlet, key: UInt,
                    mode: AttachMode = AttachMode.Persistent) -> Result<Void, SosStatus> {
        self.attach(inlet.handle, key, mode_flag(mode))
    }

    /// **WATCH A CLAIM FOR ITS ANSWER**: attach it under `key`, which a `wait()`
    /// hands back with a `ReplyDelivery` — THE REPLY BYTES THEMSELVES — when the
    /// server answers, or `PeerClosed` when it never will. Requires
    /// `PipeReplyRight.Wait` there.
    ///
    /// **THE DELIVERY CARRIES THE PAYLOAD** (`designs/010` ruling 11(a)), which
    /// is what makes this attach different in kind from the three beside it: a
    /// client that waits this way never calls `resolve` at all, because the
    /// answer arrived in the wait record. The multiplexed client is post ->
    /// attach -> wait, three traps, however many requests are outstanding.
    ///
    /// **A DELIVERY IS INHERENTLY CONSUMING HERE, WHATEVER `mode` SAYS** (ruling
    /// 11(b)): a claim is a ONE-SHOT, the answer is spent by the copy-out, and a
    /// persistent subscription to something that has happened for the last time
    /// would be a promise nothing can keep. So the attachment ends at the
    /// delivery and `mode` is inert on this kind — stated rather than refused,
    /// because the parameter is uniform across the family and a per-kind
    /// exception would be a rule to remember.
    ///
    /// THE HANDLE STAYS YOURS with `add`. What a later `resolve` on it answers
    /// is `PeerClosed`: the exchange was discharged by the delivery, and there
    /// is no second copy of an answer. Use `give` when the claim is genuinely
    /// finished with — it is, on the success path, which is why the composed
    /// `send` is the one caller that keeps it.
    public func add(&self, reply: &PipeReply, key: UInt,
                    mode: AttachMode = AttachMode.OneShot) -> Result<Void, SosStatus> {
        self.attach(reply.handle, key, mode_flag(mode))
    }

    /// **WATCH AN OBLIGATION FOR ITS CANCELLATION**: attach it under `key`,
    /// which a `wait()` hands back with `WaitPayload.Abandoned` once the client
    /// has dropped the claim behind it (spec §2.1's ratified early notice).
    /// Requires `PipeRequestRight.Wait` there.
    ///
    /// **ABANDONMENT IS INFORMATION, NOT AN IMPERATIVE** (§2.1). This is the
    /// opt-in early notice the ratified text names, and what a server does with
    /// it is the protocol's decision: a cancellable read stops working, a
    /// tell-style message ignores it entirely. Without the attach, a server
    /// learns the same fact when its `reply` answers `PeerClosed` — later, and
    /// after the work.
    ///
    /// TERMINAL, on the Process arm's exact terms: a reply column that reached
    /// zero can never rise, so a server attaching AFTER the client gave up is
    /// told at once and nothing un-abandons.
    public func add(&self, request: &PipeRequest, key: UInt,
                    mode: AttachMode = AttachMode.Persistent) -> Result<Void, SosStatus> {
        self.attach(request.handle, key, mode_flag(mode))
    }

    /// **HAND A CLAIM TO THIS WAITER, AND STOP HOLDING IT** (`designs/010`
    /// ruling 11(c); the pattern that motivated the whole ruling).
    ///
    /// A client that attaches its claim and takes the answer out of the wait
    /// record has no use for the handle afterwards — holding it is pure
    /// ceremony, and a table row. `give` says so: the wrapper goes in by MOVE,
    /// the kernel releases the entry as part of the attach, and the ATTACHMENT
    /// owns the exchange from there. So a multiplexer holds ZERO reply handles
    /// however many requests are outstanding, and its `MAX_HANDLES` stops being
    /// the bound on its in-flight depth (design 14 finding 5, answered).
    ///
    /// **AND HANGING UP IS DESTROYING THE SUBSCRIPTION**: with no handle left,
    /// `remove(key)` drops the last reference, which is §2.1's cancellation
    /// primitive reached through the Waiter. That is the abandonment re-wording
    /// this unit lands — a handle drop with a live attachment is not
    /// abandonment, because the subscription is the interested party.
    ///
    /// Everything `Waiter.give(event:)` says about the verb, the gate and the
    /// object-handed-back refusal holds word for word.
    public func give(&self, reply: PipeReply, key: UInt,
                     mode: AttachMode = AttachMode.OneShot
    ) -> Result<Void, (SosStatus, PipeReply)> {
        var owned = move reply
        let word: UInt = owned.handle
        owned.handle = PipeReplyHandle(NO_HANDLE)
        try self.attach_consuming(word, key, mode) catch {
            let back: (SosStatus, PipeReply) = (error, PipeReply(handle: PipeReplyHandle(word)))
            return move back
        }
        return
    }

    /// Hand an OBLIGATION to this Waiter — the cancellation watcher that owns
    /// what it watches. Everything `give(reply:)` says holds, with one
    /// consequence worth naming: the obligation is now the attachment's, so
    /// `remove(key)` DISCHARGES it and the client's `resolve` answers
    /// `PeerClosed`. A server hangs up on a request by unsubscribing from it.
    public func give(&self, request: PipeRequest, key: UInt,
                     mode: AttachMode = AttachMode.OneShot
    ) -> Result<Void, (SosStatus, PipeRequest)> {
        var owned = move request
        let word: UInt = owned.handle
        owned.handle = PipeRequestHandle(NO_HANDLE)
        try self.attach_consuming(word, key, mode) catch {
            let back: (SosStatus, PipeRequest) = (error, PipeRequest(handle: PipeRequestHandle(word)))
            return move back
        }
        return
    }

    /// Hand a connection's SERVER END to this Waiter. Everything
    /// `give(reply:)` says holds — and this is the half `designs/010` ruling
    /// 11(d) builds the completion-queue server on in unit 4, where the delivery
    /// becomes the TAKE. Today it is the plainer thing: a subscription that owns
    /// its end, so `remove(key)` drops the server end to zero and the
    /// connection's clients answer `PeerClosed`.
    public func give(&self, outlet: PipeOutlet, key: UInt,
                     mode: AttachMode = AttachMode.Persistent
    ) -> Result<Void, (SosStatus, PipeOutlet)> {
        var owned = move outlet
        let word: UInt = owned.handle
        owned.handle = PipeOutletHandle(NO_HANDLE)
        try self.attach_consuming(word, key, mode) catch {
            let back: (SosStatus, PipeOutlet) = (error, PipeOutlet(handle: PipeOutletHandle(word)))
            return move back
        }
        return
    }

    /// Hand a connection's CLIENT END to this Waiter. The mirror, and the least
    /// useful of the eight — an end nobody holds cannot be posted through — so
    /// it exists for uniformity and for the one shape that wants it: a watcher
    /// that only cares whether the far side is still there.
    public func give(&self, inlet: PipeInlet, key: UInt,
                     mode: AttachMode = AttachMode.Persistent
    ) -> Result<Void, (SosStatus, PipeInlet)> {
        var owned = move inlet
        let word: UInt = owned.handle
        owned.handle = PipeInletHandle(NO_HANDLE)
        try self.attach_consuming(word, key, mode) catch {
            let back: (SosStatus, PipeInlet) = (error, PipeInlet(handle: PipeInletHandle(word)))
            return move back
        }
        return
    }
}

// =============================================================================
// THE COMPOSED BLOCKING SENDS (spec §2.1's ratified client API; design 10
// ruling 4, amended; sawos design 15, M4 unit 3)
// =============================================================================
//
// **§2.1's `send(msg)` AND `send(msg, timeout:)` BECOME REAL HERE, AND THEY ARE
// LIBRARY CODE.** Ruling 4 made `post` the ONE kernel primitive on the client
// side and said so in as many words: blocking send is waiting on the claim,
// timeout is the same wait with a Timer on the same Waiter, cancel is drop, and
// THE KERNEL NEVER LEARNS WHAT A TIMEOUT IS — no duration argument, no 64-bit
// copy-in funnel for one, no timeout code in any pipe path. Every line below is
// ops that already shipped.
//
// **RULING 8's MISSING LEG IS HERE TOO**: a full ring used to surface as
// `WouldBlock` and leave the caller polling. The inlet's room-to-post level is
// what a blocked poster parks on, so the composition is wait-for-room, post,
// wait-for-reply — and `WouldBlock` stays the honest answer for the caller that
// chose `post` and wants it.
//
// **AND RULING 11(a) DELETED THE THIRD LEG.** The reply arrives IN THE WAIT
// RECORD, so there is no `resolve` on the success path at all: a blocking round
// trip is post + wait, and the claim is released by the ordinary drop.
//
// **WHY IT IS A TYPE AND NOT A METHOD ON `PipeInlet`.** Blocking a reply
// requires a Waiter (ruling 4's own sentence) and a Waiter requires a `Process`
// handle to create — which a `PipeInlet` has no way to reach, and could not be
// given one without making every connection cost a Waiter whether or not
// anybody ever blocks. So the WRAPPER OWNS THE WAITER, which is what the unit
// brief asks for, and `PipeClient` is that wrapper: an inlet, a Waiter, and the
// two attachment keys the composition needs a key space of its own for.

/// **A CLIENT THAT CAN BLOCK** — a connection's inlet plus the Waiter the
/// blocking compositions park on.
///
/// Build one out of an inlet you hold and a Waiter you made
/// (`Process.waiter_create`); it owns both, and dropping it releases both, which
/// is the ordinary RAII the rest of this module follows. The SPLIT-PHASE form is
/// still there — `post` forwards to the inlet — so a caller may multiplex by
/// hand through the same object it blocks with.
///
/// **THE TWO KEYS ARE ITS OWN**, and they are fields rather than constants
/// because the Waiter may be shared: a caller that attaches other things to the
/// same Waiter picks keys these two do not collide with. They default to 0 and
/// 1, which is right for the common case of a Waiter this client is the only
/// user of.
public struct PipeClient {
    public(package) inlet: PipeInlet,
    public(package) waiter: Waiter,
    /// The key the CLAIM and the room level attach under. They never overlap in
    /// time — the room wait finishes before the claim exists — so one key
    /// serves both, which is what keeps the client's footprint on a shared
    /// Waiter to two words.
    public(package) key: UInt,
    /// The key the TIMEOUT's Timer attaches under. Only `send(timeout:)` uses
    /// it.
    public(package) timer_key: UInt,
}

extension PipeClient: NoCopy {}

extension PipeClient {
    /// Take ownership of an inlet and a Waiter. Both are released when this
    /// client drops.
    ///
    /// **THE LABELS ARE `over:` AND `using:` RATHER THAN THE FIELD NAMES**, and
    /// that is forced rather than chosen: an `init` whose parameters match the
    /// fields is indistinguishable from the memberwise literal this body writes,
    /// which the compiler refuses by name. Renaming reads better anyway — a
    /// client is built OVER a connection USING a Waiter.
    public init(over: PipeInlet, using: Waiter, key: UInt = 0,
                timer_key: UInt = 1) -> PipeClient {
        PipeClient(inlet: move over, waiter: move using, key: key,
                   timer_key: timer_key)
    }

    /// The split-phase form, forwarded (spec §2.1's `post`). Everything
    /// `PipeInlet.post` says holds — it never blocks, and it answers the claim.
    public func post(&self, body: &[UInt8; PIPE_BODY_BYTES],
                     len: UInt) -> Result<PipeReply?, SosStatus> {
        self.inlet.post(body: &body, len: len)
    }

    /// **SEND, AND WAIT FOR THE ANSWER** (spec §2.1's ratified `send(msg)`).
    ///
    /// Three acts and two of them park: wait for room if the ring is full, post,
    /// then wait for the reply — which ARRIVES IN THE WAIT RECORD, so there is
    /// no third syscall to collect it.
    ///
    /// `Err(SosStatus.PeerClosed)` on the way OUT means nobody can ever take the
    /// message; the `ReplyDelivery.PeerClosed` case on the way BACK means the
    /// message was taken and the obligation was dropped without an answer. The
    /// two are genuinely different facts, which is why one is an error and the
    /// other is a delivery.
    ///
    /// **THE CLAIM IS ATTACHED NON-CONSUMING** even though this function has no
    /// use for it afterwards, and that is deliberate: it is the same code path
    /// `send(timeout:)` needs, and THAT one has to be able to hand the live
    /// claim back. The consuming attach is the multiplexer's tool, not the
    /// composition's (`designs/010` ruling 4, amended).
    public func send(&self, body: &[UInt8; PIPE_BODY_BYTES],
                     len: UInt) -> Result<ReplyDelivery, SosStatus> {
        var claim = try self.stage(&body, len)
        try self.waiter.add(reply: &claim, key: self.key,
                            mode: AttachMode.OneShot)
        let woke = try self.waiter.wait()
        return delivery_of(&woke)
    }

    /// **SEND, AND GIVE UP AFTER `after_ns`** (spec §2.1's ratified
    /// `send(msg, timeout:)`).
    ///
    /// The same composition with a Timer on the same Waiter, which is exactly
    /// what ruling 4 said a timeout is. `timeout` is the caller's Timer — a
    /// timeout is a schedule and a schedule is an object, so the client neither
    /// creates one per call nor keeps one nobody asked for.
    ///
    /// **`TimedOut(pending:)` CARRIES THE STILL-LIVE CLAIM**, which is the whole
    /// reason the surface is shaped this way (§2.1, ratified). The exchange has
    /// not been cancelled — the server may still be working — so the caller
    /// decides: wait again on the claim, hand it to somebody else, or DROP it,
    /// which is §2.1's cancellation primitive and makes the server's later
    /// `reply` answer `PeerClosed`.
    ///
    /// The ROOM wait is not covered by the timeout, and that is this v1
    /// composition's one stated limit: backpressure parks until the server takes
    /// something, and a caller that must bound that waits on the inlet itself.
    public func send(&self, body: &[UInt8; PIPE_BODY_BYTES], len: UInt,
                     timeout: &Timer,
                     after_ns: UInt64) -> Result<SendOutcome, SosStatus> {
        var claim = try self.stage(&body, len)
        try self.waiter.add(reply: &claim, key: self.key,
                            mode: AttachMode.OneShot)
        try self.waiter.add(timer: &timeout, key: self.timer_key,
                            mode: AttachMode.OneShot)
        try timeout.arm(after_ns: after_ns)

        let woke = try self.waiter.wait()
        // **THE KEY IS WHAT SAYS WHICH WON**, which is what §2.2 gives a key
        // for. Exactly one of the two attachments delivered, and a one-shot
        // delivery DETACHES — so the loser is the one still attached, and it is
        // the only one there is anything left to remove.
        if woke.key == self.key {
            try self.waiter.remove(self.timer_key)
            try timeout.disarm()
            var answer = delivery_of(&woke)
            return SendOutcome.Replied(r: move answer)
        }
        try self.waiter.remove(self.key)
        return SendOutcome.TimedOut(pending: move claim)
    }

    /// Post, parking on the inlet's ROOM level for as long as the ring is full
    /// (`designs/010` ruling 8).
    ///
    /// The loop is not a poll: each turn either stages the message or PARKS, so
    /// a client under backpressure costs nothing until the server takes
    /// something. It ends when the level says `PeerGone`, which is the one way
    /// posting can stop being possible.
    func stage(&self, body: &[UInt8; PIPE_BODY_BYTES],
               len: UInt) -> Result<PipeReply, SosStatus> {
        var going = true
        while going {
            let staged = try self.inlet.post(body: &body, len: len)
            if let got = move staged {
                return move got
            }
            try self.waiter.add(inlet: &self.inlet, key: self.key,
                                mode: AttachMode.OneShot)
            let woke = try self.waiter.wait()
            going = try room_of(&woke)
        }
        return SosStatus.PeerClosed
    }
}

/// What a blocking `send(timeout:)` ended as (spec §2.1's ratified shape).
///
/// **`NoCopy`, on the wrapper-carries-tier rule**: one arm owns a reply body and
/// the other owns a live capability, so neither may be duplicated by an accident
/// of binding.
public enum SendOutcome {
    case Replied(r: ReplyDelivery),
    /// The timer won. The claim is STILL LIVE and it is yours — the exchange was
    /// not cancelled, and dropping this is what cancels it.
    case TimedOut(pending: PipeReply),
}

extension SendOutcome: NoCopy {}

/// Read a reply delivery out of a wait record.
///
/// **A RECORD OF ANOTHER KIND HERE IS A BUG IN THIS FILE, SO IT PANICS** — the
/// same rule `decode_wait` states about an unknown tag, one altitude up. The
/// composition attached the claim under this key itself and no other kind can
/// answer to it, so a mismatch is this module disagreeing with itself rather
/// than a condition a caller could handle, and never-hide says a bug the caller
/// cannot act on should stop the program where it happened.
func delivery_of(woke: &WaitResult) -> ReplyDelivery {
    match woke.what {
        case Reply(outcome) -> {
            match outcome {
                case Data(msg) -> ReplyDelivery.Data(
                    msg: PipeMsg(len: msg.len, bytes: msg.bytes)),
                case PeerClosed -> ReplyDelivery.PeerClosed,
            }
        },
        case _ -> panic("sos: a pipe client's reply key answered with another kind"),
    }
}

/// Read a room-level delivery: `true` there is space, `Err(PeerClosed)` there
/// never will be again. The wrong kind panics on `delivery_of`'s reasoning.
func room_of(woke: &WaitResult) -> Result<Bool, SosStatus> {
    match woke.what {
        case Room(state) -> {
            match state {
                case Room -> true,
                case PeerGone -> SosStatus.PeerClosed,
            }
        },
        case _ -> panic("sos: a pipe client's room key answered with another kind"),
    }
}
