//! `Lock`: a lock inside one process whose holder inherits the level of the
//! threads waiting for it (spec §7).
//!
//! A lock is one machine word in the process's memory: 0 while it is free,
//! else the holder's thread ID, with the waiters bit (`LOCK_WAITERS_BIT`, the
//! word's top bit) set by the kernel once a thread waits. Taking a free lock
//! and giving back one nobody waits for are a compare-and-swap each, with no
//! trap. A thread that finds the lock held parks in the kernel
//! (`LOCK_WAIT_OP`), which sets the bit and raises the holder to the waiter's
//! level until it gives the lock back; a give that finds the bit set swaps
//! the word to 0 and traps once (`LOCK_WAKE_OP`) to answer the waiters. Both
//! are made with no handle, so every thread can take a lock, one with no
//! Thread handle of its own included.
//!
//! A thread's identity here is its ID, which its block keeps, read once at
//! the thread's start (every thread a `main` program or `thread_create(run:)`
//! makes); a thread with no block asks the kernel for it at each take.
//!
//! The C floor is `sos_lock_take` and `sos_lock_give`, over the word's
//! address; `Lock` is the same two calls on a word of its own.

import sosabi.{SosStatus, LOCK_WAITERS_BIT}
import sos.floor.{checked, sos_lock_wait, sos_lock_wake}
import sos.rt.{own_thread_id}

static STATUS_OK: UInt = SosStatus.Ok as UInt

/// A lock between the threads of one process, whose holder runs at the
/// level of the highest thread waiting for it until it gives it back.
///
/// It is for state threads at several levels share across something long or
/// something that parks, such as a print: a waiter parks rather than spins,
/// and a thread between the waiter's level and the holder's cannot keep the
/// holder off the processor, because the holder runs at the waiter's level.
/// For short state that never parks, `Section` is cheaper and holds every
/// sibling back.
///
/// The lock is not recursive: a thread that takes a lock it holds ends its
/// process. A thread that exits holding a lock answers every thread waiting
/// for it with `SosStatus.Revoked`, and so does every later wait for it.
/// Waiting inside a held section ends the process (`SectionHeld`), since the
/// holder could never run to give the lock back. A lock is the process's own:
/// one whose owner is another process's thread, through memory the two share,
/// ends the process that waits for it.
///
/// Zero is a free lock, so a `static` needs no initializer.
///
/// The kernel knows a lock by its address, yet `Lock` is not `NoMove`, for
/// the reason std's `Mutex` is not: nothing can move it while the address
/// matters. The kernel keeps the address only while a thread waits, and a
/// waiting thread is inside `take`, which borrows the lock for the whole
/// wait. A move needs exclusive ownership, which no lock threads share
/// through a reference has. A held lock nobody waits for may move: its word
/// moves with it, and the give finds it at the new address. Being movable is
/// what lets a lock be a field of a value that moves. The C floor
/// (`sos_lock_take`, `sos_lock_give`) takes a bare address, so a C caller
/// keeps the word in place itself.
public struct Lock {
    private word: Atomic<Int>,
}

extension Lock: NoCopy {}

extension Lock: ZeroInit {}

extension Lock {
    /// A free lock.
    public init() -> Lock {
        Lock(word: Atomic(0))
    }

    /// Take the lock, waiting while another thread holds it, raised to the
    /// calling thread's level while it does.
    ///
    /// `Err(SosStatus.Revoked)` when the holder exited without giving it
    /// back: nothing ever will. A thread whose wait word is wakeable
    /// (`sos_wait_word`) can be answered `Err(SosStatus.Woken)` for a wake, or
    /// `Err(SosStatus.TimedOut)` at the word's deadline, without the lock; a
    /// word at 0 waits plain. Taking a lock the calling thread holds, waiting
    /// inside a held section, or waiting on a finite deadline after
    /// registering with no Clock (`AccessDenied`) ends the process.
    public func take(&self) -> Result<Void, SosStatus> {
        checked(sos_lock_take(self.address()))
    }

    /// Give the lock back, answering the threads waiting for it. Giving back
    /// a lock the calling thread does not hold panics.
    public func give(&self) {
        let status = sos_lock_give(self.address())
        if status != STATUS_OK {
            panic("sos: Lock.give: the kernel refused the wake: {}", status)
        }
    }

    /// The address of the word.
    func address(&self) unsafe -> UInt {
        ((&self.word) as UnsafePointer<Atomic<Int>>) as UInt
    }
}

/// Take the lock whose word is at `lock` (spec §7): swap the word from 0 to
/// the caller's ID, and while another thread holds it, wait in the kernel
/// (`sos_lock_wait`), which sets the waiters bit and raises the holder, then
/// swap again. Answers `SosStatus.Ok` once the caller holds it,
/// `SosStatus.Revoked` when its holder exited holding it, and, on a wakeable
/// wait word, `SosStatus.Woken` or `SosStatus.TimedOut` without it, as
/// `sos_lock_wait` answers them. Taking a lock the caller holds ends the
/// process.
@export("sos_lock_take")
public func sos_lock_take(lock: UInt) unsafe -> UInt {
    let word = lock as UnsafePointer<Atomic<Int>>
    let me = Int.from(truncating: own_thread_id())
    while not word[0].compare_exchange(0, me) {
        let status = sos_lock_wait(lock)
        if status != STATUS_OK {
            return status
        }
    }
    STATUS_OK
}

/// Give back the lock whose word is at `lock` (spec §7): swap the word from
/// the caller's ID to 0 with no trap, or, when the kernel has set the waiters
/// bit, from the caller's ID with the bit to 0 and then trap once to answer
/// the waiters (`sos_lock_wake`). Answers `SosStatus.Ok`. Giving back a lock
/// the caller does not hold panics.
///
/// Only the kernel sets the bit, and only in a word naming the holder, so a
/// first swap that fails leaves the word either the caller's ID with the bit
/// or another thread's.
@export("sos_lock_give")
public func sos_lock_give(lock: UInt) unsafe -> UInt {
    let word = lock as UnsafePointer<Atomic<Int>>
    let me = own_thread_id()
    if word[0].compare_exchange(Int.from(truncating: me), 0) {
        return STATUS_OK
    }
    let waited = Int.from(truncating: me | LOCK_WAITERS_BIT)
    if not word[0].compare_exchange(waited, 0) {
        panic("sos: Lock.give: the calling thread does not hold the lock")
    }
    sos_lock_wake(lock)
}
