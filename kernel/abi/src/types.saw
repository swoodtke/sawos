//! The object kinds and the handle word (spec §2's table, §3).
//!
//! What a handle-table entry names, the per-kind handle aliases over it, the
//! word that names nothing, and the one knob the word's index/generation split
//! is derived from. It is the bottom of the module order: it names no right, no
//! op and no record, and everything else here is written about the objects it
//! names.
//!
//! Reached through the `sosabi` facade; see `lib.saw`.

// =============================================================================
// Object types
// =============================================================================

/// What a handle-table entry names.
///
/// `Unbound` is the reserved zero: handle 0 names nothing, so a zeroed register
/// can never be mistaken for authority, and a table slot that was never filled
/// reads as "no object" rather than as object type 0.
///
/// A `UInt8` backing because this is a kernel-internal field in `HandleEntry`,
/// never a number that crosses the trap boundary.
public enum ObjType: UInt8 {
    case Unbound = 0,
    case System = 1,
    case Process = 2,
    case Thread = 3,
    case Event = 4,
    case Waiter = 5,
    case Interrupt = 6,
    case Clock = 7,
    case Timer = 8,
    /// RAM authority: a range of physical memory, derived by `Split` and
    /// installed by `Map` (spec §2.5).
    ///
    /// A region is a capability rather than a description: there is no bounds
    /// reader. Boot regions are §2.5's "pool roots given to the root server at
    /// boot".
    case Memory = 9,
    /// Device authority: a range of memory-mapped registers (spec §2.5).
    ///
    /// A distinct kind, not a flag on `Memory`, because every question about it
    /// answers differently. An IoMemory's `Map` installs a device-attribute row
    /// and no other op on it could install anything else, so a driver cannot
    /// get a cacheable view of a register block by construction; the type
    /// system carries what a flag would leave to a check.
    ///
    /// The lifecycle differs everywhere too: it is pinned (never freed; MMIO is
    /// not memory that can be reclaimed), it is carved non-exclusively (§2.5:
    /// "a fixed region may be handed out many times", so several drivers may
    /// hold windows onto one peripheral), and it has no contents: an image
    /// never carries bytes for it.
    case IoMemory = 10,
    /// One installed protection row, with its own handle (spec §2.5).
    ///
    /// A Mapping is an installed grant row. The object records which process's
    /// domain carries the row and which row it is; `MappingOp.Base` answers the
    /// address the kernel placed it at, which on a tier that does not translate
    /// is also the physical one.
    ///
    /// Only a Mapping unmaps (§2.5), which is what the object is for. Releasing
    /// a Mapping handle frees the table entry and never the row (entries never
    /// touch objects), so §2.5's "dropped without unmap = permanent, safe but
    /// leaked" follows from existing doctrine.
    case Mapping = 11,
    /// The client end of a connection: requests flow in here (spec §2.1).
    ///
    /// Two kinds, one slab: roles are objects. A pipe carries traffic both
    /// ways, so "how many handles can still send" cannot be asked of one
    /// symmetric object (a parked receiver is itself a holder, which is the
    /// socket-`shutdown()` hole), and a rights-partitioned count on one object
    /// would be a second ledger beside the one reference ledger. So the
    /// bidirectionality dissolves: the connection is a pair of counted endpoint
    /// kinds, and "the writers went to zero" is "the client end reached zero
    /// references".
    ///
    /// Both kinds target the same `PIPES` slot, and which of the connection's
    /// two reference columns a handle counts on is decided by its kind, which
    /// §3's order establishes before anything else is asked. `kcore.refs` is
    /// where that becomes mechanical.
    ///
    /// A side reaching zero raises peer-gone on the other, and the connection
    /// frees only when both columns are zero. Peer-gone is visible as
    /// `SosStatus.PeerClosed` answers and as a waitable level.
    case PipeInlet = 12,
    /// The server end of a connection: requests come out here (spec §2.1).
    ///
    /// The mirror of `PipeInlet` in every respect except which column it counts
    /// on and which op it carries: an inlet posts, an outlet takes. Rights stay
    /// named for ops, so the role is structural rather than a rights mask
    /// somebody counts by.
    case PipeOutlet = 13,
    /// The client's claim on one reply: single-use, transferable (spec §2.1's
    /// `PipeReplyHandle`).
    ///
    /// It is ring-slot state, not a third slab. A one-shot pair exists for
    /// exactly as long as one in-flight message does, and the reply body is
    /// pinned to the staging slot that carried the request, so the claim lives
    /// with the slot. `entry.target` for this kind is an exchange index
    /// (`connection * PIPE_INFLIGHT + ring slot`), the same flat arithmetic the
    /// bodies and lengths already use, one level down from `PipeInlet`'s "two
    /// kinds, one slab".
    ///
    /// Two columns again, and they are the abandonment state:
    /// `Exchange.reply_refs` counts the claims and `Exchange.request_refs`
    /// counts the obligations, each column only ever falls, and which one a
    /// handle counts on is its kind. The client dropping its claim is
    /// abandoned-by-client; the server dropping its request without replying is
    /// abandoned-by-server. No flag beside them says so.
    ///
    /// Single use is a property of the exchange, not of the handle: `Resolve`
    /// consumes the caller's entry, and the exchange's state makes a second
    /// resolve impossible. One reply may be written and one resolve may succeed
    /// however many siblings a `Mint` produced.
    case PipeReply = 14,
    /// The server's obligation to send one reply: single-use, transferable
    /// (spec §2.1's `PipeRequestHandle`).
    ///
    /// The mirror of `PipeReply` in every respect except which column it counts
    /// on and which op it carries: a claim resolves, an obligation replies. It
    /// is minted at `PipeOutletOp.Take` into the taker's table, which makes it
    /// the delegation primitive: §2.1's canonical zero-copy example is a server
    /// giving this handle to a third party who replies straight to the original
    /// client, and `Transfer` is minted for exactly that.
    case PipeRequest = 15,
}

// Which kinds are waitable is deliberately not recorded here (§2.2). It cannot
// be a property of the kind alone: attaching a handle to a Waiter also spends a
// right, and which enum's bits that right lives in is decided by the kind. The
// two questions are one question, answered in one exhaustive `match` in the
// kernel's `waitable_slot`. A `Bool` here would be the same fact in a second
// place, and the place that could go stale.

// =============================================================================
// Handles (spec §3)
// =============================================================================

/// A handle naming the kernel's System object.
///
/// Each object kind gets its own handle type. Saw's distinct `type` alias gives
/// exactly the asymmetry a handle wants: it flows to `UInt` implicitly, so the
/// syscall stub takes it with no cast and no conversion is emitted, but a raw
/// word, or another kind's handle, cannot flow in. Crossing into a handle type
/// is an explicit construction, and only two places do it: userspace adopting
/// its boot handle, and the kernel's dispatch after the table has resolved the
/// handle to a System object. That is what makes the type mean "validated as
/// System" rather than merely "a number".
///
/// The typing stops at the ABI boundary. The `@export`ed vDSO symbols and the
/// `sos_syscallN` stubs keep raw `UInt` words, because a C caller sees words
/// and the export whitelist is primitives; the handle table indexes by word
/// too.
///
/// This is tier one of two, kind safety. Tier two is the owning tier: every
/// `kernel/sysapi` wrapper is a `NoCopy` struct over these aliases whose
/// `deinit` releases the word, so drop is release and §3's no-duplicate rule
/// has its exact `NoCopy` correspondence.
///
/// What a handle word is made of. The word is
/// `(generation << HANDLE_INDEX_BITS) | (index + 1)` on both profiles: the low
/// `HANDLE_INDEX_BITS` bits are a 1-based table index, the rest of the portable
/// 32-bit budget is the slot's generation, and the top 32 bits of a 64-bit word
/// stay zero. Same split and same width everywhere means the wrap behaves
/// identically on both machines. The split is one named constant
/// (`HANDLE_INDEX_BITS`, below) with every mask and shift derived from it, so
/// moving it is a one-line edit.
///
///   - The index is 1-based, which keeps generation 0 free. Slot 0 is usable
///     and `NO_HANDLE = 0` still names nothing, because "names nothing" is the
///     index field being zero rather than the whole word being zero. A
///     malformed word like `0x100` (generation 1 over a zero index, at the
///     default split) is not equal to `NO_HANDLE` and must still name nothing;
///     the kernel's `lookup_handle` tests the field for exactly that reason.
///   - Generation 0 stamps nothing. A slot's first-life word equals the bare
///     index, so §12's boot order (1 = System, 2 = Process, 3 = Thread) that
///     the hand-assembled payloads encode, and root's "boot handle 1", hold
///     verbatim. Only a reused slot's word grows high bits.
///   - It is best-effort detection of a bug, not a uniqueness guarantee. A word
///     held across exactly `HANDLE_GENERATION_MODULUS` reuses of one slot
///     aliases silently. Tables are per-process, so a wrap collision crosses no
///     process boundary and grants nothing. Don't "fix" this into unbounded
///     bookkeeping.
public type SystemHandle = UInt

/// A handle naming a Process object (§2 table). Same discipline as
/// `SystemHandle`: it flows to `UInt` at the syscall stub and nothing flows in.
public type ProcessHandle = UInt

/// A handle naming a Thread object (§2 table).
public type ThreadHandle = UInt

/// A handle naming an Event object (§2.4). Same discipline again.
public type EventHandle = UInt

/// A handle naming a Waiter object (§2.2).
public type WaiterHandle = UInt

/// A handle naming an Interrupt object (§2 table, §9): an IRQ line bound to a
/// waitable. Same discipline as every other handle type.
public type InterruptHandle = UInt

/// A handle naming a Clock object (§2 table): a granted time source. Same
/// discipline as every other handle type.
public type ClockHandle = UInt

/// A handle naming a Timer object (§2 table): a deadline bound to the Clock
/// that created it. Same discipline again.
public type TimerHandle = UInt

/// A handle naming a Memory object (spec §2.5): a sealed range of physical
/// memory. Same discipline again.
public type MemoryHandle = UInt

/// A handle naming an IoMemory object (spec §2.5): a range of device registers.
/// Same discipline again.
public type IoMemoryHandle = UInt

/// A handle naming a Mapping object (spec §2.5): one installed protection row.
/// Same discipline again.
public type MappingHandle = UInt

/// A handle naming a PipeInlet (spec §2.1): the client end of a connection.
/// Same discipline again.
public type PipeInletHandle = UInt

/// A handle naming a PipeOutlet (spec §2.1): the server end of a connection.
/// Same discipline again.
///
/// Two handle types for two kinds, as the §2 table's other rows get one each: a
/// word validated as an inlet cannot flow into a place that wants an outlet,
/// which is why each kind gets its own alias rather than a shared `PipeHandle`
/// with a role field.
public type PipeOutletHandle = UInt

/// A handle naming a PipeReply (spec §2.1): the client's claim on one reply.
/// Same discipline again.
///
/// The typed wrapper over it is `sos.pipe`'s `PipeReply`: the tree renders a §2
/// object name at the typed tier the way it renders `MemoryObject` as `Memory`,
/// so the spec's `PipeReplyHandle` is this alias and the owning wrapper is the
/// short name.
public type PipeReplyHandle = UInt

/// A handle naming a PipeRequest (spec §2.1): the server's obligation to send
/// one reply. Same discipline again.
public type PipeRequestHandle = UInt

/// A handle word the table can never hand out. Handle 0 names nothing, so a
/// zeroed register is never authority (see `ObjType.Unbound`).
///
/// Under the split word this is the low byte's zero, at every generation:
/// `0x100` is as unbindable as `0` is, because the index a word carries is
/// 1-based and zero is not an index. The kernel's `lookup_handle` tests the
/// byte rather than the word, and the wrappers' disarm sentinel is this value
/// for the same reason: an armed wrapper's word always has a non-zero low byte.
public static NO_HANDLE: UInt = 0

// -----------------------------------------------------------------------------
// The handle word's encoding: one constant, everything else derived
// -----------------------------------------------------------------------------
//
// The split is policy, stated once. Where the index field ends and the
// generation field begins is a choice this system may want to revisit, so it is
// one named constant with every mask, shift, bound and assert derived from it.
// Raising `HANDLE_INDEX_BITS` is a one-line edit that moves all of them
// together; there are no hardcoded `0xFF` masks and no bare `>> 8` shifts
// anywhere in the kernel or this module.
//
// It lives here, beside `NO_HANDLE`, because it defines what a handle word is.
// The kernel's table and the wrappers' sentinel are both consequences of this
// encoding, and a consequence should not be where the rule is written.
//
// The budget being divided is 32 bits on both profiles, the portable width, so
// the wrap behaves identically on either machine. A 64-bit word's top 32 bits
// stay zero, and `lookup_handle` enforces that rather than assuming it (see
// `handle_word_generation`).

/// The portable width a handle word is encoded in, on both profiles.
public static HANDLE_WORD_BITS: Int = 32

/// The one knob: how many low bits of a handle word carry the table index; the
/// rest carry the generation. Default 8.
///
/// It is a shift count everywhere it is used, the one operand position exempt
/// from Saw's type-agreement rule, so it stays a plain `Int` and needs no
/// conversion at any use site.
public static HANDLE_INDEX_BITS: Int = 8

/// What is left of the portable budget for the generation counter.
public static HANDLE_GENERATION_BITS: Int = HANDLE_WORD_BITS - HANDLE_INDEX_BITS

/// The mask that takes the index field out of a handle word.
public static HANDLE_INDEX_MASK: UInt = (1 << HANDLE_INDEX_BITS) - 1

/// The generation counter's modulus. It wraps here, identically on both
/// profiles.
///
/// It also makes the top-half-stays-zero rule enforced rather than assumed: a
/// stored generation is always below this, and a word resolves by comparing its
/// whole generation field against one, so a 64-bit word with anything set above
/// the portable budget has a generation no entry can equal and names nothing.
/// No separate range test is owed.
public static HANDLE_GENERATION_MODULUS: UInt32 = 1 << HANDLE_GENERATION_BITS

// The knob's own guard rails. Each field must exist, and the two must exactly
// divide the portable budget: a split that lost a bit would silently make some
// words unrepresentable, and one that overlapped would make a generation alias
// an index. The bound tying `MAX_HANDLES` to the index field is in
// `kcore.objects`, which is the module that knows both numbers.
static_assert(HANDLE_INDEX_BITS >= 1,
              "the index field must be at least one bit wide")
static_assert(HANDLE_GENERATION_BITS >= 1,
              "the generation field must be at least one bit wide")
static_assert(HANDLE_INDEX_BITS + HANDLE_GENERATION_BITS == HANDLE_WORD_BITS,
              "the index and generation fields must exactly divide the portable word")

/// The `entry` argument to `Process.ThreadCreate` that means "start the thread
/// at this process's own image entry": the entry the loader took out of the
/// image header.
///
/// It exists because of a language gap: Saw cannot name the address of a
/// function (`extern` declares functions, an extern function is not usable as a
/// value, and `@export` on a static emits a definition). So a process written
/// in Saw has no way to compute an entry address for a thread it wants to
/// create, and this is the one entry it can ask for by name. A process that can
/// produce an address (one with a C leaf, which is what the harness's thread
/// images use) passes it and the kernel checks it against the image's granted
/// region.
public static ENTRY_IMAGE: UInt = 0
