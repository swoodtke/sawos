//! Addresses and bytes: the arithmetic and the two byte moves the rest of the
//! kernel is written on top of.
//!
//! This module names no kernel state and calls nothing, which puts it at the
//! bottom of the module order: the copy doors (`process`), the frame arena
//! (`threads`) and, through `kcore.preempt`'s strided movers, the sosimg loader
//! all use these, and none of them can be reached back into. Calling nothing is
//! load-bearing: it is why the byte moves carry no preemption point, since a
//! point delivers and delivery is at the top of the order.

// =============================================================================
// Arithmetic the loader needs
// =============================================================================

/// Round `v` up to the next multiple of `align` (a power of two).
public func align_up(v: UInt, align: UInt) -> UInt {
    let rem = v & (align - 1)
    if rem == 0 {
        v
    } else {
        v + (align - rem)
    }
}

/// Word alignment, from the machine rather than from a constant. A function
/// because `sizeof` does not fold in a static initializer.
public(package) func word_bytes() -> UInt {
    sizeof<UInt>() as UInt
}

// =============================================================================
// The two byte moves
// =============================================================================
//
// These are the primitive, not the operation. Neither loop takes a preemption
// point, and neither may: this module is at the bottom of the order and a point
// delivers, which reaches `irq` at the top (see `kcore.preempt`, which holds
// the strided movers and states the cycle in full).
//
// A bulk caller uses `preempt.long_copy` / `preempt.long_zero`. The copy doors
// (`process.copy_out` / `copy_in`) sit below `preempt` and move records
// bounded by `WaitBuffer` (its body is at most `PIPE_BODY_BYTES`), well under
// one stride, so they use these directly. A bulk move would need a pointed
// door, and that belongs above `preempt`.

/// Copy `len` bytes from `src` to `dst`, one byte at a time and without pause.
///
/// A caller moving more than a stride's worth uses `preempt.long_copy` instead.
/// Using this one claims that the copy is short or that the caller cannot be
/// interrupted.
public(package) func copy_bytes(dst: UInt, src: UInt, len: UInt) unsafe {
    var i: UInt = 0
    while i < len {
        UnsafeMemory<UInt8, Normal>(dst + i).write(UnsafeMemory<UInt8, Normal>(src + i).read())
        i = i + 1
    }
}

/// Clear `len` bytes at `dst`, one byte at a time and without pause.
///
/// `preempt.long_zero` is the bulk spelling. This one has no caller outside
/// that wrapper.
public(package) func zero_bytes(dst: UInt, len: UInt) unsafe {
    var i: UInt = 0
    while i < len {
        UnsafeMemory<UInt8, Normal>(dst + i).write(0)
        i = i + 1
    }
}
