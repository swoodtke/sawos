//! ADDRESSES AND BYTES — the arithmetic and the two byte moves everything
//! else in the kernel is written on top of.
//!
//! It names no kernel state and calls nothing, which is what puts it at the
//! bottom of the module order: the copy doors (`process`), the frame arena
//! (`threads`) and — through `kcore.preempt`'s strided movers — the sosimg
//! loader all reach for these four, and none of them can be reached back into.
//!
//! CALLING NOTHING IS NOW LOAD-BEARING RATHER THAN INCIDENTAL (design 1): it is
//! why the byte moves below carry no preemption point, since a point delivers
//! and delivery is at the top of the order. See the section header on them.

// =============================================================================
// Arithmetic the loader needs
// =============================================================================

/// Round `v` up to the next multiple of `align` (a power of two).
public func align_up(v: UInt, align: UInt) -> UInt {
    let rem = v & (align - 1)
    if rem == 0 {
        v
    } else {
        v + (align - rem)
    }
}

/// Word alignment, from the machine rather than from a constant. A function
/// because `sizeof` does not fold in a static initializer — DF-178f, the same
/// gap `sosabi`'s `wait_record_bytes` works around, and it folds fine here.
public(package) func word_bytes() -> UInt {
    sizeof<UInt>() as UInt
}

// =============================================================================
// The two byte moves
// =============================================================================
//
// THESE ARE THE PRIMITIVE, NOT THE OPERATION (design 1, M3 unit 1.5). Neither
// loop takes a preemption point, and neither may: this module is at the BOTTOM
// of the order and a point delivers, which reaches `irq` at the top — see
// `kcore.preempt`, which holds the strided movers every bulk copy goes through
// and states the cycle in full.
//
// SO A BULK CALLER USES `preempt.long_copy` / `preempt.long_zero`, and the two
// callers left here are deliberate: the copy DOORS (`process.copy_out` /
// `copy_in`) sit below `preempt` and move a 24-byte wait record, well under one
// stride. §2.1's Pipe bodies are the length that changes that, and their callers
// are above `preempt`, so the pointed door goes there when it arrives.

/// Copy `len` bytes from `src` to `dst`, one byte at a time and without pause.
///
/// AUDIT (design 1): a caller moving more than a stride's worth reaches for
/// `preempt.long_copy` instead. Reaching for this one is a claim that the copy
/// is short or that the caller cannot be interrupted — the copy doors are both.
public(package) func copy_bytes(dst: UInt, src: UInt, len: UInt) unsafe {
    var i: UInt = 0
    while i < len {
        UnsafeMemory<UInt8, Normal>(dst + i).write(UnsafeMemory<UInt8, Normal>(src + i).read())
        i = i + 1
    }
}

/// Clear `len` bytes at `dst`, one byte at a time and without pause.
///
/// AUDIT (design 1): `preempt.long_zero` is the bulk spelling. This one has no
/// caller outside that wrapper today.
public(package) func zero_bytes(dst: UInt, len: UInt) unsafe {
    var i: UInt = 0
    while i < len {
        UnsafeMemory<UInt8, Normal>(dst + i).write(0)
        i = i + 1
    }
}
