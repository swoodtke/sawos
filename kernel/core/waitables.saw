//! Events, Waiters and Attachments (spec §2.2, §2.4): the slabs, and the
//! per-kind matrix in one place.
//!
//! Together they are the whole of asynchronous notification: an Event is a word
//! that accumulates and never blocks, a Waiter is a set of waitables plus the
//! threads parked on the set, and an Attachment is the pair.
//!
//! Delivery is not here (see `refs`). Answering a wait writes into a process's
//! memory through the copy door in `process`, and delivery drops references and
//! frees objects, so it sits above both `process` and these slabs. The tables
//! and the questions asked of them stay below it.
//!
//! The Process waitable's per-kind answers (who is watching it, is it dead,
//! what does the record say) are reads of `PROCESS_RECORDS` in `pslot`.
//! `process` imports nothing from here, so there is no cycle.

import sosabi.{EventMode, InletLevel, OutletLevel, ReplyLevel, WaitTag,
               process_status_word}
import kcore.limits.{
    MAX_ATTACHMENTS,
    MAX_EVENTS,
    MAX_INTERRUPTS,
    MAX_SLAB_EXTENTS,
    MAX_WAITERS,
    NO_ATTACHMENT,
    NO_EVENT,
    NO_INTERRUPT,
    NO_THREAD,
    NO_WAITER,
}
import kcore.slab.{Slab}
import kcore.objects.{
    EXCHANGES,
    ExchangeState,
    PIPES,
    SlotState,
    exchange_body_addr,
    exchange_pipe,
    pipe_has_room,
}
import kcore.threads.{NEED_RESCHED, THREADS, ThreadState}
import kcore.time.{TIMERS, saturating_add}
// Process is a waitable kind, so the per-kind matrix below reads the process
// slot. `process` must not import this module.
import kcore.pslot.{PROCESS_RECORDS, ProcessState}

/// The kinds that can be attached to a Waiter: the waitable kinds, and only
/// those.
///
/// This is a second enum beside `ObjType` rather than a `Bool` on it, because
/// attaching also spends a right, and which enum's bits that right lives in is
/// decided by the kind. `waitable_slot` is the only place an `ObjType` becomes
/// one of these; every non-waitable arm of that match terminates the process
/// instead of producing a value.
///
/// The per-kind questions below are exhaustive over waitables, not over object
/// types: a non-waitable object kind costs them nothing, and a new waitable
/// kind fails every one of them to compile until somebody answers for it.
public(package) enum WaitableKind: UInt8 {
    case Event = 0,
    case Interrupt = 1,
    case Timer = 2,
    /// A process, ready once it has ended (spec §8). It is not a notification
    /// object: nothing creates it to be waited on, and what a supervisor
    /// attaches is the handle `process_create` already gave it.
    case Process = 3,
    /// A `PipeOutlet`, the server end: readable while a message is staged or
    /// the client end is gone (spec §2.2's waitable list). `slot` is the
    /// connection's.
    case PipeOutlet = 4,
    /// A `PipeInlet`, the client end: postable while the ring has a free slot
    /// or the server end is gone. `slot` is the connection's, so the two
    /// endpoint kinds index one table and differ only in which column and which
    /// attachment field they read.
    case PipeInlet = 5,
    /// A `PipeReply`, the client's claim: ready once the answer has been
    /// written or can never be. `slot` is an exchange. This is the one waitable
    /// whose delivery carries bytes.
    case PipeReply = 6,
    /// A `PipeRequest`, the server's obligation: ready once the claim behind it
    /// has been abandoned (§2.1's early notice). `slot` is an exchange.
    case PipeRequest = 7,
}

/// A waitable the dispatch has resolved: which table, which slot.
public(package) struct Waitable {
    public(package) kind: WaitableKind,
    public(package) slot: Int,
}

/// One Event (spec §2.4): the accumulating non-blocking notification.
///
/// `word` is the object. Non-zero means ready, which makes readiness
/// level-triggered (§2.2): nothing records that a waiter has been told, so
/// every look at the word gives the same answer until somebody takes it.
///
/// Taking is read-and-clear through either door: §2.4's `Receive` (the
/// non-blocking poll) and a `Waiter.wait` delivery (the blocking one) both hand
/// the word to a process and reset it. So the word is never reported twice, and
/// a signal arriving after a take re-arms this object with its own bits alone.
///
/// `attachment` is the one thing an Event knows about the wait side: which
/// attachment names it, or zero. §2.2 allows at most one Waiter per object, so
/// this is a field rather than a list, which keeps `Signal`'s hot path to one
/// load. Everything else about the attachment lives in the attachment itself.
/// Slot indices are stored plus one so that zero means "none", which is what a
/// zeroed static already says.
public(package) struct EventSlot {
    public(package) state: SlotState,
    /// The process charged for this Event, or `NO_PROCESS` once that process
    /// has died and disowned it (spec §2.10). Test for that before using it
    /// as an index.
    public(package) process: Int,
    /// §2.4's per-Event accumulation mode, fixed at creation.
    public(package) mode: EventMode,
    /// The accumulated word. Non-zero = ready.
    public(package) word: UInt,
    /// The attachment naming this event (slot + 1); 0 = unattached.
    public(package) attachment: Int,
    /// Handle entries naming this event, plus its attachment, plus the staged
    /// messages that carry it.
    ///
    /// The attachment counts, so an attached Event cannot reach zero: nothing
    /// frees a waitable out from under the Waiter watching it. The Waiter's own
    /// death detaches first, and that decrement may take this one to zero.
    public(package) refs: UInt16,
}

/// One Interrupt (spec §2 table, §9): an IRQ line bound to a waitable.
///
/// `pending` is the object, as an Event's word is: set when the line fires,
/// cleared by `Ack`, and "ready" means nothing more. §9's
/// at-most-one-unacked-fire invariant is represented (a `Bool` cannot hold
/// two), and it is true because the kernel masks the line before the hook runs
/// and only `Ack` unmasks it, so the device cannot fire again in between.
///
/// `line` is the number the controller answers with. The trap path has a line
/// and needs the object, which a table scan answers. The scan runs with
/// interrupts masked, so its length is interrupt latency.
public(package) struct InterruptSlot {
    public(package) state: SlotState,
    public(package) process: Int,
    /// The IRQ line this object is bound to, for its whole life.
    public(package) line: UInt,
    /// Fired and not yet acked. Non-false = ready, in §2.2's sense.
    public(package) pending: Bool,
    /// The attachment naming this interrupt (slot + 1); 0 = unattached.
    public(package) attachment: Int,
    /// Handle entries naming this interrupt, plus its attachment. Reaching zero
    /// masks the line and returns the slot, so the line becomes bindable again.
    public(package) refs: UInt16,
}

/// Where a Waiter is in its life (spec §2.10).
///
/// A Waiter is bound to the process that created it, so it has an invalid
/// state the shared kinds lack: `Invalid` is a Waiter whose owner died while a
/// handle elsewhere still named it. Its attachments are gone, nothing is parked
/// on it, every op through a handle onto it answers `Revoked`, and the slot is
/// held only for those handles: the last one going frees it.
///
/// It is this kind's own enum rather than a third `SlotState` case, so the
/// kinds that have no invalid state need no arm for one, and rather than a flag
/// beside `SlotState`, so that every match on a Waiter's state has to say what
/// an invalid one means.
public(package) enum WaiterState: UInt8 {
    case Free = 0,
    case Live = 1,
    case Invalid = 2,
}

/// One Waiter (spec §2.2): the generic wait aggregator.
///
/// Two lists and nothing else. `attached` is the subscription set (§2.2 has no
/// one-shot mode at the Waiter level; one-shot is a property of the attachment,
/// `Attachment.oneshot`, and a kind whose delivery consumes ends its attachment
/// at delivery too). `blocked` is the threads parked in `Wait`, which §2.2
/// allows to be several. Readiness is not a third list: it is derived by
/// scanning `attached` for something ready, which is the level-triggered
/// semantics implemented rather than maintained beside it.
public(package) struct WaiterSlot {
    public(package) state: WaiterState,
    /// The process that created this Waiter and is charged for it, or
    /// `NO_PROCESS` once it is invalid. Test for that before using it as an
    /// index.
    public(package) process: Int,
    /// Head of the attachment list (attachment slot + 1).
    public(package) attached: Int,
    /// Head of the list of threads parked in `Wait` (thread slot + 1).
    ///
    /// When this Waiter's last reference goes, or its owner dies, every thread
    /// on this list is answered `SosStatus.Revoked` (`revoke_blocked`). A
    /// readiness feeds one of them (§2.2's distribution); a revocation answers
    /// all of them.
    public(package) blocked: Int,
    /// Handle entries naming this waiter, plus the staged messages that carry
    /// it. No attachment: an attachment is a reference to the waitable, not to
    /// the Waiter that holds it. A Waiter owns its attachment list, so
    /// counting them here would be an object counting itself and nothing would
    /// reach zero. This asymmetry is why the Waiter's free cascades.
    public(package) refs: UInt16,
}

/// One attachment: a Waiter, a waitable, and the key that names the pair.
///
/// It is a third object rather than fields on the waitable, so that a Waiter's
/// set is one list: a wait scans it once and a `Remove` walks it once, instead
/// of a matrix over kinds.
///
/// Each waitable keeps a single `attachment` field, which answers the only
/// question the signal side asks: who, if anyone, is watching me.
public(package) struct Attachment {
    public(package) state: SlotState,
    /// Which table `target` indexes.
    public(package) kind: WaitableKind,
    /// The waitable's slot in that table.
    public(package) target: Int,
    /// The Waiter this attachment belongs to (slot index, 0-based).
    public(package) waiter: Int,
    /// The word-sized key the attacher supplied (§2.2). The kernel stores it
    /// and hands it back; it never interprets it.
    public(package) key: UInt,
    /// Detach at delivery. Set from `WAITER_ADD_ONESHOT` at the attach, and
    /// read once, when a record for this attachment's key is copied out (never
    /// at mere readiness). One-shot is the attacher's choice per attachment,
    /// like the key, which is why it is a field here and not a bit on the
    /// waitable. It is a `Bool` rather than the userspace `AttachMode` enum
    /// because the kernel's question is a yes/no about this attachment.
    public(package) oneshot: Bool,
    /// The attachment owns the object. Set from `WAITER_ADD_CONSUMING` at the
    /// attach. A persistent-consuming attachment on a `PipeOutlet` is the
    /// completion-queue server, and its delivery is the take itself rather than
    /// a report that there is something to take, so the attachment must
    /// remember which kind of subscription it is.
    ///
    /// `oneshot` says what happens to the attachment at delivery; this says who
    /// owns the object while it lives.
    public(package) owns: Bool,
    /// Next attachment on that waiter's list (slot + 1).
    public(package) link: Int,
}

// Each slab is a `Slab<T, N>`: the array is extent 0 and `MAX_<KIND>` is the
// compiled floor. `EVENTS[i]` names slot `i` (the accessor lends the slot where
// it sits). Loop bounds read `capacity()` so that a donated slot is one the
// allocator can find.

public(package) unsafe static var EVENTS: Slab<EventSlot, MAX_EVENTS> = Slab<EventSlot, MAX_EVENTS>(
    inline: [EventSlot(state: SlotState.Free, process: 0, mode: EventMode.Or,
                       word: 0, attachment: 0, refs: 0); MAX_EVENTS],
    ext_base: [0; MAX_SLAB_EXTENTS],
    ext_slots: [0; MAX_SLAB_EXTENTS],
    ext_side: [0; MAX_SLAB_EXTENTS],
    ext_count: 0,
    total: MAX_EVENTS)

public(package) unsafe static var WAITERS: Slab<WaiterSlot, MAX_WAITERS> = Slab<WaiterSlot, MAX_WAITERS>(
    inline: [WaiterSlot(state: WaiterState.Free, process: 0, attached: 0,
                        blocked: 0, refs: 0); MAX_WAITERS],
    ext_base: [0; MAX_SLAB_EXTENTS],
    ext_slots: [0; MAX_SLAB_EXTENTS],
    ext_side: [0; MAX_SLAB_EXTENTS],
    ext_count: 0,
    total: MAX_WAITERS)

public(package) unsafe static var INTERRUPTS: Slab<InterruptSlot, MAX_INTERRUPTS> = Slab<InterruptSlot, MAX_INTERRUPTS>(
    inline: [InterruptSlot(state: SlotState.Free, process: 0, line: 0,
                           pending: false, attachment: 0,
                           refs: 0); MAX_INTERRUPTS],
    ext_base: [0; MAX_SLAB_EXTENTS],
    ext_slots: [0; MAX_SLAB_EXTENTS],
    ext_side: [0; MAX_SLAB_EXTENTS],
    ext_count: 0,
    total: MAX_INTERRUPTS)

public(package) unsafe static var ATTACHMENTS: Slab<Attachment, MAX_ATTACHMENTS> = Slab<Attachment, MAX_ATTACHMENTS>(
    inline: [Attachment(state: SlotState.Free, kind: WaitableKind.Event,
                        target: 0, waiter: 0, key: 0, oneshot: false,
                        owns: false, link: 0); MAX_ATTACHMENTS],
    ext_base: [0; MAX_SLAB_EXTENTS],
    ext_slots: [0; MAX_SLAB_EXTENTS],
    ext_side: [0; MAX_SLAB_EXTENTS],
    ext_count: 0,
    total: MAX_ATTACHMENTS)

/// Take a free event slot, or `NO_EVENT` when the slab is empty.
public(package) func alloc_event() unsafe -> Int {
    var i: Int = 0
    while i < EVENTS.capacity() {
        match EVENTS[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_EVENT
}

/// Take a free waiter slot, or `NO_WAITER` when the slab is empty.
public(package) func alloc_waiter() unsafe -> Int {
    var i: Int = 0
    while i < WAITERS.capacity() {
        match WAITERS[i].state {
            case Free -> { return i },
            case Live -> {},
            case Invalid -> {},
        }
        i = i + 1
    }
    NO_WAITER
}

/// Take a free interrupt slot, or `NO_INTERRUPT` when the slab is empty.
public(package) func alloc_interrupt() unsafe -> Int {
    var i: Int = 0
    while i < INTERRUPTS.capacity() {
        match INTERRUPTS[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_INTERRUPT
}

/// Take a free attachment slot, or `NO_ATTACHMENT` when the slab is empty.
public(package) func alloc_attachment() unsafe -> Int {
    var i: Int = 0
    while i < ATTACHMENTS.capacity() {
        match ATTACHMENTS[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_ATTACHMENT
}

// -----------------------------------------------------------------------------
// Events and Waiters (spec §2.2, §2.4)
// -----------------------------------------------------------------------------
//
// Level-triggered readiness is an absence, not a mechanism (§2.2). The kernel
// records nowhere that a waiter has been told about a ready event, so every
// look at the attachment set gives the same answer until somebody takes the
// word. That is what makes a signal landing before anyone waits safe: the word
// is still non-zero when the wait arrives. An edge-triggered design would need
// a "reported" flag per attachment and would lose exactly that.
//
// The take has two doors and both consume. `Receive` is the non-blocking poll
// and a `Waiter.wait` is the blocking one; each hands the accumulated word to a
// process, so each clears it. A delivery that left the word behind would report
// the same bits to the next wait, and the recipient could not tell that
// duplicate from a real second signal. A signal that lands after the take
// re-arms readiness with its own bits alone.
//
// A signal is a distribution, not a broadcast. `Signal` wakes at most one
// parked thread (§2.2: "a ready handle wakes one waiter"), and that thread's
// record carries the word, so with several threads parked on one Waiter one
// signal feeds exactly one of them. The recipient is unique by construction: a
// waitable has at most one attachment (§2.2), so a signal reaches one Waiter,
// which hands it to one thread.

/// §2.4's accumulation, both modes.
///
/// The sum saturates rather than wrapping: a producer faster than its consumer
/// must not roll a full count back through zero, because zero means "not ready"
/// and a wrap would make a saturated event go quiet.
public(package) func accumulate(slot: Int, bits: UInt) unsafe {
    match EVENTS[slot].mode {
        case Or -> {
            EVENTS[slot].word = EVENTS[slot].word | bits
        },
        case SaturatingSum -> {
            EVENTS[slot].word = saturating_add(EVENTS[slot].word, bits)
        },
    }
}

// -----------------------------------------------------------------------------
// The per-kind matrix: one arm per waitable kind
// -----------------------------------------------------------------------------
//
// Everything the wait machinery needs to know about a waitable is one of these
// questions, each answered by an exhaustive match on `WaitableKind`:
//
//   `waitable_attachment` / `set_waitable_attachment`   who is watching me
//   `waitable_ready`                                    am I ready
//   `waitable_answer`                                   what does a record say
//   `waitable_consume`                                  a record was delivered
//
// The answers differ per kind (an Event's readiness is a word, an Interrupt's
// is a masked line, a Timer's is a count of expiries, a Process's is being
// dead), so they are small functions in one place. Adding a waitable kind fails
// every one of them to compile, which a `_` arm anywhere here would defeat.
//
// Everything else about waiting (the list walk, the key lookup, the wake, the
// copy-out) is kind-blind and appears exactly once below.

/// Which attachment names this waitable (slot + 1), or 0.
public(package) func waitable_attachment(kind: WaitableKind, slot: Int) unsafe -> Int {
    match kind {
        case Event -> EVENTS[slot].attachment,
        case Interrupt -> INTERRUPTS[slot].attachment,
        case Timer -> TIMERS[slot].attachment,
        case Process -> PROCESS_RECORDS[slot].attachment,
        // Two kinds over one connection row; the kind says which field, as in
        // `ref_object` for the two reference columns.
        case PipeOutlet -> PIPES[slot].outlet_attachment,
        case PipeInlet -> PIPES[slot].inlet_attachment,
        // Two kinds over one exchange.
        case PipeReply -> EXCHANGES[slot].reply_attach,
        case PipeRequest -> EXCHANGES[slot].request_attach,
    }
}

/// Record (or clear, with 0) which attachment names this waitable.
public(package) func set_waitable_attachment(kind: WaitableKind, slot: Int, a: Int) unsafe {
    match kind {
        case Event -> { EVENTS[slot].attachment = a },
        case Interrupt -> { INTERRUPTS[slot].attachment = a },
        case Timer -> { TIMERS[slot].attachment = a },
        case Process -> { PROCESS_RECORDS[slot].attachment = a },
        case PipeOutlet -> { PIPES[slot].outlet_attachment = a },
        case PipeInlet -> { PIPES[slot].inlet_attachment = a },
        case PipeReply -> { EXCHANGES[slot].reply_attach = a },
        case PipeRequest -> { EXCHANGES[slot].request_attach = a },
    }
}

/// Is this waitable ready, in §2.2's level-triggered sense?
///
/// Every answer is a read of the object's own state; none consults a flag the
/// wait machinery maintains. An Event is ready while its word is non-zero, an
/// Interrupt while its fire is unacked, a Timer while it has expiries nobody
/// has been told about or once it is invalid, and a Process once it is `Gone`.
///
/// The Process arm and an invalid Timer are terminal (spec §2.10): the other
/// levels can drop again (a word is taken, a line is acked, a count is spent),
/// but `Gone` and `Invalid` are states an object leaves only by being freed,
/// and it cannot be freed while somebody is attached to it. So the level a
/// death raises stays raised for as long as anyone can observe it.
public(package) func waitable_ready(kind: WaitableKind, slot: Int) unsafe -> Bool {
    match kind {
        case Event -> EVENTS[slot].word != 0,
        case Interrupt -> INTERRUPTS[slot].pending,
        case Timer -> {
            match TIMERS[slot].state {
                case Live -> TIMERS[slot].fires != 0,
                case Invalid -> true,
                // A freed Timer has no attachment and no handle, so nothing
                // asks; it is not ready.
                case Free -> false,
            }
        },
        case Process -> {
            match PROCESS_RECORDS[slot].state {
                case Gone -> true,
                // `Created` is not ready: a process that was made and never
                // started has not ended, so a supervisor parked on one waits
                // (and `pick_next`'s deadlock report names it).
                case _ -> false,
            }
        },
        // Drain-then-terminal (spec §2.2's readable arm): anything staged is
        // readable whatever became of the sender, and an empty ring with no
        // inlet left is readable too (the waiter is told `PeerGone`). This is
        // the order `pipe_take` reads. Both halves are the connection's own
        // state, so the level is derived and maintained nowhere.
        case PipeOutlet -> PIPES[slot].staged != 0 || PIPES[slot].inlet_refs == 0,
        // Room, or nobody to take. Mirrors the above and reads in `pipe_post`'s
        // order: the outlet column at zero is the stronger fact, so a poster
        // woken by it learns that posting is over rather than that there is
        // space.
        case PipeInlet -> (PIPES[slot].outlet_refs == 0
                           || pipe_has_room(slot)),
        // The answer is here, or it never will be. This is `pipe_resolve`'s
        // split: `Replied` has the bytes; a `Taken` exchange whose obligation
        // column fell was abandoned by the server; a `Staged` one whose
        // connection lost its outlet can never be taken at all. `Settled` is
        // not ready (the answer was already delivered) and `Free` names no
        // exchange a handle could hold.
        case PipeReply -> {
            match EXCHANGES[slot].state {
                case Replied -> true,
                case Taken -> EXCHANGES[slot].request_refs == 0,
                case Staged -> PIPES[exchange_pipe(slot)].outlet_refs == 0,
                case Settled -> false,
                case Free -> false,
            }
        },
        // The claim was dropped (§2.1's early notice to the server). Asked only
        // of a `Taken` exchange, the only state in which an obligation exists:
        // `Staged` has not minted it, and `Replied` / `Settled` are past it.
        // Terminal, because a reply column that reached zero can never rise.
        case PipeRequest -> {
            match EXCHANGES[slot].state {
                case Taken -> EXCHANGES[slot].reply_refs == 0,
                case Replied -> false,
                case Settled -> false,
                case Staged -> false,
                case Free -> false,
            }
        },
    }
}

/// The tag and payload words a wait record carries for this waitable.
///
/// The Process arm carries spec §8's own word: `process_status_word` is the
/// same assembly `ProcessOp.GetStatus` answers with, so being woken by a death
/// and asking about one produce identical bits.
///
/// An invalid Timer answers its ordinary record, with no case added for the
/// invalidation (spec §2.10). Its count is zero, because the invalidation
/// disarmed it, which no live Timer's delivery carries.
///
/// Three of the four pipe arms are word-shaped levels and answer with
/// `body_len: 0`. The `PipeReply` arm carries the reply's bytes, and `body_src`
/// is the kernel address the delivery copies them from. The copy is sized to
/// the delivery: the waiter's buffer always has room for a body, but a
/// word-payload delivery copies none of it.
public(package) func waitable_answer(kind: WaitableKind, slot: Int) unsafe -> WaitAnswer {
    match kind {
        case Event -> WaitAnswer(tag: WaitTag.Event, payload: EVENTS[slot].word,
                                 body_len: 0, body_src: 0),
        case Interrupt -> WaitAnswer(tag: WaitTag.Interrupt,
                                     payload: INTERRUPTS[slot].line,
                                     body_len: 0, body_src: 0),
        case Timer -> WaitAnswer(tag: WaitTag.Timer,
                                 payload: TIMERS[slot].fires,
                                 body_len: 0, body_src: 0),
        case Process -> WaitAnswer(
            tag: WaitTag.Process,
            payload: process_status_word(PROCESS_RECORDS[slot].exit_kind,
                                         PROCESS_RECORDS[slot].exit_code),
            body_len: 0, body_src: 0),
        // Drain-first, so a staged message is `Msg` whatever became of the
        // sender; this matches the order of the readiness test above, so the
        // two never disagree.
        case PipeOutlet -> {
            var level = OutletLevel.PeerGone
            if PIPES[slot].staged != 0 {
                level = OutletLevel.Msg
            }
            WaitAnswer(tag: WaitTag.Readable, payload: level as UInt,
                       body_len: 0, body_src: 0)
        },
        // `PeerGone` first, mirroring `pipe_post`.
        case PipeInlet -> {
            var level = InletLevel.Room
            if PIPES[slot].outlet_refs == 0 {
                level = InletLevel.PeerGone
            }
            WaitAnswer(tag: WaitTag.Room, payload: level as UInt,
                       body_len: 0, body_src: 0)
        },
        // The one delivery that carries bytes. `Replied` hands over the reply
        // body out of the same ring slot that carried the request; every other
        // ready state is the abandonment `pipe_resolve` reports, with nothing
        // to copy.
        case PipeReply -> {
            match EXCHANGES[slot].state {
                case Replied -> WaitAnswer(
                    tag: WaitTag.Reply, payload: ReplyLevel.Data as UInt,
                    body_len: EXCHANGES[slot].len as UInt,
                    body_src: exchange_body_addr(slot)),
                case _ -> WaitAnswer(tag: WaitTag.Reply,
                                     payload: ReplyLevel.PeerClosed as UInt,
                                     body_len: 0, body_src: 0),
            }
        },
        // No payload: the fact is the notification.
        case PipeRequest -> WaitAnswer(tag: WaitTag.Abandoned, payload: 0,
                                       body_len: 0, body_src: 0),
    }
}

/// A record describing this waitable has been delivered to a thread. Update
/// whatever the delivery spent.
///
/// The kinds differ for real reasons:
///
///   - An Event's word is consumed by whoever takes the value, through either
///     door. §2.4's `receive` and a `Waiter.wait` both hand the accumulated
///     word to a process, so both clear it. Leaving it would report the same
///     bits to the next wait, a duplicate the recipient cannot tell from a real
///     second signal.
///   - An Interrupt's readiness is ended by the driver's `ack` and nothing else
///     (§9), because the line stays masked until the device has been serviced.
///     The kernel cannot know that a record was enough.
///   - A Timer's fire count is spent by the delivery. It has no mask to hold
///     and no device to service, so the fire has done its job once somebody has
///     been told. This is what makes a periodic timer a schedule rather than a
///     request/response. An invalid Timer's count is already zero, and its
///     level is its state, which nothing here can lower.
///   - A Process's death clears nothing. The empty arm differs from the
///     Interrupt's: an Interrupt's readiness has an end the kernel does not
///     own, while a death has no end. Consuming a death reports it and nothing
///     un-dies, so the next wait on the same attachment answers the same §8
///     word, and a waiter attaching after the death is told at once.
public(package) func waitable_consume(kind: WaitableKind, slot: Int) unsafe {
    match kind {
        // Read-and-clear is one act: `deliver_attachment` read the word a few
        // lines earlier in the same interrupts-masked region, so no signal can
        // land between the read and this clear.
        case Event -> { EVENTS[slot].word = 0 },
        case Interrupt -> {},
        case Timer -> { TIMERS[slot].fires = 0 },
        // Terminal level; see the docstring. There is nothing a death could
        // honestly write here.
        case Process -> {},
        // Three of the four pipe arms spend nothing, for different reasons:
        //
        //   - A readable outlet's level ends when the server takes the message,
        //     and a delivery is not a take (the record says "there is
        //     something", not "here it is"). Like the Interrupt, the readiness
        //     has an end the kernel does not own.
        //   - A postable inlet's level ends at the poster's own next post.
        //     Consuming it would make a client that woke and then chose not to
        //     post never hear about the room again.
        //   - An abandoned claim is terminal, like the Process arm: nothing
        //     un-abandons.
        case PipeOutlet -> {},
        case PipeInlet -> {},
        case PipeRequest -> {},
        // The fourth discharges an exchange. The delivery handed the reply's
        // bytes to a process (the wait is the resolve), so the answer is spent
        // and the exchange moves to `Settled`. Without this the slot would stay
        // `Replied` and a later `Resolve` through the same claim would copy the
        // answer out a second time. With it, a later `Resolve` is `PeerClosed`
        // and the slot goes back when the columns fall. It runs for abandoned
        // deliveries too: that claim has been told no answer will come.
        case PipeReply -> { EXCHANGES[slot].state = ExchangeState.Settled },
    }
}

/// What `waitable_answer` produces: everything in the record that is not the
/// key.
///
/// `public(package)`, like the function that hands it out: `kcore.refs` binds
/// one and reads every field, so a private type here would be a value a sibling
/// module holds and cannot name.
///
/// `body_len` is how many bytes the delivery carries (zero for every kind but a
/// reply with data) and `body_src` is the kernel address they are copied from,
/// which is a ring slot's body and nothing else. Both zero is the word-payload
/// case, and the copy-out is sized to the delivery rather than to the buffer.
public(package) struct WaitAnswer {
    public(package) tag: WaitTag,
    public(package) payload: UInt,
    public(package) body_len: UInt,
    public(package) body_src: UInt,
}

/// The first attachment of `w` whose waitable is ready, or `NO_ATTACHMENT`.
///
/// A scan, which is the level-triggered semantics implemented rather than
/// maintained: there is no ready queue to keep in step with the objects, so a
/// waitable that goes back to not-ready cannot leave a stale entry behind. It
/// is O(attachments) and runs with interrupts masked, so its length is
/// interrupt latency.
public(package) func waiter_ready_attachment(w: Int) unsafe -> Int {
    var cur = WAITERS[w].attached
    while cur != 0 {
        let a = cur - 1
        if waitable_ready(ATTACHMENTS[a].kind, ATTACHMENTS[a].target) {
            return a
        }
        cur = ATTACHMENTS[a].link
    }
    NO_ATTACHMENT
}

/// Take every thread of process `p` off every Waiter's blocked list, leaving
/// the other threads where they were.
///
/// A Waiter can be given, so a thread may be parked on another process's
/// Waiter, and another process's thread on one of `p`'s. The teardown calls
/// this before its close-all, so that no delivery and no revocation from then
/// on can reach one of `p`'s threads, while other processes' threads stay
/// parked for the invalidation of `p`'s Waiters to answer. A walk with a
/// trailing pointer, as `unjoin_process` does: a thread is on at most one list.
public(package) func unblock_process(p: Int) unsafe {
    var w: Int = 0
    while w < WAITERS.capacity() {
        match WAITERS[w].state {
            case Live -> {
                // Slot + 1 throughout, matching the list's own encoding.
                var prev: Int = 0
                var cur = WAITERS[w].blocked
                while cur != 0 {
                    let slot = cur - 1
                    let next = THREADS[slot].link
                    if THREADS[slot].process == p {
                        if prev == 0 {
                            WAITERS[w].blocked = next
                        } else {
                            THREADS[prev - 1].link = next
                        }
                        THREADS[slot].link = 0
                    } else {
                        prev = cur
                    }
                    cur = next
                }
            },
            // Nothing parks on an invalid Waiter: the invalidation emptied the
            // list and every later `Wait` answers `Revoked`.
            case Invalid -> {},
            case Free -> {},
        }
        w = w + 1
    }
}

/// Park the running thread on `w`'s blocked list, remembering where its record
/// goes. `dst` has already been through `copy_out_check`.
public(package) func block_on_wait(slot: Int, w: Int, dst: UInt) unsafe {
    THREADS[slot].state = ThreadState.Blocked
    THREADS[slot].wait_buf = dst
    THREADS[slot].link = WAITERS[w].blocked
    WAITERS[w].blocked = slot + 1
    NEED_RESCHED = true
}

// -----------------------------------------------------------------------------
// The fused call's two parks
// -----------------------------------------------------------------------------
//
// Neither puts the thread on a list, unlike `block_on_wait` above. A
// `Waiter.Wait` parks on an object several threads may share, so the Waiter
// keeps a chain of them. A fused `PipeInlet.Call` parks on something at most
// one thread can be waiting for, the exchange it just staged, so the back
// pointer is the list (of one) and lives in `Exchange.caller`, where a settling
// reply already has the index.
//
// The room park has no back pointer, and the wake finds the thread by scan.
// Several threads of one process may wait for room on one connection, so the
// connection would need a chain, and `ThreadSlot.link` is already used by the
// ready queue the resumed thread goes straight onto. A bounded walk of the
// thread slab at the moment a ring stops being full is the cheaper answer, the
// same trade `alloc_thread`, `live_threads` and `ready_remove_process` make.

/// Park the running thread until connection `c` has room to stage: the fused
/// `Call`'s first park.
///
/// `src`/`len` are the message the caller has not staged yet, and `dst` is
/// where its reply will go. Both addresses were validated at the call, while
/// the caller was the running process.
public(package) func block_on_call_room(slot: Int, c: Int, src: UInt, len: UInt,
                                        dst: UInt) unsafe {
    THREADS[slot].state = ThreadState.Blocked
    THREADS[slot].wait_buf = dst
    THREADS[slot].call_pipe = c + 1
    THREADS[slot].call_claim = 0
    THREADS[slot].call_src = src
    THREADS[slot].call_len = len
    NEED_RESCHED = true
}

/// Tie thread `slot` to exchange `x` and stop it: the fused `Call`'s second
/// park, the one that holds the claim.
///
/// The caller has already taken the exchange's reply reference; this records
/// the tie in both directions and marks the thread blocked.
///
/// It does not request a reschedule, which is why it is split from
/// `block_on_call_reply`. It is reached by the op, which is the thread being
/// parked and wants one, and by the room resume, which runs in whichever thread
/// freed the slot and must not preempt itself for somebody else's park.
public(package) func tie_call_reply(slot: Int, x: Int, dst: UInt) unsafe {
    THREADS[slot].state = ThreadState.Blocked
    THREADS[slot].wait_buf = dst
    THREADS[slot].call_pipe = 0
    THREADS[slot].call_claim = x + 1
    THREADS[slot].call_src = 0
    THREADS[slot].call_len = 0
    EXCHANGES[x].caller = slot + 1
}

/// The running thread's version: tie, and request the switch it now needs.
public(package) func block_on_call_reply(slot: Int, x: Int, dst: UInt) unsafe {
    tie_call_reply(slot, x, dst)
    NEED_RESCHED = true
}

/// Forget everything about a thread's fused call: the state, both directions of
/// the tie, and the buffer. It does not touch the reference the claim held;
/// each caller owns that decision.
public(package) func clear_pending_call(slot: Int) unsafe {
    if THREADS[slot].call_claim != 0 {
        EXCHANGES[THREADS[slot].call_claim - 1].caller = 0
    }
    THREADS[slot].call_pipe = 0
    THREADS[slot].call_claim = 0
    THREADS[slot].call_src = 0
    THREADS[slot].call_len = 0
    THREADS[slot].wait_buf = 0
}

/// The thread waiting for room on connection `c`, or `NO_THREAD`.
///
/// This is the scan the park comment above describes. It answers the
/// lowest-indexed waiter rather than the longest-waiting one, the same fairness
/// the ready queue's slot ordering has.
public(package) func call_room_waiter(c: Int) unsafe -> Int {
    var t: Int = 0
    while t < THREADS.capacity() {
        if THREADS[t].call_pipe == c + 1 {
            return t
        }
        t = t + 1
    }
    NO_THREAD
}

/// The attachment on `w` under `key`, or `NO_ATTACHMENT`.
///
/// The key is the attachment's name, so the set is a table keyed by it rather
/// than a bag: `Remove` names an attachment this way, and `Add` uses the same
/// walk to refuse a duplicate. Both rest on keys being unique per Waiter.
public(package) func attached_by_key(w: Int, key: UInt) unsafe -> Int {
    var cur = WAITERS[w].attached
    while cur != 0 {
        let a = cur - 1
        if ATTACHMENTS[a].key == key {
            return a
        }
        cur = ATTACHMENTS[a].link
    }
    NO_ATTACHMENT
}

/// Take attachment `a` off waiter `w`'s list, clear the waitable's back
/// pointer, and return the slot to the slab. The caller has established that it
/// is on that list.
public(package) func detach_attachment(w: Int, a: Int) unsafe {
    var prev: Int = 0
    var cur = WAITERS[w].attached
    while cur != 0 {
        let slot = cur - 1
        let next = ATTACHMENTS[slot].link
        if slot == a {
            if prev == 0 {
                WAITERS[w].attached = next
            } else {
                ATTACHMENTS[prev - 1].link = next
            }
            set_waitable_attachment(ATTACHMENTS[a].kind, ATTACHMENTS[a].target, 0)
            ATTACHMENTS[a] = Attachment(state: SlotState.Free,
                                        kind: WaitableKind.Event, target: 0,
                                        waiter: 0, key: 0, oneshot: false,
                                        owns: false, link: 0)
            return
        }
        prev = cur
        cur = next
    }
}

/// The Interrupt bound to `line`, or `NO_INTERRUPT`.
///
/// A scan, which turns the trap path's line number back into an object. A
/// separate line-to-slot map would be a second description of the same fact:
/// the bindings are already in the table, and `interrupt_bind` refuses a double
/// bind using this same walk.
public(package) func interrupt_by_line(line: UInt) unsafe -> Int {
    var i: Int = 0
    while i < INTERRUPTS.capacity() {
        match INTERRUPTS[i].state {
            case Live -> {
                if INTERRUPTS[i].line == line {
                    return i
                }
            },
            case Free -> {},
        }
        i = i + 1
    }
    NO_INTERRUPT
}
