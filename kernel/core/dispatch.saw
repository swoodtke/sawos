// The teardown and the two fault reports moved UP here with the scheduler when
// a process's death became a scheduling event (sawos design 2 D-6). Every call
// site below is unchanged — a fault still terminates and still never returns —
// and `sched.saw`'s header holds the argument for why the altitude moved.
import kcore.sched.{
    end_process,
    exit_thread,
    fault_process,
    fault_trap,
    pick_next,
}

/// The System object's ops (§2). Returns a status; `shutdown` does not return
/// at all.
///
/// `op` arrives as the raw register word, which a process chooses, so it is
/// DECODED rather than compared: `SystemOp.from(raw:)` accepts exactly the numbers
/// that are ops and hands back `None` for every other, which is both the range
/// check and the dispatch in one step. The `match` is then exhaustive, so adding
/// an op to `sosabi` makes this function fail to compile until it is handled —
/// which is what the old `op > OP_SYSTEM_MAX` test could never do.
///
/// AN UNKNOWN OP AND A MISSING RIGHT BOTH TERMINATE THE PROCESS (design 178's
/// faults ruling). Both are mistakes the caller could have checked: it chose
/// the number, and it knows which rights it holds.
///
/// `arg1` arrives because `ProcessCreate` takes two Memory handles (design 2's
/// RIDER). Every other System op reads `arg0` alone, exactly as before.
func system_op(raw_op: UInt, obj: &SystemObject,
               arg0: UInt, arg1: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = SystemOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return system_op_decoded(op, &obj, arg0, arg1, p)
}

func system_op_decoded(op: SystemOp, obj: &SystemObject, arg0: UInt, arg1: UInt,
                       p: Int) unsafe -> SyscallResult {
    match op {
        // The rights check is per-OP, not per-object: holding the System
        // handle is not the same as being allowed to use every part of it.
        case DebugPrint -> {
            if not obj.allows(SystemRight.Debug) {
                fault_process(p, FaultReason.AccessDenied)
            }
            hal.console_byte((arg0 & BYTE_MASK) as UInt8)
            op_ok()
        },
        // Stop the machine with `arg0` as the status. NOT process exit, which
        // is `ProcessOp.Exit` — this is the whole machine, and it is what the
        // harness kernels with no Process object still use to finish a run.
        case Shutdown -> {
            if not obj.allows(SystemRight.Shutdown) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if arg0 == 0 {
                hal.exit_pass()
            } else {
                hal.exit_fail(arg0)
            }
            op_ok()
        },
        // §3's derivation rule, made real: the boot handle set is one handle
        // wide and everything else is obtained THROUGH it. A process asks the
        // System object which Process it is, and the Process object which
        // Thread — so the kernel never has to widen the entry register, and a
        // process that was given no System handle has no way to name either.
        // **IT MINTS A FRESH HANDLE EVERY ASK** (sawos design 3 D-4). It used
        // to read a word cached on the process slot, which said "a process has
        // one Process handle" — and that is not what §3 guarantees. What §3
        // forbids is AMPLIFICATION: a mint carries the kind's DEFAULT rights and
        // the minting is itself gated (`ProcessSelf`, right here), so a caller asking
        // twice gets two capability INSTANCES of exactly the authority it
        // already had. Instances are the point — each is independently held and
        // independently released, which is what an owning wrapper is an owner
        // OF, and the cached word could not have been released by anybody.
        //
        // The default set is `process_rights()`, and there is exactly ONE —
        // root's, a process's own, and a child's are the same list since the
        // Aug-29 doctrine left nothing distinguishing them (see `sosabi`). What
        // a CHILD gets narrower than that is now a launcher's KEEP MASK at
        // `MINT_OP` rather than a second default set.
        //
        // IT CAN NOW FAIL, which the cached read could not: a full handle table
        // is `NoResource`, a thing the caller could not have known. Unit 5 is
        // where that gets a quota row.
        case ProcessSelf -> {
            if not obj.allows(SystemRight.ProcessSelf) {
                fault_process(p, FaultReason.AccessDenied)
            }
            let handle = mint_handle(p, ObjType.Process, process_rights(), p)
            if handle == NO_HANDLE {
                return op_status(mint_refusal(p))
            }
            // A SECOND NAME FOR THE SAME SLOT IS A SECOND REFERENCE (sawos
            // design 7 D-1), and it is what makes a process asking for itself
            // twice cost something the ledger can see.
            ref_object(ObjType.Process, p)
            op_value(handle)
        },
        // TIME IS A GRANTED CAPABILITY (design 232 unit 1, the M3 time notes).
        // A process that was not given this right cannot read the machine's
        // clock at all — which is what makes handing a child a VIRTUAL clock
        // over IPC a substitution rather than a rewrite, since a child holding
        // no kernel Clock has no second way to ask.
        case ClockGet -> {
            if not obj.allows(SystemRight.ClockGet) {
                fault_process(p, FaultReason.AccessDenied)
            }
            clock_get(p, arg0)
        },
        // PHASE ONE OF THE TWO-PHASE LIFECYCLE (sawos design 2 D-4; the
        // RECEIVER ruled Aug 29 by design 2's RIDER). It is asked of the
        // SYSTEM object, because a process is a machine-wide resource:
        // process-scoped objects are minted by your Process, and PROCESSES ARE
        // MINTED BY THE SYSTEM. `ProcessSelf` above is the precedent — a
        // Process handle has always come out of this object.
        //
        // It is the first System op to read a SECOND argument, which is why
        // this decoder takes `arg1` at all. Both are Memory HANDLES, and they
        // spend no `MemoryRight` of their own — they are the operation's
        // arguments, not a second authority (see `memory_arg`).
        case ProcessCreate -> {
            if not obj.allows(SystemRight.ProcessCreate) {
                fault_process(p, FaultReason.AccessDenied)
            }
            process_create(p, arg0, arg1)
        },
    }
}

/// Hand process `p` its Clock for the domain `raw_type` names (§2's Clock row).
///
/// The DOMAIN arrives as a raw register word the process chose, so it is decoded
/// rather than trusted, on `event_create`'s precedent exactly: a number that is
/// not a `ClockType` is a caller error the process could have checked, which
/// under design 178's faults ruling ends it. v1 declares one domain, so every
/// number but zero lands here.
func clock_get(p: Int, raw_type: UInt) unsafe -> SyscallResult {
    guard let type = ClockType.from(raw: raw_type) else { fault_process(p, FaultReason.BadArg) }
    return clock_get_typed(p, type)
}

/// THERE IS NOTHING TO CREATE, which is what makes this a getter rather than a
/// factory (amended Aug 17, user) — and **PURE MINTING**, which is what makes it
/// mint-per-call (sawos design 3 D-4).
///
/// The object already exists — one kernel-eternal Clock per domain, live since
/// boot — so this op only ever mints a HANDLE onto a well-known slot. The
/// find-or-create scan it opened with is gone with the per-process object it was
/// scanning for; the by-kind scan of the handle table that REPLACED it
/// (`clock_handle_of`) is gone too, and with it the tree's only walk of
/// `HANDLES` looking for a kind.
///
/// **ASKING TWICE ANSWERS TWO DIFFERENT HANDLES ONTO ONE CLOCK**, which
/// supersedes this function's own "same handle every ask" and is not a hole in
/// §3. The no-duplicate rule's real invariant was never uniqueness, it was NO
/// AMPLIFICATION: every mint carries the kind's DEFAULT rights and the minting
/// is gated by `SystemRight.ClockGet` on the System handle the caller already
/// holds, so a second ask hands out a second INSTANCE of an authority already
/// held and never a wider one. Attenuating a handle you give away stays
/// meaningful exactly where it always was — when the receiver lacks its own
/// minting authority, which for the clock is the process with `ClockGet`
/// stripped.
///
/// **`NoResource` IS REACHABLE ON REPETITION NOW.** A process that asks
/// sixteen times fills its handle table, and a full table is a thing the caller
/// could not have known, so it stays a status rather than becoming a fault. That
/// is precisely what earns this op a quota row in unit 5.
func clock_get_typed(p: Int, type: ClockType) unsafe -> SyscallResult {
    let slot = clock_slot(type)
    // NO REFERENCE IS COUNTED, and no quota row is charged for the OBJECT: a
    // Clock is kernel-eternal and owned by nobody (design 7 D-1's exemption).
    // What a repeated ask does cost is a HANDLE, and that row is charged inside
    // `mint_handle` — which is what unit 5 owed this op's `NoResource` path.
    let handle = mint_handle(p, ObjType.Clock, clock_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    op_value(handle)
}

/// The Process object's ops (§2, §7, §8; design 178 D4).
func process_op(raw_op: UInt, obj: &ProcessObject,
                arg0: UInt, arg1: UInt, arg2: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = ProcessOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return process_op_decoded(op, &obj, arg0, arg1, arg2, p)
}

func process_op_decoded(op: ProcessOp, obj: &ProcessObject,
                        arg0: UInt, arg1: UInt, arg2: UInt,
                        p: Int) unsafe -> SyscallResult {
    match op {
        case ThreadCreate -> {
            if not obj.allows(ProcessRight.ThreadCreate) {
                fault_process(p, FaultReason.AccessDenied)
            }
            thread_create(obj.slot, arg0, arg1, arg2)
        },
        // MINT-PER-CALL, exactly as `ProcessSelf` above (sawos design 3 D-4):
        // the cached word on the thread slot is gone, the default rights are
        // `thread_rights()`, and `ThreadSelf` on the PROCESS handle is what
        // gates the derivation — a bit named for its op since the Aug-29
        // doctrine retired the generic `Manage` it used to borrow. A full table
        // is `NoResource` — reachable now, where reading a cached word never
        // was.
        case ThreadSelf -> {
            if not obj.allows(ProcessRight.ThreadSelf) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if CURRENT_THREAD == NO_THREAD {
                fault_process(p, FaultReason.BadState)
            }
            let handle = mint_handle(p, ObjType.Thread, thread_rights(),
                                     CURRENT_THREAD)
            if handle == NO_HANDLE {
                return op_status(mint_refusal(p))
            }
            op_value(handle)
        },
        // Spec §5.7, ratified Aug 5: process exit belongs HERE and not on the
        // System object. Every thread of the process goes with it (§8's
        // teardown is unconditional), so this never returns.
        case Exit -> {
            if not obj.allows(ProcessRight.Exit) {
                fault_process(p, FaultReason.AccessDenied)
            }
            // `end_process` stops the machine, so this arm diverges and owes
            // the `match` no value.
            end_process(obj.slot, ProcessStatusKind.Exited, arg0, arg0)
        },
        // §8's ONE fixed-width status word: kind in the high bits, code in the
        // low ones. A process asking about itself always reads `Running`, which
        // is the honest answer and the only one M2 can produce — the interesting
        // reader is a supervisor holding somebody else's handle, and that needs
        // the second process M3 loads.
        case GetStatus -> {
            if not obj.allows(ProcessRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            op_value(process_status_word(PROCESSES[obj.slot].exit_kind,
                                      PROCESSES[obj.slot].exit_code))
        },
        // The creation authority for §2's plain objects, answering spec §12's
        // open pin the way `ThreadCreate` already does: it flows through a
        // handle the process holds, so it is §3's derivation rule rather than a
        // new mechanism beside it. See `ProcessRight`.
        case EventCreate -> {
            if not obj.allows(ProcessRight.EventCreate) {
                fault_process(p, FaultReason.AccessDenied)
            }
            event_create(obj.slot, arg0)
        },
        case WaiterCreate -> {
            if not obj.allows(ProcessRight.WaiterCreate) {
                fault_process(p, FaultReason.AccessDenied)
            }
            waiter_create(obj.slot)
        },
        // Binding an IRQ line is the strongest of the creation authorities, and
        // it flows through the same handle for the same reason: the Process
        // object is what an Interrupt is charged to, and a bit is what a
        // launcher strips from everything that is not a driver.
        case InterruptBind -> {
            if not obj.allows(ProcessRight.InterruptBind) {
                fault_process(p, FaultReason.AccessDenied)
            }
            interrupt_bind(obj.slot, arg0)
        },
        // PHASE TWO of the two-phase lifecycle, and it is asked of the CHILD's
        // handle — `obj.slot` is the process being started, not the caller. That
        // is what the bare verb in the op's name says (the receiver IS the
        // object), and it is why the right is minted on the handle
        // `process_create` hands back rather than held by the launcher in
        // advance. PHASE ONE is `SystemOp.ProcessCreate`, one object over: a
        // process is a machine-wide resource, so the System object is what mints
        // one (sawos design 2's RIDER, ruled Aug 29).
        //
        // `arg0` IS THE BOOT-TAG FORM AND `arg1` THE TAG (sawos design 4 D-4).
        // Two registers rather than one because ZERO IS A LEGITIMATE TAG —
        // root's region ordinal 0 exists today — so "no tag" cannot be a value
        // of the tag; see `BootTagForm`.
        case Start -> {
            if not obj.allows(ProcessRight.Start) {
                fault_process(p, FaultReason.AccessDenied)
            }
            process_start(p, obj.slot, arg0, arg1)
        },
        // §12's boot set, drained one record at a time. It is asked of the
        // process's OWN handle: the set belongs to the process it was minted
        // FOR, so `obj.slot` and the caller are the same process by the time the
        // right check has passed. **THE SET IS PER-PROCESS SINCE UNIT 3** (sawos
        // design 4 D-2), so `p` below reads the CALLER's own records — root's,
        // written by the kernel at boot, or a child's, written by its launcher's
        // gives — and the op is one drain over two producers.
        case BootHandleNext -> {
            if not obj.allows(ProcessRight.BootHandles) {
                fault_process(p, FaultReason.AccessDenied)
            }
            boot_handle_next(p, arg0, arg1)
        },
        // **THE COURIER OP** (sawos design 4). It is asked of the CHILD's handle
        // — `obj.slot` is the process being furnished — which is why it keeps
        // the bare verb, and it is gated on `ProcessRight.Give` on that handle
        // — "may place handles into this child's boot set", an authority with
        // its own name since the Aug-29 doctrine (an earlier cut borrowed the
        // generic `Manage`, which is exactly the borrowing the doctrine
        // refuses). It sits BESIDE `Start` rather than inside it because the two
        // are separable: a supervisor may run and watch a child without being
        // allowed to furnish it. The OTHER gate is on the handle being GIVEN and
        // is the ruling's own: the universal `Transfer` bit, checked inside
        // `process_give` where the entry is known and the kind is not.
        case Give -> {
            if not obj.allows(ProcessRight.Give) {
                fault_process(p, FaultReason.AccessDenied)
            }
            process_give(p, obj.slot, arg0, arg1)
        },
    }
}

// -----------------------------------------------------------------------------
// process_create / start / boot_handle_next (sawos design 2 D-3, D-4, D-7)
// -----------------------------------------------------------------------------

/// Resolve a handle the caller passed as a REGION, or terminate it.
///
/// A handle that names nothing, or names something that is not a Memory, is a
/// caller error in the strongest sense — the process was handed these handles
/// and chose which to pass — so it is a fault and not a `BadImage` status. The
/// line design 2 draws is between the HANDLE (authority, caller-checkable) and
/// the BYTES (data, reported), and this function is where it falls.
///
/// NO `MemoryRight` IS SPENT. The authority to create a process is
/// `SystemRight.ProcessCreate` on the caller's System handle (design 2's RIDER,
/// ruled Aug 29), already checked; these two are the operation's ARGUMENTS —
/// which is exactly why that ruling could move the authority to another object
/// without touching a line below this comment. Unit 3's `give` and unit 4's
/// `Split`/`Map` are the ops that DO ask what a holder may do with a region,
/// through the wrapper this one builds and does not question
/// (`MemoryObject.allows`).
func memory_arg(p: Int, handle: UInt) unsafe -> Int {
    let entry = lookup_handle(p, handle)
    match entry.obj_type {
        case Memory -> {
            let mem = MemoryObject(handle: MemoryHandle(handle),
                                   rights: entry.rights, slot: entry.target)
            mem.slot
        },
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case _ -> fault_process(p, FaultReason.BadHandle),
    }
}

/// Would `[base, base + len)` run past the end of the address space?
///
/// Asked BEFORE the addition, exactly as every other bound in the loader is:
/// overflow checks are always on, so an unchecked `base + len` on a region the
/// build emitted wrong would be a panic from inside the kernel rather than a
/// refusal the caller can report.
func region_wraps(base: UInt, len: UInt) -> Bool {
    len > UInt.max - base
}

/// §2's `process_create(image:memory:)` — the second address space.
///
/// **EVERYTHING IS VALIDATED BEFORE THE FIRST BYTE MOVES**, which is the boot
/// loader's phase discipline and is what makes a refusal harmless: a caller
/// that gets `BadImage` back has a destination region exactly as it left it.
/// The slot and the handle are taken before the copy too, so the one failure
/// that is not about the image — a full table — also leaves the bytes alone.
///
/// The three things `process_create` decides that the boot path does not:
///
///   - THE DESTINATION IS THE CALLER'S, not a HAL constant. Root supplies two
///     capabilities and no numbers; the stack is still the KERNEL's grant at the
///     region's top, which is root's own loader rule applied to a child.
///   - DEVICE WINDOWS ARE REFUSED (`allow_device: false`). See `check_segment`.
///   - THE TWO REGIONS MUST BE DISJOINT, which also refuses the same Memory
///     passed twice. Overlap ACROSS separate creates is deliberately not
///     policed: regions are capabilities, the region table is build-emitted
///     disjoint, and root double-spending what it holds corrupts only what it
///     holds. Unit 4's pools made a region DIVISIBLE without making it
///     accounted; unit 5 added the accounting there is — a per-process QUOTA
///     ROW per kind and free-on-last-reference on the slab slot — and it
///     counts OBJECTS, so overlap across creates is no more policed now than
///     it was. Byte accounting waits for a real allocator (M4+).
func process_create(p: Int, image_handle: UInt,
                    memory_handle: UInt) unsafe -> SyscallResult {
    let img = memory_arg(p, image_handle)
    let dst = memory_arg(p, memory_handle)

    let img_base = MEMORIES[img].base
    let img_len = MEMORIES[img].len
    let dst_base = MEMORIES[dst].base
    let dst_len = MEMORIES[dst].len

    if region_wraps(img_base, img_len) || region_wraps(dst_base, dst_len) {
        return op_status(SosStatus.BadImage)
    }
    // A destination that cannot even hold the kernel's stack grant is refused
    // here rather than by an underflow inside `LoadRegion`'s arithmetic.
    if dst_len <= hal.ROOT_STACK_LEN {
        return op_status(SosStatus.BadImage)
    }
    if img_base < dst_base + dst_len && dst_base < img_base + img_len {
        return op_status(SosStatus.BadImage)
    }

    // ONE STACK LENGTH SERVES BOTH PROCESSES in v1 (sawos design 2 D-4). A
    // per-create length is unit 4/5 vocabulary — it is a quota question, and
    // inventing an argument for it now would be an ABI to keep.
    let dest = LoadRegion(base: dst_base, top: dst_base + dst_len,
                          stack_len: hal.ROOT_STACK_LEN)
    if let _ = validate_image(img_base, img_len, &dest, false) {
        return op_status(SosStatus.BadImage)
    }

    let slot = alloc_process()
    if slot == NO_PROCESS {
        return op_status(SosStatus.NoResource)
    }
    // THE CHILD'S FIRST HANDLE, and unit 2's "unit 3 revisits" note is
    // RESOLVED: it is `process_rights()`, the one Process default set (sawos
    // design 4 D-3, collapsed by the Aug-29 doctrine). A LAUNCHER KEEPS THIS
    // HANDLE — it is what it supervises the child with — and the child derives
    // its own from the masked System handle it was given, exactly as root does
    // at boot. So the width here is not what a child receives; it is what a
    // launcher holds, and what it hands on is a keep mask's business.
    let handle = mint_handle(p, ObjType.Process, process_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }

    // Only now does anything happen to the destination region.
    let rw_base = place_image(slot, img_base, &dest)

    PROCESSES[slot].state = ProcessState.Created
    // A CHILD'S TABLE STARTS EMPTY AND `give` IS WHAT FILLS IT (sawos design 4).
    // There is nothing to record here: mint-per-call means a process's own
    // Process handle is minted when it is asked for, and a child cannot ask —
    // `ProcessSelf` needs a System handle it has not been given. So every handle
    // a child ever holds arrives through `ProcessOp.Give` between this call and
    // `Start`, and a child that was given nothing is still the ruled
    // "legal-but-doomed" sandboxed compute process, which is a FEATURE.
    PROCESSES[slot].entry = image_entry(img_base)
    PROCESSES[slot].stack_top = dest.top
    PROCESSES[slot].region_base = dest.base
    PROCESSES[slot].region_top = dest.top
    PROCESSES[slot].rw_base = rw_base
    PROCESSES[slot].rw_top = dest.top
    PROCESSES[slot].exit_kind = ProcessStatusKind.Running
    PROCESSES[slot].exit_code = 0
    // THE LAUNCHER'S HANDLE IS THE CHILD'S FIRST REFERENCE, and it is the one
    // design 3 D-3 has always been about: it outlives the child so that reading
    // how the child died stays possible, and its release is what frees the slot.
    PROCESSES[slot].refs = 1
    // NOBODY IS WATCHING A PROCESS THAT DOES NOT EXIST YET (sawos design 8).
    // Written for `refs`' own reason rather than as belt-and-braces: this slot
    // may be a RECLAIMED one (design 3 D-3), and every other field a previous
    // occupant wrote is reset on these lines too. It cannot arrive non-zero —
    // an attachment is a counted reference, so a watched slot never reaches
    // zero and never reclaims — but the reset is where a reader looks to find
    // that out.
    PROCESSES[slot].attachment = 0

    // **THE CHILD'S LEDGER OPENS HERE, AFTER `place_image`** (sawos design 7
    // D-3), and the order is what the mapping row needs: `free_rows` is what
    // this child's domain has left once its image has spent its own, and the
    // image's rows are recorded by the call above. A child gets
    // `kcore.limits`' documented defaults; nothing about them is a per-create
    // argument, which is an ABI unit 5 deliberately did not open.
    install_quota_limits(slot, false,
                         (hal.GRANT_ROW_BUDGET as Int) - PROCESSES[slot].grant_count)

    op_value(handle)
}

/// §2's `start(boot_tag:)` — phase two, and the whole of it.
///
/// It MINTS THE FIRST THREAD INTERNALLY and hands out no handle for it: nobody
/// holds a child's thread, and what a child receives is what `give` put in its
/// table. The entry and the stack come out of the process slot, recorded at
/// create, so **root supplies neither** — which is what keeps "root never
/// parses" airtight (sawlang#232 unit 2, ruled Aug 16).
///
/// **THE KERNEL RESOLVES THE TAG TO THE CHILD-SIDE WORD** (sawos design 4), so
/// `_start(boot_handle)` is unchanged from M2 and root never sees a
/// child-relative word at any point. That is the whole reason the resolution is
/// here rather than in the give's return: the give answers with a STATUS ALONE
/// because the word it minted means nothing to the giver, and the one place it
/// does mean something is the register the child wakes up with.
///
///   - `BootTagForm.Absent` keeps unit 2's `NO_HANDLE` in a0. The sandboxed
///     compute process stays a FEATURE, not an error to detect, and every
///     existing `start()` caller is this form.
///   - `BootTagForm.Present` resolves `tag` against the child's boot set. A tag
///     that names no given record is a `BadArg` FAULT — config error, and the
///     caller is the one that chose both the tag it gave and the tag it started
///     with.
///   - **RESOLUTION CONSUMES THE RECORD** (the Aug-29 user ruling). Putting the
///     word in the child's first argument register IS the delivery, so the drain
///     never answers with a word the child already holds. That is what makes
///     "a child cannot be handed one word twice" a property of the kernel rather
///     than an obligation on the child: two live wrappers over one word would be
///     two releases, and the second a fault the program did nothing to deserve.
///
/// **THE LAUNCH FLOW IS MINT -> GIVE -> START, and `Start` does one thing.** A
/// launcher mints a MASKED SIBLING of its own System handle (`MINT_OP` with a
/// keep mask), GIVES the sibling under a tag, and STARTS the child naming that
/// tag — keeping the child's Process handle throughout, so it retains
/// supervision (`get_status`, and unit 5.5's death-wait) while the child holds
/// its own authority. Both at once, which is what the mint bought.
///
/// **AND THE CHILD BOOTSTRAPS EXACTLY AS ROOT DOES** (§12's symmetry): a System
/// handle in the first argument register, its own Process handle derived through
/// its own `ProcessSelf` right, its boot set drained from there. The kernel has
/// ONE way in for
/// every process, which is the same claim §12's loader-above-boot rule makes
/// about images. An implementation of design 4 briefly folded a handle transfer
/// into this op, because with only ONE Process handle per child a launcher that
/// gave it away had nothing left to start with; the Aug-29 rulings dissolved
/// that by making a second handle mintable, and the fold went with it.
///
/// **ROOT KEEPS RUNNING.** The thread goes on the ready queue and the caller
/// returns normally; the child runs when the scheduler next picks it, which is
/// the same contract `Thread.start` has.
///
/// A SECOND START IS A `BadState` FAULT (ruled). The state word is what makes
/// that checkable, and the caller could have known: it is the one that started
/// it the first time. THE SAME WORD FREEZES THE BOOT SET — a give after this
/// point is the same `BadState` — which is the give-before-start ordering that
/// makes a half-populated table unrepresentable.
func process_start(caller: Int, child: Int,
                   raw_form: UInt, tag: UInt) unsafe -> SyscallResult {
    // The FORM arrives as a raw register word the process chose, so it is
    // decoded rather than trusted, on `event_create`'s and `clock_get`'s
    // precedent exactly: a number that is not a `BootTagForm` is a caller error
    // the process could have checked.
    guard let form = BootTagForm.from(raw: raw_form) else {
        fault_process(caller, FaultReason.BadArg)
    }
    match PROCESSES[child].state {
        case Created -> {},
        case _ -> fault_process(caller, FaultReason.BadState),
    }

    // The statuses this op can answer with, taken BEFORE the record is consumed
    // so that a refusal leaves the boot set exactly as it was. `alloc_thread`
    // is a pure scan and reserves nothing, so an early return here leaks no
    // slot either.
    //
    // **THE THREAD IS THE CHILD'S, SO THE CHILD IS CHARGED** (sawos design 7
    // D-3's creator-pays, read carefully): the launcher is not spending one of
    // its own threads, it is spending the first of the child's. That is the
    // same rule every other row follows — the slot's `process` field is who
    // pays — applied at the one site where the slot is written for somebody
    // else.
    if not quota_room(child, QuotaKind.Thread) {
        return op_status(SosStatus.QuotaExceeded)
    }
    let slot = alloc_thread()
    if slot == NO_THREAD {
        return op_status(SosStatus.NoResource)
    }

    let boot_word = match form {
        case Absent -> NO_HANDLE,
        case Present -> {
            let w = boot_handle_take(child, tag)
            if w == NO_HANDLE {
                fault_process(caller, FaultReason.BadArg)
            }
            w
        },
    }

    hal.frame_init(frame_slot(slot), PROCESSES[child].entry,
                   PROCESSES[child].stack_top, boot_word)
    THREADS[slot] = ThreadSlot(state: ThreadState.Runnable, process: child,
                               exit_code: 0,
                               joiners: 0, link: 0, wait_buf: 0)
    quota_charge(child, QuotaKind.Thread)
    ready_push(slot)
    PROCESSES[child].state = ProcessState.Running
    op_ok()
}

/// Which `BootHandleKind` a given handle's `ObjType` is delivered as, or `None`
/// when the boot record has no spelling for it.
///
/// **THE ONE PLACE THE KERNEL-INTERNAL KIND AND THE PUBLIC ONE MEET** (sawos
/// design 4). `ObjType` is renumberable bookkeeping and `BootHandleKind` crosses
/// the trap boundary, so neither is a cast of the other; this function is the
/// translation, written out, and it is deliberately PARTIAL. The kinds it cannot
/// spell are exactly the kinds nothing mints `Transfer` on today — a Thread,
/// Event, Waiter, Interrupt, Clock or Timer handle never reaches here, because
/// the `Transfer` check above refuses it first. The arm exists so that the day a
/// kind becomes givable, the compiler asks for its record spelling instead of
/// letting it arrive mis-tagged.
func boot_kind_of(kind: ObjType) -> BootHandleKind? {
    match kind {
        case Memory -> BootHandleKind.Memory,
        case Process -> BootHandleKind.Process,
        case System -> BootHandleKind.System,
        // **UNIT 4'S ARM, AND IT IS THE ARM THE COMMENT ABOVE PREDICTED**
        // (sawos design 6 D-1): `iomemory_rights()` mints `Transfer`, so a
        // window can travel, so the record needs a spelling for one. A Mapping
        // stays in the `None` arm on purpose — `mapping_rights()` withholds
        // `Transfer`, so the `Transfer` check above refuses one first and this
        // spelling would be dead surface.
        case IoMemory -> BootHandleKind.IoMemory,
        case _ -> None,
    }
}

/// §2's `give(handle, tag:)` — **UNBIND AND REBIND, RIGHTS VERBATIM** (sawos
/// design 4 D-1), and the whole of the launch flow's furnishing half.
///
/// A GIVE IS A MOVE, NOT A MINT. The fresh entry in the child's table carries the
/// SAME kind, the SAME target and the SAME rights word as the caller's did — no
/// default set is consulted and nothing amplifies, so what root attenuated stays
/// attenuated — and since the Aug-29 rulings a launcher ATTENUATES BEFORE IT
/// GIVES, by minting a masked sibling (`MINT_OP`) and giving that. The two ops
/// divide cleanly: mint narrows a capability inside one table, give moves one
/// between two. The caller's
/// entry unbinds exactly as a release does, GENERATION BUMP INCLUDED, so the
/// giver's word is stale the instant the op returns and its later use is the
/// diagnosed `BadHandle` fault design 3's generations exist to draw.
///
/// **THE ORDER OF CHECKS IS THE CONTRACT**: every FAULT first, then the capacity
/// STATUS, then the move. A fault leaves both tables unchanged by definition, and
/// the capacity refusal is ordered so that it too leaves the caller's entry
/// exactly as it was — the mint into the child happens BEFORE the unbind for
/// precisely that reason, so a full child table is a give that did not happen
/// rather than a capability lost between two tables.
///
///   - the given handle must RESOLVE — `BadHandle`, the ordinary one.
///   - it must carry the universal `Transfer` bit — `AccessDenied`. This is the
///     ruling's own gate and the first consumer §3's universal low byte has ever
///     had. It is checked HERE, where the entry is known and the kind is not,
///     which is the same altitude `RELEASE_OP` is intercepted at.
///   - the child must still be `Created` — `BadState`. **THE BOOT SET FREEZES AT
///     START**, and that ordering IS the soundness argument: a child's boot
///     handles must answer completely at its first instruction, and start is the
///     barrier that makes a half-populated table unrepresentable with no
///     synchronization invented. Dynamic transfer is M4 IPC's job, over pipes, to
///     a process expecting it.
///   - the tag must be UNUSED in the child's set — `DuplicateKey`. An identity
///     naming two handles is broken config, caller-checkable, and it would make
///     the record a multimap and the boot lookup ambiguous.
///   - a full child table (or boot set) is `NoResource`, a STATUS, because a
///     dynamic resource running out is exactly what a caller could not have
///     known.
///
/// GIVING TO YOURSELF NEEDS NO SPECIAL CASE and is refused by the state check: a
/// running process is not `Created`, so `give` through your own Process handle is
/// the same `BadState` a give after start is.
func process_give(p: Int, child: Int, word: UInt, tag: UInt) unsafe -> SyscallResult {
    let entry = lookup_handle(p, word)
    let kind = give_faults(p, child, entry, tag)
    if not boot_handle_room(child) {
        return op_status(SosStatus.NoResource)
    }
    let given = move_handle(p, child, word, entry, kind, tag)
    if given == NO_HANDLE {
        // The child's table refused it — either because it is full, or because
        // the CHILD is at its handle budget, which is the answer a launcher
        // furnishing too much needs to hear (sawos design 7 D-3).
        return op_status(mint_refusal(child))
    }
    op_ok()
}

/// Every FAULT a transfer of `entry` into `child` under `tag` can raise, in
/// D-1's order, answering the record kind the move will use. Never returns on a
/// fault; touches nothing on any path.
///
/// It is split out of `process_give` rather than inlined so that the FAULT SET
/// and the EFFECT read as the two separate things D-1 orders them as: everything
/// here happens before anything below `move_handle` touches a table.
func give_faults(p: Int, child: Int, entry: HandleEntry,
                 tag: UInt) unsafe -> BootHandleKind {
    match entry.obj_type {
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case _ -> {},
    }
    if not rights_allow_transfer(entry.rights) {
        fault_process(p, FaultReason.AccessDenied)
    }
    guard let kind = boot_kind_of(entry.obj_type) else {
        fault_process(p, FaultReason.BadArg)
    }
    match PROCESSES[child].state {
        case Created -> {},
        case _ -> fault_process(p, FaultReason.BadState),
    }
    if boot_tag_used(child, tag) {
        fault_process(p, FaultReason.DuplicateKey)
    }
    kind
}

/// THE MOVE ITSELF: bind in the child, unbind in the giver, append the record.
/// Answers the child-side word, or `NO_HANDLE` when the child's table was full —
/// in which case NOTHING happened and the giver's entry is untouched.
///
/// The two halves are ordered so that the failing one cannot lose a capability:
/// the child-side binding is made FIRST, so a full table is a refusal with the
/// caller's entry exactly as it was, and only a mint that succeeded is followed
/// by the unbind that makes the giver's word stale. The unbind is
/// `unbind_handle`, the same one release and the teardown use, so the generation
/// bump comes for free and design 3's diagnosis of a stale word covers a giver
/// exactly as it covers a releaser.
///
/// RIGHTS TRAVEL VERBATIM — `entry.rights` is copied, not recomputed — because a
/// give is a MOVE AND NOT A MINT: no default set is consulted and nothing
/// amplifies, so what the giver attenuated stays attenuated.
/// **THE COUNT GOES UP BEFORE IT GOES DOWN, AND THE ORDER IS LOAD-BEARING**
/// (sawos design 7 D-1). A give is a MOVE, so the object's reference count is
/// the same on both sides of it — but it is written as an increment and then a
/// decrement rather than as nothing at all, because "every bind refs, every
/// unbind unrefs" is a rule with no exceptions or it is not a rule. Doing them
/// in the other order would take the count to zero between two lines of one op
/// and FREE the object the give was about to hand over.
func move_handle(p: Int, child: Int, word: UInt, entry: HandleEntry,
                 kind: BootHandleKind, tag: UInt) unsafe -> UInt {
    let given = mint_handle(child, entry.obj_type, entry.rights, entry.target)
    if given == NO_HANDLE {
        return NO_HANDLE
    }
    ref_object(entry.obj_type, entry.target)
    unbind_handle(p, handle_word_index(word))
    unref_object(entry.obj_type, entry.target)
    queue_boot_handle(child, tag, kind, given)
    given
}

/// The record `Process.BootHandleNext` answers with, in kernel memory.
///
/// Declaration order IS the layout (design 58), so the field here and the word
/// index `sosabi` publishes are one description — pinned by the assert below
/// rather than by agreement, exactly as the wait record is.
struct BootHandleWire {
    tag: UInt,
    kind: UInt,
    handle: UInt,
}

static_assert(sizeof<BootHandleWire>() == BOOT_HANDLE_RECORD_WORDS * sizeof<UInt>(),
              "a boot handle record must be exactly the words sosabi publishes")

/// §12's boot set, one record at a time (sawos design 2 D-3), **out of the
/// CALLER's own per-process set** (sawos design 4 D-2).
///
/// The op did not change shape when the set went per-process, which is the claim
/// D-2 makes: root drains records the kernel wrote at boot and a child drains
/// records its launcher wrote with `give`, through one op, one record layout and
/// one exhaustion rule. `p` is the caller, established by the dispatch before the
/// `BootHandles` right was checked.
///
/// **EXHAUSTION IS A STATUS AND IT STAYS EXHAUSTED.** A caller draining an
/// iterator ENDS by meeting the end, so faulting would kill the correct program;
/// and the cursor only advances, so a drained iterator answers `Drained` for
/// ever and a loop's termination check is stable.
///
/// The record rides the EXISTING copy-out funnel — three machine words, the
/// wait record's shape — because that door already answers the two questions an
/// answer-in-memory poses (is the buffer aligned, is it inside the process's
/// writable window) and a second one would be a second set of rules.
///
/// IT IS CONSUMED BY DELIVERY, and the cursor advances only after the copy
/// SUCCEEDS: a caller whose buffer was refused is dead by then, but the ordering
/// is what makes the rule "a record is handed over exactly once" true rather
/// than nearly true.
func boot_handle_next(p: Int, dst: UInt, cap: UInt) unsafe -> SyscallResult {
    // A capacity below the record's size is an argument outside its domain —
    // the size is published, so the caller could have checked. `Waiter.Wait`'s
    // rule, and the same diagnostic.
    if cap < (boot_handle_record_bytes() as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    // The cursor first steps over anything `start(boot_tag:)` already delivered
    // through the register door — one record, one delivery, whichever door it
    // went out of (the Aug-29 user ruling).
    let cursor = boot_handle_cursor(p)
    if cursor >= BOOT_HANDLE_COUNT[p] {
        return op_status(SosStatus.Drained)
    }
    let queued = BOOT_HANDLES[p * MAX_HANDLES + cursor]
    var rec = BootHandleWire(tag: queued.tag, kind: queued.kind as UInt,
                             handle: queued.handle)
    if let why = copy_out(p, dst,
                          ((&var rec) as UnsafePointer<BootHandleWire>) as UInt,
                          boot_handle_record_bytes() as UInt) {
        fault_process(p, why)
    }
    BOOT_HANDLE_NEXT[p] = cursor + 1
    op_ok()
}

/// Make an Event in process `slot` (spec §2.4).
///
/// The MODE arrives as a raw register word the process chose, so it is decoded
/// rather than trusted: a number that is not a mode is a caller error the
/// process could have checked, which under design 178's faults ruling ends it.
func event_create(p: Int, raw_mode: UInt) unsafe -> SyscallResult {
    guard let mode = EventMode.from(raw: raw_mode) else { fault_process(p, FaultReason.BadArg) }
    return event_create_moded(p, mode)
}

func event_create_moded(p: Int, mode: EventMode) unsafe -> SyscallResult {
    // **POLICY REFUSES BEFORE THE MACHINE IS ASKED** (sawos design 7 D-3), and
    // this is the order every allocation site in the kernel now follows: a
    // process at its own budget is told so with `QuotaExceeded`, and only a
    // process still within it can meet the slab's `NoResource`. The two are
    // different facts and a caller can act on the difference — a release of
    // something it already holds fixes the first and cannot fix the second.
    if not quota_room(p, QuotaKind.Event) {
        return op_status(SosStatus.QuotaExceeded)
    }
    let slot = alloc_event()
    if slot == NO_EVENT {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_handle(p, ObjType.Event, event_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    // Written only once BOTH allocations succeeded, so a refused handle leaves
    // the slab exactly as it found it — the all-or-nothing shape design 123
    // asks of a `try_` op, for the same reason. The CHARGE joins that rule: a
    // process must not pay for an object it never got.
    EVENTS[slot] = EventSlot(state: SlotState.Live, process: p, mode: mode,
                             word: 0, attachment: 0, refs: 1)
    quota_charge(p, QuotaKind.Event)
    op_value(handle)
}

/// Bind `line` to a new Interrupt in process `p` (spec §2 table, §9).
///
/// THREE REFUSALS, all faults, all caller-checkable:
///
///   - a line THIS MACHINE does not have. The board's line space is documented
///     per profile and a driver names a number out of its own device's
///     description, so a number outside it is a mistake the caller could have
///     checked.
///   - the TIMER's line. It is the scheduler's, and a process holding it could
///     mask the tick and never yield — which is not a capability the object
///     model offers, so asking for it is a caller error rather than a refusal
///     to branch on. It is checked HERE, arch-free, because it is a KERNEL
///     policy: which number the timer uses is the machine's business, that it
///     is not for rent is not.
///   - a line ALREADY BOUND. Two Interrupts on one line would be two objects
///     with one `pending` between them and two acks for one fire, so the second
///     bind is refused rather than serialized.
///
/// The line is UNMASKED on success, which is the initial state §9's cycle needs:
/// mask-on-fire, ack-to-rearm, so something has to arm it first and creation is
/// that something. The DEVICE's own interrupt-enable register is not touched —
/// that is the driver's, through the window it was granted.
func interrupt_bind(p: Int, line: UInt) unsafe -> SyscallResult {
    if line == hal.IRQ_TIMER || not hal.irq_line_valid(line) {
        fault_process(p, FaultReason.BadArg)
    }
    if interrupt_by_line(line) != NO_INTERRUPT {
        fault_process(p, FaultReason.LineBound)
    }

    if not quota_room(p, QuotaKind.Interrupt) {
        return op_status(SosStatus.QuotaExceeded)
    }
    let slot = alloc_interrupt()
    if slot == NO_INTERRUPT {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_handle(p, ObjType.Interrupt, interrupt_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    INTERRUPTS[slot] = InterruptSlot(state: SlotState.Live, process: p,
                                     line: line, pending: false, attachment: 0,
                                     refs: 1)
    quota_charge(p, QuotaKind.Interrupt)
    hal.irq_unmask(line)
    op_value(handle)
}

/// Make a Waiter in process `slot` (spec §2.2).
func waiter_create(p: Int) unsafe -> SyscallResult {
    if not quota_room(p, QuotaKind.Waiter) {
        return op_status(SosStatus.QuotaExceeded)
    }
    let slot = alloc_waiter()
    if slot == NO_WAITER {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_handle(p, ObjType.Waiter, waiter_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    WAITERS[slot] = WaiterSlot(state: SlotState.Live, process: p, attached: 0,
                               blocked: 0, refs: 1)
    quota_charge(p, QuotaKind.Waiter)
    op_value(handle)
}

/// Make a thread in process `slot`, ready to be started.
///
/// The entry and the stack are CHECKED against the process's granted region.
/// Both are caller-checkable — a process knows where its own image and its own
/// stacks are — so a bad one terminates it rather than producing a thread that
/// would fault on its first instruction and take the process down anyway, with
/// a worse diagnostic.
func thread_create(p: Int, entry: UInt, stack_top: UInt, arg: UInt) unsafe -> SyscallResult {
    let start = if entry == ENTRY_IMAGE { PROCESSES[p].entry } else { entry }
    if start < PROCESSES[p].region_base || start >= PROCESSES[p].region_top {
        fault_process(p, FaultReason.BadEntry)
    }
    if stack_top <= PROCESSES[p].region_base || stack_top > PROCESSES[p].region_top {
        fault_process(p, FaultReason.BadEntry)
    }

    // A THREAD ROW IS CHARGED AND NEVER CREDITED BEFORE THE TEARDOWN (sawos
    // design 7 D-1), because a thread SLOT is not returned before it either:
    // `Exited` is a state a slot stays in so a late join still finds the exit
    // code. The quota tracks the slab exactly, which is what makes it honest
    // rather than a second, looser story about the same resource.
    if not quota_room(p, QuotaKind.Thread) {
        return op_status(SosStatus.QuotaExceeded)
    }
    let slot = alloc_thread()
    if slot == NO_THREAD {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_handle(p, ObjType.Thread, thread_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }

    hal.frame_init(frame_slot(slot), start, stack_top, arg)
    THREADS[slot] = ThreadSlot(state: ThreadState.Created, process: p,
                               exit_code: 0,
                               joiners: 0, link: 0, wait_buf: 0)
    quota_charge(p, QuotaKind.Thread)
    op_value(handle)
}

/// The Thread object's ops (§2, §8; design 178 D4).
///
/// `Exit` and `Yield` are ops a thread performs on ITSELF, so both check that
/// the handle names the caller. That check is the faults ruling's `NotSelf`:
/// driving another thread's execution is not something the object model offers,
/// and a process that tries has misread its own handles.
func thread_op(raw_op: UInt, obj: &ThreadObject, arg0: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = ThreadOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return thread_op_decoded(op, &obj, arg0, p)
}

func thread_op_decoded(op: ThreadOp, obj: &ThreadObject, arg0: UInt,
                       p: Int) unsafe -> SyscallResult {
    let target = obj.slot

    match op {
        case Start -> {
            if not obj.allows(ThreadRight.Start) {
                fault_process(p, FaultReason.AccessDenied)
            }
            match THREADS[target].state {
                case Created -> {},
                case _ -> fault_process(p, FaultReason.BadState),
            }
            THREADS[target].state = ThreadState.Runnable
            ready_push(target)
            op_ok()
        },
        case Join -> {
            if not obj.allows(ThreadRight.Join) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if target == CURRENT_THREAD {
                fault_process(p, FaultReason.BadState)
            }
            match THREADS[target].state {
                // Already gone: the answer is in the slot, so nothing parks.
                case Exited -> op_value(THREADS[target].exit_code),
                case Free -> fault_process(p, FaultReason.BadState),
                case _ -> {
                    block_on_join(CURRENT_THREAD, target)
                    op_blocked()
                },
            }
        },
        case Exit -> {
            if not obj.allows(ThreadRight.Control) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if target != CURRENT_THREAD {
                fault_process(p, FaultReason.NotSelf)
            }
            exit_thread(target, arg0)
            // No pair is ever written: this thread does not resume.
            op_blocked()
        },
        case Yield -> {
            if not obj.allows(ThreadRight.Control) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if target != CURRENT_THREAD {
                fault_process(p, FaultReason.NotSelf)
            }
            // The yielder DOES resume, right after the trapping instruction, so
            // its pair is written now; the requeue is `pick_next`'s, which is
            // the one place a thread is put back on the ready queue.
            NEED_RESCHED = true
            op_ok()
        },
    }
}

/// The Event object's ops (spec §2.4; design 178 D5).
func event_op(raw_op: UInt, obj: &EventObject, arg0: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = EventOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return event_op_decoded(op, &obj, arg0, p)
}

func event_op_decoded(op: EventOp, obj: &EventObject, arg0: UInt,
                      p: Int) unsafe -> SyscallResult {
    let target = obj.slot

    match op {
        // NEVER BLOCKS and never fails (§2.4): whatever the word holds, more
        // bits fit — the OR mode is idempotent and the sum saturates. That is
        // what makes it the fire-and-forget primitive, and it is why there is
        // no status here to branch on.
        case Signal -> {
            if not obj.allows(EventRight.Signal) {
                fault_process(p, FaultReason.AccessDenied)
            }
            signal_event(target, arg0)
            op_ok()
        },
        // DRAINS AND RESETS, in one operation (§2.4) — THE NON-BLOCKING DOOR of
        // the two a take can come through, and its semantics are exactly what
        // they always were. Reading an empty event answers zero rather than
        // parking: an Event is not a queue, and blocking is the Waiter's job.
        // The blocking door is a `Waiter.wait` delivery, which consumes the same
        // word the same way (`waitable_consume`); a process picks a door by
        // whether it wants to park, never by what it will be told.
        case Receive -> {
            if not obj.allows(EventRight.Receive) {
                fault_process(p, FaultReason.AccessDenied)
            }
            let word = EVENTS[target].word
            EVENTS[target].word = 0
            op_value(word)
        },
    }
}

/// The Interrupt object's ops (spec §2 table, §9; design 178 D6).
func interrupt_op(raw_op: UInt, obj: &InterruptObject) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = InterruptOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return interrupt_op_decoded(op, &obj, p)
}

func interrupt_op_decoded(op: InterruptOp, obj: &InterruptObject,
                          p: Int) unsafe -> SyscallResult {
    let target = obj.slot

    match op {
        // §9's ACK: end this fire and let the device interrupt again.
        //
        // ACKING SOMETHING THAT HAS NOT FIRED IS A FAULT, and it is worth
        // saying why that is caller-checkable rather than harsh. §9 puts at
        // most one unacked fire per Interrupt, and the driver learns about that
        // fire by being told — through a wait it made. So an ack with nothing
        // pending is a driver that acked twice for one fire, or acked before it
        // waited: in both cases the NEXT ack lands on a fire nobody serviced,
        // which is a dropped byte or a wedged device somewhere downstream. A
        // tolerated no-op here would turn that into a bug with no first
        // symptom.
        //
        // THE UNMASK IS LAST, and the order is spec §9's release discipline
        // read from the kernel's side: everything that touches this object's
        // state happens before the line can fire again.
        case Ack -> {
            if not obj.allows(InterruptRight.Ack) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if not INTERRUPTS[target].pending {
                fault_process(p, FaultReason.BadState)
            }
            INTERRUPTS[target].pending = false
            hal.irq_unmask(INTERRUPTS[target].line)
            op_ok()
        },
    }
}

/// The record `Clock.Now` answers with, in kernel memory (design 232 unit 1).
///
/// Declaration order IS the layout (design 58), so the field here and the
/// doubleword index `sosabi` publishes are one description — pinned by the
/// assert below rather than by agreement.
struct ClockNowRecord {
    now_ns: UInt64,
}

static_assert(sizeof<ClockNowRecord>()
              == CLOCK_NOW_RECORD_DOUBLEWORDS * sizeof<UInt64>(),
              "the clock reading must be exactly the doublewords sosabi publishes")

/// The record `Timer.Arm` READS out of the caller's memory. Same discipline,
/// running the other way.
struct TimerArmRecord {
    after_ns: UInt64,
    interval_ns: UInt64,
}

static_assert(sizeof<TimerArmRecord>()
              == TIMER_ARM_RECORD_DOUBLEWORDS * sizeof<UInt64>(),
              "the arm record must be exactly the doublewords sosabi publishes")

/// The Clock object's ops (spec §2 table; design 232 unit 1).
func clock_op(raw_op: UInt, obj: &ClockObject, arg0: UInt,
              arg1: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = ClockOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return clock_op_decoded(op, &obj, arg0, arg1, p)
}

func clock_op_decoded(op: ClockOp, obj: &ClockObject, arg0: UInt, arg1: UInt,
                      p: Int) unsafe -> SyscallResult {
    match op {
        // THE ANSWER IS A RECORD, not the value register, because a nanosecond
        // count is 64 bits and one of the two profiles has 32-bit registers.
        // It rides the same copy-out door `Waiter.Wait`'s answer does — the
        // door checks the buffer, so nothing here has to.
        case Now -> {
            if not obj.allows(ClockRight.Read) {
                fault_process(p, FaultReason.AccessDenied)
            }
            clock_now(p, obj.slot, arg0, arg1)
        },
        // The Timer BINDS THIS CLOCK at creation (the M3 time notes), which is
        // why creation lives on the Clock rather than on the Process beside the
        // other factory ops: the authority and the binding are one act, and a
        // Timer made through a Process handle would have no domain to measure
        // against.
        case TimerCreate -> {
            if not obj.allows(ClockRight.TimerCreate) {
                fault_process(p, FaultReason.AccessDenied)
            }
            timer_create(p, obj.slot)
        },
    }
}

/// Read clock `slot` into the caller's buffer.
///
/// THE DOMAIN DECIDES THE READING, which is why the slot is passed in rather
/// than the reading being taken straight off the machine. Today there is one
/// domain and it is the raw counter; the match is exhaustive, so a second
/// `ClockType` fails to compile here until somebody says what its reading is —
/// which is the one question adding a domain actually poses.
func clock_now(p: Int, slot: Int, dst: UInt, cap: UInt) unsafe -> SyscallResult {
    // A capacity below the record's size is an argument outside its domain —
    // the size is published, so the caller could have checked. `Waiter.Wait`'s
    // rule, and the same diagnostic.
    if cap < (clock_now_record_bytes() as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    let reading = match CLOCKS[slot].kind {
        case Monotonic -> hal.timer_now_ns(),
    }
    var rec = ClockNowRecord(now_ns: reading)
    // The door REPORTS a refused destination and the caller terminates on it
    // (sawos design 2): with more than one process a fault is a scheduling
    // event, so the kill lives above the switch point. What is checked and what
    // happens to the caller are exactly what they were.
    if let why = copy_out(p, dst, ((&var rec) as UnsafePointer<ClockNowRecord>) as UInt,
                          clock_now_record_bytes() as UInt) {
        fault_process(p, why)
    }
    op_ok()
}

/// Make a Timer bound to clock `c` in process `p` (spec §2 table).
func timer_create(p: Int, c: Int) unsafe -> SyscallResult {
    if not quota_room(p, QuotaKind.Timer) {
        return op_status(SosStatus.QuotaExceeded)
    }
    let slot = alloc_timer()
    if slot == NO_TIMER {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_handle(p, ObjType.Timer, timer_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    // Born DISARMED and owing nothing: a Timer is a schedule you have not
    // written yet, so it is not ready, and attaching one to a Waiter before
    // arming it parks rather than reporting.
    TIMERS[slot] = TimerSlot(state: SlotState.Live, process: p, clock: c,
                             armed: false, deadline_ns: 0, interval_ns: 0,
                             fires: 0, attachment: 0, refs: 1)
    quota_charge(p, QuotaKind.Timer)
    op_value(handle)
}

/// The Timer object's ops (spec §2 table; design 232 unit 1).
func timer_op(raw_op: UInt, obj: &TimerObject, arg0: UInt,
              arg1: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = TimerOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return timer_op_decoded(op, &obj, arg0, arg1, p)
}

func timer_op_decoded(op: TimerOp, obj: &TimerObject, arg0: UInt, arg1: UInt,
                      p: Int) unsafe -> SyscallResult {
    let target = obj.slot

    match op {
        // ONE RIGHT FOR BOTH, because they are one capability: the power to
        // decide when this timer fires. See `TimerRight`.
        case Arm -> {
            if not obj.allows(TimerRight.Arm) {
                fault_process(p, FaultReason.AccessDenied)
            }
            timer_arm(p, target, arg0, arg1)
        },
        case Disarm -> {
            if not obj.allows(TimerRight.Arm) {
                fault_process(p, FaultReason.AccessDenied)
            }
            timer_disarm(target)
        },
    }
}

/// §2's `arm(after, interval)`, taken through the COPY-IN door.
///
/// THE OP IS THE DOOR AND THE SCHEDULE IS THE SLOT'S: everything below this line
/// is validating what a process handed over and turning a RELATIVE delay into an
/// absolute deadline. `TimerSlot.arm` is what the schedule then means, including
/// why re-arming an armed timer is legal.
func timer_arm(p: Int, slot: Int, src: UInt, bytes: UInt) unsafe -> SyscallResult {
    // The length is published, so a caller that got it wrong could have checked
    // — `Waiter.Wait`'s capacity rule, running inward. EXACT rather than
    // at-least: an inbound record is the whole of what the op was told, and a
    // caller handing over more than the kernel reads has misunderstood the
    // call rather than merely over-provisioned a buffer.
    if bytes != (timer_arm_record_bytes() as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    var rec = TimerArmRecord(after_ns: 0, interval_ns: 0)
    if let why = copy_in(p, ((&var rec) as UnsafePointer<TimerArmRecord>) as UInt,
                         src, bytes) {
        fault_process(p, why)
    }

    let now = hal.timer_now_ns()
    // Saturating, because `now + after` is arithmetic on a number the PROCESS
    // chose and Saw's overflow checks are on in the kernel. A deadline that
    // would land past the end of time IS the end of time, which is a schedule
    // nothing will ever see fire — the honest answer, and not a panic.
    let deadline = if rec.after_ns > NEVER_NS - now { NEVER_NS } else { now + rec.after_ns }

    TIMERS[slot].arm(deadline, rec.interval_ns)
    reprogram_timer()
    op_ok()
}

/// §2's `disarm()`: this timer is off and owes nothing.
///
/// **DISARMING AN UNARMED TIMER IS A NO-OP, NOT A FAULT** (pinned here, design
/// 232 unit 1), and it is worth saying why that is the opposite call from §9's
/// ack-with-no-fire. An extra ACK is provably a bug: the only way to learn about
/// a fire is to be TOLD about one, so the caller had the information. A disarm's
/// precondition is not like that — a ONE-SHOT DISARMS ITSELF when it fires, so
/// "is it still armed" is kernel state that changed without the caller acting.
/// Cancelling a timeout that has just expired is the ordinary race at the heart
/// of every select-with-timeout, and faulting it would make the safe idiom
/// unwritable.
///
/// It clears the FIRE COUNT as well as the schedule, which is what makes it a
/// clean cancel: a caller who wants the fires reads them with a wait first.
func timer_disarm(slot: Int) unsafe -> SyscallResult {
    TIMERS[slot].disarm()
    reprogram_timer()
    op_ok()
}

/// Resolve `handle` as something this caller may ATTACH TO A WAITER, or
/// terminate the process.
///
/// THE ONE PLACE WAITABILITY IS DECIDED, and it decides the rights check with
/// it — because they are one question. Whether a handle may be attached depends
/// on its KIND, and which enum a rights word is read against depends on the
/// kind too (§3), so a separate `is_waitable` predicate would have to be joined
/// back to a per-kind rights check at every call site. Here the match that
/// establishes the kind is the match that spends the right.
///
/// Every case is spelled out rather than falling through a `_`, which is what
/// makes the next waitable kind — a Pipe, a Timer, an Interrupt (§2.2), a
/// Thread or a Process (§8) — fail to compile until somebody answers for it.
/// THAT PROMISE HAS NOW BEEN COLLECTED TWICE: the Timer took an arm from
/// nowhere (design 232 unit 1), and the PROCESS took one FROM THE REFUSAL LIST
/// (sawos design 8) — which is the shape a `_` arm would have hidden entirely,
/// since a kind moving from "not waitable" to "waitable" is not a new case at
/// all.
func waitable_slot(p: Int, handle: UInt) unsafe -> Waitable {
    let entry = lookup_handle(p, handle)
    match entry.obj_type {
        case Event -> {
            let ev = EventObject(handle: EventHandle(handle),
                                 rights: entry.rights, slot: entry.target)
            if not ev.allows(EventRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            Waitable(kind: WaitableKind.Event, slot: entry.target)
        },
        // The second waitable kind, and the one the object model was built for:
        // §2.2 lists Interrupt among the waitables and §9's whole delivery
        // model is a driver parked on one. The right it spends is
        // `InterruptRight.Wait`, which is a different enum from the Event arm's
        // and is exactly why waitability and the rights check are one question.
        case Interrupt -> {
            let irq = InterruptObject(handle: InterruptHandle(handle),
                                      rights: entry.rights, slot: entry.target)
            if not irq.allows(InterruptRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            Waitable(kind: WaitableKind.Interrupt, slot: entry.target)
        },
        // The THIRD waitable kind (design 232 unit 1), and it cost this
        // function one arm and the matrix above one column — which is what the
        // M2 finale's refactor was for. The right it spends is `TimerRight.Wait`,
        // a third enum again, which is why waitability and the rights check stay
        // one question.
        case Timer -> {
            let t = TimerObject(handle: TimerHandle(handle),
                                rights: entry.rights, slot: entry.target)
            if not t.allows(TimerRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            Waitable(kind: WaitableKind.Timer, slot: entry.target)
        },
        // **THE FOURTH WAITABLE KIND, AND IT IS AN OBJECT THAT ALREADY
        // EXISTED** (spec §8; sawos design 8, M3 unit 5.5). This arm REPLACES a
        // `NotWaitable` refusal rather than joining the list below it, which is
        // the whole shape of the unit: no new kind, no new op, no new right.
        // The bit it spends is `ProcessRight.Wait` — the SAME bit `GetStatus`
        // spends two hundred lines up, because being woken by a death and
        // asking about one are one question at two tempos, and a second bit
        // would let a supervisor poll a death it may not be told about.
        //
        // A PROCESS MAY BE ATTACHED WHILE IT IS STILL ALIVE, which is the
        // ordinary supervisor shape: readiness is `state == Gone`, so an
        // attachment onto a running child simply is not ready yet. And it may
        // be attached while it is already DEAD, which is terminal level's
        // headline — see `waitable_consume`.
        case Process -> {
            let pr = ProcessObject(handle: ProcessHandle(handle),
                                   rights: entry.rights, slot: entry.target)
            if not pr.allows(ProcessRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            Waitable(kind: WaitableKind.Process, slot: entry.target)
        },
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case System -> fault_process(p, FaultReason.NotWaitable),
        // A THREAD IS STILL NOT WAITABLE, and the arm survives its neighbour's
        // promotion deliberately (design 8 D-2): §8 names both halves and unit
        // 5.5 built one. What a waitable Thread is FOR is safe stack
        // reclamation when a dynamic pool scales down, which nothing in this
        // tree does — and `ThreadOp.Join` already answers the question a fixed
        // pool asks. So the refusal here is a scope line, not an oversight.
        case Thread -> fault_process(p, FaultReason.NotWaitable),
        case Waiter -> fault_process(p, FaultReason.NotWaitable),
        // A CLOCK IS NOT WAITABLE, and the arm is worth its line: a clock is
        // always running, so "ready" would either be permanently true or
        // meaningless. Waiting for a TIME is what the Timer it creates is for.
        case Clock -> fault_process(p, FaultReason.NotWaitable),
        // NONE OF THE THREE MEMORY KINDS IS WAITABLE, and unit 4 sharpens the
        // reason rather than changing it. A region and a window have no STATE —
        // they are sealed pairs, and ops on them succeed or fault immediately.
        // A MAPPING has state (installed, or not) and still has no readiness: it
        // changes only when its holder asks, so a wait on one could only ever
        // report what the caller just did. What would make memory waitable is a
        // fault or a REVOCATION arriving from elsewhere, and neither exists
        // until a supervisor can revoke somebody else's mapping.
        case Memory -> fault_process(p, FaultReason.NotWaitable),
        case IoMemory -> fault_process(p, FaultReason.NotWaitable),
        case Mapping -> fault_process(p, FaultReason.NotWaitable),
    }
}

/// The Waiter object's ops (spec §2.2; design 178 D5).
func waiter_op(raw_op: UInt, obj: &WaiterObject, arg0: UInt,
               arg1: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = WaiterOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return waiter_op_decoded(op, &obj, arg0, arg1, p)
}

func waiter_op_decoded(op: WaiterOp, obj: &WaiterObject, arg0: UInt, arg1: UInt,
                       p: Int) unsafe -> SyscallResult {
    let w = obj.slot

    match op {
        case Add -> {
            if not obj.allows(WaiterRight.Attach) {
                fault_process(p, FaultReason.AccessDenied)
            }
            waiter_add(p, w, arg0, arg1)
        },
        case Remove -> {
            if not obj.allows(WaiterRight.Attach) {
                fault_process(p, FaultReason.AccessDenied)
            }
            waiter_remove(p, w, arg0)
        },
        case Wait -> {
            if not obj.allows(WaiterRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            waiter_wait(p, w, arg0, arg1)
        },
    }
}

/// §2.2's `add(handle, key)`: a PERSISTENT attachment, at most one Waiter per
/// handle.
///
/// Attaching something already attached TERMINATES the process. It is the
/// ratified one-Waiter rule, and it is caller-checkable in the strongest sense
/// — the process is the only thing that attaches anything, so it knows.
func waiter_add(p: Int, w: Int, handle: UInt, key: UInt) unsafe -> SyscallResult {
    let target = waitable_slot(p, handle)
    if waitable_attachment(target.kind, target.slot) != 0 {
        fault_process(p, FaultReason.BadState)
    }
    // KEYS ARE UNIQUE PER WAITER (ruled Aug 16). A duplicate would make two
    // questions ambiguous at once — which attachment a `Remove` names, and
    // which one an answer came from — and the attacher chose both keys, so it
    // is caller-checkable in the strongest sense.
    if attached_by_key(w, key) != NO_ATTACHMENT {
        fault_process(p, FaultReason.DuplicateKey)
    }

    let a = alloc_attachment()
    if a == NO_ATTACHMENT {
        return op_status(SosStatus.NoResource)
    }
    ATTACHMENTS[a] = Attachment(state: SlotState.Live, kind: target.kind,
                                target: target.slot, waiter: w, key: key,
                                link: WAITERS[w].attached)
    WAITERS[w].attached = a + 1
    set_waitable_attachment(target.kind, target.slot, a + 1)
    // **AN ATTACHMENT IS A REFERENCE TO THE WAITABLE** (sawos design 7 D-1's
    // table), which is what keeps an Event alive past its last handle: a Waiter
    // is watching it, and something being watched is something still in use.
    // The Waiter is NOT referenced back — it owns the attachment — and that
    // asymmetry is what makes the cascade terminate.
    ref_waitable(target.kind, target.slot)

    // LEVEL-TRIGGERED, at the attach (§2.2). A waitable that is already ready
    // when it joins the set is ready NOW, and a thread parked on this Waiter
    // has to learn about it — otherwise the order "signal, then attach, then
    // wait" would lose the notification, which is the exact lost-edge this
    // semantics exists to rule out. It covers an Interrupt that fired before
    // anyone attached, which is the ordering a driver hits at bring-up.
    if waitable_ready(target.kind, target.slot) {
        wake_one_waiter(w, a)
    }
    op_ok()
}

/// §2.2's `remove(key)`. Removing a key this Waiter does not use is a caller
/// error, on the same terms as attaching twice.
///
/// IT NAMES THE ATTACHMENT BY KEY AND NEVER TOUCHES THE WAITABLE (ruled Aug 16,
/// user), which is why no handle is resolved here and no right on the waitable
/// is spent: detaching edits this Waiter's own table, so the Waiter handle
/// already validated by the dispatch plus the key is the whole of the authority
/// the operation needs. It is also the only form that survives M3: once handles
/// can be CLOSED, a closed waitable's stale attachment has no handle left to
/// name it with, and a handle-based remove could not reach it at all.
func waiter_remove(p: Int, w: Int, key: UInt) unsafe -> SyscallResult {
    let a = attached_by_key(w, key)
    if a == NO_ATTACHMENT {
        fault_process(p, FaultReason.BadState)
    }
    // WHAT WAS BEING WATCHED IS READ BEFORE THE DETACH CLEARS IT, because the
    // reference this drops is the attachment's and the attachment is about to
    // stop existing. A waitable whose last handle went while it was attached
    // reaches zero HERE and frees, which is design 7 D-1's cascade seen from
    // its one user-visible door.
    let watched = ATTACHMENTS[a].kind
    let target = ATTACHMENTS[a].target
    detach_attachment(w, a)
    unref_waitable(watched, target)
    op_ok()
}

/// §2.2's `wait(buffer, capacity)`: block until an attached handle is ready,
/// then COPY OUT a record naming the key its attacher supplied and what fired.
///
/// THE ANSWER IS A RECORD IN THE CALLER'S MEMORY, not registers, and the buffer
/// is the caller's because the kernel has no allocator and no place to put one
/// that would outlive the call. The status register still says how the call
/// went; the record says what happened.
///
/// THE BUFFER IS VALIDATED HERE, ON THE CALL, even on the path that parks and
/// will not use it for a while. That is deliberate: a bad buffer is the calling
/// process's mistake, and terminating it while it is the RUNNING process is
/// both a better diagnostic and a simpler thing to reason about than faulting
/// it out of some later thread's wake.
///
/// THE SCAN COMES FIRST, and that ordering is the level-triggered guarantee
/// doing its work: a signal that arrived before this call is still in the word,
/// so the wait returns immediately and nothing was lost. Only an empty set
/// parks.
func waiter_wait(p: Int, w: Int, dst: UInt, cap: UInt) unsafe -> SyscallResult {
    // A capacity below the record's size is an argument outside its domain —
    // the size is published, so the caller could have checked.
    if cap < (wait_record_bytes() as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    if let why = copy_out_check(p, dst, wait_record_bytes() as UInt) {
        fault_process(p, why)
    }

    let ready = waiter_ready_attachment(w)
    if ready != NO_ATTACHMENT {
        deliver_attachment(p, dst, ready)
        return op_ok()
    }
    if CURRENT_THREAD == NO_THREAD {
        fault_process(p, FaultReason.BadState)
    }
    block_on_wait(CURRENT_THREAD, w, dst)
    op_blocked()
}

/// `RELEASE_OP` — destroy the caller's handle, whatever kind it named (sawos
/// design 3 D-2).
///
/// **UNGATED, and deliberately so.** No right is checked, on any kind. A handle
/// is a capability INSTANCE and identity lives in the object's slot, so
/// destroying your own instance takes nothing away from anybody else holding
/// one — there is no one to protect from it. Releasing your System handle or
/// your own Process handle is legal-but-doomed on the sandboxed-compute
/// precedent: you lose the authority, which is what you asked for. A gate, if
/// one is ever wanted, is a NEW universal bit and never a retasking of an
/// existing one. (The ruling said "never a retasking of `Manage`"; that bit has
/// since been retired outright by the Aug-29 doctrine, which is the same
/// sentence taken further.)
///
/// **A WORD THAT DOES NOT RESOLVE IS THE ORDINARY `BadHandle` FAULT** — the
/// caller reached this line with `entry` already looked up, so `NO_HANDLE`, a
/// malformed word, a stale word whose generation has moved and a SECOND release
/// of the same word all arrive here as `Unbound` and all end the process. Using
/// a handle you released is broken code, and D-1's generations are what turn it
/// from a silent alias into this diagnosis.
///
/// **IT NEVER TOUCHES THE OBJECT** — the teardown close-all's own precedent, and
/// `unbind_handle` is the shared implementation of exactly that. An object whose
/// last handle is gone is unreachable-but-live until its process's teardown;
/// quotas (unit 5) are where that costs something. THE ONE EXCEPTION is D-3's:
/// a released entry that named a PROCESS whose slot is `Gone` may have been the
/// last possible reader of its §8 status word, so the reclaim check runs. It is
/// asked AFTER the unbind, because the entry being released is one of the ones
/// the scan must not find.
func release_handle(p: Int, word: UInt, entry: HandleEntry) unsafe -> SyscallResult {
    match entry.obj_type {
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case _ -> {},
    }
    unbind_handle(p, handle_word_index(word))
    // **AND THE OBJECT LOSES A REFERENCE — WHICH MAY BE ITS LAST** (sawos
    // design 7 D-1). The one nine-arm `match` this function used to need is
    // gone: `unref_object` is the per-kind matrix, so an Interrupt masks its
    // line here, a Timer gives the comparator back, a Waiter detaches its list,
    // a Memory returns its slot, and a `Gone` Process's slot is reclaimed —
    // which is the arm design 3 D-3 wrote by hand and this one generalizes.
    //
    // It runs AFTER the unbind, exactly as the reclaim it replaces did, and now
    // for a mechanical reason rather than a scan's: the count must not include
    // the entry being destroyed.
    unref_object(entry.obj_type, entry.target)
    op_ok()
}

/// `MINT_OP` — a SIBLING handle onto the same object, in the caller's own table,
/// with rights the caller may only NARROW (the Aug-29 user rulings on design 4).
///
/// **IT IS UNIVERSAL FOR RELEASE'S REASON**, and it sits beside release for the
/// same one: naming an object twice is the same act for every kind, so it is one
/// number the dispatch intercepts at the one point that knows the ENTRY and not
/// yet the KIND. Nine per-kind cases would be one body written nine times.
///
/// **THE MASK IS A KEEP SET.** `new = held & keep`, all-ones is "same rights",
/// and the intersection is what makes NO-AMPLIFICATION STRUCTURAL rather than
/// checked: a sibling is a subset of its source by construction, so a garbage
/// mask cannot widen anything. It is also TOTAL — naming a right the source does
/// not hold is a no-op, so there is nothing to fault on — which is what lets one
/// policy mask apply to handles of several kinds without the launcher knowing
/// which bits each carries. The polarity is the ruling: a keep mask FAILS CLOSED
/// when a kind gains a right later, where a removal mask would have passed the
/// new authority through silently. `sosabi`'s `MINT_OP` carries the full
/// argument.
///
/// **IT IS GATED ON THE UNIVERSAL `Mint` BIT**, and that bit is itself maskable
/// — so a launcher hands out a sibling whose mask omitted `Mint` and the
/// proliferation stops exactly where it said it would. A source that does not
/// resolve is the ordinary `BadHandle`, as for release; a source without `Mint`
/// is `AccessDenied`.
///
/// What comes back is INDEPENDENT: its own slot, its own generation, its own
/// release. It names the same object, which is what makes it a second NAME
/// rather than a second object. The generic `Manage` bit that once half-covered
/// this act is gone (the Aug-29 doctrine), which is why the universal byte now
/// holds exactly the two authorities that are genuinely kind-independent.
///
/// A full table is `NoResource`, a STATUS: a caller could not have known.
func mint_sibling(p: Int, entry: HandleEntry, keep: UInt) unsafe -> SyscallResult {
    match entry.obj_type {
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case _ -> {},
    }
    if not rights_allow_mint(entry.rights) {
        fault_process(p, FaultReason.AccessDenied)
    }
    // THE MASK IS A KEEP SET AND THE OPERATION IS AN INTERSECTION, which is what
    // makes no-amplification STRUCTURAL: the result is a subset of the source by
    // construction, not by a check somebody could forget. Naming a right the
    // source does not hold is a no-op, so there is no over-ask to fault on.
    //
    // The narrowing is TRUNCATING and not `as`, deliberately: `keep` is a
    // register-wide word a PROCESS chose, and an `as UInt32` on a 64-bit profile
    // would PANIC INSIDE THE KERNEL over a number userspace picked. Rights are a
    // 32-bit word, so the bits above the budget name no right and dropping them
    // changes no answer — `handle_word_generation` refuses to narrow for the
    // opposite reason, and the difference is that its bits MEAN something.
    let rights = entry.rights & UInt32.from(truncating: keep)
    let word = mint_handle(p, entry.obj_type, rights, entry.target)
    if word == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    // A SIBLING IS A SECOND NAME, AND A SECOND NAME IS A SECOND REFERENCE
    // (sawos design 7 D-1) — which is what makes releasing one of two siblings
    // leave the object alive, and the second release the one that ends it.
    ref_object(entry.obj_type, entry.target)
    op_value(word)
}

// =============================================================================
// Memory, IoMemory and Mapping (spec §2.5; sawos design 6)
// =============================================================================
//
// **A MAPPING IS AN INSTALLED GRANT ROW.** Everything below follows from that
// one sentence on a machine that does not translate (spec §5.5: an address is
// the same number in every process), and it is what makes this unit small: the
// grant record M3 unit 2 built for the SCHEDULER is the same record `map`
// edits, `load_domain` is the same installer, and the object this unit adds is
// a handle onto one row of it.
//
// THREE THINGS ARE SHARED BY THE OPS BELOW AND ARE WRITTEN ONCE HERE:
//
//   - the ACCESS vocabulary, translated rather than cast (`grant_perms`);
//   - the TARGET resolution, which spends `ProcessRight.Map` on a process the
//     caller named (`map_target`);
//   - the INSTALL itself, which is one place so that a RAM row and a device row
//     cannot be recorded differently (`install_row`).

/// Translate `MapAccess` bits into the `SegFlag` vocabulary a grant row carries.
///
/// **IT IS A TRANSLATION AND NOT A CAST, DELIBERATELY.** The two enums have the
/// same numbers on purpose (`MapAccess` says why), and writing the conversion
/// out anyway is what lets the two packages version apart: `sosabi` is the trap
/// boundary's vocabulary and `imgformat` is the image format's, and a cast here
/// would silently tie a future edit of either to the other. Three lines is the
/// whole cost.
func grant_perms(access: UInt32) -> UInt8 {
    var perms: UInt8 = 0
    if (access & (MapAccess.Read as UInt32)) != 0 {
        perms = perms | (SegFlag.Read as UInt8)
    }
    if (access & (MapAccess.Write as UInt32)) != 0 {
        perms = perms | (SegFlag.Write as UInt8)
    }
    if (access & (MapAccess.Execute as UInt32)) != 0 {
        perms = perms | (SegFlag.Execute as UInt8)
    }
    perms
}

/// Decode and VALIDATE a caller's access word, or end the caller.
///
/// FOUR REFUSALS, all `BadArg` faults and all caller-checkable — the caller
/// assembled the word out of `MapAccess` cases it named:
///
///   - a bit outside the three. There is no fourth access, so a set bit the
///     kernel cannot name is a number the caller made up.
///   - WRITE WITHOUT READ. Not a grant any target should install, and one
///     profile RESERVES the encoding outright — the same rule
///     `imgformat.has_sane_perms` applies to an image, applied to a map, which
///     is what keeps ONE answer to "what is a valid grant" in the system.
///   - **WRITE AND EXECUTE IN ONE ROW** (sawos design 9 D-1), which lands here
///     beside write-without-read because it is the same kind of judgement about
///     the same word. It costs nothing expressible: a double map is sanctioned
///     (design 6 agenda item 7 — two rows, two Mappings, no aliasing bookkeeping
///     owed on a machine that does not translate), so the JIT-shaped pattern is
///     still written as an RW row here and an RX row there, and what is refused
///     is only the single row a process could write and then fetch from.
///   - NO ACCESS AT ALL. A row that permits nothing spends a protection slot to
///     say what default-deny already says.
///
/// **THE RULE IS THE DYNAMIC MAP'S, and the loader's door is not this door.** A
/// process image's own executable segments arrive through `place_image` with
/// `SegFlag` bits read out of the image and validated by
/// `imgformat.has_sane_perms`, which refuses write-without-read and X-on-device
/// and NOT W|X — an image's segments are kept apart by its linker script, and
/// that path is `SystemRight.ProcessCreate` authority a driver child does not
/// hold. Two doors, distrusting two different things, exactly as
/// `IoMemoryOp.Carve` and `Map` already check granularity twice.
func map_access(p: Int, raw: UInt) unsafe -> UInt32 {
    // THE WHOLE REGISTER IS TESTED FIRST, in its own width, and only then
    // narrowed. `raw` is a word a PROCESS chose, so an `as UInt32` on a 64-bit
    // profile would PANIC INSIDE THE KERNEL over somebody else's number — the
    // hazard `handle_word_generation` refuses to take and `mint_sibling`
    // truncates past. Testing before narrowing gets both: a bit set anywhere
    // above the three is refused rather than dropped, and the narrowing that
    // follows is exact by construction.
    if (raw & (MAP_ACCESS_MASK as UInt)) != raw {
        fault_process(p, FaultReason.BadArg)
    }
    let access = UInt32.from(truncating: raw)
    // The parentheses around the whole condition are DF-172d's: an unbracketed
    // binary expression does not wrap across lines in either spelling.
    if ((access & (MapAccess.Write as UInt32)) != 0
        && (access & (MapAccess.Read as UInt32)) == 0) {
        fault_process(p, FaultReason.BadArg)
    }
    // W^X, PER ROW. The parentheses are DF-172d's, as above.
    if ((access & (MapAccess.Write as UInt32)) != 0
        && (access & (MapAccess.Execute as UInt32)) != 0) {
        fault_process(p, FaultReason.BadArg)
    }
    if access == 0 {
        fault_process(p, FaultReason.BadArg)
    }
    access
}

/// Resolve the Process handle a map names as its TARGET, spending
/// `ProcessRight.Map` on it. Answers the target's process slot, or ends the
/// caller.
///
/// **THIS IS THE SECOND RIGHT A MAP SPENDS, AND IT IS THE POINT OF THE
/// ARGUMENT** (sawos design 6 D-3). Installing a row into a domain is an
/// authority over THAT PROCESS, not something holding a region should imply —
/// the doctrine's no-possession-implies-authority, applied to the one op that
/// reaches across a process boundary. A launcher that hands a child a region
/// without this bit on the child's handle has handed over bytes it cannot
/// install anywhere.
///
/// A word that names nothing, or names something that is not a Process, is the
/// ordinary `BadHandle`: the caller chose which handle to pass.
///
/// **THE TARGET MUST BE ALIVE, AND THAT CHECK IS LOAD-BEARING RATHER THAN
/// TIDY.** A supervisor's handle onto a dead child OUTLIVES it — that is design
/// 3 D-3's whole point, since reading how a child died is what the handle is
/// for — so a `map` naming one would otherwise append a row to a `Gone` slot's
/// grant record. The record was emptied by `clear_domain` at the teardown and
/// the slot is RECLAIMED once no handle names it, so the next
/// `process_create` would land in that slot and `place_image` would append its
/// own rows ON TOP of the stranger's: a brand-new process holding a protection
/// row it never asked for, granting somebody else's memory. `give` and `Start`
/// were never exposed to this (both require `Created`); `map` is the first op
/// that reaches into another process's slot without one, so it states its own
/// requirement.
///
/// `Created` and `Running` are both legal — mapping into a child before or
/// after its start are equally sensible, and a mapping is not a boot record, so
/// the give-freeze does not apply. Anything else is `BadState`, a FAULT: the
/// caller can ask (`GetStatus`), so it could have known.
func map_target(p: Int, handle: UInt) unsafe -> Int {
    let entry = lookup_handle(p, handle)
    match entry.obj_type {
        case Process -> {
            let target = ProcessObject(handle: ProcessHandle(handle),
                                       rights: entry.rights, slot: entry.target)
            if not target.allows(ProcessRight.Map) {
                fault_process(p, FaultReason.AccessDenied)
            }
            match PROCESSES[target.slot].state {
                case Created -> {},
                case Running -> {},
                case _ -> fault_process(p, FaultReason.BadState),
            }
            target.slot
        },
        case _ -> fault_process(p, FaultReason.BadHandle),
    }
}

/// Install one row in process `t`'s domain and mint the Mapping that names it.
///
/// **THE POLICY CAP IS ASKED FIRST AND THE PHYSICAL WALL IS NOW A KERNEL BUG**
/// (sawos design 6 D-3, agenda item 8, made executable by sawos design 7 D-3).
///
/// Unit 4 recorded the sentence this function now runs: *a `map()` meeting the
/// physical wall with quota headroom left is a kernel bug to assert against.*
/// Unit 5 is what makes it a statement rather than a hope, and the argument is
/// short enough to write here in full.
///
/// The TARGET's mapping row counts INSTALLED ROWS, not Mapping objects (see
/// `QuotaKind.Mapping`), so `used` and `grant_count - image rows` are the same
/// number by construction: `install_row` charges one and appends one, `Unmap`
/// credits one and removes one, and a teardown zeroes both at once.
/// `install_quota_limits` then caps every process's limit at the rows its
/// domain actually has left after its image spent its own. Passing the quota
/// check therefore PROVES there is a row to take — so reaching the wall below
/// means the ledger and the record disagree, which is the kernel's bug and
/// nobody else's. `NoResource` would blame a caller for it.
///
/// `hal.GRANT_ROW_BUDGET` is still what the wall is measured against — a
/// HARDWARE number on one profile and a POLICY one on the other, which is
/// exactly why the kernel reads the HAL's rather than a shared constant.
///
/// The budget is checked BEFORE anything is written, which is what keeps
/// `record_grant`'s own `fatal_image` overflow arm a BOOT-door vocabulary: that
/// arm exists for a table the build wrote, and this check is why a syscall can
/// never reach it.
///
/// **AND THE LIVE-DOMAIN RULE IS OBEYED AT THE END** (`domain_changed`): an
/// edit to the running process's record would otherwise never be installed at
/// all, because the scheduler skips equal domains.
func install_row(p: Int, t: Int, base: UInt, top: UInt, perms: UInt8,
                 device: Bool) unsafe -> SyscallResult {
    // THE TARGET IS CHARGED, NOT THE CALLER — D-3's one ruled exception to
    // creator-pays. What a mapping consumes is the target's grant-row budget,
    // and charging the caller would let a launcher's own allowance gate how big
    // another process's domain may be.
    if not quota_room(t, QuotaKind.Mapping) {
        return op_status(SosStatus.QuotaExceeded)
    }
    if (PROCESSES[t].grant_count as UInt) >= hal.GRANT_ROW_BUDGET {
        fatal_kernel("a map met the row budget with quota headroom left",
                     PROCESSES[t].grant_count as UInt)
        // `fatal_kernel` stops the machine but is not declared `-> Never`
        // (design 6's finding 4), so the scope has to exit itself. Nothing
        // reaches this line.
        return op_status(SosStatus.NoResource)
    }
    let slot = alloc_mapping()
    if slot == NO_MAPPING {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_handle(p, ObjType.Mapping, mapping_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    // Nothing is written until every refusal is behind us — `event_create`'s
    // all-or-nothing shape, and here it matters more: a half-installed row is a
    // protection domain that disagrees with its own record.
    let row = PROCESSES[t].grant_count
    record_grant(t, base, top, perms, device)
    MAPPINGS[slot] = MappingSlot(state: SlotState.Live, process: p, target: t,
                                 row: row, refs: 1)
    quota_charge(t, QuotaKind.Mapping)
    domain_changed(t)
    op_value(handle)
}

/// The Memory object's ops (spec §2.5; sawos design 6 D-2/D-3).
func memory_op(raw_op: UInt, obj: &MemoryObject, arg0: UInt,
               arg1: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = MemoryOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return memory_op_decoded(op, &obj, arg0, arg1, p)
}

func memory_op_decoded(op: MemoryOp, obj: &MemoryObject, arg0: UInt, arg1: UInt,
                       p: Int) unsafe -> SyscallResult {
    match op {
        // **ONE CUT FROM THE FRONT, AND THE PARENT BECOMES THE REMAINDER**
        // (sawos design 6 D-2). Allocation is repeated front-splits, so the
        // parent IS the pool cursor and nothing else has to be remembered.
        //
        // THREE CALLER-CHECKABLE REFUSALS, all `BadArg` faults. A `len` of
        // zero: a region naming no bytes is not a region. A `len` past what
        // the parent holds: the caller knows what it has split off so far, and
        // a split that silently clamped would hand back a region smaller than
        // the number in the call. And a MISALIGNED `len`: a grant covers whole
        // units of the target's protection granularity, so a cut mid-unit
        // would leave a remainder that could never be mapped without granting
        // the piece before it too.
        //
        // Slab exhaustion is `NoResource`, a STATUS, because a caller cannot
        // know how many slots are left — and since unit 5 it is a HARDER wall
        // to reach than it was: free-on-last-reference landed, so a piece that
        // is split off and dropped returns its slot at once rather than at the
        // owner's teardown. What a splitting loop meets first is therefore the
        // POOL, not the slab (`tests/memory-split` walks twenty rounds past a
        // slab of sixteen), because the bytes are what nothing returns.
        case Split -> {
            if not obj.allows(MemoryRight.Split) {
                fault_process(p, FaultReason.AccessDenied)
            }
            let len = arg0
            if len == 0 || len > MEMORIES[obj.slot].len {
                fault_process(p, FaultReason.BadArg)
            }
            if (len % hal.PROT_GRAIN) != 0 {
                fault_process(p, FaultReason.BadArg)
            }
            if not quota_room(p, QuotaKind.Memory) {
                return op_status(SosStatus.QuotaExceeded)
            }
            let slot = alloc_memory()
            if slot == NO_MEMORY {
                return op_status(SosStatus.NoResource)
            }
            let handle = mint_handle(p, ObjType.Memory, memory_rights(), slot)
            if handle == NO_HANDLE {
                return op_status(mint_refusal(p))
            }
            // The cut, once both allocations are behind us. The child takes the
            // front and the parent advances past it; a parent split down to
            // zero is representable and simply refuses every later split, which
            // is the honest end of a cursor.
            let base = MEMORIES[obj.slot].base
            MEMORIES[slot] = MemorySlot(state: SlotState.Live, process: p,
                                        base: base, len: len, refs: 1)
            quota_charge(p, QuotaKind.Memory)
            MEMORIES[obj.slot].base = base + len
            MEMORIES[obj.slot].len = MEMORIES[obj.slot].len - len
            op_value(handle)
        },
        // **INSTALL THIS REGION IN A DOMAIN, AND ANSWER WITH THE MAPPING.**
        // `arg0` is the target Process handle and `arg1` the `MapAccess` bits;
        // the two rights it spends are checked on two objects, here and in
        // `map_target`.
        //
        // THE RANGE IS THE REGION'S OWN — a caller supplies no addresses at all,
        // which is the same rule `process_create` follows and the reason a
        // Memory still needs no bounds reader. The top is rounded UP to the
        // protection granularity exactly as the loader rounds a segment's, so a
        // region shorter than one grant unit still gets a whole one.
        case Map -> {
            if not obj.allows(MemoryRight.Map) {
                fault_process(p, FaultReason.AccessDenied)
            }
            let t = map_target(p, arg0)
            let access = map_access(p, arg1)
            // **THE EXEC GATE — A THIRD RIGHT, SPENT ONLY WHEN X IS ASKED FOR**
            // (sawos design 9 D-1). It sits here rather than beside the
            // `MemoryRight.Map` check above for one mechanical reason: it reads
            // the access word, and the access word is not decoded until
            // `map_access` has refused every shape that is not a grant. So the
            // order is the ordinary one — every word-shaped `BadArg` first, then
            // the authority that word turns out to require.
            //
            // AN UNSPENT RIGHT IS `AccessDenied`, the same answer every other
            // one gives, and the caller could have known: rights are a property
            // of the handle it chose to call through, and a launcher that
            // minted the sibling knows exactly what it left out.
            if ((access & (MapAccess.Execute as UInt32)) != 0
                && not obj.allows(MemoryRight.MapExecute)) {
                fault_process(p, FaultReason.AccessDenied)
            }
            let base = MEMORIES[obj.slot].base
            let len = MEMORIES[obj.slot].len
            if len == 0 || region_wraps(base, len) {
                fault_process(p, FaultReason.BadArg)
            }
            if (base % hal.PROT_GRAIN) != 0 {
                fault_process(p, FaultReason.BadArg)
            }
            let top = align_up(base + len, hal.PROT_GRAIN)
            // **THE HAL'S OWN WINDOW PREDICATE, AND THE ALTITUDE IS THE POINT**
            // (sawos design 6 D-4). One profile's grant window cannot express
            // every address, and its loader path answers that by STOPPING THE
            // MACHINE — right for a memory map the build got wrong, wrong for a
            // range a PROCESS chose. So a map asks first and faults with
            // `BadArg`, and the HAL's kernel-bug stop stays for the path it was
            // written for.
            if not hal.map_target_ok(base, top) {
                fault_process(p, FaultReason.BadArg)
            }
            install_row(p, t, base, top, grant_perms(access), false)
        },
    }
}

/// The IoMemory object's ops (spec §2.5; sawos design 6 D-1/D-2/D-3).
func iomemory_op(raw_op: UInt, obj: &IoMemoryObject, arg0: UInt,
                 arg1: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = IoMemoryOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return iomemory_op_decoded(op, &obj, arg0, arg1, p)
}

func iomemory_op_decoded(op: IoMemoryOp, obj: &IoMemoryObject, arg0: UInt,
                         arg1: UInt, p: Int) unsafe -> SyscallResult {
    match op {
        // **CARVE LEAVES THE PARENT ALONE** (sawos design 6 D-2), which is the
        // whole difference from `Split` and is §2.5's own rule: MMIO is pinned,
        // a fixed region may be handed out many times, and several drivers may
        // legitimately hold windows onto one peripheral. So there is no cursor
        // here and no arithmetic on the parent at all.
        //
        // `arg0` is an OFFSET into the parent and `arg1` a length, which is
        // what makes the op writable without a bounds reader: a caller names a
        // sub-window relative to what it holds and never learns an address.
        //
        // THE HARDWARE'S GRANULARITY IS CHECKED HERE, where the caller chose
        // the numbers: a window that could never be installed anywhere is a
        // capability that lies about itself, and a refusal deferred to the map
        // would arrive one op later than the mistake. `Map` checks it AGAIN,
        // for the one window a carve never saw — a boot ROOT, whose bounds came
        // from the build's region table rather than from a caller. The rule is
        // per-profile (`hal.device_window_ok`) because the two profiles express
        // a device window differently — one as a single naturally-aligned
        // power-of-two protection entry, the other by page.
        case Carve -> {
            if not obj.allows(IoMemoryRight.Carve) {
                fault_process(p, FaultReason.AccessDenied)
            }
            let offset = arg0
            let len = arg1
            let parent_len = IOMEMORIES[obj.slot].len
            if len == 0 || offset > parent_len || len > parent_len - offset {
                fault_process(p, FaultReason.BadArg)
            }
            let base = IOMEMORIES[obj.slot].base + offset
            if not hal.device_window_ok(base, len) {
                fault_process(p, FaultReason.BadArg)
            }
            if not quota_room(p, QuotaKind.IoMemory) {
                return op_status(SosStatus.QuotaExceeded)
            }
            let slot = alloc_iomemory()
            if slot == NO_IOMEMORY {
                return op_status(SosStatus.NoResource)
            }
            let handle = mint_handle(p, ObjType.IoMemory, iomemory_rights(), slot)
            if handle == NO_HANDLE {
                return op_status(mint_refusal(p))
            }
            IOMEMORIES[slot] = IoMemorySlot(state: SlotState.Live, process: p,
                                            base: base, len: len, refs: 1)
            quota_charge(p, QuotaKind.IoMemory)
            op_value(handle)
        },
        // **INSTALL A DEVICE-ATTRIBUTE ROW, ALWAYS** — the guarantee
        // `ObjType.IoMemory` exists for. There is no access argument: RW is
        // fixed, because execute-on-device is refused vocabulary (registers are
        // not instructions, and one profile's mapping cannot even express it)
        // and a write-only register block is not a grant either profile has.
        // `arg0` is the target Process handle, as it is for a Memory.
        case Map -> {
            if not obj.allows(IoMemoryRight.Map) {
                fault_process(p, FaultReason.AccessDenied)
            }
            let t = map_target(p, arg0)
            let base = IOMEMORIES[obj.slot].base
            let len = IOMEMORIES[obj.slot].len
            if not hal.device_window_ok(base, len) {
                fault_process(p, FaultReason.BadArg)
            }
            // The perms word is what a device grant's row carries; the HAL's
            // own device path is what actually decides the attribute, so this
            // says READ|WRITE and nothing about caching — which is the split
            // the seam has had since M2.
            install_row(p, t, base, base + len,
                        (SegFlag.Read as UInt8) | (SegFlag.Write as UInt8), true)
        },
    }
}

/// The Mapping object's ops (spec §2.5; sawos design 6 D-3).
func mapping_op(raw_op: UInt, obj: &MappingObject) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = MappingOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return mapping_op_decoded(op, &obj, p)
}

func mapping_op_decoded(op: MappingOp, obj: &MappingObject,
                        p: Int) unsafe -> SyscallResult {
    match op {
        // **ONLY A MAPPING UNMAPS** (§2.5), and this is that op.
        //
        // A MAPPING WITH NO ROW IS `BadState`, and two different things reach
        // that arm: a second unmap, and a mapping whose TARGET PROCESS has died
        // (its whole domain went with it, so there is nothing left to remove).
        // Both are "this object is not in a state to do that", and both are
        // caller-checkable — the caller either unmapped it or created the
        // child.
        //
        // THE ORDER IS THE CONTRACT: remove the row, COMPACT the record, fix up
        // every Mapping that named a later row of the same domain, and only
        // then reload. Compaction is forced by `load_domain`'s replay-by-index
        // and the fixup is the only index sensitivity in the system (the census,
        // design 6 D-3).
        //
        // **THE SLOT IS NOT FREED** — the deviation from D-3's sketch, and the
        // reason is soundness. A slab slot freed while a handle still names it
        // is reachable through that handle the moment the next `map` reuses it,
        // and design 3's generations cannot cover it: a generation lives in the
        // handle ENTRY, and the entry is not what went away. So an unmapped
        // Mapping keeps its slot and answers `BadState` forever.
        //
        // **UNIT 5 CHANGED WHAT RECLAIMS THE SLOT AND LEFT THIS ARM ALONE**
        // (sawos design 7 D-1/D-2). Refcounted reclamation landed for every
        // countable kind, so the slot comes back when the LAST HANDLE naming
        // this Mapping is released — inside that release, not at the owner's
        // teardown — which is sound precisely because it is the case this
        // paragraph excludes: no handle is left to reach the reused slot
        // through. `refs.saw`'s Mapping arm deliberately LEAVES THE ROW when
        // it frees, since a Mapping owns its row and the row is not a
        // reference back. The two husks are therefore symmetric and both
        // reachable: unmapped-but-referenced (this path — slot lives, `Unmap`
        // is `BadState`) and mapped-but-unreferenced (slot freed, row
        // installed until the TARGET tears down). `Unmap` itself still frees
        // no slot, which is what the paragraph above says and is unchanged.
        case Unmap -> {
            if not obj.allows(MappingRight.Unmap) {
                fault_process(p, FaultReason.AccessDenied)
            }
            match MAPPINGS[obj.slot].state {
                case Live -> {},
                case Free -> fault_process(p, FaultReason.BadState),
            }
            let row = MAPPINGS[obj.slot].row
            if row == NO_ROW {
                fault_process(p, FaultReason.BadState)
            }
            let t = MAPPINGS[obj.slot].target
            remove_grant(t, row)
            MAPPINGS[obj.slot].row = NO_ROW
            // **THE CREDIT FOLLOWS THE ROW, NOT THE SLOT** (sawos design 7
            // D-3). The mapping quota counts rows installed in the target's
            // domain, so this is where one comes back — not `free_object`,
            // which frees the SLOT and may leave the row standing (D-2). An
            // unmapped-but-referenced Mapping is a husk that consumes nothing,
            // and the ledger says so from this line onward.
            quota_credit(t, QuotaKind.Mapping)
            compact_mapping_rows(t, row)
            domain_changed(t)
            op_ok()
        },
    }
}

/// Handle-table lookup -> object type -> op table -> rights check -> op.
///
/// This is where a raw word becomes a TYPED handle (§3), and the order is the
/// point: the number arrives from a register, the table says what it names, and
/// only then is a `SystemHandle` / `ProcessHandle` / `ThreadHandle` constructed.
/// Below this line the kernel is no longer handling an integer a process chose —
/// it is handling an object it resolved, paired with the rights that came with
/// it and the slot it names.
///
/// AN UNBOUND HANDLE TERMINATES THE PROCESS, and it has to be decided here
/// rather than per kind: a handle that names nothing names no kind either, so
/// there is no op table to ask. That is the faults ruling's shape as much as its
/// content — the three caller errors it covers are exactly the three the
/// dispatch can raise before an op body runs.
///
/// **THE UNIVERSAL OPS ARE INTERCEPTED BETWEEN THE TWO** (sawos design 3 D-2 for
/// release, design 4's Aug-29 rulings for mint), and the position is the design:
/// after the lookup, so the entry is resolved and a word naming nothing still
/// faults; before the kind match, so neither op has to exist nine times. This is
/// the one point in the kernel that knows a handle's ENTRY and not yet its KIND,
/// which is exactly the altitude a kind-independent op belongs at — and having
/// TWO of them now is what says that altitude was a real place rather than a
/// convenience for one op.
func dispatch(handle: UInt, op: UInt,
              arg0: UInt, arg1: UInt, arg2: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    let entry = lookup_handle(p, handle)
    if op == RELEASE_OP {
        return release_handle(p, handle, entry)
    }
    if op == MINT_OP {
        return mint_sibling(p, entry, arg0)
    }
    match entry.obj_type {
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case System -> {
            let obj = SystemObject(handle: SystemHandle(handle),
                                   rights: entry.rights)
            system_op(op, &obj, arg0, arg1)
        },
        case Process -> {
            let obj = ProcessObject(handle: ProcessHandle(handle),
                                    rights: entry.rights, slot: entry.target)
            process_op(op, &obj, arg0, arg1, arg2)
        },
        case Thread -> {
            let obj = ThreadObject(handle: ThreadHandle(handle),
                                   rights: entry.rights, slot: entry.target)
            thread_op(op, &obj, arg0)
        },
        case Event -> {
            let obj = EventObject(handle: EventHandle(handle),
                                  rights: entry.rights, slot: entry.target)
            event_op(op, &obj, arg0)
        },
        case Waiter -> {
            let obj = WaiterObject(handle: WaiterHandle(handle),
                                   rights: entry.rights, slot: entry.target)
            waiter_op(op, &obj, arg0, arg1)
        },
        case Interrupt -> {
            let obj = InterruptObject(handle: InterruptHandle(handle),
                                      rights: entry.rights, slot: entry.target)
            interrupt_op(op, &obj)
        },
        case Clock -> {
            let obj = ClockObject(handle: ClockHandle(handle),
                                  rights: entry.rights, slot: entry.target)
            clock_op(op, &obj, arg0, arg1)
        },
        case Timer -> {
            let obj = TimerObject(handle: TimerHandle(handle),
                                  rights: entry.rights, slot: entry.target)
            timer_op(op, &obj, arg0, arg1)
        },
        // **UNIT 4 PUT THE TABLE HERE**, which is what unit 2's `BadOp` arm
        // said would happen (spec §2.5; sawos design 6 D-2/D-3). A Memory has
        // two ops now — derive, and install — and an unknown number aimed at
        // one is `BadOp` inside `memory_op` rather than at this line.
        case Memory -> {
            let obj = MemoryObject(handle: MemoryHandle(handle),
                                   rights: entry.rights, slot: entry.target)
            memory_op(op, &obj, arg0, arg1)
        },
        case IoMemory -> {
            let obj = IoMemoryObject(handle: IoMemoryHandle(handle),
                                     rights: entry.rights, slot: entry.target)
            iomemory_op(op, &obj, arg0, arg1)
        },
        case Mapping -> {
            let obj = MappingObject(handle: MappingHandle(handle),
                                    rights: entry.rights, slot: entry.target)
            mapping_op(op, &obj)
        },
    }
}

// =============================================================================
// The trap handler
// =============================================================================

/// The HAL's landing point for every trap taken from user mode. `frame_addr`
/// addresses the saved context, which this handler may rewrite: a returning
/// syscall leaves its (status, value) pair where the caller reads them and
/// resumes past the trapping instruction — both through the HAL, because both
/// are register conventions.
///
/// IT RETURNS THE FRAME TO RESUME, and that return value is the whole of the
/// context switch (design 178 D2/D3). Handing back the frame it was called with
/// resumes the interrupted thread; handing back another thread's frame resumes
/// THAT one, and the HAL's trap entry cannot tell the difference because there
/// is none to tell. So a switch has one location, it is the user-return
/// boundary by construction, and the kernel is never half-way through one.
///
/// THREE KINDS OF TRAP, and the order below is what tells them apart. An
/// INTERRUPT is not the running program's business at all — it is serviced and
/// the interrupted instruction resumes untouched, which is why it is decided
/// first and why it never reaches the syscall return path (that path steps the
/// saved PC, and stepping past an instruction that has not run yet would lose
/// it). A FAULT is fatal — spec §8 makes a thread fault kill its process. A bad
/// SYSCALL is fatal TOO since design 178's faults ruling: an unknown handle, an
/// unknown op or a missing right is a mistake the caller could have checked, so
/// it ends the process rather than handing back a word to branch on. What is
/// left as a STATUS is what the caller could not have known — a full slab, and
/// later a dead peer.
@export("ktrap")
public func ktrap(frame_addr: UInt, cause: UInt, tval: UInt) unsafe -> UInt {
    if hal.is_interrupt(cause) {
        service_irq(frame_addr, cause)
        return pick_next(frame_addr)
    }

    if not hal.is_syscall(cause) {
        fault_trap(hal.cause_tag(cause), cause, hal.trap_pc(frame_addr), tval)
    }

    let result = dispatch(hal.syscall_handle(frame_addr),
                          hal.syscall_op(frame_addr),
                          hal.syscall_arg0(frame_addr),
                          hal.syscall_arg1(frame_addr),
                          hal.syscall_arg2(frame_addr))

    // THE SYSCALL BOUNDARY: the one place the typed status becomes the number
    // the ABI specifies. `as` on a backed enum is total — the enum IS its tag —
    // so there is nothing here that can fail or disagree with `sosabi`'s table.
    //
    // A BLOCKED CALLER IS SKIPPED. Its pair belongs to whatever wakes it, and
    // writing one here would both answer a question nobody has asked yet and,
    // on the profile whose saved PC points AT the trapping instruction, step
    // that PC a second time when the wake wrote the real pair.
    if not result.blocked {
        write_result(frame_addr, result)
    }
    pick_next(frame_addr)
}

static BYTE_MASK: UInt = 0xFF
