/// The System object's ops (§2.8). Returns a status; `shutdown` does not
/// return.
///
/// `raw_op` is a raw register word the process chose, so it is decoded:
/// `SystemOp.from(raw:)` accepts exactly the numbers that are ops, which is
/// both the range check and the dispatch. The `match` is exhaustive, so adding
/// an op to `sosabi` fails to compile until it is handled here.
///
/// An unknown op and a missing right both terminate the process: the caller
/// chose the number and knows which rights it holds.
///
/// `arg1` is read only by the ops that take a second argument (`ProcessCreate`,
/// `SlabDonate`, `StatsRegionMap`), and `arg2` only by `ProcessCreate`.
func system_op(raw_op: UInt, obj: &SystemObject,
               arg0: UInt, arg1: UInt, arg2: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = SystemOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return system_op_decoded(op, &obj, arg0, arg1, arg2, p)
}

func system_op_decoded(op: SystemOp, obj: &SystemObject, arg0: UInt, arg1: UInt,
                       arg2: UInt, p: Int) unsafe -> SyscallResult {
    match op {
        // The rights check is per-op, not per-object: holding the System handle
        // is not the same as being allowed to use every part of it.
        case DebugPrint -> {
            if not obj.allows(SystemRight.Debug) {
                fault_process(p, FaultReason.AccessDenied)
            }
            hal.console_byte((arg0 & BYTE_MASK) as UInt8)
            op_ok()
        },
        // Stop the machine with `arg0` as the status. Not process exit (that is
        // `ProcessOp.Exit`): this is the whole machine, and kernels with no
        // Process object use it to finish a run.
        case Shutdown -> {
            if not obj.allows(SystemRight.Shutdown) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if arg0 == 0 {
                hal.exit_pass()
            } else {
                hal.exit_fail(arg0)
            }
            op_ok()
        },
        // Derivation rule (§3): the boot handle set is one handle wide and
        // everything else is obtained through it. A process asks the System
        // object which Process it is, so the kernel never widens the entry
        // register, and a process given no System handle cannot name one.
        //
        // Each ask mints a fresh handle gated by `ProcessSelf`, with the kind's
        // default rights (`process_rights()`) narrowed by `arg0`. §3 forbids
        // amplification, not duplication: a second ask yields another
        // independently held and released instance of authority the caller
        // already has. A narrower set comes from the keep mask in `arg0`, or
        // from `MINT_OP` on a handle already held.
        //
        // It can fail: a full handle table is `NoResource`, which the caller
        // could not have known.
        case ProcessSelf -> {
            if not obj.allows(SystemRight.ProcessSelf) {
                fault_process(p, FaultReason.AccessDenied)
            }
            // `arg0` is a keep mask the caller chooses: the derived handle's
            // rights are `process_rights() & arg0` (the default set is in
            // `process_rights`' doc in `rights.saw`), capped by the caller's
            // Process ceiling. The rights of the System handle do not enter
            // it; the derived set can never exceed the default one. The
            // narrowing is truncating, as in `mint_sibling`.
            let handle = mint_capped(p, ObjType.Process,
                                     process_rights()
                                         & UInt32.from(truncating: arg0),
                                     p)
            if handle == NO_HANDLE {
                return op_status(mint_refusal(p))
            }
            // A second name for the same slot is a second reference, so asking
            // for yourself twice is visible to the ledger.
            ref_object(ObjType.Process, p)
            op_value(handle)
        },
        // Time is a granted capability: a process without this right cannot
        // read the machine's clock at all, so handing a child a virtual clock
        // over IPC is a substitution rather than a rewrite.
        case ClockGet -> {
            if not obj.allows(SystemRight.ClockGet) {
                fault_process(p, FaultReason.AccessDenied)
            }
            clock_get(p, arg0)
        },
        // Phase one of the two-phase lifecycle. It is asked of the System
        // object because a process is a machine-wide resource (`ProcessSelf` is
        // the precedent). `arg0` and `arg1` are Memory handles; they spend no
        // `MemoryRight` of their own (see `memory_arg`).
        case ProcessCreate -> {
            if not obj.allows(SystemRight.ProcessCreate) {
                fault_process(p, FaultReason.AccessDenied)
            }
            process_create(p, arg0, arg1, arg2)
        },
        // `arg0` is the `SlabKind`, `arg1` the Memory handle it consumes. The
        // only System op that changes the machine.
        case SlabDonate -> {
            if not obj.allows(SystemRight.SlabDonate) {
                fault_process(p, FaultReason.AccessDenied)
            }
            slab_donate(p, arg0, arg1)
        },
        // Reads no state, spends no resource, takes no argument and cannot
        // fail, so the body is the rights check and the word.
        //
        // The tier comes from the HAL as a `Bool`: `sosabi` sits above the HAL
        // in the dependency order, so the HAL cannot name `ProtectionTier` and
        // the mapping to the ABI word belongs at this seam.
        case TierGet -> {
            if not obj.allows(SystemRight.TierGet) {
                fault_process(p, FaultReason.AccessDenied)
            }
            op_value(protection_tier() as UInt)
        },
        // Grants access without handing over anything to possess. `arg0` is the
        // copy-out buffer for the caller's row index and `arg1` its capacity;
        // the Mapping comes back in the value register, as for `MemoryOp.Map`.
        case StatsRegionMap -> {
            if not obj.allows(SystemRight.StatsRegionMap) {
                fault_process(p, FaultReason.AccessDenied)
            }
            stats_region_map(p, arg0, arg1)
        },
        // Binding an IRQ line is the strongest creation authority, and a line
        // is a machine-wide resource, so the op is System's and its faults land
        // on the caller. A launcher strips the bit from everything that is not
        // a binder; a driver is given the bound Interrupt, not the bit.
        case InterruptBind -> {
            if not obj.allows(SystemRight.InterruptBind) {
                fault_process(p, FaultReason.AccessDenied)
            }
            interrupt_bind(p, arg0)
        },
        // The walk and the lookup by pid. Each reads a pid from the doubleword
        // at `arg0`; the right is checked before the address is read.
        case ProcessNext -> {
            if not obj.allows(SystemRight.ProcessObserve) {
                fault_process(p, FaultReason.AccessDenied)
            }
            process_next(p, arg0)
        },
        case ProcessByPid -> {
            if not obj.allows(SystemRight.ProcessObserve) {
                fault_process(p, FaultReason.AccessDenied)
            }
            process_by_pid(p, arg0)
        },
    }
}

/// Bytes in the doubleword `ProcessNext` and `ProcessByPid` take the address
/// of: a pid is 64 bits on every profile.
static PID_BYTES: UInt = 8

static_assert(sizeof<UInt64>() == 8, "a pid is one doubleword")

/// Mint `p` a Process handle onto record `r`: the observe set, capped by `p`'s
/// Process ceiling, as the sender handle is (`pipe_request_sender`). Neither
/// op that calls this takes a keep mask. `NO_HANDLE` is the mint's refusal, and
/// nothing is referenced then (`mint_refusal` says which status it is).
///
/// The new handle is a reference on the record, counted as
/// `SystemOp.ProcessSelf`'s is, so a `Gone` record stays held and a `Created`
/// process is not torn down for want of a name while the handle lives.
func mint_observe(p: Int, r: Int) unsafe -> UInt {
    let handle = mint_capped(p, ObjType.Process, process_observe_rights(), r)
    if handle != NO_HANDLE {
        ref_object(ObjType.Process, r)
    }
    handle
}

/// Read the pid in the doubleword at `src` in `p`'s memory. An address that is
/// misaligned or outside the caller's memory terminates it, as at every copy
/// door.
func read_pid(p: Int, src: UInt) unsafe -> UInt64 {
    var pid: UInt64 = 0
    if let why = copy_in(p, ((&var pid) as UnsafePointer<UInt64>) as UInt, src,
                         PID_BYTES) {
        fault_process(p, why)
    }
    pid
}

/// `SystemOp.ProcessNext` (spec §2.8): answer the process with the smallest pid
/// above the cursor in the doubleword at `at`, and write its pid back.
///
/// The answers come in a fixed order. The cursor is read, and the doubleword
/// must lie in writable memory as well, because the op writes it: a refused
/// address terminates the caller before anything is looked up. The end of the
/// walk is `Drained`, which mints nothing and leaves the doubleword as it was.
/// Then the mint, whose refusal also leaves it as it was, so a cursor never
/// passes a process the caller got no handle for. The pid is written only once
/// the handle exists.
func process_next(p: Int, at: UInt) unsafe -> SyscallResult {
    let cursor = read_pid(p, at)
    if let why = copy_out_check(p, at, PID_BYTES) {
        fault_process(p, why)
    }
    let r = record_above_pid(cursor)
    if r == NO_PROCESS {
        return op_status(SosStatus.Drained)
    }
    let handle = mint_observe(p, r)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    var next = PROCESS_RECORDS[r].pid
    if let why = copy_out(p, at, ((&var next) as UnsafePointer<UInt64>) as UInt,
                          PID_BYTES) {
        fault_process(p, why)
    }
    op_value(handle)
}

/// `SystemOp.ProcessByPid` (spec §2.8): answer the process the pid in the
/// doubleword at `at` names. The doubleword is only read.
///
/// A pid the record table does not hold is `Revoked` and mints nothing: it is
/// data the caller was passed, so it is a status and not a fault, zero
/// included.
func process_by_pid(p: Int, at: UInt) unsafe -> SyscallResult {
    let pid = read_pid(p, at)
    let r = record_of_pid(pid)
    if r == NO_PROCESS {
        return op_status(SosStatus.Revoked)
    }
    let handle = mint_observe(p, r)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    op_value(handle)
}

/// Install a read-only row over the published stats region in `p`'s own domain
/// and tell `p` which row of it is its own.
///
/// No `Memory` is involved: the row's `region` is `NO_MEMORY` (as for a device
/// window) because no Memory slot owns these bytes and nothing returns them to
/// a pool. `unmap` still works, since a Mapping owns its row rather than its
/// bytes.
///
/// Read-only is the whole access. On an isolated tier a store faults; the flat
/// tier disclaims hardware denial. Write is absent because the columns are the
/// kernel's and a writer could lie to every supervisor.
///
/// The row index is written first: it is a fact about the caller (process `p`
/// occupies its body's row), not a product of the install, so it is true on
/// refusal paths too; see `STATS_REGION_MAP_RECORD_WORDS`. A capacity below the
/// published size and a buffer outside the caller's writable memory are caller
/// mistakes and both terminate it, as in `process_stats`.
func stats_region_map(p: Int, dst: UInt, cap: UInt) unsafe -> SyscallResult {
    if cap < (stats_region_map_record_bytes() as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    var row: [UInt; STATS_REGION_MAP_RECORD_WORDS] = [0; STATS_REGION_MAP_RECORD_WORDS]
    row[STATS_REGION_MAP_ROW_WORD] = body_of(p) as UInt
    if let why = copy_out(p, dst,
                          ((&var row) as UnsafePointer<UInt>) as UInt,
                          stats_region_map_record_bytes() as UInt) {
        fault_process(p, why)
    }
    // The physical base, not the kernel's own address: a grant row names
    // frames, and where the kernel lives in a linear map the two differ.
    // `kcore.stats` owns that conversion.
    let base = stats_region_phys()
    install_row(p, p, base, base + stats_region_len(),
                grant_perms(MapAccess.Read as UInt32), false, NO_MEMORY)
}

/// Which tier this build is: `hal.prot_isolated()` in the ABI's vocabulary.
///
/// A `Bool` is two-valued and the tier word is two words, so the HAL answers
/// honestly with one; `hal.prot_replay_at_switch()` is the other protection
/// fact `kernel/core` reads. Both are functions rather than `static`s: a
/// module-level static is shared by the whole program, so a build profile could
/// not override it. A leaf returning a literal inlines and the branch folds
/// away.
func protection_tier() -> ProtectionTier {
    if hal.prot_isolated() {
        ProtectionTier.Isolated
    } else {
        ProtectionTier.Flat
    }
}

/// Hand process `p` its Clock for the domain `raw_type` names (§2.6).
///
/// The domain is a raw register word the process chose, so it is decoded (as in
/// `event_create`); a number that is not a `ClockType` terminates the caller.
/// One domain exists, so every number but zero faults.
func clock_get(p: Int, raw_type: UInt) unsafe -> SyscallResult {
    guard let type = ClockType.from(raw: raw_type) else { fault_process(p, FaultReason.BadArg) }
    return clock_get_typed(p, type)
}

/// Mint a handle onto the kernel-eternal Clock for `type`.
///
/// Nothing is created: one Clock per domain exists from boot, so this only
/// mints a handle onto a well-known slot. Asking twice yields two handles onto
/// one Clock. That is not a hole in §3, whose invariant is no amplification:
/// every mint carries the kind's default rights and is gated by
/// `SystemRight.ClockGet`, so a second ask hands out another instance of an
/// authority already held.
///
/// `NoResource` is reachable on repetition: a full handle table is something
/// the caller could not have known, so it is a status, not a fault.
func clock_get_typed(p: Int, type: ClockType) unsafe -> SyscallResult {
    let slot = clock_slot(type)
    // No reference is counted and no quota row is charged for the object: a
    // Clock is kernel-eternal and owned by nobody. The handle itself is charged
    // inside `mint_handle`.
    let handle = mint_capped(p, ObjType.Clock, clock_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    op_value(handle)
}

/// The Process object's ops (§2.7, §8).
func process_op(raw_op: UInt, obj: &ProcessObject,
                arg0: UInt, arg1: UInt, arg2: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = ProcessOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return process_op_decoded(op, &obj, arg0, arg1, arg2, p)
}

func process_op_decoded(op: ProcessOp, obj: &ProcessObject,
                        arg0: UInt, arg1: UInt, arg2: UInt,
                        p: Int) unsafe -> SyscallResult {
    match op {
        case ThreadCreate -> {
            if not obj.allows(ProcessRight.ThreadCreate) {
                fault_process(p, FaultReason.AccessDenied)
            }
            thread_create(p, obj.slot, arg0, arg1, arg2)
        },
        // Mint-per-call, as `ProcessSelf`: the default rights are
        // `thread_rights()` and `ThreadSelf` on the Process handle gates the
        // derivation. A full table is `NoResource`. Self-only: the running
        // thread is the caller's, so a handle naming another process, a `Gone`
        // one included, faults the caller (`NotSelf`), as `Exit` does.
        case ThreadSelf -> {
            if not obj.allows(ProcessRight.ThreadSelf) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if obj.slot != p {
                fault_process(p, FaultReason.NotSelf)
            }
            if CURRENT_THREAD == NO_THREAD {
                fault_process(p, FaultReason.BadState)
            }
            let handle = mint_capped(p, ObjType.Thread, thread_rights(),
                                     CURRENT_THREAD)
            if handle == NO_HANDLE {
                return op_status(mint_refusal(p))
            }
            // The new handle is a reference to the running thread: another
            // one, or the first for a child's main thread, which no handle
            // named.
            ref_object(ObjType.Thread, CURRENT_THREAD)
            op_value(handle)
        },
        // Process exit belongs here, not on the System object (spec §5.7).
        // It ends the calling process only: a handle naming any other process
        // faults the caller (`NotSelf`), since there is no kill. Every thread
        // of the process goes with it (§8's teardown is unconditional), so
        // this never returns.
        case Exit -> {
            if not obj.allows(ProcessRight.Exit) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if obj.slot != p {
                fault_process(p, FaultReason.NotSelf)
            }
            // `end_process` does not return, so this arm diverges and owes the
            // `match` no value.
            end_process(obj.slot, ProcessStatusKind.Exited, arg0, arg0)
        },
        // §8's status word: kind in the high bits, code in the low ones. A
        // process asking about itself reads `Running`; the interesting reader
        // is a supervisor holding another process's handle.
        case GetStatus -> {
            if not obj.allows(ProcessRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            op_value(process_status_word(PROCESS_RECORDS[obj.slot].exit_kind,
                                      PROCESS_RECORDS[obj.slot].exit_code))
        },
        // The creation authority for §2's plain objects flows through a handle
        // the process holds (§3's derivation rule). See `ProcessRight`.
        case EventCreate -> {
            if not obj.allows(ProcessRight.EventCreate) {
                fault_process(p, FaultReason.AccessDenied)
            }
            event_create(p, obj.slot, arg0)
        },
        case WaiterCreate -> {
            if not obj.allows(ProcessRight.WaiterCreate) {
                fault_process(p, FaultReason.AccessDenied)
            }
            waiter_create(p, obj.slot)
        },
        // Phase two of the two-phase lifecycle, asked of the child's handle:
        // `obj.slot` is the process being started, not the caller. The right is
        // minted on the handle `process_create` hands back rather than held by
        // the launcher in advance. Phase one is `SystemOp.ProcessCreate`.
        //
        // `arg0` is the boot-tag form and `arg1` the tag. Two registers because
        // zero is a legitimate tag, so "no tag" cannot be a value of the tag;
        // see `BootTagForm`.
        case Start -> {
            if not obj.allows(ProcessRight.Start) {
                fault_process(p, FaultReason.AccessDenied)
            }
            process_start(p, obj.slot, arg0, arg1)
        },
        // §12's boot set, drained one record at a time. Self-only: the set
        // belongs to the process it was minted for, so a handle naming another
        // process, a `Gone` one included, faults the caller (`NotSelf`) and
        // `obj.slot` and the caller are the same process past the check. `p`
        // reads the caller's own records, written by the kernel at boot (root)
        // or by a launcher's gives (a child).
        case BootHandleNext -> {
            if not obj.allows(ProcessRight.BootHandles) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if obj.slot != p {
                fault_process(p, FaultReason.NotSelf)
            }
            boot_handle_next(p, arg0, arg1)
        },
        // The courier op. It is asked of the child's handle (`obj.slot` is the
        // process being furnished) and gated on `ProcessRight.Give` on that
        // handle: "may place handles into this child's boot set". It is
        // separate from `Start` because a supervisor may run and watch a child
        // without being allowed to furnish it. The other gate is on the handle
        // being given: the universal `Transfer` bit, checked inside
        // `process_give` where the entry is known and the kind is not.
        case Give -> {
            if not obj.allows(ProcessRight.Give) {
                fault_process(p, FaultReason.AccessDenied)
            }
            process_give(p, obj.slot, arg0, arg1, arg2)
        },
        // The factory for a connection. It sits on the Process object beside
        // `EventCreate` and `WaiterCreate` because a pipe is IPC and nothing
        // system-shaped, and because the Process object is what a connection is
        // charged to: its slab slot and its quota row. The two handles are the
        // caller's, as for every creation op.
        //
        // `arg0` is the answer buffer and `arg1` its capacity: both ends come
        // back through a copy-out record, because one op returns one value
        // register.
        case PipeCreate -> {
            if not obj.allows(ProcessRight.PipeCreate) {
                fault_process(p, FaultReason.AccessDenied)
            }
            pipe_create(p, obj.slot, arg0, arg1)
        },
        // Introspection. It is asked of the process being observed: `obj.slot`
        // is whose columns come back and the caller `p` is only whose buffer
        // they are written into, so self-inspection is `ProcessSelf` followed
        // by this call and supervision is the same call on a child's handle.
        //
        // `arg0` is the answer buffer and `arg1` its capacity: four 64-bit
        // columns (three counters and the pid) do not fit a value register, so
        // the answer rides the copy-out funnel.
        //
        // A `Gone` process reads normally, which is the point of the `faults`
        // column: a process that faulted is dead and cannot ask, but its
        // record keeps the final counters while a handle names it, so the
        // supervisor holding that handle reads the count.
        case Stats -> {
            if not obj.allows(ProcessRight.Stats) {
                fault_process(p, FaultReason.AccessDenied)
            }
            process_stats(p, obj.slot, arg0, arg1)
        },
        // Narrows one of the named process's rights ceilings (§2.7). It acts
        // on the process the handle names, which is how a launcher bounds its
        // child before `Start` and how a process bounds itself.
        case RestrictRights -> {
            if not obj.allows(ProcessRight.RestrictRights) {
                fault_process(p, FaultReason.AccessDenied)
            }
            process_restrict_rights(p, obj.slot, arg0, arg1)
        },
        // Reads one of the named process's ceilings. Gated by `Stats`, the
        // right that observes the process, on the handle used.
        case Ceiling -> {
            if not obj.allows(ProcessRight.Stats) {
                fault_process(p, FaultReason.AccessDenied)
            }
            process_ceiling(p, obj.slot, arg0)
        },
    }
}

/// The ceiling-table index `raw` names, or terminate the caller: a number that
/// is not a `HandleKind` is a caller error, as for every decoded argument.
func ceiling_index(p: Int, raw: UInt) unsafe -> Int {
    guard let kind = HandleKind.from(raw: raw) else {
        fault_process(p, FaultReason.BadArg)
    }
    kind as Int
}

/// `ProcessOp.RestrictRights`: process `target`'s ceiling for the kind `raw`
/// names becomes its old value intersected with `mask`.
///
/// Only bits are cleared, so the op is valid at any time and a repeat is
/// harmless. It changes what later mints carry and never an existing handle.
/// The kind is decoded first, so a bad kind faults the caller whatever the
/// target's state; a `Gone` target has no ceilings and answers `Revoked`. The
/// narrowing of `mask` is truncating, for `mint_sibling`'s reason: rights are
/// 32 bits and the register is wider.
func process_restrict_rights(p: Int, target: Int, raw: UInt,
                             mask: UInt) unsafe -> SyscallResult {
    let kind = ceiling_index(p, raw)
    if not has_body(target) {
        return op_status(SosStatus.Revoked)
    }
    let b = body_of(target)
    PROCESSES[b].ceilings[kind] = (PROCESSES[b].ceilings[kind]
                                   & UInt32.from(truncating: mask))
    op_ok()
}

/// `ProcessOp.Ceiling`: process `target`'s ceiling for the kind `raw` names, as
/// a rights word. Faults and `Revoked` as for `process_restrict_rights`.
func process_ceiling(p: Int, target: Int, raw: UInt) unsafe -> SyscallResult {
    let kind = ceiling_index(p, raw)
    if not has_body(target) {
        return op_status(SosStatus.Revoked)
    }
    op_value(PROCESSES[body_of(target)].ceilings[kind] as UInt)
}

// -----------------------------------------------------------------------------
// process_create / start / boot_handle_next
// -----------------------------------------------------------------------------

/// Resolve a handle the caller passed as a region, or terminate it.
///
/// A handle that names nothing, or names something that is not a Memory, is a
/// caller error (the process was handed these handles and chose which to pass),
/// so it is a fault and not a `BadImage` status. The line is between the handle
/// (authority, caller-checkable) and the bytes (data, reported).
///
/// No `MemoryRight` is spent. The authority to create a process is
/// `SystemRight.ProcessCreate` on the caller's System handle, already checked;
/// these handles are the operation's arguments. Ops that do ask what a holder
/// may do with a region (`Split`, `Map`) go through `MemoryObject.allows`.
func memory_arg(p: Int, handle: UInt) unsafe -> Int {
    let entry = lookup_handle(p, handle)
    match entry.obj_type {
        case Memory -> {
            let mem = MemoryObject(handle: MemoryHandle(handle),
                                   rights: entry.rights, slot: entry.target)
            mem.slot
        },
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case _ -> fault_process(p, FaultReason.BadHandle),
    }
}

/// Resolve a handle the caller passed as a process, or terminate it, as
/// `memory_arg` does for a region. No `ProcessRight` is spent: the handle is an
/// argument, and naming a process can only restrict what it is used for.
func process_arg(p: Int, handle: UInt) unsafe -> Int {
    let entry = lookup_handle(p, handle)
    match entry.obj_type {
        case Process -> entry.target,
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case _ -> fault_process(p, FaultReason.BadHandle),
    }
}

// =============================================================================
// `SystemOp.SlabDonate`: capacity becomes policy
// =============================================================================
//
// The op is three questions and one irreversible step. May this caller do it (a
// right); is this region safe to absorb (no other reference, no mapping, and
// for a pool root no pieces on loan); does it hold a whole slot and has the
// chain room (the machine's two answers). Only then does anything move, and
// what moves is permanent.

/// One donatable slab's geometry: how many bytes one donated unit needs, what
/// the extent's base must be aligned to, how many more extents the kind can
/// take, and how many more units its ceiling still allows.
///
/// Four numbers in one match rather than four matches, because they are asked
/// together and a kind that answered one of them from a different slab than the
/// others would be a silent corruption rather than a compile error.
///
/// A unit is not always a slot. Most kinds donate one array and a unit is a
/// slot. `Threads` and `Pipes` donate a slot and the per-slot storage that
/// belongs to it, so a unit is the pair and the stride is the pair's size. It
/// is one region, carved by `slab_install`, so a caller never has to know two
/// kernel-internal sizes and their alignment.
///
/// The fourth number is headroom, not the held count: a kind with two chains
/// has two ceilings and only the kind knows which binds, so the kind answers
/// "how many more units may I take" and the caller compares. For `Pipes` the
/// exchange chain binds, by a factor of `PIPE_INFLIGHT`.
func slab_geometry(kind: SlabKind) unsafe -> (Int, Int, Int, Int) {
    match kind {
        case Events -> (EVENTS.slot_bytes(), EVENTS.slot_align(), EVENTS.extents_left(), MAX_SLAB_CAPACITY - EVENTS.capacity()),
        case Waiters -> (WAITERS.slot_bytes(), WAITERS.slot_align(), WAITERS.extents_left(), MAX_SLAB_CAPACITY - WAITERS.capacity()),
        case Interrupts -> (INTERRUPTS.slot_bytes(), INTERRUPTS.slot_align(), INTERRUPTS.extents_left(), MAX_SLAB_CAPACITY - INTERRUPTS.capacity()),
        case Attachments -> (ATTACHMENTS.slot_bytes(), ATTACHMENTS.slot_align(), ATTACHMENTS.extents_left(), MAX_SLAB_CAPACITY - ATTACHMENTS.capacity()),
        case Timers -> (TIMERS.slot_bytes(), TIMERS.slot_align(), TIMERS.extents_left(), MAX_SLAB_CAPACITY - TIMERS.capacity()),
        case Memories -> (MEMORIES.slot_bytes(), MEMORIES.slot_align(), MEMORIES.extents_left(), MAX_SLAB_CAPACITY - MEMORIES.capacity()),
        case IoMemories -> (IOMEMORIES.slot_bytes(), IOMEMORIES.slot_align(), IOMEMORIES.extents_left(), MAX_SLAB_CAPACITY - IOMEMORIES.capacity()),
        case Mappings -> (MAPPINGS.slot_bytes(), MAPPINGS.slot_align(), MAPPINGS.extents_left(), MAX_SLAB_CAPACITY - MAPPINGS.capacity()),
        case FreeRanges -> (FREE_RANGES.slot_bytes(), FREE_RANGES.slot_align(), FREE_RANGES.extents_left(), MAX_SLAB_CAPACITY - FREE_RANGES.capacity()),
        // A thread unit is a slot plus a frame. The frame's stride is also the
        // extent's alignment: it is the strictest of the two and so serves
        // both, since `THREAD_FRAME_STRIDE` is a multiple of every slot
        // alignment.
        case Threads -> (THREADS.slot_bytes() + THREAD_FRAME_STRIDE,
                         THREAD_FRAME_STRIDE,
                         THREADS.extents_left(),
                         MAX_SLAB_CAPACITY - THREADS.capacity()),
        // A pipe unit is a connection plus its whole staging ring. Both chains
        // must have an extent free, and the exchange ceiling binds:
        // `PIPE_INFLIGHT` exchanges are spent per connection, so the headroom
        // in connections is the exchange headroom divided by it.
        case Pipes -> (PIPES.slot_bytes() + PIPE_INFLIGHT * EXCHANGES.slot_bytes(),
                       max_int(PIPES.slot_align(), EXCHANGES.slot_align()),
                       min_int(PIPES.extents_left(), EXCHANGES.extents_left()),
                       min_int(MAX_SLAB_CAPACITY - PIPES.capacity(),
                               (MAX_SLAB_CAPACITY - EXCHANGES.capacity()) / PIPE_INFLIGHT)),
        // A process body unit is a slot. The handle table, the boot set and the
        // grant record live inside `ProcessBody`, so this is a plain one-array
        // chain and needs neither a side arena nor a second ceiling. The
        // domain-pool ceiling is not a donation's business: the allocator
        // applies it (`process_slots_usable`).
        case Processes -> (PROCESSES.slot_bytes(), PROCESSES.slot_align(), PROCESSES.extents_left(), MAX_SLAB_CAPACITY - PROCESSES.capacity()),
        // A record unit is a slot of its own chain, the same one-array shape.
        // Records have no domain behind them, so the slab is the whole bound.
        case ProcessRecords -> (PROCESS_RECORDS.slot_bytes(), PROCESS_RECORDS.slot_align(), PROCESS_RECORDS.extents_left(), MAX_SLAB_CAPACITY - PROCESS_RECORDS.capacity()),
    }
}

/// The larger / smaller of two counts, for `slab_geometry`'s two-chain kinds.
func max_int(a: Int, b: Int) -> Int { if a > b { a } else { b } }

func min_int(a: Int, b: Int) -> Int { if a < b { a } else { b } }

/// Append the extent. The caller has validated everything and zeroed the bytes;
/// this is the step that makes them reachable.
///
/// The two-chain kinds carve here, and the order matters. `slab_geometry`
/// already refused a donation either chain has no room for, so once the first
/// `donate` has run the second cannot fail. If it did, the chains would skew,
/// so that refusal is `fatal_kernel`: a kernel invariant, not a caller
/// condition.
func slab_install(kind: SlabKind, base: UInt, slots: Int) unsafe -> Bool {
    match kind {
        case Events -> EVENTS.donate(base, slots),
        case Waiters -> WAITERS.donate(base, slots),
        case Interrupts -> INTERRUPTS.donate(base, slots),
        case Attachments -> ATTACHMENTS.donate(base, slots),
        case Timers -> TIMERS.donate(base, slots),
        case Memories -> MEMORIES.donate(base, slots),
        case IoMemories -> IOMEMORIES.donate(base, slots),
        case Mappings -> MAPPINGS.donate(base, slots),
        case FreeRanges -> FREE_RANGES.donate(base, slots),
        // Frames first, at the extent's own base: the base is aligned to
        // `THREAD_FRAME_STRIDE` (the geometry says so) and each frame is
        // exactly a stride, so every frame is stride-aligned, which
        // `frame_slot` requires. The slots follow at
        // `slots * THREAD_FRAME_STRIDE`, itself a multiple of the stride and
        // therefore of any slot alignment.
        case Threads -> THREADS.donate_paired(
            base + ((slots * THREAD_FRAME_STRIDE) as UInt), slots, base),
        // Connections first, then their exchanges. `slots * sizeof(PipeSlot)`
        // is a multiple of the slot's alignment, which is the alignment
        // `Exchange` wants too (the geometry took the larger of the two for the
        // base), so the second array lands aligned with no pad.
        case Pipes -> {
            let ex_base = base + ((slots * PIPES.slot_bytes()) as UInt)
            if not PIPES.donate(base, slots) {
                return false
            }
            if not EXCHANGES.donate(ex_base, slots * PIPE_INFLIGHT) {
                fatal_kernel("a pipe donation installed connections without exchanges",
                             slots as UInt)
                return false
            }
            true
        },
        case Processes -> PROCESSES.donate(base, slots),
        case ProcessRecords -> PROCESS_RECORDS.donate(base, slots),
    }
}

/// §2.8's `slab_donate(kind:memory:)`: root hands the kernel memory to back a
/// named slab, forever.
///
/// The kernel is about to write its own object slots into these bytes, so
/// nothing else may be able to see them: `refs == 1` says the handle being
/// consumed is the region's only reference, and `maps == 0` says no installed
/// grant row reaches it from any domain.
///
/// A pool root also needs `out_bytes == 0`, for `memory_release_if_idle`'s
/// reason: pieces on loan carry a back-reference to the slot, and retiring it
/// under them would make those references name a stranger.
///
/// A region with bytes must be memory the board can give a process
/// (`hal.map_source_ok`): the kernel writes its slots there, and a region over
/// flash takes no store. That is a `BadArg` fault, asked before the state
/// conditions because it is about the region itself. An empty region holds no
/// slot, which is the `NoResource` below.
///
/// Faults versus statuses: a missing right, an unknown kind, a handle that is
/// not a Memory, a region the board cannot give, and each of the state
/// conditions are things the caller
/// could have checked (it minted the siblings, installed the rows, split the
/// pieces), so they end the process. Whether a region holds a whole slot of
/// some kind the caller cannot name, and whether the extent chain has room, are
/// machine answers: they return `NoResource` with nothing consumed and the
/// caller's capability untouched.
func slab_donate(p: Int, raw_kind: UInt, handle: UInt) unsafe -> SyscallResult {
    guard let kind = SlabKind.from(raw: raw_kind) else {
        fault_process(p, FaultReason.BadArg)
    }
    let slot = memory_arg(p, handle)
    // Only a region with bytes is asked: an empty one has none the kernel
    // could write, and goes on to the `NoResource` a region too small for a
    // slot answers.
    let region_base = MEMORIES[slot].base
    let region_len = MEMORIES[slot].len
    if (region_len != 0
        && (region_wraps(region_base, region_len)
            || not hal.map_source_ok(region_base, region_base + region_len))) {
        fault_process(p, FaultReason.BadArg)
    }

    if MEMORIES[slot].refs != 1 {
        fault_process(p, FaultReason.BadState)
    }
    if MEMORIES[slot].maps != 0 {
        fault_process(p, FaultReason.BadState)
    }
    let root = MEMORIES[slot].root
    if root == slot && MEMORIES[slot].out_bytes != 0 {
        fault_process(p, FaultReason.BadState)
    }

    let base = MEMORIES[slot].base
    let len = MEMORIES[slot].len
    let (stride_i, align_i, room, headroom) = slab_geometry(kind)
    let stride = stride_i as UInt
    let align = align_i as UInt

    // Aligned by arithmetic, not by refusal. A region's base is whatever the
    // pool's cursor reached and the caller cannot know a kernel slot's
    // alignment, so a misaligned donation is not a caller mistake to fault on.
    // The remainder form never overflows, which `align_up` on a near-max base
    // would.
    let rem = base % align
    let pad: UInt = if rem == 0 { 0 } else { align - rem }
    if pad >= len {
        return op_status(SosStatus.NoResource)
    }
    let start = base + pad
    let slots = ((len - pad) / stride) as Int
    if slots <= 0 {
        return op_status(SosStatus.NoResource)
    }
    if room <= 0 {
        return op_status(SosStatus.NoResource)
    }
    // The machine-wide ceiling is checked here so that `slab_install`'s refusal
    // stays what it says it is: a violated kernel invariant, not a caller
    // condition. `headroom` is the kind's own answer, since a two-chain kind
    // knows which of its ceilings binds.
    if slots > headroom {
        return op_status(SosStatus.NoResource)
    }

    // Zero before installing. A slab slot must start Free, and `Free` is zero
    // in `SlotState` and in every per-kind state enum, so a zeroed extent is an
    // extent full of free slots by construction.
    //
    // `long_zero` takes preemption points. That is safe here because nothing is
    // half-built across a point: the extent is not installed, so no allocator
    // or teardown sweep can reach these bytes, and the handle is not consumed,
    // so the region is still exactly the caller's. A delivery landing mid-zero
    // finds the machine as it was before the call.
    //
    // This is a kernel dereference of a donated extent, so it converts with
    // `hal.phys_to_virt`, as `Slab.extent_addr` does on the read side. `start`
    // itself stays physical: it is what `slab_install` records in the extent
    // table, which holds addresses as data.
    long_zero(hal.phys_to_virt(start), (slots as UInt) * stride)

    if not slab_install(kind, start, slots) {
        fatal_kernel("a validated slab donation was refused", raw_kind)
        return op_status(SosStatus.NoResource)
    }

    // The consume deliberately does not go through `unref_object`. The ordinary
    // path would reach `memory_release_if_idle`, which returns the range to its
    // pool root's free list, and the next `Split` would hand a slab's backing
    // store to somebody else. Donation is permanent: the slot comes back, the
    // bytes never do, and a derived region's length stays charged to its root's
    // `out_bytes` forever, so the root can never be handed on with a slab
    // living inside it.
    unbind_handle(p, handle_word_index(handle))
    memory_retire_donated(slot)
    op_ok()
}

/// Would `[base, base + len)` run past the end of the address space?
///
/// Asked before the addition, as every other bound in the loader is: overflow
/// checks are always on, so an unchecked `base + len` on a malformed region
/// would panic inside the kernel rather than be a refusal the caller can
/// report.
func region_wraps(base: UInt, len: UInt) -> Bool {
    len > UInt.max - base
}

/// §2.8's `process_create(image:memory:)`: the second address space.
///
/// Everything is validated before the first byte moves, so a refusal is
/// harmless: a caller that gets `BadImage` back has a destination region
/// exactly as it left it. The record, the body and the handle are taken before
/// the copy too, so the one failure that is not about the image (a full table)
/// also leaves the bytes alone.
///
/// The third argument is the ceiling source: a Process handle, or `NO_HANDLE`
/// for none. The child's rights ceilings (spec §2.7) are the creator's
/// intersected with the source's, so naming a source only restricts, and any
/// rights on its handle serve. A handle that is not a Process is a fault, and a
/// source that has ended is `Revoked` with nothing created.
///
/// What `process_create` decides that the boot path does not:
///
///   - The destination is the caller's, not a HAL constant. Root supplies two
///     capabilities and no numbers; the stack is still the kernel's grant at
///     the region's top, which is the loader rule applied to a child.
///   - Device windows are refused (`allow_device: false`). See `check_segment`.
///   - The two regions must be disjoint, which also refuses the same Memory
///     passed twice. Overlap across separate creates is deliberately not
///     policed: regions are capabilities, and a root double-spending what it
///     holds corrupts only what it holds. The quota rows count objects, not
///     bytes.
///   - The destination must be memory the board can give a process
///     (`hal.map_source_ok`), so a region over flash is an image and never a
///     destination.
func process_create(p: Int, image_handle: UInt, memory_handle: UInt,
                    ceiling_handle: UInt) unsafe -> SyscallResult {
    let img = memory_arg(p, image_handle)
    let dst = memory_arg(p, memory_handle)
    // The ceiling source, if any: a Process handle of any rights. With none the
    // creator stands in, and intersecting its ceilings with themselves changes
    // nothing. A `Gone` source has no ceilings to intersect, so it answers
    // `Revoked` before anything is validated or taken.
    var source = p
    if ceiling_handle != NO_HANDLE {
        source = process_arg(p, ceiling_handle)
    }
    if not has_body(source) {
        return op_status(SosStatus.Revoked)
    }

    let img_base = MEMORIES[img].base
    let img_len = MEMORIES[img].len
    let dst_base = MEMORIES[dst].base
    let dst_len = MEMORIES[dst].len

    if region_wraps(img_base, img_len) || region_wraps(dst_base, dst_len) {
        return op_status(SosStatus.BadImage)
    }
    // A destination that cannot even hold the kernel's stack grant is refused
    // here rather than by an underflow inside `LoadRegion`'s arithmetic.
    if dst_len <= hal.ROOT_STACK_LEN {
        return op_status(SosStatus.BadImage)
    }
    if img_base < dst_base + dst_len && dst_base < img_base + img_len {
        return op_status(SosStatus.BadImage)
    }
    // A destination is memory the board can give a process: copied segments
    // and the stack are written there and the process writes it. Flash is an
    // image source and never one (spec §5.6). A status rather than a fault,
    // as for the refusals above, because a launcher cannot read a region's
    // bounds.
    if not hal.map_source_ok(dst_base, dst_base + dst_len) {
        return op_status(SosStatus.BadImage)
    }

    // One stack length serves both processes; a per-create length would be a
    // quota question and an ABI to keep.
    //
    // The frames are the caller's and the address is the kernel's. Root
    // supplies two capabilities and no numbers; the kernel adds where the child
    // will see the region it was given: the one canonical link base every image
    // shares on a translating tier, the destination itself on an identity tier.
    let dest = LoadRegion(base: dst_base, top: dst_base + dst_len,
                          stack_len: hal.ROOT_STACK_LEN,
                          link_base: hal.image_link_base(dst_base))
    if let _ = validate_image(img_base, img_len, &dest, false) {
        return op_status(SosStatus.BadImage)
    }

    // A record and a body, or neither: either table full is the same
    // `NoResource`, and the find reserves nothing, so a refusal here or at the
    // mint below takes nothing.
    let (slot, body) = alloc_process()
    if slot == NO_PROCESS {
        return op_status(SosStatus.NoResource)
    }
    // The child's first handle is `process_rights()`, the one Process default
    // set, capped by the creator's Process ceiling. A launcher keeps this
    // handle (it supervises the child with it) and the child derives its own
    // from the masked System handle it was given, so the width here is what a
    // launcher holds, and what it hands on is a keep mask's business.
    let handle = mint_capped(p, ObjType.Process, process_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    link_process(slot, body)
    let pid = assign_pid(slot)

    // Only now does anything happen to the destination region.
    //
    // The rows it records count against the regions they live in. A child's
    // copied segments and stack live in `dst`'s bytes and its segments used in
    // place in `img`'s, so they are references on those in §2.5's sense: a
    // launcher may release its own handle on either while the child runs, and
    // neither range goes back on its pool's free list while a process is
    // running out of it. Each goes back when the child dies.
    let placed = place_image(slot, img_base, &dest, dst, img)

    PROCESS_RECORDS[slot].state = ProcessState.Created
    // A child's table starts empty and `give` fills it. There is nothing to
    // record here: a process's own Process handle is minted when asked for, and
    // a child cannot ask (`ProcessSelf` needs a System handle it has not been
    // given). Every handle a child holds arrives through `ProcessOp.Give`
    // between this call and `Start`; a child given nothing is a legal sandboxed
    // compute process.
    PROCESSES[body].entry = image_entry(img_base)
    // The child's ceilings are the creator's narrowed by the source's, written
    // word by word: the body may be a reused one, and no create inherits what a
    // previous occupant was bounded to.
    var kind: Int = 0
    while kind < HANDLE_KINDS {
        PROCESSES[body].ceilings[kind] = (PROCESSES[body_of(p)].ceilings[kind]
                                          & PROCESSES[body_of(source)].ceilings[kind])
        kind = kind + 1
    }
    // Every address on a process body is a user address: the entry goes into a
    // program counter, the stack top into a stack pointer, and the two windows
    // are what the copy doors check a process's own buffers against. The frames
    // behind them live in the grant rows.
    PROCESSES[body].stack_top = dest.link_top()
    PROCESSES[body].region_base = dest.link_base
    PROCESSES[body].region_top = dest.link_top()
    PROCESSES[body].rw_base = placed.rw_base
    PROCESSES[body].rw_top = dest.link_top()
    PROCESSES[body].ro_base = placed.ro_base
    PROCESSES[body].ro_top = placed.ro_top
    PROCESS_RECORDS[slot].exit_kind = ProcessStatusKind.Running
    PROCESS_RECORDS[slot].exit_code = 0
    // The launcher's handle is the child's first reference. It outlives the
    // child so that reading how the child died stays possible, and its release
    // frees the record.
    PROCESS_RECORDS[slot].refs = 1
    // Nobody is watching a process that does not exist yet. This record may be
    // a reclaimed one, so every field a previous occupant wrote is reset here.
    // It cannot arrive non-zero (an attachment is a counted reference, so a
    // watched record never reaches zero and never reclaims), but the reset is
    // where a reader looks to find that out.
    PROCESS_RECORDS[slot].attachment = 0
    // The final counters are written at the teardown and read only through a
    // `Gone` record, so a stale copy here could not be read; it is reset with
    // the rest.
    PROCESS_RECORDS[slot].final_stats = StatsRow(syscalls: 0, interrupts: 0,
                                                 faults: 0, pid: 0)
    // The columns open at zero. The body may be a reused one, and this is the
    // line that keeps a child from inheriting its predecessor's traffic and
    // reading a first `stats()` that describes a program it never was. It
    // clears the body's row of the shared region; a supervisor watching the
    // page sees the row go to zero exactly here.
    stats_clear(body)
    stats_name(body, pid)

    // The child's ledger opens here, after `place_image`: `free_rows` is what
    // this child's domain has left once its image has spent its own rows, and
    // the image's rows are recorded by that call. A child gets `kcore.limits`'
    // documented defaults; there is no per-create argument.
    install_quota_limits(slot, false,
                         (hal.GRANT_ROW_BUDGET as Int) - PROCESSES[body].grant_count)

    op_value(handle)
}

/// §2.7's `start(boot_tag:)`: phase two, and the whole of it.
///
/// It mints the first thread internally and hands out no handle for it: nobody
/// holds a child's thread, and what a child receives is what `give` put in its
/// table. The entry and the stack come out of the process body, recorded at
/// create, so root supplies neither, which keeps "root never parses" airtight.
///
/// The kernel resolves the tag to the child-side word, so `_start(boot_handle)`
/// is unchanged and root never sees a child-relative word. The resolution is
/// here rather than in the give's return because the give answers with a status
/// alone: the word it minted means nothing to the giver, and the one place it
/// means something is the register the child wakes up with.
///
///   - `BootTagForm.Absent` leaves `NO_HANDLE` in a0. A sandboxed compute
///     process is a feature, not an error to detect.
///   - `BootTagForm.Present` resolves `tag` against the child's boot set. A tag
///     that names no given record is a `BadArg` fault: a config error, and the
///     caller chose both the tag it gave and the tag it started with.
///   - Resolution consumes the record. Putting the word in the child's first
///     argument register is the delivery, so the drain never answers with a
///     word the child already holds. That makes "a child cannot be handed one
///     word twice" a kernel property: two live wrappers over one word would be
///     two releases, and the second a fault the program did nothing to deserve.
///
/// The launch flow is mint, give, start, and `Start` does one thing. A launcher
/// mints a masked sibling of its own System handle (`MINT_OP` with a keep
/// mask), gives the sibling under a tag, and starts the child naming that tag.
/// It keeps the child's Process handle throughout, so it retains supervision
/// (`get_status`, the death wait) while the child holds its own authority.
///
/// The child bootstraps as root does (§12's symmetry): the first argument
/// register holds the word the start tag named (typically its System handle),
/// or `NO_HANDLE` for `Absent`; its own Process handle is derived through its
/// `ProcessSelf` right, and its boot set is drained from there.
///
/// Root keeps running. The thread goes on the ready queue and the caller
/// returns normally; the child runs when the scheduler next picks it, as with
/// `Thread.start`.
///
/// A second start is a `BadState` fault; the caller could have known, since it
/// started the child the first time. The same state word freezes the boot set:
/// a give after this point is the same `BadState`, which makes a half-populated
/// table unrepresentable.
func process_start(caller: Int, child: Int,
                   raw_form: UInt, tag: UInt) unsafe -> SyscallResult {
    // The form is a raw register word the process chose, so it is decoded (as
    // in `event_create` and `clock_get`): a number that is not a `BootTagForm`
    // is a caller error.
    guard let form = BootTagForm.from(raw: raw_form) else {
        fault_process(caller, FaultReason.BadArg)
    }
    match PROCESS_RECORDS[child].state {
        case Created -> {},
        case _ -> fault_process(caller, FaultReason.BadState),
    }

    // The statuses this op can answer with are taken before the record is
    // consumed, so a refusal leaves the boot set exactly as it was.
    // `alloc_thread` is a pure scan and reserves nothing, so an early return
    // leaks no slot either.
    //
    // The thread is the child's, so the child is charged: the launcher is not
    // spending one of its own threads but the first of the child's. This is the
    // same rule every other row follows: the slot's `process` field is who
    // pays.
    if not quota_room(child, QuotaKind.Thread) {
        return op_status(SosStatus.QuotaExceeded)
    }
    let slot = alloc_thread()
    if slot == NO_THREAD {
        return op_status(SosStatus.NoResource)
    }

    let boot_word = match form {
        case Absent -> NO_HANDLE,
        case Present -> {
            let w = boot_handle_take(child, tag)
            if w == NO_HANDLE {
                fault_process(caller, FaultReason.BadArg)
            }
            w
        },
    }

    let body = body_of(child)
    hal.frame_init(frame_slot(slot), PROCESSES[body].entry,
                   PROCESSES[body].stack_top, boot_word)
    // No handle names the child's first thread, so its count starts at zero:
    // it runs in its slot, and the child's `ThreadSelf` is what names it.
    THREADS[slot] = ThreadSlot(state: ThreadState.Runnable, process: child,
                               exit_code: 0,
                               joiners: 0, link: 0, wait_buf: 0,
                               call_pipe: 0, call_claim: 0, call_src: 0,
                               call_len: 0, refs: 0)
    quota_charge(child, QuotaKind.Thread)
    ready_push(slot)
    PROCESS_RECORDS[child].state = ProcessState.Running
    op_ok()
}

/// §2.7's `give(handle, tag:)`: unbind and rebind, narrowed by a keep mask.
/// This is the furnishing half of the launch flow.
///
/// A give is a move, not a mint. The fresh entry in the child's table carries
/// the same kind and target as the caller's, and its rights are the caller's
/// `& keep` (all-ones `keep` is rights verbatim): no default set is consulted
/// and nothing amplifies, so what root attenuated stays attenuated. A launcher
/// can also attenuate before it gives, by minting a masked sibling (`MINT_OP`)
/// and giving that. Mint narrows a capability inside one table; give moves one
/// between two. The caller's entry unbinds exactly as a release does,
/// generation bump included, so the giver's word is stale the instant the op
/// returns and later use is the diagnosed `BadHandle` fault.
///
/// The order of checks is the contract: every fault first, then the capacity
/// status, then the move. A fault leaves both tables unchanged, and the
/// capacity refusal also leaves the caller's entry as it was, because the mint
/// into the child happens before the unbind. A full child table is a give that
/// did not happen, not a capability lost between two tables.
///
///   - The given handle must resolve: `BadHandle`.
///   - It must carry the universal `Transfer` bit: `AccessDenied`. This is
///     checked here, where the entry is known and the kind is not, at the
///     altitude `RELEASE_OP` is intercepted at.
///   - The child must still be `Created`: `BadState`. The boot set freezes at
///     start, and that ordering is the soundness argument: a child's boot
///     handles must answer completely at its first instruction, and start is
///     the barrier that makes a half-populated table unrepresentable without
///     any synchronization. Dynamic transfer is for IPC over pipes.
///   - The tag must be unused in the child's set: `DuplicateKey`. An identity
///     naming two handles would make the record a multimap and the lookup
///     ambiguous.
///   - A full child table (or boot set) is `NoResource`, a status, because a
///     dynamic resource running out is something a caller could not have known.
///
/// Giving to yourself needs no special case: a running process is not
/// `Created`, so `give` through your own Process handle is the same `BadState`
/// as a give after start.
func process_give(p: Int, child: Int, word: UInt, tag: UInt,
                  keep: UInt) unsafe -> SyscallResult {
    let entry = lookup_handle(p, word)
    let kind = give_faults(p, child, entry, tag)
    if not boot_handle_room(child) {
        return op_status(SosStatus.NoResource)
    }
    let given = move_handle(p, child, word, entry, kind, tag, keep)
    if given == NO_HANDLE {
        // The child's table refused it, either because it is full or because
        // the child is at its handle budget, which is what a launcher
        // furnishing too much needs to hear.
        return op_status(mint_refusal(child))
    }
    op_ok()
}

/// Every fault a transfer of `entry` into `child` under `tag` can raise, in
/// order, answering the record kind the move will use. Never returns on a
/// fault; touches nothing on any path.
///
/// It is split out of `process_give` so that the fault set and the effect read
/// as two separate things: everything here happens before anything below
/// `move_handle` touches a table.
func give_faults(p: Int, child: Int, entry: HandleEntry,
                 tag: UInt) unsafe -> BootHandleKind {
    match entry.obj_type {
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case _ -> {},
    }
    if not rights_allow_transfer(entry.rights) {
        fault_process(p, FaultReason.AccessDenied)
    }
    guard let kind = boot_kind_of(entry.obj_type) else {
        fault_process(p, FaultReason.BadArg)
    }
    match PROCESS_RECORDS[child].state {
        case Created -> {},
        case _ -> fault_process(p, FaultReason.BadState),
    }
    if boot_tag_used(child, tag) {
        fault_process(p, FaultReason.DuplicateKey)
    }
    kind
}

/// The move itself: bind in the child, unbind in the giver, append the record.
/// Answers the child-side word, or `NO_HANDLE` when the child's table was full,
/// in which case nothing happened and the giver's entry is untouched.
///
/// The two halves are ordered so the failing one cannot lose a capability: the
/// child-side binding is made first, so a full table is a refusal with the
/// caller's entry as it was, and only a successful mint is followed by the
/// unbind that makes the giver's word stale. The unbind is `unbind_handle`, the
/// same one release and the teardown use, so the generation bump covers a giver
/// exactly as it covers a releaser.
///
/// The child's rights are `entry.rights & keep`, never recomputed from a
/// default set, so what the giver attenuated stays attenuated.
///
/// The count goes up before it goes down, and the order is load-bearing. A give
/// is a move, so the object's reference count is the same on both sides, but it
/// is written as an increment then a decrement because "every bind refs, every
/// unbind unrefs" has no exceptions. The other order would take the count to
/// zero between two lines of one op and free the object the give was about to
/// hand over.
func move_handle(p: Int, child: Int, word: UInt, entry: HandleEntry,
                 kind: BootHandleKind, tag: UInt, keep: UInt) unsafe -> UInt {
    // The narrowing is truncating, not `as`, for `mint_sibling`'s reason:
    // `keep` is a register-wide word a process chose, and `as UInt32` on a
    // 64-bit profile would panic inside the kernel over a number userspace
    // picked. Rights are a 32-bit word, so the bits above it name no right and
    // dropping them changes no answer.
    let given = move_entry(p, child, word, entry, UInt32.from(truncating: keep))
    if given == NO_HANDLE {
        return NO_HANDLE
    }
    queue_boot_handle(child, tag, kind, given)
    given
}

/// The record `Process.BootHandleNext` answers with, in kernel memory.
///
/// Declaration order is the layout, so the field here and the word index
/// `sosabi` publishes are one description, pinned by the assert below.
struct BootHandleWire {
    tag: UInt,
    kind: UInt,
    handle: UInt,
}

static_assert(sizeof<BootHandleWire>() == BOOT_HANDLE_RECORD_WORDS * sizeof<UInt>(),
              "a boot handle record must be exactly the words sosabi publishes")

/// §12's boot set, one record at a time, out of the caller's own per-process
/// set.
///
/// Root drains records the kernel wrote at boot and a child drains records its
/// launcher wrote with `give`, through one op, one record layout and one
/// exhaustion rule. `p` is the caller, established by the dispatch before the
/// `BootHandles` right was checked.
///
/// Exhaustion is a status and it stays exhausted. A caller draining an iterator
/// ends by meeting the end, so faulting would kill the correct program; and the
/// cursor only advances, so a drained iterator answers `Drained` forever.
///
/// The record rides the existing copy-out funnel (three machine words) because
/// that door already answers the two questions an answer-in-memory poses: is
/// the buffer aligned, and is it inside the process's writable window.
///
/// It is consumed by delivery: the cursor advances only after the copy
/// succeeds, so "a record is handed over exactly once" is true rather than
/// nearly true.
func boot_handle_next(p: Int, dst: UInt, cap: UInt) unsafe -> SyscallResult {
    // A capacity below the record's size is outside the argument's domain and
    // the size is published, so the caller could have checked. Same rule and
    // diagnostic as `Waiter.Wait`.
    if cap < (boot_handle_record_bytes() as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    // The cursor first steps over anything `start(boot_tag:)` already delivered
    // through the register door: one record, one delivery, whichever door it
    // went out of.
    let cursor = boot_handle_cursor(p)
    let body = body_of(p)
    if cursor >= PROCESSES[body].boot_count {
        return op_status(SosStatus.Drained)
    }
    let queued = PROCESSES[body].boot_handles[cursor]
    var rec = BootHandleWire(tag: queued.tag, kind: queued.kind as UInt,
                             handle: queued.handle)
    if let why = copy_out(p, dst,
                          ((&var rec) as UnsafePointer<BootHandleWire>) as UInt,
                          boot_handle_record_bytes() as UInt) {
        fault_process(p, why)
    }
    PROCESSES[body].boot_next = cursor + 1
    op_ok()
}

// The record `Process.Stats` answers with is `sosabi.StatsRow`. The shared
// region is an array of the published row, so the op and the region are one
// declaration and cannot drift.

/// Copy `target`'s trap columns and pid into `p`'s buffer.
///
/// Two processes are involved, and the asymmetry is the op. `target` is whose
/// counters are read (the handle's record, so a supervisor asking about a
/// child names the child) and `p` is whose memory the answer lands in, always
/// the caller. Only the copy door consults `p`, which makes the self case and
/// the supervision case one function.
///
/// A live target's counters are its body's row of the region. A `Gone` one has
/// no body, and its counters are the copy its teardown left in the record,
/// final because nothing is charged to a process once its teardown has begun.
///
/// It costs nothing and allocates nothing, so no quota row is charged and no
/// `NoResource` path exists: the columns are already in the region and the
/// record is built on the kernel's own stack. The only failures a correct
/// caller can meet are the copy door's, and those terminate (a buffer outside
/// your own writable memory is a mistake only you could have made).
///
/// It is the compatibility floor for callers that do not want a mapping or do
/// not hold `SystemRight.StatsRegionMap`: they get the same numbers,
/// consistent by construction because, for a live process, this reads the very
/// storage the region publishes.
///
/// The call itself is counted before this runs: `ktrap` charges the syscall
/// column at trap entry, so a reading taken by the process it describes already
/// includes the trap that took it. The alternative would undercount by one at
/// exactly the moment anyone looks. A delta measured between two `stats()`
/// calls therefore counts the second call itself.
func process_stats(p: Int, target: Int, dst: UInt, cap: UInt) unsafe -> SyscallResult {
    // A capacity below the record's size is outside the argument's domain and
    // the size is published, so the caller could have checked. Same rule and
    // diagnostic as `Clock.Now`.
    if cap < (process_stats_record_bytes() as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    var rec = if has_body(target) {
        stats_read(body_of(target))
    } else {
        PROCESS_RECORDS[target].final_stats
    }
    // The pid is the record's: it is what a `Gone` process keeps, and a live
    // row's copy of it is written once at the create.
    rec.pid = PROCESS_RECORDS[target].pid
    if let why = copy_out(p, dst,
                          ((&var rec) as UnsafePointer<StatsRow>) as UInt,
                          process_stats_record_bytes() as UInt) {
        fault_process(p, why)
    }
    op_ok()
}

/// Make an Event owned by process `owner`, whose one handle goes into the
/// caller `p`'s table (spec §2.4, §2.7).
///
/// `owner` is the process the Process handle names, and it is charged for the
/// Event. `p` is who trapped: it holds the handle, pays for it on its `Handle`
/// row, and is the process any caller error faults. They are one process when a
/// process creates through its own handle.
///
/// The mode is a raw register word the caller chose, so it is decoded: a
/// number that is not a mode is a caller error and ends the caller, whichever
/// process the handle names. Through a `Gone` owner the answer is `Revoked`,
/// after that argument check (spec §2.10).
func event_create(p: Int, owner: Int, raw_mode: UInt) unsafe -> SyscallResult {
    guard let mode = EventMode.from(raw: raw_mode) else { fault_process(p, FaultReason.BadArg) }
    return event_create_moded(p, owner, mode)
}

func event_create_moded(p: Int, owner: Int, mode: EventMode) unsafe -> SyscallResult {
    if not has_body(owner) {
        return op_status(SosStatus.Revoked)
    }
    // Policy refuses before the machine is asked. This is the order every
    // allocation site follows: a process at its own budget gets
    // `QuotaExceeded`, and only a process still within it can meet the slab's
    // `NoResource`. The two are different facts and a caller can act on the
    // difference: releasing something it already holds fixes the first and
    // cannot fix the second. The object row is the owner's and the `Handle`
    // row is the caller's.
    if not quota_room(owner, QuotaKind.Event) {
        return op_status(SosStatus.QuotaExceeded)
    }
    // The caller's `Handle` row is policy too, so it is asked before the slab:
    // a caller at its budget facing a full slab hears `QuotaExceeded`.
    if not quota_room(p, QuotaKind.Handle) {
        return op_status(SosStatus.QuotaExceeded)
    }
    let slot = alloc_event()
    if slot == NO_EVENT {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_capped(p, ObjType.Event, event_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    // Written only once both allocations succeeded, so a refused handle leaves
    // the slab exactly as it found it. The charge joins that rule: a process
    // must not pay for an object it never got.
    EVENTS[slot] = EventSlot(state: SlotState.Live, process: owner, mode: mode,
                             word: 0, attachment: 0, refs: 1)
    quota_charge(owner, QuotaKind.Event)
    op_value(handle)
}

/// Bind `line` to a new Interrupt, whose one handle goes into caller `p`'s
/// table (spec §2 table, §9).
///
/// Three refusals, all faults on the caller, all caller-checkable:
///
///   - A line this machine does not have. A driver names a number out of its
///     own device's description, so a number outside the board's line space is
///     a mistake the caller could have checked.
///   - The timer's line. It is the scheduler's, and a process holding it could
///     mask the tick and never yield, which the object model does not offer. It
///     is checked here, arch-free, because it is kernel policy: which number
///     the timer uses is the machine's business, that it is not for rent is
///     not.
///   - A line already bound. Two Interrupts on one line would be two objects
///     with one `pending` between them and two acks for one fire, so the second
///     bind is refused rather than serialized. An invalid Interrupt does not
///     hold its line, so a line whose Interrupt was destroyed is free at once.
///
/// A full Interrupt slab is `NoResource`, with no Interrupt quota asked first:
/// there is no such row, because at most one Interrupt is live per line and the
/// slab bounds the rest. The new handle is charged to the caller's `Handle` row
/// by the mint, as any handle is.
///
/// The line is unmasked on success, the initial state §9's cycle needs
/// (mask-on-fire, ack-to-rearm): something has to arm it first and creation is
/// that something. The device's own interrupt-enable register is not touched;
/// that is the driver's, through the window it was granted.
func interrupt_bind(p: Int, line: UInt) unsafe -> SyscallResult {
    if line == hal.IRQ_TIMER || not hal.irq_line_valid(line) {
        fault_process(p, FaultReason.BadArg)
    }
    if interrupt_by_line(line) != NO_INTERRUPT {
        fault_process(p, FaultReason.LineBound)
    }

    let slot = alloc_interrupt()
    if slot == NO_INTERRUPT {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_capped(p, ObjType.Interrupt, interrupt_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    INTERRUPTS[slot] = InterruptSlot(state: InterruptState.Live, line: line,
                                     pending: false, attachment: 0, refs: 1)
    hal.irq_unmask(line)
    op_value(handle)
}

/// Make a Waiter owned by process `owner`, whose one handle goes into the
/// caller `p`'s table (spec §2.2, §2.7). The owner is charged for the Waiter
/// and the caller for the handle, as `event_create` describes. A `Gone` owner
/// answers `Revoked` (spec §2.10).
func waiter_create(p: Int, owner: Int) unsafe -> SyscallResult {
    if not has_body(owner) {
        return op_status(SosStatus.Revoked)
    }
    if not quota_room(owner, QuotaKind.Waiter) {
        return op_status(SosStatus.QuotaExceeded)
    }
    // The caller's `Handle` row is policy too, so it is asked before the slab:
    // a caller at its budget facing a full slab hears `QuotaExceeded`.
    if not quota_room(p, QuotaKind.Handle) {
        return op_status(SosStatus.QuotaExceeded)
    }
    let slot = alloc_waiter()
    if slot == NO_WAITER {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_capped(p, ObjType.Waiter, waiter_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    WAITERS[slot] = WaiterSlot(state: WaiterState.Live, process: owner,
                               attached: 0, blocked: 0, refs: 1)
    quota_charge(owner, QuotaKind.Waiter)
    op_value(handle)
}

/// Make a thread that runs in process `owner`, ready to be started, whose
/// handle goes into the caller `p`'s table (spec §2.7). The owner is charged
/// against its Thread row and the caller against its `Handle` row.
///
/// The entry must lie in a row of the owner's grants that permits execute, and
/// the stack in the owner's granted region, since that is where the thread
/// runs. Both are caller-checkable (a launcher knows where the image it
/// launched keeps its code and its stacks), so a bad one terminates the caller,
/// not the owner, rather than producing a thread that would fault on its first
/// instruction and take the owner down anyway, with a worse diagnostic.
///
/// A `Gone` owner answers `Revoked` (spec §2.10). It is asked before the
/// entry and the stack are checked: the check needs a body to read the region
/// from, and a `Gone` process has none. This is the one argument check that
/// follows `Revoked`; the rights check comes first as for every op.
func thread_create(p: Int, owner: Int, entry: UInt, stack_top: UInt,
                   arg: UInt) unsafe -> SyscallResult {
    if not has_body(owner) {
        return op_status(SosStatus.Revoked)
    }
    let body = body_of(owner)
    let start = if entry == ENTRY_IMAGE { PROCESSES[body].entry } else { entry }
    if not executable_at(owner, start) {
        fault_process(p, FaultReason.BadEntry)
    }
    if stack_top <= PROCESSES[body].region_base || stack_top > PROCESSES[body].region_top {
        fault_process(p, FaultReason.BadEntry)
    }

    // The thread row is credited when the slot is freed (`free_object`) or the
    // thread is invalidated (`invalidate_thread`), so it counts the slots the
    // process holds, exited ones still named included.
    if not quota_room(owner, QuotaKind.Thread) {
        return op_status(SosStatus.QuotaExceeded)
    }
    // The caller's `Handle` row is policy too, so it is asked before the slab:
    // a caller at its budget facing a full slab hears `QuotaExceeded`.
    if not quota_room(p, QuotaKind.Handle) {
        return op_status(SosStatus.QuotaExceeded)
    }
    let slot = alloc_thread()
    if slot == NO_THREAD {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_capped(p, ObjType.Thread, thread_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }

    hal.frame_init(frame_slot(slot), start, stack_top, arg)
    // The handle just minted is the first reference.
    THREADS[slot] = ThreadSlot(state: ThreadState.Created, process: owner,
                               exit_code: 0,
                               joiners: 0, link: 0, wait_buf: 0,
                               call_pipe: 0, call_claim: 0, call_src: 0,
                               call_len: 0, refs: 1)
    quota_charge(owner, QuotaKind.Thread)
    op_value(handle)
}

/// The Thread object's ops (§2, §8).
///
/// `Exit` and `Yield` are ops a thread performs on itself, so both check that
/// the handle names the caller (`NotSelf`): driving another thread's execution
/// is not something the object model offers, and a process that tries has
/// misread its own handles.
///
/// `Exit` also releases the handle it was invoked through (`exit_thread`):
/// that one entry is unbound and its reference dropped, every other handle
/// onto the thread keeps naming the `Exited` slot, and a thread nothing else
/// names is freed once it is off the processor.
///
/// An invalid thread (its process died before it exited, spec §2.10) answers
/// `Start` and `Join` with `Revoked`, after the rights check and the self-join
/// check fault as they would on a live thread. `Exit` and `Yield` through its
/// handle stay the `NotSelf` fault: an invalid thread never runs, so its handle
/// never names the caller, the rule a `Gone` process's self-only ops follow.
func thread_op(raw_op: UInt, obj: &ThreadObject, arg0: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = ThreadOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return thread_op_decoded(op, &obj, arg0, p)
}

func thread_op_decoded(op: ThreadOp, obj: &ThreadObject, arg0: UInt,
                       p: Int) unsafe -> SyscallResult {
    let target = obj.slot

    match op {
        case Start -> {
            if not obj.allows(ThreadRight.Start) {
                fault_process(p, FaultReason.AccessDenied)
            }
            match THREADS[target].state {
                case Created -> {},
                case Invalid -> { return op_status(SosStatus.Revoked) },
                case _ -> fault_process(p, FaultReason.BadState),
            }
            // No thread of a process runs before its `ProcessOp.Start`: a
            // thread made through a `Created` child's handle is inert until
            // the child is started, so starting it earlier is a caller error.
            // This is also why a `Created` child never ends by itself and a
            // `Gone` one was always started.
            match PROCESS_RECORDS[THREADS[target].process].state {
                case Created -> fault_process(p, FaultReason.BadState),
                case _ -> {},
            }
            THREADS[target].state = ThreadState.Runnable
            ready_push(target)
            op_ok()
        },
        case Join -> {
            if not obj.allows(ThreadRight.Join) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if target == CURRENT_THREAD {
                fault_process(p, FaultReason.BadState)
            }
            match THREADS[target].state {
                // Already gone: the answer is in the slot, so nothing parks.
                // `Exited` wins over the process's death (spec §2.10).
                case Exited -> op_value(THREADS[target].exit_code),
                // Its process died before it exited: there is no code to read
                // and nothing will ever exit.
                case Invalid -> op_status(SosStatus.Revoked),
                case Free -> fault_process(p, FaultReason.BadState),
                case _ -> {
                    block_on_join(CURRENT_THREAD, target)
                    op_blocked()
                },
            }
        },
        case Exit -> {
            if not obj.allows(ThreadRight.Control) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if target != CURRENT_THREAD {
                fault_process(p, FaultReason.NotSelf)
            }
            exit_thread(target, arg0, obj.handle)
            // No pair is ever written: this thread does not resume.
            op_blocked()
        },
        case Yield -> {
            if not obj.allows(ThreadRight.Control) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if target != CURRENT_THREAD {
                fault_process(p, FaultReason.NotSelf)
            }
            // The yielder does resume, right after the trapping instruction, so
            // its pair is written now; the requeue is `pick_next`'s, the one
            // place a thread is put back on the ready queue.
            NEED_RESCHED = true
            op_ok()
        },
    }
}

/// The Event object's ops (spec §2.4).
func event_op(raw_op: UInt, obj: &EventObject, arg0: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = EventOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return event_op_decoded(op, &obj, arg0, p)
}

func event_op_decoded(op: EventOp, obj: &EventObject, arg0: UInt,
                      p: Int) unsafe -> SyscallResult {
    let target = obj.slot

    match op {
        // Never blocks and never fails (§2.4): whatever the word holds, more
        // bits fit (the OR mode is idempotent and the sum saturates). That is
        // what makes it the fire-and-forget primitive, and why there is no
        // status to branch on.
        case Signal -> {
            if not obj.allows(EventRight.Signal) {
                fault_process(p, FaultReason.AccessDenied)
            }
            signal_event(target, arg0)
            op_ok()
        },
        // Drains and resets in one operation (§2.4). This is the non-blocking
        // door: an empty event answers zero rather than parking, since an Event
        // is not a queue and blocking is the Waiter's job. The blocking door is
        // a `Waiter.wait` delivery, which consumes the same word the same way
        // (`waitable_consume`); a process picks a door by whether it wants to
        // park, never by what it will be told.
        case Receive -> {
            if not obj.allows(EventRight.Receive) {
                fault_process(p, FaultReason.AccessDenied)
            }
            let word = EVENTS[target].word
            EVENTS[target].word = 0
            op_value(word)
        },
    }
}

/// The Interrupt object's ops (spec §2 table, §9).
func interrupt_op(raw_op: UInt, obj: &InterruptObject) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = InterruptOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return interrupt_op_decoded(op, &obj, p)
}

func interrupt_op_decoded(op: InterruptOp, obj: &InterruptObject,
                          p: Int) unsafe -> SyscallResult {
    let target = obj.slot

    match op {
        // §9's ack: end this fire and let the device interrupt again.
        //
        // Acking something that has not fired is a fault, and it is
        // caller-checkable. §9 allows at most one unacked fire per Interrupt,
        // and the driver learns about that fire through a wait it made. An ack
        // with nothing pending is therefore a driver that acked twice for one
        // fire, or acked before it waited; the next ack would land on a fire
        // nobody serviced, which shows up as a dropped byte or a wedged device
        // downstream. A tolerated no-op would hide that bug's first symptom.
        //
        // The unmask is last, per spec §9's release discipline: everything that
        // touches this object's state happens before the line can fire again.
        case Ack -> {
            if not obj.allows(InterruptRight.Ack) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if not INTERRUPTS[target].pending {
                fault_process(p, FaultReason.BadState)
            }
            INTERRUPTS[target].pending = false
            hal.irq_unmask(INTERRUPTS[target].line)
            op_ok()
        },
    }
}

/// The record `Clock.Now` answers with, in kernel memory.
///
/// Declaration order is the layout, so the field here and the doubleword index
/// `sosabi` publishes are one description, pinned by the assert below.
struct ClockNowRecord {
    now_ns: UInt64,
}

static_assert(sizeof<ClockNowRecord>()
              == CLOCK_NOW_RECORD_DOUBLEWORDS * sizeof<UInt64>(),
              "the clock reading must be exactly the doublewords sosabi publishes")

/// The record `Timer.Arm` reads out of the caller's memory. Same discipline,
/// running the other way.
struct TimerArmRecord {
    after_ns: UInt64,
    interval_ns: UInt64,
}

static_assert(sizeof<TimerArmRecord>()
              == TIMER_ARM_RECORD_DOUBLEWORDS * sizeof<UInt64>(),
              "the arm record must be exactly the doublewords sosabi publishes")

/// The Clock object's ops (spec §2.6).
func clock_op(raw_op: UInt, obj: &ClockObject, arg0: UInt,
              arg1: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = ClockOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return clock_op_decoded(op, &obj, arg0, arg1, p)
}

func clock_op_decoded(op: ClockOp, obj: &ClockObject, arg0: UInt, arg1: UInt,
                      p: Int) unsafe -> SyscallResult {
    match op {
        // The answer is a record, not the value register, because a nanosecond
        // count is 64 bits and one of the two profiles has 32-bit registers. It
        // rides the same copy-out door as `Waiter.Wait`'s answer; the door
        // checks the buffer.
        case Now -> {
            if not obj.allows(ClockRight.Read) {
                fault_process(p, FaultReason.AccessDenied)
            }
            clock_now(p, obj.slot, arg0, arg1)
        },
        // The Timer binds this Clock at creation, which is why creation lives
        // on the Clock rather than on the Process beside the other factory ops:
        // the authority and the binding are one act, and a Timer made through a
        // Process handle would have no domain to measure against.
        case TimerCreate -> {
            if not obj.allows(ClockRight.TimerCreate) {
                fault_process(p, FaultReason.AccessDenied)
            }
            timer_create(p, obj.slot)
        },
    }
}

/// Read clock `slot` into the caller's buffer.
///
/// The domain decides the reading, which is why the slot is passed in rather
/// than the reading being taken straight off the machine. The match is
/// exhaustive, so a new `ClockType` fails to compile here until somebody says
/// what its reading is.
func clock_now(p: Int, slot: Int, dst: UInt, cap: UInt) unsafe -> SyscallResult {
    // A capacity below the record's size is outside the argument's domain and
    // the size is published, so the caller could have checked. Same rule and
    // diagnostic as `Waiter.Wait`.
    if cap < (clock_now_record_bytes() as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    let reading = match CLOCKS[slot].kind {
        case Monotonic -> hal.timer_now_ns(),
    }
    var rec = ClockNowRecord(now_ns: reading)
    // The door reports a refused destination and the caller terminates on it. A
    // fault is a scheduling event, so the kill lives above the switch point.
    if let why = copy_out(p, dst, ((&var rec) as UnsafePointer<ClockNowRecord>) as UInt,
                          clock_now_record_bytes() as UInt) {
        fault_process(p, why)
    }
    op_ok()
}

/// Make a Timer bound to clock `c` in process `p` (spec §2.6).
func timer_create(p: Int, c: Int) unsafe -> SyscallResult {
    if not quota_room(p, QuotaKind.Timer) {
        return op_status(SosStatus.QuotaExceeded)
    }
    let slot = alloc_timer()
    if slot == NO_TIMER {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_capped(p, ObjType.Timer, timer_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    // Born disarmed and owing nothing: a Timer is a schedule not yet written,
    // so it is not ready, and attaching one to a Waiter before arming it parks
    // rather than reporting.
    TIMERS[slot] = TimerSlot(state: TimerState.Live, process: p, clock: c,
                             armed: false, deadline_ns: 0, interval_ns: 0,
                             fires: 0, attachment: 0, refs: 1)
    quota_charge(p, QuotaKind.Timer)
    op_value(handle)
}

/// The Timer object's ops (spec §2.6).
///
/// An invalid Timer (its owner died while this handle named it, spec §2.10)
/// answers `Arm` and `Disarm` with `Revoked`, after the rights check and, for
/// `Arm`, the record's checks fault as they would on a live Timer.
func timer_op(raw_op: UInt, obj: &TimerObject, arg0: UInt,
              arg1: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = TimerOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return timer_op_decoded(op, &obj, arg0, arg1, p)
}

func timer_op_decoded(op: TimerOp, obj: &TimerObject, arg0: UInt, arg1: UInt,
                      p: Int) unsafe -> SyscallResult {
    let target = obj.slot

    match op {
        // One right for both, because they are one capability: the power to
        // decide when this timer fires. See `TimerRight`.
        case Arm -> {
            if not obj.allows(TimerRight.Arm) {
                fault_process(p, FaultReason.AccessDenied)
            }
            timer_arm(p, target, arg0, arg1)
        },
        case Disarm -> {
            if not obj.allows(TimerRight.Arm) {
                fault_process(p, FaultReason.AccessDenied)
            }
            timer_disarm(target)
        },
    }
}

/// §2.6's `arm(after, interval)`, taken through the copy-in door.
///
/// Everything below validates what a process handed over and turns a relative
/// delay into an absolute deadline. `TimerSlot.arm` defines what the schedule
/// then means, including why re-arming an armed timer is legal.
func timer_arm(p: Int, slot: Int, src: UInt, bytes: UInt) unsafe -> SyscallResult {
    // The length is published, so a caller that got it wrong could have checked
    // (`Waiter.Wait`'s capacity rule, running inward). It is exact rather than
    // at-least: an inbound record is the whole of what the op was told, and a
    // caller handing over more than the kernel reads has misunderstood the
    // call.
    if bytes != (timer_arm_record_bytes() as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    var rec = TimerArmRecord(after_ns: 0, interval_ns: 0)
    if let why = copy_in(p, ((&var rec) as UnsafePointer<TimerArmRecord>) as UInt,
                         src, bytes) {
        fault_process(p, why)
    }
    if timer_invalid(slot) {
        return op_status(SosStatus.Revoked)
    }

    let now = hal.timer_now_ns()
    // Saturating, because `now + after` is arithmetic on a number the process
    // chose and overflow checks are on in the kernel. A deadline past the end
    // of time is the end of time, a schedule nothing will ever see fire: the
    // honest answer, not a panic.
    let deadline = if rec.after_ns > NEVER_NS - now { NEVER_NS } else { now + rec.after_ns }

    TIMERS[slot].arm(deadline, rec.interval_ns)
    reprogram_timer()
    op_ok()
}

/// §2.6's `disarm()`: this timer is off and owes nothing.
///
/// Disarming an unarmed timer is a no-op, not a fault. That is the opposite
/// call from §9's ack-with-no-fire. An extra ack is provably a bug: the only
/// way to learn about a fire is to be told about one, so the caller had the
/// information. A disarm's precondition is not like that: a one-shot disarms
/// itself when it fires, so "is it still armed" is kernel state that changed
/// without the caller acting. Cancelling a timeout that has just expired is the
/// ordinary race at the heart of every select-with-timeout, and faulting it
/// would make the safe idiom unwritable.
///
/// It clears the fire count as well as the schedule, which makes it a clean
/// cancel: a caller who wants the fires reads them with a wait first.
func timer_disarm(slot: Int) unsafe -> SyscallResult {
    if timer_invalid(slot) {
        return op_status(SosStatus.Revoked)
    }
    TIMERS[slot].disarm()
    reprogram_timer()
    op_ok()
}

/// Whether Timer `slot` is invalid: its owner died while a handle or an
/// attachment elsewhere named it (spec §2.10).
func timer_invalid(slot: Int) unsafe -> Bool {
    match TIMERS[slot].state {
        case Invalid -> true,
        case Live -> false,
        case Free -> false,
    }
}

/// Resolve `handle` as something this caller may attach to a Waiter, or
/// terminate the process.
///
/// This is the one place waitability is decided, and it decides the rights
/// check with it, because they are one question. Whether a handle may be
/// attached depends on its kind, and which enum a rights word is read against
/// depends on the kind too (§3), so a separate waitability predicate would have
/// to be joined back to a per-kind rights check at every call site. Here
/// the match that establishes the kind is the match that spends the right.
///
/// Every case is spelled out rather than falling through a `_`, so a kind that
/// becomes waitable fails to compile until somebody answers for it. A `_` arm
/// would hide that entirely, since a kind moving from "not waitable" to
/// "waitable" is not a new case at all.
func waitable_slot(p: Int, handle: UInt) unsafe -> Waitable {
    let entry = lookup_handle(p, handle)
    match entry.obj_type {
        case Event -> {
            let ev = EventObject(handle: EventHandle(handle),
                                 rights: entry.rights, slot: entry.target)
            if not ev.allows(EventRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            Waitable(kind: WaitableKind.Event, slot: entry.target)
        },
        // §2.2 lists Interrupt among the waitables and §9's delivery model is a
        // driver parked on one. The right it spends is `InterruptRight.Wait`, a
        // different enum from the Event arm's, which is why waitability and the
        // rights check are one question.
        case Interrupt -> {
            let irq = InterruptObject(handle: InterruptHandle(handle),
                                      rights: entry.rights, slot: entry.target)
            if not irq.allows(InterruptRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            Waitable(kind: WaitableKind.Interrupt, slot: entry.target)
        },
        // The right it spends is `TimerRight.Wait`, a third enum again.
        case Timer -> {
            let t = TimerObject(handle: TimerHandle(handle),
                                rights: entry.rights, slot: entry.target)
            if not t.allows(TimerRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            Waitable(kind: WaitableKind.Timer, slot: entry.target)
        },
        // A Process is waitable (spec §8). The bit it spends is
        // `ProcessRight.Wait`, the same bit `GetStatus` spends: being woken by
        // a death and asking about one are one question at two tempos, and a
        // second bit would let a supervisor poll a death it may not be told
        // about.
        //
        // A Process may be attached while it is still alive, the ordinary
        // supervisor shape: readiness is `state == Gone`, so an attachment onto
        // a running child is simply not ready yet. It may also be attached when
        // already dead; see `waitable_consume`.
        case Process -> {
            let pr = ProcessObject(handle: ProcessHandle(handle),
                                   rights: entry.rights, slot: entry.target)
            if not pr.allows(ProcessRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            Waitable(kind: WaitableKind.Process, slot: entry.target)
        },
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case System -> fault_process(p, FaultReason.NotWaitable),
        // A Thread is not waitable. §8 names both halves of the Process/Thread
        // pair, but a waitable Thread would serve safe stack reclamation when a
        // dynamic pool scales down, which nothing here does, and
        // `ThreadOp.Join` already answers the question a fixed pool asks. The
        // refusal is a scope line, not an oversight.
        case Thread -> fault_process(p, FaultReason.NotWaitable),
        case Waiter -> fault_process(p, FaultReason.NotWaitable),
        // A Clock is not waitable: it is always running, so "ready" would be
        // either permanently true or meaningless. Waiting for a time is what
        // the Timer it creates is for.
        case Clock -> fault_process(p, FaultReason.NotWaitable),
        // None of the three memory kinds is waitable. A region and a window
        // have no state (they are sealed pairs, and ops on them succeed or
        // fault immediately). A Mapping has state (installed or not) but no
        // readiness: it changes only when its holder asks, so a wait on one
        // could only report what the caller just did. What would make memory
        // waitable is a fault or a revocation arriving from elsewhere, and
        // neither exists until a supervisor can revoke somebody else's mapping.
        case Memory -> fault_process(p, FaultReason.NotWaitable),
        case IoMemory -> fault_process(p, FaultReason.NotWaitable),
        case Mapping -> fault_process(p, FaultReason.NotWaitable),
        // The four pipe kinds are waitable (§2.2's waitable list ends here).
        // Each spends its own kind's `Wait` right, out of its own rights enum,
        // which is why this function does waitability and the rights check in
        // one match.
        //
        // The slot is the connection for the two endpoints and the exchange for
        // the two one-shots, which is what `entry.target` already carries: the
        // wait machinery inherits the identity the handle table established.
        case PipeInlet -> {
            let inlet = PipeInletObject(handle: PipeInletHandle(handle),
                                        rights: entry.rights, slot: entry.target)
            if not inlet.allows(PipeInletRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            Waitable(kind: WaitableKind.PipeInlet, slot: entry.target)
        },
        case PipeOutlet -> {
            let outlet = PipeOutletObject(handle: PipeOutletHandle(handle),
                                          rights: entry.rights,
                                          slot: entry.target)
            if not outlet.allows(PipeOutletRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            Waitable(kind: WaitableKind.PipeOutlet, slot: entry.target)
        },
        case PipeReply -> {
            let claim = PipeReplyObject(handle: PipeReplyHandle(handle),
                                        rights: entry.rights, slot: entry.target)
            if not claim.allows(PipeReplyRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            Waitable(kind: WaitableKind.PipeReply, slot: entry.target)
        },
        case PipeRequest -> {
            let obligation = PipeRequestObject(handle: PipeRequestHandle(handle),
                                               rights: entry.rights,
                                               slot: entry.target)
            if not obligation.allows(PipeRequestRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            Waitable(kind: WaitableKind.PipeRequest, slot: entry.target)
        },
    }
}

/// The Waiter object's ops (spec §2.2).
///
/// An invalid Waiter (its owner died while this handle named it, spec §2.10)
/// answers `Add`, `Remove` and `Wait` with `Revoked`, after the rights check
/// and each op's argument checks fault as they would on a live Waiter: `Add`'s
/// flags and target handle, `Wait`'s buffer.
func waiter_op(raw_op: UInt, obj: &WaiterObject, arg0: UInt, arg1: UInt,
               arg2: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = WaiterOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return waiter_op_decoded(op, &obj, arg0, arg1, arg2, p)
}

func waiter_op_decoded(op: WaiterOp, obj: &WaiterObject, arg0: UInt, arg1: UInt,
                       arg2: UInt, p: Int) unsafe -> SyscallResult {
    let w = obj.slot

    match op {
        case Add -> {
            if not obj.allows(WaiterRight.Attach) {
                fault_process(p, FaultReason.AccessDenied)
            }
            waiter_add(p, w, arg0, arg1, arg2)
        },
        case Remove -> {
            if not obj.allows(WaiterRight.Attach) {
                fault_process(p, FaultReason.AccessDenied)
            }
            waiter_remove(p, w, arg0)
        },
        case Wait -> {
            if not obj.allows(WaiterRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            waiter_wait(p, w, arg0, arg1)
        },
    }
}

/// §2.2's `add(handle, key)`: a persistent attachment, at most one Waiter per
/// object.
///
/// Attaching something already attached terminates the process, through
/// whichever process's handle attached it. It is the one-Waiter rule, a
/// contract on the object that binds every holder: holders of one object must
/// agree which of them attaches it, so a violation is a program error.
///
/// The `flags` word has two orthogonal bits:
///
///   - `WAITER_ADD_ONESHOT`: the attachment detaches at delivery (never at mere
///     readiness). It is recorded on the attachment because it is the
///     attacher's choice, like the key, and nothing about the waitable changes.
///   - `WAITER_ADD_CONSUMING`: the op releases the caller's handle entry, and
///     the attachment owns the object from here on. It is the transfer funnel's
///     kernel half: one op rather than an add followed by a release, which
///     would cost the very trap the pattern exists to save. On an Interrupt
///     target it is a `BadArg` fault: the handle is the Interrupt's one name.
///
/// A word with any other bit set is a `BadArg` fault (§5.7): the set is
/// published, so the caller could have checked.
///
/// The order of the last two steps matters. The attachment takes its reference
/// before the consuming release drops the caller's, so the object never passes
/// through zero in the middle of its own attach; and the release happens before
/// the level-triggered wake, so a delivery that fires immediately sees the
/// final reference picture. That lets an already-ready consuming attach settle
/// its exchange in one act instead of leaving a slot held by an entry that no
/// longer exists.
///
/// A refusal consumes nothing. Every early return above the commit leaves the
/// caller's handle exactly as it was, which the typed `Waiter.give` rests on
/// when it hands the object back in its `Err`.
///
/// An invalid Waiter answers `Revoked` once the flags and the target have
/// passed their checks, and before the one-Waiter and duplicate-key checks:
/// those ask about the Waiter's attachments, and an invalid Waiter has none
/// and never will (spec §2.10: an op on an invalid object answers a status).
/// So attaching an already-attached object through an invalid Waiter answers
/// `Revoked` rather than faulting.
func waiter_add(p: Int, w: Int, handle: UInt, key: UInt,
                flags: UInt) unsafe -> SyscallResult {
    if (flags & ~WAITER_ADD_FLAGS) != 0 {
        fault_process(p, FaultReason.BadArg)
    }
    let target = waitable_slot(p, handle)
    // An Interrupt is the one waitable that cannot be consumed: its handle is
    // its one name and the only thing that can `Ack` it, so an attachment that
    // owned it would leave a driver with a line it can never acknowledge. The
    // flags asked for something the target's kind excludes, which the caller
    // could have checked.
    if (flags & WAITER_ADD_CONSUMING) != 0 {
        match target.kind {
            case Interrupt -> fault_process(p, FaultReason.BadArg),
            case _ -> {},
        }
    }
    // Nothing is attached, consumed or woken: the caller keeps its handle, as
    // on every refusal here.
    if waiter_invalid(w) {
        return op_status(SosStatus.Revoked)
    }
    if waitable_attachment(target.kind, target.slot) != 0 {
        fault_process(p, FaultReason.BadState)
    }
    // Keys are unique per waiter. A duplicate would make two questions
    // ambiguous at once (which attachment a `Remove` names, and which one an
    // answer came from), and the attacher chose both keys, so it is
    // caller-checkable.
    if attached_by_key(w, key) != NO_ATTACHMENT {
        fault_process(p, FaultReason.DuplicateKey)
    }

    let a = alloc_attachment()
    if a == NO_ATTACHMENT {
        return op_status(SosStatus.NoResource)
    }
    ATTACHMENTS[a] = Attachment(state: SlotState.Live, kind: target.kind,
                                target: target.slot, waiter: w, key: key,
                                oneshot: (flags & WAITER_ADD_ONESHOT) != 0,
                                owns: (flags & WAITER_ADD_CONSUMING) != 0,
                                link: WAITERS[w].attached)
    WAITERS[w].attached = a + 1
    set_waitable_attachment(target.kind, target.slot, a + 1)
    // An attachment is a reference to the waitable, which keeps an Event alive
    // past its last handle: a Waiter is watching it, and something being
    // watched is still in use. The Waiter is not referenced back (it owns the
    // attachment), and that asymmetry is what makes the cascade terminate.
    ref_waitable(target.kind, target.slot)

    // The consuming half. The caller's entry is destroyed here, by the op: the
    // transfer-funnel contract reached through an attach rather than a `give`,
    // using `consume_entry`'s two calls in `release_handle`'s order. The
    // attachment took its reference one line up, so the object cannot pass
    // through zero between the two. What is left is an object the attachment
    // owns and no handle names, an opt-in state rather than an accident.
    if (flags & WAITER_ADD_CONSUMING) != 0 {
        unbind_handle(p, handle_word_index(handle))
        unref_object(waitable_obj_of(target.kind), target.slot)
    }

    // Level-triggered at the attach (§2.2). A waitable that is already ready
    // when it joins the set is ready now, and a thread parked on this Waiter
    // has to learn about it; otherwise "signal, then attach, then wait" would
    // lose the notification. It covers an Interrupt that fired before anyone
    // attached, the ordering a driver hits at bring-up.
    //
    // It runs after the consuming release, and the order matters: a reply
    // delivered here detaches and drops the attachment's reference, and only if
    // the caller's entry is already gone does that take the claim's column to
    // zero and settle the exchange. The other order would leave a
    // settled-but-for-one-entry ring slot held by a handle the very next line
    // destroys.
    if waitable_ready(target.kind, target.slot) {
        wake_one_waiter(w, a)
    }
    op_ok()
}

/// Whether Interrupt `slot` is invalid: its one name went while an attachment
/// still held it (spec §2.10).
func interrupt_invalid(slot: Int) unsafe -> Bool {
    match INTERRUPTS[slot].state {
        case Invalid -> true,
        case Live -> false,
        case Free -> false,
    }
}

/// Whether Waiter `w` is invalid: its owner died while a handle elsewhere named
/// it (spec §2.10).
func waiter_invalid(w: Int) unsafe -> Bool {
    match WAITERS[w].state {
        case Invalid -> true,
        case Live -> false,
        case Free -> false,
    }
}

/// The wait machinery's kind, as the object kind the handle table speaks.
///
/// This duplicates `kcore.refs`' private translation, because the consuming
/// attach is the one site that needs it above that file. Both are total, so a
/// new waitable kind fails both to compile; that is what makes two spellings
/// safe where a cast between two differently-numbered enums would not be.
func waitable_obj_of(kind: WaitableKind) -> ObjType {
    match kind {
        case Event -> ObjType.Event,
        case Interrupt -> ObjType.Interrupt,
        case Timer -> ObjType.Timer,
        case Process -> ObjType.Process,
        case PipeOutlet -> ObjType.PipeOutlet,
        case PipeInlet -> ObjType.PipeInlet,
        case PipeReply -> ObjType.PipeReply,
        case PipeRequest -> ObjType.PipeRequest,
    }
}

/// §2.2's `remove(key)`. Removing a key this Waiter does not use is a caller
/// error, on the same terms as attaching twice.
///
/// The attachment is named by key and the waitable is never touched, so no
/// handle is resolved and no right on the waitable is spent: detaching edits
/// this Waiter's own table, and the already-validated Waiter handle plus the
/// key is all the authority needed. A handle-based remove could not reach the
/// stale attachment of a waitable whose handle has been closed.
func waiter_remove(p: Int, w: Int, key: UInt) unsafe -> SyscallResult {
    // An invalid Waiter has no attachments, so no key names one; the answer is
    // that the Waiter is gone, not that the caller misnamed a key.
    if waiter_invalid(w) {
        return op_status(SosStatus.Revoked)
    }
    let a = attached_by_key(w, key)
    if a == NO_ATTACHMENT {
        fault_process(p, FaultReason.BadState)
    }
    // Read what was watched before the detach clears it: the reference being
    // dropped is the attachment's, and the attachment is about to stop
    // existing. A waitable whose last handle went while it was attached reaches
    // zero here and frees.
    let watched = ATTACHMENTS[a].kind
    let target = ATTACHMENTS[a].target
    detach_attachment(w, a)
    unref_waitable(watched, target)
    op_ok()
}

/// §2.2's `wait(buffer, capacity)`: block until an attached handle is ready,
/// then copy out a record naming the key its attacher supplied and what fired.
///
/// The answer is a record in the caller's memory, not registers; the status
/// register still says how the call went.
///
/// The buffer is validated on the call, even on the path that parks and will
/// not use it for a while: terminating a bad-buffer caller while it is the
/// running process is a better diagnostic than faulting it out of some later
/// thread's wake.
///
/// The scan comes first (the level-triggered guarantee): a signal that arrived
/// before this call is still in the word, so the wait returns immediately. Only
/// an empty set parks.
func waiter_wait(p: Int, w: Int, dst: UInt, cap: UInt) unsafe -> SyscallResult {
    // A capacity below the record's size is outside the argument's domain; the
    // size is published, so the caller could have checked.
    if cap < (wait_record_bytes() as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    if let why = copy_out_check(p, dst, wait_record_bytes() as UInt) {
        fault_process(p, why)
    }
    // Nothing could ever wake a thread parked on an invalid Waiter, so the
    // wait is answered at once, with no record.
    if waiter_invalid(w) {
        return op_status(SosStatus.Revoked)
    }

    let ready = waiter_ready_attachment(w)
    if ready != NO_ATTACHMENT {
        // A delivery can refuse: it mints the obligation and every handle the
        // message carried, so a table with no room answers the table-full
        // status and delivers nothing. The message stays staged and its level
        // stays raised, so a caller that frees a slot and waits again is handed
        // the same message.
        return op_status(deliver_attachment(p, dst, ready))
    }
    if CURRENT_THREAD == NO_THREAD {
        fault_process(p, FaultReason.BadState)
    }
    block_on_wait(CURRENT_THREAD, w, dst)
    op_blocked()
}

/// `RELEASE_OP`: destroy the caller's handle, whatever kind it named.
///
/// Ungated: no right is checked, on any kind. A handle is a capability instance
/// and identity lives in the object's slot, so destroying your own instance
/// takes nothing from anyone else. Releasing your System or Process handle is
/// legal; you lose the authority, which is what you asked for. A gate, if ever
/// wanted, must be a new universal bit, not a retasking of an existing one.
///
/// A word that does not resolve is the ordinary `BadHandle` fault: `NO_HANDLE`,
/// a malformed word, a stale word whose generation has moved, and a second
/// release of the same word all arrive here as `Unbound` and end the process.
///
/// The object itself is not touched beyond dropping a reference (see
/// `unref_object`, which frees at zero), and `unbind_handle` is shared with the
/// teardown close-all. A released entry naming a `Gone` Process may have been
/// the last possible reader of its §8 status word, so dropping the last
/// reference reclaims the slot. The unref runs after the unbind so that
/// nothing in its cascade can find the released entry by lookup.
func release_handle(p: Int, word: UInt, entry: HandleEntry) unsafe -> SyscallResult {
    match entry.obj_type {
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case _ -> {},
    }
    unbind_handle(p, handle_word_index(word))
    // The object loses a reference, which may be its last. `unref_object` is
    // the per-kind matrix: an Interrupt masks its line, a Timer gives the
    // comparator back, a Waiter detaches its list, a Memory returns its slot,
    // and a `Gone` Process's record is reclaimed.
    //
    // This runs after the unbind: nothing in the cascade may find the released
    // entry by lookup (a settle can resume a parked caller, which re-reads
    // handle words).
    unref_object(entry.obj_type, entry.target)
    op_ok()
}

/// Whether the object `slot` of `kind` is invalid (spec §2.10): bound to a
/// process that died, so that its ops answer `Revoked`. Each kind with an
/// invalid state has an arm here; a `Gone` Process is not one.
func object_invalid(kind: ObjType, slot: Int) unsafe -> Bool {
    match kind {
        case Thread -> THREADS[slot].state == ThreadState.Invalid,
        case Mapping -> MAPPINGS[slot].row == ROW_TARGET_DIED,
        case Waiter -> waiter_invalid(slot),
        case Timer -> timer_invalid(slot),
        // No handle names an invalid Interrupt (releasing the last name is what
        // invalidates it), and `MINT_OP` faults on the missing `Mint` right
        // before it asks, so no path reaches this arm. It keeps the match
        // total over the kinds that have an invalid state.
        case Interrupt -> interrupt_invalid(slot),
        case _ -> false,
    }
}

/// `MINT_OP`: a sibling handle onto the same object, in the caller's own table,
/// with rights the caller may only narrow.
///
/// Universal for the same reason as release: naming an object twice is the same
/// act for every kind, so the dispatch intercepts it where the entry is known
/// and the kind is not yet.
///
/// The mask is a keep set: `new = held & keep`, and all-ones means "same
/// rights". The intersection makes no-amplification structural, since a sibling
/// is a subset of its source by construction and a garbage mask cannot widen
/// anything. It is total: naming a right the source does not hold is a no-op,
/// so one policy mask can apply to handles of several kinds. A keep mask fails
/// closed when a kind gains a right later, where a removal mask would pass the
/// new authority through. `sosabi`'s `MINT_OP` carries the full argument.
///
/// Gated on the universal `Mint` bit, which is itself maskable, so a launcher
/// can hand out a sibling that cannot mint further. A source that does not
/// resolve is the ordinary `BadHandle`; a source without `Mint` is
/// `AccessDenied`.
///
/// The result is independent: its own slot, generation and release. It names
/// the same object, so it is a second name rather than a second object.
///
/// A source naming an invalid object answers `Revoked`, a status, after the
/// rights check (spec §2.10). A `Gone` Process is not invalid for this: its
/// record still answers `GetStatus`, `Stats` and attachments, so a sibling to
/// it stays allowed.
///
/// A full table is `NoResource`, a status: a caller could not have known.
func mint_sibling(p: Int, entry: HandleEntry, keep: UInt) unsafe -> SyscallResult {
    match entry.obj_type {
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case _ -> {},
    }
    if not rights_allow_mint(entry.rights) {
        fault_process(p, FaultReason.AccessDenied)
    }
    if object_invalid(entry.obj_type, entry.target) {
        return op_status(SosStatus.Revoked)
    }
    // The mask is a keep set and the operation an intersection, so the result
    // is a subset of the source by construction, not by a check somebody could
    // forget. Naming a right the source does not hold is a no-op; there is no
    // over-ask to fault on.
    //
    // The narrowing truncates rather than using `as`: `keep` is a register-wide
    // word a process chose, and an `as UInt32` on a 64-bit target would panic
    // inside the kernel over a number userspace picked. Rights are a 32-bit
    // word, so the bits above it name no right and dropping them changes no
    // answer. `handle_word_generation` refuses to narrow because its bits mean
    // something.
    let rights = entry.rights & UInt32.from(truncating: keep)
    let word = mint_handle(p, entry.obj_type, rights, entry.target)
    if word == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    // A sibling is a second name and so a second reference: releasing one of
    // two siblings leaves the object alive, and the second release ends it.
    ref_object(entry.obj_type, entry.target)
    op_value(word)
}

/// The `HandleKind` spelling of a bound kind. `ObjType` is renumberable
/// bookkeeping and `HandleKind` crosses the trap boundary, so neither is a cast
/// of the other, and this match is the translation. An `Unbound` entry names no
/// kind, so it is a `BadHandle` fault.
func handle_kind_of(p: Int, kind: ObjType) unsafe -> HandleKind {
    match kind {
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case _ -> handle_kind(kind),
    }
}

/// `INFO_OP`: one fact about the caller's own handle, chosen by `selector`, a
/// `HandleInfo` number.
///
/// Universal for release's reason, so the dispatch intercepts it where the
/// entry is known and the kind is not yet. It is ungated: it describes the
/// caller's own handle, not the object, and every op on the object is still
/// checked on use. It reads the entry and never the object, so a handle to an
/// invalid object answers normally; `Revoked` belongs to ops on the object. A
/// word that does not resolve is the ordinary `BadHandle`, and a selector that
/// is not a `HandleInfo` is `BadArg`, both faults the caller could have
/// avoided. The answer is the entry's rights word or the `HandleKind` number,
/// and the op changes nothing.
func handle_info(p: Int, entry: HandleEntry,
                 selector: UInt) unsafe -> SyscallResult {
    match entry.obj_type {
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case _ -> {},
    }
    guard let which = HandleInfo.from(raw: selector) else {
        fault_process(p, FaultReason.BadArg)
    }
    match which {
        case Rights -> op_value(entry.rights as UInt),
        case Kind -> op_value(handle_kind_of(p, entry.obj_type) as UInt),
    }
}

// =============================================================================
// Memory, IoMemory and Mapping (spec §2.5)
// =============================================================================
//
// A mapping is an installed grant row: the grant record the scheduler loads is
// the same record `map` edits, `load_domain` is the same installer, and a
// Mapping object is a handle onto one row of it. (Where the address comes from
// depends on the tier, spec §5.5: on a tier that does not translate an address
// is the same number in every process, and on a translating tier `map` answers
// with the address it chose.)
//
// Three things are shared by the ops below and written once:
//
//   - the access vocabulary, translated rather than cast (`grant_perms`);
//   - target resolution, which spends `ProcessRight.Map` on a process the
//     caller named (`map_target`);
//   - the install itself, in one place so that a RAM row and a device row
//     cannot be recorded differently (`install_row`).

/// Translate `MapAccess` bits into the `SegFlag` vocabulary a grant row
/// carries.
///
/// This is a translation and not a cast on purpose. The two enums have the same
/// numbers, but writing the conversion out lets `sosabi` (the trap boundary's
/// vocabulary) and `imgformat` (the image format's) version apart; a cast would
/// silently tie an edit of either to the other.
func grant_perms(access: UInt32) -> UInt8 {
    var perms: UInt8 = 0
    if (access & (MapAccess.Read as UInt32)) != 0 {
        perms = perms | (SegFlag.Read as UInt8)
    }
    if (access & (MapAccess.Write as UInt32)) != 0 {
        perms = perms | (SegFlag.Write as UInt8)
    }
    if (access & (MapAccess.Execute as UInt32)) != 0 {
        perms = perms | (SegFlag.Execute as UInt8)
    }
    perms
}

/// Decode and validate a caller's access word, or end the caller.
///
/// Four refusals, all `BadArg` faults and all checkable by the caller:
///
///   - A bit outside the three. There is no fourth access, so such a bit is a
///     number the caller made up.
///   - Write without read. Not a grant any target should install, and one
///     target reserves the encoding outright; this is the same rule
///     `imgformat.has_sane_perms` applies to an image, so there is one answer
///     to "what is a valid grant".
///   - Write and execute in one row. It costs nothing expressible: a double map
///     is allowed (two rows, two Mappings, no aliasing bookkeeping owed), so a
///     JIT-shaped pattern is an RW row here and an RX row there. Only the
///     single row a process could write and then fetch from is refused.
///   - No access at all. A row that permits nothing spends a protection slot to
///     say what default-deny already says.
///
/// This is the dynamic map's rule only. A process image's own segments arrive
/// through `place_image` with `SegFlag` bits validated by
/// `imgformat.has_sane_perms`, which refuses write-without-read and
/// execute-on-device but not W|X: an image's segments are kept apart by its
/// linker script, and that path is `SystemRight.ProcessCreate` authority.
func map_access(p: Int, raw: UInt) unsafe -> UInt32 {
    // Test the whole register first, in its own width, and only then narrow.
    // `raw` is a word a process chose, so an `as UInt32` on a 64-bit target
    // would panic inside the kernel over someone else's number. Testing first
    // refuses a bit set anywhere above the three instead of dropping it, and
    // makes the narrowing that follows exact.
    if (raw & (MAP_ACCESS_MASK as UInt)) != raw {
        fault_process(p, FaultReason.BadArg)
    }
    let access = UInt32.from(truncating: raw)
    // The parentheses around the whole condition are needed: an unbracketed
    // binary expression does not wrap across lines.
    if ((access & (MapAccess.Write as UInt32)) != 0
        && (access & (MapAccess.Read as UInt32)) == 0) {
        fault_process(p, FaultReason.BadArg)
    }
    // W^X per row; same parenthesization as above.
    if ((access & (MapAccess.Write as UInt32)) != 0
        && (access & (MapAccess.Execute as UInt32)) != 0) {
        fault_process(p, FaultReason.BadArg)
    }
    if access == 0 {
        fault_process(p, FaultReason.BadArg)
    }
    access
}

/// Resolve the Process handle a map names as its target, spending
/// `ProcessRight.Map` on it. Answers the target's process record, or ends the
/// caller.
///
/// This is the second right a map spends. Installing a row into a domain is
/// authority over that process, which holding a region must not imply. A
/// launcher that hands a child a region without this bit on the child's handle
/// has handed over bytes it cannot install anywhere.
///
/// A word that names nothing, or something that is not a Process, is the
/// ordinary `BadHandle`.
///
/// `Created` and `Running` are both legal, and a mapping is not a boot record,
/// so the give-freeze does not apply. A `Gone` target passes through: it has no
/// body to install into, and `install_row` answers `Revoked` for it once the
/// caller's own arguments have been checked, as spec §2.10 orders. Any other
/// state is a `BadState` fault.
func map_target(p: Int, handle: UInt) unsafe -> Int {
    let entry = lookup_handle(p, handle)
    match entry.obj_type {
        case Process -> {
            let target = ProcessObject(handle: ProcessHandle(handle),
                                       rights: entry.rights, slot: entry.target)
            if not target.allows(ProcessRight.Map) {
                fault_process(p, FaultReason.AccessDenied)
            }
            match PROCESS_RECORDS[target.slot].state {
                case Created -> {},
                case Running -> {},
                case Gone -> {},
                case _ -> fault_process(p, FaultReason.BadState),
            }
            target.slot
        },
        case _ -> fault_process(p, FaultReason.BadHandle),
    }
}

/// Install one row in process `t`'s domain and mint the Mapping that names it.
///
/// The policy cap is asked first and the physical wall is a kernel bug. The
/// target's mapping quota counts installed rows, not Mapping objects (see
/// `QuotaKind.Mapping`), so `quota_used` and `grant_count - image rows` are the
/// same number by construction: `install_row` charges one and appends one,
/// `Unmap` credits one and removes one, and a teardown zeroes both.
/// `install_quota_limits` caps every process's limit at the rows its domain has
/// left after its image, so passing the quota check proves there is a row to
/// take. Reaching the wall below means the ledger and the record disagree;
/// `NoResource` would blame a caller for the kernel's bug.
///
/// A `Gone` target has no body to append a row to (the body went back at the
/// teardown and the next create may already be running in it), so it is
/// answered `Revoked` before anything else is read: the mapper did not cause
/// the death. Every fault the caller's own arguments can raise is behind this
/// line.
///
/// A range that meets a row of the target's image or its stack
/// (`meets_image_row`) is `NoResource` and installs nothing: where a mapping's
/// address is its memory's own, a launcher's destination region is the child's
/// image, and a second row over it would change what the rows already there
/// mean to the copy doors and the entry check. Mappings may cover one another.
///
/// `hal.GRANT_ROW_BUDGET` is what the wall is measured against; the kernel
/// reads the HAL's number because it is a hardware limit on one target and a
/// policy one on another. The budget is checked before anything is written,
/// which keeps `record_grant`'s own `fatal_image` overflow arm a boot-path
/// vocabulary: a syscall can never reach it.
///
/// The live-domain rule is obeyed at the end (`domain_changed`): an edit to the
/// running process's record would otherwise never be installed, because the
/// scheduler skips equal domains.
///
/// `region` is which `Memory` these bytes belong to, or `NO_MEMORY` for a
/// device window (an IoMemory is pinned and its range is never returned,
/// §5.9). `record_grant` counts the row against the region, and that count is
/// half of the release condition in §2.5.
func install_row(p: Int, t: Int, base: UInt, top: UInt, perms: UInt8,
                 device: Bool, region: Int) unsafe -> SyscallResult {
    match PROCESS_RECORDS[t].state {
        case Gone -> { return op_status(SosStatus.Revoked) },
        case _ -> {},
    }
    // The target is charged, not the caller. What a mapping consumes is the
    // target's grant-row budget, and charging the caller would let a launcher's
    // own allowance gate how big another process's domain may be.
    if not quota_room(t, QuotaKind.Mapping) {
        return op_status(SosStatus.QuotaExceeded)
    }
    let target_body = body_of(t)
    if (PROCESSES[target_body].grant_count as UInt) >= hal.GRANT_ROW_BUDGET {
        fatal_kernel("a map met the row budget with quota headroom left",
                     PROCESSES[target_body].grant_count as UInt)
        // `fatal_kernel` stops the machine but is not declared `-> Never`, so
        // the scope has to exit itself. Nothing reaches this line.
        return op_status(SosStatus.NoResource)
    }
    // The address is chosen here, before anything is allocated. `base`/`top`
    // arrive physical (a region's frames, or a device window's registers) and
    // the target's virtual range is the kernel's answer: `free_user_va`
    // proposes the lowest unclaimed address above the target's image, and
    // `hal.map_place` decides whether that proposal is the answer (translating
    // target) or the physical address is (identity target, and every device row
    // on both).
    //
    // There is no address hint on any target: the caller passes no address and
    // this signature has nowhere to take one.
    //
    // Placement precedes `alloc_mapping` and `mint_handle` so that a refusal
    // leaks neither.
    let span = top - base
    let va_base = hal.map_place(free_user_va(t, span), base, device)
    if span > UInt.max - va_base {
        return op_status(SosStatus.NoResource)
    }
    let va_top = va_base + span
    // Running out of address space is `NoResource`, not `BadArg`: the caller
    // chose no address, so what it met is a domain window with no room left. A
    // device row is not asked; its window is the board's, and
    // `device_window_ok` answered for it at the op that named the bounds.
    if not device && not hal.map_target_ok(va_base, va_top) {
        return op_status(SosStatus.NoResource)
    }
    // A mapping does not cover a row of the target's image or its stack. On a
    // profile where a mapping's address is its memory's own, a launcher's
    // region is the child's image, and a second row over it would change what
    // the rows already there mean to the copy doors and the entry check.
    if meets_image_row(t, va_base, va_top) {
        return op_status(SosStatus.NoResource)
    }
    let slot = alloc_mapping()
    if slot == NO_MAPPING {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_capped(p, ObjType.Mapping, mapping_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    // Nothing is written until every refusal is behind us (the all-or-nothing
    // shape of `event_create`): a half-installed row is a protection domain
    // that disagrees with its own record.
    let row = PROCESSES[target_body].grant_count
    record_grant(t, va_base, va_top, base, perms, device, region)
    MAPPINGS[slot] = MappingSlot(state: SlotState.Live, process: p, target: t,
                                 row: row, refs: 1)
    quota_charge(t, QuotaKind.Mapping)
    domain_changed(t)
    op_value(handle)
}

/// The Memory object's ops (spec §2.5).
func memory_op(raw_op: UInt, obj: &MemoryObject, arg0: UInt,
               arg1: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = MemoryOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return memory_op_decoded(op, &obj, arg0, arg1, p)
}

func memory_op_decoded(op: MemoryOp, obj: &MemoryObject, arg0: UInt, arg1: UInt,
                       p: Int) unsafe -> SyscallResult {
    match op {
        // Split: one cut from the front, and the parent becomes the remainder.
        // A pool root serves a cut from its free list first and its cursor
        // second (`pool_cut`); either way a region is one contiguous range and
        // the caller supplies no addresses.
        //
        // Three refusals, all `BadArg` faults. A `len` of zero: a region naming
        // no bytes is not a region. A `len` this region cannot serve in one
        // range (`pool_can_serve`): a split that silently clamped would hand
        // back a region smaller than the number in the call. A misaligned
        // `len`: a grant covers whole units of the target's protection
        // granularity, so a cut mid-unit would leave a remainder that could
        // never be mapped without granting the piece before it too.
        //
        // With a free list the second refusal can also mean fragmentation: the
        // pool holds the bytes but not in one range, which the caller cannot
        // compute and which is therefore not strictly its mistake. It is
        // knowingly classed as a fault rather than `NoResource`; moving it
        // would change behaviour.
        //
        // Slab exhaustion is `NoResource`, a status, because a caller cannot
        // know how many slots are left. A piece that is split off and dropped
        // returns its slot at once, so a splitting loop meets the pool wall
        // before the slab wall: the bytes are what nothing returns.
        //
        // Rows counted on the region go with the bytes they grant. A row lying
        // wholly inside the cut moves to the piece and the rest stay, so the
        // piece's range returns to the pool only when no row of any process is
        // left in it. A cut through the middle of a row is `NoResource`, a
        // status: where a child's segments lie is not something the launcher
        // that holds its region can have known, as for `Map` over an image row.
        case Split -> {
            if not obj.allows(MemoryRight.Split) {
                fault_process(p, FaultReason.AccessDenied)
            }
            let len = arg0
            if len == 0 || not pool_can_serve(obj.slot, len) {
                fault_process(p, FaultReason.BadArg)
            }
            if (len % hal.PROT_GRAIN) != 0 {
                fault_process(p, FaultReason.BadArg)
            }
            // A cut that would run through a row counted on this region is
            // refused with nothing changed. The rows wholly inside the cut go
            // with it, below.
            let cut = pool_cut_base(obj.slot, len)
            if not rows_clear_of_cut(obj.slot, cut, len) {
                return op_status(SosStatus.NoResource)
            }
            if not quota_room(p, QuotaKind.Memory) {
                return op_status(SosStatus.QuotaExceeded)
            }
            let slot = alloc_memory()
            if slot == NO_MEMORY {
                return op_status(SosStatus.NoResource)
            }
            // The piece carries the rights of the handle the op came through,
            // so a derivation never widens: a parent narrowed to drop
            // `MapExecute` yields pieces that cannot map executable.
            let handle = mint_capped(p, ObjType.Memory, obj.rights, slot)
            if handle == NO_HANDLE {
                return op_status(mint_refusal(p))
            }
            // The cut, once both allocations are behind us: first fit off the
            // pool's free list, else the front-cut cursor (`pool_cut`). The
            // child takes the front of whichever range served it; a parent
            // split down to zero is representable and refuses every later
            // split.
            //
            // The child carries the root down. Its bytes go back to the pool
            // when both of its counts reach zero, not to this parent; the
            // derivation chain is a cursor artifact, not an ownership tree.
            let base = pool_cut(obj.slot, len)
            MEMORIES[slot] = MemorySlot(state: SlotState.Live, process: p,
                                        base: base, len: len, refs: 1, maps: 0,
                                        root: MEMORIES[obj.slot].root,
                                        free_head: 0, out_bytes: 0, dropped: 0)
            rows_move_to_piece(obj.slot, slot, base, len)
            quota_charge(p, QuotaKind.Memory)
            op_value(handle)
        },
        // Map: install this region in a domain and answer with the Mapping.
        // `arg0` is the target Process handle and `arg1` the `MapAccess` bits;
        // the two rights it spends are checked on two objects, here and in
        // `map_target`.
        //
        // The range is the region's own, since a caller supplies no addresses.
        // The top is rounded up to the protection granularity as the loader
        // rounds a segment's, so a region shorter than one grant unit still
        // gets a whole one.
        case Map -> {
            if not obj.allows(MemoryRight.Map) {
                fault_process(p, FaultReason.AccessDenied)
            }
            let t = map_target(p, arg0)
            let access = map_access(p, arg1)
            // The exec gate: a third right, spent only when execute is asked
            // for. It sits here rather than beside the `MemoryRight.Map` check
            // because it reads the access word, which is not decoded until
            // `map_access` has refused every shape that is not a grant. So
            // every word-shaped `BadArg` comes first, then the authority that
            // word requires. An unspent right is `AccessDenied`, and the caller
            // could have known: rights belong to the handle it chose to call
            // through.
            if ((access & (MapAccess.Execute as UInt32)) != 0
                && not obj.allows(MemoryRight.MapExecute)) {
                fault_process(p, FaultReason.AccessDenied)
            }
            let base = MEMORIES[obj.slot].base
            let len = MEMORIES[obj.slot].len
            if len == 0 || region_wraps(base, len) {
                fault_process(p, FaultReason.BadArg)
            }
            if (base % hal.PROT_GRAIN) != 0 {
                fault_process(p, FaultReason.BadArg)
            }
            let top = align_up(base + len, hal.PROT_GRAIN)
            // Ask the HAL's window predicate rather than relying on its loader
            // path: one target's grant window cannot express every address, and
            // its loader path stops the machine, which is right for a memory
            // map the build got wrong and wrong for a range a process chose. So
            // a map asks first and faults with `BadArg`.
            //
            // This checks the physical half only: the range is the region's own
            // frames, so the question is whether the board can hand them to a
            // user domain at all. The virtual half is answered in
            // `install_row`.
            if not hal.map_source_ok(base, top) {
                fault_process(p, FaultReason.BadArg)
            }
            install_row(p, t, base, top, grant_perms(access), false, obj.slot)
        },
    }
}

/// The IoMemory object's ops (spec §2.5).
func iomemory_op(raw_op: UInt, obj: &IoMemoryObject, arg0: UInt,
                 arg1: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = IoMemoryOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return iomemory_op_decoded(op, &obj, arg0, arg1, p)
}

func iomemory_op_decoded(op: IoMemoryOp, obj: &IoMemoryObject, arg0: UInt,
                         arg1: UInt, p: Int) unsafe -> SyscallResult {
    match op {
        // Carve leaves the parent alone, unlike `Split` (spec §2.5): MMIO is
        // pinned, a fixed region may be handed out many times, and several
        // drivers may legitimately hold windows onto one peripheral. So there
        // is no cursor and no arithmetic on the parent.
        //
        // `arg0` is an offset into the parent and `arg1` a length: a caller
        // names a sub-window relative to what it holds and never learns an
        // address.
        //
        // The hardware's granularity is checked here, where the caller chose
        // the numbers: a window that could never be installed anywhere would be
        // a capability that lies about itself. `Map` checks it again for the
        // one window a carve never saw, a boot root, whose bounds came from the
        // build's region table. The rule is per-target (`hal.device_window_ok`)
        // because targets express a device window differently, as a single
        // naturally-aligned power-of-two protection entry or by page.
        case Carve -> {
            if not obj.allows(IoMemoryRight.Carve) {
                fault_process(p, FaultReason.AccessDenied)
            }
            let offset = arg0
            let len = arg1
            let parent_len = IOMEMORIES[obj.slot].len
            if len == 0 || offset > parent_len || len > parent_len - offset {
                fault_process(p, FaultReason.BadArg)
            }
            let base = IOMEMORIES[obj.slot].base + offset
            if not hal.device_window_ok(base, len) {
                fault_process(p, FaultReason.BadArg)
            }
            if not quota_room(p, QuotaKind.IoMemory) {
                return op_status(SosStatus.QuotaExceeded)
            }
            let slot = alloc_iomemory()
            if slot == NO_IOMEMORY {
                return op_status(SosStatus.NoResource)
            }
            // The window carries the rights of the handle the op came through,
            // for the reason a `Split` piece does.
            let handle = mint_capped(p, ObjType.IoMemory, obj.rights, slot)
            if handle == NO_HANDLE {
                return op_status(mint_refusal(p))
            }
            IOMEMORIES[slot] = IoMemorySlot(state: SlotState.Live, process: p,
                                            base: base, len: len, refs: 1)
            quota_charge(p, QuotaKind.IoMemory)
            op_value(handle)
        },
        // Map: install a device-attribute row, always. There is no access
        // argument: RW is fixed, because execute-on-device is refused
        // (registers are not instructions) and a write-only register block is
        // not a grant any target has. `arg0` is the target Process handle, as
        // for a Memory.
        case Map -> {
            if not obj.allows(IoMemoryRight.Map) {
                fault_process(p, FaultReason.AccessDenied)
            }
            let t = map_target(p, arg0)
            let base = IOMEMORIES[obj.slot].base
            let len = IOMEMORIES[obj.slot].len
            if not hal.device_window_ok(base, len) {
                fault_process(p, FaultReason.BadArg)
            }
            // The perms word is what a device grant's row carries; the HAL's
            // own device path decides the attribute, so this says read|write
            // and nothing about caching. `NO_MEMORY`: MMIO is pinned, so a
            // device row counts against no region and returns no bytes when it
            // goes (§5.9).
            install_row(p, t, base, base + len,
                        (SegFlag.Read as UInt8) | (SegFlag.Write as UInt8), true,
                        NO_MEMORY)
        },
    }
}

/// The Mapping object's ops (spec §2.5).
func mapping_op(raw_op: UInt, obj: &MappingObject) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = MappingOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return mapping_op_decoded(op, &obj, p)
}

func mapping_op_decoded(op: MappingOp, obj: &MappingObject,
                        p: Int) unsafe -> SyscallResult {
    match op {
        // Unmap: only a mapping unmaps (§2.5).
        //
        // A mapping with no row has one of two states. The holder's own earlier
        // unmap leaves `NO_ROW`, a `BadState` fault: the holder caused it and
        // can check. The target process dying takes its whole domain and leaves
        // `ROW_TARGET_DIED`: the Mapping is invalid, and the answer is
        // `Revoked`, a status, since the holder did not cause it (spec §2.10).
        // Both follow the rights check.
        //
        // The order is the contract: remove the row, compact the record, fix up
        // every Mapping that named a later row of the same domain, and only
        // then reload. Compaction is forced by `load_domain`'s replay-by-index,
        // and the fixup is the only index sensitivity in the system.
        //
        // `Unmap` does not free the slot. A slab slot freed while a handle
        // still names it would be reachable through that handle once the next
        // `map` reuses it, and handle generations cannot cover it: a generation
        // lives in the handle entry, and the entry is not what went away. So an
        // unmapped Mapping keeps its slot and answers `BadState` thereafter.
        // The slot is reclaimed when the last handle naming it is released,
        // which is sound because then no handle is left to reach the reused
        // slot through. `refs.saw`'s Mapping arm leaves the row in place when
        // it frees, since a Mapping owns its row and the row is not a reference
        // back. Both husks are therefore reachable: unmapped-but-referenced
        // (slot lives, `Unmap` is `BadState`) and mapped-but-unreferenced (slot
        // freed, row installed until the target tears down).
        case Unmap -> {
            if not obj.allows(MappingRight.Unmap) {
                fault_process(p, FaultReason.AccessDenied)
            }
            match MAPPINGS[obj.slot].state {
                case Live -> {},
                case Free -> fault_process(p, FaultReason.BadState),
            }
            let row = MAPPINGS[obj.slot].row
            if row == ROW_TARGET_DIED {
                return op_status(SosStatus.Revoked)
            }
            if row == NO_ROW {
                fault_process(p, FaultReason.BadState)
            }
            let t = MAPPINGS[obj.slot].target
            remove_grant(t, row)
            // The husk names nobody, as the target's teardown leaves one: a
            // Mapping names its target only while it has a row there.
            MAPPINGS[obj.slot].row = NO_ROW
            MAPPINGS[obj.slot].target = NO_PROCESS
            // The credit follows the row, not the slot. The mapping quota
            // counts rows installed in the target's domain, so this is where
            // one comes back, not `free_object`, which frees the slot and may
            // leave the row standing. An unmapped-but-referenced Mapping is a
            // husk that consumes nothing, and the ledger says so from this line
            // onward.
            quota_credit(t, QuotaKind.Mapping)
            compact_mapping_rows(t, row)
            domain_changed(t)
            op_ok()
        },
        // Base: where the row is, in the target's own addresses. `MemoryOp.Map`
        // answers a Mapping handle, because the capability is what a caller
        // must not lose; the kernel chooses the address, so this is the only
        // way to learn it. It hangs off the object that owns the row, where
        // §2.5 puts every other fact about it.
        //
        // The refusals are `Unmap`'s, for its reasons: a freed slot or a
        // `NO_ROW` husk (a second unmap) is a `BadState` fault, and a husk
        // whose target died is `Revoked`. A husk that answered an address would
        // be answering about a row that is not installed anywhere.
        case Base -> {
            if not obj.allows(MappingRight.Base) {
                fault_process(p, FaultReason.AccessDenied)
            }
            match MAPPINGS[obj.slot].state {
                case Live -> {},
                case Free -> fault_process(p, FaultReason.BadState),
            }
            let row = MAPPINGS[obj.slot].row
            if row == ROW_TARGET_DIED {
                return op_status(SosStatus.Revoked)
            }
            if row == NO_ROW {
                fault_process(p, FaultReason.BadState)
            }
            // The record is what is read, not the hardware: the grant record is
            // authoritative, and the row's user base is the number the target's
            // own instructions will issue.
            let t = MAPPINGS[obj.slot].target
            op_value(PROCESSES[body_of(t)].grants[row].base)
        },
    }
}

// =============================================================================
// The pair: PipeInlet and PipeOutlet (spec §2.1)
// =============================================================================
//
// One connection, two kinds. The factory is on the Process object. `Post` is
// the one non-blocking primitive on the client end, and `Take` is its mirror on
// the server end. Both poll: a full ring and an empty one are both `WouldBlock`
// and neither op parks. (The client end's fused `Call` is a separate op and
// does park.)
//
// The two doors are the existing two. A post rides `copy_in`, which §2.2's
// one-door rule makes the only way a process's memory is read; a take rides
// `copy_out`, which every record-answering op already uses. Neither op invents
// a check: the doors answer alignment and containment, and what is left here is
// the domain question (is this length one this op can mean) and the ring
// question (is there a slot / is there a message).
//
// The peer-gone arms are reads of the reference columns and nothing else. A
// `Post` asks whether the outlet column is zero; a `Take` asks whether the
// inlet column is zero, but only once the ring has run dry (close drains
// first), which is an order of two comparisons.
//
// Neither op needs a preemption point. The one unbounded-looking thing in
// either is the body copy, bounded by `PIPE_BODY_BYTES`.
// `alloc_pipe` scans the connection slab, whose length is `PIPES.capacity()`:
// finite, because extents are finitely many and each is finitely sized.

/// The record `Process.PipeCreate` answers with, in kernel memory.
///
/// Declaration order is the layout, so the fields here and the word indices
/// `sosabi` publishes are one description, pinned by the assert below.
struct PipeCreateRecord {
    inlet: UInt,
    outlet: UInt,
}

static_assert(sizeof<PipeCreateRecord>()
              == PIPE_CREATE_RECORD_WORDS * sizeof<UInt>(),
              "a pipe-create record must be exactly the words sosabi publishes")

/// Make a connection owned by process `owner` and hand back both of its ends,
/// which go into the caller's table (spec §2.1, §2.7).
///
/// `owner` is the process the Process handle names, and it is charged for the
/// connection; `caller` is who trapped. The caller's table receives the two
/// handles, its `Handle` row pays for them, its memory takes the answer, and it
/// is the process any caller error faults. They are one process when a process
/// creates a pipe through its own Process handle.
///
/// Refusal order is the all-or-nothing shape every allocation site follows:
/// caller-checkable faults first (a capacity below the published record size, a
/// destination the copy door refuses), then `Revoked` for a `Gone` owner (spec
/// §2.10), then policy (`QuotaExceeded`: the owner's pipe row, then room for
/// both handles on the caller's `Handle` row), then the machine (`NoResource`:
/// the pipe slab, then room for both handles in the caller's table), and only
/// then is anything written. The destination is checked before the slab is
/// touched, so a refused buffer leaves the slab as it found it.
///
/// Room for both handles is established before the slab is asked, so neither
/// mint can be refused and a connection never ends up with one reachable end:
/// the kernel runs the syscall with nothing able to take a table slot between
/// the count and the mints.
func pipe_create(caller: Int, owner: Int, dst: UInt, cap: UInt) unsafe -> SyscallResult {
    // A capacity below the record's size is outside the argument's domain; the
    // size is published, so the caller could have checked (as in
    // `Waiter.Wait`).
    if cap < (pipe_create_record_bytes() as UInt) {
        fault_process(caller, FaultReason.BadArg)
    }
    // Asked before anything is allocated, for `Waiter.Wait`'s reason: a bad
    // buffer is the calling process's mistake, and terminating it before the
    // kernel has minted anything is the simpler thing to reason about. It also
    // makes the copy at the bottom unable to fail, so a successful creation
    // never ends in a fault with two live handles nobody was told about.
    if let why = copy_out_check(caller, dst, pipe_create_record_bytes() as UInt) {
        fault_process(caller, why)
    }

    if not has_body(owner) {
        return op_status(SosStatus.Revoked)
    }
    if not quota_room(owner, QuotaKind.Pipe) {
        return op_status(SosStatus.QuotaExceeded)
    }
    if not quota_room_for(caller, QuotaKind.Handle, 2) {
        return op_status(SosStatus.QuotaExceeded)
    }
    let slot = alloc_pipe()
    if slot == NO_PIPE {
        return op_status(SosStatus.NoResource)
    }
    if not table_room(caller, 2) {
        return op_status(SosStatus.NoResource)
    }
    let inlet = mint_capped(caller, ObjType.PipeInlet, pipe_inlet_rights(), slot)
    let outlet = mint_capped(caller, ObjType.PipeOutlet, pipe_outlet_rights(),
                             slot)
    if inlet == NO_HANDLE || outlet == NO_HANDLE {
        // Unreachable: the pre-flight established room for both.
        fatal_kernel("a pipe's handles were refused after their pre-flight",
                     slot as UInt)
    }

    // Both columns start at one: the creation count, applied once per end. The
    // slot is written only once both mints succeeded (the all-or-nothing shape
    // of `event_create`); the charge joins that rule, because a process must
    // not pay for an object it never got.
    PIPES[slot] = PipeSlot(state: SlotState.Live, process: owner, staged: 0,
                           inlet_attachment: 0, outlet_attachment: 0,
                           inlet_refs: 1, outlet_refs: 1)
    quota_charge(owner, QuotaKind.Pipe)

    var rec = PipeCreateRecord(inlet: inlet, outlet: outlet)
    if let why = copy_out(caller, dst,
                          ((&var rec) as UnsafePointer<PipeCreateRecord>) as UInt,
                          pipe_create_record_bytes() as UInt) {
        // Unreachable, and still written: the same destination passed
        // `copy_out_check` before anything was allocated, and nothing between
        // here and there can move a process's window. The arm reports rather
        // than assumes.
        fault_process(caller, why)
    }
    op_ok()
}

/// The PipeInlet's ops (spec §2.1).
func pipe_inlet_op(raw_op: UInt, obj: &PipeInletObject, arg0: UInt,
                   arg1: UInt, arg2: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = PipeInletOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return pipe_inlet_op_decoded(op, &obj, arg0, arg1, arg2, p)
}

func pipe_inlet_op_decoded(op: PipeInletOp, obj: &PipeInletObject, arg0: UInt,
                           arg1: UInt, arg2: UInt, p: Int) unsafe -> SyscallResult {
    match op {
        case Post -> {
            if not obj.allows(PipeInletRight.Post) {
                fault_process(p, FaultReason.AccessDenied)
            }
            pipe_post(p, obj.slot, arg0, arg1)
        },
        // `Post` and `Call` are one op each; `arg0`/`arg1` are the send record
        // and its size on both, so the two paths read as one message with and
        // without a park.
        //
        // The same bit gates both. A `Call` submits a message exactly as a
        // `post` does (same ring, same body maximum, same peer-gone answer);
        // the fusion is mechanics, not authority. What it adds is a park, and
        // the park needs no `Wait` right because no Waiter is involved. A
        // second bit would let a launcher hand out an endpoint that may post
        // and may not do the cheap thing, a distinction with no security
        // content.
        case Call -> {
            if not obj.allows(PipeInletRight.Post) {
                fault_process(p, FaultReason.AccessDenied)
            }
            pipe_call(p, obj.slot, arg0, arg1, arg2)
        },
    }
}

/// Read a send record, and refuse the whole message if any part of it is wrong
/// (spec §2.1's `send(data?, handles?)`).
///
/// It is the copy-in and staging validation for the three sending ops (`Post`,
/// `Call` and `Reply`) in one place: the domain questions a message poses are
/// the same whichever direction it goes, and a second copy of them is a second
/// place to be wrong about which handle a caller may attach.
///
/// `invoking` is the word the op was invoked through when the op consumes that
/// handle (`Reply` consumes the request handle it is invoked through), and
/// `NO_HANDLE` when it does not. A carried word equal to it is refused: the
/// handle cannot both travel in the message and be the one the op destroys.
///
/// `pipe` is the slab slot of the connection the message is posted or called
/// into, and `NO_PIPE` for a reply, whose handles go back to the client and
/// not into the request's own ring. A carried `PipeOutlet` of that connection
/// is refused: the staged reference keeps the connection's outlet column above
/// zero, an exchange does not settle while it is, and once the sender dropped
/// its inlet and claim nothing could reach the connection to free it.
///
/// Every refusal here is a fault, and it happens before anything is staged. A
/// record of the wrong size, a body longer than `PIPE_BODY_BYTES`, a handle
/// word that names nothing, one whose entry lacks the universal `Transfer`
/// right, one naming a kind no `BootHandleKind` spells, one equal to
/// `invoking` and an outlet of `pipe` are all mistakes only the caller could
/// have made. Raising them above the ring, the exchange and every mint makes
/// "refuses the whole post, atomic, nothing staged" true by construction rather
/// than by an unwind.
///
/// It validates and does not unbind. The entries leave the sender (take at
/// post) in `hold_staged`, which runs after the last refusal that leaves them
/// in place. So a full ring and a table with no room for the claim are answered
/// while the caller still holds everything it held. A departed peer is
/// answered earlier still, but it is terminal: the entries are released
/// (`release_carried`), not kept.
func send_args(p: Int, src: UInt, bytes: UInt, invoking: UInt,
               pipe: Int) unsafe -> PipeSendRecord {
    // Exactly the published size (`timer_arm`'s rule): the record is the whole
    // argument list, and a caller that hands over a different number of words
    // has built something else.
    if bytes != (pipe_send_record_bytes() as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    var args = PipeSendRecord(body: 0, len: 0, handles: [NO_HANDLE; PIPE_MSG_HANDLES])
    if let why = copy_in(p, ((&var args) as UnsafePointer<PipeSendRecord>) as UInt,
                         src, bytes) {
        fault_process(p, why)
    }
    check_send(p, &args, invoking, NO_HANDLE, pipe)
    args
}

/// The domain half of `send_args`, split out for the one op whose record
/// arrives nested inside another: `PipeRequestOp.ReplyWait` copies in a waiter
/// and a message together, so it has the message already and needs only the
/// checks. `invoking` and `pipe` are as `send_args` describes them.
///
/// `kept` is a word the op goes on to use after the message has left, or
/// `NO_HANDLE`: `ReplyWait`'s Waiter, which its wait leg parks on. A carried
/// word equal to it is refused too. Carried, the entry would leave the table
/// with the reply, and if it was the Waiter's last handle the reply's
/// settlement could free the Waiter under the thread about to park on it.
func check_send(p: Int, args: &PipeSendRecord, invoking: UInt, kept: UInt,
                pipe: Int) unsafe {
    if args.len > (PIPE_BODY_BYTES as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    var i: Int = 0
    while i < PIPE_MSG_HANDLES {
        let word = args.handles[i]
        if word != NO_HANDLE {
            if word == invoking || word == kept {
                fault_process(p, FaultReason.BadArg)
            }
            let entry = lookup_handle(p, word)
            match entry.obj_type {
                case Unbound -> fault_process(p, FaultReason.BadHandle),
                case _ -> {},
            }
            // The same bit `give` spends, checked at the same altitude: the
            // entry is known and the kind is not, which is where §3's universal
            // low byte is read (`rights_allow_transfer`). A message is a
            // transfer, so it spends the transfer right.
            if not rights_allow_transfer(entry.rights) {
                fault_process(p, FaultReason.AccessDenied)
            }
            // The kind must also be one the delivery record can spell, the same
            // partial translation `give` consults. This is not the same
            // question as `Transfer`: that is an authority the holder was
            // granted, and this is whether the receiver could be told what
            // arrived.
            guard let _ = msg_kind_of(entry.obj_type) else {
                fault_process(p, FaultReason.BadArg)
            }
            // An outlet of the connection the message enters.
            if is_outlet_of(entry.obj_type, entry.target, pipe) {
                fault_process(p, FaultReason.BadArg)
            }
        }
        i = i + 1
    }
}

/// Stage one message and never suspend: `post` is the one kernel primitive on
/// the client side.
///
/// `args_src`/`args_bytes` name the caller's send record; the body's address
/// in the caller's memory is `args.body` and its length `args.len`. A length of
/// zero is legal (§2.1 makes a data-free message an option) and reads
/// no buffer: no address is touched or validated, since demanding an aligned
/// in-range address for a copy of nothing would only refuse correct programs.
///
/// Three answers, asked in this order:
///
///   - A `len` above `PIPE_BODY_BYTES` is a fault. The maximum is published and
///     the caller chose the number.
///   - The outlet column at zero is `PeerClosed`, asked before the ring because
///     it is the stronger fact: nobody can ever take again, so a free slot
///     would be a place to put a message with no future. The staged bodies were
///     already dropped at that transition (`kcore.refs`). The refusal is
///     terminal, so the handles the message carried are released.
///   - A full ring is `WouldBlock`: caller-checkable, transient, never a park.
///     A blocking send is the fused `Call` (`pipe_call`), which waits for room
///     instead. The carried handles stay with the caller, as they do on the
///     mint refusals below.
///
/// A staged message opens an exchange, and the `PipeReply` handle minted into
/// the poster's table is the client's claim on its one reply.
///
/// The message cannot carry an outlet of this connection: `check_send` raises
/// that as a `BadArg` fault on the caller, ahead of the ring.
///
/// A refused post mints nothing: the ring is scanned but nothing is committed
/// until the claim exists, so a full handle table (`NoResource`) or a spent
/// handle budget (`QuotaExceeded`) leaves the connection, and the caller's
/// carried handles, exactly as they were. The scan reserves nothing, so an
/// early return leaks no slot.
///
/// A ring slot lives until its exchange settles rather than until its bytes are
/// taken, so `PIPE_INFLIGHT` bounds awaiting-reply exchanges.
func pipe_post(p: Int, slot: Int, args_src: UInt, args_bytes: UInt) unsafe -> SyscallResult {
    let args = send_args(p, args_src, args_bytes, NO_HANDLE, slot)
    let len = args.len
    if PIPES[slot].outlet_refs == 0 {
        // Terminal: the carried handles are consumed, as they would have been
        // by a delivery.
        release_carried(p, &args)
        return op_status(SosStatus.PeerClosed)
    }
    let x = alloc_exchange(slot)
    if x == NO_EXCHANGE {
        return op_status(SosStatus.WouldBlock)
    }

    if len != 0 {
        // The one door inward (§2.2's one-door rule). It reports a refused
        // source and the caller terminates on it, as `Timer.Arm` does. It runs
        // before the mint so that the fault path has no handle to account for;
        // the slot it writes is still `Free`, and a `Free` slot's bytes are
        // read by nothing.
        if let why = copy_in(p, exchange_body_addr(x), args.body, len) {
            fault_process(p, why)
        }
    }

    // The claim is minted before anything is committed. A full table or a spent
    // handle budget is a status, and it must leave the ring untouched;
    // otherwise a refused post would have staged a message nobody can ever
    // answer.
    let claim = mint_capped(p, ObjType.PipeReply, pipe_reply_rights(), x)
    if claim == NO_HANDLE {
        return op_status(mint_refusal(p))
    }

    // `as UInt16` is exact: the length was refused above unless it fits
    // `PIPE_BODY_BYTES`, which the ABI's own assert keeps well inside the
    // width. An out-of-range value here would be a kernel bug, which is when
    // `as` is the right spelling.
    EXCHANGES[x].len = len as UInt16
    stamp_sender(x, p)
    // The handles leave the sender here (take at post). This is the last line
    // that can change anything the caller owns and every refusal is already
    // behind it, so the message is committed from this point and nothing the
    // sender does afterwards (releasing, exiting) can make it arrive empty.
    hold_staged(p, x, &args, slot)
    // One column starts at one and the other at zero, and the asymmetry is the
    // state machine: the claim exists from the post, the obligation does not
    // exist until somebody takes the message. That is why `Staged` is a
    // recorded state: a zero request column means "not minted yet" here and
    // "abandoned by the server" one state later, and the columns alone cannot
    // tell those apart.
    EXCHANGES[x].reply_refs = 1
    EXCHANGES[x].request_refs = 0
    EXCHANGES[x].state = ExchangeState.Staged
    stage_push(slot, x)
    // The server end is now readable (§2.2's readable arm), so a server parked
    // on this connection's outlet is woken. This is `notify_ready` and not
    // `notify_if_ready` because the message just staged is the readiness.
    notify_ready(WaitableKind.PipeOutlet, slot)
    op_value(claim)
}

/// Post, park, and resolve behind one trap: the fused client path.
///
/// This is `pipe_post` plus a park, and every rule the composed path obeys
/// applies verbatim: a fused op is the composition run without returning to
/// userspace, so it asks `pipe_post`'s questions in `pipe_post`'s order, stages
/// through `pipe_post`'s door, and then does what a client would have done
/// next.
///
/// Three differences, all consequences of not returning:
///
///   - No claim is minted. The exchange's reply column starts at one for the
///     parked thread, not for a handle entry, so a fused RPC spends no table
///     row and no handle traffic, which matters for a client that meets
///     `MAX_HANDLES` before it meets the ring. `Exchange.caller` is the tie;
///     `kcore.refs`' one wake arm reads it.
///   - A full ring parks rather than answering `WouldBlock`. `post` surfaces
///     the refusal because it never suspends; this op does, so it waits for the
///     room a settle makes, as the composed send's room leg does with two more
///     traps.
///   - Both buffers are checked before anything is staged. The reply lands from
///     another thread's context and the request body may be copied from one, so
///     each address is validated here, while the caller is the running process
///     and a refusal can still terminate it (`copy_in_check`).
///
/// As at `pipe_post`, a carried outlet of this connection is a `BadArg` fault
/// on the caller (`check_send`), raised before anything is staged.
///
/// The call's own refusal is never transient: a full ring parks it and no claim
/// is minted. Its refusal, `PeerClosed`, is terminal, so the carried handles
/// are released whether the outlet closed before the call or while it waited
/// for room (`resume_call_room`). A `NoResource` or `QuotaExceeded` at the
/// reply's delivery comes after the message was staged, so it consumes them
/// like every later outcome.
///
/// The reply buffer takes no capacity argument: the three argument registers
/// are spent, so the buffer is checked against `pipe_msg_record_bytes()` of the
/// caller's real memory, which is stricter than a number the caller types (as
/// in `pipe_take`).
func pipe_call(p: Int, slot: Int, args_src: UInt, args_bytes: UInt,
               reply_dst: UInt) unsafe -> SyscallResult {
    let args = send_args(p, args_src, args_bytes, NO_HANDLE, slot)
    let len = args.len
    if let why = copy_out_check(p, reply_dst, pipe_msg_record_bytes() as UInt) {
        fault_process(p, why)
    }
    // A zero-length call reads no buffer at all, as a zero-length post does.
    if len != 0 {
        if let why = copy_in_check(p, args.body, len) {
            fault_process(p, why)
        }
    }
    // The args record itself is re-checked for the room park. A full ring
    // parks this call with its message still in the caller's memory, and
    // `resume_call_room` re-reads the record as well as the body (the handle
    // words are in it), so both addresses have to survive until the resume.
    // Both are checked here while the caller is the running process.
    if let why = copy_in_check(p, args_src, args_bytes) {
        fault_process(p, why)
    }
    // An op that parks needs a thread to park; harness kernels that enter user
    // mode with no object model have none (`waiter_wait`'s guard).
    if CURRENT_THREAD == NO_THREAD {
        fault_process(p, FaultReason.BadState)
    }

    if PIPES[slot].outlet_refs == 0 {
        // Terminal: the carried handles are consumed, as `pipe_post`'s are.
        release_carried(p, &args)
        return op_status(SosStatus.PeerClosed)
    }
    let x = alloc_exchange(slot)
    if x == NO_EXCHANGE {
        // The park remembers the args record, not the body, which keeps
        // `ThreadSlot` small: a message is four handle words plus a body
        // address plus a length, and re-reading the one record the caller
        // already built is cheaper than more thread fields to keep in step. No
        // thread of the caller runs, but a row can still go while it is parked
        // (a mapping unmapped by the launcher that made it, or by a sibling),
        // so the resume checks again and ends the process if the record or the
        // body is gone (`resume_call_room`).
        block_on_call_room(CURRENT_THREAD, slot, args_src, args_bytes, reply_dst)
        return op_blocked()
    }
    if len != 0 {
        if let why = copy_in(p, exchange_body_addr(x), args.body, len) {
            // Unreachable: the same source passed `copy_in_check` above and
            // no user code has run since. Written rather than assumed.
            fault_process(p, why)
        }
    }
    EXCHANGES[x].len = len as UInt16
    stamp_sender(x, p)
    hold_staged(p, x, &args, slot)
    // One column at one for a thread rather than for a handle: the only line
    // here that is not `pipe_post`'s. The asymmetry with the request column
    // means what it means there: the claim exists from the call, the obligation
    // does not exist until somebody takes.
    EXCHANGES[x].reply_refs = 1
    EXCHANGES[x].request_refs = 0
    EXCHANGES[x].state = ExchangeState.Staged
    stage_push(slot, x)
    // Park before notifying, so a server woken by the staging can never find
    // this thread runnable with its answer already owed. The wake only queues,
    // so the order costs nothing and buys the invariant.
    block_on_call_reply(CURRENT_THREAD, x, reply_dst)
    notify_ready(WaitableKind.PipeOutlet, slot)
    op_blocked()
}

/// The PipeOutlet's ops (spec §2.1).
func pipe_outlet_op(raw_op: UInt, obj: &PipeOutletObject, arg0: UInt, arg1: UInt,
                    arg2: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = PipeOutletOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return pipe_outlet_op_decoded(op, &obj, arg0, arg1, arg2, p)
}

func pipe_outlet_op_decoded(op: PipeOutletOp, obj: &PipeOutletObject, arg0: UInt,
                            arg1: UInt, arg2: UInt, p: Int) unsafe -> SyscallResult {
    match op {
        case Take -> {
            if not obj.allows(PipeOutletRight.Take) {
                fault_process(p, FaultReason.AccessDenied)
            }
            pipe_take(p, obj.slot, arg0, arg1)
        },
    }
}

/// Take the oldest staged message, and never park (spec §2.1).
///
/// `rec_dst` is the caller's buffer and `rec_cap` its size in bytes, which must
/// be at least the published record size (the minimum rule `Waiter.Wait`
/// follows). It is the whole slot's size, not the message's, because the
/// message's length is what the op answers with and a caller cannot size a
/// buffer against a number it has not been told yet.
///
/// An empty result is drain-then-terminal, two comparisons in this order:
///
///   - Anything staged is handed over, whatever the inlet column says. The
///     sender being gone does not un-send what it sent, and a message dropped
///     because its author exited would be the silent loss §2.1's bounded-IPC
///     model exists to rule out.
///   - Only an empty ring asks about the peer. Empty with a live inlet is
///     `WouldBlock`: call again. Empty with the inlet column at zero is
///     `PeerClosed`, and it is terminal: no new sender can appear, because
///     attenuation is monotonic and a column at zero has no handle left to mint
///     from. A second take answers the same.
///
/// The answer is a record: the message's length, and the `PipeRequest` that
/// obliges its reply, minted into the taker's table at the take.
///
/// The ring slot does not come back here. A take moves the exchange from
/// `Staged` to `Taken`, and the slot recycles only when the exchange settles
/// (the reply travels back through it). Ring-full therefore counts
/// awaiting-reply exchanges, as `pipe_post`'s docstring says from the other
/// side.
func pipe_take(p: Int, slot: Int, rec_dst: UInt, rec_cap: UInt) unsafe -> SyscallResult {
    // The published minimum is checked before the ring is consulted: the
    // capacity is a domain question about the call, right or wrong whether or
    // not there is anything to hand over (`boot_handle_next`'s ordering).
    //
    // It covers the body as well: one record holds the obligation, the meta,
    // the handle words and the body, and the door is asked about the whole of
    // it against the caller's real memory rather than a number it typed.
    if rec_cap < (pipe_take_record_bytes() as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    if let why = copy_out_check(p, rec_dst, pipe_take_record_bytes() as UInt) {
        fault_process(p, why)
    }

    let x = stage_peek(slot)
    if x == NO_EXCHANGE {
        if PIPES[slot].inlet_refs == 0 {
            return op_status(SosStatus.PeerClosed)
        }
        return op_status(SosStatus.WouldBlock)
    }

    // The whole batch is pre-flighted, and the refusal is atomic. A take mints
    // the obligation and every handle the message is carrying, and a table with
    // room for some of them must refuse all of them; otherwise a half-delivered
    // message would strand capabilities in a table its receiver never learned
    // about. One question about `staged_count(x) + 1`, asked before anything
    // exists: the message stays staged with its references still held, the
    // readable level stays raised, and freeing a slot and taking again is
    // handed the same message carrying the same handles.
    if not table_room(p, staged_count(x) + 1) {
        return op_status(mint_refusal(p))
    }
    let request = mint_capped(p, ObjType.PipeRequest, pipe_request_rights(), x)
    if request == NO_HANDLE {
        // Unreachable: `table_room` established the room one line up and
        // nothing between the two can spend it. Written rather than assumed.
        fatal_kernel("a take's obligation was refused after its pre-flight",
                     x as UInt)
        return op_status(SosStatus.NoResource)
    }
    // The rendezvous (spec §2.1: attached handles enter the receiver's table
    // only at receive). Every reference the message has been holding since the
    // post is minted into this table, rights verbatim, and the taker is charged
    // for each: the second half of a move whose first half ran in the sender's
    // own syscall. A slot arrives empty only if the sender left it empty;
    // staleness cannot exist under take-at-post.
    let moved = mint_staged(x, p)

    let len = EXCHANGES[x].len as UInt
    var rec = PipeTakePrefix(request: request as UInt64,
                             msg: msg_prefix(len, EXCHANGES[x].sender_pid,
                                             &moved))
    // The one door outward, twice, as one contiguous prefix ending at the
    // message's length: the fixed part, then the bytes straight out of the ring
    // slot. A short message pays for no part of the body region.
    if let why = copy_out(p, rec_dst,
                          ((&var rec) as UnsafePointer<PipeTakePrefix>) as UInt,
                          sizeof<PipeTakePrefix>() as UInt) {
        // Unreachable, and still written: the same destination passed
        // `copy_out_check` above and nothing since can move a process's window.
        // The arm reports rather than assumes.
        fault_process(p, why)
    }
    if len != 0 {
        if let why = copy_out(p, rec_dst + (pipe_take_body_offset() as UInt),
                              exchange_body_addr(x), len) {
            fault_process(p, why)
        }
    }

    // Consumed by delivery, and only after the copies succeeded, so "a staged
    // message is handed over exactly once" holds exactly. The exchange stays in
    // the ring; what it leaves is the staged list.
    stage_pop(slot)
    EXCHANGES[x].request_refs = 1
    EXCHANGES[x].state = ExchangeState.Taken
    op_ok()
}

// -----------------------------------------------------------------------------
// The one-shot pair: PipeReply and PipeRequest (spec §2.1)
// -----------------------------------------------------------------------------
//
// `Resolve`, `Reply` and `ReplyWait` each consume the handle they were called
// through (`Ready`, the level poll, consumes nothing). That is the
// transfer-funnel contract reached through an op rather than through `give`:
// the sysapi wrapper disarms its sentinel, the kernel drops the entry's
// reference, and the exchange's column falls. "Single use" is thereby enforced
// by the ledger rather than by a per-handle bit. `Mint` is absent from both
// rights sets, so a one-shot has exactly one name and no sibling can keep the
// object alive.
//
// Abandonment is read off the columns, and nothing records it:
//
//   the claim column at zero      the client abandoned: `Reply` answers
//                                 `PeerClosed`, the obligation discharged
//   `Taken`, request column zero  the server abandoned: `Resolve` answers
//                                 `PeerClosed`
//   `Staged`, outlet column zero  nobody can ever take it, so likewise
//
// This is the same rule as for the pair above: the two columns are the
// peer-gone state, and no flag beside them says so.
//
// None of these ops needs a preemption point, on `pipe_post`'s reasoning: one
// bounded body copy of at most `PIPE_BODY_BYTES`, and no scan.

/// The PipeReply's ops: the client's claim (spec §2.1).
func pipe_reply_op(raw_op: UInt, obj: &PipeReplyObject, arg0: UInt,
                   arg1: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = PipeReplyOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return pipe_reply_op_decoded(op, &obj, arg0, arg1, p)
}

func pipe_reply_op_decoded(op: PipeReplyOp, obj: &PipeReplyObject, arg0: UInt,
                           arg1: UInt, p: Int) unsafe -> SyscallResult {
    match op {
        case Resolve -> {
            if not obj.allows(PipeReplyRight.Resolve) {
                fault_process(p, FaultReason.AccessDenied)
            }
            pipe_resolve(p, obj.handle, obj.slot, arg0, arg1)
        },
        // The level question spends `Wait`, not `Resolve`. Asking whether the
        // answer has arrived is the same question attaching this claim to a
        // Waiter asks, so it is gated by the same bit; `Resolve` stays the
        // consuming act's authority. A claim narrowed to `Wait` alone can be
        // watched and polled and never spent.
        case Ready -> {
            if not obj.allows(PipeReplyRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            pipe_ready(obj.slot)
        },
    }
}

/// Take the reply, parking until it is there, and consume the claim on every
/// path (spec §2.1).
///
/// A pending exchange parks the calling thread on the claim's ready level and
/// finishes, on the wake, whichever of the two remaining arms the level turned
/// out to be; `WouldBlock` is never returned. Because the op consumes on every
/// path it can be a `consumes` method upstairs, so a second resolve is a
/// compile error rather than a `BadHandle` fault, and a consumed wrapper whose
/// kernel entry survived a `WouldBlock` would have been a leaked reference. The
/// poll is `PipeReplyOp.Ready`.
///
/// A park is mechanics, not authority, so the op spends only the `Resolve` bit.
///
/// Three answers, depending only on the exchange's state and its two columns:
///
///   - `Replied`: the bytes are copied out, the claim is consumed, and the
///     length is the value. The consume frees the ring slot when the obligation
///     has already gone, the ordinary end of an exchange.
///   - Pending (the message is staged or taken and no reply has been written):
///     the caller parks. `park_resolve` takes its entry on the way down, so the
///     claim is spent from that moment and the reference it held is the parked
///     thread's; the wake arm is the fused call's.
///   - Abandoned by the server (`Taken` with no obligation left, or `Staged`
///     with no outlet left): `PeerClosed`, and the claim is consumed exactly as
///     a delivered reply consumes it. Nothing un-closes: the columns only fall.
///
/// The caller's entry is what the consume destroys (`unbind_handle` plus
/// `unref_object`, the two calls `RELEASE_OP` makes), so a second resolve
/// through the same word is the ordinary `BadHandle` fault. A one-shot has one
/// name, so there is no minted sibling to reach that fault from either.
func pipe_resolve(p: Int, word: UInt, x: Int, dst: UInt,
                  cap: UInt) unsafe -> SyscallResult {
    if cap < (pipe_msg_record_bytes() as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    if let why = copy_out_check(p, dst, pipe_msg_record_bytes() as UInt) {
        fault_process(p, why)
    }

    match EXCHANGES[x].state {
        case Replied -> {
            let len = EXCHANGES[x].len as UInt
            // The pre-flight comes before the delivery, and a refusal is
            // terminal. A reply may carry handles, so this op mints too. A
            // table with no room for them cannot leave the claim alive for a
            // retry, because this op consumes on every path and the wrapper
            // upstairs is already dead. So the refusal consumes, as
            // `wake_call_reply`'s does: the handles the replier attached go
            // back to their slabs when the exchange settles, because the
            // replier gave them up at the reply and there is nobody left to
            // hand them to. A client that must not lose a capability this way
            // makes room before it resolves. Everything below the pre-flight is
            // the delivery, and none of it can fail for a reason a caller could
            // act on.
            if not table_room(p, staged_count(x)) {
                let why = mint_refusal(p)
                consume_entry(p, word, ObjType.PipeReply, x)
                return op_status(why)
            }
            let moved = mint_staged(x, p)
            var rec = msg_prefix(len, EXCHANGES[x].sender_pid, &moved)
            if let why = copy_out(p, dst,
                                  ((&var rec) as UnsafePointer<PipeMsgPrefix>) as UInt,
                                  sizeof<PipeMsgPrefix>() as UInt) {
                fault_process(p, why)
            }
            if len != 0 {
                if let why = copy_out(p, dst + (pipe_msg_body_offset() as UInt),
                                      exchange_body_addr(x), len) {
                    fault_process(p, why)
                }
            }
            consume_entry(p, word, ObjType.PipeReply, x)
            op_value(len)
        },
        case Taken -> {
            if EXCHANGES[x].request_refs == 0 {
                consume_entry(p, word, ObjType.PipeReply, x)
                return op_status(SosStatus.PeerClosed)
            }
            park_resolve(p, word, x, dst)
        },
        case Staged -> {
            if PIPES[exchange_pipe(x)].outlet_refs == 0 {
                consume_entry(p, word, ObjType.PipeReply, x)
                return op_status(SosStatus.PeerClosed)
            }
            park_resolve(p, word, x, dst)
        },
        // The answer already went out through a wait. A `Waiter` delivery is a
        // resolve (the record carried the bytes), so there is nothing here for
        // a second asker, and the word for "there is no longer anybody on the
        // other side of this exchange" is the one an abandoned peer gets. It
        // consumes the claim, as the two arms above it do, which lets the ring
        // slot go. The only second asker left is the claim's own holder asking
        // twice, which the typed tier refuses at compile time.
        //
        // A non-consuming attach reaches this arm: the client kept its handle,
        // the delivery discharged the exchange, and this is what its later
        // `resolve` is told. A subscription delivery that settled the slot
        // first composes the same way, because a settled exchange is never
        // pending, so the resolve reaching it does not park.
        case Settled -> {
            consume_entry(p, word, ObjType.PipeReply, x)
            op_status(SosStatus.PeerClosed)
        },
        // Unreachable: a `Free` exchange has no reference columns, so no handle
        // can name one. Written rather than assumed; reaching it would have
        // recycled a slot under a live claim, the invariant `pipe_idle` exists
        // to keep. `fatal_kernel` stops the machine but is not declared
        // `-> Never`, so the arm has to yield something; nothing reaches the
        // line that does.
        case Free -> {
            fatal_kernel("a pipe claim named a free exchange", x as UInt)
            op_status(SosStatus.NoResource)
        },
    }
}

/// Spend the claim and park on it: the pending arm of `Resolve`.
///
/// The entry is taken here and its reference is not dropped, which is why no
/// new wake protocol is needed. `consume_entry` is detach, unbind, unref; this
/// is the same act with the last step left out, so the reference the handle row
/// held becomes the parked thread's. That is the invariant a fused `Call`
/// establishes when it starts `Exchange.reply_refs` at one for a thread rather
/// than for a row. From this line the two shapes of parked client are
/// indistinguishable downstream: `notify_claim` asks one question,
/// `wake_call_reply` writes the same record and value register,
/// `release_pending_calls` drops the same reference, and `exchange_settle`'s
/// no-caller-parked assert covers both.
///
/// The detach is the implicit detach of any consuming op: a claim attached to a
/// Waiter and then resolved loses the attachment at the park. That keeps
/// `EXCHANGES[x].reply_attach` and `EXCHANGES[x].caller` alternatives rather
/// than a pair (the invariant `kcore.refs`' wake-arm banner states and
/// `exchange_settle` asserts).
///
/// An op that parks needs a thread to park (`pipe_call`'s guard). It is asked
/// here rather than at the top of `pipe_resolve` because the arms that return
/// without parking are answerable without one.
///
/// `dst` went through `copy_out_check` at the top of `pipe_resolve`, while the
/// caller was the running process. The wake asks again (`wake_call_reply`),
/// since a mapped row can go while the caller is parked.
func park_resolve(p: Int, word: UInt, x: Int, dst: UInt) unsafe -> SyscallResult {
    if CURRENT_THREAD == NO_THREAD {
        fault_process(p, FaultReason.BadState)
    }
    detach_consumed(ObjType.PipeReply, x)
    unbind_handle(p, handle_word_index(word))
    block_on_call_reply(CURRENT_THREAD, x, dst)
    op_blocked()
}

/// Has the answer arrived? The claim's level, asked without spending anything.
///
/// Status-only. `Ok`: the reply is there and a `Resolve` will return it without
/// parking. `WouldBlock`: not yet, and the exchange is still live.
/// `PeerClosed`: it can never arrive, so the holder drops the claim instead of
/// spending a resolve on a dead exchange. Readiness is monotonic (pending goes
/// to settled and never back), so ready-then-resolve has no check-then-act
/// race.
///
/// This is `pipe_resolve`'s state split with the act removed, written out
/// rather than routed through `waitable_ready`. The deciding arm is `Settled`:
/// the level matrix reports a settled exchange as not ready, which is true of a
/// Waiter's level and would mislead a poller, since the answer went to somebody
/// else and asking again will not produce another. So this function reads the
/// states directly and reports the terminal where the matrix reports a false
/// level.
func pipe_ready(x: Int) unsafe -> SyscallResult {
    match EXCHANGES[x].state {
        case Replied -> op_ok(),
        case Taken -> {
            if EXCHANGES[x].request_refs == 0 {
                return op_status(SosStatus.PeerClosed)
            }
            op_status(SosStatus.WouldBlock)
        },
        case Staged -> {
            if PIPES[exchange_pipe(x)].outlet_refs == 0 {
                return op_status(SosStatus.PeerClosed)
            }
            op_status(SosStatus.WouldBlock)
        },
        case Settled -> op_status(SosStatus.PeerClosed),
        // Unreachable, for `pipe_resolve`'s reason: a `Free` exchange has no
        // reference columns, so no handle can name one.
        case Free -> {
            fatal_kernel("a pipe claim named a free exchange", x as UInt)
            op_status(SosStatus.NoResource)
        },
    }
}

/// The PipeRequest's ops: the server's obligation (spec §2.1).
func pipe_request_op(raw_op: UInt, obj: &PipeRequestObject, arg0: UInt,
                     arg1: UInt, arg2: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = PipeRequestOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return pipe_request_op_decoded(op, &obj, arg0, arg1, arg2, p)
}

func pipe_request_op_decoded(op: PipeRequestOp, obj: &PipeRequestObject,
                             arg0: UInt, arg1: UInt, arg2: UInt,
                             p: Int) unsafe -> SyscallResult {
    match op {
        case Reply -> {
            if not obj.allows(PipeRequestRight.Reply) {
                fault_process(p, FaultReason.AccessDenied)
            }
            let args = send_args(p, arg0, arg1, obj.handle, NO_PIPE)
            op_status(pipe_reply_status(p, obj.handle, obj.slot, &args))
        },
        // `Reply` gates the reply leg and the Waiter gates its own. The op does
        // two things, so it spends two rights on two objects: this bit, and
        // `WaiterRight.Wait` inside, read off the waiter handle the args record
        // names. This is the shape `MemoryOp.Map` has, for the same reason:
        // holding an obligation must not imply authority over somebody else's
        // Waiter.
        case ReplyWait -> {
            if not obj.allows(PipeRequestRight.Reply) {
                fault_process(p, FaultReason.AccessDenied)
            }
            pipe_reply_wait(p, obj.handle, obj.slot, arg0, arg1, arg2)
        },
        // The sender handle (spec §2.1). Holding the obligation is the whole
        // authority, so the only gate is this bit; the op consumes nothing.
        case Sender -> {
            if not obj.allows(PipeRequestRight.Sender) {
                fault_process(p, FaultReason.AccessDenied)
            }
            pipe_request_sender(p, obj.slot)
        },
    }
}

/// Mint `p` a Process handle onto the sender of the request exchange `x`
/// carries: the observe set, capped by `p`'s Process ceiling.
///
/// The answers come in a fixed order. A sender that is no longer live is
/// `Revoked` and mints nothing: the exchange kept no reference, so the record
/// is trusted only if it is live and still holds the pid the exchange kept
/// (`sender_alive`), and a record another handle still pins is as dead as a
/// reclaimed one. Then the mint: a caller at its handle budget answers
/// `QuotaExceeded` and one with a full table `NoResource`.
///
/// No second name can ask after the reply. The reply rewrites the exchange's
/// sender fields to the replier's, so a request handle that outlived it would
/// name the replier; none can, because `pipe_request_rights()` has no `Mint`,
/// which leaves an obligation one handle, and `Reply` and `ReplyWait` consume
/// it.
///
/// The new handle is a reference on the sender's record, counted as
/// `SystemOp.ProcessSelf`'s is. The exchange is left alone: the obligation is
/// not consumed and the reply is still owed.
func pipe_request_sender(p: Int, x: Int) unsafe -> SyscallResult {
    if not sender_alive(x) {
        return op_status(SosStatus.Revoked)
    }
    let r = EXCHANGES[x].sender_rec
    let handle = mint_capped(p, ObjType.Process, process_observe_rights(), r)
    if handle == NO_HANDLE {
        return op_status(mint_refusal(p))
    }
    ref_object(ObjType.Process, r)
    op_value(handle)
}

/// Write the reply and discharge the obligation, either way (spec §2.1).
///
/// The reply body rides the copy-in funnel into the very slot that carried the
/// request, and the request handle is consumed, so an obligation is discharged
/// exactly once through any one name. The request handle cannot be one of the
/// handles the reply carries: `check_send` raises that as a `BadArg` fault on
/// the caller, ahead of the exchange (spec §3).
///
/// To an abandoned request it answers `PeerClosed` and writes nothing. The
/// client dropping its claim is a cancellation signal the server may honour or
/// ignore (§2.1: abandonment is information, not an imperative), and a reply
/// that arrives afterwards is told so rather than silently succeeding,
/// ignorable with `let _ =`. The obligation is discharged all the same, which
/// lets the slot go, and the handles the reply carried are released.
///
/// An exchange already `Replied` (or `Settled`) answers `PeerClosed` too: there
/// is no longer a claim waiting for this reply. Single use is a property of the
/// exchange, not of the handle. The carried handles are released here as well.
///
/// No status of this op leaves the carried handles with the caller: every
/// answer other than a fault consumes them, by delivery or by release.
///
/// It answers a `SosStatus` rather than a `SyscallResult` because
/// `PipeRequestOp.ReplyWait` runs this leg and has to look at the answer: a
/// failure there is reported with a leg tag in the value register and no park.
/// `Reply` itself is `op_status` wrapped around it.
func pipe_reply_status(p: Int, word: UInt, x: Int,
                       args: &PipeSendRecord) unsafe -> SosStatus {
    let len = args.len

    match EXCHANGES[x].state {
        case Taken -> {
            if EXCHANGES[x].reply_refs == 0 {
                // Abandoned by the client. Nothing is copied, since there is
                // nobody to copy it for, and the obligation is discharged,
                // which settles the slot. Nothing is staged either: the
                // handles the reply meant to carry are released.
                consume_entry(p, word, ObjType.PipeRequest, x)
                release_carried(p, &args)
                return SosStatus.PeerClosed
            }
            if len != 0 {
                if let why = copy_in(p, exchange_body_addr(x), args.body, len) {
                    fault_process(p, why)
                }
            }
            EXCHANGES[x].len = len as UInt16
            // The replier is now the sender of what the slot holds. The
            // request's sender is read only through the obligation this reply
            // consumes.
            stamp_sender(x, p)
            // The reply direction stages into the same slots the request used,
            // and they are provably empty: the take that produced this
            // obligation moved every handle the request carried and cleared the
            // note. §2.1's `send(data?, handles?)` is symmetric, so this is the
            // identical act one direction over.
            hold_staged(p, x, &args, NO_PIPE)
            EXCHANGES[x].state = ExchangeState.Replied
            // The claim's level is now ready. A client parked on this claim is
            // woken here and its record carries the bytes just written; that is
            // what makes a blocking send a park rather than a poll.
            //
            // This runs before the consume rather than relying on it. The
            // consume below drops the obligation column and `drop_reference`
            // notifies as a side effect when that column reaches zero, but the
            // wake is this op's own act and is not left to the ledger.
            //
            // It goes through `notify_claim`: a claim is either a
            // subscription's or a parked thread's, and that function is the
            // only place in the kernel that tells the two apart. A fused caller
            // is woken from here with the bytes this line just wrote, inside
            // its own syscall.
            notify_claim(x)
            consume_entry(p, word, ObjType.PipeRequest, x)
            SosStatus.Ok
        },
        case Replied -> {
            consume_entry(p, word, ObjType.PipeRequest, x)
            release_carried(p, &args)
            SosStatus.PeerClosed
        },
        // A delivered reply, discharged through somebody's wait. It is
        // `Replied`'s answer for `Replied`'s reason (no claim is left waiting
        // for this reply); the arm is separate because the two states are
        // reached differently and a reader should be able to see which one
        // happened.
        case Settled -> {
            consume_entry(p, word, ObjType.PipeRequest, x)
            release_carried(p, &args)
            SosStatus.PeerClosed
        },
        // Unreachable: an obligation is minted at the take, the same moment the
        // exchange leaves `Staged`, and a `Free` exchange has no reference
        // columns for a handle to name. See `pipe_resolve`'s own arm for why
        // each of these yields a status nothing reaches.
        case Staged -> {
            fatal_kernel("a pipe obligation named a staged exchange", x as UInt)
            SosStatus.NoResource
        },
        case Free -> {
            fatal_kernel("a pipe obligation named a free exchange", x as UInt)
            SosStatus.NoResource
        },
    }
}

/// Resolve a raw word as a Waiter this process may park on: the second half of
/// `ReplyWait`'s authority.
///
/// This is `memory_arg`'s shape at a different kind and with a right to spend:
/// the word arrives in an argument record rather than in the handle register,
/// so the dispatch's §3 order has not run on it and this is where it does. A
/// word that names nothing, or something that is not a Waiter, is the ordinary
/// `BadHandle` fault.
func reply_wait_waiter(p: Int, handle: UInt) unsafe -> Int {
    let entry = lookup_handle(p, handle)
    match entry.obj_type {
        case Waiter -> {
            let w = WaiterObject(handle: WaiterHandle(handle),
                                 rights: entry.rights, slot: entry.target)
            if not w.allows(WaiterRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            w.slot
        },
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case _ -> fault_process(p, FaultReason.BadHandle),
    }
}

/// Discharge the obligation, then park on the Waiter, behind one trap.
///
/// This is `pipe_reply_status` followed by `waiter_wait` and nothing else: a
/// fused op is the composition run without returning to userspace, so both legs
/// are the existing functions in the existing order, and every rule either
/// obeys applies verbatim. The steady-state server loop is one trap per message
/// it answers, and two per message it discards, since a tell is owed no reply:
/// this op is not the one that runs there, and the obligation the delivery
/// minted has to be released instead (spec §2.1).
///
/// Every fault is raised before the obligation is discharged; this is the
/// function's one real ordering decision. A bad args record, a waiter handle
/// that names nothing or lacks `Wait`, an oversized body, the request handle
/// itself or the waiter's word among the carried handles, a record buffer
/// outside the caller's memory all end the process, and all are asked while the
/// request is still live, so a caller that faults leaves an exchange its client
/// can still be told about rather than one discharged into a process that no
/// longer exists.
///
/// A refused reply returns without parking. The request is consumed either way
/// (§2.1), but a `PeerClosed` comes straight back with `ReplyWaitLeg.Reply` in
/// the value register, so one dead client can never stall a server loop. The
/// recovery is the caller's own next `WaiterOp.Wait`. The reply's carried
/// handles are released on that refusal, as `pipe_reply_status` releases them.
func pipe_reply_wait(p: Int, word: UInt, x: Int, args_src: UInt,
                     args_bytes: UInt, rec_dst: UInt) unsafe -> SyscallResult {
    // Exactly the published size (`timer_arm`'s rule): the record is the whole
    // argument list, and a caller that hands over a different number of words
    // has built something else.
    if args_bytes != (pipe_reply_wait_record_bytes() as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    var args = PipeReplyWaitRecord(
        waiter: 0,
        msg: PipeSendRecord(body: 0, len: 0, handles: [NO_HANDLE; PIPE_MSG_HANDLES]))
    if let why = copy_in(p, ((&var args) as UnsafePointer<PipeReplyWaitRecord>) as UInt,
                         args_src, args_bytes) {
        fault_process(p, why)
    }
    // The message half is validated by the funnel every sending op uses. It
    // arrived in this record rather than in its own, so it is handed to
    // `send_args`' checks through the address of the nested field: the length
    // bound and the four handle words, on the same terms as a `Reply`. Every
    // one of those refusals is a fault, and every one happens while the
    // obligation is still live.
    check_send(p, &args.msg, word, args.waiter, NO_PIPE)
    let w = reply_wait_waiter(p, args.waiter)
    // The wait leg's buffer is validated here, on the call, as `waiter_wait`
    // validates its own: terminating a bad-buffer caller while it is the
    // running process is the better diagnostic. Asking now also means the reply
    // below cannot be discharged into a call that is about to fault. There is
    // no capacity argument left to check it against, so the published size is
    // the number the door is asked about.
    if let why = copy_out_check(p, rec_dst, wait_record_bytes() as UInt) {
        fault_process(p, why)
    }

    let answered = pipe_reply_status(p, word, x, &args.msg)
    match answered {
        case Ok -> {},
        case _ -> {
            return op_status_value(answered, ReplyWaitLeg.Reply as UInt)
        },
    }

    // `waiter_wait`'s tail. An invalid Waiter answers `Revoked` with the value
    // register at zero, `ReplyWaitLeg.Wait`: the reply was written, and it is
    // the wait that cannot be served. Then the scan, because by the
    // level-triggered guarantee a readiness that arrived before this call
    // (including one this very reply just raised on a claim of another
    // connection) is still there, and only an empty set parks.
    if waiter_invalid(w) {
        return op_status(SosStatus.Revoked)
    }
    let ready = waiter_ready_attachment(w)
    if ready != NO_ATTACHMENT {
        // A delivery can refuse: a message carrying handles needs room in this
        // table for them, and a full one answers the table-full status having
        // delivered nothing. The value register stays zero, which is
        // `ReplyWaitLeg.Wait`: the reply was written, and it is the wait that
        // could not be served.
        return op_status(deliver_attachment(p, rec_dst, ready))
    }
    if CURRENT_THREAD == NO_THREAD {
        fault_process(p, FaultReason.BadState)
    }
    block_on_wait(CURRENT_THREAD, w, rec_dst)
    op_blocked()
}

/// Consume the caller's entry through the op: the transfer-funnel contract
/// reached by an op rather than by `give`.
///
/// It makes `RELEASE_OP`'s two calls in `release_handle`'s order: unbind first
/// (so nothing in the unref's cascade can find the entry by lookup), then
/// unref, which may take the exchange's column to zero and settle the ring
/// slot. The
/// generation bump comes with the unbind, so the word the caller used is stale
/// the instant the op returns and using it again is the diagnosed `BadHandle`
/// fault rather than an alias.
///
/// It detaches first. An attachment is a counted reference, and `resolve`
/// consuming the claim (or `reply` discharging the obligation) is an op that
/// consumes the object, so without the implicit detach the op could not free
/// the ring slot, and refusing while attached would wedge the op ordering.
///
/// The order is detach, then unbind, then unref, and it is the only safe one:
/// the caller's entry is still a reference while the detach runs, so dropping
/// the attachment's cannot take the column to zero and cannot settle an
/// exchange the two lines below still name. The entry's own drop is what
/// reaches zero, and it is last.
func consume_entry(p: Int, word: UInt, kind: ObjType, target: Int) unsafe {
    detach_consumed(kind, target)
    unbind_handle(p, handle_word_index(word))
    unref_object(kind, target)
}

/// The implicit detach: drop any subscription on the object this op is about to
/// consume.
///
/// The `_` arm is deliberate. This function is asked about an `ObjType` because
/// that is what an op has, and the question it answers ("is this a single-use
/// object an op can consume?") is true of exactly the two one-shot kinds and
/// false of every other by construction. A kind that becomes consumable joins
/// the list because its op has to be written, not because a match here changed
/// shape.
func detach_consumed(kind: ObjType, target: Int) unsafe {
    match kind {
        case PipeReply -> { detach_watcher(WaitableKind.PipeReply, target) },
        case PipeRequest -> { detach_watcher(WaitableKind.PipeRequest, target) },
        case _ -> {},
    }
}

/// Take whatever is watching `target` off its Waiter, and drop the reference
/// the attachment held. A no-op when nobody is watching.
func detach_watcher(watched: WaitableKind, target: Int) unsafe {
    let a = waitable_attachment(watched, target)
    if a == 0 {
        return
    }
    detach_attachment(ATTACHMENTS[a - 1].waiter, a - 1)
    unref_waitable(watched, target)
}

/// Handle-table lookup -> object type -> op table -> rights check -> op.
///
/// This is where a raw word becomes a typed handle (§3), and the order is the
/// point: the number arrives from a register, the table says what it names, and
/// only then is a `SystemHandle` / `ProcessHandle` / `ThreadHandle`
/// constructed. Below this line the kernel is handling an object it resolved,
/// paired with the rights that came with it and the slot it names, not an
/// integer a process chose.
///
/// An unbound handle terminates the process, decided here rather than per kind:
/// a handle that names nothing names no kind either, so there is no op table to
/// ask. The caller errors the dispatch raises before an op body runs include an
/// unbound handle, an unknown op and a missing right; op bodies raise others
/// (`BadArg`, `BadState` and so on).
///
/// The universal ops (release, mint and info) are intercepted between the
/// lookup and the kind match. After the lookup, the entry is resolved and a
/// word naming nothing still faults; before the kind match, no op has to exist
/// once per kind. This is the one point in the kernel that knows a handle's
/// entry and not yet its kind, which is the altitude a kind-independent op
/// belongs at.
func dispatch(handle: UInt, op: UInt,
              arg0: UInt, arg1: UInt, arg2: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    let entry = lookup_handle(p, handle)
    if op == RELEASE_OP {
        return release_handle(p, handle, entry)
    }
    if op == MINT_OP {
        return mint_sibling(p, entry, arg0)
    }
    if op == INFO_OP {
        return handle_info(p, entry, arg0)
    }
    match entry.obj_type {
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case System -> {
            let obj = SystemObject(handle: SystemHandle(handle),
                                   rights: entry.rights)
            system_op(op, &obj, arg0, arg1, arg2)
        },
        case Process -> {
            let obj = ProcessObject(handle: ProcessHandle(handle),
                                    rights: entry.rights, slot: entry.target)
            process_op(op, &obj, arg0, arg1, arg2)
        },
        case Thread -> {
            let obj = ThreadObject(handle: ThreadHandle(handle),
                                   rights: entry.rights, slot: entry.target)
            thread_op(op, &obj, arg0)
        },
        case Event -> {
            let obj = EventObject(handle: EventHandle(handle),
                                  rights: entry.rights, slot: entry.target)
            event_op(op, &obj, arg0)
        },
        case Waiter -> {
            let obj = WaiterObject(handle: WaiterHandle(handle),
                                   rights: entry.rights, slot: entry.target)
            waiter_op(op, &obj, arg0, arg1, arg2)
        },
        case Interrupt -> {
            let obj = InterruptObject(handle: InterruptHandle(handle),
                                      rights: entry.rights, slot: entry.target)
            interrupt_op(op, &obj)
        },
        case Clock -> {
            let obj = ClockObject(handle: ClockHandle(handle),
                                  rights: entry.rights, slot: entry.target)
            clock_op(op, &obj, arg0, arg1)
        },
        case Timer -> {
            let obj = TimerObject(handle: TimerHandle(handle),
                                  rights: entry.rights, slot: entry.target)
            timer_op(op, &obj, arg0, arg1)
        },
        // A Memory has two ops, derive and install (spec §2.5); an unknown
        // number aimed at one is `BadOp` inside `memory_op` rather than at this
        // line.
        case Memory -> {
            let obj = MemoryObject(handle: MemoryHandle(handle),
                                   rights: entry.rights, slot: entry.target)
            memory_op(op, &obj, arg0, arg1)
        },
        case IoMemory -> {
            let obj = IoMemoryObject(handle: IoMemoryHandle(handle),
                                     rights: entry.rights, slot: entry.target)
            iomemory_op(op, &obj, arg0, arg1)
        },
        case Mapping -> {
            let obj = MappingObject(handle: MappingHandle(handle),
                                    rights: entry.rights, slot: entry.target)
            mapping_op(op, &obj)
        },
        // Two arms onto one slab. `entry.target` is the connection for both,
        // and the kind decides which op table answers and which rights enum the
        // word is read against (§3's order).
        case PipeInlet -> {
            let obj = PipeInletObject(handle: PipeInletHandle(handle),
                                      rights: entry.rights, slot: entry.target)
            pipe_inlet_op(op, &obj, arg0, arg1, arg2)
        },
        case PipeOutlet -> {
            let obj = PipeOutletObject(handle: PipeOutletHandle(handle),
                                       rights: entry.rights, slot: entry.target)
            pipe_outlet_op(op, &obj, arg0, arg1, arg2)
        },
        // Two more arms onto the ring slots inside that slab. `entry.target` is
        // an exchange here rather than a connection (`connection *
        // PIPE_INFLIGHT + ring slot`), and the kind again decides which op
        // table answers and which rights enum the word is read against.
        case PipeReply -> {
            let obj = PipeReplyObject(handle: PipeReplyHandle(handle),
                                      rights: entry.rights, slot: entry.target)
            pipe_reply_op(op, &obj, arg0, arg1)
        },
        case PipeRequest -> {
            let obj = PipeRequestObject(handle: PipeRequestHandle(handle),
                                        rights: entry.rights, slot: entry.target)
            pipe_request_op(op, &obj, arg0, arg1, arg2)
        },
    }
}

// =============================================================================
// The trap handler
// =============================================================================

/// Which stats column a trap lands in: the cause class `ktrap` decides on,
/// named.
///
/// It is an enum rather than three counter functions because the "which
/// process, and is there one" question below must have exactly one answer in
/// the kernel; three bodies would be three places to get the boot-door case
/// wrong.
///
/// It is not backed, because these numbers cross nothing: the column indices
/// that do cross are `sosabi`'s `PROCESS_STATS_*_SLOT`, and this enum never
/// meets them.
enum TrapKind {
    case Syscall,
    case Interrupt,
    case Fault,
}

/// Charge one trap to the process that was running when it arrived.
///
/// The attribution is `CURRENT_THREAD`'s process, read at trap entry, which
/// makes every column mean the same thing: a syscall is charged to the process
/// that issued it even when the op switches to another, and an interrupt is
/// charged to the process it preempted rather than to whoever the reschedule
/// picks.
///
/// A trap with no current thread is unattributed (the boot door).
/// `calling_process()` answers `ROOT_PROCESS` for that case, which is right for
/// a syscall's dispatch, where the harness kernels that enter user mode with no
/// object model still have to be served, and wrong here, because charging root
/// for traps taken before root was reified would make its opening count
/// unpredictable. So this reads the thread word itself and counts nothing when
/// there is none. Nothing is lost: `start_process` is the only door into user
/// mode and it installs a thread before it opens, so the guard keeps the
/// unattributed set empty rather than compensating for it.
///
/// An interrupt taken at the idle poll or a preemption point is not a trap and
/// is not counted. Those arrive through `irq_poll` inside the kernel, never
/// through a vector, so they never reach this function; that is right for a
/// column that means "interrupts taken while this process was current", since
/// at both of those sites no process was.
func count_trap(kind: TrapKind) unsafe {
    if CURRENT_THREAD == NO_THREAD {
        return
    }
    // The column is the body's row of the published region: `kcore.stats` owns
    // the doubleword, `ProcessOp.Stats` reads it back out of the same place,
    // and a supervisor holding a read-only mapping sees this store land with
    // no syscall of its own. A current thread's process is live, so it has a
    // body.
    let row = body_of(THREADS[CURRENT_THREAD].process)
    match kind {
        case Syscall -> { stats_bump(row, PROCESS_STATS_SYSCALLS_SLOT) },
        case Interrupt -> { stats_bump(row, PROCESS_STATS_INTERRUPTS_SLOT) },
        case Fault -> { stats_bump(row, PROCESS_STATS_FAULTS_SLOT) },
    }
}

/// The HAL's landing point for every trap taken from user mode. `frame_addr`
/// addresses the saved context, which this handler may rewrite: a returning
/// syscall leaves its (status, value) pair where the caller reads them and
/// resumes past the trapping instruction, both through the HAL because both are
/// register conventions.
///
/// It returns the frame to resume, and that return value is the whole of the
/// context switch. Handing back the frame it was called with resumes the
/// interrupted thread; handing back another thread's frame resumes that one,
/// and the HAL's trap entry cannot tell the difference. So a switch has one
/// location, the user-return boundary by construction, and the kernel is never
/// half-way through one.
///
/// A trap the HAL claims as a thread's first use of floating point
/// (`hal.fp_trap`) is asked first and resumes the same frame. It is none of the
/// three kinds below and no stats column counts it.
///
/// Three kinds of trap, told apart by the order below. An interrupt is not the
/// running program's business: it is serviced and the interrupted instruction
/// resumes untouched, which is why it is decided first and never reaches the
/// syscall return path (that path steps the saved program counter, and stepping
/// past an instruction that has not run yet would lose it). A fault is fatal:
/// spec §8 makes a thread fault kill its process. A bad syscall is fatal too:
/// an unknown handle, an unknown op or a missing right is a mistake the caller
/// could have checked, so it ends the process rather than handing back a word
/// to branch on. What is left as a status is what the caller could not have
/// known, such as a full slab or a dead peer.
///
/// The stats columns are counted here because the cause class is decided
/// exactly once in the system, at this function's head, before anything is
/// dispatched: the column is a by-product of a decision the handler was already
/// making, with no second site to keep in step. One increment per trap, never
/// two: the three branches below are mutually exclusive and each charges before
/// it commits to its path.
@export("ktrap")
public func ktrap(frame_addr: UInt, cause: UInt, tval: UInt) unsafe -> UInt {
    if hal.is_interrupt(cause) {
        count_trap(TrapKind.Interrupt)
        service_irq(frame_addr, cause)
        return pick_next(frame_addr)
    }

    // A thread's first floating-point instruction traps, and the HAL gives it
    // its own state and lets it run on. The thread resumes at the instruction
    // that trapped, so this is not a syscall, a fault or an interrupt and no
    // stats column counts it; the line is its observable.
    if hal.fp_trap(frame_addr, cause) {
        console().write_str("SOS: fp first use\n")
        return frame_addr
    }

    if not hal.is_syscall(cause) {
        // Charged before the report, because the report does not return: the
        // process is ended by `fault_trap` and its slot lives on as `Gone` for
        // whoever holds a handle onto it, so this increment is what lets a
        // supervisor read how its child died and that it faulted once.
        count_trap(TrapKind.Fault)
        fault_trap(hal.cause_tag(cause), cause, hal.trap_pc(frame_addr), tval)
    }

    // Charged before the dispatch, so a call that never comes back is counted
    // the same as one that does: an op that parks is one syscall however long
    // it parks (the wake writes the pair, it does not re-enter here), an op
    // that ends the process (`Exit`, and every caller-checkable refusal that
    // terminates) is counted against the process that made it, and an op that
    // switches to a different process is charged to the one that asked.
    count_trap(TrapKind.Syscall)

    let result = dispatch(hal.syscall_handle(frame_addr),
                          hal.syscall_op(frame_addr),
                          hal.syscall_arg0(frame_addr),
                          hal.syscall_arg1(frame_addr),
                          hal.syscall_arg2(frame_addr))

    // The syscall boundary: the one place the typed status becomes the number
    // the ABI specifies. `as` on a backed enum is total, so nothing here can
    // fail or disagree with `sosabi`'s table.
    //
    // A blocked caller is skipped. Its pair belongs to whatever wakes it, and
    // writing one here would answer a question nobody has asked yet and, where
    // the saved program counter points at the trapping instruction, step it a
    // second time when the wake wrote the real pair.
    if not result.blocked {
        write_result(frame_addr, result)
    }
    pick_next(frame_addr)
}

static BYTE_MASK: UInt = 0xFF
