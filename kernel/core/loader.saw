//! The sosimg loader (spec §5.6, §7, §12).
//!
//! One loader, two doors. The kernel loads root at boot and a child at
//! `process_create`, and both go through the phases below with different region
//! parameters and a different failure vocabulary, never two copies of the walk.
//! Spec §12's "no second code path" holds by construction: `validate_image` and
//! `place_image` take the destination as an argument, `fatal_image` versus a
//! `BadImage` status is the caller's choice, and nothing else in the tree reads
//! a segment record.
//!
//! What lives here holds for every target and every image: the order the checks
//! run in, that nothing is placed before everything validates, and that a
//! malformed shape is diagnosed rather than half-loaded.
//!
//! The loader sits below the dispatch: `process_create` is an op, so the phases
//! must be reachable from `kcore.dispatch`. Nothing here reaches upward;
//! placement calls the HAL, the movers and the process body, all of which are
//! below.

import hal
import imgformat.{SosimgHeader, SosimgSeg, SegFlag, fits_target_word}
import kcore.mem.{align_up}
import kcore.diag.{console, fatal_image}
import kcore.stats.{stats_publish}
import kcore.preempt.{long_copy, long_zero}
import kcore.limits.{MAX_GRANT_ROWS, NO_MEMORY, ROOT_PROCESS}
import kcore.process.{claim_root, load_domain, record_grant, seal_image_rows,
                      start_process}

/// What a refused too-high address reports: its top 32 bits. The low half is
/// what would have survived a narrowing, so it says nothing; the high half is
/// the part the machine cannot reach. (`write_hex` prints a machine word, which
/// on the profile that can raise this is 32 bits wide.)
static HIGH_HALF_SHIFT: Int = 32

// =============================================================================
// The sosimg loader (spec §5.6, §7, §12)
// =============================================================================
//
// The image is not ELF; a microkernel-sized loader gets a flat header.
//
// The layout is not described here. It is the `imgformat` package, shared with
// the Blade target that emits it, and this loader overlays those structs on the
// appended bytes: one `UnsafeMemory` view construction per record, then plain
// field names (`seg.mem_len`). The format's alignment discipline (every u32
// 4-aligned, no interior padding, pinned there by `static_assert`) is what
// makes the overlay exact and turns a layout edit into a compile error.
//
// Where a process's region is, how many grants there are to spend and what a
// permission bit does to the hardware are the HAL's, so the numbers are read
// from it (for root) or carried in a `LoadRegion` (for a child).

/// Where an image is going: the parameter that turns one loader into two doors.
///
/// `base`..`top` is the whole destination range (the physical frames the bytes
/// go into) and `stack_len` is what the kernel takes off the top for the first
/// thread's stack, so segments must fit below `top - stack_len`. A child gets
/// the same rule as root: root supplies a region capability and no numbers.
///
/// `link_base` is the virtual address the image was linked at, which is where
/// the process sees the bytes. It comes from the HAL (`hal.image_link_base`): a
/// translating board answers with the one canonical base whatever the frames
/// are, and a board without translation answers with where the image loads, the
/// identity, which folds away. So placement is parameterized here and nothing
/// below branches on a tier.
public(package) struct LoadRegion {
    public(package) base: UInt,
    public(package) top: UInt,
    public(package) stack_len: UInt,
    public(package) link_base: UInt,
}

extension LoadRegion {
    /// The virtual top: the link base plus the destination's own length.
    /// Computed as an offset from `link_base` rather than stored, so the two
    /// ranges are the same size by construction.
    public(package) func link_top(&self) -> UInt {
        self.link_base + (self.top - self.base)
    }

    /// The physical address the user address `va` names in this image.
    ///
    /// One affine map for the whole destination, so placement derives every
    /// segment's frames from its link address with one rule. (The copy funnels
    /// resolve a user address through the grant rows instead, in
    /// `translate_user`, and refuse a range that crosses a row.) On the
    /// identity tier `link_base == base`, so this is `va`.
    public(package) func phys_of(&self, va: UInt) -> UInt {
        self.base + (va - self.link_base)
    }
}

/// Why an image was refused: the answer the shared phases give, so the two
/// doors can report it their own way.
///
/// The boot door turns it into `fatal_image`, because a machine whose only
/// image is malformed has nothing else to do. The create door turns it into
/// `SosStatus.BadImage`, because image bytes are data a launcher was handed and
/// a launcher that cannot report a bad image cannot launch anything else
/// either. `reason` is the same sentence in both.
public(package) struct ImageFault {
    public(package) reason: String,
    public(package) detail: UInt,
}

/// Root's destination, from the HAL's own constants.
public(package) func root_region() -> LoadRegion {
    LoadRegion(base: hal.ROOT_LOAD_BASE, top: hal.ROOT_REGION_TOP,
               stack_len: hal.ROOT_STACK_LEN,
               link_base: hal.image_link_base(hal.ROOT_LOAD_BASE))
}

/// Overlay the header on the image's first bytes. One view construction, then
/// an ordinary safe struct; the unsafety is confined to this line.
///
/// `addr` is physical (a sosimg blob's base is an address-as-data and stays
/// physical). The kernel reaches it through the linear map; `hal.phys_to_virt`
/// is the identity on the tier without translation.
func header_at(addr: UInt) unsafe -> SosimgHeader {
    UnsafeMemory<SosimgHeader, Normal>(hal.phys_to_virt(addr)).read()
}

/// Overlay one segment record. Same conversion, same reason.
func seg_at(addr: UInt) unsafe -> SosimgSeg {
    UnsafeMemory<SosimgSeg, Normal>(hal.phys_to_virt(addr)).read()
}

/// Validate one segment record against the image bounds and the destination
/// region. `None` when it is loadable.
///
/// Checks are ordered so no bound is computed by an addition that could
/// overflow: a hostile length must produce a diagnostic, not a panic.
///
/// A segment whose link address names its own bytes in the image
/// (`hal.same_bytes`) is used in place (spec §5.6): `check_in_place` judges it
/// against the image, and the destination region does not hold it. Every other
/// segment is copied and judged against the region. Either kind must also be
/// linked where the board's buses can serve it (`hal.segment_bus_ok`).
func check_segment(seg: &SosimgSeg, img_base: UInt, img_len: UInt,
                   dest: &LoadRegion, allow_device: Bool) -> ImageFault? {
    let file_off = seg.file_off as UInt
    let file_len = seg.file_len as UInt
    let mem_len = seg.mem_len as UInt

    // The format's addresses are 64-bit on every profile, so a 32-bit kernel
    // can be handed an image it cannot address. Refuse: narrowing would wrap a
    // high address into a low one and place the segment somewhere the linker
    // never meant. The test folds away on a 64-bit build.
    if not fits_target_word(seg.load_addr) {
        return ImageFault(reason: "segment loads past this machine's address space",
                          detail: (seg.load_addr >> HIGH_HALF_SHIFT) as UInt)
    }
    let load_addr = seg.load_addr as UInt

    if file_off > img_len {
        return ImageFault(reason: "segment starts past the image", detail: file_off)
    }
    if file_len > img_len - file_off {
        return ImageFault(reason: "segment runs past the image", detail: file_len)
    }
    if not seg.mem_covers_file() {
        return ImageFault(reason: "segment mem_len below file_len", detail: mem_len)
    }

    // Write-without-read is not a grant any target should install, and one
    // profile's hardware reserves the encoding outright. Checked before the
    // device branch because it holds for both kinds of record.
    if not seg.has_sane_perms() {
        return ImageFault(reason: "segment permissions are not a valid grant",
                          detail: seg.flags as UInt)
    }

    // A device window is judged against the board, not the destination region
    // (it names hardware, not RAM), so it takes its own path and returns.
    if seg.is_device_grant() {
        if not allow_device {
            // A child may not declare an MMIO window. Extending the boot-time
            // image-declares/board-authorizes grant to every child would make
            // "which process gets the UART" a race between images. A driver
            // child gets its window as a capability root hands over (an
            // `IoMemory`, mapped or given).
            return ImageFault(reason: "a child image may not declare a device window",
                              detail: load_addr)
        }
        return check_device_grant(&seg, load_addr, file_len, mem_len)
    }

    // Asked only once the file range is known to lie in the image, so the
    // bytes `same_bytes` is asked about are the image's own.
    let in_place = used_in_place(&seg, img_base)
    if in_place {
        if let bad = check_in_place(&seg, img_len, load_addr) {
            return bad
        }
    }
    if not hal.segment_bus_ok(load_addr, mem_len, seg.flags, in_place) {
        return ImageFault(
            reason: "segment is linked where this board cannot serve it",
            detail: load_addr)
    }
    if in_place {
        return None
    }

    // Judged in the virtual domain: a segment's `load_addr` is what the linker
    // wrote, so the region it must fit is the one the image was linked into
    // (`link_base` and the destination's length), not the frames it is copied
    // to.
    if load_addr < dest.link_base {
        return ImageFault(reason: "segment loads below the root region",
                          detail: load_addr)
    }
    // A grant covers whole units of the target's protection granularity, so a
    // segment starting mid-unit would be granted along with whatever shares its
    // first unit: the previous segment's tail, at the previous segment's
    // permissions. On a page-granular profile that is how code would silently
    // become writable; on a four-byte-granular one it never arises. Refuse the
    // image, which is right on both.
    if (load_addr & (hal.PROT_GRAIN - 1)) != 0 {
        return ImageFault(reason: "segment is not aligned to the grant granularity",
                          detail: load_addr)
    }
    let limit = dest.link_top() - dest.stack_len
    if load_addr > limit {
        return ImageFault(reason: "segment loads above the root region",
                          detail: load_addr)
    }
    if mem_len > limit - load_addr {
        return ImageFault(reason: "segment overruns the root region",
                          detail: mem_len)
    }
    None
}

/// Is this segment used in place: does its link address name its own bytes in
/// the image at `img_base` (spec §5.6)? The one test `check_segment` and
/// `place_image` both ask, so the two cannot disagree. A segment with no bytes
/// has nothing to use in place. The caller has held the file range to the
/// image, so the sum cannot wrap.
func used_in_place(seg: &SosimgSeg, img_base: UInt) -> Bool {
    let file_len = seg.file_len as UInt
    if file_len == 0 {
        return false
    }
    hal.same_bytes(seg.load_addr as UInt, img_base + (seg.file_off as UInt),
                   file_len)
}

/// Validate a segment used in place: its grant names the image's own bytes, so
/// it must be one the image can stand behind (spec §5.6).
///
/// Readable and not writable, since the bytes are the image's: flash, or
/// memory its launcher holds. No zero-filled tail, since nothing is placed
/// and the bytes past `file_len` are whatever follows in the image. Aligned to
/// the grain, for `check_segment`'s reason. And its grant, rounded up to the
/// grain, inside the image, so the rounding reaches no byte the image does not
/// hold. The file range is already held to the image, so the room after it
/// cannot underflow.
func check_in_place(seg: &SosimgSeg, img_len: UInt,
                    load_addr: UInt) -> ImageFault? {
    let file_off = seg.file_off as UInt
    let file_len = seg.file_len as UInt
    let mem_len = seg.mem_len as UInt
    if not seg.is_readable() {
        return ImageFault(reason: "segment used in place is not readable",
                          detail: seg.flags as UInt)
    }
    if seg.is_writable() {
        return ImageFault(reason: "segment used in place is writable",
                          detail: seg.flags as UInt)
    }
    if mem_len != file_len {
        return ImageFault(
            reason: "segment used in place has a zero-filled tail",
            detail: mem_len)
    }
    if (load_addr & (hal.PROT_GRAIN - 1)) != 0 {
        return ImageFault(
            reason: "segment is not aligned to the grant granularity",
            detail: load_addr)
    }
    let over = file_len % hal.PROT_GRAIN
    let pad: UInt = if over == 0 { 0 } else { hal.PROT_GRAIN - over }
    if pad > img_len - file_off - file_len {
        return ImageFault(
            reason: "segment used in place is granted past the image",
            detail: file_len)
    }
    None
}

/// Validate a device window record.
///
/// The image declares and the board authorizes; both halves are load-bearing. A
/// window in the image makes "this program drives that device" a property of
/// the program, and a window the board publishes stops an image naming any
/// physical address it likes and being handed it. The board offers exactly one,
/// the console UART's page, so the authorization is a comparison rather than a
/// table.
///
/// Images need not use this path: driver packages obtain their windows as an
/// `IoMemory` derived from a device row of the region table (spec §2.5),
/// installed by `IoMemoryOp.Map` or handed over by `Process.give(iomemory:)`,
/// and checked against `hal.device_window_ok`. It remains because the flag it
/// reads (`imgformat`'s `SegFlag.Device`) and the emitter that writes it are in
/// the sawlang toolchain. Retiring it also
/// removes this function, `check_segment`'s device branch, `place_image`'s
/// device arm and `validate_image`'s `allow_device` parameter. A child image is
/// refused a declared window either way.
func check_device_grant(seg: &SosimgSeg, load_addr: UInt, file_len: UInt,
                        mem_len: UInt) -> ImageFault? {
    // A window carries no bytes: there is nothing in an image file to place at
    // a hardware address, and a record claiming otherwise has been built wrong.
    if file_len != 0 {
        return ImageFault(reason: "device grant carries image bytes",
                          detail: file_len)
    }
    if load_addr != hal.DEVICE_GRANT_BASE {
        return ImageFault(reason: "device grant names a window this board does not offer",
                          detail: load_addr)
    }
    if mem_len != hal.DEVICE_GRANT_LEN {
        return ImageFault(reason: "device grant is not the size of that window",
                          detail: mem_len)
    }
    None
}

// -----------------------------------------------------------------------------
// Validation: everything, before anything
// -----------------------------------------------------------------------------

/// An image's header and segment table, as the kernel read them: copied out of
/// the image once, by `validate_image`, and never read there again.
///
/// The image is memory, and memory a process may be able to write while the
/// kernel places it: a launcher's region mapped into another process, or a
/// buffer a delivery writes into at one of placement's preemption points. So
/// what was validated is what is placed only if placement reads the copy that
/// was validated. The segments' bytes are still read from the image as they
/// are placed; they are the process's contents, not instructions to the
/// kernel, and nothing about them was validated.
///
/// The table holds every segment an image may have: `kcore.limits` asserts
/// that `MAX_GRANT_ROWS` covers `hal.MAX_ROOT_SEGMENTS` and the stack.
public(package) struct ImageTable {
    public(package) header: SosimgHeader,
    public(package) segs: [SosimgSeg; MAX_GRANT_ROWS],
}

extension ImageTable {
    /// A table with nothing read into it yet.
    public(package) static func empty() -> ImageTable {
        let seg = SosimgSeg(load_addr: 0, file_off: 0, file_len: 0, mem_len: 0,
                            flags: 0, reserved0: 0, reserved1: 0,
                            reserved2: 0)
        ImageTable(header: SosimgHeader(magic: 0, version: 0, seg_count: 0,
                                        arch: 0, prio_map: 0, reserved0: 0,
                                        entry: 0),
                   segs: [seg; MAX_GRANT_ROWS])
    }

    /// The validated header's entry point.
    public(package) func entry(&self) -> UInt {
        self.header.entry as UInt
    }

    /// The validated header's segment count.
    public(package) func seg_count(&self) -> UInt {
        self.header.seg_count as UInt
    }

    /// The validated header's §7 band map.
    public(package) func prio_map(&self) -> UInt {
        self.header.prio_map as UInt
    }
}

/// Validate a whole image against `img_len` bytes at `img_base` and the
/// destination `dest`, reading its header and segment table into `table`.
/// `None` when every byte of it may be placed.
///
/// Each record is read out of the image once, here, and judged as read; the
/// placement that follows reads `table` and not the image (see `ImageTable`).
///
/// No effect happens in here. A refused image leaves the destination region
/// untouched, so a launcher that gets `BadImage` back has lost only the call,
/// and a refused boot image leaves the root region as the linker left it.
///
/// No preemption point: at most `hal.MAX_ROOT_SEGMENTS` iterations of an O(1)
/// body.
public(package) func validate_image(
    img_base: UInt,
    img_len: UInt,
    dest: &LoadRegion,
    allow_device: Bool,
    table: &var ImageTable
) unsafe -> ImageFault? {
    let header_len = sizeof<SosimgHeader>() as UInt
    let seg_len = sizeof<SosimgSeg>() as UInt

    if img_len < header_len {
        return ImageFault(reason: "no root image appended", detail: img_len)
    }

    table.header = header_at(img_base)
    let header = table.header
    if not header.has_magic() {
        return ImageFault(reason: "bad magic", detail: header.magic as UInt)
    }
    if not header.has_known_version() {
        return ImageFault(reason: "unsupported version", detail: header.version as UInt)
    }
    // An image built for the other profile is refused rather than jumped into:
    // its instructions are not this machine's and its addresses need not be in
    // this machine's map.
    if not header.is_for_arch(hal.arch_tag()) {
        return ImageFault(reason: "image is for another architecture",
                          detail: header.arch as UInt)
    }

    let seg_count = header.seg_count as UInt
    if seg_count == 0 {
        return ImageFault(reason: "image has no segments", detail: 0)
    }
    // The budget is the reload set's, not the image's: segments plus the
    // kernel's stack grant must fit the rows one process's domain is made of,
    // and `MAX_ROOT_SEGMENTS` is that budget minus the stack. A child is
    // bounded by the same number because only one domain is installed at a
    // time.
    if seg_count > hal.MAX_ROOT_SEGMENTS {
        return ImageFault(reason: "more segments than the grant budget",
                          detail: seg_count)
    }
    let table_len = seg_count * seg_len
    if table_len > img_len - header_len {
        return ImageFault(reason: "segment table runs past the image",
                          detail: table_len)
    }

    // Same rule as a segment's address, at the one other place a 64-bit field
    // becomes a machine word: refuse, never narrow.
    if not fits_target_word(header.entry) {
        return ImageFault(reason: "entry is past this machine's address space",
                          detail: (header.entry >> HIGH_HALF_SHIFT) as UInt)
    }
    let entry = header.entry as UInt

    var i: UInt = 0
    while i < seg_count {
        table.segs[i as Int] = seg_at(img_base + header_len + i * seg_len)
        let seg = table.segs[i as Int]
        if let bad = check_segment(&seg, img_base, img_len, &dest,
                                   allow_device) {
            return bad
        }
        i = i + 1
    }

    // The entry must be something the process may execute: an entry in a data
    // segment faults on its first instruction, which the kernel can see and
    // the image's author cannot. It is judged by the executable segments alone
    // and never by the region, since code used in place lies outside the
    // region. Checked last so every earlier diagnostic keeps its wording.
    if not entry_is_executable(&table, entry) {
        return ImageFault(reason: "entry is not inside an executable segment",
                          detail: entry)
    }
    None
}

/// Is `entry` inside the load range of a segment the image asked to be
/// executable?
func entry_is_executable(table: &ImageTable, entry: UInt) -> Bool {
    var i: UInt = 0
    while i < table.seg_count() {
        let seg = table.segs[i as Int]
        let executes = (seg.flags & (SegFlag.Execute as UInt8)) != 0
        if not seg.is_device_grant() && executes {
            let load_addr = seg.load_addr as UInt
            let mem_len = seg.mem_len as UInt
            if entry >= load_addr && entry - load_addr < mem_len {
                return true
            }
        }
        i = i + 1
    }
    false
}

// -----------------------------------------------------------------------------
// Placement: copy the bytes, record the domain
// -----------------------------------------------------------------------------

/// Copy a validated image's segments into `dest`, use in place the ones that
/// already are where they are linked (spec §5.6), and record process `p`'s
/// grant rows.
///
/// The copy goes through `kcore.preempt`'s strided movers (`long_copy`,
/// `long_zero`), so the loop carries their preemption points, which is where
/// the time is. The walk itself takes none. A delivery landing between two
/// segments reads grant records only through the copy doors (`translate_user`),
/// and the process being placed has no waiters yet, so it observes nothing in
/// flight. A delivery can write, though: the record it hands a parked thread
/// may land in the image's own memory, which is why the walk reads its
/// segment records from `table`, the copy `validate_image` judged, and never
/// from the image.
///
/// A tick can fire mid-load in a harness kernel that arms one first
/// (`tests/threads_timer.saw`), and that is legal: no thread is current, so the
/// tick charges no slice; no Timer object exists before root runs, so expiry
/// walks a table of free slots; and the reprogramming it ends with is the one
/// the idle path does.
///
/// This does not install the domain. The rows go into the process's grant
/// record (`record_grant` also tells the HAL, on a tier that keeps a standing
/// image), and `load_domain` is what installs the domain: the boot path calls
/// it immediately, and a child's is installed by the scheduler at the switch.
/// One place installs a domain, and it is not here.
///
/// `region` is the `Memory` the destination is, or `NO_MEMORY`. A copied
/// segment and the stack grant live in the destination region's bytes, so their
/// rows are references on it under the second-zero rule; a launcher that
/// releases its handle on a child's memory while the child runs leaves a husk
/// rather than a range on the free list, and the bytes come back when the child
/// dies and its rows go. `image` is the `Memory` the image is, or `NO_MEMORY`,
/// and a segment used in place is a reference on it by the same rule: the
/// child runs out of the image's bytes, so a launcher may release its image
/// handle and the bytes stay until the child's teardown. The boot path passes
/// `NO_MEMORY` for both (root's image and its region are HAL and linker
/// constants that no `Memory` object names), and a device segment names none
/// (those bytes are registers elsewhere, and `process_create` refuses one from
/// a child).
///
/// Every row recorded here is an image row (`seal_image_rows`), the in-place
/// ones included, so no mapping may cover one.
public(package) func place_image(p: Int, img_base: UInt, table: &ImageTable,
                                 dest: &LoadRegion, region: Int,
                                 image: Int) unsafe {
    let seg_count = table.seg_count()

    var s: UInt = 0
    while s < seg_count {
        let seg = table.segs[s as Int]
        let load_addr = seg.load_addr as UInt
        let file_len = seg.file_len as UInt
        let mem_len = seg.mem_len as UInt

        // A device window places no bytes; it is a grant and nothing else, and
        // no copy door takes a buffer in it. A device window is mapped at its
        // own address on every tier, so its row's two halves are one number (as
        // `hal.map_place` does for a mapped `IoMemory`).
        if seg.is_device_grant() {
            record_grant(p, load_addr, load_addr + mem_len, load_addr,
                         seg.flags, true, NO_MEMORY)
        } else if used_in_place(&seg, img_base) {
            // Nothing moves: the row names the image's own bytes, read where
            // the kernel holds them, and the user sees them at the link
            // address, which `same_bytes` said names the same bytes.
            // `check_in_place` held the rounded grant inside the image.
            let top = align_up(load_addr + mem_len, hal.PROT_GRAIN)
            record_grant(p, load_addr, top, img_base + (seg.file_off as UInt),
                         seg.flags, false, image)
        } else {
            // The segment loads at a frame and is mapped at its link address.
            // `load_addr` is what the linker wrote (a user address), and
            // `dest.phys_of` turns it into the frame the bytes go into. Both
            // ends of the copy are physical and both convert: the destination
            // is where the bytes go in RAM, the source is inside the sosimg
            // blob, and neither is an address the kernel runs at. `load_addr`
            // is what `record_grant` installs.
            let load_pa = dest.phys_of(load_addr)
            long_copy(hal.phys_to_virt(load_pa),
                      hal.phys_to_virt(img_base + (seg.file_off as UInt)),
                      file_len)
            long_zero(hal.phys_to_virt(load_pa + file_len), mem_len - file_len)

            // The sosimg flag bits are the protection vocabulary (`imgformat`
            // states the encoding; each HAL translates it), so a segment's
            // permissions become its grant with nothing in between.
            record_grant(p, load_addr,
                         align_up(load_addr + mem_len, hal.PROT_GRAIN),
                         load_pa, seg.flags, false, region)
        }
        s = s + 1
    }

    // The stack is the kernel's grant, not the image's. Its two ranges sit at
    // their own ends of the destination: the user sees the top of the linked
    // region, the bytes are the top of the frames.
    record_grant(p, dest.link_top() - dest.stack_len, dest.link_top(),
                 dest.top - dest.stack_len,
                 (SegFlag.Read as UInt8) | (SegFlag.Write as UInt8), false,
                 region)
    seal_image_rows(p)
}

// -----------------------------------------------------------------------------
// The boot door
// -----------------------------------------------------------------------------

/// Parse the appended root image, place its segments, grant root exactly the
/// regions the image asks for plus a stack, and drop to user mode at its entry.
/// Never returns.
///
/// `tick_period_us` is the scheduler tick's period, or 0 for a kernel that arms
/// none (see `start_process` for where it is armed).
public func load_root_and_enter(tick_period_us: UInt = 0) unsafe {
    // Publish the stats region's header (version, row count, two offsets)
    // before anything can count. This is the door into user mode and nothing
    // traps before it. It is done at boot rather than in the static's
    // initializer so the whole region stays zero-filled.
    stats_publish()

    let base = hal.payload_start()
    let end = hal.payload_end()
    if end < base {
        fatal_image("payload bounds inverted", base)
    }
    let img_len = end - base
    let dest = root_region()

    // Boot failure vocabulary: a machine whose only image is malformed has
    // nothing else to run, so every refusal stops it with the reason. The
    // create door turns the same `ImageFault` into a status.
    var table = ImageTable.empty()
    if let bad = validate_image(base, img_len, &dest, true, &var table) {
        fatal_image(bad.reason, bad.detail)
    }

    let entry = table.entry()
    let seg_count = table.seg_count()
    let prio_map = table.prio_map()

    let uart = console()
    uart.write_str("SOS: root image ok segments=")
    uart.write_hex(seg_count)
    uart.write_str(" entry=")
    uart.write_hex(entry)
    uart.write_str(" prio=")
    uart.write_hex(prio_map)
    uart.write_str("\n")

    // Root's rows are recorded like every other process's, into its body, so
    // root takes its record and its body first. The reload at the switch is
    // what installs a domain, so a root with no grant record could be switched
    // away from and never back into. The device-window row is included, which
    // keeps a driver image's window across a switch.
    claim_root()
    place_image(ROOT_PROCESS, base, &table, &dest, NO_MEMORY, NO_MEMORY)
    load_domain(ROOT_PROCESS)

    // Spec §7: root's band map applies verbatim from its image. The scheduler
    // is round-robin over one level, so the kernel parses and reports the map
    // (which proves the Blade-emitted field arrives intact) but does not store
    // it in the process record.
    //
    // Spec §12: root's boot handle set. The entry register carries exactly one
    // handle, System; everything else the kernel minted for root is collected
    // through `ProcessOp.BootHandleNext` rather than passed.
    start_process(entry, dest.link_top(), dest.link_top(), tick_period_us)
}
