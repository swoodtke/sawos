//! THE SOSIMG LOADER (design 140 unit B; spec §6, §7, §12; sawos design 2 D-1).
//!
//! **ONE LOADER, TWO DOORS.** The kernel loads root at boot and a child at
//! `process_create`, and both go through the phases below with different REGION
//! PARAMETERS and different FAILURE VOCABULARY — never through two copies of the
//! walk. §12's "no second code path" is kept by construction rather than by
//! discipline: `validate_image` and `place_image` take the destination as an
//! argument, `fatal_image` versus a `BadImage` status is the caller's choice,
//! and there is nowhere else in the tree that reads a segment record.
//!
//! What stays here is everything that holds on EVERY target and for EVERY
//! image — the order the checks run in, that nothing is placed before
//! everything validates, and that a malformed shape is diagnosed rather than
//! half-loaded.
//!
//! IT SITS BELOW THE DISPATCH, not above it, and that is what the second door
//! cost: `load_root_and_enter` is still the machine's last boot step, but
//! `process_create` is an OP, so the phases have to be reachable from
//! `kcore.dispatch`. Nothing here reaches upward — the placement calls the
//! HAL, the movers and the process slot, all of which are below.

import hal
import imgformat.{SosimgHeader, SosimgSeg, SegFlag, fits_target_word}
import kcore.mem.{align_up}
import kcore.diag.{console, fatal_image}
import kcore.preempt.{long_copy, long_zero}
import kcore.limits.{ROOT_PROCESS}
import kcore.process.{load_domain, record_grant, start_process}

/// What a refused too-high address REPORTS: its top 32 bits. The low half is
/// what would have survived a narrowing, so it is the half that says nothing;
/// the high half is the part the machine cannot reach and is what a reader
/// needs to see. (`write_hex` prints a machine word, which on the profile that
/// can raise this is 32 bits wide.)
static HIGH_HALF_SHIFT: Int = 32

// =============================================================================
// The sosimg loader (design 140 unit B; spec §6, §7, §12)
// =============================================================================
//
// The image is not ELF — a microkernel-sized loader gets a flat header.
//
// The LAYOUT is not described here: it is the `imgformat` package, shared with
// the Blade target that emits it, and this loader reads it by OVERLAYING those
// structs on the appended bytes — one `UnsafeMemory` view construction per
// record, then plain field names (`seg.mem_len`). The format's alignment
// discipline (every u32 4-aligned, no interior padding, pinned there by
// `static_assert`) is what makes the overlay exact, and it is what turns a
// layout edit into a compile error instead of a silent misparse at boot.
//
// Where a process's region IS, how many grants there are to spend and what a
// permission bit does to the hardware are the HAL's — which is why the numbers
// are read from it (for root) or carried in a `LoadRegion` (for a child) rather
// than written here.

/// WHERE AN IMAGE IS GOING — the parameter that turns one loader into two doors.
///
/// `base`..`top` is the whole destination range and `stack_len` is what the
/// KERNEL takes off the top for the first thread's stack, so segments must fit
/// below `top - stack_len`. That is root's own rule ("the stack is the kernel's
/// grant, not the image's"), and a child gets it unchanged: root supplies a
/// region capability and no numbers at all.
public(package) struct LoadRegion {
    public(package) base: UInt,
    public(package) top: UInt,
    public(package) stack_len: UInt,
}

/// WHY AN IMAGE WAS REFUSED — the answer the shared phases give, so that the
/// two doors can say it their own way.
///
/// The boot door turns it into `fatal_image`, because a machine whose only
/// image is malformed has nothing else to do. The create door turns it into
/// `SosStatus.BadImage`, because image bytes are DATA a launcher was handed and
/// a launcher that cannot report a bad image cannot launch anything else
/// either (sawos design 2 D-4; sawlang#232 agenda item 2's lean (i)).
///
/// `reason` is the same sentence in both mouths, which is the point: one
/// vocabulary, two ways of raising it.
public(package) struct ImageFault {
    public(package) reason: String,
    public(package) detail: UInt,
}

/// Root's destination, from the HAL's own constants.
public(package) func root_region() -> LoadRegion {
    LoadRegion(base: hal.ROOT_LOAD_BASE, top: hal.ROOT_REGION_TOP,
               stack_len: hal.ROOT_STACK_LEN)
}

/// Overlay the header on the image's first bytes. One view construction, then
/// an ordinary safe struct — the unsafety is confined to this line.
func header_at(addr: UInt) unsafe -> SosimgHeader {
    UnsafeMemory<SosimgHeader, Normal>(addr).read()
}

/// Overlay one segment record.
func seg_at(addr: UInt) unsafe -> SosimgSeg {
    UnsafeMemory<SosimgSeg, Normal>(addr).read()
}

/// Validate one segment record against the image bounds and the destination
/// region. `None` when it is loadable.
///
/// Checks are ordered so no bound is computed by an addition that could
/// overflow — a hostile length must produce a diagnostic, not a panic.
func check_segment(seg: &SosimgSeg, img_len: UInt, dest: &LoadRegion,
                   allow_device: Bool) -> ImageFault? {
    let file_off = seg.file_off as UInt
    let file_len = seg.file_len as UInt
    let mem_len = seg.mem_len as UInt

    // The format's addresses are 64-bit on both profiles (design 172 unit 8),
    // so a 32-bit kernel can be handed an image it cannot address. Refusing is
    // the only answer that cannot corrupt a load — narrowing would wrap a high
    // address into a low one and place the segment somewhere the linker never
    // meant. The test folds away entirely on a 64-bit build.
    if not fits_target_word(seg.load_addr) {
        return ImageFault(reason: "segment loads past this machine's address space",
                          detail: (seg.load_addr >> HIGH_HALF_SHIFT) as UInt)
    }
    let load_addr = seg.load_addr as UInt

    if file_off > img_len {
        return ImageFault(reason: "segment starts past the image", detail: file_off)
    }
    if file_len > img_len - file_off {
        return ImageFault(reason: "segment runs past the image", detail: file_len)
    }
    if not seg.mem_covers_file() {
        return ImageFault(reason: "segment mem_len below file_len", detail: mem_len)
    }

    // Write-without-read is not a grant any target should install, and one
    // profile's hardware RESERVES the encoding outright. `imgformat` states the
    // rule; refusing the image is the consequence. It is checked BEFORE the
    // device branch because it holds for both kinds of record.
    if not seg.has_sane_perms() {
        return ImageFault(reason: "segment permissions are not a valid grant",
                          detail: seg.flags as UInt)
    }

    // A DEVICE WINDOW is judged against the BOARD, not against the destination
    // region — it names hardware, which is nowhere near RAM — so it takes its
    // own path and returns.
    if seg.is_device_grant() {
        if not allow_device {
            // **A CHILD MAY NOT DECLARE AN MMIO WINDOW** (sawos design 2 D-7),
            // and unit 4 did not change it — it made it moot. The
            // image-declares/board-authorizes placeholder below was a BOOT-time
            // grant of the one window this board offers to the one process the
            // kernel loads; extending it to every child would have made "which
            // process gets the UART" a race between images rather than a
            // decision anybody made. A driver child now gets its window as a
            // CAPABILITY root hands over — an `IoMemory`, mapped or given —
            // which is what this refusal was waiting for and is unit 6's flow.
            return ImageFault(reason: "a child image may not declare a device window",
                              detail: load_addr)
        }
        return check_device_grant(&seg, load_addr, file_len, mem_len)
    }

    if load_addr < dest.base {
        return ImageFault(reason: "segment loads below the root region",
                          detail: load_addr)
    }
    // A grant covers whole units of the target's protection granularity, so a
    // segment starting mid-unit would be granted along with whatever shares
    // its first unit — the previous segment's tail, at the previous segment's
    // permissions. On a page-granular profile that is how code would silently
    // become writable; on a four-byte-granular one it never arises.
    // Refusing the image is the only answer that is right on both.
    if (load_addr & (hal.PROT_GRAIN - 1)) != 0 {
        return ImageFault(reason: "segment is not aligned to the grant granularity",
                          detail: load_addr)
    }
    let limit = dest.top - dest.stack_len
    if load_addr > limit {
        return ImageFault(reason: "segment loads above the root region",
                          detail: load_addr)
    }
    if mem_len > limit - load_addr {
        return ImageFault(reason: "segment overruns the root region",
                          detail: mem_len)
    }
    None
}

/// Validate a DEVICE WINDOW record (design 178's finale constraint 1, ruled
/// Aug 16, user).
///
/// THE IMAGE DECLARES AND THE BOARD AUTHORIZES, and both halves are load-bearing.
/// A window in the image is what makes "this program drives that device" a
/// property of the program; a window the BOARD publishes is what stops an image
/// from naming any physical address it likes and being handed it. In M2 the
/// board offers exactly one — the console UART's page, which is the only device
/// a process has any business holding while the kernel owns everything else —
/// so the authorization is a comparison rather than a table.
///
/// **THE MIGRATION THIS PLACEHOLDER PROMISED HAS HAPPENED, AND THIS FUNCTION IS
/// WHAT IS LEFT OF THE OLD PATH** (sawos design 6 D-6, M3 unit 4). A device
/// window is now an `IoMemory` derived from a DEVICE row of the build-emitted
/// region table (spec §2.5's device pool root), installed by `IoMemoryOp.Map`
/// and revocable by unmapping the Mapping — and the board's comparison below
/// became `hal.device_window_ok`, a predicate a CARVE is checked against,
/// because a process can now choose a window's bounds where an image could only
/// declare the one.
///
/// **NO IMAGE IN THIS TREE REACHES HERE ANY MORE.** Both driver packages
/// obtain their window instead of declaring it, with the same echoed bytes and
/// the same line number — which is the migration's own claim, "the same window,
/// obtained rather than declared", as a diff of two console transcripts.
///
/// SO WHY IS IT STILL HERE. The flag this path reads (`imgformat`'s
/// `SegFlag.Device`) and the emitter that writes it (`blade/sosimg.saw`) are
/// SAWLANG-SIDE, so deleting them is a pin-bump event rather than an edit in
/// this repository. The path is DORMANT — reachable only by an image nobody
/// builds — and its retirement is a backlog entry naming the sawlang side and
/// the four in-tree consumers that go with it (this function, `check_segment`'s
/// device branch, `place_image`'s device arm, and `validate_image`'s
/// `allow_device` parameter).
///
/// What does NOT change at that retirement: a CHILD image is still refused a
/// declared window, and always was. A driver child gets its window because root
/// MAPS it in or GIVES it a carved `IoMemory`, which is what obtaining rather
/// than declaring bought and is unit 6's flow.
func check_device_grant(seg: &SosimgSeg, load_addr: UInt, file_len: UInt,
                        mem_len: UInt) -> ImageFault? {
    // A window carries no bytes: there is nothing in an image file to place at
    // a hardware address, and a record claiming otherwise has been built wrong.
    if file_len != 0 {
        return ImageFault(reason: "device grant carries image bytes",
                          detail: file_len)
    }
    if load_addr != hal.DEVICE_GRANT_BASE {
        return ImageFault(reason: "device grant names a window this board does not offer",
                          detail: load_addr)
    }
    if mem_len != hal.DEVICE_GRANT_LEN {
        return ImageFault(reason: "device grant is not the size of that window",
                          detail: mem_len)
    }
    None
}

// -----------------------------------------------------------------------------
// PHASE A/B: everything, before anything
// -----------------------------------------------------------------------------

/// Validate a whole image against `img_len` bytes at `img_base` and the
/// destination `dest`. `None` when every byte of it may be placed.
///
/// **NOT ONE EFFECT HAPPENS IN HERE**, which is the phase discipline both doors
/// depend on: a refused image leaves the destination region untouched, so a
/// launcher that gets `BadImage` back has lost nothing but the call, and a
/// refused boot image leaves a machine whose root region is exactly as the
/// linker left it.
///
/// AUDIT (design 1): NO POINT. At most eight iterations of an O(1) body —
/// bounded-small, so there is nothing here for a point to shorten.
public(package) func validate_image(img_base: UInt, img_len: UInt,
                                    dest: &LoadRegion,
                                    allow_device: Bool) unsafe -> ImageFault? {
    let header_len = sizeof<SosimgHeader>() as UInt
    let seg_len = sizeof<SosimgSeg>() as UInt

    if img_len < header_len {
        return ImageFault(reason: "no root image appended", detail: img_len)
    }

    let header = header_at(img_base)
    if not header.has_magic() {
        return ImageFault(reason: "bad magic", detail: header.magic as UInt)
    }
    if not header.has_known_version() {
        return ImageFault(reason: "unsupported version", detail: header.version as UInt)
    }
    // An image built for the OTHER profile is refused rather than jumped into.
    // Its instructions are not this machine's and its addresses need not be in
    // this machine's map — and before the format carried a tag, the only thing
    // that stopped one booting on the other was that nobody had tried.
    if not header.is_for_arch(hal.arch_tag()) {
        return ImageFault(reason: "image is for another architecture",
                          detail: header.arch as UInt)
    }

    let seg_count = header.seg_count as UInt
    if seg_count == 0 {
        return ImageFault(reason: "image has no segments", detail: 0)
    }
    // THE BUDGET IS THE RELOAD SET'S, not the image's: segments plus the
    // kernel's stack grant have to fit the rows one process's domain is made
    // of, and `MAX_ROOT_SEGMENTS` is that budget minus the stack on each
    // profile. A child is bounded by the same number for the same reason —
    // only one domain is installed at a time.
    if seg_count > hal.MAX_ROOT_SEGMENTS {
        return ImageFault(reason: "more segments than the grant budget",
                          detail: seg_count)
    }
    let table_len = seg_count * seg_len
    if table_len > img_len - header_len {
        return ImageFault(reason: "segment table runs past the image",
                          detail: table_len)
    }

    // Same rule as a segment's address, at the one other place a 64-bit field
    // becomes a machine word: refuse, never narrow.
    if not fits_target_word(header.entry) {
        return ImageFault(reason: "entry is past this machine's address space",
                          detail: (header.entry >> HIGH_HALF_SHIFT) as UInt)
    }
    let entry = header.entry as UInt

    var i: UInt = 0
    while i < seg_count {
        let seg = seg_at(img_base + header_len + i * seg_len)
        if let bad = check_segment(&seg, img_len, &dest, allow_device) {
            return bad
        }
        i = i + 1
    }

    if entry < dest.base || entry >= dest.top - dest.stack_len {
        return ImageFault(reason: "entry outside the root region", detail: entry)
    }
    // THE ENTRY MUST BE SOMETHING THE PROCESS MAY EXECUTE (sawos design 2 D-7).
    // Being inside the region is not enough: an entry in a data segment is a
    // program that faults on its first instruction, which the kernel can see
    // and the image's author cannot. It is checked LAST so that every earlier
    // diagnostic keeps the wording it has always had.
    if not entry_is_executable(img_base, seg_count, entry) {
        return ImageFault(reason: "entry is not inside an executable segment",
                          detail: entry)
    }
    None
}

/// Is `entry` inside the load range of a segment the image asked to be
/// executable?
func entry_is_executable(img_base: UInt, seg_count: UInt, entry: UInt) unsafe -> Bool {
    let header_len = sizeof<SosimgHeader>() as UInt
    let seg_len = sizeof<SosimgSeg>() as UInt
    var i: UInt = 0
    while i < seg_count {
        let seg = seg_at(img_base + header_len + i * seg_len)
        if not seg.is_device_grant() && (seg.flags & (SegFlag.Execute as UInt8)) != 0 {
            let load_addr = seg.load_addr as UInt
            let mem_len = seg.mem_len as UInt
            if entry >= load_addr && entry - load_addr < mem_len {
                return true
            }
        }
        i = i + 1
    }
    false
}

/// The validated header's entry point.
public(package) func image_entry(img_base: UInt) unsafe -> UInt {
    header_at(img_base).entry as UInt
}

/// The validated header's segment count.
public(package) func image_seg_count(img_base: UInt) unsafe -> UInt {
    header_at(img_base).seg_count as UInt
}

/// The validated header's §7 band map.
public(package) func image_prio_map(img_base: UInt) unsafe -> UInt {
    header_at(img_base).prio_map as UInt
}

// -----------------------------------------------------------------------------
// PHASE C/D: place the bytes, record the domain
// -----------------------------------------------------------------------------

/// Copy a VALIDATED image's segments into `dest` and record process `p`'s grant
/// rows. Returns the writable window's floor.
///
/// **PHASE C IS WHERE UNIT 1.5 PAYS OFF.** The copy goes through
/// `kcore.preempt`'s strided movers, so the loop is born with its preemption
/// points rather than being retrofitted with them — which is the sequencing
/// sawlang#232 pin 1 asked for, and the reason design 1 landed first.
///
/// **PHASE D COMMITS NOTHING TO HARDWARE.** The rows go into the process's grant
/// record and the domain is installed by whoever is about to run the process:
/// the boot path calls `load_domain` immediately, and a child's is installed by
/// the scheduler at the switch (sawos design 2 D-5). One place installs a
/// domain, and it is not here.
///
/// AUDIT (design 1): the walk itself takes NO point; its POINTS ARE THE MOVERS'
/// (`long_copy`/`long_zero`), which is where the time is — up to 240 KiB of it.
/// The grant record is plain kernel storage no IRQ path reads, so a delivery
/// landing between two segments observes nothing in flight.
///
/// A TICK CAN FIRE MID-LOAD in a harness kernel that arms one before loading
/// (`tests/threads_timer.saw`), and that is legal by the same audit: no thread
/// is current, so the tick charges no slice; no Timer object exists before root
/// runs, so expiry walks a table of free slots; and the reprogramming it ends
/// with is the same one the idle path does.
public(package) func place_image(p: Int, img_base: UInt,
                                 dest: &LoadRegion) unsafe -> UInt {
    let header_len = sizeof<SosimgHeader>() as UInt
    let seg_len = sizeof<SosimgSeg>() as UInt
    let seg_count = image_seg_count(img_base)

    // The WRITABLE window, accumulated as the segments are placed. It is what
    // `copy_out` checks a kernel-written record against, and the stack below is
    // always part of it — so it starts at the region's top edge and only ever
    // grows downward, which means "no writable segment at all" still leaves the
    // stack, and a process always has somewhere to receive one.
    var rw_base = dest.top - dest.stack_len

    var s: UInt = 0
    while s < seg_count {
        let seg = seg_at(img_base + header_len + s * seg_len)
        let load_addr = seg.load_addr as UInt
        let file_len = seg.file_len as UInt
        let mem_len = seg.mem_len as UInt

        // A DEVICE WINDOW places no bytes and joins no writable window: it is a
        // grant and nothing else. Keeping it out of `rw_base` is not tidiness —
        // a hardware address is BELOW RAM on one profile, so folding it in
        // would stretch the copy-out window from the device page to the top of
        // the region and make `copy_out`'s check accept most of the machine.
        if seg.is_device_grant() {
            record_grant(p, load_addr, load_addr + mem_len, seg.flags, true)
        } else {
            long_copy(load_addr, img_base + (seg.file_off as UInt), file_len)
            long_zero(load_addr + file_len, mem_len - file_len)

            // The sosimg flag bits ARE the protection vocabulary (imgformat
            // states the encoding; each HAL translates it into its own
            // hardware's bits), so a segment's permissions become its grant
            // with nothing in between.
            record_grant(p, load_addr,
                         align_up(load_addr + mem_len, hal.PROT_GRAIN),
                         seg.flags, false)
            if (seg.flags & (SegFlag.Write as UInt8)) != 0 && load_addr < rw_base {
                rw_base = load_addr
            }
        }
        s = s + 1
    }

    // The stack is the kernel's grant, not the image's: a program asks for code
    // and data, the kernel decides where it runs.
    record_grant(p, dest.top - dest.stack_len, dest.top,
                 (SegFlag.Read as UInt8) | (SegFlag.Write as UInt8), false)
    rw_base
}

// -----------------------------------------------------------------------------
// THE BOOT DOOR
// -----------------------------------------------------------------------------

/// Parse the appended root image, place its segments, grant root exactly the
/// regions the image asks for plus a stack, and drop to user mode at its entry.
/// Never returns.
public func load_root_and_enter() unsafe {
    let base = hal.payload_start()
    let end = hal.payload_end()
    if end < base {
        fatal_image("payload bounds inverted", base)
    }
    let img_len = end - base
    let dest = root_region()

    // THE BOOT FAILURE VOCABULARY: a machine whose only image is malformed has
    // nothing else to run, so every refusal stops it with the reason. The
    // create door turns the same `ImageFault` into a status instead.
    if let bad = validate_image(base, img_len, &dest, true) {
        fatal_image(bad.reason, bad.detail)
    }

    let entry = image_entry(base)
    let seg_count = image_seg_count(base)
    let prio_map = image_prio_map(base)

    let uart = console()
    uart.write_str("SOS: root image ok segments=")
    uart.write_hex(seg_count)
    uart.write_str(" entry=")
    uart.write_hex(entry)
    uart.write_str(" prio=")
    uart.write_hex(prio_map)
    uart.write_str("\n")

    // ROOT'S ROWS ARE RECORDED LIKE EVERY OTHER PROCESS'S, and that is new in
    // M3 unit 2 rather than incidental: the reload at the switch is what
    // installs a domain from now on, so a root that had no grant record would
    // be a process the scheduler could switch away from and never back into.
    // The device-window row is in there too, which is what keeps a driver
    // image's window across a switch.
    let rw_base = place_image(ROOT_PROCESS, base, &dest)
    load_domain(ROOT_PROCESS)

    // spec §7: root's band map applies verbatim from its image. D3 keeps the
    // map a loader artifact for M2 — the scheduler is round-robin over one
    // level — so the kernel still parses and reports it, which is what proves
    // the Blade-emitted field arrives intact. Storing it in the Process slot is
    // the priority unit's job, not this one's.
    //
    // §12: root's boot handle set. The entry register still carries exactly one
    // handle — System — and everything else the kernel minted for root is
    // COLLECTED through `ProcessOp.BootHandleNext` rather than passed.
    start_process(entry, dest.top, dest.base, dest.top, rw_base, dest.top)
}
