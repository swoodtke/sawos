//! The process record and the process body (spec §2.7): every storage a
//! process index keys, in two tables.
//!
//! A process is two entries. Its record (`ProcessRecord`, in `PROCESS_RECORDS`)
//! holds what outlives it: the state, the status word, the quota ledger, the
//! reference count and the attachment, and the final trap counters. Its body
//! (`ProcessBody`, in `PROCESSES`) holds what only a live process needs: the
//! handle table, the boot set, the grant record, the entry and the stack. The
//! process number every other table stores is the record's index. A live
//! record names its body, and the teardown frees the body and clears the link,
//! so a `Gone` process is a record with no body.
//!
//! This module does no work beyond following that link (`body_of`). It defines
//! both entries, their field types and the slabs that hold them, and it sits
//! below every module that reads any of them, `objects` included. The functions
//! that maintain each part live elsewhere: the handle table's and the ledger's
//! in `kcore.objects`, the grant record's, the copy doors' and the link's in
//! `kcore.process`, and the body's free in the teardown (`kcore.sched`).
//!
//! Both tables are `Slab`s, so a deployment can donate records and bodies
//! separately. A slab is one array keyed by its index, so every per-process
//! table is a field of one entry or the other (all inner dimensions are
//! per-process constants); a parallel table would not grow with a donation.
//!
//! Cost: the body table lives in `.data`, not `.bss`, because
//! `GrantRow.region`'s `NO_MEMORY` sentinel is `-1` and the body's initializer
//! is therefore not all-zero. A plus-one encoding for that field (as
//! `ProcessRecord.attachment` and `ProcessRecord.body_link` use) would put it
//! back in `.bss`. The record table is all-zero, and so is a donated extent of
//! it: a zeroed record is a `Free` record with no body.

import sosabi.{BootHandleKind, HANDLE_KINDS, ObjType, ProcessStatusKind,
               StatsRow}
import kcore.limits.{
    MAX_GRANT_ROWS,
    MAX_HANDLES,
    MAX_PROCESSES,
    MAX_PROCESS_RECORDS,
    MAX_SLAB_EXTENTS,
    NO_BODY,
    NO_MEMORY,
}
import kcore.diag.{fatal_kernel}
import kcore.slab.{Slab}

/// One handle-table entry: the object a handle names, the rights its holder has
/// on it (spec §3), which object of that kind it is, and which life of this
/// slot it belongs to.
///
/// `rights` is a plain `UInt32` mask; which kind's rights enum the bits belong
/// to is decided by `obj_type`, and the pairing happens in `kcore.objects`.
/// `target` is the object's slot in its kind's table.
///
/// `gen` survives unbinding: it is the only field a release does not clear.
/// Unbinding zeroes the binding and increments the generation, so the next mint
/// in this slot stamps a word no earlier word can equal. A stale word fails the
/// equality test in `lookup_handle` and becomes the `Unbound` answer the
/// callers turn into a `BadHandle` fault. It lives in the entry, not a parallel
/// array, because the two are one fact about one slot.
public(package) struct HandleEntry {
    public(package) obj_type: ObjType,
    public(package) rights: UInt32,
    public(package) target: Int,
    public(package) gen: UInt32,
}

/// One boot handle waiting to be collected.
///
/// A record leaves the set through one of two doors: the drain, which advances
/// `boot_next` past it, or `start(boot_tag:)` putting its word in the child's
/// first argument register (`boot_handle_take`). Only the second door sets
/// `taken`. The flag lets it reach into the middle of the queue, which a cursor
/// alone cannot; the drain skips taken records.
///
/// A tag stays spent whether or not its record was delivered: `boot_tag_used`
/// scans the whole set, taken or not, because a tag identifies a record in the
/// process's boot set rather than a queue position.
public(package) struct BootHandleSlot {
    public(package) tag: UInt,
    public(package) kind: BootHandleKind,
    public(package) handle: UInt,
    public(package) taken: Bool,
}

/// What a process may be charged for.
///
/// Raw-backed and dense from zero, because the value is the column index in the
/// two quota rows of `ProcessRecord`.
///
/// `Handle` has no slab: a handle entry lives in the per-process table, so this
/// row alone bounds it.
///
/// `Mapping` counts installed grant rows, not Mapping objects. A mapping
/// charges its target, whose scarce resource is its grant-row budget, and a row
/// outlives its Mapping object (freeing the slot leaves the row). Counting rows
/// keeps `quota_used` and the target's `grant_count` in step, which is what
/// makes `install_row`'s `fatal` unreachable. `Thread` has a slab and no
/// refcount, so its row is charged and only credited by teardown.
///
/// `Pipe` is charged to the creator once per connection, not per endpoint: one
/// charge at `ProcessOp.PipeCreate`, credited when both reference columns reach
/// zero and the connection's slot is returned. The two ends are two handle
/// entries, which the `Handle` row already counts; charging each endpoint would
/// double-charge one slab slot and make giving an end away look like a refund.
public(package) enum QuotaKind: UInt8 {
    case Thread = 0,
    case Event = 1,
    case Waiter = 2,
    case Timer = 3,
    case Memory = 4,
    case IoMemory = 5,
    case Mapping = 6,
    case Handle = 7,
    case Pipe = 8,
}

/// Columns in the ledger: one per `QuotaKind`, and the length of the two rows.
public(package) static QUOTA_KINDS: Int = 9

static_assert(QUOTA_KINDS == (QuotaKind.Pipe as Int) + 1,
              "the ledger has one column per QuotaKind")

/// What a process record is doing.
///
/// `Created` is the inert state between `process_create` (an address space with
/// an entry and stack recorded, no thread) and `start`. A second `start` is a
/// `BadState` fault because this state says the first already happened.
public(package) enum ProcessState: UInt8 {
    case Free = 0,
    case Running = 1,
    case Gone = 2,
    case Created = 3,
}

/// One installed protection row: a range, what may be done with it, and whether
/// it names hardware.
///
/// It is the argument list of a `hal.prot_region` / `hal.prot_device` call,
/// remembered, so the scheduler can replay it when it switches the process in.
/// What a permission bit does to the machine is the HAL's business.
///
/// `base` and `top` are the user's range, the numbers the process itself
/// issues; `pa` is the physical base that `base` translates to. On tiers
/// without translation they are equal (`hal.prot_update` asserts `pa == base`
/// on the region-protection tier).
///
/// The mapping is affine over the row: the physical address of a user address
/// `va` inside it is `pa + (va - base)`, which is what `translate_user`
/// computes. A row is the largest unit over which that holds, so the copy
/// funnels resolve against one row rather than a span of them.
public(package) struct GrantRow {
    public(package) base: UInt,
    public(package) top: UInt,
    public(package) pa: UInt,
    public(package) perms: UInt8,
    public(package) device: Bool,
    /// Which `Memory` region these bytes are, or `NO_MEMORY`.
    ///
    /// The back-reference rides the row because the row is what
    /// `MemorySlot.maps` counts. A row outlives its `Mapping` object (freeing
    /// the slot leaves the row installed), so a link on the Mapping slot would
    /// be lost exactly when the region still needs to know something grants its
    /// bytes. A row is born in `record_grant`, dies in `remove_grant` or
    /// `clear_domain`, and its region travels with it through compaction
    /// because compaction copies whole rows.
    ///
    /// `NO_MEMORY` means the bytes are not a region the pool lent out: an image
    /// segment, the kernel's stack grant, or any device row (an IoMemory is
    /// pinned and returns nothing, spec §5.9).
    ///
    /// Because `NO_MEMORY` is `-1` and every other field rests at zero, this
    /// field is what keeps the body table out of `.bss`; see the module header.
    public(package) region: Int,
}

/// One process as the rest of the kernel names it (spec §2.7): what must
/// outlive the process.
///
/// A Process handle's target, an attachment on one, a thread's or a charged
/// object's `process` field and a Mapping's `target` are all an index into
/// `PROCESS_RECORDS`. A `Gone` record keeps its status word and final counters
/// for as long as a reference names it, and `reclaim_process_record` frees it
/// when `refs` reaches zero.
///
/// `public(package)`, like the table: `kcore.dispatch` and `kcore.sched` read
/// records out of it, and a private element type would be a value a sibling
/// module holds and cannot name.
///
/// There is no cached self-handle: a process's own Process handle is minted per
/// call, each instance independently releasable, so a cached word would go
/// stale when that instance was released. The handle table is the truth.
public(package) struct ProcessRecord {
    public(package) state: ProcessState,
    /// The spec §8 status word's two halves, written at the death.
    public(package) exit_kind: ProcessStatusKind,
    public(package) exit_code: UInt,
    /// This process's pid (spec §2.7): assigned from the kernel's counter when
    /// the record is taken and never zero while a process holds the record.
    /// A record that is free holds zero, because the reclaim clears it, so a
    /// pid that was once assigned is held by no record after its process's
    /// record is reclaimed.
    public(package) pid: UInt64,
    /// What this process has spent, by `QuotaKind`. The record sits below
    /// `kcore.objects` so `mint_handle` can charge and `unbind_handle` can
    /// credit the `Handle` row.
    public(package) quota_used: [UInt16; QUOTA_KINDS],
    /// What this process may spend, by kind. Zero until `install_quota_limits`
    /// runs, which is deliberate: a record with no limits installed can
    /// allocate nothing, so a process reached before its ledger exists refuses
    /// rather than running unbudgeted.
    public(package) quota_limit: [UInt16; QUOTA_KINDS],
    /// How many handle entries anywhere name this process, plus its
    /// attachment.
    ///
    /// `reclaim_process_record` reads this instead of scanning every table: no
    /// reference naming the record means no possible reader of its status word
    /// (spec §8). It counts references from every process's table, so it lives
    /// on the record rather than in the ledger; whoever still holds a handle is
    /// the reader that matters, not necessarily the releaser.
    ///
    /// A Process handle is a waitable and an attachment is a counted reference
    /// on every waitable, so a supervisor watching a dead child holds the
    /// record open, and the status word it is waiting to read cannot be
    /// reclaimed (attach-after-death is sound).
    public(package) refs: UInt16,
    /// The attachment naming this process (slot + 1); 0 = unattached.
    ///
    /// The same field the other waitables carry (`EventSlot.attachment`): spec
    /// §2.2 allows at most one Waiter per object, so it is a field rather than
    /// a list, and it is the one thing `end_process` loads from the wait
    /// machinery. It is a property of the record, which is why
    /// `kcore.waitables` sits above `kcore.pslot` (see `kcore`'s module-order
    /// list).
    public(package) attachment: Int,
    /// The trap counters as the teardown left them.
    ///
    /// While the process lives its counters are its body's row of the stats
    /// region (`kcore.stats`), keyed by the body's index, and nothing is
    /// written here. The teardown copies that row in as the body goes, after
    /// which nothing is charged to the process, so `ProcessOp.Stats` through a
    /// `Gone` process's handle reads a final answer. The copy's pid column is
    /// the row's; `ProcessOp.Stats` answers the record's `pid` instead.
    public(package) final_stats: StatsRow,
    /// The body this process runs in, plus one; 0 = no body.
    ///
    /// Plus one so that zero means none: a zeroed record, inline or in a
    /// donated extent, is one no create has linked. Linked at create (root's
    /// at boot, `claim_root`) and cleared by the teardown as the body is freed,
    /// so a `Gone` record names none. Read and written only through `body_of`,
    /// `has_body`, `link_body` and `unlink_body`, which own the encoding.
    public(package) body_link: Int,
    /// The fault this process is owed, as the `FaultReason`'s number plus one;
    /// 0 = none.
    ///
    /// Set where a delivery finds that a buffer the process parked with is
    /// gone (`doom_process`), which may be inside another process's syscall or
    /// an interrupt, where a teardown must not run. The scheduler ends the
    /// process at its next switch point (`drain_doomed`), and a teardown clears
    /// the field.
    public(package) doom: UInt8,
}

/// What a live process runs in (spec §2.7): its protection domain, its handle
/// table, its boot set and its entry. The teardown frees it.
///
/// `region_base`/`region_top` are the address-space domain's outer bounds: one
/// granted range per process, which thread creation checks entries and stacks
/// against. `rw_base`/`rw_top` are the writable window inside it, which
/// `copy_out_check` tests first. It is one window rather than a per-segment
/// list because a loaded image is contiguous (code, rodata, rw) plus a stack at
/// the region's top edge, and that holds for a child as for root
/// (`process_create` computes it by root's rule).
///
/// The window is only a first bound: a gap between the image's writable end and
/// the stack falls inside the span, and it is `translate_user`, resolving
/// against the grant rows, that refuses an address in the gap. Zero/zero means
/// no writable grant (harness kernels that grant a payload only its own bytes
/// read+execute).
///
/// `grants`/`grant_count` are the grant record: the rows this process's domain
/// is made of, written by whoever grants and replayed by the scheduler when it
/// switches in. The domain is data because a hardware protection set cannot be
/// assumed to hold more than one process's rows at a time. The body's index is
/// the domain's number at the HAL (`hal.prot_switch` and its siblings), which
/// is why `process_slots_usable` caps the bodies and not the records.
public(package) struct ProcessBody {
    /// Whether a record names this body. False is free, and it is zero, so a
    /// donated extent is an extent of free bodies.
    public(package) live: Bool,
    /// The image entry, which is what `ENTRY_IMAGE` resolves to.
    public(package) entry: UInt,
    /// Where a `start` puts the first thread's stack pointer — the kernel's
    /// grant at the region's top, recorded at create so root supplies no
    /// numbers at start.
    public(package) stack_top: UInt,
    public(package) region_base: UInt,
    public(package) region_top: UInt,
    public(package) rw_base: UInt,
    public(package) rw_top: UInt,
    public(package) grant_count: Int,
    /// How many of the first rows are the image's, which the loader recorded:
    /// its segments and then the stack grant. Rows recorded after them are
    /// mappings, and a mapping may not cover an image row.
    public(package) image_rows: Int,
    public(package) grants: [GrantRow; MAX_GRANT_ROWS],
    /// This process's handle table (spec §3). Handle index `i` (0-based) is
    /// `handles[i]`, and the word the process holds carries `i + 1` in its low
    /// byte ("handle 0 names nothing"). Generations start at zero, so a fresh
    /// body's first word is the bare index and boot order hands root 1, 2, 3
    /// (spec §12).
    ///
    /// `MAX_HANDLES` is the per-process ceiling: however many objects the
    /// machine holds, one process can name at most this many at once.
    ///
    /// The generations survive the body's reuse: the teardown unbinds every
    /// entry, bumping each, so the next process in this body starts with an
    /// empty table whose words differ from the last one's.
    public(package) handles: [HandleEntry; MAX_HANDLES],
    /// This process's boot set: what was minted for it before it ran and has
    /// not been handed over yet (spec §12).
    ///
    /// `MAX_HANDLES` bounds it because every record names a handle in the same
    /// table, so a larger boot set could never be drained.
    public(package) boot_handles: [BootHandleSlot; MAX_HANDLES],
    /// How many records are queued.
    public(package) boot_count: Int,
    /// How many have been collected. `boot_next == boot_count` is "drained".
    public(package) boot_next: Int,
    /// This process's rights ceilings (spec §2.7): one word per `HandleKind`,
    /// indexed by the kind's number. `mint_capped` intersects every handle the
    /// kernel mints into this process's table with the word for the handle's
    /// kind.
    ///
    /// A body's creator writes every word: `start_process` sets root's to
    /// all-ones, and `process_create` writes a child's from its creator's and
    /// its ceiling source's. A zeroed body, as a donated extent is, carries no
    /// ceiling until a create has linked it. `ProcessOp.RestrictRights` only
    /// ever clears bits.
    public(package) ceilings: [UInt32; HANDLE_KINDS],
}

// A live process's trap counters (`syscalls`, `interrupts`, `faults`) are not
// fields of its body. They are rows of `kcore.stats`' published region, keyed
// by the body's index: one storage, read by `ProcessOp.Stats` and by a mapped
// supervisor, with no mirror. They are per process (a thread's traps are its
// process's), `UInt64`, keyed by the cause class `ktrap` decides on, and zeroed
// at create so a reused body inherits nothing. They cannot live in
// `ProcessBody` because a mapped page needs the columns contiguous and
// grain-aligned. The teardown copies them into `ProcessRecord.final_stats`.

/// The record slab: extent 0 is `MAX_PROCESS_RECORDS` long and a donation
/// (`SlabKind.ProcessRecords`) appends. `capacity()` is the record allocator's
/// whole bound.
public(package) unsafe static var PROCESS_RECORDS: Slab<ProcessRecord, MAX_PROCESS_RECORDS> = Slab<ProcessRecord, MAX_PROCESS_RECORDS>(
    inline: [ProcessRecord(state: ProcessState.Free,
                           exit_kind: ProcessStatusKind.Running, exit_code: 0,
                           pid: 0,
                           quota_used: [0; QUOTA_KINDS],
                           quota_limit: [0; QUOTA_KINDS],
                           refs: 0, attachment: 0,
                           final_stats: StatsRow(syscalls: 0, interrupts: 0,
                                                 faults: 0, pid: 0),
                           body_link: 0, doom: 0); MAX_PROCESS_RECORDS],
    ext_base: [0; MAX_SLAB_EXTENTS],
    ext_slots: [0; MAX_SLAB_EXTENTS],
    ext_side: [0; MAX_SLAB_EXTENTS],
    ext_count: 0,
    total: MAX_PROCESS_RECORDS)

/// The body slab: extent 0 is `MAX_PROCESSES` long and a donation
/// (`SlabKind.Processes`) appends.
///
/// `capacity()` is what every scan reads, but it does not by itself bound a
/// creation: a tier that keeps a persistent protection domain per body
/// publishes how many it has (`hal.PROT_DOMAIN_SLOTS`), and `alloc_process`
/// takes the smaller of the two. See `kcore.process.process_slots_usable`.
public(package) unsafe static var PROCESSES: Slab<ProcessBody, MAX_PROCESSES> = Slab<ProcessBody, MAX_PROCESSES>(
    inline: [ProcessBody(live: false, entry: 0,
                         stack_top: 0, region_base: 0, region_top: 0,
                         rw_base: 0, rw_top: 0,
                         grant_count: 0, image_rows: 0,
                         grants: [GrantRow(base: 0, top: 0, pa: 0, perms: 0,
                                           device: false,
                                           region: NO_MEMORY);
                                  MAX_GRANT_ROWS],
                         handles: [HandleEntry(obj_type: ObjType.Unbound,
                                               rights: 0, target: 0, gen: 0);
                                   MAX_HANDLES],
                         boot_handles: [BootHandleSlot(tag: 0,
                                                       kind: BootHandleKind.Memory,
                                                       handle: 0, taken: false);
                                        MAX_HANDLES],
                         boot_count: 0, boot_next: 0,
                         ceilings: [0; HANDLE_KINDS]); MAX_PROCESSES],
    ext_base: [0; MAX_SLAB_EXTENTS],
    ext_slots: [0; MAX_SLAB_EXTENTS],
    ext_side: [0; MAX_SLAB_EXTENTS],
    ext_count: 0,
    total: MAX_PROCESSES)

/// The body process `p` runs in.
///
/// Every caller acts on a live process, so a record with no body is a kernel
/// bug here and stops the machine rather than indexing the body table with
/// `NO_BODY`. A site that can meet a `Gone` process asks `has_body` first.
public(package) func body_of(p: Int) unsafe -> Int {
    let link = PROCESS_RECORDS[p].body_link
    if link == 0 {
        fatal_kernel("a process with no body was asked for one", p as UInt)
        return NO_BODY
    }
    link - 1
}

/// Whether process `p` still has its body: false once its teardown has freed
/// it, and for a record no create has linked yet.
public(package) func has_body(p: Int) unsafe -> Bool {
    PROCESS_RECORDS[p].body_link != 0
}

/// Record that process `p` runs in body `b`.
public(package) func link_body(p: Int, b: Int) unsafe {
    PROCESS_RECORDS[p].body_link = b + 1
}

/// Record that process `p` has no body any more.
public(package) func unlink_body(p: Int) unsafe {
    PROCESS_RECORDS[p].body_link = 0
}
