//! A syscall's answer: the (status, value) pair, the third answer `blocked`,
//! and the one place any of them is written into a thread's frame.
//!
//! Its own module because its writers sit in different seams (the return path
//! in `dispatch`, a thread's exit in `sched`, deliveries and wakes in `refs`),
//! which is the funnel `write_result` documents. A seam that can answer a
//! syscall imports this one; nothing here imports anything.

import hal
import sosabi.{SosStatus}

/// What one op did: a (status, value) pair for the caller, or the news that the
/// caller is not going to receive one yet.
///
/// `blocked` is the third answer and not a failure. A thread that parks in
/// `Join` gets no status now; its pair is written into its frame by whatever
/// wakes it, exactly once. Modelling that as a field rather than a magic status
/// keeps the return path from having to know which ops can park.
public(package) struct SyscallResult {
    status: SosStatus,
    value: UInt,
    /// Read by `ktrap` to decide whether to answer at all; the pair itself is
    /// written by `write_result` and nowhere else.
    public(package) blocked: Bool,
}

public(package) func op_ok() -> SyscallResult {
    SyscallResult(status: SosStatus.Ok, value: 0, blocked: false)
}

public(package) func op_value(v: UInt) -> SyscallResult {
    SyscallResult(status: SosStatus.Ok, value: v, blocked: false)
}

public(package) func op_status(s: SosStatus) -> SyscallResult {
    SyscallResult(status: s, value: 0, blocked: false)
}

/// A refusal that still carries a value: a status beside a value, the one
/// combination the helpers above cannot spell.
///
/// It serves `PipeRequestOp.ReplyWait`. A fused reply-then-wait can
/// fail in either half, and which half decides what a server loop does next
/// (wait afresh, or stop because the wait itself is broken), so the answer
/// carries a status and a `ReplyWaitLeg`. Elsewhere a failed op's value is
/// meaningless and `op_status` writes zero; here zero is `ReplyWaitLeg.Wait`.
public(package) func op_status_value(s: SosStatus, v: UInt) -> SyscallResult {
    SyscallResult(status: s, value: v, blocked: false)
}

public(package) func op_blocked() -> SyscallResult {
    SyscallResult(status: SosStatus.Ok, value: 0, blocked: true)
}

/// The one place a syscall's answer is written into a thread's frame.
///
/// A funnel rather than a rule repeated per caller, because an op that parks is
/// answered later by whatever wakes it. The callers include:
///
///   - `ktrap`, for an op that answered immediately;
///   - `exit_thread`, waking everything that joined the thread that just left;
///   - the wake paths in `refs` (`wake_one_waiter` handing a ready attachment
///     to a parked waiter, §2.2; `revoke_blocked`; `wake_call_reply`;
///     `resume_call_room`).
///
/// Each writes exactly once per syscall, the invariant the blocking protocol
/// rests on: a blocked caller is skipped on the return path so that its waker
/// is the only writer, and a second write would step the saved PC twice where
/// the PC is stepped at all.
///
/// The answer is a (status, value) pair and nothing wider. An op whose answer
/// does not fit (`Waiter.Wait`'s record) writes the rest into the caller's own
/// memory through `copy_out` and returns a status here (register convention,
/// §5.7).
public(package) func write_result(frame_addr: UInt, result: SyscallResult) unsafe {
    hal.syscall_return(frame_addr, (result.status as UInt8) as UInt,
                       result.value)
}
