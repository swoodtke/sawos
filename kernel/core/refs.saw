/// Something now names object `slot` of kind `kind`.
///
/// Called beside every generic bind: `mint_handle` at each op that hands out a
/// handle onto an existing object, `give`'s child-side bind, and `waiter_add`'s
/// attachment (through `ref_waitable`). Creation sites do not call it: a fresh
/// slot is written with `refs: 1`, because its first reference is the count.
///
/// Three kinds are not counted:
///
///   - `System` has no slab; it is the singleton every boot handle names.
///   - `Clock` is exempt: kernel-eternal and owned by nobody, so a release must
///     not take it away from everyone else.
///   - `Unbound` names nothing, so binding it never happens.
public(package) func ref_object(kind: ObjType, slot: Int) unsafe {
    match kind {
        case Event -> { EVENTS[slot].refs = EVENTS[slot].refs + 1 },
        case Waiter -> { WAITERS[slot].refs = WAITERS[slot].refs + 1 },
        case Interrupt -> { INTERRUPTS[slot].refs = INTERRUPTS[slot].refs + 1 },
        case Timer -> { TIMERS[slot].refs = TIMERS[slot].refs + 1 },
        case Memory -> { MEMORIES[slot].refs = MEMORIES[slot].refs + 1 },
        case IoMemory -> { IOMEMORIES[slot].refs = IOMEMORIES[slot].refs + 1 },
        case Mapping -> { MAPPINGS[slot].refs = MAPPINGS[slot].refs + 1 },
        case Process -> {
            PROCESS_RECORDS[slot].refs = PROCESS_RECORDS[slot].refs + 1
        },
        // Two kinds, one slot, two columns. `slot` is the connection's index;
        // the kind says which end the handle names and therefore which column
        // it counts on.
        case PipeInlet -> { PIPES[slot].inlet_refs = PIPES[slot].inlet_refs + 1 },
        case PipeOutlet -> { PIPES[slot].outlet_refs = PIPES[slot].outlet_refs + 1 },
        // The same mechanism one level down: `slot` is an exchange (a
        // connection's ring slot), and the kind says whether the handle is the
        // client's claim or the server's obligation, hence which column it
        // counts on.
        case PipeReply -> { EXCHANGES[slot].reply_refs = EXCHANGES[slot].reply_refs + 1 },
        case PipeRequest -> {
            EXCHANGES[slot].request_refs = EXCHANGES[slot].request_refs + 1
        },
        case Thread -> { THREADS[slot].refs = THREADS[slot].refs + 1 },
        case System -> {},
        case Clock -> {},
        case Unbound -> {},
    }
}

/// Whether connection `slot` may be given back now: no endpoint names it, and
/// no exchange lives in it.
///
/// Ring slots live inside the `PIPES` row, so freeing the row while a claim is
/// live would hand that claim a recycled connection. The connection therefore
/// outlives its endpoints for as long as an exchange inside it does.
///
/// The state test is not defensive. Settling an exchange can cascade into
/// freeing the connection (`exchange_settle`), and the outlet's zero-arm
/// settles exchanges before asking this question, so the row may already be
/// back on the slab. The answer is then no.
func pipe_frees_now(slot: Int) unsafe -> Bool {
    match PIPES[slot].state {
        case Free -> false,
        case Live -> {
            (PIPES[slot].inlet_refs == 0 && PIPES[slot].outlet_refs == 0
             && pipe_idle(slot))
        },
    }
}

/// Take one reference away, and answer whether that was the last.
///
/// Split out of `unref_object` for the teardown, which must decrement without
/// freeing (see `unref_teardown`).
///
/// The zero test before the subtraction is not defensive: a teardown zeroes the
/// slots a process owned, so a later decrement from another process's close-all
/// can arrive at a slot whose count is already gone. Nothing is taken then, and
/// nothing reached zero. The Thread and Interrupt arms are the exceptions:
/// their slots are only ever freed at zero, never zeroed under their namers, so
/// a decrement at zero there is an undercount, and it stops the machine.
func drop_reference(kind: ObjType, slot: Int) unsafe -> Bool {
    match kind {
        case Event -> {
            if EVENTS[slot].refs == 0 { return false }
            EVENTS[slot].refs = EVENTS[slot].refs - 1
            EVENTS[slot].refs == 0
        },
        case Waiter -> {
            if WAITERS[slot].refs == 0 { return false }
            WAITERS[slot].refs = WAITERS[slot].refs - 1
            WAITERS[slot].refs == 0
        },
        // The one kind whose last name is not its last reference: an
        // attachment is a reference and not a name. The drop that takes the
        // names to zero destroys the Interrupt (`destroy_interrupt`) whether or
        // not an attachment still holds the slot, so the answer is "free it
        // now" only when nothing holds it either.
        //
        // Reentrancy: the destruction fires the attachment, and a one-shot
        // attachment detaches at that delivery and drops the last reference,
        // which frees the slot under us. The state is read again afterwards
        // for that, as `PipeInlet`'s arm does for its connection.
        case Interrupt -> {
            if INTERRUPTS[slot].refs == 0 {
                fatal_kernel("an interrupt reference was dropped twice",
                             slot as UInt)
            }
            INTERRUPTS[slot].refs = INTERRUPTS[slot].refs - 1
            match INTERRUPTS[slot].state {
                case Live -> {
                    if interrupt_names(slot) == 0 {
                        destroy_interrupt(slot)
                    }
                },
                case Invalid -> {},
                case Free -> {},
            }
            match INTERRUPTS[slot].state {
                case Free -> false,
                case Live -> false,
                case Invalid -> INTERRUPTS[slot].refs == 0,
            }
        },
        case Timer -> {
            if TIMERS[slot].refs == 0 { return false }
            TIMERS[slot].refs = TIMERS[slot].refs - 1
            TIMERS[slot].refs == 0
        },
        case Memory -> {
            if MEMORIES[slot].refs == 0 { return false }
            MEMORIES[slot].refs = MEMORIES[slot].refs - 1
            MEMORIES[slot].refs == 0
        },
        case IoMemory -> {
            if IOMEMORIES[slot].refs == 0 { return false }
            IOMEMORIES[slot].refs = IOMEMORIES[slot].refs - 1
            IOMEMORIES[slot].refs == 0
        },
        case Mapping -> {
            if MAPPINGS[slot].refs == 0 { return false }
            MAPPINGS[slot].refs = MAPPINGS[slot].refs - 1
            MAPPINGS[slot].refs == 0
        },
        // The pipe arms answer about more than their own column's zero. A
        // connection frees when both ends have gone, so each arm decrements its
        // column and then asks about the pair.
        //
        // One column reaching zero is the peer-gone transition, which this
        // function handles besides counting. It lives here because
        // `free_object` runs only when both columns are zero, and peer-gone is
        // what happens when exactly one is. `unref_teardown` reaches it too, on
        // purpose: a dying process's endpoint going away is the same news to
        // the far end as a release.
        case PipeInlet -> {
            if PIPES[slot].inlet_refs == 0 { return false }
            PIPES[slot].inlet_refs = PIPES[slot].inlet_refs - 1
            // Nothing to do for staged messages at the inlet's zero: they were
            // posted by a sender that is gone, but the outlet may still take
            // every word of them. `Take` reads the column when the ring runs
            // dry and answers `PeerClosed` then (drain, then terminal). A claim
            // also outlives the inlet it was posted through: a `PipeReply` is
            // counted in its own right, rooted in the ring slot, so the client
            // may drop its inlet and still resolve every claim it holds.
            //
            // Someone may be parked on the far end. The outlet's readable level
            // is drain-then-terminal, so the inlet column reaching zero raises
            // it (`PeerGone` once the ring is dry), and a server waiting for a
            // message that can never come is told. Reentrancy: the delivery can
            // detach and unref the outlet's own attachment, which can take that
            // column to zero and free the connection under us. `pipe_frees_now`
            // below is guarded on `PIPES[slot].state` for that.
            if PIPES[slot].inlet_refs == 0 {
                notify_if_ready(WaitableKind.PipeOutlet, slot)
            }
            pipe_frees_now(slot)
        },
        case PipeOutlet -> {
            if PIPES[slot].outlet_refs == 0 { return false }
            PIPES[slot].outlet_refs = PIPES[slot].outlet_refs - 1
            if PIPES[slot].outlet_refs == 0 {
                // Nobody can take again (a take needs an outlet handle), so a
                // staged message has no future and its claim is abandoned by
                // the server. `pipe_drop_staged` empties the list and gives
                // back every exchange nobody names; exchanges a live claim
                // still names stay, holding the `PeerClosed` their `Resolve` is
                // owed.
                //
                // This runs before the notifications. The drop walks a list
                // threaded through `Exchange.next` and settling an exchange
                // zeroes its link, so a delivery inside that walk could settle
                // a node the walk has not reached and truncate it. The
                // notifications that follow are a bounded scan of the ring,
                // which holds no list position and so cannot be broken by what
                // it delivers.
                pipe_drop_staged(slot)
                // The client's room-to-post level is now `PeerGone`: posting is
                // over, which is a better thing to wake for than space.
                // `notify_room` serves parked fused `Call`s before the
                // subscription and, on this transition, serves all of them: a
                // poster whose server end has gone is waiting for something
                // that can never happen.
                notify_room(slot)
                // Every claim still naming a staged message learns that its
                // obligation can never be minted.
                notify_claims(slot)
            }
            pipe_frees_now(slot)
        },
        // An exchange is the same two-column object one level down, so these
        // arms read like the pair above: each decrements its column and answers
        // about the whole exchange. `exchange_can_settle` is that question
        // (nobody names it and nothing is owed), and it carries the one
        // asymmetry: a staged message is still owed to a live outlet whatever
        // became of its claim (spec §2.1's tell idiom).
        //
        // What reaching zero means is read off the counts, not recorded. A
        // claim column at zero is abandoned-by-client, and a request column at
        // zero on a `Taken` exchange is abandoned-by-server; `Reply` and
        // `Resolve` read that when they need an answer. No flag sits beside the
        // columns.
        //
        // Each zero is also news for the other half, since someone may be
        // parked there. The claim column at zero raises the obligation's
        // abandoned level (the server's cancellation watcher); the obligation
        // column at zero on a `Taken` exchange raises the claim's reply-ready
        // level, carrying `PeerClosed`.
        //
        // Reentrancy: a reply delivery detaches whatever mode it was attached
        // under, so `notify_if_ready` can re-enter this function on the other
        // column, settle the exchange and cascade into `free_pipe`. That is
        // safe because the arm ends by reading the exchange afterwards:
        // `exchange_can_settle` answers false for a `Free` slot.
        case PipeReply -> {
            if EXCHANGES[slot].reply_refs == 0 { return false }
            EXCHANGES[slot].reply_refs = EXCHANGES[slot].reply_refs - 1
            if EXCHANGES[slot].reply_refs == 0 {
                notify_if_ready(WaitableKind.PipeRequest, slot)
            }
            exchange_can_settle(slot)
        },
        case PipeRequest -> {
            if EXCHANGES[slot].request_refs == 0 { return false }
            EXCHANGES[slot].request_refs = EXCHANGES[slot].request_refs - 1
            if EXCHANGES[slot].request_refs == 0 {
                notify_claim(slot)
            }
            exchange_can_settle(slot)
        },
        case Process -> {
            if PROCESS_RECORDS[slot].refs == 0 { return false }
            PROCESS_RECORDS[slot].refs = PROCESS_RECORDS[slot].refs - 1
            PROCESS_RECORDS[slot].refs == 0
        },
        case Thread -> {
            if THREADS[slot].refs == 0 {
                fatal_kernel("a thread reference was dropped twice",
                             slot as UInt)
            }
            THREADS[slot].refs = THREADS[slot].refs - 1
            THREADS[slot].refs == 0
        },
        case System -> false,
        case Clock -> false,
        case Unbound -> false,
    }
}

/// Destroy Interrupt `slot`: its one name is gone (spec §2.10).
///
/// The line is masked and unbound, and bindable again at once, even while an
/// attachment holds the slot. A device the holder was driving may still be
/// asserting, and an unmasked line with no object behind it would be taken,
/// reported and masked once per fire forever; spec §9 masks on fire and
/// unmasks on ack, and here the mask happens with no ack coming. The slot
/// becomes `Invalid` before the attachment is told, because the record the
/// delivery writes reads the state: it carries `hal.IRQ_NONE` and never the old
/// line, which may be bound to another Interrupt by then.
///
/// An attachment on it is told now: the Interrupt is ready for good
/// (`waitable_ready`), so a waiter is never stranded on a line that can no
/// longer fire. Unlike the other bound kinds there is no handle left to learn
/// it from at the next op, so the record is the only news.
///
/// The delivery may free the slot (a one-shot attachment detaches at it), so
/// this function reads nothing after the notify, and its caller
/// (`drop_reference`) re-reads the state and `refs` to learn whether it did.
func destroy_interrupt(slot: Int) unsafe {
    hal.irq_mask(INTERRUPTS[slot].line)
    INTERRUPTS[slot].state = InterruptState.Invalid
    INTERRUPTS[slot].pending = false
    notify_ready(WaitableKind.Interrupt, slot)
}

/// Give exchange `x`'s ring slot back, and tell whoever is waiting for room on
/// the connection's client end.
///
/// A settle is what makes a full ring not full, so it is where the inlet's
/// room level rises (the other rise is the outlet column reaching zero, handled
/// in `drop_reference`). `exchange_settle` lives in `objects` with the storage
/// it gives back; this is the acting half around it.
///
/// The held handles are released before the level is raised: a settling
/// exchange may still carry a message nobody took, and releasing it can itself
/// free the connection. The `Live` test afterwards is not defensive: settling
/// the last exchange of a connection whose endpoint columns are already zero
/// frees the row (`exchange_settle`'s cascade), and a freed row has no level to
/// raise.
func settle_exchange(x: Int) unsafe {
    let c = exchange_pipe(x)
    var held = exchange_settle(x)
    release_staged(&held)
    match PIPES[c].state {
        case Free -> {},
        case Live -> { notify_room(c) },
    }
}

/// Something no longer names object `slot` of kind `kind`. Zero frees.
///
/// The ordinary decrement used by every op: `release`, `give`'s caller-side
/// unbind, `Waiter.Remove`'s detach, and the cascade out of a freed Waiter. The
/// kernel runs to completion, so the free happens inside the syscall that
/// dropped the last reference and no zero-reference object is ever reachable.
public(package) func unref_object(kind: ObjType, slot: Int) unsafe {
    if drop_reference(kind, slot) {
        free_object(kind, slot)
    }
}

/// The decrement that counts and does not free, used by the teardown and by
/// `exit_thread`.
///
/// A teardown frees in per-slab sweeps that also count what they freed for the
/// teardown report, by ownership or by a count the close-all has already
/// lowered. If the close-all above
/// those sweeps freed by reference, those counts would collapse. So the
/// close-all keeps the ledger honest (a handle in a dying table is one
/// reference fewer, and objects other processes own must see that) and the
/// sweeps, plus `reap_unreferenced`, do the freeing.
///
/// For the objects a sweep frees by owner (the dying process's Mappings) the
/// two agree by construction: the sweep zeroes the slot, count included, so
/// nothing is left half-counted.
///
/// An Interrupt's destruction is not deferred by this: the close-all's drop of
/// its one handle runs `destroy_interrupt` like any release, and only the
/// slot's return waits for the sweep.
///
/// A Process whose count reaches zero here is not freed either. A `Gone` record
/// whose last reference this was (a handle in the close-all, or an attachment
/// in the attachment sweep) is reclaimed by the process scan at the end of
/// `reap_unreferenced`, and a `Created` one is owed its teardown by the same
/// scan (`reclaim_process_record`), which `end_process` runs once its own
/// teardown has ended (`drain_unstarted`). A Thread whose count reaches zero
/// here is freed by `end_process`'s thread sweep, whichever process it belongs
/// to, once it has exited or been invalidated. A Waiter or Timer whose count
/// reaches zero here is freed by that kind's sweep, whichever process it
/// belongs to; an Interrupt, which is bound to no process, by the Interrupt
/// sweep.
///
/// `exit_thread` drops the exiting thread's handle this way because the thread
/// is still running: the free, if that was the last reference, waits for the
/// switch away from it (`PENDING_FREE`) or for the teardown's thread sweep.
public(package) func unref_teardown(kind: ObjType, slot: Int) unsafe {
    let _ = drop_reference(kind, slot)
}

/// Wake every thread parked on Waiter `w` with `Revoked`.
///
/// This is one of the Waiter's two last rites, and it runs first: it answers
/// everybody who was watching through the Waiter, and then the cascade releases
/// what the Waiter was watching. A thread still parked during the cascade could
/// be handed a delivery mid-walk (see `free_object`'s Waiter arm). Its owner's
/// death runs it too, before the teardown takes the Waiter's list apart
/// (`end_process`).
///
/// No record is written, which is the difference from a delivery. A delivery
/// copies a wait record out and then answers `Ok`; a revocation answers
/// `Revoked` and copies nothing, since nothing became ready (no key, no tag, no
/// payload). The woken `wait()` returns `Err(Revoked)` with the caller's buffer
/// untouched, and `wait_buf` is cleared because it records where a record was
/// going to go.
///
/// It touches no process memory: it needs only a frame's status word and the
/// ready queue, both in `threads`, so unlike delivery it needs no copy door.
///
/// The walk covers the whole list, not a pop. §2.2 lets several threads park on
/// one Waiter and a readiness feeds only one of them, but here the thing they
/// all wait on has ceased to exist, so every one is answered. It is
/// process-blind, like every wake.
public(package) func revoke_blocked(w: Int) unsafe {
    var cur = WAITERS[w].blocked
    WAITERS[w].blocked = 0
    while cur != 0 {
        let slot = cur - 1
        // Read the link before `ready_push` takes the field for the ready
        // queue: a thread is on at most one list at a time, and this is the
        // moment it changes lists.
        cur = THREADS[slot].link
        THREADS[slot].wait_buf = 0
        write_result(frame_slot(slot), op_status(SosStatus.Revoked))
        THREADS[slot].state = ThreadState.Runnable
        ready_push(slot)
    }
}

/// Give object `slot` of kind `kind` back to its slab, and run the kind's own
/// last rites.
///
/// Three kinds have something to say to the machine or the rest of the kernel
/// on the way out:
///
///   - An Interrupt masks its line, but not here: its last rites run when its
///     last name goes (`destroy_interrupt`), which may be well before the slot
///     is given back, so the free only returns an already-invalid slot.
///   - A Timer reprograms the comparator, so the kernel does not keep waking
///     itself for a dropped deadline.
///   - A Waiter wakes what is parked on it and then detaches its attachment
///     list (the one cascade in the system). The revocation answers everybody
///     who was watching through it; the detach releases what it was watching.
///
/// One kind deliberately does less: see the `Mapping` arm.
///
/// The quota is credited against the slot's own `process` field (creator pays)
/// for the kinds that have one: whoever was charged gets it back, whichever
/// process dropped the last handle. A shared kind, and a Waiter or Timer,
/// credits through `credit_shared`, which credits nobody when the charged
/// process's death has disowned the object: a shared one outlives its owner
/// live, and a Waiter or Timer outlives it invalid, its charge already
/// refunded. An `Exited` Thread credits through `credit_shared` too, and an
/// invalid one credits nothing. `Interrupt`, `Mapping` and `Process` have no
/// credit here: an Interrupt has no `process` field and no quota column, and
/// the others for the reason given in their arms.
public(package) func free_object(kind: ObjType, slot: Int) unsafe {
    match kind {
        case Event -> {
            // An attached event cannot be here: an attachment is a counted
            // reference, so zero means nothing is watching. If this fires, the
            // count and the wait machinery disagree.
            if EVENTS[slot].attachment != 0 {
                fatal_kernel("an event reached zero references while attached",
                             slot as UInt)
            }
            let owner = EVENTS[slot].process
            EVENTS[slot] = EventSlot(state: SlotState.Free, process: 0,
                                     mode: EventMode.Or, word: 0,
                                     attachment: 0, refs: 0)
            credit_shared(owner, QuotaKind.Event)
        },
        case Waiter -> {
            // Every thread parked on the Waiter is woken with `Revoked` first:
            // what they waited on has ceased to exist, so they are told, in the
            // status of the syscall that parked them, rather than left blocked.
            // `revoke_blocked` documents why this is a revocation and not a
            // delivery. Don't count a parked thread as a reference to keep the
            // Waiter alive: that makes the drop silent and turns a handleable
            // error into a hang.
            //
            // The count is the gate, not the release: a release with a minted
            // sibling still live never reaches this function, so it wakes
            // nobody. Only the last name going is the object ceasing to exist.
            //
            // The wake must come before the cascade. A release in the cascade
            // can raise the level of a waitable another row of this list still
            // watches (a claim dropping to zero tells its obligation), and that
            // notification reaches `wake_one_waiter` for this Waiter. With a
            // thread still parked, the delivery would run mid-walk, and a
            // one-shot row's `detach_attachment` would walk a list whose head
            // the cascade has already freed, miss its row and drop its
            // reference, which the cascade would then drop a second time. With
            // the list empty, the wake finds nobody and nothing is delivered.
            revoke_blocked(slot)

            // The one cascade. A Waiter's attachments are references it holds,
            // so its death releases them, and each release may take a waitable
            // to zero, which frees and credits through this function. The list
            // is walked whole rather than through `detach_attachment`, because
            // there is no list left to unlink from.
            var cur = WAITERS[slot].attached
            while cur != 0 {
                let a = cur - 1
                let next = ATTACHMENTS[a].link
                let watched = ATTACHMENTS[a].kind
                let target = ATTACHMENTS[a].target
                ATTACHMENTS[a] = Attachment(state: SlotState.Free,
                                            kind: WaitableKind.Event, target: 0,
                                            waiter: 0, key: 0, oneshot: false,
                                            owns: false, link: 0)
                set_waitable_attachment(watched, target, 0)
                unref_waitable(watched, target)
                cur = next
            }

            // An invalid Waiter's lists are already empty and its charge came
            // back at the invalidation; its `process` is `NO_PROCESS`, so the
            // credit below goes to nobody.
            let owner = WAITERS[slot].process
            // A reused slot starts with an empty blocked list, so the next
            // Waiter in this slot cannot inherit any thread. The wake above is
            // what makes the list honestly empty.
            WAITERS[slot] = WaiterSlot(state: WaiterState.Free, process: 0,
                                       attached: 0, blocked: 0, refs: 0)
            credit_shared(owner, QuotaKind.Waiter)
        },
        case Interrupt -> {
            if INTERRUPTS[slot].attachment != 0 {
                fatal_kernel("an interrupt reached zero references while attached",
                             slot as UInt)
            }
            match INTERRUPTS[slot].state {
                case Invalid -> {},
                case Live -> {
                    fatal_kernel("a bound interrupt was freed", slot as UInt)
                },
                case Free -> {
                    fatal_kernel("a free interrupt was freed", slot as UInt)
                },
            }
            // No quota is credited: an Interrupt is charged to nobody.
            INTERRUPTS[slot] = InterruptSlot(state: InterruptState.Free, line: 0,
                                             pending: false, attachment: 0,
                                             refs: 0)
        },
        case Timer -> {
            if TIMERS[slot].attachment != 0 {
                fatal_kernel("a timer reached zero references while attached",
                             slot as UInt)
            }
            // An invalid Timer's charge came back at the invalidation, and its
            // `process` is `NO_PROCESS`, so the credit below goes to nobody.
            let owner = TIMERS[slot].process
            TIMERS[slot] = TimerSlot(state: TimerState.Free, process: 0, clock: 0,
                                     armed: false, deadline_ns: 0,
                                     interval_ns: 0, fires: 0, attachment: 0,
                                     refs: 0)
            reprogram_timer()
            credit_shared(owner, QuotaKind.Timer)
        },
        case Memory -> {
            // The range goes back to the pool with the slot, but only at the
            // second zero. Reaching `free_object` means the handle count hit
            // zero; §2.5 frees a region only when the last reference of either
            // kind drops, and an installed grant row is the other kind. So a
            // mapped region with no handles stays Live here, holding its slot
            // and charge while a domain still grants its bytes, and
            // `unref_region_row` frees it when the last row goes. The callers
            // do not care: `unref_object` asks nothing about the outcome, and
            // `reap_unreferenced`'s "give back what nobody names" is the
            // question this answers, since a row is a namer.
            memory_release_if_idle(slot)
        },
        case IoMemory -> {
            // MMIO is pinned, so this touches no hardware. What actually
            // revokes a driver's reach is the row, and a row is a Mapping.
            let owner = IOMEMORIES[slot].process
            IOMEMORIES[slot] = IoMemorySlot(state: SlotState.Free, process: 0,
                                            base: 0, len: 0, refs: 0)
            credit_shared(owner, QuotaKind.IoMemory)
        },
        case Mapping -> {
            // The slot frees and the row stays; this is §2.5 made mechanical,
            // not an omission. A Mapping owns its row; the row does not own the
            // Mapping. A Mapping with every handle released and the grant still
            // installed is §2.5's "dropped without unmap = permanent,
            // safe-but-leaked": the row stays unremovable until the target's
            // teardown. Removing it here would be a revocation nobody asked
            // for, in a different process from the one that dropped the handle.
            //
            // No quota is credited because the mapping quota counts the row
            // (see `QuotaKind.Mapping`). The charge follows the row: `Unmap`
            // credits it, the target's teardown zeroes it, and a leaked row
            // stays charged while installed. That keeps `quota_used` and
            // `grant_count` in step and `install_row`'s `fatal` unreachable.
            MAPPINGS[slot] = MappingSlot(state: SlotState.Free, process: 0,
                                         target: 0, row: NO_ROW, refs: 0)
        },
        case Process -> {
            // A process is a waitable, so reaching zero asserts the same
            // invariant as the arms above: nothing is watching, because a
            // watcher is a reference. This is what makes attach-after-death
            // sound against the reclaim below; if it fired, a supervisor would
            // be parked on a record already given away.
            if PROCESS_RECORDS[slot].attachment != 0 {
                fatal_kernel("a process reached zero references while attached",
                             slot as UInt)
            }
            // A live process is not freed by losing its last handle: it is
            // still running as this record. Only a `Gone` record's last reader
            // going makes the §8 status word unreadable, and
            // `reclaim_process_record` implements that rule by reading this
            // count. Its body went back at its teardown, whatever the count.
            // A `Created` process at zero has a body and a boot set still
            // held; `reclaim_process_record` owes it a teardown, which this
            // module cannot run (`kcore.sched` is above it).
            //
            // The ledger is not credited: the teardown already zeroed this
            // record's rows, and a process is not something another process is
            // charged for.
            reclaim_process_record(slot)
        },
        // Both ends are gone, so the connection is too. The two arms are one
        // act written twice, because the matrix is over `ObjType`: either kind
        // reaching here means `drop_reference` found both columns at zero, and
        // which end went last does not matter.
        //
        // Staging needs nothing here. Either the outlet went first and
        // `drop_reference` dropped what was staged then, or the inlet went
        // first and the outlet drained (or declined to) before its own last
        // handle went. The ring is plain storage that a later `pipe_create`
        // overwrites.
        case PipeInlet -> { free_pipe(slot) },
        case PipeOutlet -> { free_pipe(slot) },
        // The one-shot pair is the same act written twice again: either kind
        // reaching here means both of the exchange's columns are zero with
        // nothing owed.
        //
        // No quota is credited: a claim mints no quota row. The scarce thing an
        // exchange occupies is a ring slot, which belongs to the connection,
        // charged once at `PipeCreate` and credited when the row goes back.
        //
        // The settle may cascade into freeing the connection (the ring slot is
        // storage inside the `PIPES` row). That terminates because an exchange
        // references its connection and a connection references no exchange.
        case PipeReply -> { settle_exchange(slot) },
        case PipeRequest -> { settle_exchange(slot) },
        case System -> {
            fatal_kernel("free_object on the System singleton", slot as UInt)
        },
        case Clock -> {
            fatal_kernel("free_object on a kernel-eternal Clock", slot as UInt)
        },
        case Thread -> {
            // A thread that has not exited is not freed by losing its last
            // handle: its slot is what it runs in. It is freed by its process's
            // teardown, which invalidates it and frees it there if nothing
            // names it (spec §2.10). An `Exited` or `Invalid` slot has nothing
            // left for anybody but a handle, so its last one frees it.
            //
            // An `Exited` slot still holds its charge, so a process's exited
            // threads count against its Thread quota for as long as anything
            // names them. The free gives the charge back to the owner, or to
            // nobody once its death has disowned the slot (`credit_shared`).
            // An `Invalid` slot's charge came back at the invalidation.
            match THREADS[slot].state {
                case Exited -> {
                    let owner = THREADS[slot].process
                    free_thread_slot(slot)
                    credit_shared(owner, QuotaKind.Thread)
                },
                case Invalid -> { free_thread_slot(slot) },
                case _ -> {},
            }
        },
        case Unbound -> {
            fatal_kernel("free_object on a handle that names nothing",
                         slot as UInt)
        },
    }
}

// =============================================================================
// Teardown write-off: reaping what nobody names (spec §2.9)
// =============================================================================
//
// References govern lifetime, so a teardown never force-frees a counted kind
// that other processes may still reference (regions, IO windows, pipe
// connections, Events): a slot outlives its creator for as long as anybody
// holds a reference. Freeing by `process == p` would free a connection under a
// peer that still holds an end.
//
// The close-all counts without freeing (`unref_teardown`), so a slot whose last
// handle the dying process held reaches zero references with nothing to free
// it. `reap_unreferenced` therefore frees by condition, "named by nobody",
// through `free_object`, so every kind's last rites and quota credit run
// exactly as on the ordinary release path. The same holds for a `Gone`
// process record whose last reference, handle or attachment, the dying process
// held: the reap's process scan reclaims it.
//
// What survives the reap and is charged to the dying process is disowned in
// the same scans: its `process` field becomes `NO_PROCESS`, its charge goes
// with the ledger `quota_clear` zeroes, and its eventual free credits nobody
// (spec §2.10). A dead process's record is reclaimed on its handles and
// attachment alone, and a refund owed to it must not reach the record's next
// occupant.
//
// The Thread, Waiter and Timer sweeps in `end_process` are not force-frees:
// each invalidates the dying process's objects of its kind (a thread only if it
// has not exited), frees what nothing else names and disowns the rest. Each
// also frees another process's object of its kind that nothing names any more
// (for a thread, one that has exited or been invalidated). The Interrupt sweep
// is that second half alone: an Interrupt has no owner, so it only frees the
// invalid ones nothing names. They live there rather than here because the
// counts feed the teardown report. Mapping's sweep is not a force-free either:
// `mapping_rights()` withholds `Transfer`, so a Mapping handle cannot outlive
// its owner's process, and its second arm (clearing the row of a mapping whose
// target died) is not a free.

/// Reap every Event, Memory, IoMemory, exchange and Pipe connection that
/// nothing names, and disown every one still charged to dying process `p`. It
/// also reclaims every `Gone` process record that nothing names, and owes a
/// teardown to every `Created` one (`reclaim_process_record`).
/// Called by `end_process` after the close-all and the attachment sweep, so
/// both kinds of reference `p` held on another process are already counted.
///
/// Answers how many Events charged to `p` the Event scan freed, which is what
/// the teardown line's `events=` reports. Only that scan's own frees are
/// counted. An Event freed before it (inside the close-all, as when an outlet's
/// last handle releases a staged message) is not, nor is one the exchange scan
/// frees later by settling a message nobody will take. An Event a message owed
/// to a live outlet still names is disowned and stays live.
///
/// Inner to outer: an exchange lives inside a connection's row, so exchanges
/// are given back first and the connections can then answer `pipe_idle`
/// honestly. `exchange_settle` cascades into `free_pipe` itself, so the
/// connection loop catches connections with no exchanges (the ordinary case).
///
/// `p`'s own record is never reclaimed here: its teardown holds a reference on
/// it until the teardown ends (`end_process`). Any other `Gone` record is
/// finished, its teardown having ended, so reclaiming it here cannot disturb
/// this one.
///
/// Each object is disowned after its own free is tried, so an object the dying
/// process alone named credits its ledger as on any release. An object freed
/// later in the scan by a cascade may already be disowned; that credits nobody,
/// and the ledger is cleared either way.
public(package) func reap_unreferenced(p: Int) unsafe -> UInt {
    var events_freed: UInt = 0
    var e: Int = 0
    while e < EVENTS.capacity() {
        match EVENTS[e].state {
            case Free -> {},
            case Live -> {
                if EVENTS[e].refs == 0 {
                    if EVENTS[e].process == p { events_freed = events_freed + 1 }
                    free_object(ObjType.Event, e)
                }
                disown_event(e, p)
            },
        }
        e = e + 1
    }

    var m: Int = 0
    while m < MEMORIES.capacity() {
        match MEMORIES[m].state {
            case Free -> {},
            case Live -> {
                if MEMORIES[m].refs == 0 { free_object(ObjType.Memory, m) }
                disown_region(m, p)
            },
        }
        m = m + 1
    }

    var io: Int = 0
    while io < IOMEMORIES.capacity() {
        match IOMEMORIES[io].state {
            case Free -> {},
            case Live -> {
                if IOMEMORIES[io].refs == 0 { free_object(ObjType.IoMemory, io) }
                disown_window(io, p)
            },
        }
        io = io + 1
    }

    var x: Int = 0
    while x < EXCHANGES.capacity() {
        if exchange_can_settle(x) {
            // Its held handles go back with it. A reap can free the very
            // objects a later row of this scan concerns, which is why this is a
            // scan and not a list: it reads each slot's state when it reaches
            // it.
            var held = exchange_settle(x)
            release_staged(&held)
        }
        x = x + 1
    }

    var c: Int = 0
    while c < PIPES.capacity() {
        if pipe_frees_now(c) { free_pipe(c) }
        disown_pipe(c, p)
        c = c + 1
    }

    var q: Int = 0
    while q < PROCESS_RECORDS.capacity() {
        reclaim_process_record(q)
        q = q + 1
    }
    events_freed
}

/// Disown region `m` if dying process `p` is still charged for it. The free
/// tried just before may have given the slot back, or left it live (a mapped
/// region keeps its slot, and so does a pool root with pieces on loan).
func disown_region(m: Int, p: Int) unsafe {
    match MEMORIES[m].state {
        case Free -> {},
        case Live -> {
            if MEMORIES[m].process == p { MEMORIES[m].process = NO_PROCESS }
        },
    }
}

/// Disown Event `e` if dying process `p` is still charged for it.
func disown_event(e: Int, p: Int) unsafe {
    match EVENTS[e].state {
        case Free -> {},
        case Live -> {
            if EVENTS[e].process == p { EVENTS[e].process = NO_PROCESS }
        },
    }
}

/// Disown window `io` if dying process `p` is still charged for it.
func disown_window(io: Int, p: Int) unsafe {
    match IOMEMORIES[io].state {
        case Free -> {},
        case Live -> {
            if IOMEMORIES[io].process == p {
                IOMEMORIES[io].process = NO_PROCESS
            }
        },
    }
}

/// Disown connection `c` if dying process `p` is still charged for it.
func disown_pipe(c: Int, p: Int) unsafe {
    match PIPES[c].state {
        case Free -> {},
        case Live -> {
            if PIPES[c].process == p { PIPES[c].process = NO_PROCESS }
        },
    }
}

/// The wait machinery's kinds, translated into the object kinds this matrix is
/// written over.
///
/// `WaitableKind` exists because attaching spends a right and which enum's bits
/// that is depends on the kind (see `waitables`' header); `ObjType` is what a
/// handle entry carries. The enums are numbered differently on purpose
/// (`WaitableKind.Process` is 3, `ObjType.Process` is not), so this is an
/// explicit total translation rather than a cast.
func waitable_obj_type(kind: WaitableKind) -> ObjType {
    match kind {
        case Event -> ObjType.Event,
        case Interrupt -> ObjType.Interrupt,
        case Timer -> ObjType.Timer,
        case Process -> ObjType.Process,
        case PipeOutlet -> ObjType.PipeOutlet,
        case PipeInlet -> ObjType.PipeInlet,
        case PipeReply -> ObjType.PipeReply,
        case PipeRequest -> ObjType.PipeRequest,
    }
}

/// An attachment now names this waitable (§2.2).
public(package) func ref_waitable(kind: WaitableKind, slot: Int) unsafe {
    ref_object(waitable_obj_type(kind), slot)
}

/// An attachment no longer names this waitable. Zero frees, as everywhere.
public(package) func unref_waitable(kind: WaitableKind, slot: Int) unsafe {
    unref_object(waitable_obj_type(kind), slot)
}

/// The teardown's version: it counts and does not free (`unref_teardown`,
/// reached through the wait machinery's own enum).
///
/// An attachment can span processes (a supervisor's attachment onto a child's
/// Process record), so the dying supervisor's side owes the other side a
/// decrement, as the close-all does for a handle onto someone else's object.
/// Same asymmetry and reason as `unref_teardown`: the ledger stays honest and
/// the per-slab sweeps do the freeing.
public(package) func unref_waitable_teardown(kind: WaitableKind, slot: Int) unsafe {
    unref_teardown(waitable_obj_type(kind), slot)
}

// =============================================================================
// Delivery: readiness turning into a woken thread (spec §2.2), and the
// attachment lifetimes that ride on it
// =============================================================================
//
// Three funnels, one act. `notify_ready` is the only place a ready waitable
// reaches its Waiter, `wake_one_waiter` hands the answer to at most one parked
// thread, and `deliver_attachment` is where the answer is read, the readiness
// spent and the attachment released if the delivery ended it, all in one step
// so no kind is drained on one path and not the other.

// =============================================================================
// The rendezvous (spec §2.1: handles enter the receiver's table only at
// receive)
// =============================================================================
//
// A send is a half-move and a receive is the other half. `move_entry` is the
// courier op's single act (unbind here, bind there). A message does the same in
// two steps with the kernel holding the reference between them: `hold_staged`
// unbinds the sender's entries at the post, and `mint_staged` binds the
// receiver's at the take or the delivery. At both halves the count goes up
// before it goes down, per handle.
//
// The charge moves at the post, and nobody pays in between. The unbind credits
// the sender's `QuotaKind.Handle` row (`unbind_handle` does this wherever a
// binding is destroyed) and the mint charges the taker's, so a staged handle is
// charged to nobody. `kcore.objects`' ledger header carries the bound that
// makes that safe.
//
// A staged message that never arrives is unwound by releasing its references
// (`take_staged` then `release_staged`) at these sites:
//
//   - the outlet's zero-arm (`pipe_drop_staged`): nobody can ever take, so what
//     is staged is dropped and its references go back;
//   - `exchange_settle`, from each of its callers: it collects the batch and
//     answers with it, and the caller releases;
//   - not the inlet's zero-arm, which must not release: a staged message
//     survives the client's departure and is still owed to a live outlet
//     (spec §2.1), so its handles stay held and arrive at the take as usual.
//
// Reentrancy: a release can take an object to zero, and that object can be a
// pipe endpoint or a one-shot pair, so a release can re-enter
// `pipe_drop_staged` and `exchange_settle` on another exchange. Two things make
// that safe. The batch is collected before any release runs, so the ledger a
// re-entry reads is consistent (and `exchange_can_settle` answers false for the
// `Free` slot the outer call left behind). And the recursion cannot cycle: a
// reference held by exchange x's message keeps y's column non-zero, so y cannot
// be settling while x holds it. Depth is bounded by the exchange count, a fixed
// slab dimension.

/// The handle slots a rendezvous produced in the taker's table: one kind byte
/// and one word per message slot, both zero for an empty or a dead one.
public(package) struct StagedHandles {
    public(package) kinds: [UInt8; PIPE_MSG_HANDLES],
    public(package) words: [UInt; PIPE_MSG_HANDLES],
}

/// The fixed prefix of a delivered-message record, in kernel memory: everything
/// `sosabi`'s `PipeMsgRecord` holds except the body.
///
/// The kernel builds the prefix on its own stack and the body is a second copy
/// straight out of the ring slot, so a short message costs no full-body memset
/// or copy. Declaration order is the layout, and the assert below pins this
/// description to `sosabi`'s.
///
/// Every byte is a field. The prefix is copied out whole, and compiler padding
/// between the meta and the handle words would carry whatever the kernel stack
/// held there into the receiver's memory, so the gap is `pad`, written zero.
public(package) struct PipeMsgPrefix {
    public(package) meta: PipeMsgMeta,
    public(package) pad: [UInt8; MSG_META_PAD],
    public(package) handles: [UInt; PIPE_MSG_HANDLES],
}

/// The bytes between the meta (one length byte and one kind byte per slot) and
/// the word-aligned handle words: the one count below a word that aligns them.
static MSG_META_PAD: Int = 3

static_assert((1 + PIPE_MSG_HANDLES + MSG_META_PAD) % sizeof<UInt>() == 0
              && MSG_META_PAD < sizeof<UInt>(),
              "the message prefix's pad must be exactly the gap before the handle words")

static_assert(sizeof<PipeMsgPrefix>() == sizeof<PipeMsgRecord>() - PIPE_BODY_BYTES,
              "the kernel's message prefix must be exactly the record sosabi publishes, less its body")

/// The same, for a `Take` — an obligation in front of a message.
public(package) struct PipeTakePrefix {
    public(package) request: UInt,
    public(package) msg: PipeMsgPrefix,
}

static_assert(sizeof<PipeTakePrefix>() == sizeof<PipeTakeRecord>() - PIPE_BODY_BYTES,
              "the kernel's take prefix must be exactly the record sosabi publishes, less its body")

/// Assemble a message prefix out of a length and a completed rendezvous. The
/// one place the two halves of a delivered message are put together, so a take,
/// a resolve and a fused call's reply cannot disagree about the layout.
public(package) func msg_prefix(len: UInt, moved: &StagedHandles) -> PipeMsgPrefix {
    var rec = PipeMsgPrefix(meta: PipeMsgMeta(len: len as UInt8,
                                              kinds: [0; PIPE_MSG_HANDLES]),
                            pad: [0; MSG_META_PAD],
                            handles: [NO_HANDLE; PIPE_MSG_HANDLES])
    var i: Int = 0
    while i < PIPE_MSG_HANDLES {
        rec.meta.kinds[i] = moved.kinds[i]
        rec.handles[i] = moved.words[i]
        i = i + 1
    }
    rec
}

/// How many bytes of a message record a delivery of this shape writes: the
/// contiguous prefix ending at the body's length.
///
/// A handles-only message pays for no part of the body region, because the
/// variable part is the tail.
public(package) func msg_record_span(len: UInt) -> UInt {
    (pipe_msg_body_offset() as UInt) + len
}

/// Move one handle entry from `from`'s table to `to`'s, narrowed by `keep`.
/// Answers the receiver-side word, or `NO_HANDLE` when the receiving table had
/// no room, in which case nothing happened and the giver's entry is untouched.
///
/// The count goes up before it goes down, and the order is load-bearing. A move
/// leaves the reference count as it was, but it is written as an increment then
/// a decrement so that "every bind refs, every unbind unrefs" has no
/// exceptions. The other order would take the count to zero between two lines
/// of one op and free the object being handed over.
///
/// `keep` is `MINT_OP`'s mask: the receiving entry carries `source & keep`, so
/// all-ones is rights verbatim and anything narrower attenuates at give.
///
/// This is `ProcessOp.Give`'s act. A message performs the same move in two
/// halves (`hold_staged`, `mint_staged`) because a send and a receive are
/// separated in time; the two share this function's rules, not its body.
public(package) func move_entry(from: Int, to: Int, word: UInt,
                                entry: HandleEntry, keep: UInt32) unsafe -> UInt {
    let given = mint_handle(to, entry.obj_type, entry.rights & keep, entry.target)
    if given == NO_HANDLE {
        return NO_HANDLE
    }
    ref_object(entry.obj_type, entry.target)
    unbind_handle(from, handle_word_index(word))
    unref_object(entry.obj_type, entry.target)
    given
}

/// Whether an entry of `kind` and `target` is an outlet of connection `pipe`.
/// `NO_PIPE` is negative and no target is, so it names no connection.
public(package) func is_outlet_of(kind: ObjType, target: Int,
                                  pipe: Int) -> Bool {
    match kind {
        case PipeOutlet -> target == pipe,
        case _ -> false,
    }
}

/// Take `p`'s handle entries and hold them against exchange `x`: the first half
/// of the rendezvous move.
///
/// Every non-empty slot of the record is unbound from the sender's table and
/// its reference parked in the ledger. From then on the message owns what it
/// carries: the sender's words are stale (a diagnosed `BadHandle`, as after a
/// `give`), the sender's quota row is credited, and nothing can make the
/// delivery arrive empty.
///
/// Per handle the count goes up before it goes down (`move_entry`'s rule): the
/// kernel's reference is taken, the entry unbound, and the entry's reference
/// dropped, so no object can reach zero and be freed between two lines of one
/// op.
///
/// The batch is atomic because every step is infallible (a lookup, a ref, an
/// unbind and a store), so a partly staged message is unrepresentable and no
/// unwind is needed. The caller completes the exchange with no further failure
/// point: the ring slot, the body copy and the claim mint all happen ahead of
/// this call.
///
/// It stages what is stageable and skips the rest; raising a fault is the
/// caller's job. A word that names nothing, an entry without `Transfer`, a
/// kind the record cannot spell, or an outlet of `pipe` is raised as a fault by
/// `check_send` on the two paths where the caller is the running process. This
/// function is also reached from `resume_call_room`, where the caller is
/// blocked and there is no fault to raise, so it asks the same four questions
/// and leaves a failing slot empty (an outlet of `pipe` stays in the sender's
/// table). The two are not a duplicated check: one decides whether to end the
/// caller, the other what a message carries.
///
/// `pipe` is the connection a request enters, and `NO_PIPE` for a reply, which
/// may carry that connection's outlet back to the client.
///
/// The second asking is load-bearing: a `Call` that met a full ring parks with
/// its args record still in the caller's memory, and the record is re-read at
/// the resume. A sibling thread may have rewritten it, so the words arriving
/// here need not be the ones `check_send` blessed.
public(package) func hold_staged(p: Int, x: Int, args: &PipeSendRecord,
                                 pipe: Int) unsafe {
    var i: Int = 0
    while i < PIPE_MSG_HANDLES {
        let word = args.handles[i]
        if word != NO_HANDLE {
            let entry = lookup_handle(p, word)
            match entry.obj_type {
                case Unbound -> {},
                case _ -> {
                    let may_send = rights_allow_transfer(entry.rights)
                    let spellable = msg_kind_of(entry.obj_type).is_some()
                    let own = is_outlet_of(entry.obj_type, entry.target, pipe)
                    if may_send && spellable && not own {
                        // Up before down, per handle: the kernel's own
                        // reference is taken before the entry's is dropped, so
                        // nothing can reach zero between two lines of one op.
                        ref_object(entry.obj_type, entry.target)
                        unbind_handle(p, handle_word_index(word))
                        unref_object(entry.obj_type, entry.target)
                        let held = StagedRef(obj_type: entry.obj_type,
                                             rights: entry.rights,
                                             target: entry.target)
                        EXCHANGES[x].held[i] = held
                    }
                },
            }
        }
        i = i + 1
    }
}

/// Release the handle entries a refused send carried: a terminal refusal
/// consumes them, as a delivered message does.
///
/// Each non-empty slot is released the way `RELEASE_OP` releases (unbind, then
/// unref), so an object whose last handle this was is freed: a pipe end
/// reaches zero and its peer is told, for example. A transient refusal of the
/// send itself (`WouldBlock`, `NoResource`, `QuotaExceeded`, answered before
/// the message is staged) must not call this; those leave the entries with the
/// caller.
///
/// The slots are validated again, as `hold_staged` validates them: the paths
/// where the caller is running have had the record through `check_send`, but
/// `resume_call_room` re-reads a record a sibling thread may have rewritten,
/// and there is no fault to raise for a caller that is not running. A slot that
/// fails the questions, or that an earlier slot of the same record already
/// released, is skipped.
public(package) func release_carried(p: Int, args: &PipeSendRecord) unsafe {
    var i: Int = 0
    while i < PIPE_MSG_HANDLES {
        let word = args.handles[i]
        if word != NO_HANDLE {
            let entry = lookup_handle(p, word)
            match entry.obj_type {
                case Unbound -> {},
                case _ -> {
                    let may_send = rights_allow_transfer(entry.rights)
                    let spellable = msg_kind_of(entry.obj_type).is_some()
                    if may_send && spellable {
                        // Unbind before the unref, so nothing in the cascade
                        // can find the released entry by lookup.
                        unbind_handle(p, handle_word_index(word))
                        unref_object(entry.obj_type, entry.target)
                    }
                },
            }
        }
        i = i + 1
    }
}

/// Mint every held reference of `x` into `p`'s table: the second half, and the
/// one place spec §2.1's "attached handles enter the receiver's table only at
/// receive" happens.
///
/// Precondition: `table_room(p, staged_count(x))`, established by the caller
/// before anything was spent. That makes the refusal atomic and every mint here
/// succeed; a `NO_HANDLE` answer means the pre-flight and the table disagree,
/// which is a kernel bug, and `fatal_kernel` says so.
///
/// Rights are verbatim: the held ref carries the rights the sender held the
/// entry with and the mint installs exactly those, so a transfer through a
/// message amplifies nothing and consults no default set. A sender that wants
/// to hand over less mints the narrower sibling and attaches that (a
/// message-attach takes no keep mask).
///
/// The batch is collected first, so the ledger is empty before the first mint:
/// what lands in the taker's table is accounted for by the taker from then on,
/// and the exchange's slots are free for the reply direction to stage into.
public(package) func mint_staged(x: Int, p: Int) unsafe -> StagedHandles {
    var out = StagedHandles(kinds: [0; PIPE_MSG_HANDLES],
                            words: [NO_HANDLE; PIPE_MSG_HANDLES])
    let held = take_staged(x)
    var i: Int = 0
    while i < PIPE_MSG_HANDLES {
        let ref = held.slots[i]
        match ref.obj_type {
            case Unbound -> {},
            case _ -> {
                let given = mint_handle(p, ref.obj_type, ref.rights, ref.target)
                if given == NO_HANDLE {
                    fatal_kernel("a rendezvous mint was refused after its pre-flight",
                                 x as UInt)
                }
                // Up before down, the second half's own instance of the rule:
                // the new binding's reference is taken before the kernel's
                // held one is dropped.
                ref_object(ref.obj_type, ref.target)
                unref_object(ref.obj_type, ref.target)
                // The kind was validated at the post and an object cannot
                // change kind, so this cannot be `None`. It is a partial
                // translation, so the arm reports instead of hiding it.
                guard let kind = msg_kind_of(ref.obj_type) else {
                    fatal_kernel("a staged handle named a kind the record cannot spell",
                                 x as UInt)
                    return move out
                }
                out.kinds[i] = kind as UInt8
                out.words[i] = given
            },
        }
        i = i + 1
    }
    move out
}

/// Release a collected batch: the unwind half of the rendezvous, which every
/// arm that drops a staged message ends with.
///
/// A plain loop of `unref_object`. A message that never arrives still holds
/// real references, and dropping them is how the objects it carried reach zero
/// and free. Each release can cascade (see the rendezvous block's reentrancy
/// note), which is why the batch is collected before the first release runs.
public(package) func release_staged(held: &StagedRefs) unsafe {
    var i: Int = 0
    while i < PIPE_MSG_HANDLES {
        let ref = held.slots[i]
        match ref.obj_type {
            case Unbound -> {},
            case _ -> { unref_object(ref.obj_type, ref.target) },
        }
        i = i + 1
    }
}

/// The outlet's zero-arm: nothing staged can ever be taken again.
///
/// Called when the outlet column reaches zero, because from then nobody can
/// take: a take needs an outlet handle. Each staged exchange's claim becomes
/// abandoned-by-server (its obligation will never be minted), so a later
/// `Resolve` answers `PeerClosed` and consumes the claim. The list is emptied,
/// since nothing will read it again, and each exchange nobody names is given
/// back on the spot with its held references released. The rest stay, holding
/// the answer their claims are owed and the handles it carries; `Resolve` reads
/// `outlet_refs == 0` to know what to say. Abandonment is the columns, not a
/// flag.
public(package) func pipe_drop_staged(c: Int) unsafe {
    var cur = PIPES[c].staged
    PIPES[c].staged = 0
    while cur != 0 {
        let x = cur - 1
        cur = EXCHANGES[x].next
        EXCHANGES[x].next = 0
        if exchange_can_settle(x) {
            // The link is read before the settle and the release runs after it,
            // so the walk holds nothing a cascade could invalidate: `cur` is
            // already the next node and `x` is already off the list.
            var held = exchange_settle(x)
            release_staged(&held)
        }
    }
}

/// The fixed prefix of the record `Waiter.Wait` answers with, in kernel memory
/// (spec §2.2).
///
/// Declaration order is the layout, so the field names here and the buffer
/// `sosabi` publishes are one description, pinned by the assert below. The body
/// is not a field: it is a separate copy at `wait_prefix_bytes()` into the same
/// caller buffer, out of the ring slot it already lives in, so the copy is
/// sized to the delivery and not to the record.
///
/// Every byte is a field, for `PipeMsgPrefix`'s reason: the gap between the
/// meta and the handle words is `pad`, written zero, rather than compiler
/// padding carrying stale kernel stack out.
struct WaitPrefix {
    key: UInt,
    tag: UInt,
    payload: UInt,
    meta: PipeMsgMeta,
    pad: [UInt8; MSG_META_PAD],
    handles: [UInt; WAIT_HANDLE_SLOTS],
}

static_assert(sizeof<WaitPrefix>() == sizeof<WaitBuffer>() - PIPE_BODY_BYTES,
              "the kernel's wait prefix must be exactly the buffer sosabi publishes, less its body")

/// Build one and hand it to a process. The only producer of the wire form.
///
/// A refused destination here is a kernel bug, not a process error, so it stops
/// the machine rather than terminating anybody. `Waiter.Wait` validates the
/// buffer at the call (`copy_out_check`; see `ThreadSlot.wait_buf`), and a
/// process's writable window is fixed for its life, so a buffer that passed
/// then cannot fail now. Both copies lie inside the one checked window: the
/// check was for `wait_record_bytes()`, the whole prefix plus a whole message
/// body, and `meta.len` never exceeds `PIPE_BODY_BYTES`.
///
/// The wake path runs below the scheduler (a timer expiry reaches here from the
/// IRQ path with no current thread), so terminating a process from here would
/// leave it nowhere to go next. The door reports, and the callers that can kill
/// are the ones above the switch point.
///
/// The copy is sized to the delivery, in two lengths. A delivery carrying
/// neither handles nor bytes writes `wait_meta_end_bytes()` and stops, which
/// covers almost every delivery (Event, Interrupt, Timer, death, room level,
/// abandoned claim, plain readable outlet). Only a message writes the handle
/// words, and only a message with data writes a body. The meta, inside the
/// short length, tells a decode which happened.
func deliver_wait_record(p: Int, dst: UInt, rec: &var WaitPrefix,
                         body_src: UInt) unsafe {
    var carries = rec.meta.len != 0
    var i: Int = 0
    while i < WAIT_HANDLE_SLOTS {
        if rec.handles[i] != NO_HANDLE {
            carries = true
        }
        i = i + 1
    }
    var bytes = wait_meta_end_bytes() as UInt
    if carries {
        bytes = wait_prefix_bytes() as UInt
    }
    if let why = copy_out(p, dst, ((&var rec) as UnsafePointer<WaitPrefix>) as UInt,
                          bytes) {
        fatal("wait record refused by the copy door", (why as UInt8) as UInt,
              dst, p as UInt, ExitCode.ProcessFault)
    }
    // The second copy happens only for a message with data, straight out of the
    // ring slot that holds the bytes, so a reply never transits a kernel
    // buffer.
    if rec.meta.len != 0 {
        if let why = copy_out(p, dst + (wait_prefix_bytes() as UInt), body_src,
                              rec.meta.len as UInt) {
            fatal("wait record body refused by the copy door",
                  (why as UInt8) as UInt, dst, p as UInt, ExitCode.ProcessFault)
        }
    }
}

/// Does a delivery of this kind consume the subscription, whatever mode it was
/// attached under?
///
/// Only a reply does: it is a one-shot, the record carries the answer, and the
/// exchange is discharged by the copy-out, so the attachment goes with it (an
/// act that consumes the object detaches it). A persistent reading would
/// subscribe to an event that has already happened for the last time. Every
/// other kind is the attacher's choice, `Attachment.oneshot`. This is an
/// exhaustive match rather than `kind == PipeReply` so the next one-shot
/// waitable must answer here too.
func delivery_consumes(kind: WaitableKind) -> Bool {
    match kind {
        case Event -> false,
        case Interrupt -> false,
        case Timer -> false,
        case Process -> false,
        case PipeOutlet -> false,
        case PipeInlet -> false,
        case PipeReply -> true,
        case PipeRequest -> false,
    }
}

/// Is this attachment the completion-queue server's?
///
/// Three conditions, each load-bearing. The kind is a `PipeOutlet`, the only
/// waitable whose readiness names a message to take. The attachment owns the
/// outlet, because the completion-queue server hands its end over entirely; a
/// borrowing `add` leaves the caller holding a handle it is expected to `take`
/// through, and turning its delivery into a take would consume a message the
/// caller was told about, not handed. And something is staged, because the same
/// level is raised by a dead inlet with a dry ring, where there is nothing to
/// take and `PeerGone` is the answer.
func outlet_take_delivery(kind: WaitableKind, target: Int, owns: Bool) unsafe -> Bool {
    match kind {
        case PipeOutlet -> owns && PIPES[target].staged != 0,
        case _ -> false,
    }
}

/// Does this delivery carry a message's handles? The reply direction's half of
/// the rendezvous.
///
/// Only a claim's delivery can, and only when the answer is data: an abandoned
/// claim's `PeerClosed` carries nothing, and the level kinds carry nothing by
/// construction. Spec §2.1's `send(data?, handles?)` is symmetric, so a reply
/// stages handles as a request did and they move at the same moment, the
/// delivery that hands the bytes over.
func reply_carries_handles(kind: WaitableKind, answer: &WaitAnswer) -> Bool {
    match kind {
        case PipeReply -> answer.payload == (ReplyLevel.Data as UInt),
        case _ -> false,
    }
}

/// Answer one attachment into a process's memory, move whatever the message
/// carried, spend what the answer spent, and release the subscription if this
/// delivery ended it. Entry points:
///
///   - `waiter_wait` (and `pipe_reply_wait`'s tail), when something was already
///     ready and nothing parks;
///   - `wake_one_waiter`, handing a ready attachment to a thread that parked.
///
/// A funnel rather than two call sites, because "read the answer" and "record
/// that it was delivered" must be one step: split apart, a kind whose readiness
/// is consumed by delivery (Timer, Event) would be drained on one path and not
/// the other, and a periodic timer would report the same fire twice.
///
/// The read and the clear are one act: `waitable_answer` takes the value,
/// `waitable_consume` clears it, and nothing between them can run. The kernel
/// takes no trap in kernel mode (interrupts are taken from user mode only), so
/// a signal cannot land inside this window; one landing after it finds the
/// object empty and re-arms readiness with its own bits alone.
///
/// The detach is the third part. An attachment ends here when the attacher
/// asked for one delivery (`AttachMode.OneShot`) or the kind's delivery is
/// inherently consuming; an attachment is a counted reference, so ending it
/// drops one. That drop can cascade all the way to a freed connection: a reply
/// delivered to a consuming attachment takes the claim column to zero, which
/// settles the ring slot, which may free the `PIPES` row. Nothing after the
/// detach reads any of that (the answer, key and waiter were all taken before
/// it), which is the reentrancy argument. For the same reason `ATTACHMENTS[a]`
/// is read up front: afterwards the slot is `Free` and belongs to whoever
/// allocates next.
///
/// It can refuse. A delivery carrying handles must mint them into the waiting
/// process's table, and a full table is a condition, not a bug, so this answers
/// a `SosStatus`. On anything but `Ok` nothing happened: no record was copied,
/// no readiness spent, no attachment detached, and the message is still staged
/// with its level raised. The caller writes the status where it would have
/// written `Ok`, and a waiter that frees a slot and waits again gets the same
/// message. This has `revoke_blocked`'s shape: a delivered wake with a
/// distinguishable status and no record.
public(package) func deliver_attachment(p: Int, dst: UInt, a: Int) unsafe -> SosStatus {
    let kind = ATTACHMENTS[a].kind
    let target = ATTACHMENTS[a].target
    let key = ATTACHMENTS[a].key
    let waiter = ATTACHMENTS[a].waiter
    let owns = ATTACHMENTS[a].owns
    let ends = ATTACHMENTS[a].oneshot || delivery_consumes(kind)

    if outlet_take_delivery(kind, target, owns) {
        return deliver_take(p, dst, key, waiter, a, target, ends)
    }

    let answer = waitable_answer(kind, target)
    var rec = WaitPrefix(key: key, tag: answer.tag as UInt,
                         payload: answer.payload,
                         meta: PipeMsgMeta(len: answer.body_len as UInt8,
                                           kinds: [0; PIPE_MSG_HANDLES]),
                         pad: [0; MSG_META_PAD],
                         handles: [NO_HANDLE; WAIT_HANDLE_SLOTS])

    if reply_carries_handles(kind, &answer) {
        // The pre-flight, before anything is spent. `staged_count` is exact:
        // the refs are the kernel's own, so what the reply carries is what the
        // claimant will be handed.
        if not table_room(p, staged_count(target)) {
            return mint_refusal(p)
        }
        let moved = mint_staged(target, p)
        var i: Int = 0
        while i < PIPE_MSG_HANDLES {
            rec.meta.kinds[i] = moved.kinds[i]
            rec.handles[WAIT_MSG_SLOT_0 + i] = moved.words[i]
            i = i + 1
        }
    }

    deliver_wait_record(p, dst, &var rec, answer.body_src)
    waitable_consume(kind, target)

    if ends {
        detach_attachment(waiter, a)
        unref_waitable(kind, target)
    }
    SosStatus.Ok
}

/// The delivery is the take: the completion-queue server's op, which takes a
/// multiplexed server from two traps per message to one.
///
/// It is `pipe_take`'s body run inside a wait, with the same three acts in the
/// same order: mint the obligation, move the message's handles, hand the bytes
/// over. Only the destination differs (a wait record, not a `Take` record), and
/// the server never held an outlet handle to call `Take` through, because the
/// attachment owns the end.
///
/// The refusal is atomic and the only way this can fail. The obligation and
/// every live staged handle are one batch: `table_room` asks about all of them
/// before any exists, so a full table leaves the message staged, the readable
/// level raised and the exchange in `Staged`. The server frees a slot, waits
/// again and is handed the same message.
///
/// The staged message leaves the list and stays in the ring, as with a `Take`:
/// the exchange is `Taken`, its slot is held by the obligation just minted, and
/// the reply travels back through the same slot.
func deliver_take(p: Int, dst: UInt, key: UInt, waiter: Int, a: Int, c: Int,
                  ends: Bool) unsafe -> SosStatus {
    let x = stage_peek(c)
    if x == NO_EXCHANGE {
        // Unreachable: `outlet_take_delivery` established that something is
        // staged and nothing runs between. Written out rather than assumed.
        fatal_kernel("a completion-queue delivery found nothing staged", c as UInt)
        return SosStatus.NoResource
    }
    if not table_room(p, staged_count(x) + 1) {
        return mint_refusal(p)
    }
    let request = mint_handle(p, ObjType.PipeRequest, pipe_request_rights(), x)
    if request == NO_HANDLE {
        fatal_kernel("a delivery-as-take mint was refused after its pre-flight",
                     x as UInt)
        return SosStatus.NoResource
    }
    let moved = mint_staged(x, p)

    var rec = WaitPrefix(key: key, tag: WaitTag.Message as UInt,
                         payload: OutletLevel.Msg as UInt,
                         meta: PipeMsgMeta(len: EXCHANGES[x].len as UInt8,
                                           kinds: [0; PIPE_MSG_HANDLES]),
                         pad: [0; MSG_META_PAD],
                         handles: [NO_HANDLE; WAIT_HANDLE_SLOTS])
    rec.handles[WAIT_REQUEST_SLOT] = request
    var i: Int = 0
    while i < PIPE_MSG_HANDLES {
        rec.meta.kinds[i] = moved.kinds[i]
        rec.handles[WAIT_MSG_SLOT_0 + i] = moved.words[i]
        i = i + 1
    }
    deliver_wait_record(p, dst, &var rec, exchange_body_addr(x))

    // Consumed by delivery, and only after the copy succeeded (`pipe_take`'s
    // ordering), which makes "a staged message is handed over exactly once"
    // true.
    stage_pop(c)
    EXCHANGES[x].request_refs = 1
    EXCHANGES[x].state = ExchangeState.Taken

    // The readable level is not consumed by this delivery and does not have to
    // be: taking the message off the staged list lowers it
    // (`waitable_consume`'s `PipeOutlet` arm: the level ends when the server
    // takes), and this is that take.
    //
    // The detach is last for `deliver_attachment`'s reason: it can cascade into
    // a freed connection, and nothing after it reads `c`. A persistent
    // completion queue never reaches it.
    if ends {
        detach_attachment(waiter, a)
        unref_waitable(WaitableKind.PipeOutlet, c)
    }
    SosStatus.Ok
}

/// Hand attachment `a` to one thread parked on `w`, if any is (§2.2).
///
/// The record goes into the woken thread's own buffer and its status into its
/// frame, both here and nowhere else (as `exit_thread` does for a joiner): a
/// thread that blocked in a syscall was answered by nobody when it blocked, so
/// its waker is its single writer.
///
/// The writer is a different thread from the one answered, and need not be a
/// thread at all (the trap path and the idle poll both reach here). That
/// changes nothing about the write, but it is why the buffer check had to
/// happen back at the `Wait` call. `copy_out` names the target process
/// explicitly and reaches its memory through the linear map, so the write does
/// not depend on which process's mappings are active when it runs.
///
/// The thread leaves the blocked list before the delivery, so cascades from the
/// delivery (which can free objects and whole connections) cannot reach a walk
/// this function has already finished.
public(package) func wake_one_waiter(w: Int, a: Int) unsafe {
    let head = WAITERS[w].blocked
    if head == 0 {
        return
    }
    let slot = head - 1
    WAITERS[w].blocked = THREADS[slot].link
    THREADS[slot].link = 0

    // The answer is whatever the delivery said. A delivery that carries handles
    // can be refused by a full table, which wakes the thread with a status and
    // an untouched buffer (`revoke_blocked`'s shape): the wake is delivered
    // either way, never a strand. The message stays staged and its level
    // raised, so waiting again is handed it.
    let answered = deliver_attachment(THREADS[slot].process,
                                      THREADS[slot].wait_buf, a)
    THREADS[slot].wait_buf = 0
    write_result(frame_slot(slot), op_status(answered))
    THREADS[slot].state = ThreadState.Runnable
    ready_push(slot)
}

/// A waitable just became ready: tell its Waiter, if it has one.
///
/// The one place readiness turns into a wake, reached from every producer: an
/// Event's `Signal`, an Interrupt's line firing, a Timer's expiry, a process
/// ending and a pipe's levels. None of them knows anything about waiters
/// beyond the attachment field.
public(package) func notify_ready(kind: WaitableKind, slot: Int) unsafe {
    let a = waitable_attachment(kind, slot)
    if a == 0 {
        return
    }
    wake_one_waiter(ATTACHMENTS[a - 1].waiter, a - 1)
}

/// `notify_ready` for a caller that has not established readiness: ask first.
///
/// Needed at the peer-gone sites. Other producers know they just made something
/// ready; a reference reaching zero raises a level that may already have been
/// raised (a readable outlet with messages still staged) or not at all (an
/// obligation column falling on an exchange whose reply was already delivered),
/// so the transition is asked about, not asserted. It is cheap: the attachment
/// field is one load and answers "nobody is watching" for almost every call.
public(package) func notify_if_ready(kind: WaitableKind, slot: Int) unsafe {
    if waitable_attachment(kind, slot) == 0 {
        return
    }
    if not waitable_ready(kind, slot) {
        return
    }
    notify_ready(kind, slot)
}

/// Tell every watched claim in connection `c` that its level just changed.
///
/// A scan and not a list walk, deliberately. It is called at the outlet's
/// zero-arm, where each delivery can settle the exchange it just visited and
/// cascade into freeing the connection, so it must hold no position in any
/// structure those acts edit. A bounded walk over the ring's fixed indices
/// holds nothing: an exchange settled underneath it becomes `Free`, which is
/// unattached, which the next iteration skips. `PIPE_INFLIGHT` is small and
/// `kcore.limits`' audit note covers a scan of it.
func notify_claims(c: Int) unsafe {
    var i: Int = 0
    while i < PIPE_INFLIGHT {
        notify_claim(pipe_exchange_at(c, i))
        i = i + 1
    }
}

// =============================================================================
// The parked claim's wake arm
// =============================================================================
//
// One arm asks one question: is this claim a parked thread's or a
// subscription's? `notify_claim` is that arm. A parked fused call wakes the
// thread, a split-phase claim notifies the Waiter, and there is no second wake
// protocol. Every producer of reply-readiness calls it instead of
// `notify_if_ready(PipeReply, ...)`, so this is the one place the two shapes of
// client are told apart.
//
// The arm does not care which op parked the thread. A parked `Resolve` is a
// thread with a reference on the claim column and a buffer to write into, which
// is what a fused `Call` is. `park_resolve` gets there by taking the caller's
// handle entry and keeping its reference (unbind without unref), so both arrive
// at `EXCHANGES[x].caller` in the same state. One park shape, one wake shape,
// one teardown arm.

// A thread-tied claim cannot be attached: a fused call mints no `PipeReply`
// handle for `Waiter.Add`, and `park_resolve` detaches a parked resolver's
// attachment on the way down. So `EXCHANGES[x].reply_attach` is zero whenever
// `EXCHANGES[x].caller` is not, and the two arms are alternatives, not a
// sequence.
//
// The room level has the same shape. `Call` never answers `WouldBlock`, so a
// full ring parks the caller, and the level that ends that park is the inlet's
// room-to-post one. `notify_room` asks the same question at that level's
// producers and routes into the same resume.
/// A claim's level changed: tell whoever holds it, whichever kind of holder
/// that is.
public(package) func notify_claim(x: Int) unsafe {
    let parked = EXCHANGES[x].caller
    if parked == 0 {
        notify_if_ready(WaitableKind.PipeReply, x)
        return
    }
    if not waitable_ready(WaitableKind.PipeReply, x) {
        return
    }
    wake_call_reply(parked - 1, x)
}

/// Answer a thread parked on a claim, in a fused `Call` or a `Resolve`. It is
/// `deliver_attachment`'s mirror image.
///
/// Both do the same three things in the same order and differ in where the
/// answer goes: a delivery writes a wait record, while a parked claim writes
/// the reply bytes and a value register, because both ops resume inside their
/// own syscall rather than a `Wait`. The two parked shapes agree down to the
/// register (success is the reply's length in the value register with the
/// record copied to `wait_buf`; `PeerClosed` is a bare status), so no second
/// arm is needed. Readiness is read through `waitable_answer`, the exchange is
/// spent through `waitable_consume`, and the claim's reference is dropped last.
///
/// The unref is last, and that order is the only safe one: it can settle the
/// ring slot and cascade to a freed connection, and `exchange_settle` asserts
/// that nobody is parked, so the tie must be gone first. Nothing after the
/// unref reads the exchange.
///
/// A refused copy-out is a kernel bug, on `deliver_wait_record`'s terms:
/// `pipe_call` validated the reply buffer while the caller was running, and a
/// process's window is fixed for its life.
func wake_call_reply(t: Int, x: Int) unsafe {
    let p = THREADS[t].process
    let dst = THREADS[t].wait_buf
    let answer = waitable_answer(WaitableKind.PipeReply, x)
    var result = op_status(SosStatus.PeerClosed)
    if answer.payload == (ReplyLevel.Data as UInt) {
        // The fused path mints only what the reply carried. A `Call` mints no
        // claim handle; what it may mint is the handles the server attached to
        // its answer.
        //
        // A full table refuses the handles and not the exchange, and that
        // refusal destroys them. The caller is parked inside its own syscall,
        // so it cannot retry: the reply has been written and the claim is about
        // to be spent either way. It is answered with the table-full status,
        // and the handles the replier attached go back to their slabs when the
        // exchange settles, because the replier gave them up at the reply.
        //
        // This is the one place a refusal is terminal, because a fused `Call`'s
        // claim is a parked thread, which cannot ask again without returning. A
        // refused `Take` or delivery-as-take leaves the message staged. A
        // client that must not lose a capability this way makes room before it
        // calls, or uses the composed path, whose claim is a handle. Nothing
        // half-moves and nothing leaks either way.
        if not table_room(p, staged_count(x)) {
            result = op_status(mint_refusal(p))
        } else {
            let moved = mint_staged(x, p)
            var rec = msg_prefix(answer.body_len, &moved)
            if let why = copy_out(p, dst,
                                  ((&var rec) as UnsafePointer<PipeMsgPrefix>) as UInt,
                                  sizeof<PipeMsgPrefix>() as UInt) {
                fatal("fused call reply refused by the copy door",
                      (why as UInt8) as UInt, dst, p as UInt,
                      ExitCode.ProcessFault)
            }
            if answer.body_len != 0 {
                if let why = copy_out(p, dst + (pipe_msg_body_offset() as UInt),
                                      answer.body_src, answer.body_len) {
                    fatal("fused call reply body refused by the copy door",
                          (why as UInt8) as UInt, dst, p as UInt,
                          ExitCode.ProcessFault)
                }
            }
            result = op_value(answer.body_len)
        }
    }
    waitable_consume(WaitableKind.PipeReply, x)
    clear_pending_call(t)
    write_result(frame_slot(t), result)
    THREADS[t].state = ThreadState.Runnable
    ready_push(t)
    unref_waitable(WaitableKind.PipeReply, x)
}

/// A connection's room level changed: serve the parked callers, then the
/// subscription.
///
/// It loops where `notify_claim` does not, because a claim is one exchange with
/// at most one holder, while room is a connection-wide level several threads
/// may wait on. A settle frees one slot, so the ordinary pass serves one caller
/// and the next finds no room and stops. A peer-gone transition serves every
/// one, since a poster whose server end has died waits for something that can
/// no longer happen.
///
/// The subscription is told afterwards and asks its own question: if a resumed
/// caller took the freed slot, `notify_if_ready` finds the level false and says
/// nothing.
public(package) func notify_room(c: Int) unsafe {
    var t = call_room_waiter(c)
    while t != NO_THREAD {
        if not resume_call_room(t, c) {
            break
        }
        t = call_room_waiter(c)
    }
    notify_if_ready(WaitableKind.PipeInlet, c)
}

/// Stage a room-parked call's message now that there may be somewhere to put
/// it, and re-park it on its exchange. Answers whether the thread stopped
/// waiting for room: `false` means the ring is still full and it is still
/// parked, which stops `notify_room`'s loop.
///
/// This is `pipe_post`'s body run in another thread's context, with two
/// consequences. The questions are asked in `pipe_post`'s order (the outlet
/// column before the ring, since nobody being able to take is the stronger
/// fact), and the copy-in must not fault a process that is not running: the
/// address was checked at the call by `copy_in_check`, so a refusal here stops
/// the machine.
///
/// It mints nothing, which is what a fused call buys: the claim is the parked
/// thread, `Exchange.reply_refs` starts at one for it, and no handle row is
/// spent.
func resume_call_room(t: Int, c: Int) unsafe -> Bool {
    let p = THREADS[t].process
    if PIPES[c].outlet_refs == 0 {
        // Terminal, and the message was never staged: the record is re-read to
        // release the handles it carried, exactly as `pipe_call` releases them
        // when it meets a closed outlet without parking.
        var carried = PipeSendRecord(body: 0, len: 0,
                                     handles: [NO_HANDLE; PIPE_MSG_HANDLES])
        if let why = copy_in(p, ((&var carried) as UnsafePointer<PipeSendRecord>) as UInt,
                             THREADS[t].call_src, THREADS[t].call_len) {
            fatal("parked call record refused by the copy door",
                  (why as UInt8) as UInt, THREADS[t].call_src, p as UInt,
                  ExitCode.ProcessFault)
        }
        clear_pending_call(t)
        write_result(frame_slot(t), op_status(SosStatus.PeerClosed))
        THREADS[t].state = ThreadState.Runnable
        ready_push(t)
        release_carried(p, &carried)
        return true
    }
    let x = alloc_exchange(c)
    if x == NO_EXCHANGE {
        return false
    }
    let src = THREADS[t].call_src
    let dst = THREADS[t].wait_buf
    // The parked call's message is re-read out of its args record. `call_src`
    // and `call_len` name the record, so the handle words and the body address
    // come back together. The caller is blocked, so nothing it owns can have
    // changed since `pipe_call` validated both addresses; a refusal here is a
    // kernel bug, for `copy_in_check`'s reason: a process's window is fixed for
    // its life.
    var args = PipeSendRecord(body: 0, len: 0, handles: [NO_HANDLE; PIPE_MSG_HANDLES])
    if let why = copy_in(p, ((&var args) as UnsafePointer<PipeSendRecord>) as UInt,
                         src, THREADS[t].call_len) {
        fatal("parked call record refused by the copy door",
              (why as UInt8) as UInt, src, p as UInt, ExitCode.ProcessFault)
    }
    let len = args.len
    if len != 0 {
        if let why = copy_in(p, exchange_body_addr(x), args.body, len) {
            fatal("parked call body refused by the copy door",
                  (why as UInt8) as UInt, args.body, p as UInt,
                  ExitCode.ProcessFault)
        }
    }
    EXCHANGES[x].len = len as UInt16
    // The handle words are re-validated here, and have to be. The record was
    // re-read from the caller's memory just above, so a sibling thread may have
    // rewritten it since `check_send` blessed it; `hold_staged` therefore asks
    // its four questions again. There is no fault to raise (the caller is not
    // running), so a failing slot arrives empty, and no rewritten record can
    // stage a handle its process does not hold or may not send, or an outlet
    // of this connection.
    hold_staged(p, x, &args, c)
    EXCHANGES[x].reply_refs = 1
    EXCHANGES[x].request_refs = 0
    EXCHANGES[x].state = ExchangeState.Staged
    stage_push(c, x)
    tie_call_reply(t, x, dst)
    notify_ready(WaitableKind.PipeOutlet, c)
    true
}

/// Release the claims of threads parked on a claim when their process dies (the
/// orphaned-claim arm).
///
/// A parked caller's claim is a reference no handle table holds, so the
/// teardown's close-all cannot reach it. It would pin a ring slot and leave
/// `Exchange.caller` naming a thread slot about to be recycled. Dropping it is
/// the abandonment: the claim column falls to zero, which `pipe_reply_status`
/// reads as abandoned-by-client, so the server's later reply answers
/// `Err(PeerClosed)`.
///
/// This covers a thread parked in `Resolve` with no arm of its own:
/// `park_resolve` unbinds without unref, so the parked resolver's entry is
/// already gone from the table and its reference sits on the claim column
/// exactly where a fused caller's does.
///
/// It runs before the close-all, in two passes. Before, because the close-all
/// drops endpoint columns and every such transition notifies, and a
/// notification must never find a thread of the process being torn down. Two
/// passes, because the second pass's unrefs can deliver: settling an exchange
/// raises the room level, and serving a room waiter of this dying process would
/// resume a thread into a process that no longer has one. Room waiters go first
/// (they hold no exchange and no reference), so by the time any reference is
/// dropped this process has none left for a delivery to find.
public(package) func release_pending_calls(p: Int) unsafe {
    var t: Int = 0
    while t < THREADS.capacity() {
        if THREADS[t].process == p && THREADS[t].call_pipe != 0 {
            clear_pending_call(t)
        }
        t = t + 1
    }
    var u: Int = 0
    while u < THREADS.capacity() {
        if THREADS[u].process == p && THREADS[u].call_claim != 0 {
            let x = THREADS[u].call_claim - 1
            clear_pending_call(u)
            unref_waitable(WaitableKind.PipeReply, x)
        }
        u = u + 1
    }
}

/// Spec §2.4's signal: accumulate, never block, and tell the Waiter if there is
/// one.
public(package) func signal_event(slot: Int, bits: UInt) unsafe {
    accumulate(slot, bits)
    // A signal of nothing is not a readiness. Both modes can produce it —
    // `signal(0)` in either — and reporting it would wake a waiter for a word
    // it would then read as empty.
    if EVENTS[slot].word == 0 {
        return
    }
    notify_ready(WaitableKind.Event, slot)
}
