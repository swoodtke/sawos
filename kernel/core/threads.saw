//! The thread table, the frame arena and the ready queue: a thread's state,
//! held below everything that acts on it.
//!
//! The switch (`sched`) and the exit (`sched` again, because retiring the last
//! thread ends the process) are not here. This module is the storage and the
//! queue discipline, so the seams that wake a thread (a waiter's delivery, a
//! timer's expiry) can push one onto the ready queue without reaching for the
//! scheduler that will pick it up.

import hal

import kcore.limits.{
    FRAME_ARENA_WORDS,
    MAX_SLAB_EXTENTS,
    MAX_THREADS,
    NO_PROCESS,
    NO_THREAD,
    THREAD_FRAME_STRIDE,
}
import kcore.mem.{align_up}
import kcore.slab.{Slab}

// =============================================================================
// Threads and the scheduler (spec §2, §7, §8)
// =============================================================================
//
// The trap frame is the thread context. A thread's saved registers are the
// frame the HAL's trap entry writes on the way in and reads on the way out, so
// a thread switch is not a separate save/restore: it is `ktrap` returning a
// different frame address than it was called with. Entering user mode for the
// first time is the same operation with a frame nothing has run in yet. Two
// seam calls carry it: `hal.frame_init` builds a fresh context and
// `hal.resume_frame` enters one.
//
// The only place a frame address is chosen is the user-return boundary, because
// that is the only place `ktrap` returns. The kernel is never preempted and
// holds no lock; the state a switch reads is a table, and the tick that
// motivates a switch only sets a flag.
//
// The protection-domain reload is not here. Threads of one process share one
// domain, so a same-process switch reloads nothing; a switch that changes
// process reloads in `kcore.sched`'s `run_thread`, where the incoming thread's
// process is in hand, and `kcore.process.domain_changed` reloads after an edit
// to the running process's record. What lives here is the one word they compare
// against, `LAST_PROT_PROCESS`, beside the rest of the state a switch reads.

/// Extent 0's frames: every compiled thread's saved context, back to back.
///
/// All-zero, so it costs no image bytes; a zeroed frame is also the right
/// initial state, since `frame_init` only writes the few words that are not
/// zero.
///
/// It is a bare array rather than part of `THREADS`; `frame_slot` below says
/// why (the alignment is load-bearing, and a `Slab`'s inline array cannot
/// promise it).
unsafe static var THREAD_FRAMES: [UInt64; FRAME_ARENA_WORDS] = [0; FRAME_ARENA_WORDS]

/// The address of thread slot `index`'s frame.
///
/// # The context-switch path
///
/// This is the read the trap path makes with interrupts implied off. Every
/// context switch is `kcore.sched.run_thread` calling this and `ktrap`
/// returning the answer; the HAL's trap entry then resumes that frame. The
/// floor arm must stay plain arithmetic.
///
/// The floor arm: `index < MAX_THREADS` covers every thread on a machine that
/// never donates. It is an `align_up` plus a multiply-add behind one compare
/// against a compile-time constant, with no walk and no read of the extent
/// table.
///
/// The donated arm is one bounded walk. `THREADS.locate` is at most
/// `MAX_SLAB_EXTENTS` iterations of an O(1) body over the same table the slot
/// lookup uses, and the address is then a multiply-add on the side-arena base
/// recorded in that same row. It takes no preemption point and needs none: it
/// allocates nothing, takes no lock, and cannot fault (the extent was validated
/// and zeroed before it was installed, and donation is permanent so a base is
/// never retired).
///
/// Slot `i`'s frame and slot `i`'s storage come from one `locate` answer (the
/// same extent, the same offset), so a donated thread cannot read another
/// thread's frame. That is why the frame base is a column of the extent table
/// (`Slab.ext_side`) rather than a parallel array.
///
/// # Why the frame is not a field of `ThreadSlot`
///
/// Folding the frame into the slot is unsound. The trap entry's user-return
/// path loads the frame address into the stack pointer, so a frame must carry
/// that register's alignment (`THREAD_FRAME_STRIDE % 16 == 0` in
/// `kcore.limits`, with a static_assert). A fattened `ThreadSlot` would be
/// `sizeof(ThreadSlot) + THREAD_FRAME_STRIDE` bytes at `alignof(Int)`; on some
/// targets that is a multiple of 16 and on others it is 8 mod 16, so every
/// other frame would be misaligned, silently on a target that does not check.
/// Saw has no alignment attribute to pin a struct, and no padding fixes both at
/// once because the header sizes differ in parity. So the arena stays
/// separately aligned, at the stride.
///
/// # The second funnel
///
/// `Slab.extent_addr` is the funnel for donated slots; this is the funnel for
/// donated frames, and the only other place where a stored physical base
/// becomes a kernel-dereferenced address. `ext_side[e]` stays physical (a base
/// is address-as-data) and the `hal.phys_to_virt` below is the moment of
/// dereference. A missed conversion is a hard fault on a translating target and
/// invisible on the others.
public(package) func frame_slot(index: Int) unsafe -> UInt {
    let stride = THREAD_FRAME_STRIDE as UInt
    if index < MAX_THREADS {
        let base = align_up(((&var THREAD_FRAMES) as UnsafePointer<UInt64>) as UInt, stride)
        return base + (index as UInt) * stride
    }
    let (e, rest) = THREADS.locate(index)
    hal.phys_to_virt(THREADS.side_base(e) + (rest as UInt) * stride)
}

/// What a thread slot is doing (spec §8).
///
/// `Exited` is a state a slot stays in rather than a transition to `Free`,
/// because a join arriving after the exit must still find the exit code. The
/// slot returns to the pool at process teardown and at no earlier moment:
/// `end_process` holds the one loop that ever writes `Free`. A Thread carries
/// no reference count (argued at `ThreadSlot` below), so `RELEASE_OP` destroys
/// a Thread handle and never a thread; reaping a slot earlier would need a
/// close op, which does not exist for any kind. Slots freed at teardown are
/// handed to the next process, so stale-handle detection (§3) applies to Thread
/// handles as to every other kind.
public(package) enum ThreadState: UInt8 {
    case Free = 0,
    case Created = 1,
    case Runnable = 2,
    case Running = 3,
    case Blocked = 4,
    case Exited = 5,
}

/// One thread (spec §2 table row).
///
/// `link` is the one list pointer a thread needs, because a thread is on at
/// most one list at a time: the ready queue when it is runnable, or the joiner
/// list of the thread it is waiting for when it is blocked. Slot indices are
/// stored plus one so that zero means "no thread", which is what a zeroed
/// static already says.
///
/// There is no `refs` field, on purpose. The join/exit protocol already owns a
/// thread slot's lifetime on terms a handle count cannot express.
/// `ThreadState.Exited` is a state a slot stays in so that a join arriving
/// after the exit still finds the exit code (a reader that holds no handle and
/// is not counted anywhere), and the joiner list is a second such claim on the
/// slot. Folding those into a reference count raises questions (what is a
/// joiner worth, what does a zero-reference `Exited` slot owe a join that has
/// not arrived) with no payoff, since nothing runs out of thread slots before
/// its process ends. The slot comes back at teardown, and the thread quota row
/// is charged and only credited there.
public(package) struct ThreadSlot {
    /// `public(package)` because parking a thread happens outside this module:
    /// `waitables` blocks one on a Waiter's list. The state machine is
    /// described here and nowhere else.
    public(package) state: ThreadState,
    public(package) process: Int,
    public(package) exit_code: UInt,
    /// Head of the list of threads blocked joining this one (slot + 1).
    public(package) joiners: Int,
    /// Next slot on whichever list this thread is on (slot + 1).
    /// `public(package)`: the list a parked thread is on may be a Waiter's,
    /// which `waitables` owns.
    public(package) link: Int,
    /// Where a parked thread wants its answer written: a user address, already
    /// validated by `copy_out_check` at the call. Validating at the call rather
    /// than at the wake makes a bad buffer terminate the process that supplied
    /// it while it is still the running one. `public(package)` because the wait
    /// side sets it, at the park.
    ///
    /// Two parks use it, and it is one field because a thread is inside at most
    /// one syscall: a `Waiter.Wait` writes a wait record here, and a fused
    /// `PipeInlet.Call` writes the reply body here. Both are the buffer this
    /// park will answer into, both were checked while the caller was running,
    /// and `call_pipe` / `call_claim` say which one it is.
    public(package) wait_buf: UInt,
    /// The fused call's room park: which connection this thread is waiting for
    /// space on (slot + 1; 0 = it is not).
    ///
    /// `PipeInletOp.Call` never answers `WouldBlock`, so a full ring parks the
    /// caller here, and the room the next settle makes resumes it. Exactly one
    /// of this field and `call_claim` is non-zero while a thread is inside a
    /// `Call`, and the pair names which of the two things it is waiting for.
    public(package) call_pipe: Int,
    /// The fused call's reply park: which exchange this thread's answer is
    /// coming from (exchange + 1; 0 = it is not waiting for one).
    ///
    /// It is the claim itself, not a note about one. A fused call mints no
    /// `PipeReply` handle, so the parked thread is what holds the exchange's
    /// reply column open: one reference, taken at the stage and dropped at the
    /// wake. `Exchange.caller` is the same fact indexed the other way, which
    /// lets a settling exchange find the thread without a scan.
    public(package) call_claim: Int,
    /// The request body's address in the caller's memory, and its length; live
    /// only while `call_pipe` is set.
    ///
    /// A room-parked call has not staged anything yet, so the message is still
    /// where the caller put it and the resume copies it then. The address went
    /// through `copy_in_check` at the call, while the caller was running, which
    /// is what makes the later copy unable to fail.
    public(package) call_src: UInt,
    public(package) call_len: UInt,
}

/// The thread slab: an extent chain, with the frame arena riding the extent
/// table's side column (see `frame_slot`). Loop bounds read `capacity()`.
public(package) unsafe static var THREADS: Slab<ThreadSlot, MAX_THREADS> = Slab<ThreadSlot, MAX_THREADS>(
    inline: [ThreadSlot(state: ThreadState.Free, process: 0,
                        exit_code: 0, joiners: 0, link: 0, wait_buf: 0,
                        call_pipe: 0, call_claim: 0, call_src: 0,
                        call_len: 0); MAX_THREADS],
    ext_base: [0; MAX_SLAB_EXTENTS],
    ext_slots: [0; MAX_SLAB_EXTENTS],
    ext_side: [0; MAX_SLAB_EXTENTS],
    ext_count: 0,
    total: MAX_THREADS)

/// The running thread's slot, or `NO_THREAD`.
///
/// It is none before the first process exists, and stays none for the harness
/// kernels that enter user mode without one; every `NO_THREAD` guard below is
/// for those. Uniprocessor kernel with interrupts taken from user mode only, so
/// the only writer is the trap path and nothing can interleave with it.
public(package) unsafe static var CURRENT_THREAD: Int = NO_THREAD

/// The ready queue: a FIFO of runnable threads, head and tail as slot + 1.
/// The running thread is not on it: round-robin puts the outgoing thread at the
/// tail and takes the head, and both halves happen in `pick_next`.
public(package) unsafe static var READY_HEAD: Int = 0

public(package) unsafe static var READY_TAIL: Int = 0

/// Set by the tick when a thread's slice runs out, and by `Yield`. Read and
/// cleared at the user-return boundary, which is the only place it can act.
public(package) unsafe static var NEED_RESCHED: Bool = false

/// Ticks left in the running thread's slice.
public(package) unsafe static var SLICE_LEFT: UInt = 0

/// Ticks a thread runs before the timer takes the processor away (spec §7's
/// fixed timeslice). One tick, since the tick period is already the unit the
/// scheduler cares about.
public(package) static SLICE_TICKS: UInt = 1

/// Whose protection domain is currently installed in the hardware, or
/// `NO_PROCESS` when none is.
///
/// This word makes the reload cheap. A switch between two threads of one
/// process must reload nothing, so the scheduler compares the incoming thread's
/// process against this and reloads only when they differ. It is set by whoever
/// installs a domain (`load_domain`, and the boot path through
/// `start_process`) and invalidated when a process is torn down, so a
/// slot reused by a later child can never inherit the dead one's map by number.
///
/// It lives here rather than beside the reload because it is scheduler state in
/// the sense `CURRENT_THREAD` is, and because `process`, which is below the
/// scheduler, has to write it at boot.
public(package) unsafe static var LAST_PROT_PROCESS: Int = NO_PROCESS

// -----------------------------------------------------------------------------
// The ready queue
// -----------------------------------------------------------------------------

public(package) func ready_push(slot: Int) unsafe {
    THREADS[slot].link = 0
    if READY_TAIL == 0 {
        READY_HEAD = slot + 1
        READY_TAIL = slot + 1
    } else {
        THREADS[READY_TAIL - 1].link = slot + 1
        READY_TAIL = slot + 1
    }
}

public(package) func ready_pop() unsafe -> Int {
    if READY_HEAD == 0 {
        return NO_THREAD
    }
    let slot = READY_HEAD - 1
    READY_HEAD = THREADS[slot].link
    if READY_HEAD == 0 {
        READY_TAIL = 0
    }
    THREADS[slot].link = 0
    slot
}

/// Take every thread of process `p` off the ready queue, leaving everybody
/// else's where they were.
///
/// A singly-linked walk with a trailing pointer, because `link` is the one list
/// pointer a thread has (see `ThreadSlot`): there is no back pointer to unlink
/// through. `READY_TAIL` follows the removal rather than being recomputed; it
/// is wrong exactly when the removed node was the last one.
///
/// No preemption point: at most as many iterations as the thread slab is long
/// (`MAX_THREADS` plus whatever was donated; finite), of an O(1) body. The
/// ready queue is state the IRQ path writes (`ready_push` from a wake), so a
/// delivery landing mid-walk would be an in-flight invariant.
public(package) func ready_remove_process(p: Int) unsafe {
    // Slot + 1 throughout, matching the list's own encoding: 0 means "no node".
    var prev: Int = 0
    var cur = READY_HEAD
    while cur != 0 {
        let slot = cur - 1
        let next = THREADS[slot].link
        if THREADS[slot].process == p {
            if prev == 0 {
                READY_HEAD = next
            } else {
                THREADS[prev - 1].link = next
            }
            if READY_TAIL == cur {
                READY_TAIL = prev
            }
            THREADS[slot].link = 0
        } else {
            prev = cur
        }
        cur = next
    }
}

// -----------------------------------------------------------------------------
// Allocation
// -----------------------------------------------------------------------------

/// Take a free thread slot, or `NO_THREAD` when the slab is empty.
public(package) func alloc_thread() unsafe -> Int {
    var i: Int = 0
    while i < THREADS.capacity() {
        match THREADS[i].state {
            case Free -> { return i },
            case _ -> {},
        }
        i = i + 1
    }
    NO_THREAD
}

// -----------------------------------------------------------------------------
// Thread lifecycle
// -----------------------------------------------------------------------------

/// How many of a process's threads have not exited.
public(package) func live_threads(p: Int) unsafe -> Int {
    var live: Int = 0
    var i: Int = 0
    while i < THREADS.capacity() {
        if THREADS[i].process == p {
            match THREADS[i].state {
                case Free -> {},
                case Exited -> {},
                case _ -> { live = live + 1 },
            }
        }
        i = i + 1
    }
    live
}

/// Park the running thread on `target`'s joiner list.
public(package) func block_on_join(slot: Int, target: Int) unsafe {
    THREADS[slot].state = ThreadState.Blocked
    THREADS[slot].link = THREADS[target].joiners
    THREADS[target].joiners = slot + 1
    NEED_RESCHED = true
}

/// The calling process: the process of the running thread. Before there are
/// threads it is process 0, the only one there is (harness kernels that enter
/// user mode with no object model still make syscalls).
public(package) func calling_process() unsafe -> Int {
    if CURRENT_THREAD == NO_THREAD {
        return 0
    }
    THREADS[CURRENT_THREAD].process
}
