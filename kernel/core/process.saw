//! A process: the grant record, the two doors into and out of its memory, and
//! the one way into user mode.
//!
//! The teardown is not here; it lives in `kcore.sched`. Ending a process ends
//! in a reschedule, choosing what runs next can idle, and idling delivers,
//! which reaches back down into this module's copy doors. Putting the teardown
//! here would be an import cycle. Consequently the copy doors report a bad
//! buffer as a `FaultReason` instead of terminating, and the callers above the
//! scheduler terminate on it. See `sched.saw`'s header.
//!
//! This module holds what acts on a process: the protection domain each body
//! records, the copy doors, and `start_process`. The record and body tables are
//! in `kcore.pslot`, below `kcore.objects`, whose handle functions index them.
//! `alloc_process`, `link_process` and `process_slots_usable` stay here because
//! taking a record and a body is an action and it is where the domain-pool
//! limit is applied.
//!
//! Every `p` here is a process number, a record's index. The grant record and
//! the windows are the body's, reached through `body_of(p)`, and the HAL's
//! domain number is the body's index.

import hal
import sosabi.{
    ObjType,
    FaultReason,
    ProcessStatusKind,
    BootHandleKind,
    root_system_rights,
    process_rights,
    memory_rights,
    iomemory_rights,
    thread_rights,
    NO_HANDLE,
    ROOT_SYSTEM_HANDLE,
}
import kcore.limits.{
    MAX_GRANT_ROWS,
    MAX_IOMEMORIES,
    MAX_MEMORIES,
    NO_BODY,
    NO_IOMEMORY,
    NO_MEMORY,
    NO_PROCESS,
    ROOT_BODY,
    ROOT_PROCESS,
}
import kcore.mem.{align_up, copy_bytes, word_bytes}
import kcore.diag.{console, fatal_image}
import kcore.stats.{stats_clear}
import kcore.pslot.{
    GrantRow,
    PROCESSES,
    PROCESS_RECORDS,
    ProcessState,
    QuotaKind,
    body_of,
    link_body,
}
import kcore.objects.{
    IOMEMORIES,
    IoMemorySlot,
    MEMORIES,
    MemorySlot,
    SlotState,
    alloc_iomemory,
    alloc_memory,
    boot_handle_room,
    install_quota_limits,
    mint_handle,
    queue_boot_handle,
    quota_charge,
    ref_region_row,
    unref_region_row,
}
import kcore.threads.{
    CURRENT_THREAD,
    LAST_PROT_PROCESS,
    SLICE_LEFT,
    SLICE_TICKS,
    THREADS,
    ThreadSlot,
    ThreadState,
    alloc_thread,
    frame_slot,
}

// `ProcessState`, `GrantRow`, `ProcessRecord`, `ProcessBody` and their tables
// are declared in `kcore.pslot`. They hold every storage keyed by a process
// index, so they must sit below `kcore.objects`, whose functions index them.
// Everything that acts on a process stays here: the grant record,
// `translate_user`, the copy doors, `load_domain`, `clear_domain` and
// `start_process`.


/// How many process bodies this machine can actually run: the body slab's
/// capacity, capped by the protection domains the tier has to put them in.
///
/// Donation raises `PROCESSES.capacity()` past the compiled floor, but a tier
/// that keeps a persistent per-process table set draws it from a static pool
/// that donation does not reach. `hal.PROT_DOMAIN_SLOTS` is that pool's size
/// (every profile publishes it), and a body's index is its domain's number.
/// Taking the smaller of the two means the scan never reaches a body with no
/// domain behind it, so a create past the limit is the `NoResource` a full
/// table already answers. The caller cannot know the number, which is what a
/// status is for as against a fault.
///
/// `kcore.limits`' `static_assert(MAX_PROCESSES <= hal.PROT_DOMAIN_SLOTS)`
/// binds only the floor (extent 0 must fit the pool); this function enforces
/// the limit above the floor at run time. Records have no domain, so their
/// table is bounded by its capacity alone.
public(package) func process_slots_usable() unsafe -> Int {
    let held = PROCESSES.capacity()
    if held > hal.PROT_DOMAIN_SLOTS {
        return hal.PROT_DOMAIN_SLOTS
    }
    held
}

/// Find a free record and a free body for a create: `(record, body)`, or
/// `NO_PROCESS` as the record when either table is full.
///
/// A pure scan that reserves neither, so a create refused after it leaks
/// nothing, and a find of one without the other takes neither. The create
/// takes both with `link_process` once every refusal is behind it. The record
/// scan is bounded by the record slab's capacity and the body scan by
/// `process_slots_usable`, so donated entries of either are visible and the
/// domain-pool limit is respected. Both walks are bounded and their bodies
/// O(1).
///
/// `Gone` is not `Free`: a dead record is spent again only when nothing can
/// read it. The teardown leaves the record holding its status word (spec §8)
/// because the creator's handle onto it outlives it, and
/// `reclaim_process_record` frees it once the last such reference is gone. The
/// body is free from the teardown on. So `MAX_PROCESSES` bounds concurrent
/// processes and the record table bounds those plus the dead still held, and a
/// request past either is `NoResource`.
public(package) func alloc_process() unsafe -> (Int, Int) {
    let record = free_record()
    let body = free_body()
    if record == NO_PROCESS || body == NO_BODY {
        return (NO_PROCESS, NO_BODY)
    }
    (record, body)
}

/// The lowest free record, or `NO_PROCESS`.
func free_record() unsafe -> Int {
    var r: Int = 0
    while r < PROCESS_RECORDS.capacity() {
        match PROCESS_RECORDS[r].state {
            case Free -> { return r },
            case _ -> {},
        }
        r = r + 1
    }
    NO_PROCESS
}

/// The lowest free body this machine can run, or `NO_BODY`.
func free_body() unsafe -> Int {
    let usable = process_slots_usable()
    var b: Int = 0
    while b < usable {
        if not PROCESSES[b].live {
            return b
        }
        b = b + 1
    }
    NO_BODY
}

/// Give record `p` body `b`, both found free by `alloc_process`. From here on
/// `body_of(p)` answers `b`, until the teardown frees it.
public(package) func link_process(p: Int, b: Int) unsafe {
    link_body(p, b)
    PROCESSES[b].live = true
}

/// Give root its record and its body, the first of each table.
///
/// Root is not created through `alloc_process`: the kernel loads exactly one
/// image (spec §12), and the boot door places it before anything else runs, so
/// the two are known. The loader calls this before it records root's grant
/// rows and `start_process` calls it again for the harness kernels that enter
/// user mode without the loader; linking twice writes the same two fields.
public(package) func claim_root() unsafe {
    link_process(ROOT_PROCESS, ROOT_BODY)
}

/// Free a `Gone` process's record if nothing anywhere still names it.
///
/// A `Gone` record holds its status word and final counters (spec §8), and the
/// only ways to read them are `GetStatus` and `Stats` through a Process handle
/// and an attachment on one, so `ProcessRecord.refs == 0` means no possible
/// reader and the record may go. It runs when a live process releases the last
/// reference to a Process (`free_object`'s Process arm), for every record at
/// the end of `reap_unreferenced` (a dying process held the last reference; the
/// dying process's own record is refused there, its teardown still holding a
/// reference), and at the end of the dying process's own teardown, when it
/// drops the reference that teardown holds on its own record.
///
/// `refs` counts Process handles bound in every process's table, not just the
/// caller's. A process's own teardown closes its handles first, so if it held
/// the last one on its own record (it released its creator's handle, or it
/// refers to itself) that close leaves only the teardown's own reference.
///
/// The body is already free: the teardown gave it back. Handle generations make
/// the reused record safe, since a word naming the old life is released or
/// stale, and the teardown's disown leaves no field naming it (spec §2.10).
///
/// A live process is never reclaimed however far its count falls: its record
/// is what it is running as.
public(package) func reclaim_process_record(p: Int) unsafe {
    match PROCESS_RECORDS[p].state {
        case Gone -> {},
        case _ -> { return },
    }
    if PROCESS_RECORDS[p].refs != 0 {
        return
    }
    PROCESS_RECORDS[p].state = ProcessState.Free
}

// -----------------------------------------------------------------------------
// The grant record, and installing a domain
// -----------------------------------------------------------------------------

/// Record one row of process `p`'s protection domain.
///
/// Rows are appended in the order they are granted. On a tier whose
/// `hal.prot_region` index names a numbered hardware region, replaying row `i`
/// at index `i` is what makes an installed domain match the one the loader
/// staged.
///
/// An overflow is a kernel bug, since the boot loader and `process_create` both
/// bound `seg_count` against `hal.MAX_ROOT_SEGMENTS` before the first grant and
/// `MAX_GRANT_ROWS` covers that plus the stack. The bound is re-tested here
/// because a silently dropped grant presents as a fault somewhere else
/// entirely.
///
/// A row that names a region is a reference on it. `region` is `NO_MEMORY` for
/// image segments, the stack grant and device windows, and `ref_region_row`
/// takes that arm, so every caller passes its answer unconditionally.
///
/// `base`/`top` are the user's range and `pa` its physical base. Every caller
/// knows both: the loader computes the destination frame from the region it was
/// handed, and `install_row` asks `hal.map_place`. On a tier that does not
/// translate the two are equal, which `hal.prot_update` asserts.
public(package) func record_grant(p: Int, base: UInt, top: UInt, pa: UInt,
                                  perms: UInt8,
                                  device: Bool, region: Int) unsafe {
    let b = body_of(p)
    if PROCESSES[b].grant_count >= MAX_GRANT_ROWS {
        fatal_image("more grants than a process's record can hold",
                    PROCESSES[b].grant_count as UInt)
    }
    let n = PROCESSES[b].grant_count
    PROCESSES[b].grants[n] = GrantRow(base: base, top: top, pa: pa,
                                      perms: perms, device: device,
                                      region: region)
    PROCESSES[b].grant_count = n + 1
    ref_region_row(region)
    // The hardware learns here, on a tier that keeps a standing image. This is
    // the single funnel every grant row is appended through (the loader's at
    // boot and `install_row`'s from a `map`), so the record and the tables move
    // together by construction, for any process, current or not. On a replay
    // tier it is a no-op and the row reaches hardware at the next switch.
    //
    // After the reference above: the region is held before anything can reach
    // the bytes, so a free cannot race the row that is about to permit access.
    //
    // `perms` is non-zero on both paths into here (an image segment must be
    // readable or executable, and `map_access` refuses a row that permits
    // nothing), which leaves zero free to mean the revocation in
    // `remove_grant`.
    hal.prot_update(b as UInt, base, top, pa, perms, device)
}

/// Where the next mapping of `len` bytes goes in `p`'s address space: the
/// kernel's VA policy.
///
/// First fit at or above the image region's top, over the rows `p` already has.
/// Everything below `region_top` is the image and its stack, placed by the
/// linker and recorded by the loader. Device rows are skipped: they live in a
/// window of their own and never contend with RAM for an address.
///
/// Addresses are recycled, so an address freed by `unmap` may be handed to a
/// later mapping of different bytes, and a program that keeps a pointer past
/// its own `unmap` can reach a stranger's memory instead of faulting. Closing
/// that would need a generation or quarantine. Don't replace this with a
/// monotonic cursor: cases such as `mapping_slot_free` and `memory_split` rely
/// on a freed address coming back.
///
/// No preemption point: at most `grant_count + 1` passes over at most
/// `MAX_GRANT_ROWS` rows, because every pass that changes anything moves `va`
/// above one more row's top.
///
/// The answer is not checked against the tier's window here: `install_row` asks
/// `hal.map_target_ok` about the returned range, the one place a refusal has
/// somewhere to go.
public(package) func free_user_va(p: Int, len: UInt) unsafe -> UInt {
    let b = body_of(p)
    var va = PROCESSES[b].region_top
    var pass: Int = 0
    while pass <= PROCESSES[b].grant_count {
        // Checked before the addition that computes the candidate's top:
        // overflow checks are always on, so a length that would run off the end
        // of the address space must become a refusal upstairs (`install_row`'s
        // window check) rather than a panic here.
        if len > UInt.max - va {
            return va
        }
        var bumped = false
        var i: Int = 0
        while i < PROCESSES[b].grant_count {
            let row = PROCESSES[b].grants[i]
            if not row.device && va < row.top && row.base < va + len {
                va = align_up(row.top, hal.PROT_GRAIN)
                bumped = true
            }
            i = i + 1
        }
        if not bumped {
            return va
        }
        pass = pass + 1
    }
    va
}

/// Resolve a user address to the physical one it names in `p`'s domain, or
/// `BadBuffer` if it names nothing.
///
/// Walks `p`'s grant rows for the one covering `va`; the caller then
/// dereferences through the linear map. Bounded by `MAX_GRANT_ROWS`.
///
/// The whole range must lie in one row. A row is the largest span over which
/// the user-to-physical mapping is affine (`GrantRow`), so a copy that crossed
/// a row boundary would need two translations and could not be one
/// `copy_bytes`.
///
/// A device row is not a candidate: the kernel does not copy through a register
/// window, and a memcpy over device memory would break the access-size
/// discipline a driver's own reads keep.
///
/// An address in no row is `BadBuffer`, the same answer the window checks give,
/// because the process handed the kernel an address it does not own.
public(package) func translate_user(p: Int, va: UInt,
                                    bytes: UInt) unsafe -> Result<UInt, FaultReason> {
    let b = body_of(p)
    var i: Int = 0
    while i < PROCESSES[b].grant_count {
        let row = PROCESSES[b].grants[i]
        if not row.device && va >= row.base && va < row.top {
            // Ordered so the subtraction cannot underflow: `row.top - va` is
            // computed only once `va` is known to be inside the row.
            if bytes > row.top - va {
                return FaultReason.BadBuffer
            }
            return row.pa + (va - row.base)
        }
        i = i + 1
    }
    FaultReason.BadBuffer
}

/// Make process `p`'s recorded domain the live one.
///
/// The one place a domain is installed. Its callers are the boot path
/// (`loader`), the scheduler at a switch that changes process (`run_thread`)
/// and `domain_changed`. Reset, replay and commit are written once so the boot
/// domain and a switched-in domain cannot be programmed differently.
///
/// The replay is for tiers where `hal.prot_replay_at_switch()` holds (the HAL
/// advertises this; the kernel does not guess the tier). Such a tier rebuilds
/// its protection set from the record at each switch. A tier that keeps a
/// persistent table set per process folds the loop away: the tables were
/// brought up to date when the record was edited (`record_grant` /
/// `remove_grant`), and `prot_switch` is the whole of the switch.
///
/// No preemption point: a half-rewritten grant table is an in-flight invariant,
/// and the staged sequence is one edit published by `prot_commit`.
public(package) func load_domain(p: Int) unsafe {
    let b = body_of(p)
    if hal.prot_replay_at_switch() {
        hal.prot_reset()
        var i: Int = 0
        while i < PROCESSES[b].grant_count {
            let row = PROCESSES[b].grants[i]
            // The replay programs the physical range. A replay tier filters
            // addresses the processor actually issues, where a user address is
            // its physical address, so `row.pa` and `row.base` are equal here
            // and the seam asserts it.
            if row.device {
                hal.prot_device(i as UInt, row.pa, row.top - row.base)
            } else {
                hal.prot_region(i as UInt, row.pa, row.pa + (row.top - row.base),
                                row.perms)
            }
            i = i + 1
        }
        hal.prot_commit()
    }
    hal.prot_switch(b as UInt)
    LAST_PROT_PROCESS = p
}

/// Take row `row` out of process `p`'s grant record and compact what is left.
///
/// Compaction is forced by `load_domain`'s replay by index: on a tier whose row
/// `i` programs numbered region `i`, a hole would install a disabled region in
/// the middle of the set or shift every later row's meaning at the next reload.
/// The Mapping slab's stored indices are fixed up beside this call
/// (`compact_mapping_rows`).
///
/// The caller has established that `row` is in range: a Mapping's stored index
/// is the `grant_count` `install_row` read immediately before appending its
/// row, and only a compaction has moved it since, which `compact_mapping_rows`
/// keeps in step.
///
/// The region is read first and dropped last, and the order is the contract:
/// the row leaves the record, and the grant is revoked in hardware, before the
/// region's count drops, so the domain has stopped granting these bytes by the
/// time they may go back on the pool's free list. The reverse order would let a
/// `Split` hand a range to a new owner while the old protection row still
/// reached it.
public(package) func remove_grant(p: Int, row: Int) unsafe {
    // Read once, and both consumers see that read: the hardware revoke (issued
    // first, here) and `region` (dropped last, below). The compaction is about
    // to move this storage.
    let b = body_of(p)
    let gone = PROCESSES[b].grants[row]
    // Revoked from the hardware before the range can move. Removing the row
    // from the record suffices where the hardware image is rebuilt from the
    // record at the next switch; where the tables persist, the record no longer
    // speaks for the hardware, so this call is what stops the grant and it must
    // precede `unref_region_row`. It is eager because an unmap that waited
    // would be a revocation that did not revoke. On a replay tier it is a no-op
    // and the replay stops programming the row.
    //
    // A grant of nothing is the revocation: the same call `record_grant` makes,
    // with permissions of zero. On a translating tier a non-granted page is
    // still mapped and simply denied to user mode, so removal is the
    // installation of deny. Zero is free to say so because neither door records
    // a row that permits nothing.
    hal.prot_update(b as UInt, gone.base, gone.top, gone.pa, 0, gone.device)
    var i = row
    while i + 1 < PROCESSES[b].grant_count {
        PROCESSES[b].grants[i] = PROCESSES[b].grants[i + 1]
        i = i + 1
    }
    PROCESSES[b].grant_count = PROCESSES[b].grant_count - 1
    unref_region_row(gone.region)
}

/// The live-domain rule: any edit to process `p`'s grant record reloads
/// immediately when `p`'s domain is the one in the hardware.
///
/// This is required because `run_thread` skips equal domains: the scheduler
/// reloads only when the process changes, so a record edited under the running
/// process would never be installed for as long as that process keeps the
/// processor. A `map()` would appear to succeed and the memory would still
/// fault; an `unmap()` would return `Ok` and the window would stay open.
///
/// It is a no-op for the common shape, a launcher mapping into a child it has
/// not started.
public(package) func domain_changed(p: Int) unsafe {
    if LAST_PROT_PROCESS == p {
        load_domain(p)
    }
}

/// Forget process `p`'s domain and its rows. Called by the teardown, just
/// before it frees the body.
///
/// Invalidating `LAST_PROT_PROCESS` is required: the body goes back at the end
/// of the teardown and the record once nothing names it, so a new process can
/// take either, compare equal to a domain that is no longer installed, and run
/// under the dead one's map because the next switch skips the reload. This is
/// separate from handle generations: a generation stops a stale handle from
/// naming the new occupant, and this stops a stale protection domain from
/// staying installed for it.
///
/// Every row this record holds is a reference on a region, so dropping the
/// record drops them all. A region whose last row goes here, with its handles
/// already closed by the sweep above this call, returns its range to its pool
/// (spec §2.5: a mapping dropped without unmap is leaked until the target
/// process's teardown).
///
/// The count is zeroed first, for `remove_grant`'s reason: nothing replays the
/// rows before any range can move. The row data is left in place and
/// overwritten by the next grant.
public(package) func clear_domain(p: Int) unsafe {
    let b = body_of(p)
    let rows = PROCESSES[b].grant_count
    PROCESSES[b].grant_count = 0
    // The standing image goes with the record, before the walk below can return
    // a range to its pool (the same composition as `remove_grant`). Zeroing the
    // count stops a replay tier from granting these bytes again; this call
    // stops a persistent-table tier, and the free list is reachable from the
    // next line, so the order is a contract.
    //
    // The body, and so the address-space identifier the tables are tagged with,
    // becomes reusable here, so the identifier's cached translations are
    // dropped. Invalidating `LAST_PROT_PROCESS` below is not enough: it only
    // forces the next switch to reprogram, which a persistent-table tier no
    // longer does.
    hal.prot_clear(b as UInt)
    var i: Int = 0
    while i < rows {
        unref_region_row(PROCESSES[b].grants[i].region)
        i = i + 1
    }
    if LAST_PROT_PROCESS == p {
        LAST_PROT_PROCESS = NO_PROCESS
    }
}

// -----------------------------------------------------------------------------
// Copy-out: the one door from kernel memory into a process's
// -----------------------------------------------------------------------------
//
// Spec §2.1's Pipe `receive` copies a message body into the receiver's address
// space through this door. The writer may be a different thread from the one
// that asked (a signaller waking a parked waiter). The destination is resolved
// through the target process's own grant record (`translate_user`) and reached
// through the linear map, so the copy does not depend on which process's domain
// is installed.
//
// What it refuses, each as a fault rather than a status because the process
// could have checked it:
//
//   - a destination that is not word-aligned (the kernel writes machine words;
//     a misaligned store traps on some tiers and is merely wrong on others);
//   - a destination outside the process's writable window (a record placed in
//     its own code is a misread memory map).
//
// The door reports and its caller faults: ending a process is a scheduling
// event, so the termination lives above the scheduler and these functions
// answer with the `FaultReason`. `None` means the buffer is good.
//
// These two doors are the only places the kernel dereferences a user address,
// so they are the only places that turn one into a kernel dereference.
// `hal.phys_to_virt` is the conversion on a tier whose kernel does not run at
// physical addresses, and the identity otherwise; the code reads the same
// either way, which keeps this module arch-free.

/// Validate a destination the kernel is about to write. `None` when it is fine.
///
/// Split out from `copy_out` for two reasons. Ops that park and copy at a later
/// wake (`Waiter.Wait`, the fused pipe call) validate while parking, so a bad
/// buffer ends the process that supplied it while that process is still the
/// running one, rather than at some later wake in another thread's context. Ops
/// that mint before they copy (`pipe_create`, `pipe_take`) validate first, so a
/// bad buffer faults before anything is minted. A consumer with neither
/// concern validates and copies in one step (`copy_out`).
public(package) func copy_out_check(p: Int, dst: UInt, bytes: UInt) unsafe -> FaultReason? {
    if (dst % word_bytes()) != 0 {
        return FaultReason.BadAlign
    }
    let b = body_of(p)
    if dst < PROCESSES[b].rw_base {
        return FaultReason.BadBuffer
    }
    // Ordered so the subtraction below cannot underflow: `rw_top - dst` is only
    // computed once `dst` is known to be inside the window. A hostile length
    // must produce a diagnostic, not a panic.
    if dst >= PROCESSES[b].rw_top {
        return FaultReason.BadBuffer
    }
    if bytes > PROCESSES[b].rw_top - dst {
        return FaultReason.BadBuffer
    }
    // The address must also resolve. The window above is conservative (it
    // includes the hole between the image's writable end and the stack); the
    // grant record says which user addresses exist. The early check owes the
    // same answer the copy will get: `pipe_call` validates when it parks and
    // copies at the resume, so a destination that passed here and failed there
    // would be a broken kernel invariant rather than a caller's mistake.
    let _ = try translate_user(p, dst, bytes) catch { return error }
    None
}

/// Copy `bytes` from kernel memory at `src` into process `p` at `dst`, unless
/// the destination is refused, in which case nothing is written and the reason
/// comes back.
///
/// The one door outward. Consumers include `Waiter.Wait` (ready and wake
/// paths), the boot-handle iterator's record, `clock_now`, the stats ops, and
/// the pipe ops that return a record or a message body (spec §2.1).
///
/// Nothing else in the kernel may dereference a user address for writing.
public(package) func copy_out(p: Int, dst: UInt, src: UInt, bytes: UInt) unsafe -> FaultReason? {
    if let why = copy_out_check(p, dst, bytes) {
        return why
    }
    // `dst` is the process's address and is resolved through its record
    // (`translate_user`: which bytes) and then reached through the linear map
    // (`phys_to_virt`: how the kernel touches them). `src` is already a kernel
    // address, from a `&var` of a record on this frame, and is neither.
    let pa = try translate_user(p, dst, bytes) catch { return error }
    copy_bytes(hal.phys_to_virt(pa), src, bytes)
    None
}

// -----------------------------------------------------------------------------
// Copy-in: the one door from a process's memory into the kernel's
// -----------------------------------------------------------------------------
//
// The mirror of `copy_out`. Spec §2.1's Pipe `send` copies a message body out
// of the sender's address space through it, and `Timer.Arm` uses it because a
// nanosecond time is 64 bits and `arm`'s (first deadline, interval) pair is
// four words on a 32-bit tier, which does not fit the three argument registers
// (spec §5.7).
//
// What it refuses, each as a fault rather than a status because the process
// could have checked it:
//
//   - a source that is not word-aligned (the same rule as copy-out, so a caller
//     learns one alignment rule for kernel records);
//   - a source outside the process's own memory (this check stops a process
//     from naming kernel memory or another process's).
//
// The window is the whole granted region, not the writable one. A process may
// hand the kernel a record out of its own rodata, so demanding a writable
// source would refuse correct programs. Writing outside the writable window
// corrupts the process, while reading outside the granted region reads somebody
// else, so each door checks the window that answers its own question.

/// Check a source the kernel is about to read from process `p`;
/// `copy_out_check`'s twin. `None` when it is fine.
///
/// A door that can be used late owes an early check. A fused `PipeInletOp.Call`
/// that meets a full ring parks on the inlet's room level with its message
/// still in the caller's memory, so the copy happens at the resume, in
/// whichever context freed the slot. Validating while the caller is still the
/// running process is both the better diagnostic and simpler to reason about.
///
/// A process's granted region is fixed for its life, so a source that passes
/// here cannot fail later; `pipe_call`'s resume treats a refusal as a broken
/// kernel invariant, as `deliver_wait_record` does for its own.
public(package) func copy_in_check(p: Int, src: UInt, bytes: UInt) unsafe -> FaultReason? {
    if (src % word_bytes()) != 0 {
        return FaultReason.BadAlign
    }
    let b = body_of(p)
    if src < PROCESSES[b].region_base {
        return FaultReason.BadBuffer
    }
    // Ordered so the subtraction below cannot underflow: `region_top - src` is
    // computed only once `src` is known to be inside the region. A hostile
    // length must produce a diagnostic, not a panic.
    if src >= PROCESSES[b].region_top {
        return FaultReason.BadBuffer
    }
    if bytes > PROCESSES[b].region_top - src {
        return FaultReason.BadBuffer
    }
    // The address must also resolve, as in `copy_out_check`.
    let _ = try translate_user(p, src, bytes) catch { return error }
    None
}

/// Copy `bytes` from process `p` at `src` into kernel memory at `dst`, unless
/// the source is refused, in which case nothing is read and the reason comes
/// back.
///
/// The one door inward. Consumers include `timer_arm` (the (after, interval)
/// pair) and the pipe ops that read a send record or a message body (spec
/// §2.1). Nothing else in the kernel may dereference a user address for
/// reading.
public(package) func copy_in(p: Int, dst: UInt, src: UInt, bytes: UInt) unsafe -> FaultReason? {
    if let why = copy_in_check(p, src, bytes) {
        return why
    }
    // As in `copy_out`: `src` is the process's address, resolved through its
    // record and then reached through the linear map; `dst` is the kernel's own
    // storage and is neither.
    let pa = try translate_user(p, src, bytes) catch { return error }
    copy_bytes(dst, hal.phys_to_virt(pa), bytes)
    None
}

// =============================================================================
// The boot region table, and the Memory objects it mints
// =============================================================================
//
// The build emits a table and the kernel mints one object per row, interpreting
// nothing: the stitcher appends each child image to the boot blob as it is and
// records where things are, the kernel turns each row into a capability, and
// root's config says which ordinal is an image and which is a destination.
//
// A row carries a kind, the one thing the kernel reads besides its bounds:
//
//   - a blob region (an appended image, base resolved by the linker) and a
//     free-RAM region (a pool or a child's destination range) are both
//     `kind = Ram` and indistinguishable here on purpose; the difference is in
//     what root does with them;
//   - a Device row names a peripheral's registers and mints an `IoMemory`
//     rather than a `Memory`, because the pool attribute is a kind (spec §2.5)
//     and a kind cannot be inferred from an address the kernel may not
//     interpret.
//
// A missing or empty table is zero regions, the ordinary reading of a section
// the linker script always defines and the stitcher usually does not fill. The
// `len == 0` short-circuit is ahead of every header read so that an image with
// no table is not refused for a version it never wrote.
//
// Wire layout (fixed-width little-endian, as the sosimg format): an 8-byte
// header (magic `u32`, version `u16`, count `u8`, reserved `u8`), then `count`
// rows of `{base: u64, len: u64, kind: u8, reserved x 7}`. The header's size
// puts every row on an 8-byte boundary and the row's padding keeps the next one
// there, which is what makes the overlay below exact.

/// The region table's header: 8 bytes at the section's start. The version field
/// is the first thing a reader needs, so its position may never move.
struct RegionTableHeader {
    magic: UInt32,
    version: UInt16,
    count: UInt8,
    reserved0: UInt8,
}

/// A region row's kind. The two kinds are spec §2.5's pool attributes: RAM is
/// cacheable memory a process runs in, Device is a peripheral's registers, and
/// the kernel mints a different object kind for each (`Memory` / `IoMemory`).
///
/// Raw-backed, so a reorder cannot renumber them, and read at the boundary with
/// `from(raw:)`, which is total: an unrecognized byte is data the loader
/// refuses (`fatal_image`, since the build wrote the table) rather than an
/// index it trusts.
enum RegionKind: UInt8 {
    case Ram = 0,
    case Device = 1,
}

/// One row: a range, what kind of memory it is, and room to grow.
///
/// 24 bytes, size-pinned. The seven reserved bytes are declared rather than
/// compiler padding so the size is a decision; they leave room for another
/// column (a pool identity, a finer attribute) without a version bump.
struct RegionRow {
    base: UInt64,
    len: UInt64,
    kind: UInt8,
    reserved0: UInt8,
    reserved1: UInt8,
    reserved2: UInt8,
    reserved3: UInt8,
    reserved4: UInt8,
    reserved5: UInt8,
    reserved6: UInt8,
}

// ABI pin: a layout edit that skews these stops the build here instead of
// misreading a table at boot. They hold on every profile.
static_assert(sizeof<RegionTableHeader>() == 8,
              "the region table header must be exactly 8 bytes")
static_assert(sizeof<RegionRow>() == 24,
              "a region table row must be exactly 24 bytes")

/// 'S','R','G','N' as a little-endian word, "SOS regions".
static REGION_TABLE_MAGIC: UInt32 = 0x4E47_5253

/// The only region table version the kernel accepts. A loader refuses anything
/// it does not know, as the sosimg format does: an unknown layout cannot be
/// safely guessed at, and a version-1 row read as version 2 would take the next
/// row's base as this one's kind. The stitcher and kernel are built together.
/// An image with no table at all reads as zero regions and never reaches this
/// comparison.
static REGION_TABLE_VERSION: UInt16 = 2

/// Overlay the header on the section's first bytes. One view construction, then
/// an ordinary safe struct; the unsafety is confined to this line.
///
/// `addr` is physical, as every address the kernel holds as data is; the linear
/// map is where the kernel reaches it.
func region_header_at(addr: UInt) unsafe -> RegionTableHeader {
    UnsafeMemory<RegionTableHeader, Normal>(hal.phys_to_virt(addr)).read()
}

/// Overlay one row. Same conversion, same reason.
func region_row_at(addr: UInt) unsafe -> RegionRow {
    UnsafeMemory<RegionRow, Normal>(hal.phys_to_virt(addr)).read()
}

/// Parse the region table and mint one Memory or IoMemory per row into process
/// `p`, queuing a boot-handle record for each.
///
/// Every refusal is `fatal_image`: the table is part of the boot image, written
/// by the build that produced this kernel, and a machine whose own boot data is
/// malformed has nothing to run. `BadImage` as a status belongs to
/// `process_create`, where the bytes came from a region root handed over at run
/// time.
///
/// No preemption point: at most `MAX_MEMORIES + MAX_IOMEMORIES` iterations of
/// an O(1) body, before any thread exists.
func mint_boot_regions(p: Int) unsafe {
    let start = hal.region_table_start()
    let end = hal.region_table_end()
    if end < start {
        fatal_image("region table bounds inverted", start)
    }
    let len = end - start
    let header_len = sizeof<RegionTableHeader>() as UInt
    let row_len = sizeof<RegionRow>() as UInt

    // An image built with no children has an empty section: zero regions, not
    // an error.
    if len == 0 {
        return
    }
    if len < header_len {
        fatal_image("region table is shorter than its header", len)
    }

    let header = region_header_at(start)
    if header.magic != REGION_TABLE_MAGIC {
        fatal_image("region table has bad magic", header.magic as UInt)
    }
    if header.version != REGION_TABLE_VERSION {
        fatal_image("region table version is not this build's",
                    header.version as UInt)
    }
    let count = (header.count as UInt)
    // The bound is both slabs' combined: a row mints into one or the other by
    // its kind. The per-row `alloc_*` refusals below catch a table that is
    // small enough overall but lopsided.
    if count > ((MAX_MEMORIES + MAX_IOMEMORIES) as UInt) {
        fatal_image("more boot regions than the kernel can hold", count)
    }
    if count * row_len > len - header_len {
        fatal_image("region table rows run past the section", count)
    }

    var i: UInt = 0
    while i < count {
        let row = region_row_at(start + header_len + i * row_len)
        // The table's fields are 64-bit on every profile, as sosimg's addresses
        // are. A 32-bit kernel refuses a row it cannot address rather than
        // narrowing one into a low address the build never meant.
        if not fits_word(row.base) || not fits_word(row.len) {
            fatal_image("boot region is past this machine's address space", i)
        }
        // A row's base is normalized to physical here, once, because the rows
        // come from two producers. A blob row's base is a linker expression
        // (the child section's own symbol), which on a higher-half kernel is a
        // link address in the high half; a destination, pool or device row's
        // base is a literal the build wrote, already physical. `virt_to_phys`
        // is idempotent on the literals and corrective on the linker-resolved
        // ones, and the identity on a tier without a higher half.
        //
        // This must precede storing the base, because it becomes a
        // `Memory`/`IoMemory` capability's base: a user-visible address that
        // root maps and hands to children and that ends up as a grant row's
        // bounds in hardware.
        let row_base = hal.virt_to_phys(row.base as UInt)
        // The kind is data the build wrote, so it is decoded rather than
        // trusted: an unknown byte stops the boot with the number in it. The
        // `return` is required by the language: `fatal_image` is not declared
        // `-> Never`, so a guard's else block has to exit the scope itself.
        guard let kind = RegionKind.from(raw: row.kind) else {
            fatal_image("boot region has a kind this build cannot name",
                        row.kind as UInt)
            return
        }
        // The tag is the row ordinal; root's config gives it a meaning. The
        // kernel writes root's boot record through the same machinery
        // `ProcessOp.Give` uses for a child's, into root's own per-process set,
        // so the drain cannot tell the two producers apart.
        if not boot_handle_room(p) {
            fatal_image("no boot-record room for the boot regions", i)
        }
        // Two kinds of row, two kinds of object: the same range becomes a
        // different capability depending on the kind byte the build wrote.
        match kind {
            case Ram -> {
                let slot = alloc_memory()
                if slot == NO_MEMORY {
                    fatal_image("out of Memory slots for the boot regions", i)
                }
                // `refs: 1` is the mint below: a boot region is created with
                // exactly one handle onto it, so the count starts at one.
                //
                // A boot region is a pool root, and a root names itself (`root:
                // slot`). This is the one place a pool is created; every other
                // region is a `Split` off one of these and carries this slot's
                // index down the chain. The ledger starts empty: nothing lent,
                // nothing free but the cursor, nothing dropped.
                MEMORIES[slot] = MemorySlot(state: SlotState.Live, process: p,
                                            base: row_base,
                                            len: row.len as UInt,
                                            refs: 1, maps: 0, root: slot,
                                            free_head: 0, out_bytes: 0,
                                            dropped: 0)
                let handle = mint_handle(p, ObjType.Memory, memory_rights(), slot)
                if handle == NO_HANDLE {
                    fatal_image("no handle table room for the boot regions", i)
                }
                quota_charge(p, QuotaKind.Memory)
                queue_boot_handle(p, i, BootHandleKind.Memory, handle)
            },
            case Device -> {
                let slot = alloc_iomemory()
                if slot == NO_IOMEMORY {
                    fatal_image("out of IoMemory slots for the boot regions", i)
                }
                IOMEMORIES[slot] = IoMemorySlot(state: SlotState.Live, process: p,
                                                base: row_base,
                                                len: row.len as UInt,
                                                refs: 1)
                let handle = mint_handle(p, ObjType.IoMemory, iomemory_rights(),
                                         slot)
                if handle == NO_HANDLE {
                    fatal_image("no handle table room for the boot regions", i)
                }
                quota_charge(p, QuotaKind.IoMemory)
                queue_boot_handle(p, i, BootHandleKind.IoMemory, handle)
            },
        }
        i = i + 1
    }

    let uart = console()
    uart.write_str("SOS: boot regions=")
    uart.write_hex(count)
    uart.write_str("\n")
}

/// Can this build's machine word hold `v`?
///
/// `imgformat.fits_target_word` answers the same question for a sosimg field;
/// this copy exists because the region table is sawos's format, not the shared
/// image format, and the two must be free to version apart. It folds to a
/// constant `true` on a 64-bit profile.
func fits_word(v: UInt64) -> Bool {
    if sizeof<UInt>() >= 8 {
        return true
    }
    v <= 0xFFFF_FFFFu64
}

// =============================================================================
// Into user mode
// =============================================================================

/// Reify a user-mode program as a Process with one Thread, mint its boot handle
/// set, and run it. Never returns.
///
/// The only way into user mode for the first process. The loader reaches it
/// with a root image's entry and region; harness kernels that grant a
/// hand-written payload its own bytes reach it with theirs. A child does not
/// come through here: `ProcessOp.Start` makes a thread and lets the scheduler
/// pick it up.
///
/// `p = ROOT_PROCESS`: the kernel loads exactly one image (spec §12), it takes
/// the first record and the first body (`claim_root`), and every later process
/// is created by root through `process_create`.
///
/// The three handles are minted in an order the boot ABI depends on: System
/// first, so it comes out as `ROOT_SYSTEM_HANDLE`, the register the program
/// receives (spec §12). The other two are not passed anywhere; the program asks
/// for them. The boot regions come after all three: they are collected
/// (`ProcessOp.BootHandleNext`) rather than passed, so the entry register stays
/// one handle wide.
///
/// `rw_base`/`rw_top` default to none: harness payloads are granted
/// read+execute only, so the kernel may write nowhere in them and should say so
/// if asked. Only the loader, which grants a data segment and a stack, passes a
/// window.
public func start_process(entry: UInt, stack_top: UInt,
                          region_base: UInt, region_top: UInt,
                          rw_base: UInt = 0, rw_top: UInt = 0) unsafe -> Never {
    let p: Int = ROOT_PROCESS
    claim_root()
    let b = body_of(p)

    // Field by field rather than a whole-entry literal: the loader has already
    // recorded root's grant rows in the body, and a struct literal would erase
    // them.
    PROCESS_RECORDS[p].state = ProcessState.Running
    PROCESS_RECORDS[p].exit_kind = ProcessStatusKind.Running
    PROCESS_RECORDS[p].exit_code = 0
    PROCESS_RECORDS[p].refs = 0
    PROCESSES[b].entry = entry
    PROCESSES[b].stack_top = stack_top
    PROCESSES[b].region_base = region_base
    PROCESSES[b].region_top = region_top
    PROCESSES[b].rw_base = rw_base
    PROCESSES[b].rw_top = rw_top
    // The trap columns open at zero. Root is reified here rather than through
    // `process_create`, so its body's row of the stats region is cleared here.
    // Boot-door traps a harness kernel takes before this line are unattributed
    // by `ktrap`, so nothing has been counted against root's row yet.
    stats_clear(b)

    // The ledger opens before the first mint, because `mint_handle` consults
    // the handle row and a record with no limits installed can allocate
    // nothing. Root's rows are `QUOTA_UNLIMITED` (root is init and the slab is
    // what refuses it) except the mapping row, which is clamped to the rows
    // root's domain still has after the loader spent its image's. That is what
    // makes `install_row`'s kernel-bug `fatal` unreachable. The loader has
    // already recorded root's grant rows, so the free-row count can be read
    // here.
    install_quota_limits(p, true,
                         (hal.GRANT_ROW_BUDGET as Int) - PROCESSES[b].grant_count)

    // Spec §12's order is the contract: the three are minted into a virgin
    // table, so each lands at generation 0 and its word is the bare index (1 =
    // System, 2 = Process, 3 = Thread). The Process and Thread handles are
    // minted so root's own Process and main Thread occupy those indices;
    // nothing reads the words back (`ProcessSelf` and `ThreadSelf` mint their
    // own), so neither is bound to a name.
    let system = mint_handle(p, ObjType.System, root_system_rights(), 0)
    let _ = mint_handle(p, ObjType.Process, process_rights(), p)
    // Root's own Process handle is a reference to root's record, counted like
    // any other. It makes root's count start at one.
    PROCESS_RECORDS[p].refs = PROCESS_RECORDS[p].refs + 1

    let main = alloc_thread()
    let _ = mint_handle(p, ObjType.Thread, thread_rights(), main)
    // The boot Thread handle is the main thread's one reference.
    THREADS[main] = ThreadSlot(state: ThreadState.Running, process: p,
                               exit_code: 0,
                               joiners: 0, link: 0, wait_buf: 0,
                               call_pipe: 0, call_claim: 0, call_src: 0,
                               call_len: 0, refs: 1)
    quota_charge(p, QuotaKind.Thread)
    CURRENT_THREAD = main
    SLICE_LEFT = SLICE_TICKS

    if system != ROOT_SYSTEM_HANDLE {
        fatal_image("the boot handle set did not start at the System handle",
                    system)
    }

    mint_boot_regions(p)

    // The domain this process runs under is installed and the scheduler is told
    // so: the boot path grants directly, so the first switch must not reload
    // what is already live. A harness kernel that programmed `prot_*` itself
    // records no rows, and with one process the comparison never comes up
    // again.
    LAST_PROT_PROCESS = p

    // The handover marker: the last thing the kernel says on its own
    // initiative, after which a transcript reads everything as the process's.
    // See `Console`.
    console().write_str("SOS: console handover\n")

    hal.frame_init(frame_slot(main), entry, stack_top, system)
    // `resume_frame` is `-> Never`: it enters the process and the kernel is
    // only re-entered through a trap. That is this function's divergence.
    hal.resume_frame(frame_slot(main))
}
