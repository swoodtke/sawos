//! A PROCESS: the slab, its GRANT RECORD, the two doors into and out of its
//! memory, and the one way into user mode.
//!
//! WHAT THIS MODULE IS *NOT* IS THE TEARDOWN, and its absence is design 2's one
//! structural finding rather than a tidy-up. Ending a process used to stop the
//! machine, so it could live here beside the slabs it frees; with more than one
//! process it ends in a RESCHEDULE, and choosing what runs next can IDLE, and
//! idling DELIVERS, and delivery reaches back down into this module's copy door.
//! That is design 1's cycle at a second site, so the teardown sits with the
//! scheduler (`kcore.sched`) and this module holds the state it frees. The full
//! argument is in `sched.saw`'s header.
//!
//! What is left here divides cleanly: the PROCESSES table and the protection
//! domain each slot records, the two copy doors — which now REPORT a bad buffer
//! instead of faulting on it, for the same altitude reason — and `start_process`,
//! the single way a program reaches user mode.

import hal
import sosabi.{
    ObjType,
    FaultReason,
    ProcessStatusKind,
    BootHandleKind,
    root_system_rights,
    process_rights,
    memory_rights,
    iomemory_rights,
    thread_rights,
    NO_HANDLE,
    ROOT_SYSTEM_HANDLE,
}
import kcore.limits.{
    MAX_GRANT_ROWS,
    MAX_IOMEMORIES,
    MAX_MEMORIES,
    MAX_PROCESSES,
    NO_IOMEMORY,
    NO_MEMORY,
    NO_PROCESS,
    ROOT_PROCESS,
}
import kcore.mem.{copy_bytes, word_bytes}
import kcore.diag.{console, fatal_image}
import kcore.objects.{
    IOMEMORIES,
    IoMemorySlot,
    MEMORIES,
    MemorySlot,
    QuotaKind,
    SlotState,
    alloc_iomemory,
    alloc_memory,
    boot_handle_room,
    install_quota_limits,
    mint_handle,
    queue_boot_handle,
    quota_charge,
    ref_region_row,
    unref_region_row,
}
import kcore.threads.{
    CURRENT_THREAD,
    LAST_PROT_PROCESS,
    SLICE_LEFT,
    SLICE_TICKS,
    THREADS,
    ThreadSlot,
    ThreadState,
    alloc_thread,
    frame_slot,
}

/// What a process slot is doing.
///
/// `Created` is M3 unit 2's, and it is the whole of the two-phase lifecycle in
/// the state machine: `process_create` leaves a process INERT — an address
/// space with an entry and a stack recorded and no thread — and `start` is what
/// makes it run. A second `start` is a `BadState` fault because this word says
/// the first one already happened.
public(package) enum ProcessState: UInt8 {
    case Free = 0,
    case Running = 1,
    case Gone = 2,
    case Created = 3,
}

/// ONE INSTALLED PROTECTION ROW — a range, what may be done with it, and
/// whether it names hardware (sawos design 2 D-5).
///
/// It is the argument list of a `hal.prot_region` / `hal.prot_device` call,
/// remembered. That is the honest description and it is why there is no
/// per-profile field: what a permission bit does to the machine is the HAL's,
/// and this record's job is only to say the same thing twice — once when the
/// grant is made and once when the scheduler puts it back.
public(package) struct GrantRow {
    public(package) base: UInt,
    public(package) top: UInt,
    public(package) perms: UInt8,
    public(package) device: Bool,
    /// WHICH `Memory` REGION these bytes are, or `NO_MEMORY` (sawos design 28).
    ///
    /// **THE BACK-REFERENCE RIDES THE ROW BECAUSE THE ROW IS WHAT IS COUNTED**
    /// (`MemorySlot.maps`). A row outlives its `Mapping` object by design — 7
    /// D-2's husk arm frees the slot and leaves the row installed — so a link
    /// kept on the Mapping slot would be lost exactly when the region still
    /// needed to know that something was granting its bytes. Here it cannot be:
    /// a row is born in `record_grant`, dies in `remove_grant` or
    /// `clear_domain`, and travels with its own row through the compaction
    /// because the compaction copies whole rows.
    ///
    /// `NO_MEMORY` is the common case and means "these bytes are not a region
    /// the pool lent out": an image segment, the kernel's stack grant, and every
    /// DEVICE row (an IoMemory is pinned and returns nothing — §5.9's carve-out).
    public(package) region: Int,
}

/// One process (spec §2 table row): its protection domain, its handle table and
/// its threads.
///
/// The handle table is not a field: it is a slice of `HANDLES` below, indexed
/// by this slot. That is the same arrangement as the frames and for the same
/// reason — a fixed-size array of fixed-size arrays is a shape the kernel has
/// no allocator for.
///
/// `region_base`/`region_top` ARE the address-space domain's OUTER BOUNDS: one
/// granted range per process, and the one question thread creation has to ask —
/// is this entry, is this stack, inside the process at all.
/// `rw_base`/`rw_top` are the WRITABLE window inside that range, and they exist
/// because the kernel now writes into a process's memory (`copy_out`). A
/// process that asks the kernel to place a record in its own CODE has made a
/// caller-checkable mistake, and the check needs somewhere to read the answer
/// from. It is ONE window rather than a per-segment list because a loaded image
/// is contiguous (spec §5.5's `code|rodata|rw` layout) plus a stack at the
/// region's top edge, so the writable part is the span between them. That holds
/// for a CHILD exactly as it does for root — `process_create` computes it by
/// root's own rule. **UNIT 4's `Mapping` DID NOT REPLACE THIS PAIR, and the
/// reason is worth recording where the pair is**: a mapping records its own
/// access, so the per-mapping answer now EXISTS — but this window is what the
/// KERNEL checks a record it is about to write against (`copy_out`), and
/// answering that by walking the grant rows would make every copy-out a scan.
/// The pair stays the conservative span it always was; a row-walk is the
/// improvement, not the correction.
/// It is CONSERVATIVE in one direction only: a gap between the image's writable
/// end and the stack falls inside the span, so the kernel may write RAM the
/// process was not granted. That corrupts nothing — the process owns the whole
/// region either way, and a process that names a hole gets a record it cannot
/// read, which is its own bug.
///
/// Zero/zero means NO writable grant, and that is the honest answer for the
/// harness kernels that grant a payload its own bytes read+execute: a process
/// with nowhere to receive a record cannot receive one.
///
/// `grants`/`grant_count` are the GRANT RECORD (sawos design 2 D-5) — the rows
/// this process's domain is made of, written by whoever grants and REPLAYED by
/// the scheduler when it switches in. With one process the live protection set
/// and the only process's set were the same thing, so nothing had to be
/// remembered; with two they cannot be — one profile has a small fixed budget
/// of numbered regions and a three-segment image spends all of it, and the
/// other's grant window is a single shared user-mode permission map — so the
/// domain is DATA now and installing it is an operation.
///
/// `public(package)`, like the `PROCESSES` table below it: `kcore.dispatch` and
/// `kcore.sched` read slots out of that table, so a private element type would
/// be a value a sibling module holds and cannot name (refused since the Aug-21
/// signature-visibility rule).
/// (`self_handle` WAS HERE and is GONE — sawos design 3 D-4. It cached the word
/// `ProcessSelf` answered with, which only made sense while a getter handed the
/// same handle back every ask. Under mint-per-call a process's own Process
/// handle is not a fact about the process at all: it is however many capability
/// instances the process asked for, each independently releasable, so a cached
/// word would name one of them and go stale the moment that one was released.
/// The table is the truth. `ThreadSlot.self_handle` went the same way and for
/// the same reason.)
public(package) struct ProcessSlot {
    public(package) state: ProcessState,
    /// The image entry, which is what `ENTRY_IMAGE` resolves to.
    public(package) entry: UInt,
    /// Where a `start` puts the first thread's stack pointer — the kernel's
    /// grant at the region's top, recorded at create so root supplies no
    /// numbers at start.
    public(package) stack_top: UInt,
    public(package) region_base: UInt,
    public(package) region_top: UInt,
    public(package) rw_base: UInt,
    public(package) rw_top: UInt,
    public(package) grant_count: Int,
    public(package) grants: [GrantRow; MAX_GRANT_ROWS],
    public(package) exit_kind: ProcessStatusKind,
    public(package) exit_code: UInt,
    /// How many handle entries ANYWHERE name this process (sawos design 7
    /// D-1).
    ///
    /// **THIS IS DESIGN 3 D-3's SCAN, GENERALIZED INTO A COUNT.** Unit 2.75
    /// answered "may this Gone slot be spent again" by walking every process's
    /// handle table looking for a reference, and argued at the time that a
    /// per-slot count would be a second fact to keep in step with the table.
    /// Unit 5 keeps seven other kinds' counts in step at exactly the same
    /// sites, so the argument reverses: the count is now the CHEAPER thing to
    /// maintain and the walk is the odd one out. The answer is identical —
    /// no handle naming the slot means no possible reader of its §8 status
    /// word — and `reclaim_process_slot` reads this instead of scanning.
    ///
    /// It counts references from EVERY process's table, which is why it lives
    /// on the slot rather than in the ledger: whoever still holds a handle is
    /// the reader that matters, and that need not be the process releasing one.
    ///
    /// **AND SINCE M3 UNIT 5.5 IT COUNTS THE ATTACHMENT TOO** (sawos design 8,
    /// amending design 7 D-1's table row): a Process handle is a waitable, an
    /// attachment is a counted reference on every waitable, and this one is
    /// load-bearing rather than uniform — it is what makes attach-after-death
    /// SOUND. A supervisor watching a dead child holds the slot open, so the
    /// §8 status word it is waiting to read cannot be reclaimed out from under
    /// it by design 3 D-3's rule.
    public(package) refs: UInt16,
    /// The attachment naming this process (slot + 1); 0 = unattached (sawos
    /// design 8).
    ///
    /// THE SAME FIELD THE THREE OTHER WAITABLES CARRY, for the same reason
    /// (`EventSlot.attachment`): §2.2 ratifies at most one Waiter per handle,
    /// so it is a field rather than a list, and it is the ONE thing the
    /// notifying side has to load — `end_process` asks it and nothing else
    /// about the wait machinery.
    ///
    /// It lives here rather than beside the wait tables because it is a
    /// property of the process slot, and that is also why `kcore.waitables`
    /// now sits ABOVE this module: a Process's readiness and payload are read
    /// out of this table. See `kcore`'s module-order list.
    public(package) attachment: Int,
    /// **THE THREE TRAP COLUMNS** (sawos design 16), split by the cause class
    /// `ktrap` decides on: syscall traps, interrupts taken while this process
    /// was current, and every other exception. `sosabi`'s
    /// `PROCESS_STATS_RECORD_DOUBLEWORDS` block is the full description of what
    /// each counts and which one an assertion may read.
    ///
    /// **`UInt64` ON BOTH PROFILES, AND THAT IS THE POINT.** A count is a
    /// property of the quantity rather than of the machine: a `UInt` column
    /// would be register-wide, so the same program would answer two different
    /// things about itself depending on which profile it was built for. It is
    /// the same rule the Clock record follows for a nanosecond count.
    ///
    /// THEY LIVE ON THE PROCESS SLOT AND NOT ON THE THREAD SLOT because the
    /// ruled surface is PER-PROCESS (design 16, user, Sep 1) — per-thread waits
    /// for a consumer that names it. A thread's traps are its process's, which
    /// is what makes the count survive the thread and makes a multi-threaded
    /// process's total the one number a supervisor asked for.
    public(package) syscalls: UInt64,
    public(package) interrupts: UInt64,
    public(package) faults: UInt64,
}

public(package) unsafe static var PROCESSES: [ProcessSlot; MAX_PROCESSES] = [
    ProcessSlot(state: ProcessState.Free, entry: 0,
             stack_top: 0, region_base: 0, region_top: 0, rw_base: 0, rw_top: 0,
             grant_count: 0,
             grants: [GrantRow(base: 0, top: 0, perms: 0, device: false,
                               region: NO_MEMORY);
                      MAX_GRANT_ROWS],
             exit_kind: ProcessStatusKind.Running, exit_code: 0,
             refs: 0, attachment: 0,
             syscalls: 0, interrupts: 0, faults: 0); MAX_PROCESSES]

/// Take a free process slot, or `NO_PROCESS` when the table is full.
///
/// **`Gone` IS NOT `Free`, AND A DEAD SLOT IS SPENT AGAIN ONLY WHEN NOTHING CAN
/// READ IT** (sawos design 3 D-3, amending unit 2's pend) — which is why this
/// scans rather than counting how many processes have been made. The teardown
/// leaves the slot holding its §8 status word, because the creator's handle onto
/// it OUTLIVES it (the teardown closes the handles in the DEAD process's table,
/// not in its creator's) and reading how a child died is the whole of the
/// supervision story. What unit 2 lacked was a way to know when the last reader
/// was gone; RELEASE is that reader-count, and `reclaim_process_slot` below is
/// the check. So `MAX_PROCESSES` bounds CONCURRENT processes again, which is
/// what the name says, and a request past it is still `NoResource`.
///
/// `ThreadState.Exited` is the same decision one level down, and it has NOT
/// moved: a join arriving after the exit still has to find the exit code, and no
/// handle names a thread slot the way one names a process slot, so there is no
/// reader-count to run. Thread slots come back at the process's teardown.
public(package) func alloc_process() unsafe -> Int {
    var i: Int = 0
    while i < MAX_PROCESSES {
        match PROCESSES[i].state {
            case Free -> { return i },
            case _ -> {},
        }
        i = i + 1
    }
    NO_PROCESS
}

/// Free a `Gone` process's slot if no handle ANYWHERE still names it (sawos
/// design 3 D-3).
///
/// **THE ONE SLAB THAT RECLAIMS ON RELEASE, and it is special for a reason the
/// others do not share.** Every other kind's slot is freed by its owner's
/// teardown, because "may I free this" has no cheap answer for an Event or a
/// Timer — it needs a refcount nothing yet justifies. A Gone process's slot is
/// different twice over: unit 2 explicitly queued it (`alloc_process` above
/// recorded the pend), and its question has a PRECISE answer. The only thing a
/// Gone slot still holds is its §8 status word, the only way to read that word
/// is `GetStatus` through a Process handle, so no handle naming the slot means
/// no possible reader and the slot may go.
///
/// **COUNTED, NOT SCANNED — AND THAT IS WHAT UNIT 5 CHANGED HERE** (sawos
/// design 7 D-1, superseding design 3 D-3's walk). Unit 2.75 argued the walk
/// was the cheaper thing, because a per-slot count would be a second fact to
/// keep in step with the table across mint, release, teardown and `give`.
/// Design 7 keeps seven other kinds' counts in step at exactly those sites, so
/// the second fact is no longer second: `ProcessSlot.refs` is maintained by the
/// same lines that maintain an Event's, and the thirty-two-entry walk is gone
/// with the era that needed it. The ANSWER is unchanged — zero references means
/// no possible reader of the §8 status word — which is why no transcript moves
/// for this alone.
///
/// EVERY PROCESS'S TABLE, not the caller's, exactly as before: the count is
/// incremented wherever a Process handle is bound, in whichever table. It runs
/// at the END of a process's own teardown too, for its own slot — the dying
/// process's handles are closed there, and if it happened to hold the last one
/// (a process that released its creator's handle, or a self-referring root)
/// that close is what takes the count to zero.
///
/// D-1's generations are what make the reused slot SAFE: a later process landing
/// here gets a new life, and a word onto the old one has a generation that no
/// longer matches. `clear_domain` already invalidated `LAST_PROT_PROCESS` in
/// anticipation of exactly this.
///
/// A LIVE PROCESS IS NEVER RECLAIMED however far its count falls — a process
/// nobody holds a handle to is still running, and its slot is what it is
/// running IN. That is the whole reason this is a `Gone`-only arm rather than
/// the plain "free at zero" every other kind gets.
public(package) func reclaim_process_slot(slot: Int) unsafe {
    match PROCESSES[slot].state {
        case Gone -> {},
        case _ -> { return },
    }
    if PROCESSES[slot].refs != 0 {
        return
    }
    PROCESSES[slot].state = ProcessState.Free
}

// -----------------------------------------------------------------------------
// The grant record, and installing a domain (sawos design 2 D-5)
// -----------------------------------------------------------------------------

/// Record one row of process `p`'s protection domain.
///
/// Rows are appended IN THE ORDER THEY ARE GRANTED, and the order is
/// load-bearing on one profile: `hal.prot_region`'s index names a numbered
/// hardware region there, so replaying row `i` at index `i` is what makes an
/// installed domain identical to the one the loader staged directly before this
/// record existed.
///
/// An overflowing record is a caller error the caller has already refused: both
/// the boot loader and `process_create` bound `seg_count` against
/// `hal.MAX_ROOT_SEGMENTS` before the first grant, and `MAX_GRANT_ROWS` covers
/// that plus the stack. The bound is re-tested here anyway because a silently
/// dropped grant is a process running with less memory than it was given, which
/// presents as a fault somewhere else entirely.
/// **AND A ROW THAT NAMES A REGION IS A REFERENCE ON IT** (sawos design 28).
/// `region` is `NO_MEMORY` for every row that is not one — image segments, the
/// stack grant, device windows — and `ref_region_row` takes that arm, which is
/// what lets all five callers pass their answer unconditionally.
public(package) func record_grant(p: Int, base: UInt, top: UInt, perms: UInt8,
                                  device: Bool, region: Int) unsafe {
    if PROCESSES[p].grant_count >= MAX_GRANT_ROWS {
        fatal_image("more grants than a process's record can hold",
                    PROCESSES[p].grant_count as UInt)
    }
    let n = PROCESSES[p].grant_count
    PROCESSES[p].grants[n] = GrantRow(base: base, top: top,
                                      perms: perms, device: device,
                                      region: region)
    PROCESSES[p].grant_count = n + 1
    ref_region_row(region)
    // THE HARDWARE LEARNS HERE, on a tier that keeps a standing image (sawos
    // design 27). This is the single funnel every grant row is appended
    // through — the loader's three at boot and `install_row`'s one from a
    // `map` — so putting the edit here is what makes the record and the tables
    // move together by construction, for ANY process, current or not, rather
    // than by two call sites agreeing to stay in step. On the MPU tier it is a
    // no-op and the row reaches hardware at the next switch, exactly as before.
    //
    // AFTER the reference above, so the region is held before anything can
    // reach the bytes: the grant is the thing that makes them reachable, and
    // taking the reference first is what stops a free from racing the row that
    // is about to permit access to it.
    //
    // `perms` is non-zero by construction on both paths into here — an image
    // segment must be readable or executable, and `map_access` refuses a row
    // that permits nothing — which is what leaves zero free to mean the
    // revocation `remove_grant` spells below.
    hal.prot_update(p as UInt, base, top, perms, device)
}

/// Make process `p`'s recorded domain the LIVE one.
///
/// THE ONE PLACE A DOMAIN IS INSTALLED, reached from exactly two callers: the
/// boot path, once, and the scheduler at a switch that changes process. Reset,
/// replay, commit — the same three steps the loader used to perform inline, now
/// written once so the boot domain and a switched-in domain cannot be programmed
/// differently.
///
/// COST, RECORDED HONESTLY (sawos design 2 D-5, amended by design 27). On
/// Profile A this is about nineteen control-register writes and no
/// translation-buffer work at all. On Profile B it WAS a window reset
/// (1024 + 512 descriptor stores), a regrant walk and a full
/// translation-buffer flush — the order of 1.6k stores per switch. That is
/// retired: Profile B now holds a persistent table set per process and this
/// collapses to ONE register write, because the tables were already brought up
/// to date when the RECORD was edited (`record_grant` / `remove_grant`).
///
/// **THE REPLAY IS THE MPU TIER'S, AND THE HAL SAYS WHICH TIER IT IS.** Design
/// 25 D-2 ruled that replay-at-switch stays MPU-only rather than becoming a
/// permitted MMU implementation — an address-space identifier means nothing if
/// the tables are rebuilt under it — so the loop below is guarded by a HAL
/// constant rather than by anything this file knows. On Profile A it folds to
/// the same three steps it always was; on Profile B it folds away entirely and
/// `prot_switch` is the whole of the switch. This is design 19's doctrine that
/// a tier difference is ADVERTISED and never faked, spelled at the one seam
/// that has to care.
///
/// AUDIT (design 1): NO PREEMPTION POINT, and both HALs say so at their own
/// `prot_reset` — a half-rewritten grant table is exactly an in-flight
/// invariant, and the whole staged sequence is one edit published by
/// `prot_commit`.
public(package) func load_domain(p: Int) unsafe {
    if hal.PROT_REPLAY_AT_SWITCH {
        hal.prot_reset()
        var i: Int = 0
        while i < PROCESSES[p].grant_count {
            let row = PROCESSES[p].grants[i]
            if row.device {
                hal.prot_device(i as UInt, row.base, row.top - row.base)
            } else {
                hal.prot_region(i as UInt, row.base, row.top, row.perms)
            }
            i = i + 1
        }
        hal.prot_commit()
    }
    hal.prot_switch(p as UInt)
    LAST_PROT_PROCESS = p
}

/// Take row `row` out of process `p`'s grant record and COMPACT what is left.
///
/// **COMPACTION IS FORCED BY `load_domain`'s REPLAY-BY-INDEX** (sawos design 6
/// D-3). A row's position is what the hardware sees on one profile — row `i`
/// programs numbered region `i` — so a hole would either install a disabled
/// region in the middle of the set or shift every later row's meaning at the
/// next reload. Shifting them down HERE, once, is the version of that everybody
/// can see; the Mapping slab's stored indices are fixed up beside this call
/// (`compact_mapping_rows`), which is the whole of the index sensitivity the
/// census found.
///
/// The caller has already established that `row` is in range, and it is worth
/// saying HOW: a Mapping's stored index is the `grant_count` `install_row` read
/// immediately before appending its row, and the only thing that has moved one
/// since is a compaction — which is exactly what `compact_mapping_rows` beside
/// this call keeps in step. So the index names a row this record still has.
///
/// **THE REGION IS READ FIRST AND DROPPED LAST** (sawos design 28), and the
/// order is the contract rather than a convenience: taking the row out of the
/// record before dropping the count means the domain has already stopped
/// granting these bytes at the moment they may go back on the pool's free list.
/// The reverse order would let a `Split` hand a range to a new owner while the
/// old one's protection row still reached it.
public(package) func remove_grant(p: Int, row: Int) unsafe {
    // THE ROW IS READ ONCE, and both consumers see that same read: design 28's
    // `region` (dropped last, below) and design 27's hardware revoke (issued
    // first, here). The compaction underneath is about to move this storage, so
    // reading it twice would be two reads of a row in motion.
    let gone = PROCESSES[p].grants[row]
    // REVOKED FROM THE HARDWARE BEFORE THE RANGE CAN MOVE — and that is what
    // makes the paragraph above this function TRUE on a tier whose tables
    // PERSIST (sawos design 27 meeting design 28). Design 28's ordering
    // argument is that the domain has stopped granting these bytes by the time
    // they may reach the pool's free list, and it rests on the ROW LEAVING THE
    // RECORD — which is sufficient exactly where the hardware image is rebuilt
    // from the record at the next switch. Where the tables stand, the record no
    // longer speaks for the hardware, so THIS call is what stops the grant, and
    // it therefore precedes `unref_region_row` rather than merely the
    // compaction. Eagerly for its own reason too: an unmap that waited would be
    // a revocation that did not revoke — the sentence `domain_changed` has
    // always carried. On the MPU tier it is a no-op and the replay is what
    // stops programming the row.
    //
    // A GRANT OF NOTHING IS THE REVOCATION (user ruling, Sep 3): the same call
    // `record_grant` makes, with permissions of zero. It is one operation
    // because on a translating tier it IS one — a non-granted page is still
    // mapped and simply denied to user mode, so removal is the installation of
    // deny — and zero is available to say so because neither door will record a
    // row that permits nothing.
    hal.prot_update(p as UInt, gone.base, gone.top, 0, gone.device)
    var i = row
    while i + 1 < PROCESSES[p].grant_count {
        PROCESSES[p].grants[i] = PROCESSES[p].grants[i + 1]
        i = i + 1
    }
    PROCESSES[p].grant_count = PROCESSES[p].grant_count - 1
    unref_region_row(gone.region)
}

/// **THE LIVE-DOMAIN RULE** (sawos design 6 D-3): any edit to `PROCESSES[p]`'s
/// grant record RELOADS IMMEDIATELY when `p`'s domain is the one in the
/// hardware.
///
/// **IT IS LAW BECAUSE `run_thread` SKIPS EQUAL DOMAINS.** The scheduler
/// reloads only when the process changes, which is what keeps every
/// one-process transcript free of protection work — and it means a grant record
/// edited under the RUNNING process would never be installed at all. Not
/// "installed late": never, for as long as that process keeps the processor.
/// A `map()` would appear to succeed and the memory would still fault; an
/// `unmap()` would return `Ok` and the window would stay open, which is the
/// direction that matters.
///
/// ONE HELPER, BOTH OPS, and the `map_unmap` case is what asserts it end to
/// end: the touch after the unmap FAULTS, which is only true if the reload
/// happened.
///
/// It is a no-op for the common shape — a launcher mapping into a child it has
/// not started — so the cost is one comparison on the path that does not need
/// it.
public(package) func domain_changed(p: Int) unsafe {
    if LAST_PROT_PROCESS == p {
        load_domain(p)
    }
}

/// Forget process `p`'s domain and its rows. Called by the teardown.
///
/// INVALIDATING `LAST_PROT_PROCESS` IS THE PART THAT MATTERS, and the hazard it
/// was written for HAS ARRIVED (sawos design 3 D-3). A dead slot is reclaimed
/// now, as soon as no handle names it, so a new process really can land in this
/// slot — and it would compare EQUAL to a domain that is no longer installed,
/// and the next switch would skip the reload and run it under the dead one's
/// map. Clearing the word here is what makes the reuse safe, and it costs one
/// comparison.
///
/// It is a SEPARATE mechanism from D-1's handle generations rather than a
/// duplicate of one, and the difference is worth keeping straight: a generation
/// stops a stale HANDLE from naming the new occupant, and this stops a stale
/// PROTECTION DOMAIN from being left installed for it. Neither substitutes for
/// the other — the first is about what userspace may name, the second about what
/// the hardware is programmed with.
/// **AND THIS IS WHERE A TEARDOWN RECYCLES** (sawos design 28). Every row this
/// record still holds is a reference on a region, so dropping the record drops
/// them all — and a region whose LAST row goes here, with its handles already
/// closed by the sweep above this call, returns its range to its pool. That is
/// what narrows §2.5's "dropped without unmap = permanent, safe-but-leaked" to
/// "leaked until the TARGET PROCESS's teardown": the bound was always the
/// target's death, and the death now gives the bytes back instead of forgetting
/// them.
///
/// THE COUNT IS ZEROED FIRST, for `remove_grant`'s reason one function up: the
/// rows are gone from the record — nothing replays them, `grant_count` is what
/// says how many there are — before any range can move. The row DATA is left
/// where it lies, which costs nothing and is overwritten by the next grant.
public(package) func clear_domain(p: Int) unsafe {
    let rows = PROCESSES[p].grant_count
    PROCESSES[p].grant_count = 0
    // AND THE STANDING IMAGE GOES WITH THE RECORD (sawos design 27), BEFORE the
    // walk below can return a single range to its pool — the same composition
    // `remove_grant` spells one function up. Zeroing the count above is what
    // stops a REPLAY tier from granting these bytes again; this is what stops a
    // persistent-table one, and the free list is reachable from the next line,
    // so the order is the contract and not a preference.
    //
    // It is also where the slot — and so the address-space identifier the
    // tables are tagged with — becomes reusable, which is why the identifier's
    // cached translations are dropped here. Invalidating `LAST_PROT_PROCESS`
    // below is not enough there: it forces the next SWITCH to reprogram, which
    // is exactly what a persistent-table profile no longer does.
    hal.prot_clear(p as UInt)
    var i: Int = 0
    while i < rows {
        unref_region_row(PROCESSES[p].grants[i].region)
        i = i + 1
    }
    if LAST_PROT_PROCESS == p {
        LAST_PROT_PROCESS = NO_PROCESS
    }
}

// -----------------------------------------------------------------------------
// COPY-OUT: the one door from kernel memory into a process's
// -----------------------------------------------------------------------------
//
// This is SOS's FIRST kernel-writes-userspace path, and it is built as a funnel
// on the first use rather than after the third, because the shape of what
// follows is already known: spec §2.1 has a Pipe `receive` copying a message
// body into the receiver's address space, and that is the same operation with a
// bigger length.
//
// WHAT IT REFUSES, and why each is a FAULT rather than a status (design 178's
// ruling — a caller error the process could have checked ends it):
//
//   - a destination that is not word-aligned. The kernel writes machine words;
//     a misaligned store traps on one profile and is merely wrong on the other,
//     and neither is something to discover at the wake.
//   - a destination outside the process's WRITABLE window. A process asking the
//     kernel to place a record in its own code has misread its own memory map.
//
// A process knows where its own writable memory is — it linked the image — so
// both are caller-checkable in the strongest sense.
//
// **THE DOOR REPORTS; ITS CALLER FAULTS** (sawos design 2). It used to end the
// process itself, which was free while ending a process stopped the machine.
// With more than one process a fault is a SCHEDULING EVENT — somebody else has
// to run next — so the kill lives above the scheduler and these functions answer
// with the `FaultReason` instead. `None` means the buffer is good. Nothing about
// what is checked or what a caller does with the answer changed; only where the
// termination is spelled.
//
// M2 WAS ONE ADDRESS SPACE and that is what made the write a plain copy: the
// writer may be a DIFFERENT thread from the one that asked (a signaller waking
// a parked waiter). With several address spaces the copy is still plain, because
// spec §5.5's contract is that a user address is the same number in every
// process — so what changed is the PERMISSION set, which the kernel is not
// subject to.
//
// **AND THE CONVERSION A TRANSLATING KERNEL NEEDS DID LAND HERE** (sawos design
// 29), exactly where the sentence this paragraph used to end with predicted it:
// these two doors are the only places the kernel dereferences a user address, so
// they are the only places in this module that turn one into a kernel
// dereference. On a tier whose kernel does not run at physical addresses,
// `hal.phys_to_virt` is the arithmetic that gets there; on a tier that has no
// translation at all it is the identity and compiles to nothing. Either way the
// two lines below read the same, which is what keeps this module arch-free.
//
// §5.5 IS UNTOUCHED BY THIS, and a reader could reasonably wonder: it says a
// USER address is the same number everywhere, and it still is — placement is
// design 25's unit 2, not this one. What moved is where the KERNEL stands,
// which §5.5 never spoke about.

/// Validate a destination the kernel is about to write. `None` when it is fine.
///
/// Split out from `copy_out` for exactly one caller: `Waiter.Wait` validates
/// when it PARKS, so that a bad buffer ends the process that supplied it while
/// that process is still the running one, rather than at some later wake in
/// another thread's context. Every other consumer validates and copies in one
/// step, which is what `copy_out` is.
public(package) func copy_out_check(p: Int, dst: UInt, bytes: UInt) unsafe -> FaultReason? {
    if (dst % word_bytes()) != 0 {
        return FaultReason.BadAlign
    }
    if dst < PROCESSES[p].rw_base {
        return FaultReason.BadBuffer
    }
    // Ordered so the subtraction below cannot underflow: `rw_top - dst` is only
    // computed once `dst` is known to be inside the window. A hostile length
    // must produce a diagnostic, not a panic — the loader's own discipline.
    if dst >= PROCESSES[p].rw_top {
        return FaultReason.BadBuffer
    }
    if bytes > PROCESSES[p].rw_top - dst {
        return FaultReason.BadBuffer
    }
    None
}

/// Copy `bytes` from kernel memory at `src` into process `p` at `dst`, unless
/// the destination is refused — in which case NOTHING is written and the reason
/// comes back.
///
/// THE ONE DOOR. Its consumers, current and intended:
///
///   - `Waiter.Wait` (both paths — the ready one and the wake);
///   - the boot-handle iterator's record;
///   - the Interrupt object's wait result, when that lands;
///   - M4's Pipe `receive`, which is §2.1's message body and the reason this
///     is a general copy rather than a record writer.
///
/// Nothing else in the kernel may dereference a user address. That is the whole
/// rule, and it is one function long so it stays checkable by reading.
public(package) func copy_out(p: Int, dst: UInt, src: UInt, bytes: UInt) unsafe -> FaultReason? {
    if let why = copy_out_check(p, dst, bytes) {
        return why
    }
    // **THE ASYMMETRY IS THE WHOLE SEAM** (sawos design 29). `dst` is the
    // PROCESS's address — physical, because user placement is still identity —
    // and the kernel does not run at those addresses any more, so it converts to
    // dereference. `src` is already a kernel address: it comes from a `&var` of
    // a record on this frame, which the linker placed wherever the kernel lives.
    // On an MPU tier `phys_to_virt` is the identity and this line is what it
    // always was.
    copy_bytes(hal.phys_to_virt(dst), src, bytes)
    None
}

// -----------------------------------------------------------------------------
// COPY-IN: the one door from a process's memory into the kernel's
// -----------------------------------------------------------------------------
//
// THE MIRROR TWIN OF `copy_out`, and it is built as a funnel on its first use
// for the same reason that one was: the shape of what follows is already known.
// Spec §2.1 has a Pipe `send` copying a message BODY out of the sender's
// address space, and that is this operation with a bigger length — so design
// 232 unit 1 builds the door, and `Timer.Arm` is its small first consumer
// exactly as `Waiter.Wait` was for copy-out.
//
// WHY AN OP NEEDS IT AT ALL. §5.7 gives an op three argument registers. A
// nanosecond time is 64 bits — anything narrower wraps in four seconds — so
// `arm`'s (first deadline, interval) pair is FOUR words on a 32-bit profile.
// The arguments do not fit, and widening the register convention would widen it
// for every op forever to suit one.
//
// WHAT IT REFUSES, and why each is a FAULT rather than a status (design 178's
// ruling — a caller error the process could have checked ends it):
//
//   - a source that is not word-aligned. Same rule the copy-out door applies,
//     and stated once so a caller learns ONE alignment rule for kernel records
//     rather than one per direction.
//   - a source outside the process's own memory. A process asking the kernel to
//     read a record from an address it does not own has misread its own memory
//     map — and this is the check that stops it naming KERNEL memory, or
//     ANOTHER PROCESS's, which is the whole reason the door exists.
//
// THE WINDOW IS THE WHOLE GRANTED REGION, NOT THE WRITABLE ONE, and the
// asymmetry with `copy_out` is deliberate. A process may legitimately hand the
// kernel a record out of its own RODATA — a constant schedule is exactly the
// thing a driver would write — so demanding a writable source would refuse
// correct programs. The hazard the two doors guard against is not the same one:
// writing outside the writable window CORRUPTS the process, while reading
// outside the granted region READS SOMEBODY ELSE, so each door checks the
// window that answers its own question.

/// Copy `bytes` from process `p` at `src` into kernel memory at `dst`, unless
/// the source is refused — in which case NOTHING is read and the reason comes
/// back.
///
/// THE ONE DOOR INWARD. Its consumers, current and intended:
///
///   - `timer_arm` (design 232 unit 1), the (after, interval) pair;
///   - M4's Pipe `send`, which is §2.1's message body and the reason this is
///     a general copy rather than a record reader.
///
/// Nothing else in the kernel may dereference a user address for reading. That
/// is the whole rule, and it is one function long so it stays checkable by
/// reading.
///
/// **THE INBOUND DOOR'S CHECK, WITHOUT THE COPY** — `copy_out_check`'s twin, and
/// M4 unit 3.5 is what it exists for (sawos design 17).
///
/// The paragraph that used to stand here said no `copy_in_check` was owed,
/// because the split exists for a caller that validates when it PARKS and reads
/// much later, and "no inbound op can have that shape: a copy-in happens while
/// the calling process is still the running one, by construction". THE FUSED
/// `PipeInletOp.Call` IS THE OP THAT BROKE THAT SENTENCE. A `Call` that meets a
/// full ring parks on the inlet's room level (design 10 ruling 8, reached from
/// inside), and the message it has not staged yet is still sitting in the
/// caller's memory — so the copy happens at the RESUME, in whichever context
/// freed the slot, exactly as a wait record's copy-out happens in the waker's.
///
/// So the rule generalizes rather than bending: A DOOR THAT CAN BE USED LATE
/// OWES AN EARLY CHECK, both directions, and the reason is the same one
/// `Waiter.Wait` gives — a bad buffer is the calling process's mistake and
/// terminating it while it is still the running process is both the better
/// diagnostic and the simpler thing to reason about.
///
/// A process's granted region is fixed for its life, so a source that passes
/// here cannot fail later; `pipe_call`'s resume treats a refusal as a kernel
/// invariant broken, exactly as `deliver_wait_record` treats its own.
public(package) func copy_in_check(p: Int, src: UInt, bytes: UInt) unsafe -> FaultReason? {
    if (src % word_bytes()) != 0 {
        return FaultReason.BadAlign
    }
    if src < PROCESSES[p].region_base {
        return FaultReason.BadBuffer
    }
    // Ordered so the subtraction below cannot underflow, exactly as the
    // outbound door orders its own: `region_top - src` is computed only once
    // `src` is known to be inside the region. A hostile length must produce a
    // diagnostic, not a panic.
    if src >= PROCESSES[p].region_top {
        return FaultReason.BadBuffer
    }
    if bytes > PROCESSES[p].region_top - src {
        return FaultReason.BadBuffer
    }
    None
}

public(package) func copy_in(p: Int, dst: UInt, src: UInt, bytes: UInt) unsafe -> FaultReason? {
    if let why = copy_in_check(p, src, bytes) {
        return why
    }
    // The mirror of `copy_out`'s conversion, and the same sentence in the other
    // direction: `src` is the PROCESS's physical address and converts,
    // `dst` is the kernel's own storage and does not. See design 29 there.
    copy_bytes(dst, hal.phys_to_virt(src), bytes)
    None
}

// =============================================================================
// The boot region table, and the Memory objects it mints (sawos design 2 D-2)
// =============================================================================
//
// THE BUILD EMITS A TABLE; THE KERNEL MINTS ONE OBJECT PER ROW AND INTERPRETS
// NOTHING. That is the whole of the ruled hybrid (sawlang#232 agenda item 2):
// the stitcher appends each child image to the boot blob AS IT IS and records
// where things are, the kernel turns each row into a capability, and ROOT's
// config is what says which ordinal is an image and which is a destination.
// A kernel that knew would be a kernel with a launcher inside it.
//
// **ROWS CARRY A KIND SINCE M3 UNIT 4** (sawos design 6 D-5), and that is the
// one thing the kernel now reads out of a row besides its bounds. There are
// three kinds of row in practice and only TWO the kernel distinguishes:
//
//   - a blob region (where an appended image sits, its base resolved by the
//     LINKER) and a free-RAM region (a pool or a child's destination range,
//     assigned in config) are both `kind = Ram` and are INDISTINGUISHABLE here
//     on purpose — the difference is entirely in what root does with them;
//   - a DEVICE row names a peripheral's registers and mints an `IoMemory`
//     rather than a `Memory`, because §2.5's pool attribute is a KIND (D-1) and
//     a kind cannot be inferred from an address the kernel is not allowed to
//     interpret.
//
// That is why the column exists at all: everything else about a row stays the
// build's business, and the kernel still assigns no MEANING to a Ram row.
//
// A MISSING OR EMPTY TABLE IS ZERO REGIONS. That is not a special case, it is
// the ordinary reading of a section the linker script always defines and the
// stitcher usually does not fill — which is what keeps every image built
// without regions booting byte-identically, and the `len == 0` short-circuit
// below is deliberately AHEAD of every header read so that a v1-era image with
// no table is not refused for a version it never wrote.
//
// WIRE LAYOUT (frozen by design 2 D-2 and REVISED by design 6 D-5, fixed-width
// little-endian, the design-47 discipline the sosimg format follows): an 8-byte
// header — magic `u32`, version `u16`, count `u8`, reserved `u8` — then `count`
// rows of `{base: u64, len: u64, kind: u8, reserved × 7}`. The header's size is
// what puts every row on an 8-byte boundary and the row's padding is what keeps
// the NEXT one there, which is what makes the overlay below exact.

/// The region table's header: 8 bytes at the section's start.
///
/// UNCHANGED BY VERSION 2, and pinned so it stays that way: the version field
/// is the first thing a reader needs, so its position is the one part of a
/// versioned format that may never move.
struct RegionTableHeader {
    magic: UInt32,
    version: UInt16,
    count: UInt8,
    reserved0: UInt8,
}

/// WHAT A REGION ROW IS (sawos design 6 D-5) — the table's kind column.
///
/// TWO KINDS, AND THEY ARE §2.5's TWO POOL ATTRIBUTES: RAM is cacheable memory
/// a process runs in, Device is a peripheral's registers. The kernel mints a
/// different OBJECT KIND for each (`Memory` / `IoMemory`), which is D-1's
/// ruling arriving at the one place a window can enter the system.
///
/// Raw-backed, so a reorder cannot renumber them and the read at the boundary
/// is `from(raw:)` — total, so an unrecognized byte is DATA the loader refuses
/// rather than an index it trusts. Refusing is `fatal_image`, like every other
/// malformation in this table: the build wrote it.
enum RegionKind: UInt8 {
    case Ram = 0,
    case Device = 1,
}

/// One row: a range, what kind of memory it is, and room to grow.
///
/// **24 BYTES, SIZE-PINNED**, and the seven reserved bytes are not padding the
/// compiler happened to add — they are declared, so the size is a decision
/// rather than a consequence of field order. What they buy is the next column
/// (a pool identity, an attribute finer than Ram/Device) without a version 3.
struct RegionRow {
    base: UInt64,
    len: UInt64,
    kind: UInt8,
    reserved0: UInt8,
    reserved1: UInt8,
    reserved2: UInt8,
    reserved3: UInt8,
    reserved4: UInt8,
    reserved5: UInt8,
    reserved6: UInt8,
}

// The ABI pin, on the sosimg format's own terms: a layout edit that skews these
// stops the build here instead of misreading a table at boot. They hold on both
// profiles, which is what the field order is arranged to make true.
static_assert(sizeof<RegionTableHeader>() == 8,
              "the region table header must be exactly 8 bytes")
static_assert(sizeof<RegionRow>() == 24,
              "a region table row must be exactly 24 bytes")

/// 'S','R','G','N' as a little-endian word — "SOS regions".
static REGION_TABLE_MAGIC: UInt32 = 0x4E47_5253

/// **VERSION 2** (sawos design 6 D-5). A loader refuses anything it does not
/// know, on the sosimg format's terms: there is no reading of an unknown layout
/// that is safe to guess at, and a v1 row read as a v2 one would take the next
/// row's base as this one's kind.
///
/// THE KERNEL ACCEPTS EXACTLY THIS NUMBER — no v1 compatibility arm — and that
/// is the format's own refuse-unknown rule applied to itself rather than a
/// convenience: v1 never shipped past this tree, and the stitcher and the
/// kernel move in one commit. The compatibility that IS kept is the one that
/// matters to every case in the suite: an image with no table at all reads as
/// zero regions and never reaches this comparison.
static REGION_TABLE_VERSION: UInt16 = 2

/// Overlay the header on the section's first bytes. One view construction, then
/// an ordinary safe struct — the unsafety is confined to this line.
///
/// `addr` is PHYSICAL, as every address the kernel holds as data is; the linear
/// map is where the kernel reaches it (sawos design 29).
func region_header_at(addr: UInt) unsafe -> RegionTableHeader {
    UnsafeMemory<RegionTableHeader, Normal>(hal.phys_to_virt(addr)).read()
}

/// Overlay one row. Same conversion, same reason.
func region_row_at(addr: UInt) unsafe -> RegionRow {
    UnsafeMemory<RegionRow, Normal>(hal.phys_to_virt(addr)).read()
}

/// Parse the region table and mint one Memory per row into process `p`, queuing
/// a boot-handle record for each.
///
/// EVERY REFUSAL IS `fatal_image`, and that is the right vocabulary even though
/// the bytes are not a process image: this table is part of the BOOT IMAGE, it
/// was written by the build that produced this kernel, and a machine whose own
/// boot data is malformed has nothing to run. The other failure vocabulary —
/// `BadImage` as a status — belongs to `process_create`, where the bytes came
/// from a region root handed over at run time.
///
/// AUDIT (design 1): NO PREEMPTION POINT. At most `MAX_MEMORIES` iterations of
/// an O(1) body, and it runs before any thread exists.
func mint_boot_regions(p: Int) unsafe {
    let start = hal.region_table_start()
    let end = hal.region_table_end()
    if end < start {
        fatal_image("region table bounds inverted", start)
    }
    let len = end - start
    let header_len = sizeof<RegionTableHeader>() as UInt
    let row_len = sizeof<RegionRow>() as UInt

    // An image built with no children has an EMPTY section, which is zero
    // regions and not an error. This is the branch every existing case takes.
    if len == 0 {
        return
    }
    if len < header_len {
        fatal_image("region table is shorter than its header", len)
    }

    let header = region_header_at(start)
    if header.magic != REGION_TABLE_MAGIC {
        fatal_image("region table has bad magic", header.magic as UInt)
    }
    if header.version != REGION_TABLE_VERSION {
        fatal_image("region table version is not this build's",
                    header.version as UInt)
    }
    let count = (header.count as UInt)
    // THE BOUND IS BOTH SLABS' — a row mints into one or the other by its kind,
    // and a table larger than the two together could not be minted whichever
    // way the kinds fell. The per-row `alloc_*` refusals below are what catch a
    // table that is small enough overall and lopsided.
    if count > ((MAX_MEMORIES + MAX_IOMEMORIES) as UInt) {
        fatal_image("more boot regions than the kernel can hold", count)
    }
    if count * row_len > len - header_len {
        fatal_image("region table rows run past the section", count)
    }

    var i: UInt = 0
    while i < count {
        let row = region_row_at(start + header_len + i * row_len)
        // The table's fields are 64-bit on both profiles, exactly as sosimg's
        // addresses are and for the same reason. A 32-bit kernel refuses a row
        // it cannot address rather than narrowing one into a low address the
        // build never meant.
        if not fits_word(row.base) || not fits_word(row.len) {
            fatal_image("boot region is past this machine's address space", i)
        }
        // **A ROW'S BASE IS NORMALIZED TO PHYSICAL HERE, ONCE** (sawos design
        // 29), because the rows come from two producers with two readings. A
        // BLOB row's base is a LINKER EXPRESSION — the child section's own
        // symbol, which is the whole point of generating the stub — so on a
        // higher-half kernel it resolves to a link address in the high half. A
        // destination, pool or device row's base is a literal the build wrote,
        // already physical. `virt_to_phys` answers both: masking off bits that
        // are not set changes nothing, so it is IDEMPOTENT on the literal rows
        // and corrective on the linker-resolved ones. It is the identity on
        // every MPU HAL.
        //
        // It has to happen before the base is stored, not at some later
        // dereference, because this base becomes a `Memory`/`IoMemory`
        // capability's — a USER-VISIBLE address that root maps and hands to
        // children, and that ends up as a grant row's bounds in hardware.
        let row_base = hal.virt_to_phys(row.base as UInt)
        // The kind is DATA the build wrote, so it is decoded rather than
        // trusted — `from(raw:)` is total and an unknown byte stops the boot
        // with the number in it, exactly as a bad magic does.
        // The `return` is owed by the language rather than by the logic:
        // `fatal_image` stops the machine but is not declared `-> Never`, so a
        // guard's else block has to exit the scope itself.
        guard let kind = RegionKind.from(raw: row.kind) else {
            fatal_image("boot region has a kind this build cannot name",
                        row.kind as UInt)
            return
        }
        // THE TAG IS THE ROW ORDINAL and nothing else — root's config is what
        // gives it a meaning. **THE KERNEL IS THE GIVER NOBODY GAVE TO** (sawos
        // design 4 D-2): this writes root's boot record through exactly the
        // machinery `ProcessOp.Give` writes a child's, into root's own
        // per-process set, so the two producers are one and the drain cannot
        // tell them apart.
        if not boot_handle_room(p) {
            fatal_image("no boot-record room for the boot regions", i)
        }
        // **TWO KINDS OF ROW, TWO KINDS OF OBJECT** (sawos design 6 D-5), and
        // the arms are deliberately symmetrical: the same range becomes a
        // different CAPABILITY depending on one byte the build wrote, which is
        // the whole of what the kind column buys.
        match kind {
            case Ram -> {
                let slot = alloc_memory()
                if slot == NO_MEMORY {
                    fatal_image("out of Memory slots for the boot regions", i)
                }
                // `refs: 1` IS THE MINT BELOW, WRITTEN AT THE SLOT (sawos
                // design 7 D-1). A boot region is created with exactly one
                // handle onto it, so the count starts at one rather than being
                // incremented afterwards — a fresh slot's reference is not a
                // change to a count, it IS the count.
                // **A BOOT REGION IS A POOL ROOT, AND A ROOT NAMES ITSELF**
                // (sawos design 28). This is the one place a pool is created:
                // every other region in the system is a `Split` off one of
                // these and carries this slot's index down the chain, which is
                // what "return to ROOT" is made of. The ledger starts empty —
                // nothing lent, nothing free but the cursor, nothing dropped.
                MEMORIES[slot] = MemorySlot(state: SlotState.Live, process: p,
                                            base: row_base,
                                            len: row.len as UInt,
                                            refs: 1, maps: 0, root: slot,
                                            free_head: 0, out_bytes: 0,
                                            dropped: 0)
                let handle = mint_handle(p, ObjType.Memory, memory_rights(), slot)
                if handle == NO_HANDLE {
                    fatal_image("no handle table room for the boot regions", i)
                }
                quota_charge(p, QuotaKind.Memory)
                queue_boot_handle(p, i, BootHandleKind.Memory, handle)
            },
            case Device -> {
                let slot = alloc_iomemory()
                if slot == NO_IOMEMORY {
                    fatal_image("out of IoMemory slots for the boot regions", i)
                }
                IOMEMORIES[slot] = IoMemorySlot(state: SlotState.Live, process: p,
                                                base: row_base,
                                                len: row.len as UInt,
                                                refs: 1)
                let handle = mint_handle(p, ObjType.IoMemory, iomemory_rights(),
                                         slot)
                if handle == NO_HANDLE {
                    fatal_image("no handle table room for the boot regions", i)
                }
                quota_charge(p, QuotaKind.IoMemory)
                queue_boot_handle(p, i, BootHandleKind.IoMemory, handle)
            },
        }
        i = i + 1
    }

    let uart = console()
    uart.write_str("SOS: boot regions=")
    uart.write_hex(count)
    uart.write_str("\n")
}

/// Can THIS build's machine word hold `v`?
///
/// `imgformat.fits_target_word` says the same thing about a sosimg field; this
/// is the region table's own copy of the question because the table is sawos's
/// format rather than the shared image format, and the two must be free to
/// version apart. It folds to a constant `true` on a 64-bit profile.
func fits_word(v: UInt64) -> Bool {
    if sizeof<UInt>() >= 8 {
        return true
    }
    v <= 0xFFFF_FFFFu64
}

// =============================================================================
// Into user mode
// =============================================================================

/// Reify a user-mode program as a Process with one Thread, mint its boot handle
/// set, and run it. Never returns.
///
/// THE ONLY WAY INTO USER MODE FOR THE FIRST PROCESS. The loader reaches it with
/// a root image's entry and region; the harness kernels that grant a
/// hand-written payload its own bytes reach it with theirs. A CHILD does not
/// come through here — `ProcessOp.Start` makes a thread and lets the scheduler
/// pick it up, because by then there is a scheduler to return to and a process
/// already running that must not be displaced.
///
/// `let p = ROOT_PROCESS` IS STILL EXACTLY RIGHT with two process slots, and the
/// comment is the point of this line: the kernel loads exactly ONE image (§12),
/// it lands in slot 0, and every later process is created by root through
/// `process_create` — which allocates its own slot. This is not a
/// one-process leftover; it is the statement that root is process 0.
///
/// The three handles are minted in an order the boot ABI depends on: System
/// first, so that it comes out as `ROOT_SYSTEM_HANDLE` and the register the
/// program receives means what §12 says it means. The other two are not passed
/// anywhere — the program asks for them — so their numbers are the kernel's
/// business and stay that way. THE BOOT REGIONS COME AFTER ALL THREE, for the
/// same reason and in the same spirit: they are collected rather than passed
/// (`ProcessOp.BootHandleNext`), so the entry register stays one handle wide.
///
/// `rw_base`/`rw_top` DEFAULT TO NONE, and that default is the right answer
/// rather than a convenience: the harness kernels that grant a hand-written
/// payload its own bytes grant them read+execute, so those processes have
/// nowhere the kernel may write and should be told so if they ask. Only the
/// loader, which grants a data segment and a stack, passes a window.
public func start_process(entry: UInt, stack_top: UInt,
                          region_base: UInt, region_top: UInt,
                          rw_base: UInt = 0, rw_top: UInt = 0) unsafe -> Never {
    let p: Int = ROOT_PROCESS

    // FIELD BY FIELD RATHER THAN A WHOLE-SLOT LITERAL, because the GRANT RECORD
    // is already there: the loader records root's rows as it places them, and a
    // struct literal here would erase them on the way past.
    PROCESSES[p].state = ProcessState.Running
    PROCESSES[p].entry = entry
    PROCESSES[p].stack_top = stack_top
    PROCESSES[p].region_base = region_base
    PROCESSES[p].region_top = region_top
    PROCESSES[p].rw_base = rw_base
    PROCESSES[p].rw_top = rw_top
    PROCESSES[p].exit_kind = ProcessStatusKind.Running
    PROCESSES[p].exit_code = 0
    PROCESSES[p].refs = 0
    // **THE COLUMNS OPEN AT ZERO** (sawos design 16). Root is reified HERE
    // rather than through `process_create`, so its columns are zeroed here too —
    // and the number that matters is what the zero MEANS: the boot-door traps a
    // harness kernel takes before this line are unattributed by `ktrap`, so
    // nothing has been counted against slot 0 yet and this is a statement rather
    // than a discard.
    PROCESSES[p].syscalls = 0
    PROCESSES[p].interrupts = 0
    PROCESSES[p].faults = 0

    // **THE LEDGER OPENS BEFORE THE FIRST MINT** (sawos design 7 D-3), because
    // `mint_handle` consults the handle row and a slot with no limits installed
    // can allocate nothing. Root's rows are `QUOTA_UNLIMITED` — root is init and
    // its policy cap IS the machine, so the SLAB is what refuses it — with the
    // one exception the mapping row is: it is clamped to the rows root's domain
    // still has after the loader spent its image's, which is what makes
    // `install_row`'s kernel-bug `fatal` unreachable.
    //
    // The loader has already recorded root's grant rows by this line, which is
    // why the free-row count can be read here at all.
    install_quota_limits(p, true,
                         (hal.GRANT_ROW_BUDGET as Int) - PROCESSES[p].grant_count)

    // §12's ORDER IS THE CONTRACT and it is unchanged by design 3: these three
    // are minted into a virgin table, so each lands at generation 0 and D-1's
    // rule makes its word the bare index — 1 = System, 2 = Process, 3 = Thread,
    // exactly what root and the hand-assembled payloads have always been handed.
    // The two that are not passed anywhere are minted so that root's own Process
    // and its main Thread OCCUPY those indices; nothing reads the words back
    // (`ProcessSelf` and `ThreadSelf` mint their own now, D-4), which is why
    // neither is bound to a name here.
    let system = mint_handle(p, ObjType.System, root_system_rights(), 0)
    let _ = mint_handle(p, ObjType.Process, process_rights(), p)
    // ROOT'S OWN PROCESS HANDLE IS A REFERENCE TO ROOT'S SLOT, counted like any
    // other (sawos design 7 D-1). It is what makes root's count start at one
    // rather than at zero, and the teardown's own check is what reads it back.
    PROCESSES[p].refs = PROCESSES[p].refs + 1

    let main = alloc_thread()
    let _ = mint_handle(p, ObjType.Thread, thread_rights(), main)
    THREADS[main] = ThreadSlot(state: ThreadState.Running, process: p,
                               exit_code: 0,
                               joiners: 0, link: 0, wait_buf: 0,
                               call_pipe: 0, call_claim: 0, call_src: 0,
                               call_len: 0)
    quota_charge(p, QuotaKind.Thread)
    CURRENT_THREAD = main
    SLICE_LEFT = SLICE_TICKS

    if system != ROOT_SYSTEM_HANDLE {
        fatal_image("the boot handle set did not start at the System handle",
                    system)
    }

    mint_boot_regions(p)

    // The domain this process runs under is INSTALLED, and the scheduler is
    // told so: the boot path grants directly (the loader recorded the rows as
    // it placed the segments), so the first switch must not reload what is
    // already live. A harness kernel that programmed `prot_*` itself records no
    // rows, and with one process the comparison never comes up again.
    LAST_PROT_PROCESS = p

    // THE HANDOVER MARKER — the last thing the kernel says on its own
    // initiative, and the line a transcript reads everything after as the
    // PROCESS's. See `Console` for the protocol it announces.
    console().write_str("SOS: console handover\n")

    hal.frame_init(frame_slot(main), entry, stack_top, system)
    // `resume_frame` is `-> Never`: it enters the process and the kernel is
    // only ever re-entered through a trap. That is this function's divergence.
    hal.resume_frame(frame_slot(main))
}
