//! The console, and the ways a run ends badly.
//!
//! The formatting half of a diagnostic (a string one scalar at a time, a
//! machine word as fixed-width hex) plus the reports that stop the machine:
//! `fatal` for a trap the kernel cannot survive, `fatal_kernel` for a broken
//! kernel invariant and `fatal_image` for a root image it refuses to boot.
//!
//! It calls nothing in the kernel, which is what lets every other seam report.
//! The reports that tear a process down are not here: they own kernel state and
//! live in `sched`. The difference is whether there is anything left to clean
//! up.

import hal
import sosrt.{ascii_byte, hex_digit_of, hex_digits_per_word}

/// The kernel's console: the arch-free half of writing a diagnostic.
///
/// It formats (a string one scalar at a time, a machine word as fixed-width
/// hex) and hands each byte to the HAL, which knows what device it is.
/// `write_hex` is the same code on every target; only where the byte lands
/// differs.
///
/// # The UART handover protocol
///
/// There is one console UART and both the kernel and a driver process can drive
/// it. Unstated, that is a flaky-test mystery: two writers on one device
/// interleave mid-word and nothing in either is wrong. Ownership has three
/// phases:
///
///   1. **Boot.** The kernel owns the device outright. It narrates the banner,
///      the image, and anything that goes wrong.
///   2. **Handover.** `start_process` writes one marker line, `SOS: console
///      handover`, as the last thing the kernel says on its own initiative.
///      After it, the process owns the device.
///   3. **Reclaim, on diagnostics only.** The kernel writes again exactly where
///      the run has already failed or ended: a fault report, a process
///      teardown, a panic, or an interrupt on a line nothing is bound to. The
///      interleaving those may cause is acceptable because there is no longer a
///      transcript to protect.
///
/// What the kernel writes on demand does not violate this: a
/// `SystemOp.DebugPrint` is the process asking the kernel to place a byte, and
/// the process sequences it. The protocol forbids the kernel narrating over a
/// process that is using the device.
///
/// A kernel that arms a timer is the one bounded exception: `TICK_REPORT_LIMIT`
/// ticks are narrated after handover before the tick path goes quiet. That is
/// why the preemption case does not assert its root's banner, and why a case
/// whose transcript matters after handover arms no timer.
///
/// The device half (which registers, and what a second writer does to them) is
/// stated in each HAL's console section.
public struct Console {
    /// A console is a capability to write, not a device handle: the HAL owns
    /// the device. The field records which sink the writes go to (there is
    /// one), since a zero-field struct has no reason to exist either.
    sink: UInt8,
}

extension Console {
    /// Write one byte.
    func write_byte(&self, b: UInt8) {
        hal.console_byte(b)
    }

    /// Write an ASCII string, byte by byte. The scalar-to-byte rule is
    /// `sosrt`'s, so the kernel console and a process console agree on what a
    /// non-ASCII scalar becomes.
    ///
    /// No preemption point, and this is the one verdict that accepts latency
    /// rather than arguing it away. The loop is bounded by the device drain, so
    /// a long diagnostic line is masked latency. Two reasons not to point it:
    /// half of this module's callers are the fault reports, which run with the
    /// kernel's state already deliberately inconsistent; and a delivery here
    /// would interleave the tick path's own console output into the middle of
    /// the line being written, into the transcript the acceptance oracle diffs.
    public func write_str(&self, msg: String) {
        for scalar in msg.scalars() {
            hal.console_byte(ascii_byte(scalar))
        }
    }

    /// Write a machine word as `0x` + one hex digit per nibble. No allocation,
    /// no formatting machinery.
    ///
    /// The width is the target's word, not a constant: eight digits on a 32-bit
    /// target and sixteen on a 64-bit one. A fixed eight would print the low
    /// half of a 64-bit address and look like a complete answer.
    public func write_hex(&self, v: UInt) {
        self.write_str("0x")
        let digits = hex_digits_per_word()
        var n = 0
        while n < digits {
            hal.console_byte(hex_digit_of(v, n))
            n = n + 1
        }
    }
}

/// A console for this board. Constructing one costs nothing.
public func console() -> Console {
    Console(sink: 0)
}

/// Exit codes the kernel reports through the platform's failure channel,
/// distinct from any status root chooses for itself.
///
/// A type rather than a family of `UInt`s so `fatal` cannot be handed an
/// arbitrary number: the kernel's failure vocabulary is closed, and the harness
/// asserts on these values.
///
/// 3 is deliberately absent. The values are per-case, so a gap costs nothing,
/// and reusing a retired number would make unrelated transcripts read alike.
public enum ExitCode: UInt {
    case UmodeFault = 2,
    case BadImage = 4,
    case ProcessFault = 5,
    /// The kernel found its own invariant broken: a state the kernel's own
    /// rules say cannot exist. Not a process's mistake and not the build's. It
    /// is a separate number from `BadImage` because the two say opposite things
    /// about who is at fault.
    case KernelBug = 6,
}

// =============================================================================
// Fault reporting
// =============================================================================

/// Report a fatal condition on the console and fail the run. Never returns: a
/// fault is diagnosed and the machine stops non-zero, never a hang.
public func fatal(tag: String, cause: UInt, epc: UInt, tval: UInt, code: ExitCode) {
    let uart = console()
    uart.write_str("SOS: fault ")
    uart.write_str(tag)
    uart.write_str(" cause=")
    uart.write_hex(cause)
    uart.write_str(" epc=")
    uart.write_hex(epc)
    uart.write_str(" tval=")
    uart.write_hex(tval)
    uart.write_str("\n")
    hal.exit_fail(code as UInt)
}

/// Stop: the kernel broke its own invariant. Never returns.
///
/// The line between the three failure vocabularies is whose mistake it was. A
/// caller error ends the process (`fault_process`); a malformed boot image ends
/// the machine as `fatal_image`, because the build wrote those bytes; and this
/// one ends the machine because the kernel reached a state its own rules say is
/// unreachable. Reporting it as either of the others would blame somebody who
/// did nothing wrong.
///
/// Examples: a `map()` that meets the physical row wall with quota headroom
/// left (`install_quota_limits` is what makes it unreachable), and a
/// `free_object` reaching a kind that has no slab to free into.
public func fatal_kernel(reason: String, detail: UInt) {
    let uart = console()
    uart.write_str("SOS: kernel bug: ")
    uart.write_str(reason)
    uart.write_str(" (")
    uart.write_hex(detail)
    uart.write_str(")\n")
    hal.exit_fail(ExitCode.KernelBug as UInt)
}

/// Reject the root image. Never returns.
public func fatal_image(reason: String, detail: UInt) {
    let uart = console()
    uart.write_str("SOS: bad root image: ")
    uart.write_str(reason)
    uart.write_str(" (")
    uart.write_hex(detail)
    uart.write_str(")\n")
    hal.exit_fail(ExitCode.BadImage as UInt)
}
