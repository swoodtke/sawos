/// An IoMemory handle the dispatch has validated, paired with its rights and
/// the window slot it names (spec §2.5).
///
/// This is a separate wrapper from `MemoryObject`, not a flag on one: a
/// function that takes one of these can only have been handed a device window,
/// so "a Device region cannot produce a cacheable mapping" is a fact about
/// which `allows` compiles rather than a check somebody runs.
public(package) struct IoMemoryObject {
    public(package) handle: IoMemoryHandle,
    public(package) rights: UInt32,
    public(package) slot: Int,
}

extension IoMemoryObject {
    public(package) func allows(&self, right: IoMemoryRight) -> Bool {
