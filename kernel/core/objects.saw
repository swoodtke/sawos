/// A PipeInlet handle the dispatch has VALIDATED, paired with its rights and the
/// CONNECTION slot it names (spec §2.1; sawos design 13).
///
/// **`slot` NAMES THE CONNECTION, NOT AN ENDPOINT**, which is D-1's one slab
/// seen from the dispatch: both endpoint kinds target the same `PIPES` row, and
/// what makes this handle the CLIENT end is its `obj_type` — established by §3's
/// order before any right is read. Which reference column it counts on, which op
/// table it answers to and which rights enum its word is read against all follow
/// from that one fact.
public(package) struct PipeInletObject {
    public(package) handle: PipeInletHandle,
    public(package) rights: UInt32,
    public(package) slot: Int,
}

extension PipeInletObject {
    public(package) func allows(&self, right: PipeInletRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// A PipeOutlet handle the dispatch has VALIDATED, paired with its rights and
/// the CONNECTION slot it names (spec §2.1; sawos design 13).
///
/// A SEPARATE WRAPPER AND NOT A FLAG, exactly as `IoMemoryObject` is separate
/// from `MemoryObject`: a function taking one of these can only ever have been
/// handed the server end, so "an inlet cannot take and an outlet cannot post" is
/// a fact about which `allows` compiles rather than a check somebody runs.
public(package) struct PipeOutletObject {
    public(package) handle: PipeOutletHandle,
    public(package) rights: UInt32,
    public(package) slot: Int,
}

extension PipeOutletObject {
    public(package) func allows(&self, right: PipeOutletRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// A PipeReply handle the dispatch has VALIDATED — the CLIENT's claim on one
/// reply, paired with the EXCHANGE it names (spec §2.1; sawos design 14 D-1).
///
/// **`slot` NAMES AN EXCHANGE, WHICH IS A RING SLOT** — `connection *
/// PIPE_INFLIGHT + ring index`, the same flat arithmetic the bodies and lengths
/// already use. That is D-1's "the claim IS ring-slot state" seen from the
/// dispatch: there is no third slab, because a one-shot pair exists for exactly
/// as long as one in-flight message does.
public(package) struct PipeReplyObject {
    public(package) handle: PipeReplyHandle,
    public(package) rights: UInt32,
    public(package) slot: Int,
}

extension PipeReplyObject {
    public(package) func allows(&self, right: PipeReplyRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// A PipeRequest handle the dispatch has VALIDATED — the SERVER's obligation,
/// paired with the EXCHANGE it names (spec §2.1; sawos design 14 D-1).
///
/// The mirror of `PipeReplyObject`, and separate for `PipeOutletObject`'s reason:
/// a function taking one of these can only ever have been handed the obligation,
/// so "a claim cannot reply and an obligation cannot resolve" is a fact about
/// which `allows` compiles.
public(package) struct PipeRequestObject {
    public(package) handle: PipeRequestHandle,
    public(package) rights: UInt32,
    public(package) slot: Int,
}

extension PipeRequestObject {
    public(package) func allows(&self, right: PipeRequestRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// Whether an Event or a Waiter slot is in use.
///
/// ONE enum for both because it really is one question. Threads and processes
/// have state MACHINES — a thread is created, then runnable, then running, then
/// blocked or exited, and a join arriving after the exit still has to find the
/// code — while an Event and a Waiter are either there or not: an Event's whole
/// state is its accumulated word, and a Waiter's is its two lists.
public(package) enum SlotState: UInt8 {
    case Free = 0,
    case Live = 1,
}

/// Every process's handle table, back to back: process `p`'s handle INDEX `i`
/// (0-based inside the table) lives at `p * MAX_HANDLES + i`, and the word a
/// process holds carries `i + 1` in its low byte (§3's "handle 0 names
/// nothing").
///
/// Generations start at zero, which is what makes a fresh slot's first word the
/// bare index — D-1's compatibility rule, and the reason §12's boot order still
/// hands root 1, 2, 3.
public(package) unsafe static var HANDLES: [HandleEntry; MAX_PROCESSES * MAX_HANDLES] = [
    HandleEntry(obj_type: ObjType.Unbound, rights: 0, target: 0, gen: 0);
    MAX_PROCESSES * MAX_HANDLES]

// -----------------------------------------------------------------------------
// The handle table (spec §3) and the split word (sawos design 3 D-1)
// -----------------------------------------------------------------------------

// THE TABLE MUST FIT THE INDEX FIELD, and this is the module that knows both
// numbers — `sosabi` owns the encoding and `kcore.limits` owns the table size,
// so the bound tying them belongs here rather than in either.
//
// The comparison is `<=` because the field carries a 1-BASED index: the largest
// value it must hold is `MAX_HANDLES` itself (naming slot `MAX_HANDLES - 1`),
// not `MAX_HANDLES - 1`. Zero is spent on "names nothing", which is the whole
// reason the index is 1-based, so a field of `HANDLE_INDEX_BITS` bits addresses
// `HANDLE_INDEX_MASK` slots and no more.
//
// Raising `MAX_HANDLES` past what the field can hold fails the build here rather
// than silently aliasing slot 1 onto slot 257.
static_assert(MAX_HANDLES <= (1 << HANDLE_INDEX_BITS) - 1,
              "MAX_HANDLES must fit the handle word's index field — raise HANDLE_INDEX_BITS")

/// The Unbound answer — what a word that resolves to nothing looks like.
///
/// One constructor rather than three literals, because `lookup_handle` has
/// three ways to reach it and a reader should be able to see that they are the
/// SAME answer: the callers turn it into one `BadHandle` fault, so a difference
/// between them would be a difference with no observer.
func unbound_entry() -> HandleEntry {
    HandleEntry(obj_type: ObjType.Unbound, rights: 0, target: 0, gen: 0)
}

/// The 0-based table index a handle word names, or a number past `MAX_HANDLES`
/// when it names none.
///
/// **THE INDEX FIELD IS 1-BASED, so zero is not an index** — that is the whole
/// of "handle 0 names nothing", and it is why it survives generations.
/// `NO_HANDLE` is the index field's zero AT EVERY GENERATION, so a malformed
/// word like `0x100` (generation 1 over a zero index, at the default split)
/// names nothing exactly as a plain `0` does. Testing the WORD against
/// `NO_HANDLE` would have missed that one; testing the FIELD cannot. The 1-based
/// spelling is also what keeps slot 0 usable and generation 0 free to mean
/// "first life".
///
/// Answering `MAX_HANDLES` for a zero byte rather than a separate signal is
/// deliberate: the one range test below covers both refusals, so there is one
/// place that decides what a word can name.
///
/// `public(package)` for exactly one caller: the release op, which has a word
/// and a resolved entry and needs the INDEX to unbind. It gets it from the same
/// function `lookup_handle` used, so the two can never disagree about which slot
/// a word names.
public(package) func handle_word_index(word: UInt) unsafe -> Int {
    let byte = word & HANDLE_INDEX_MASK
    if byte == 0 {
        return MAX_HANDLES
    }
    (byte as Int) - 1
}

/// The generation a handle word claims — everything above its index field.
///
/// **IT IS NOT NARROWED AND NOT MASKED**, and both are deliberate. Narrowing to
/// `UInt32` with `as` would PANIC INSIDE THE KERNEL on a 64-bit profile over a
/// word a PROCESS chose, which is the one thing a decode at the trap boundary
/// must never do. Masking to 24 bits would be worse than a panic: it would make
/// a word with garbage above bit 31 compare EQUAL to a low generation and
/// RESOLVE, quietly handing out somebody's handle.
///
/// Answering the whole field in the word's own width instead makes the
/// comparison in `lookup_handle` do the range check for free: a stored
/// generation is always below `HANDLE_GENERATION_MODULUS`, so any word claiming
/// a wider generation than the portable budget allows equals no entry and names
/// nothing. That is D-1's "the top half of a 64-bit word stays zero" as an
/// ENFORCED rule rather than an assumed one.
func handle_word_generation(word: UInt) unsafe -> UInt {
    word >> HANDLE_INDEX_BITS
}

/// Build the word for slot index `i` at generation `gen`.
///
/// `gen == 0` yields the bare 1-based index, which is D-1's load-bearing
/// compatibility rule: a slot's first-life word is what it always was.
func handle_word(index: Int, gen: UInt32) unsafe -> UInt {
    ((gen as UInt) << HANDLE_INDEX_BITS) | ((index as UInt) + 1)
}

/// Resolve a handle in a process's table.
///
/// An out-of-range, unbound or STALE handle resolves to `ObjType.Unbound`, and
/// the rights travel WITH the entry rather than being assumed by the op — the
/// two properties the M1 version already had, now over a real table with
/// generations.
///
/// THREE WAYS TO NAME NOTHING and one answer for all of them: a word whose index
/// byte is not an index (zero at any generation, or past the table), a slot that
/// holds no binding, and a slot whose GENERATION has moved on since this word
/// was handed out. The third is design 3 D-1's whole purpose — a word from a
/// released handle points at a live slot with the wrong life, and the caller's
/// `BadHandle` fault is the diagnosis.
public(package) func lookup_handle(p: Int, h: UInt) unsafe -> HandleEntry {
    let index = handle_word_index(h)
    if index >= MAX_HANDLES {
        return unbound_entry()
    }
    let entry = HANDLES[p * MAX_HANDLES + index]
    match entry.obj_type {
        case Unbound -> unbound_entry(),
        case _ -> {
            if (entry.gen as UInt) != handle_word_generation(h) {
                return unbound_entry()
            }
            entry
        },
    }
}

/// Mint a handle naming `target` of kind `kind` with `rights`, in process `p`'s
/// table. Returns `NO_HANDLE` when the table is full — an exhaustion the caller
/// could not have known about, which is what a status is for.
///
/// LOWEST FREE INDEX WINS, which is what makes a released slot the one the next
/// mint reuses — the property `handle_remint` observes. The word it stamps
/// carries the slot's SURVIVING generation, so the reuse is visible in the word
/// and the old word is stale rather than aliasing.
///
/// **THE HANDLE ROW IS CHARGED HERE, POLICY BEFORE THE TABLE** (sawos design 7
/// D-3). A process at its handle budget is refused before the table is walked,
/// which is the check order every other allocation site follows spelled inside
/// the allocator instead of beside it — `mint_handle` is the only one whose
/// "slab" is a region of a per-process table, so there is no second scan for a
/// caller to order against. The two refusals share `NO_HANDLE`, and
/// `mint_refusal` is what tells them apart for the status.
public(package) func mint_handle(p: Int, kind: ObjType, rights: UInt32, target: Int) unsafe -> UInt {
    if not quota_room(p, QuotaKind.Handle) {
        return NO_HANDLE
    }
    var h: Int = 0
    while h < MAX_HANDLES {
        let entry = HANDLES[p * MAX_HANDLES + h]
        match entry.obj_type {
            case Unbound -> {
                HANDLES[p * MAX_HANDLES + h] = HandleEntry(obj_type: kind,
                                                           rights: rights,
                                                           target: target,
                                                           gen: entry.gen)
                quota_charge(p, QuotaKind.Handle)
                return handle_word(h, entry.gen)
            },
            case _ -> {},
        }
        h = h + 1
    }
    NO_HANDLE
}

/// **CAN `p`'s TABLE ACCEPT `n` MORE ENTRIES, BOTH BY POLICY AND BY THE
/// TABLE?** — the rendezvous's atomic pre-flight (`designs/010` ruling 5; sawos
/// design 18).
///
/// It asks `mint_handle`'s two questions `n` times over, without answering
/// either: the quota first (policy before the table, the check order every
/// allocation site follows) and then a bounded count of the free slots. A take
/// or a delivery that carries handles calls this ONCE, before it moves anything,
/// so a refusal leaves the staged message exactly where it was and the level it
/// raised still raised — free a slot, ask again, and the same message arrives.
///
/// **IT COUNTS RATHER THAN RESERVING**, which is `pipe_has_room`'s own argument
/// one table over: a reservation would have to be given back on every path that
/// does not use it, and the caller is inside a single syscall with interrupts
/// masked, so nothing can take a slot between the count and the mints.
public(package) func table_room(p: Int, n: Int) unsafe -> Bool {
    if not quota_room_for(p, QuotaKind.Handle, n) {
        return false
    }
    var free: Int = 0
    var h: Int = 0
    while h < MAX_HANDLES {
        match HANDLES[p * MAX_HANDLES + h].obj_type {
            case Unbound -> { free = free + 1 },
            case _ -> {},
        }
        h = h + 1
    }
    free >= n
}

/// Unbind the entry at index `i` of process `p`'s table and BUMP its generation.
///
/// THE ONE PLACE A BINDING IS DESTROYED — the release op and the teardown's
/// close-all both come through here, which is what makes "release and teardown
/// do the same thing to a slot" a fact rather than two implementations that
/// agree today. It NEVER touches the object the entry named: an object whose
/// last handle is gone is unreachable-but-live until its process's teardown,
/// which is the close-all's own long-standing precedent (design 3 D-2). The one
/// exception is a Gone process's slot, and it is decided by the caller, above
/// this line.
///
/// The generation WRAPS at 2^24 rather than saturating, and the wrap is the
/// documented limit of the mechanism: after 2^24 reuses of one slot a word can
/// alias again. That is best-effort bug detection working as ruled, not a hole
/// to close with unbounded bookkeeping — the table is per-process, so a wrap
/// collision crosses no boundary and grants nothing.
public(package) func unbind_handle(p: Int, index: Int) unsafe {
    let entry = HANDLES[p * MAX_HANDLES + index]
    let next = (entry.gen + 1) % HANDLE_GENERATION_MODULUS
    HANDLES[p * MAX_HANDLES + index] = HandleEntry(obj_type: ObjType.Unbound,
                                                   rights: 0, target: 0,
                                                   gen: next)
    // THE HANDLE ROW IS CREDITED HERE, at the one place a binding is destroyed
    // — which is what makes the entry count and the quota count the same fact
    // rather than two that agree today (sawos design 7 D-3).
    quota_credit(p, QuotaKind.Handle)
}

// =============================================================================
// THE QUOTA LEDGER (spec §12's promise; sawos design 7 D-3)
// =============================================================================
//
// **PER-PROCESS STORAGE, SO IT LIVES WHERE THE PER-PROCESS STORAGE LIVES.**
// §12 promised "a field on the process slot", and this is that promise kept one
// module down, for a reason the module order decides rather than taste: the
// HANDLE row has to be charged inside `mint_handle` and credited inside
// `unbind_handle`, which are here, and `kcore.process` sits ABOVE this file —
// so a table on `ProcessSlot` could not be reached from the two functions that
// most need it, and the alternative was a second funnel over "the one place a
// binding is destroyed". The flat `p * QUOTA_KINDS + kind` array is the handle
// table's own idiom, one file down from where the boot-handle queue uses it,
// which is the shape this module already has for per-process storage.
// `ProcessSlot`'s docstring points here.
//
// **TWO ROWS PER KIND: what is spent, and what may be.** A charge happens at
// the allocation sites that answer `NoResource` today, ordered POLICY FIRST —
// the quota is asked before the machine is, so a process at its budget is told
// whose limit it met. A credit happens where the thing is actually returned:
// `free_object` for the refcounted kinds, `Unmap` for the mapping ROW, and the
// teardown for everything at once.
//
// **NOTHING HERE IS INDEXED BY `ObjType`**, deliberately. The kinds with a
// budget are not the kinds with a slab — a Clock is kernel-eternal and owned by
// nobody, a System object is a singleton, and HANDLES are counted though they
// have no slab at all — so this is its own closed set, and adding a case fails
// `install_quota_limits` to compile until somebody says what a child may hold
// of it.

/// What a process may be charged for (sawos design 7 D-3).
///
/// Raw-backed and dense from zero, because the value IS the column index in the
/// two arrays below — the same "the slot is the ordinal" arrangement `ClockType`
/// uses, and the reason no lookup table is owed.
///
/// **`Handle` IS THE KIND WITH NO SLAB**, and that is why it is here rather
/// than derived: a handle entry lives in the per-process table region, so the
/// thing that bounds it is this row and nothing else. It is design 3's promised
/// addition, arriving with the rest of the ledger.
///
/// **`Mapping` COUNTS INSTALLED ROWS, NOT OBJECTS**, and it is the one row in
/// this enum that does. D-3 rules that a mapping charges its TARGET, because
/// the scarce thing it consumes is that process's grant-row budget — and the
/// row budget is what a `map` can physically meet, so a ledger that counted
/// Mapping OBJECTS would drift from it the moment a mapped Mapping's last
/// handle went away (D-2 frees the slot and LEAVES the row). Counting rows
/// keeps `used` and the target's `grant_count` exactly in step, which is what
/// makes `install_row`'s `fatal` provably unreachable rather than merely
/// unlikely. `Thread` is the mirror asymmetry from the other side: it has a
/// slab and no refcount, so its row is charged and only ever credited by the
/// teardown.
/// **`Pipe` IS M4 UNIT 1's ROW, AND IT IS CREATOR-PAYS FOR A CONNECTION RATHER
/// THAN FOR AN ENDPOINT** (sawos design 10 ruling 6; design 13 D-1). One charge
/// at `ProcessOp.PipeCreate`, credited when BOTH reference columns reach zero
/// and the connection's slot goes back — which is the only moment the scarce
/// thing it counts (a `PIPES` row and its staging ring) is actually returned.
///
/// **CHARGING THE PAIR ONCE IS THE POINT.** Two ends of one connection are two
/// handle entries, and the HANDLE row already counts those; a second charge per
/// endpoint would make a launcher that keeps both ends pay twice for one slab
/// slot, and would make "give one end away" look like a refund. What the ledger
/// tracks is what the slab holds.
public(package) enum QuotaKind: UInt8 {
    case Thread = 0,
    case Event = 1,
    case Waiter = 2,
    case Interrupt = 3,
    case Timer = 4,
    case Memory = 5,
    case IoMemory = 6,
    case Mapping = 7,
    case Handle = 8,
    case Pipe = 9,
}

/// Columns in the ledger — one per `QuotaKind`, and the arrays' stride.
public(package) static QUOTA_KINDS: Int = 10

/// "No policy cap on this row: the MACHINE answers."
///
/// **THIS IS HOW ROOT'S LIMITS ARE THE SLAB SIZES** (D-3), and the sentinel is
/// the right spelling rather than the numbers themselves. Writing root's rows
/// as the slab sizes would put a policy cap at exactly the point the machine
/// refuses, and since the quota is asked FIRST, every `NoResource` root has
/// ever been answered with would become a `QuotaExceeded` — the machine's edge
/// speaking in policy's voice, which is the opposite of what "its policy cap IS
/// the machine" says. With the sentinel the slab is what refuses root, which is
/// the sentence executed rather than approximated.
public(package) static QUOTA_UNLIMITED: UInt16 = 0xFFFF

/// What each process has spent, by kind.
public(package) unsafe static var QUOTA_USED: [UInt16; MAX_PROCESSES * QUOTA_KINDS] = [
    0; MAX_PROCESSES * QUOTA_KINDS]

/// What each process may spend, by kind. Zero until `install_quota_limits`
/// runs, which is deliberate: a slot with no limits installed can allocate
/// nothing, so a process reached before its ledger exists refuses rather than
/// running unbudgeted.
public(package) unsafe static var QUOTA_LIMIT: [UInt16; MAX_PROCESSES * QUOTA_KINDS] = [
    0; MAX_PROCESSES * QUOTA_KINDS]

/// Where process `p`'s row for `kind` lives.
func quota_at(p: Int, kind: QuotaKind) -> Int {
    p * QUOTA_KINDS + ((kind as UInt8) as Int)
}

/// Has `p` room for one more of `kind`?
///
/// ASKED BEFORE THE SLAB IS, at every allocation site — D-3's check order, and
/// the reason a caller can tell "my budget" from "the machine's edge".
public(package) func quota_room(p: Int, kind: QuotaKind) unsafe -> Bool {
    let at = quota_at(p, kind)
    if QUOTA_LIMIT[at] == QUOTA_UNLIMITED {
        return true
    }
    QUOTA_USED[at] < QUOTA_LIMIT[at]
}

/// Has `p` room for `n` more of `kind`?
///
/// **THE RENDEZVOUS IS WHY THIS EXISTS** (`designs/010` ruling 5, built by sawos
/// design 18). Every other allocation site takes one thing and can ask about
/// one; a take that carries handles mints SEVERAL entries at once and must
/// refuse ATOMICALLY — the message stays staged, the level stays ready, and the
/// answer is the table-full status — so the question has to be asked about the
/// whole batch before any of it happens. Asking one at a time and unwinding
/// would be the same answer reached by a path that can fail halfway.
///
/// `n == 0` is legal and answers true, which is what a message with no handles
/// asks.
public(package) func quota_room_for(p: Int, kind: QuotaKind, n: Int) unsafe -> Bool {
    let at = quota_at(p, kind)
    if QUOTA_LIMIT[at] == QUOTA_UNLIMITED {
        return true
    }
    ((QUOTA_USED[at] as Int) + n) <= (QUOTA_LIMIT[at] as Int)
}

/// Spend one of `kind` against `p`.
///
/// CALLED ONLY ONCE EVERY REFUSAL IS BEHIND US — `event_create`'s
/// all-or-nothing shape, applied to the ledger: a charge made before a slab
/// refusal would leave a process paying for an object it never got.
public(package) func quota_charge(p: Int, kind: QuotaKind) unsafe {
    let at = quota_at(p, kind)
    QUOTA_USED[at] = QUOTA_USED[at] + 1
}

/// Give one of `kind` back to `p`.
///
/// The zero test is not defensive bookkeeping, it is the write-off D-4 names:
/// a credit may land on a row the teardown has already zeroed, and the honest
/// answer for "give back what nobody is charged for" is to do nothing.
public(package) func quota_credit(p: Int, kind: QuotaKind) unsafe {
    let at = quota_at(p, kind)
    if QUOTA_USED[at] != 0 {
        QUOTA_USED[at] = QUOTA_USED[at] - 1
    }
}

/// Forget process `p`'s ledger. Called by the teardown.
///
/// **CREDITS DIE WITH THE LEDGER** (sawos design 7 D-4): a Gone process's rows
/// zero with its slot, so everything it was ever charged for is written off in
/// one line and the books balance by construction. Both rows go, not only the
/// used ones — a process slot is reclaimable (design 3 D-3) and the next
/// occupant must not inherit a stranger's allowance.
public(package) func quota_clear(p: Int) unsafe {
    var i: Int = 0
    while i < QUOTA_KINDS {
        QUOTA_USED[p * QUOTA_KINDS + i] = 0
        QUOTA_LIMIT[p * QUOTA_KINDS + i] = 0
        i = i + 1
    }
}

/// Write one row of `p`'s allowance.
func set_limit(p: Int, kind: QuotaKind, value: UInt16) unsafe {
    QUOTA_LIMIT[quota_at(p, kind)] = value
}

/// Give process `p` its allowance, and zero what it has spent.
///
/// TWO POLICIES, ONE FUNCTION. `root` is init and its cap is the machine, so
/// every row but one is `QUOTA_UNLIMITED` and the SLAB is what refuses it. A
/// child gets `kcore.limits`' documented defaults, which are all visibly under
/// their slabs.
///
/// **THE MAPPING ROW IS CLAMPED FOR BOTH, and that is agenda item 8's assert's
/// runtime half.** `free_rows` is what the target's domain has left after its
/// image spent its own — a fact no `static_assert` can know, since how many
/// rows an image takes is a property of the image — and capping the row at it
/// makes the invariant "quota limit <= free rows" true for EVERY process by
/// construction. `install_row` then cannot meet the physical wall with quota
/// headroom left, which is what turns its `fatal` from a hope into a
/// consequence. Root is capped too, and that is not a departure from "root's
/// cap is the machine": the row budget IS the machine, stated in the ledger's
/// vocabulary so that the one refusal a `map` can meet is the one the assert
/// reasons about.
///
/// It is called once per process life — at boot for root, at `process_create`
/// for a child — and always AFTER the image's rows are recorded, because
/// `free_rows` is read from the record.
public(package) func install_quota_limits(p: Int, root: Bool, free_rows: Int) unsafe {
    var i: Int = 0
    while i < QUOTA_KINDS {
        QUOTA_USED[p * QUOTA_KINDS + i] = 0
        i = i + 1
    }

    if root {
        set_limit(p, QuotaKind.Thread, QUOTA_UNLIMITED)
        set_limit(p, QuotaKind.Event, QUOTA_UNLIMITED)
        set_limit(p, QuotaKind.Waiter, QUOTA_UNLIMITED)
        set_limit(p, QuotaKind.Interrupt, QUOTA_UNLIMITED)
        set_limit(p, QuotaKind.Timer, QUOTA_UNLIMITED)
        set_limit(p, QuotaKind.Memory, QUOTA_UNLIMITED)
        set_limit(p, QuotaKind.IoMemory, QUOTA_UNLIMITED)
        set_limit(p, QuotaKind.Handle, QUOTA_UNLIMITED)
        set_limit(p, QuotaKind.Pipe, QUOTA_UNLIMITED)
    } else {
        set_limit(p, QuotaKind.Thread, DEFAULT_QUOTA_THREADS as UInt16)
        set_limit(p, QuotaKind.Event, DEFAULT_QUOTA_EVENTS as UInt16)
        set_limit(p, QuotaKind.Waiter, DEFAULT_QUOTA_WAITERS as UInt16)
        set_limit(p, QuotaKind.Interrupt, DEFAULT_QUOTA_INTERRUPTS as UInt16)
        set_limit(p, QuotaKind.Timer, DEFAULT_QUOTA_TIMERS as UInt16)
        set_limit(p, QuotaKind.Memory, DEFAULT_QUOTA_MEMORIES as UInt16)
        set_limit(p, QuotaKind.IoMemory, DEFAULT_QUOTA_IOMEMORIES as UInt16)
        set_limit(p, QuotaKind.Handle, DEFAULT_QUOTA_HANDLES as UInt16)
        set_limit(p, QuotaKind.Pipe, DEFAULT_QUOTA_PIPES as UInt16)
    }

    // A record that somehow holds more rows than the profile grants would make
    // this negative, and a negative allowance is not a number — zero is.
    let rows = if free_rows < 0 { 0 } else { free_rows }
    let want = if root { MAX_MAPPINGS } else { DEFAULT_QUOTA_MAPPINGS }
    let mappings = if want < rows { want } else { rows }
    set_limit(p, QuotaKind.Mapping, mappings as UInt16)
}

/// Which refusal a `mint_handle` that answered `NO_HANDLE` was.
///
/// The two are indistinguishable in the word — there is one sentinel — so this
/// re-asks the question the mint asked first: a caller with no handle room left
/// met ITS budget, anyone else met the TABLE. One helper rather than a second
/// return channel, because every mint site already tests for `NO_HANDLE` and
/// this turns that test into the right status without changing its shape.
public(package) func mint_refusal(p: Int) unsafe -> SosStatus {
    if quota_room(p, QuotaKind.Handle) {
        return SosStatus.NoResource
    }
    SosStatus.QuotaExceeded
}

// =============================================================================
// The Memory slab, first of three (spec §2.5; sawos design 2 D-2, grown by
// design 6)
// =============================================================================
//
// **THREE SLABS, AND NONE OF THEM IS A MODULE — WHICH UNIT 4 TESTED AND KEPT.**
// Unit 2 put the Memory slab here beside the handle table on the argument that
// a Memory is a SEALED PAIR: every other object kind has behaviour somewhere
// (a thread has a state machine, a timer a schedule, an event an accumulation
// rule) and a region had none, so a file per object would have been a file with
// no verbs in it. Unit 4 gave all three kinds verbs — `Split`, `Carve`, `Map`,
// `Unmap` — and they still live here, because the verbs went to the DISPATCH
// where every other kind's do. What is here is what was here: storage, an
// allocator per slab, and one index fixup.
//
// They sit BELOW `process` for the reason every other slab does: ending a
// process frees what it owned, so the storage has to be reachable from the
// teardown.

/// One Memory object: a range of physical memory, and whose it is.
///
/// `len` rather than a top address, because that is the shape the region table
/// carries and the shape a pool will hand out. The kernel computes the top
/// where it needs one, with the bound test ordered so the addition cannot
/// overflow — the loader's own discipline.
public(package) struct MemorySlot {
    public(package) state: SlotState,
    public(package) process: Int,
    public(package) base: UInt,
    public(package) len: UInt,
    /// How many handle entries name this region (sawos design 7 D-1).
    public(package) refs: UInt16,
}

public(package) unsafe static var MEMORIES: [MemorySlot; MAX_MEMORIES] = [
    MemorySlot(state: SlotState.Free, process: 0, base: 0, len: 0, refs: 0);
    MAX_MEMORIES]

/// Take a free Memory slot, or `NO_MEMORY` when the slab is full.
public(package) func alloc_memory() unsafe -> Int {
    var i: Int = 0
    while i < MAX_MEMORIES {
        match MEMORIES[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_MEMORY
}

// =============================================================================
// The IoMemory slab (spec §2.5; sawos design 6 D-1)
// =============================================================================
//
// THE SAME SHAPE AS THE MEMORY SLAB, AND A DIFFERENT LIFETIME. An IoMemory is
// `{base, len}` plus the process it is charged to, exactly as a Memory is —
// which is why the two slabs are two arrays rather than one array with a flag,
// per D-1: what differs is not the SHAPE but everything the shape is used for.
// The bytes it names are REGISTERS, so nothing is ever placed in them, nothing
// is ever zeroed, and the range is never returned to anybody — carving hands
// out a view and leaves the parent whole (§2.5's "a fixed region may be handed
// out many times"). The teardown reclaims the slot and touches no hardware.

/// One IoMemory object: a range of device registers, and whose it is.
public(package) struct IoMemorySlot {
    public(package) state: SlotState,
    public(package) process: Int,
    public(package) base: UInt,
    public(package) len: UInt,
    /// How many handle entries name this window (sawos design 7 D-1).
    public(package) refs: UInt16,
}

public(package) unsafe static var IOMEMORIES: [IoMemorySlot; MAX_IOMEMORIES] = [
    IoMemorySlot(state: SlotState.Free, process: 0, base: 0, len: 0, refs: 0);
    MAX_IOMEMORIES]

/// Take a free IoMemory slot, or `NO_IOMEMORY` when the slab is full.
public(package) func alloc_iomemory() unsafe -> Int {
    var i: Int = 0
    while i < MAX_IOMEMORIES {
        match IOMEMORIES[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_IOMEMORY
}

// =============================================================================
// The Mapping slab (spec §2.5; sawos design 6 D-3)
// =============================================================================
//
// **A MAPPING IS AN INSTALLED GRANT ROW**, so a slot records WHICH domain
// carries the row and WHICH row it is — an index into `PROCESSES[target].grants`
// — and nothing else. There is no base, no length and no access word here,
// because the row already holds all three and a copy would be a second place
// for them to disagree.
//
// **THE ROW INDEX IS THE ONE INDEX-SENSITIVE FACT IN THE SYSTEM** (design 6
// D-3's census). `load_domain` replays rows BY POSITION, so unmapping row `i`
// COMPACTS the record — and every Mapping slot naming a later row of the same
// domain has to move with it. `compact_mapping_rows` below is that fixup, and
// it is a bounded scan of this slab rather than a back-pointer per row: eight
// slots, at an unmap, against a per-row pointer that four other paths would
// have to keep in step.
//
// **A SLOT OUTLIVES ITS ROW, DELIBERATELY.** Two things end a row without
// ending the object: an `unmap`, and the death of the TARGET process (whose
// whole domain goes with it). Both leave the slot Live with `row == NO_ROW`,
// which is what a later `unmap` sees as `BadState`. The slot itself comes back
// at its OWNER's teardown, like every other kind — an op that freed a slab slot
// while a handle still named it would let the next occupant be reached through
// a stale word, which is exactly the aliasing design 3's generations exist to
// prevent and which they cannot cover here (a generation lives in the handle
// ENTRY, and the entry is not what went away).

/// "This mapping has no row" — unmapped, or its target process is gone.
///
/// A row index is a position in a bounded array, so a negative is unusable as
/// one and needs no reserved slot of its own.
public(package) static NO_ROW: Int = -1

/// One Mapping object: who owns the handle, whose domain holds the row, and
/// which row it is.
///
/// `process` is the OWNER — the process whose teardown reclaims this slot —
/// and `target` is the process whose domain the row sits in. They are usually
/// the same and are genuinely different for the shape unit 4 exists to make
/// possible: a launcher mapping a region into a child it created.
public(package) struct MappingSlot {
    public(package) state: SlotState,
    public(package) process: Int,
    public(package) target: Int,
    public(package) row: Int,
    /// How many handle entries name this mapping (sawos design 7 D-1).
    ///
    /// **THE ROW IS NOT ONE OF THEM** (design 7 D-2). A Mapping OWNS its row,
    /// not the reverse, so a mapped-but-unreferenced Mapping is at zero and
    /// frees — leaving the row behind, which is §2.5's "permanent,
    /// safe-but-leaked" made mechanical rather than a new law.
    public(package) refs: UInt16,
}

public(package) unsafe static var MAPPINGS: [MappingSlot; MAX_MAPPINGS] = [
    MappingSlot(state: SlotState.Free, process: 0, target: 0, row: NO_ROW,
                refs: 0);
    MAX_MAPPINGS]

/// Take a free Mapping slot, or `NO_MAPPING` when the slab is full.
public(package) func alloc_mapping() unsafe -> Int {
    var i: Int = 0
    while i < MAX_MAPPINGS {
        match MAPPINGS[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_MAPPING
}

/// A row was removed from process `target`'s grant record at index `removed`,
/// and the record COMPACTED. Move every Mapping that named a later row down
/// with it.
///
/// THE ONLY INDEX-SENSITIVE FIXUP IN THE KERNEL, and it is small because the
/// census said it would be: `load_domain` is the one place a row's POSITION
/// means anything to the hardware, and this slab is the one place a position is
/// remembered across a syscall.
public(package) func compact_mapping_rows(target: Int, removed: Int) unsafe {
    var i: Int = 0
    while i < MAX_MAPPINGS {
        match MAPPINGS[i].state {
            case Live -> {
                if MAPPINGS[i].target == target && MAPPINGS[i].row > removed {
                    MAPPINGS[i].row = MAPPINGS[i].row - 1
                }
            },
            case Free -> {},
        }
        i = i + 1
    }
}

// =============================================================================
// The Pipe slab — ONE CONNECTION, TWO COUNTED KINDS (spec §2.1; sawos design 13
// D-1, on design 10 D-1 and ruling 6)
// =============================================================================
//
// **ONE SLAB, TWO REFERENCE COLUMNS, AND THAT IS THE WHOLE OF "ROLES ARE
// OBJECTS".** `ObjType.PipeInlet` and `ObjType.PipeOutlet` are two counted kinds
// that TARGET THE SAME ROW here, and which column a handle entry maintains is
// decided by its kind — which §3's order establishes before any right is read.
// So "the writers went to zero" is "the inlet column reached zero", asked of the
// ledger design 7 already built, with no second ledger and no rights-partitioned
// count.
//
// **THE SLOT FREES WHEN BOTH COLUMNS ARE ZERO**, and only then; ONE column
// reaching zero is the PEER-GONE transition, which `kcore.refs` is where it
// becomes mechanical. A connection with a live outlet and no inlet is a slot
// that still has messages to hand over — design 230's close-drains-first rule,
// which is exactly why the free cannot be per-endpoint.
//
// **THE STAGING IS SEPARATE STORAGE, NOT A FIELD.** A ring of `PIPE_INFLIGHT`
// slots at `PIPE_BODY_BYTES` each is kilobytes per connection, and a slot struct
// holding one would make every `PIPES[slot] = PipeSlot(...)` a multi-kilobyte
// memset inside a syscall. So the bodies live in their own flat array, indexed
// `c * PIPE_INFLIGHT * PIPE_BODY_BYTES + i * PIPE_BODY_BYTES` — the handle
// table's own idiom, one file up from where the boot-handle queue uses it — and
// the slot carries the three numbers that describe the ring rather than the ring
// itself. Both arrays are all-zero initializers, so they cost NO IMAGE BYTES
// (design 149) and the kernel's `.bss` is where the storage lands.
//
// **NOTHING IS EVER ALLOCATED PER MESSAGE**, which is the property §2.1's fixed
// body and fixed in-flight budget were ratified for. A post writes an existing
// slot; a take reads one and advances a cursor.
//
// It sits BELOW `process` for the reason every other slab does: ending a process
// frees what it owned, so the storage has to be reachable from the teardown.

/// Which `BootHandleKind` a given handle's `ObjType` is delivered as, or `None`
/// when the boot record has no spelling for it.
///
/// **THE ONE PLACE THE KERNEL-INTERNAL KIND AND THE PUBLIC ONE MEET** (sawos
/// design 4). `ObjType` is renumberable bookkeeping and `BootHandleKind` crosses
/// the trap boundary, so neither is a cast of the other; this function is the
/// translation, written out, and it is deliberately PARTIAL. The kinds it cannot
/// spell are exactly the kinds nothing mints `Transfer` on today — a Thread,
/// Event, Waiter, Interrupt, Clock or Timer handle never reaches here, because
/// the `Transfer` check above refuses it first. The arm exists so that the day a
/// kind becomes givable, the compiler asks for its record spelling instead of
/// letting it arrive mis-tagged.
///
/// **IT MOVED DOWN HERE IN M4 UNIT 4** (sawos design 18), and the reason is a
/// SECOND caller that could not reach it where it was: a message's handle slots
/// carry their kinds, so `kcore.refs` has to translate one at every rendezvous —
/// and `refs` sits BELOW `dispatch`, which is what makes reaching upward the
/// cycle DF-232e does not diagnose. It belongs here on the ordinary rule: a
/// translation between two `sosabi` enums names nothing this module does not
/// already import, so the lowest module that needs it is where it goes.
public(package) func boot_kind_of(kind: ObjType) -> BootHandleKind? {
    match kind {
        case Memory -> BootHandleKind.Memory,
        case Process -> BootHandleKind.Process,
        case System -> BootHandleKind.System,
        // **UNIT 4'S ARM, AND IT IS THE ARM THE COMMENT ABOVE PREDICTED**
        // (sawos design 6 D-1): `iomemory_rights()` mints `Transfer`, so a
        // window can travel, so the record needs a spelling for one. A Mapping
        // stays in the `None` arm on purpose — `mapping_rights()` withholds
        // `Transfer`, so the `Transfer` check above refuses one first and this
        // spelling would be dead surface.
        case IoMemory -> BootHandleKind.IoMemory,
        // **M4 UNIT 1's TWO ARMS, AND THEY ARE THE SAME PREDICTION COLLECTED A
        // SECOND TIME** (sawos design 13 D-3): `pipe_inlet_rights()` and
        // `pipe_outlet_rights()` mint `Transfer`, because handing a child ONE
        // END of a connection is what the pair is FOR — a launcher creates the
        // pair, gives the inlet to the client and the outlet to the server, and
        // the launch flow is unchanged.
        case PipeInlet -> BootHandleKind.PipeInlet,
        case PipeOutlet -> BootHandleKind.PipeOutlet,
        // **M4 UNIT 2's TWO ARMS, AND THIS PAIR IS THE ONE §2.1 ARGUED FOR BY
        // NAME** (sawos design 14). `pipe_reply_rights()` and
        // `pipe_request_rights()` mint `Transfer` because the ratified section
        // calls the one-shots THE DELEGATION PRIMITIVE: a server MOVES its
        // obligation to a third party, who replies straight to the original
        // client and the payload never transits the middle process. So a give
        // must carry one, and its record must be able to spell it —
        // `pipe-delegate` is that flow at its smallest.
        case PipeReply -> BootHandleKind.PipeReply,
        case PipeRequest -> BootHandleKind.PipeRequest,
        case _ -> None,
    }
}

/// Which `BootHandleKind` a handle may be delivered as IN A MESSAGE, or `None`
/// when a message cannot carry that kind at all (sawos design 18).
///
/// **IT IS `boot_kind_of` MINUS TWO, AND THE TWO ARE A TYPED-SURFACE FACT
/// RATHER THAN A CAPABILITY ONE.** A `Process` and a `System` handle are both
/// givable — `process_rights()` and `root_system_rights()` mint `Transfer`, and
/// the boot record spells both — so a launcher hands either across at start-up
/// today. What a MESSAGE cannot do with one is TELL THE RECEIVER WHAT ARRIVED:
/// the receiving vocabulary is `sos.pipe`'s `PipeHandle`, and `Process` and
/// `System` are declared in `sos.system`, which imports `sos.pipe` — so a case
/// for either would be the import cycle DF-232e does not diagnose.
///
/// **REFUSING AT THE SENDER IS THE HONEST PLACE.** The alternative is delivering
/// a word the receiver's decode would have to panic on, which turns one
/// process's mistake into another's crash; this way the sender is told
/// `BadArg` — a caller-checkable fault, since it chose the handle — and nothing
/// crosses. It is `boot_kind_of`'s own partiality one door over, and the arm
/// exists so the day the two wrappers are declarable below the message layer,
/// the compiler asks here.
public(package) func msg_kind_of(kind: ObjType) -> BootHandleKind? {
    guard let spelled = boot_kind_of(kind) else {
        return None
    }
    match spelled {
        case Process -> None,
        case System -> None,
        case _ -> spelled,
    }
}

/// One Pipe CONNECTION: whose it is, what is staged, and how many handles name
/// each of its two ends.
///
/// `process` is the CREATOR — creator-pays (design 7 D-3), so whoever was
/// charged is who gets the quota row back when the connection frees, whichever
/// process happened to drop the last handle onto either end.
///
/// `head` and `count` are the ring, and there is no `tail` because a tail is
/// `(head + count) % PIPE_INFLIGHT` — one derivation beats a second index two
/// paths would have to keep in step.
///
/// **THE TWO COLUMNS ARE THE PEER-GONE STATE, and no flag beside them says so.**
/// "The inlet side is gone" IS `inlet_refs == 0`, because a column can only fall
/// to zero and can never rise again: what would raise it is a handle onto that
/// end, and a mint needs a source handle there is none of. So the terminal level
/// is a fact about the count rather than a bit somebody has to remember to set,
/// and the two can never disagree.
///
/// **THE RING WENT FROM A QUEUE OF BYTES TO A TABLE OF EXCHANGES IN M4 UNIT 2**
/// (sawos design 14 D-1), which is what cost this struct its `head` and `count`.
/// A slot used to live until its bytes were taken, so the staged messages were
/// contiguous and a head plus a count described them; a slot now carries the
/// REPLY back and recycles only when the exchange settles, and exchanges settle
/// in whatever order their two holders act — so occupancy is per-slot and the
/// staged messages are a LIST threaded through them. `staged` is that list's
/// head, 1-based so that zero is "nothing staged", and there is no tail because
/// appending walks at most `PIPE_INFLIGHT` links — design 13's own argument
/// against a second index to keep in step.
public(package) struct PipeSlot {
    public(package) state: SlotState,
    public(package) process: Int,
    /// The oldest STAGED (untaken) exchange's ring index, PLUS ONE. Zero is
    /// "nothing staged", which is the list-link idiom the thread queues use.
    public(package) staged: Int,
    /// The attachment watching the CLIENT end's room-to-post level (slot + 1);
    /// 0 = unattached. **ONE FIELD PER END, not one per connection** (sawos
    /// design 15, M4 unit 3): the two ends are two waitables — a client waits
    /// for room and a server waits for a message — so §2.2's at-most-one-Waiter
    /// rule is per END, exactly as `inlet_refs` and `outlet_refs` are.
    public(package) inlet_attachment: Int,
    /// The attachment watching the SERVER end's readable level (slot + 1).
    public(package) outlet_attachment: Int,
    /// How many handle entries name the CLIENT end (sawos design 7 D-1's
    /// counting rule, one column per kind), PLUS its attachment.
    public(package) inlet_refs: UInt16,
    /// How many handle entries name the SERVER end, PLUS its attachment.
    public(package) outlet_refs: UInt16,
}

public(package) unsafe static var PIPES: [PipeSlot; MAX_PIPES] = [
    PipeSlot(state: SlotState.Free, process: 0, staged: 0,
             inlet_attachment: 0, outlet_attachment: 0,
             inlet_refs: 0, outlet_refs: 0);
    MAX_PIPES]

/// Every connection's staging ring, back to back — the storage the slots above
/// describe.
static PIPE_BODY_STORAGE: Int = MAX_PIPES * PIPE_INFLIGHT * PIPE_BODY_BYTES

public(package) unsafe static var PIPE_BODIES: [UInt8; PIPE_BODY_STORAGE] = [
    0; PIPE_BODY_STORAGE]

/// Ring slots in the whole machine — the stride every per-exchange array below
/// is sized to. One row per (connection, ring slot) pair, which is what an
/// EXCHANGE index names.
public(package) static PIPE_EXCHANGES: Int = MAX_PIPES * PIPE_INFLIGHT

/// How long the message in each staging slot is — and, once a reply has been
/// written, how long THAT is. One number, because a slot holds one body at a
/// time and the exchange's state is what says which body it is.
public(package) unsafe static var PIPE_LENS: [UInt16; PIPE_EXCHANGES] = [
    0; PIPE_EXCHANGES]

// =============================================================================
// The one-shot pair — CLAIM AND OBLIGATION, AS RING-SLOT STATE (spec §2.1;
// sawos design 14 D-1/D-2)
// =============================================================================
//
// **NO THIRD SLAB, AND D-1's ARGUMENT IS ONE SENTENCE**: a one-shot pair exists
// for exactly as long as one in-flight message does, and design 10 ruling 4's
// rider already pins the reply body to the staging slot that carried the
// request. So the claim state lives WITH THE SLOT — four parallel arrays beside
// `PIPE_LENS`, all zero-initialized, all in `.bss` (design 149), costing no
// image bytes and no new limit.
//
// **THE EXCHANGE INDEX IS THE OBJECT'S IDENTITY.** `ObjType.PipeReply` and
// `ObjType.PipeRequest` both target `connection * PIPE_INFLIGHT + ring slot`,
// which is the flat arithmetic `pipe_body_addr` already uses — design 13's "two
// kinds, one slab" one level down, with the same consequence: which column a
// handle counts on is decided by its KIND, before any right is read.
//
// **THE TWO COLUMNS ARE THE ABANDONMENT STATE**, exactly as the connection's two
// are the peer-gone state, and no flag beside them says so:
//
//   the claim column at zero          the client abandoned the exchange
//   `Taken` with the request column
//     at zero                         the server abandoned the obligation
//   `Staged` with the connection's
//     outlet column at zero           nobody can ever take it, so likewise
//
// **AND THE SLOT SETTLES WHEN NOBODY NAMES IT AND NOTHING IS OWED.** That is one
// predicate (`exchange_can_settle`) and it is the counted-object rule with one
// extra clause: a STAGED message is owed to a live outlet whatever became of the
// claim, which is §2.1's TELL idiom (post, drop the claim, and the server still
// receives the message) and design 230's close-drains-first rule reaching one
// level down.

/// Where an exchange is in its life. FOUR STATES, and the two abandonment
/// answers are derived from the columns rather than stored beside them.
///
/// `Free` is the slot nobody is using — the ring's own occupancy, which is what
/// `PipeInletOp.Post` scans for and what makes a full ring count AWAITING-REPLY
/// exchanges rather than merely untaken messages (D-1's literal reading of
/// design 10 ruling 6's in-flight budget).
public(package) enum ExchangeState: UInt8 {
    case Free = 0,
    /// A request body is in the slot and nobody has taken it. The obligation has
    /// not been minted, so its column is zero for a reason that is not
    /// abandonment — which is exactly why the state has to be recorded and the
    /// columns alone would not do.
    case Staged = 1,
    /// The obligation has been minted and the reply is owed.
    case Taken = 2,
    /// The reply body is in the slot and the claim may take it.
    case Replied = 3,
    /// **THE EXCHANGE IS DISCHARGED, AND M4 UNIT 3 IS WHERE THAT BECAME A STATE**
    /// (sawos design 15, on design 10 ruling 11(a)/(b)). A reply DELIVERED
    /// through a `Waiter.wait` hands the bytes over exactly as a `Resolve` does
    /// — the wait IS the delivery — but it does not travel through the claim's
    /// handle ENTRY, so it cannot consume one. Without a state to move to, the
    /// slot would stay `Replied` and a later `Resolve` through the very same
    /// claim would copy the answer out a SECOND time, which is the duplicate
    /// §2.2's consume rule exists to make impossible.
    ///
    /// So a delivered reply lands here, and it answers everything the way a
    /// spent exchange should: a later `Resolve` is `PeerClosed` and consumes the
    /// claim, a `Reply` through a minted sibling is `PeerClosed` too, and the
    /// slot settles as soon as both columns are zero. It is the ONE state whose
    /// arrival is not an op — which is exactly why the columns could not have
    /// derived it.
    case Settled = 4,
}

public(package) unsafe static var PIPE_EX_STATE: [ExchangeState; PIPE_EXCHANGES] = [
    ExchangeState.Free; PIPE_EXCHANGES]

/// How many handle entries name each exchange's CLAIM.
public(package) unsafe static var PIPE_REPLY_REFS: [UInt16; PIPE_EXCHANGES] = [
    0; PIPE_EXCHANGES]

/// How many name its OBLIGATION.
public(package) unsafe static var PIPE_REQUEST_REFS: [UInt16; PIPE_EXCHANGES] = [
    0; PIPE_EXCHANGES]

/// The attachment watching each exchange's CLAIM (slot + 1); 0 = unattached.
///
/// **TWO ARRAYS, BECAUSE A CLAIM AND AN OBLIGATION ARE TWO WAITABLES** (sawos
/// design 15). They are one exchange and two objects — the reply-ready level
/// belongs to the client, the request-abandoned level to the server — so §2.2's
/// at-most-one-Waiter rule holds per COLUMN, exactly as the reference count
/// does, and the two may be watched from two different processes at once. It is
/// the `PipeSlot` pair one level down, which is the shape design 14 already
/// inherited from design 13.
public(package) unsafe static var PIPE_REPLY_ATTACH: [Int; PIPE_EXCHANGES] = [
    0; PIPE_EXCHANGES]

/// The attachment watching each exchange's OBLIGATION (slot + 1).
public(package) unsafe static var PIPE_REQUEST_ATTACH: [Int; PIPE_EXCHANGES] = [
    0; PIPE_EXCHANGES]

/// **THE THREAD PARKED IN A FUSED `Call` ON THIS EXCHANGE** (thread slot + 1;
/// 0 = none), sawos design 17.
///
/// **IT IS A THIRD WAY TO NAME A CLAIM, AND THE ONLY ONE THAT IS NOT A HANDLE.**
/// Design 10 ruling 4's rider says a fused call mints no `PipeReply` into the
/// caller's table — zero handle traffic and zero table rows on the fast path —
/// so the claim it holds is KERNEL-INTERNAL and tied to the parked thread. This
/// array is that tie, and the reference model is unchanged underneath it: a
/// parked caller counts ONE on `PIPE_REPLY_REFS`, exactly as a handle entry or
/// an attachment would, so nothing can settle the ring slot out from under it.
///
/// **TWO DIRECTIONS, TWO FIELDS, AND EACH EARNS ITS PLACE.** This one answers
/// "who is waiting for this exchange", which is what a settling reply has to
/// know and what makes the wake arm a load rather than a scan of the thread
/// table; `ThreadSlot.call_claim` answers "what is this thread waiting for",
/// which is what the teardown has to know when a process dies parked. Neither
/// question can be answered from the other side without a walk.
///
/// A parked caller is on NO LIST — it is not on a Waiter's `blocked` chain,
/// because a fused call involves no Waiter at all — so this field is the whole
/// of how it is reachable. That is why `exchange_settle` asserts it is clear.
public(package) unsafe static var PIPE_CALLER: [Int; PIPE_EXCHANGES] = [
    0; PIPE_EXCHANGES]

/// The staged list's links — the next STAGED exchange in this connection, plus
/// one, or zero at the end. Only ever appended at the tail and removed at the
/// head (a take), or cleared whole (the outlet's zero-arm), so it is a strict
/// FIFO and never needs a removal from the middle.
public(package) unsafe static var PIPE_NEXT: [Int; PIPE_EXCHANGES] = [
    0; PIPE_EXCHANGES]

// =============================================================================
// THE STAGED HANDLE LEDGER (spec §2.1's rendezvous transfer; `designs/010`
// ruling 5 AS RE-RULED Sep 2 — TAKE-AT-POST; sawos design 18)
// =============================================================================
//
// **A HANDLE LEAVES THE SENDER AT THE POST, AND THE KERNEL HOLDS IT UNTIL THE
// RECEIVER TAKES IT.** That is the re-ruled ruling 5 in one sentence, and this
// array is the whole of its mechanism: a validated send UNBINDS each of its
// handle entries and parks the REFERENCE those entries were holding in the ring
// note, so a staged message owns what it is carrying and nothing about it can
// go stale.
//
// **THE NOTE IS TYPED REFS, NOT WORDS, AND THE SHAPE IS THE RULING.** A handle
// word is an index into a table the entry no longer occupies, so once the entry
// is unbound the word means nothing — what survives is the OBJECT the reference
// names and the RIGHTS the sender was holding it with. `StagedRef` is exactly
// that: a handle entry with its table slot and its generation left off, which is
// all a later mint needs and all a later release needs.
//
// **WHY THIS REPLACED SENDER-KEEPS** (the Sep-2 re-rule, recorded here because
// this array is where the two designs differ). Under sender-keeps the note was a
// process index plus four handle words, re-validated at the rendezvous, and a
// released entry arrived as an empty slot; that was sound but it made a
// capability send RACE THE SENDER'S OWN EXIT, and it contradicted the typed
// tier's move story, where `post_with(handles:)` consumes the wrapper and a
// consumed wrapper does not come back. Design 260's `consumes` and ruling 10's
// orphan accounting both post-date the Aug-30 ruling and both point the other
// way. Take-at-post turns the old first consequence into a GUARANTEE: a message
// that was accepted will deliver what it was carrying, whatever becomes of the
// sender.
//
// **NOBODY IS CHARGED FOR A STAGED HANDLE, AND THE BOUND IS WHY THAT IS SAFE.**
// The unbind credits the sender's `QuotaKind.Handle` row at the one place a
// binding is destroyed, and the taker is charged at the mint — so between the
// two the entry is charged to NOBODY, which is design 14 D-4's orphan vocabulary
// arriving at a second kind. It cannot be exploited into an unbounded hole: a
// connection can hold at most `PIPE_INFLIGHT * PIPE_MSG_HANDLES` staged handles
// (the ring is fixed and every slot's note is fixed), the connection itself cost
// a `QuotaKind.Pipe` row, and the objects the refs name already occupy the slab
// slots they were charged for. Quota <= wall therefore still holds: the SLAB is
// what refuses the next allocation, and no staged handle can conjure one.
//
// The array is zero-initialized and therefore `.bss` (design 149), costing no
// image bytes: `PIPE_EXCHANGES * PIPE_MSG_HANDLES` entries, which at the tree's
// numbers is 64 × 4.

/// ONE HANDLE A MESSAGE IS CARRYING, held by the kernel between the post and the
/// rendezvous — a `HandleEntry` with the two table-only fields left off.
///
/// **THE RIGHTS TRAVEL WITH THE REFERENCE, and they have to.** A reference names
/// an OBJECT; a capability is an object AND a rights word, and the receiver is
/// owed the sender's rights verbatim (design 4 D-1, reached through a second
/// door). Carrying only `(obj_type, target)` would make the taker's mint consult
/// a default set, which is precisely the amplification a transfer must not do.
///
/// `obj_type == Unbound` is the empty slot, which is what zero-init means and
/// why this array needs no separate occupancy word.
public(package) struct StagedRef {
    public(package) obj_type: ObjType,
    public(package) rights: UInt32,
    public(package) target: Int,
}

/// A whole message's worth of them, COLLECTED OUT OF THE LEDGER — the value
/// `take_staged` answers with and the only thing a release or a mint reads.
///
/// It exists because of the module order, and the module order is enforcing the
/// right discipline: releasing a reference lives in `kcore.refs`, which is ABOVE
/// this file, so an unwind arm down here cannot release and must hand the batch
/// upward instead. That is COLLECT-THEN-FREE spelled across a module boundary —
/// the ledger is left consistent before any release runs, so a cascade that
/// re-enters this file can never find a half-emptied exchange.
public(package) struct StagedRefs {
    public(package) slots: [StagedRef; PIPE_MSG_HANDLES],
}

/// The empty slot, written once so the zero value has a name.
public(package) func no_staged_ref() -> StagedRef {
    StagedRef(obj_type: ObjType.Unbound, rights: 0, target: 0)
}

/// The references a post or a reply staged, per exchange. Indexed
/// `x * PIPE_MSG_HANDLES + slot`, which is the flat arithmetic the bodies and
/// lengths already use.
///
/// ONE ARRAY SERVES BOTH DIRECTIONS, and it can because an exchange only ever
/// has one message in flight: the request's handles leave at the take, which is
/// the same moment the slot stops holding a request and starts being able to
/// hold a reply. The take COLLECTS what it minted, so a reply stages into slots
/// that are provably empty.
public(package) unsafe static var PIPE_MSG_HELD: [StagedRef; PIPE_EXCHANGES * PIPE_MSG_HANDLES] = [
    StagedRef(obj_type: ObjType.Unbound, rights: 0, target: 0);
    PIPE_EXCHANGES * PIPE_MSG_HANDLES]

/// Where exchange `x`'s handle slot `i` lives.
public(package) func msg_word_at(x: Int, i: Int) -> Int {
    x * PIPE_MSG_HANDLES + i
}

/// How many references exchange `x` is holding.
///
/// **IT IS A COUNT AND NOT A RE-VALIDATION** (the Sep-2 re-rule). Under
/// sender-keeps this had to resolve four handle words against a table that might
/// have moved on; now the refs are the kernel's own and staleness cannot exist,
/// so the answer is a scan of four tags. It is what the rendezvous pre-flights
/// the taker's table against.
public(package) func staged_count(x: Int) unsafe -> Int {
    var live: Int = 0
    var i: Int = 0
    while i < PIPE_MSG_HANDLES {
        match PIPE_MSG_HELD[msg_word_at(x, i)].obj_type {
            case Unbound -> {},
            case _ -> { live = live + 1 },
        }
        i = i + 1
    }
    live
}

/// **TAKE EXCHANGE `x`'s HELD REFERENCES OUT OF THE LEDGER**, leaving it empty.
///
/// The one way anything leaves this array, so every consumer — the rendezvous
/// that mints them onward and every unwind arm that drops them — goes through
/// one door and the ledger is consistent the instant the door returns. What the
/// caller does with the batch is the caller's obligation, and there are exactly
/// two things it may be: mint each ref into a table, or release each ref. Doing
/// NEITHER leaks a reference, which is why every call site is named in
/// `kcore.refs`' rendezvous header.
public(package) func take_staged(x: Int) unsafe -> StagedRefs {
    var out = StagedRefs(slots: [StagedRef(obj_type: ObjType.Unbound,
                                           rights: 0, target: 0);
                                 PIPE_MSG_HANDLES])
    var i: Int = 0
    while i < PIPE_MSG_HANDLES {
        out.slots[i] = PIPE_MSG_HELD[msg_word_at(x, i)]
        PIPE_MSG_HELD[msg_word_at(x, i)] = no_staged_ref()
        i = i + 1
    }
    out
}

/// "No exchange" — the sentinel a full ring answers with.
public(package) static NO_EXCHANGE: Int = -1

/// Which connection exchange `x` belongs to.
public(package) func exchange_pipe(x: Int) -> Int {
    x / PIPE_INFLIGHT
}

/// Which ring slot of that connection it is.
public(package) func exchange_index(x: Int) -> Int {
    x % PIPE_INFLIGHT
}

/// The exchange index of connection `c`'s ring slot `i` — the flat arithmetic
/// every per-exchange array is indexed by, and the identity `ObjType.PipeReply`
/// and `ObjType.PipeRequest` handle entries carry.
public(package) func pipe_exchange_at(c: Int, i: Int) -> Int {
    c * PIPE_INFLIGHT + i
}

/// Take a free Pipe slot, or `NO_PIPE` when the slab is full.
public(package) func alloc_pipe() unsafe -> Int {
    var i: Int = 0
    while i < MAX_PIPES {
        match PIPES[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_PIPE
}

/// The KERNEL address of exchange `x`'s body slot.
///
/// The whole-array address plus an offset, which is `frame_slot`'s own idiom in
/// `kcore.threads` — an `unsafe static var` array has one address and every slot
/// is arithmetic on it. Confined to this small named helper (design 136), so the
/// callers stay ordinary code and the pointer never leaves the expression.
///
/// ONE SLOT CARRIES BOTH BODIES, one at a time: the request on the way in, and
/// then the reply written over it (sawos design 14 D-1, on design 10 ruling 4's
/// rider — "ruling 6's fixed slots carry the reply"). Nothing is owed to the
/// request bytes once the taker has copied them out.
public(package) func exchange_body_addr(x: Int) unsafe -> UInt {
    let base = ((&var PIPE_BODIES) as UnsafePointer<UInt8>) as UInt
    base + ((x * PIPE_BODY_BYTES) as UInt)
}

/// Take a FREE ring slot of connection `c`, or `NO_EXCHANGE` when every one of
/// them is in use.
///
/// **THIS SCAN IS THE RING-FULL TEST** (sawos design 14 D-1), and what it counts
/// is what changed in unit 2: a slot is in use from the post that stages a
/// message until the exchange SETTLES, so a full ring is `PIPE_INFLIGHT`
/// AWAITING-REPLY exchanges rather than `PIPE_INFLIGHT` untaken messages. That is
/// design 10 ruling 6's "in-flight messages per client" read literally, and it is
/// why `PipeOutletOp.Take` no longer frees anything.
///
/// A scan rather than a cursor, for the reason `alloc_pipe` above is one:
/// exchanges settle in whatever order their two holders act, so the free slots
/// are not contiguous and there is no cursor that could describe them. It is
/// bounded by `PIPE_INFLIGHT` (16), which `kcore.limits`' audit note covers.
public(package) func alloc_exchange(c: Int) unsafe -> Int {
    var i: Int = 0
    while i < PIPE_INFLIGHT {
        let x = pipe_exchange_at(c, i)
        match PIPE_EX_STATE[x] {
            case Free -> { return x },
            case _ -> {},
        }
        i = i + 1
    }
    NO_EXCHANGE
}

/// **IS THERE ROOM TO POST — the inlet's waitable level** (design 10 ruling 8;
/// sawos design 15, M4 unit 3).
///
/// It is `alloc_exchange`'s own scan asked as a QUESTION rather than as a
/// reservation, and that is deliberate: readiness must reserve nothing, because
/// a level that took a slot to answer would hand it to whoever asked instead of
/// to whoever posts. So this is the same bounded walk with no side effect, which
/// is §2.2's level-triggering implemented rather than maintained — the same
/// argument `waiter_ready_attachment`'s scan makes.
public(package) func pipe_has_room(c: Int) unsafe -> Bool {
    var i: Int = 0
    while i < PIPE_INFLIGHT {
        match PIPE_EX_STATE[pipe_exchange_at(c, i)] {
            case Free -> { return true },
            case _ -> {},
        }
        i = i + 1
    }
    false
}

/// Append exchange `x` to its connection's STAGED list — the FIFO a take reads
/// from.
///
/// The walk to the tail is bounded by `PIPE_INFLIGHT` and buys the absence of a
/// tail index, which is design 13's own trade taken again: a second index is a
/// second thing two paths have to keep in step.
public(package) func stage_push(c: Int, x: Int) unsafe {
    PIPE_NEXT[x] = 0
    if PIPES[c].staged == 0 {
        PIPES[c].staged = x + 1
        return
    }
    var cur = PIPES[c].staged - 1
    while PIPE_NEXT[cur] != 0 {
        cur = PIPE_NEXT[cur] - 1
    }
    PIPE_NEXT[cur] = x + 1
}

/// The OLDEST staged exchange of connection `c`, or `NO_EXCHANGE` when nothing
/// is staged. Looks and does not remove — a take mints its obligation before it
/// consumes anything, so the refusal path must leave the list as it found it.
public(package) func stage_peek(c: Int) unsafe -> Int {
    if PIPES[c].staged == 0 {
        return NO_EXCHANGE
    }
    PIPES[c].staged - 1
}

/// Remove the oldest staged exchange from the list. Called only once the take
/// that asked for it can no longer be refused.
public(package) func stage_pop(c: Int) unsafe {
    let head = PIPES[c].staged
    if head == 0 {
        return
    }
    PIPES[c].staged = PIPE_NEXT[head - 1]
    PIPE_NEXT[head - 1] = 0
}

/// Is every ring slot of connection `c` free — is there no exchange left in it?
///
/// **THE CONNECTION OUTLIVES ITS ENDPOINTS FOR EXACTLY AS LONG AS AN EXCHANGE
/// INSIDE IT DOES** (sawos design 14 D-1, which is design 10 ruling 10's
/// "references govern lifetime" one level down). A claim is a reference on a RING
/// SLOT, and a ring slot lives inside the `PIPES` row — so freeing the row while
/// a claim is live would hand that claim a recycled connection. This predicate is
/// what stops it, and it is a scan rather than a third column for `alloc_pipe`'s
/// reason: it is the same bounded walk, and a maintained count would be one more
/// thing to keep in step.
public(package) func pipe_idle(c: Int) unsafe -> Bool {
    var i: Int = 0
    while i < PIPE_INFLIGHT {
        match PIPE_EX_STATE[pipe_exchange_at(c, i)] {
            case Free -> {},
            case _ -> { return false },
        }
        i = i + 1
    }
    true
}

/// Give connection `slot` back to the Pipe slab, and credit its CREATOR.
///
/// **CREATOR-PAYS, ONE CHARGE, ONE CREDIT** (design 10 ruling 6; design 7 D-3's
/// rule applied to an object with two names). The `process` field is who
/// `PipeCreate` charged, and it is credited here whichever process happened to
/// drop the last handle onto whichever end.
///
/// Its precondition is both columns at zero AND `pipe_idle` — no endpoint names
/// it and no exchange lives in it — so the ring slots are already `Free` and
/// there is nothing to unwind here.
public(package) func free_pipe(slot: Int) unsafe {
    // **NEITHER END CAN BE ATTACHED HERE, and the test is the invariant written
    // down** (sawos design 15, on the Event/Timer/Interrupt precedent in
    // `free_object`). An attachment is a counted reference on the END it
    // watches, so a connection whose columns are both zero has no watcher on
    // either side; if this ever fired, the ledger and the wait machinery would
    // have disagreed and a Waiter would be watching a recycled slot.
    if PIPES[slot].inlet_attachment != 0 || PIPES[slot].outlet_attachment != 0 {
        fatal_kernel("a pipe reached zero references while attached",
                     slot as UInt)
    }
    let owner = PIPES[slot].process
    PIPES[slot] = PipeSlot(state: SlotState.Free, process: 0, staged: 0,
                           inlet_attachment: 0, outlet_attachment: 0,
                           inlet_refs: 0, outlet_refs: 0)
    quota_credit(owner, QuotaKind.Pipe)
}

/// Can exchange `x` be given back — does nobody name it and is nothing owed?
///
/// **IT IS THE COUNTED-OBJECT RULE WITH ONE EXTRA CLAUSE** (sawos design 14
/// D-2). Both columns at zero is what says no handle can ever act on this
/// exchange again; the extra clause is that a `Staged` message is still OWED to a
/// live outlet whatever became of the claim — which is §2.1's TELL idiom (post,
/// drop the claim, and the server still receives the message) and design 230's
/// close-drains-first rule reaching one level down. Once the outlet column is
/// zero nobody can ever take it, so the message is owed to nobody and the slot
/// may go.
public(package) func exchange_can_settle(x: Int) unsafe -> Bool {
    if PIPE_REPLY_REFS[x] != 0 || PIPE_REQUEST_REFS[x] != 0 {
        return false
    }
    match PIPE_EX_STATE[x] {
        case Free -> false,
        case Staged -> PIPES[exchange_pipe(x)].outlet_refs == 0,
        case Taken -> true,
        case Replied -> true,
        // A DISCHARGED EXCHANGE OWES NOTHING BY CONSTRUCTION (sawos design 15):
        // the answer has already been handed to somebody through a wait record,
        // so there is nothing left for either side and only the columns are
        // holding the slot.
        case Settled -> true,
    }
}

/// Give exchange `x`'s ring slot back — **and the CONNECTION with it, if that
/// was the last thing keeping the row alive.**
///
/// The cascade is the one design 7's header describes over a different pair of
/// kinds, and it terminates for the same reason: an exchange references its
/// connection's storage and a connection references no exchange, so the graph is
/// a forest.
///
/// THE BYTES ARE NOT ZEROED, on `pipe_drop_staged`'s own reasoning: a staged or
/// replied body is bytes that were COPIED, the slot is unreachable until a later
/// post writes it, and every read of one is bounded by the length that post
/// recorded.
///
/// **IT ANSWERS WITH THE HANDLE REFERENCES THE EXCHANGE WAS STILL HOLDING, AND
/// THE CALLER MUST RELEASE THEM** (the Sep-2 re-rule of ruling 5). A settling
/// exchange may still be carrying a message nobody took, and under take-at-post
/// those handles are the KERNEL's references rather than notes about somebody
/// else's table — so forgetting them would leak the objects. Releasing them is
/// `kcore.refs`' job and this file sits below it, so the batch travels UP: the
/// ledger is emptied here, every other line of the settle runs, and the release
/// happens at the call site with the exchange already `Free`. That ordering is
/// not incidental — a release can take a pipe endpoint to zero and cascade back
/// into this very function, and by then there is nothing left here to corrupt.
public(package) func exchange_settle(x: Int) unsafe -> StagedRefs {
    // **NEITHER HALF CAN BE ATTACHED HERE** — `free_pipe`'s assert one level
    // down, and the same invariant: an attachment is a counted reference on the
    // column it watches, so both columns at zero means nobody is watching
    // either. If it ever fired, a Waiter would be holding a level on a ring slot
    // the next `Post` is about to write.
    if PIPE_REPLY_ATTACH[x] != 0 || PIPE_REQUEST_ATTACH[x] != 0 {
        fatal_kernel("an exchange settled while attached", x as UInt)
    }
    // **AND NO THREAD CAN BE PARKED ON IT EITHER** (sawos design 17), which is
    // the same invariant one kind of reference further along: a fused caller
    // counts on the CLAIM column, so both columns at zero means nobody is
    // parked. It is worth asserting for a sharper reason than the attachment
    // pair's — a parked caller is on no list at all, so a settle that lost one
    // would strand a thread nothing could ever reach again, which is precisely
    // what design 10 ruling 2 forbids.
    if PIPE_CALLER[x] != 0 {
        fatal_kernel("an exchange settled with a caller parked on it", x as UInt)
    }
    // **THE HELD REFERENCES COME OUT FIRST AND ARE RELEASED LAST** — collected
    // here so the ledger is already empty for anything the caller's release
    // cascades into, handed back so the release happens where releases live.
    let held = take_staged(x)
    PIPE_EX_STATE[x] = ExchangeState.Free
    PIPE_REPLY_REFS[x] = 0
    PIPE_REQUEST_REFS[x] = 0
    PIPE_LENS[x] = 0
    PIPE_NEXT[x] = 0

    let c = exchange_pipe(x)
    match PIPES[c].state {
        case Free -> {},
        case Live -> {
            if (PIPES[c].inlet_refs == 0 && PIPES[c].outlet_refs == 0
                && pipe_idle(c)) {
                free_pipe(c)
            }
        },
    }
    held
}

// **`pipe_drop_staged` MOVED TO `kcore.refs` IN M4 UNIT 4** (the Sep-2 re-rule
// of ruling 5). The outlet's zero-arm used to be pure bookkeeping — it forgot
// notes about somebody else's table — and take-at-post made it a RELEASE SITE:
// every staged message it drops is holding kernel references that have to go
// back. Releasing lives one module up, so the function went with it, beside the
// other last rites that unref. Its one caller was already there.

// =============================================================================
// The boot-handle queues, ONE PER PROCESS (spec §12; sawos design 2 D-3, as
// re-shaped by design 4 D-2)
// =============================================================================
//
// WHAT SOMEBODY MINTED FOR A PROCESS BEFORE IT RAN AND HAS NOT HANDED OVER YET.
// §12 keeps the boot set ONE HANDLE WIDE at the entry register, so everything
// else a process is furnished with has to be COLLECTED rather than passed, and
// this is where it waits.
//
// **THE QUEUE WENT PER-PROCESS IN M3 UNIT 3, and the reason is that there are
// two drainers now.** Unit 2's globals were correct for one — only root had a
// boot set, because a child was handed nothing — and are wrong for two: a
// launcher fills a child's set with `ProcessOp.Give`, and the child drains ITS
// OWN through its own Process handle exactly as root drains root's. The two
// producers are indistinguishable on purpose: THE KERNEL IS THE GIVER NOBODY
// GAVE TO, root's records are written at boot by exactly the machinery a give
// uses, and their tags are region ordinals because that is the config root and
// the build agreed on.
//
// THE STORAGE IS THE HANDLE TABLE'S OWN IDIOM — one flat array indexed
// `p * MAX_HANDLES + i`, with a count and a cursor per process — so the file has
// one shape for "per-process storage" rather than two. **`MAX_HANDLES` IS THE
// RIGHT BOUND AND NOT AN ARBITRARY ONE**: every record names a handle in that
// process's table, so a boot set larger than the table it fills could never be
// drained into existence.
//
// It is still a queue with a cursor and no removal: the cursor only ever
// advances, so a drained iterator STAYS drained and a delivered record can never
// be delivered twice. That is the whole of the lifetime rule, and it is why the
// records are plain storage rather than a slab. The set FREEZES at `Start` —
// enforced by the give's own `BadState` refusal, one level up — and the DRAIN
// has no deadline at all.

/// One boot handle waiting to be collected.
///
/// **`taken` IS WHICH DELIVERY ALREADY HAPPENED** (the Aug-29 user ruling on
/// design 4). A record leaves the set through one of two doors — the drain, or
/// `start(boot_tag:)` putting its word in the child's first argument register —
/// and a delivery through either spends it. The flag is what lets the SECOND
/// door reach into the middle of the queue, which a cursor alone cannot: a
/// resolved record may sit anywhere, and the drain simply skips it.
///
/// A TAG STAYS SPENT WHETHER OR NOT ITS RECORD WAS DELIVERED — `boot_tag_used`
/// scans the whole set, flag and all — because a tag is an IDENTITY for the
/// process's boot set, not a slot in a queue.
public(package) struct BootHandleSlot {
    public(package) tag: UInt,
    public(package) kind: BootHandleKind,
    public(package) handle: UInt,
    public(package) taken: Bool,
}

public(package) unsafe static var BOOT_HANDLES: [BootHandleSlot; MAX_PROCESSES * MAX_HANDLES] = [
    BootHandleSlot(tag: 0, kind: BootHandleKind.Memory, handle: 0, taken: false);
    MAX_PROCESSES * MAX_HANDLES]

/// How many records are queued for each process.
public(package) unsafe static var BOOT_HANDLE_COUNT: [Int; MAX_PROCESSES] = [0; MAX_PROCESSES]

/// How many each has collected. `NEXT[p] == COUNT[p]` is "drained".
public(package) unsafe static var BOOT_HANDLE_NEXT: [Int; MAX_PROCESSES] = [0; MAX_PROCESSES]

/// Is there room for one more record in process `p`'s set?
///
/// Asked BEFORE a give does anything, so a refusal leaves both tables untouched.
/// It can only ever answer `false` in theory — a record is queued beside a mint
/// into the same process's table, so the handle table fills first — and the test
/// is here anyway because a silently dropped record is a capability a child was
/// given and can never collect.
public(package) func boot_handle_room(p: Int) unsafe -> Bool {
    BOOT_HANDLE_COUNT[p] < MAX_HANDLES
}

/// Does process `p`'s set already carry `tag`?
///
/// **THE DUPLICATE-TAG CHECK, and it scans rather than indexes** (sawos design 4
/// D-2). A tag is the giver's own word and the kernel constrains it in no way,
/// so there is nothing to index by; the array is bounded by `MAX_HANDLES` and
/// tiny, and the walk runs once per give. It looks at the WHOLE set and not only
/// the undelivered part, because the tag is an IDENTITY for the process's whole
/// boot set — a tag reused after the child drained the first one would still name
/// two handles.
public(package) func boot_tag_used(p: Int, tag: UInt) unsafe -> Bool {
    var i: Int = 0
    while i < BOOT_HANDLE_COUNT[p] {
        if BOOT_HANDLES[p * MAX_HANDLES + i].tag == tag {
            return true
        }
        i = i + 1
    }
    false
}

/// TAKE the handle word process `p`'s set carries under `tag`, or `NO_HANDLE`
/// when no record carries it.
///
/// **`start(boot_tag:)`'s RESOLVER, AND IT CONSUMES** (the Aug-29 user ruling on
/// design 4). Putting the word in the child's first argument register IS the
/// delivery, so the record is marked spent and the drain will skip it — a child
/// is never handed one word twice, and the two-owners-of-one-word hazard that
/// the non-consuming reading created is unrepresentable rather than documented.
///
/// A record already taken answers `NO_HANDLE` too, which is the same answer a
/// tag nobody gave gets: both are "there is no word here to deliver", and the
/// caller turns either into the `BadArg` fault. Nothing today can reach the
/// second — a set freezes at start and start happens once — and the arm costs a
/// comparison.
public(package) func boot_handle_take(p: Int, tag: UInt) unsafe -> UInt {
    var i: Int = 0
    while i < BOOT_HANDLE_COUNT[p] {
        let at = p * MAX_HANDLES + i
        if BOOT_HANDLES[at].tag == tag && not BOOT_HANDLES[at].taken {
            BOOT_HANDLES[at].taken = true
            return BOOT_HANDLES[at].handle
        }
        i = i + 1
    }
    NO_HANDLE
}

/// Queue one record for process `p`. The caller has already asked
/// `boot_handle_room`; this is the one producer, and both doors — the kernel's
/// boot minting and a launcher's `give` — come through it.
public(package) func queue_boot_handle(p: Int, tag: UInt, kind: BootHandleKind,
                                       handle: UInt) unsafe {
    let n = BOOT_HANDLE_COUNT[p]
    BOOT_HANDLES[p * MAX_HANDLES + n] = BootHandleSlot(tag: tag, kind: kind,
                                                       handle: handle,
                                                       taken: false)
    BOOT_HANDLE_COUNT[p] = n + 1
}

/// Advance process `p`'s cursor past every record already delivered, and answer
/// where it now points.
///
/// **THE CURSOR ONLY EVER ADVANCES**, which is the whole of the lifetime rule and
/// is unchanged by the second delivery door: a record `start(boot_tag:)` took is
/// one the drain steps over, exactly as it steps over one it delivered itself.
/// So a drained iterator stays drained, and no record is ever handed out twice
/// however it left the set.
public(package) func boot_handle_cursor(p: Int) unsafe -> Int {
    var at = BOOT_HANDLE_NEXT[p]
    while at < BOOT_HANDLE_COUNT[p] && BOOT_HANDLES[p * MAX_HANDLES + at].taken {
        at = at + 1
    }
    BOOT_HANDLE_NEXT[p] = at
    at
}

/// Forget process `p`'s set. Called by the teardown.
///
/// **THE RECORDS ARE BOOKKEEPING AND CLEAR WITH THE SLOT** (sawos design 4 D-2).
/// The handles they name are entries in the dying process's own table, already
/// unbound by the close-all, so nothing is released here and nothing is leaked:
/// what is reset is the count and the cursor, which MUST be reset because a
/// process slot is reclaimable (design 3 D-3) and the next occupant would
/// otherwise inherit a stranger's boot set.
public(package) func clear_boot_handles(p: Int) unsafe {
    BOOT_HANDLE_COUNT[p] = 0
    BOOT_HANDLE_NEXT[p] = 0
}
