//! HANDLES AND THE OBJECTS THEY NAME (spec §2, §3, §5.7): the process-indexed
//! handle table, and the VALIDATED wrapper each object kind gets out of it.
//!
//! This is the vocabulary the dispatch is written in, held below every table it
//! indexes into: a `HandleEntry` says which kind and which slot, and the typed
//! wrappers pair a kind with its rights word so testing one kind's right against
//! another's object is a compile error rather than a bit comparison.
//!
//! `SlotState` is here rather than beside any one slab because four of them
//! answer the same question with it.

import sosabi.{
    ObjType,
    SystemHandle,
    ProcessHandle,
    ThreadHandle,
    EventHandle,
    WaiterHandle,
    InterruptHandle,
    ClockHandle,
    TimerHandle,
    SystemRight,
    ProcessRight,
    ThreadRight,
    EventRight,
    WaiterRight,
    InterruptRight,
    ClockRight,
    TimerRight,
    MemoryHandle,
    MemoryRight,
    BootHandleKind,
    NO_HANDLE,
    HANDLE_INDEX_BITS,
    HANDLE_INDEX_MASK,
    HANDLE_GENERATION_MODULUS,
}
import kcore.limits.{
    MAX_HANDLES,
    MAX_MEMORIES,
    MAX_PROCESSES,
    NO_MEMORY,
}

/// One handle-table entry: the object a handle names, the rights its holder has
/// on it (§3), WHICH object of that kind it is, and which LIFE of this slot it
/// belongs to.
///
/// `obj_type` is the typed tag; `rights` stays a plain `UInt32` because it is a
/// MASK — a set of bits, not one of the cases of any kind's rights enum. It is
/// deliberately NOT interpretable on its own: which enum's bits these are is
/// decided by `obj_type`, and the pairing happens below.
///
/// `target` is the object's slot in its kind's table. It was not needed while
/// the only object was a singleton; with Threads it is the whole point of the
/// entry, because "which thread" is exactly what a handle answers.
///
/// **`gen` SURVIVES THE UNBIND, and that is the whole mechanism** (sawos design
/// 3 D-1). It is the only field a release does not clear: unbinding zeroes the
/// binding and INCREMENTS the generation, so the next mint in this slot stamps
/// a word that no word handed out before it can equal. A stale word therefore
/// fails the equality test in `lookup_handle` and becomes the `Unbound` answer
/// the callers already turn into a `BadHandle` fault — which is what makes
/// use-after-release a DIAGNOSED bug rather than a silent alias onto whatever
/// took the slot.
///
/// It lives in the ENTRY rather than in a parallel array because the two are one
/// fact about one slot, and a second array would be a second place to forget.
public(package) struct HandleEntry {
    public(package) obj_type: ObjType,
    public(package) rights: UInt32,
    public(package) target: Int,
    public(package) gen: UInt32,
}

/// A System handle the dispatch has VALIDATED (§3).
///
/// This type is the pairing of a handle kind with its rights word, and it is
/// what makes the rights check typed rather than cosmetic. The only way to get
/// one is through `dispatch`, after the table resolved the handle to a System
/// object — so the type carries the claim "validated as System", and
/// `allows` can accept a `SystemRight` and nothing else. `ProcessObject` and
/// `ThreadObject` below are the same construction with their own rights enums,
/// so testing one kind's right against another's object is a compile error, not
/// a bit comparison that quietly returns an answer.
public(package) struct SystemObject {
    public(package) handle: SystemHandle,
    public(package) rights: UInt32,
}

extension SystemObject {
    /// Whether this holder may perform an op requiring `right`.
    ///
    /// The mask arithmetic lives here rather than at each call site, so the
    /// dispatch below reads as the question it is asking and there is one place
    /// to change when rights become a wider word.
    public(package) func allows(&self, right: SystemRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// A Process handle the dispatch has VALIDATED, paired with its rights and the
/// process slot it names.
public(package) struct ProcessObject {
    public(package) handle: ProcessHandle,
    public(package) rights: UInt32,
    public(package) slot: Int,
}

extension ProcessObject {
    public(package) func allows(&self, right: ProcessRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

