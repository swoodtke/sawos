/// A PipeInlet handle the dispatch has validated, paired with its rights and
/// the connection slot it names (spec §2.1).
///
/// `slot` names the connection, not an endpoint: both endpoint kinds target the
/// same `PIPES` row, and what makes this handle the client end is its
/// `obj_type`, established by §3's order before any right is read. Which
/// reference column it counts on, which op table it answers to and which rights
/// enum its word is read against all follow from that.
public(package) struct PipeInletObject {
    public(package) handle: PipeInletHandle,
    public(package) rights: UInt32,
    public(package) slot: Int,
}

extension PipeInletObject {
    public(package) func allows(&self, right: PipeInletRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// A PipeOutlet handle the dispatch has validated, paired with its rights and
/// the connection slot it names (spec §2.1).
///
/// Separate from `PipeInletObject`, as `IoMemoryObject` is from `MemoryObject`:
/// a function taking one of these can only have been handed the server end, so
/// "an inlet cannot take and an outlet cannot post" is a fact about which
/// `allows` compiles.
public(package) struct PipeOutletObject {
    public(package) handle: PipeOutletHandle,
    public(package) rights: UInt32,
    public(package) slot: Int,
}

extension PipeOutletObject {
    public(package) func allows(&self, right: PipeOutletRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// A PipeReply handle the dispatch has validated: the client's claim on one
/// reply, paired with the exchange it names (spec §2.1).
///
/// `slot` names an exchange, which is a ring slot:
/// `connection * PIPE_INFLIGHT + ring index`, the same flat arithmetic the
/// bodies and lengths use. The claim is ring-slot state; there is no third
/// slab, because a one-shot pair exists for exactly as long as one in-flight
/// message does.
public(package) struct PipeReplyObject {
    public(package) handle: PipeReplyHandle,
    public(package) rights: UInt32,
    public(package) slot: Int,
}

extension PipeReplyObject {
    public(package) func allows(&self, right: PipeReplyRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// A PipeRequest handle the dispatch has validated: the server's obligation,
/// paired with the exchange it names (spec §2.1).
///
/// The mirror of `PipeReplyObject`, and separate for the same reason as
/// `PipeOutletObject`: "a claim cannot reply and an obligation cannot resolve"
/// is a fact about which `allows` compiles.
public(package) struct PipeRequestObject {
    public(package) handle: PipeRequestHandle,
    public(package) rights: UInt32,
    public(package) slot: Int,
}

extension PipeRequestObject {
    public(package) func allows(&self, right: PipeRequestRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// Whether a slot of a stateless kind (an Event or a Waiter, say) is in use.
///
/// One enum for all of them because it is one question. Threads and processes
/// have state machines (a join arriving after the exit still has to find the
/// code), while an Event and a Waiter are either there or not: an Event's whole
/// state is its accumulated word, and a Waiter's is its two lists.
public(package) enum SlotState: UInt8 {
    case Free = 0,
    case Live = 1,
}

// -----------------------------------------------------------------------------
// The handle table (spec §3) and the split word
// -----------------------------------------------------------------------------

// The table must fit the index field. `sosabi` owns the encoding and
// `kcore.limits` owns the table size, so the bound tying them belongs here.
//
// The comparison is `<=` because the field carries a 1-based index: the largest
// value it must hold is `MAX_HANDLES` itself (naming slot `MAX_HANDLES - 1`).
// Zero means "names nothing", so a field of `HANDLE_INDEX_BITS` bits addresses
// `HANDLE_INDEX_MASK` slots and no more. Raising `MAX_HANDLES` past that fails
// the build here rather than silently aliasing slot 1 onto slot 257.
static_assert(MAX_HANDLES <= (1 << HANDLE_INDEX_BITS) - 1,
              "MAX_HANDLES must fit the handle word's index field — raise HANDLE_INDEX_BITS")

/// The Unbound answer: what a word that resolves to nothing looks like.
///
/// One constructor, because `lookup_handle` has three ways to reach it and they
/// must be the same answer: callers turn it into one `BadHandle` fault.
func unbound_entry() -> HandleEntry {
    HandleEntry(obj_type: ObjType.Unbound, rights: 0, target: 0, gen: 0)
}

/// The 0-based table index a handle word names, or a number past `MAX_HANDLES`
/// when it names none.
///
/// The index field is 1-based, so zero is not an index and "handle 0 names
/// nothing". `NO_HANDLE` is the index field's zero at every generation, so a
/// malformed word like `0x100` (generation 1 over a zero index, at the default
/// split) names nothing exactly as a plain `0` does; testing the word against
/// `NO_HANDLE` would miss that, testing the field cannot. The 1-based spelling
/// also keeps slot 0 usable and generation 0 free to mean "first life".
///
/// A zero field answers `MAX_HANDLES` rather than a separate signal, so the one
/// range test in the caller covers both refusals.
///
/// `public(package)` for the release op, which has a word and a resolved entry
/// and needs the index to unbind. It uses the same function as `lookup_handle`,
/// so the two can never disagree about which slot a word names.
public(package) func handle_word_index(word: UInt) unsafe -> Int {
    let byte = word & HANDLE_INDEX_MASK
    if byte == 0 {
        return MAX_HANDLES
    }
    (byte as Int) - 1
}

/// The generation a handle word claims: everything above its index field.
///
/// It is neither narrowed nor masked. Narrowing to `UInt32` with `as` would
/// panic inside the kernel on a 64-bit profile over a word a process chose,
/// which a decode at the trap boundary must never do. Masking to the generation
/// field's width would let a word with garbage above bit 31 compare equal to a
/// low generation and resolve.
///
/// Answering the whole field in the word's own width makes the comparison in
/// `lookup_handle` do the range check: a stored generation is always below
/// `HANDLE_GENERATION_MODULUS`, so a word claiming a wider generation equals no
/// entry and names nothing. The top half of a 64-bit word is thereby enforced
/// to be zero.
func handle_word_generation(word: UInt) unsafe -> UInt {
    word >> HANDLE_INDEX_BITS
}

/// Build the word for slot index `i` at generation `gen`.
///
/// `gen == 0` yields the bare 1-based index, so a slot's first-life word is the
/// plain index. Spec §12's boot order (System, Process, Thread are words 1, 2,
/// 3) and hand-assembled payloads depend on that.
func handle_word(index: Int, gen: UInt32) unsafe -> UInt {
    ((gen as UInt) << HANDLE_INDEX_BITS) | ((index as UInt) + 1)
}

/// Resolve a handle in a process's table.
///
/// An out-of-range, unbound or stale handle resolves to `ObjType.Unbound`, and
/// the rights travel with the entry rather than being assumed by the op.
///
/// Three ways to name nothing, one answer for all: a word whose index field is
/// not an index (zero at any generation, or past the table), a slot that holds
/// no binding, and a slot whose generation has moved on since this word was
/// handed out. In the last case the word points at a live slot with the wrong
/// life, and the caller's `BadHandle` fault is the diagnosis.
public(package) func lookup_handle(p: Int, h: UInt) unsafe -> HandleEntry {
    let index = handle_word_index(h)
    if index >= MAX_HANDLES {
        return unbound_entry()
    }
    let entry = PROCESSES[body_of(p)].handles[index]
    match entry.obj_type {
        case Unbound -> unbound_entry(),
        case _ -> {
            if (entry.gen as UInt) != handle_word_generation(h) {
                return unbound_entry()
            }
            entry
        },
    }
}

/// Mint a handle naming `target` of kind `kind` with `rights`, in process `p`'s
/// table. Returns `NO_HANDLE` when the table is full or the quota is spent;
/// `mint_refusal` tells the two apart for the status.
///
/// The lowest free index wins, so a released slot is the one the next mint
/// reuses. The word carries the slot's surviving generation, so the reuse is
/// visible in the word and the old word is stale rather than aliasing.
///
/// The handle row is charged here, policy before the table: a process at its
/// handle budget is refused before the table is walked, matching the check
/// order of every other allocation site.
public(package) func mint_handle(p: Int, kind: ObjType, rights: UInt32, target: Int) unsafe -> UInt {
    if not quota_room(p, QuotaKind.Handle) {
        return NO_HANDLE
    }
    let b = body_of(p)
    var h: Int = 0
    while h < MAX_HANDLES {
        let entry = PROCESSES[b].handles[h]
        match entry.obj_type {
            case Unbound -> {
                PROCESSES[b].handles[h] = HandleEntry(obj_type: kind,
                                                      rights: rights,
                                                      target: target,
                                                      gen: entry.gen)
                quota_charge(p, QuotaKind.Handle)
                return handle_word(h, entry.gen)
            },
            case _ -> {},
        }
        h = h + 1
    }
    NO_HANDLE
}

/// Whether `p`'s table can accept `n` more entries, both by quota and by free
/// slots. This is the rendezvous's atomic pre-flight.
///
/// It asks `mint_handle`'s two questions `n` times over without answering
/// either: the quota first, then a bounded count of the free slots. A take or
/// delivery that carries handles calls this once, before it moves anything, so
/// a refusal leaves the staged message where it was and the level it raised
/// still raised.
///
/// It counts rather than reserving: a reservation would have to be given back
/// on every path that does not use it, and the caller is inside a single
/// syscall with interrupts masked, so nothing can take a slot between the count
/// and the mints.
public(package) func table_room(p: Int, n: Int) unsafe -> Bool {
    if not quota_room_for(p, QuotaKind.Handle, n) {
        return false
    }
    let b = body_of(p)
    var free: Int = 0
    var h: Int = 0
    while h < MAX_HANDLES {
        match PROCESSES[b].handles[h].obj_type {
            case Unbound -> { free = free + 1 },
            case _ -> {},
        }
        h = h + 1
    }
    free >= n
}

/// Unbind the entry at index `i` of process `p`'s table and bump its
/// generation.
///
/// This is the one place a binding is destroyed: the release op and the
/// teardown's close-all both come through here, so release and teardown do the
/// same thing to a slot. It never touches the object the entry named or its
/// reference count; the caller drops the reference (`unref_object` frees at
/// zero, and the teardown's `unref_teardown` does not).
///
/// The generation wraps at `HANDLE_GENERATION_MODULUS` rather than saturating.
/// After that many reuses of one slot a word can alias again; this is
/// best-effort bug detection, and since the table is per-process a wrap
/// collision crosses no boundary and grants nothing.
///
/// The index must be bound. Unbinding an unbound slot would bump the
/// generation and credit the handle quota for an entry that no longer exists,
/// so it is a kernel bug and stops the machine.
public(package) func unbind_handle(p: Int, index: Int) unsafe {
    let b = body_of(p)
    let entry = PROCESSES[b].handles[index]
    match entry.obj_type {
        case Unbound -> {
            fatal_kernel("an unbound handle slot was unbound", index as UInt)
        },
        case _ -> {},
    }
    let next = (entry.gen + 1) % HANDLE_GENERATION_MODULUS
    PROCESSES[b].handles[index] = HandleEntry(obj_type: ObjType.Unbound,
                                              rights: 0, target: 0,
                                              gen: next)
    // Credited at the one place a binding is destroyed, so the entry count and
    // the quota count are the same fact.
    quota_credit(p, QuotaKind.Handle)
}

// =============================================================================
// The quota ledger (spec §2.9)
// =============================================================================
//
// The ledger is a pair of rows on the process record
// (`PROCESS_RECORDS[p].quota_used` / `.quota_limit`), indexed by `QuotaKind`.
// The handle row is charged inside `mint_handle` and credited inside
// `unbind_handle`, which is why the record lives below this file.
//
// Two rows per kind: what is spent, and what may be. A charge happens at the
// allocation sites that answer `NoResource`, policy first: the quota is asked
// before the machine is, so a process at its budget is told whose limit it met.
// A credit happens where the thing is actually returned: `free_object` for the
// refcounted kinds, `Unmap` for the mapping row, and the teardown for
// everything at once.
//
// Nothing here is indexed by `ObjType`. The kinds with a budget are not the
// kinds with a slab (a Clock is kernel-eternal, a System object is a singleton,
// and handles are counted though they have no slab), so this is its own closed
// set. A new `QuotaKind` case needs a line in `install_quota_limits`; without
// one its limit stays zero and a process can hold none of it.

/// "No policy cap on this row: the machine answers."
///
/// This is how root's limits are the slab sizes. Writing root's rows as the
/// slab sizes would put a policy cap exactly where the machine refuses, and
/// since the quota is asked first, every `NoResource` root was answered with
/// would become a `QuotaExceeded`. With the sentinel the slab is what refuses
/// root.
public(package) static QUOTA_UNLIMITED: UInt16 = 0xFFFF

/// Which column of a process's two ledger rows `kind` is.
///
/// The value of `QuotaKind` is the column index; this keeps that cast in one
/// place rather than at every site.
func quota_column(kind: QuotaKind) -> Int {
    (kind as UInt8) as Int
}

/// Has `p` room for one more of `kind`?
///
/// Asked before the slab is, at every allocation site, so a caller can tell "my
/// budget" from "the machine's edge".
public(package) func quota_room(p: Int, kind: QuotaKind) unsafe -> Bool {
    let at = quota_column(kind)
    let limit = PROCESS_RECORDS[p].quota_limit[at]
    if limit == QUOTA_UNLIMITED {
        return true
    }
    PROCESS_RECORDS[p].quota_used[at] < limit
}

/// Has `p` room for `n` more of `kind`?
///
/// A take that carries handles mints several entries at once and must refuse
/// atomically (the message stays staged, the level stays ready, the answer is
/// the table-full status), so the question is asked about the whole batch
/// before any of it happens. `n == 0` is legal and answers true.
public(package) func quota_room_for(p: Int, kind: QuotaKind, n: Int) unsafe -> Bool {
    let at = quota_column(kind)
    let limit = PROCESS_RECORDS[p].quota_limit[at]
    if limit == QUOTA_UNLIMITED {
        return true
    }
    ((PROCESS_RECORDS[p].quota_used[at] as Int) + n) <= (limit as Int)
}

/// Spend one of `kind` against `p`.
///
/// Call only once every refusal is behind you: a charge made before a slab
/// refusal would leave a process paying for an object it never got.
public(package) func quota_charge(p: Int, kind: QuotaKind) unsafe {
    let at = quota_column(kind)
    let spent = PROCESS_RECORDS[p].quota_used[at]
    PROCESS_RECORDS[p].quota_used[at] = spent + 1
}

/// Give one of `kind` back to `p`.
///
/// The zero test is a defence, not a write-off: the teardown disowns every
/// shared object still charged to a dying process before it clears the ledger
/// (`credit_shared`), so no credit is owed to a cleared row. Giving back what
/// nobody is charged for does nothing rather than underflow.
public(package) func quota_credit(p: Int, kind: QuotaKind) unsafe {
    let at = quota_column(kind)
    let spent = PROCESS_RECORDS[p].quota_used[at]
    if spent != 0 {
        PROCESS_RECORDS[p].quota_used[at] = spent - 1
    }
}

/// Give one of shared `kind` back to `owner`, the `process` field of the
/// object being freed, if the object still has an owner.
///
/// A shared kind (a connection, a Memory, an IoMemory, an Event) can outlive
/// the process charged for it. That process's teardown disowns it, writing
/// `NO_PROCESS` into its `process` field (spec §2.10's refund rule), and the
/// charge goes with the dead process's ledger. A disowned object's free credits
/// nobody, so a refund can never reach a later occupant of the dead process's
/// record.
public(package) func credit_shared(owner: Int, kind: QuotaKind) unsafe {
    if owner == NO_PROCESS {
        return
    }
    quota_credit(owner, kind)
}

/// Forget process `p`'s ledger. Called by the teardown.
///
/// A Gone process's rows zero at its teardown, so everything it was ever
/// charged for is written off and the books balance by construction. Both rows
/// go, not only the used ones: a record is reclaimable and the next occupant
/// must not inherit a stranger's allowance.
public(package) func quota_clear(p: Int) unsafe {
    var i: Int = 0
    while i < QUOTA_KINDS {
        PROCESS_RECORDS[p].quota_used[i] = 0
        PROCESS_RECORDS[p].quota_limit[i] = 0
        i = i + 1
    }
}

/// Write one row of `p`'s allowance.
func set_limit(p: Int, kind: QuotaKind, value: UInt16) unsafe {
    PROCESS_RECORDS[p].quota_limit[quota_column(kind)] = value
}

/// Give process `p` its allowance, and zero what it has spent.
///
/// Root's cap is the machine, so every row but the mapping row is
/// `QUOTA_UNLIMITED` and the slab is what refuses it. A child gets
/// `kcore.limits`' documented defaults, all visibly under their slabs.
///
/// The mapping row is clamped for both. `free_rows` is what the target's domain
/// has left after its image spent its own, which no `static_assert` can know
/// since how many rows an image takes is a property of the image. Capping the
/// row at it makes "quota limit <= free rows" true for every process by
/// construction, so `install_row` cannot meet the physical wall with quota
/// headroom left and its `fatal` is a consequence rather than a hope. Root is
/// capped too: the row budget is the machine, stated in the ledger's
/// vocabulary.
///
/// Call once per process life (at boot for root, at `process_create` for a
/// child), always after the image's rows are recorded, because `free_rows` is
/// read from the record.
public(package) func install_quota_limits(p: Int, root: Bool, free_rows: Int) unsafe {
    var i: Int = 0
    while i < QUOTA_KINDS {
        PROCESS_RECORDS[p].quota_used[i] = 0
        i = i + 1
    }

    if root {
        set_limit(p, QuotaKind.Thread, QUOTA_UNLIMITED)
        set_limit(p, QuotaKind.Event, QUOTA_UNLIMITED)
        set_limit(p, QuotaKind.Waiter, QUOTA_UNLIMITED)
        set_limit(p, QuotaKind.Interrupt, QUOTA_UNLIMITED)
        set_limit(p, QuotaKind.Timer, QUOTA_UNLIMITED)
        set_limit(p, QuotaKind.Memory, QUOTA_UNLIMITED)
        set_limit(p, QuotaKind.IoMemory, QUOTA_UNLIMITED)
        set_limit(p, QuotaKind.Handle, QUOTA_UNLIMITED)
        set_limit(p, QuotaKind.Pipe, QUOTA_UNLIMITED)
    } else {
        set_limit(p, QuotaKind.Thread, DEFAULT_QUOTA_THREADS as UInt16)
        set_limit(p, QuotaKind.Event, DEFAULT_QUOTA_EVENTS as UInt16)
        set_limit(p, QuotaKind.Waiter, DEFAULT_QUOTA_WAITERS as UInt16)
        set_limit(p, QuotaKind.Interrupt, DEFAULT_QUOTA_INTERRUPTS as UInt16)
        set_limit(p, QuotaKind.Timer, DEFAULT_QUOTA_TIMERS as UInt16)
        set_limit(p, QuotaKind.Memory, DEFAULT_QUOTA_MEMORIES as UInt16)
        set_limit(p, QuotaKind.IoMemory, DEFAULT_QUOTA_IOMEMORIES as UInt16)
        set_limit(p, QuotaKind.Handle, DEFAULT_QUOTA_HANDLES as UInt16)
        set_limit(p, QuotaKind.Pipe, DEFAULT_QUOTA_PIPES as UInt16)
    }

    // A record that somehow holds more rows than the profile grants would make
    // this negative, and a negative allowance is not a number — zero is.
    let rows = if free_rows < 0 { 0 } else { free_rows }
    let want = if root { MAX_MAPPINGS } else { DEFAULT_QUOTA_MAPPINGS }
    let mappings = if want < rows { want } else { rows }
    set_limit(p, QuotaKind.Mapping, mappings as UInt16)
}

/// Which refusal a `mint_handle` that answered `NO_HANDLE` was.
///
/// The word has one sentinel for both, so this re-asks the mint's first
/// question: a caller with no handle room left met its budget, anyone else met
/// the table. Every mint site already tests for `NO_HANDLE`; this turns that
/// test into the right status without changing its shape.
public(package) func mint_refusal(p: Int) unsafe -> SosStatus {
    if quota_room(p, QuotaKind.Handle) {
        return SosStatus.NoResource
    }
    SosStatus.QuotaExceeded
}

// =============================================================================
// The Memory slab (spec §2.5)
// =============================================================================
//
// The Memory, IoMemory and Mapping slabs live here beside the handle table,
// with storage, an allocator per slab and one index fixup; the verbs (`Split`,
// `Carve`, `Map`, `Unmap`) live in the dispatch. They sit below `process` as
// every slab does: ending a process frees what it owned, so the storage has to
// be reachable from the teardown.

/// One Memory object: a range of physical memory, whose it is, and which pool
/// the bytes came out of.
///
/// `len` rather than a top address, because that is the shape the region table
/// carries and a pool hands out. Compute the top where needed, with the bound
/// test ordered so the addition cannot overflow.
///
/// Two counts, and the range goes back at the second zero. §2.5 says a region
/// is freed only when the last reference of either kind (any MemoryObject
/// handle or any Mapping) drops: `refs` counts the first kind and `maps` the
/// second.
///
/// `free_head`, `out_bytes` and `dropped` are the pool's, meaningful only on a
/// root. A pool is not a separate object kind: it is the boot-minted region
/// every derived region points back at, so its ledger lives on its own slot.
/// They read as zero on every derived region and nothing asks them there.
public(package) struct MemorySlot {
    public(package) state: SlotState,
    /// The process charged for this region, or `NO_PROCESS` once that process
    /// has died and disowned it (spec §2.10).
    public(package) process: Int,
    public(package) base: UInt,
    public(package) len: UInt,
    /// How many handle entries name this region.
    public(package) refs: UInt16,
    /// How many installed grant rows name this region: the second of §2.5's two
    /// reference kinds.
    ///
    /// It counts rows, not `Mapping` objects. A Mapping object and its row have
    /// different lifetimes (the husk arm frees the slot and leaves the row
    /// installed), so counting objects would lose the row that is still
    /// granting these bytes the moment its last handle went. A row is born in
    /// `record_grant` and dies in `remove_grant` or `clear_domain`; those three
    /// sites are where this count moves.
    public(package) maps: UInt16,
    /// The pool root these bytes belong to: a boot-minted region names itself,
    /// and a split carries its parent's answer down.
    ///
    /// The derivation chain is a cursor artifact, not an ownership tree: a
    /// piece cut from a piece returns to the pool, not to the intermediate
    /// region it was cut from.
    public(package) root: Int,
    /// Root only: the head of this pool's free list, node index + 1, 0 empty.
    public(package) free_head: Int,
    /// Root only: bytes handed out of this pool and not yet returned.
    ///
    /// With `pool_free_bytes` this is §5.9's byte accounting: outstanding here,
    /// free there. Quotas stay object-counted; bytes are the pool's business.
    /// It is also the third count in a root's release condition (see
    /// `memory_release_if_idle`), which keeps a derived region's back-reference
    /// from ever naming a slot that has been given away.
    public(package) out_bytes: UInt,
    /// Root only: bytes lost to free-node exhaustion, counted rather than
    /// silent.
    ///
    /// Release is infallible: a range that finds no node after coalescing is
    /// leaked and counted here, because refusing a release would mean an object
    /// that cannot be given up. Reaching this takes a pool fragmented into more
    /// than `MAX_FREE_RANGES` holes.
    public(package) dropped: UInt,
}

// `MAX_MEMORIES` is the length of the inline extent; donated extents add slots.
// A Memory slot is the object: donating slots raises how many regions can exist
// at once without adding a byte to any pool.
public(package) unsafe static var MEMORIES: Slab<MemorySlot, MAX_MEMORIES> = Slab<MemorySlot, MAX_MEMORIES>(
    inline: [MemorySlot(state: SlotState.Free, process: 0, base: 0, len: 0,
                        refs: 0, maps: 0, root: NO_MEMORY, free_head: 0,
                        out_bytes: 0, dropped: 0); MAX_MEMORIES],
    ext_base: [0; MAX_SLAB_EXTENTS],
    ext_slots: [0; MAX_SLAB_EXTENTS],
    ext_side: [0; MAX_SLAB_EXTENTS],
    ext_count: 0,
    total: MAX_MEMORIES)

/// Take a free Memory slot, or `NO_MEMORY` when the slab is full.
public(package) func alloc_memory() unsafe -> Int {
    var i: Int = 0
    while i < MEMORIES.capacity() {
        match MEMORIES[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_MEMORY
}

// -----------------------------------------------------------------------------
// The pool: spent bytes come back (spec §2.5, §5.9)
// -----------------------------------------------------------------------------
//
// A region knows its pool root. When both of its counts are zero its range goes
// back to that root. A returned range coalesces with its free neighbours, and
// one that touches the root's unspent frontier folds back into the cursor, so a
// fully-freed pool returns to its boot state. A `Split` takes the first fit off
// the free list and falls back to the cursor.
//
// The cursor is the empty-free-list fast path and what a fresh pool is. A
// cut-and-drop loop allocates and frees the same range forever and never
// touches a node.
//
// Only a root draws on the list. This is an authority rule: a derived region
// names exactly its own range, and serving its `Split` out of the pool's list
// would hand its holder bytes it never had. A pool root's cut ranges are on
// loan, and a returned loan is the pool's again.
//
// IoMemory is untouched (§5.9's carve-out): a carve leaves the parent whole,
// MMIO is pinned, and nothing is ever placed in or returned from those bytes.

/// One free range on a pool's list: where it is, how big, and what follows it.
///
/// The list is kept sorted by base, so coalescing is two comparisons against
/// the immediate neighbours and first-fit is a walk that stops.
public(package) struct FreeRange {
    public(package) state: SlotState,
    public(package) base: UInt,
    public(package) len: UInt,
    /// The next node of this pool's list: node index + 1, 0 = end.
    ///
    /// Index + 1 rather than a `-1` sentinel, matching every other list in this
    /// kernel (`WaiterSlot.attached`, an attachment's `link`), so a zeroed slab
    /// is an empty list by construction.
    public(package) next: Int,
}

// A donatable slab: a returned range that coalesces into nothing and finds no
// node is added to its pool's `dropped` and lost, because release is
// infallible. Donating nodes lets the same release find a node and the bytes
// come home.
//
// It is `public(package)` because the donation dispatch names every donatable
// slab in one `match` and sits above `waitables`, so it cannot live in this
// file.
public(package) unsafe static var FREE_RANGES: Slab<FreeRange, MAX_FREE_RANGES> = Slab<FreeRange, MAX_FREE_RANGES>(
    inline: [FreeRange(state: SlotState.Free, base: 0, len: 0,
                       next: 0); MAX_FREE_RANGES],
    ext_base: [0; MAX_SLAB_EXTENTS],
    ext_slots: [0; MAX_SLAB_EXTENTS],
    ext_side: [0; MAX_SLAB_EXTENTS],
    ext_count: 0,
    total: MAX_FREE_RANGES)

/// Take a free node, or `NO_FREE_RANGE` when the slab is full.
func alloc_free_range() unsafe -> Int {
    var i: Int = 0
    while i < FREE_RANGES.capacity() {
        match FREE_RANGES[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_FREE_RANGE
}

/// Give one node back.
func free_free_range(n: Int) unsafe {
    FREE_RANGES[n] = FreeRange(state: SlotState.Free, base: 0, len: 0, next: 0)
}

/// The bytes pool `root` has ready to hand out: its unspent frontier plus every
/// free range on its list.
///
/// `out_bytes` is what is on loan, this is what is home, and `dropped` is what
/// was lost; together they are §5.9's byte accounting.
public(package) func pool_free_bytes(root: Int) unsafe -> UInt {
    var total = MEMORIES[root].len
    var cur = MEMORIES[root].free_head
    while cur != 0 {
        let n = cur - 1
        total = total + FREE_RANGES[n].len
        cur = FREE_RANGES[n].next
    }
    total
}

/// Can region `slot` serve a cut of `len` bytes, from its own cursor or (for a
/// pool root) from one range on its free list?
///
/// This is the `Split` refusal. The question is whether the pool can hand out
/// `len` bytes in one range, which is what a region is, not whether it holds
/// that many in total. Two non-adjacent halves of the ask answer no: that is
/// fragmentation rather than exhaustion.
public(package) func pool_can_serve(slot: Int, len: UInt) unsafe -> Bool {
    if MEMORIES[slot].len >= len {
        return true
    }
    if MEMORIES[slot].root != slot {
        return false
    }
    var cur = MEMORIES[slot].free_head
    while cur != 0 {
        let n = cur - 1
        if FREE_RANGES[n].len >= len {
            return true
        }
        cur = FREE_RANGES[n].next
    }
    false
}

/// Cut `len` bytes out of region `slot` and answer where they are.
///
/// First fit first, cursor second. Taking the list first keeps the frontier
/// unspent as long as possible, so a recycled pool stays whole at its top edge
/// instead of fragmenting outward.
///
/// The caller has asked `pool_can_serve` and been told yes. A wall reached with
/// the check passed is the kernel's bug, so it stops the machine rather than
/// inventing a status.
public(package) func pool_cut(slot: Int, len: UInt) unsafe -> UInt {
    let root = MEMORIES[slot].root
    if root == slot {
        var prev: Int = NO_FREE_RANGE
        var cur = MEMORIES[slot].free_head
        while cur != 0 {
            let n = cur - 1
            if FREE_RANGES[n].len >= len {
                // The front of the hole, as the cursor hands out its own front.
                let base = FREE_RANGES[n].base
                FREE_RANGES[n].base = base + len
                FREE_RANGES[n].len = FREE_RANGES[n].len - len
                if FREE_RANGES[n].len == 0 {
                    if prev == NO_FREE_RANGE {
                        MEMORIES[slot].free_head = FREE_RANGES[n].next
                    } else {
                        FREE_RANGES[prev].next = FREE_RANGES[n].next
                    }
                    free_free_range(n)
                }
                MEMORIES[root].out_bytes = MEMORIES[root].out_bytes + len
                return base
            }
            prev = n
            cur = FREE_RANGES[n].next
        }
    }
    if MEMORIES[slot].len < len {
        fatal_kernel("a split cut bytes its region does not have", len)
        // `fatal_kernel` stops the machine but is not declared `-> Never`, so
        // the scope has to exit itself.
        return 0
    }
    let base = MEMORIES[slot].base
    MEMORIES[slot].base = base + len
    MEMORIES[slot].len = MEMORIES[slot].len - len
    // Bytes leave the pool only at the root. A cut from a derived region moves
    // bytes already on loan from one holder to another, so the ledger does not
    // move; each piece returns its own length and the parent returns whatever
    // its cursor has left.
    if root == slot {
        MEMORIES[root].out_bytes = MEMORIES[root].out_bytes + len
    }
    base
}

/// Put `[base, base + len)` back on pool `root`'s free list, coalescing.
///
/// A range that touches the free neighbour below it grows that node; one that
/// touches the neighbour above grows that one; one that touches both merges
/// three into one and gives a node back. Only a range with free space on
/// neither side needs a node of its own, so the list is as long as the pool is
/// fragmented, not as long as it is busy.
func pool_insert_range(root: Int, base: UInt, len: UInt) unsafe {
    var prev: Int = NO_FREE_RANGE
    var cur = MEMORIES[root].free_head
    while cur != 0 {
        let n = cur - 1
        if FREE_RANGES[n].base > base {
            break
        }
        prev = n
        cur = FREE_RANGES[n].next
    }
    let next = if cur == 0 { NO_FREE_RANGE } else { cur - 1 }

    var b = base
    var l = len
    var into: Int = NO_FREE_RANGE
    if prev != NO_FREE_RANGE {
        if FREE_RANGES[prev].base + FREE_RANGES[prev].len == b {
            FREE_RANGES[prev].len = FREE_RANGES[prev].len + l
            b = FREE_RANGES[prev].base
            l = FREE_RANGES[prev].len
            into = prev
        }
    }
    if next != NO_FREE_RANGE {
        if b + l == FREE_RANGES[next].base {
            if into == NO_FREE_RANGE {
                FREE_RANGES[next].base = b
                FREE_RANGES[next].len = FREE_RANGES[next].len + l
                into = next
            } else {
                // Three into one; the node in the middle comes back.
                FREE_RANGES[into].len = FREE_RANGES[into].len + FREE_RANGES[next].len
                FREE_RANGES[into].next = FREE_RANGES[next].next
                free_free_range(next)
            }
        }
    }
    if into != NO_FREE_RANGE {
        return
    }

    let n = alloc_free_range()
    if n == NO_FREE_RANGE {
        // A release cannot fail: an object whose last reference cannot be given
        // up is worse than a hole in a pool, and a silent hole is worse than a
        // counted one.
        MEMORIES[root].dropped = MEMORIES[root].dropped + l
        return
    }
    FREE_RANGES[n] = FreeRange(state: SlotState.Live, base: b, len: l, next: cur)
    if prev == NO_FREE_RANGE {
        MEMORIES[root].free_head = n + 1
    } else {
        FREE_RANGES[prev].next = n + 1
    }
}

/// Fold the free range that touches pool `root`'s unspent frontier back into
/// the cursor, so a fully-freed pool is whole again.
///
/// Only the last node can touch the frontier: bytes are cut from the front, so
/// every range ever handed out lies below it, and the list is sorted. One pass
/// suffices, because the coalescing invariant leaves no two free ranges
/// adjacent, so the node below the one just absorbed cannot also be touching.
func pool_fold_frontier(root: Int) unsafe {
    var prev: Int = NO_FREE_RANGE
    var cur = MEMORIES[root].free_head
    while cur != 0 {
        let n = cur - 1
        if FREE_RANGES[n].next == 0 {
            if FREE_RANGES[n].base + FREE_RANGES[n].len == MEMORIES[root].base {
                MEMORIES[root].base = FREE_RANGES[n].base
                MEMORIES[root].len = MEMORIES[root].len + FREE_RANGES[n].len
                if prev == NO_FREE_RANGE {
                    MEMORIES[root].free_head = 0
                } else {
                    FREE_RANGES[prev].next = 0
                }
                free_free_range(n)
            }
            return
        }
        prev = n
        cur = FREE_RANGES[n].next
    }
}

/// Give `[base, base + len)` back to pool `root`, and take it off the loan
/// ledger.
func pool_return(root: Int, base: UInt, len: UInt) unsafe {
    if len == 0 {
        return
    }
    // A pool that is not there is a kernel bug, not a case to handle: a root's
    // own release refuses while any of its bytes are out (see
    // `memory_release_if_idle`), so every live back-reference names a live
    // pool.
    match MEMORIES[root].state {
        case Live -> {},
        case Free -> {
            fatal_kernel("a region returned its range to a pool that is gone",
                         root as UInt)
            return
        },
    }
    if MEMORIES[root].out_bytes < len {
        fatal_kernel("a pool got back more bytes than it ever lent", len)
        return
    }
    MEMORIES[root].out_bytes = MEMORIES[root].out_bytes - len
    pool_insert_range(root, base, len)
    pool_fold_frontier(root)
}

/// Give every node of pool `root`'s free list back to the slab.
///
/// Reached only when the pool itself is going. The bytes those nodes described
/// die with the pool.
func pool_drop_nodes(root: Int) unsafe {
    var cur = MEMORIES[root].free_head
    while cur != 0 {
        let n = cur - 1
        let next = FREE_RANGES[n].next
        free_free_range(n)
        cur = next
    }
    MEMORIES[root].free_head = 0
}

/// A grant row now names region `region`. Count it.
///
/// `NO_MEMORY` is the ordinary case, not an error: an image segment's row, a
/// stack row and a device row name no region, and taking that arm here keeps
/// the call sites in `process` unconditional.
public(package) func ref_region_row(region: Int) unsafe {
    if region == NO_MEMORY {
        return
    }
    MEMORIES[region].maps = MEMORIES[region].maps + 1
}

/// A grant row that named region `region` is gone, from an `Unmap` or from the
/// target's teardown. Count it out, and release the region if that was its
/// second zero.
public(package) func unref_region_row(region: Int) unsafe {
    if region == NO_MEMORY {
        return
    }
    if MEMORIES[region].maps == 0 {
        // Invariant: a region does not free while a row names it, so no row can
        // outlive the slot it points at and be found here.
        fatal_kernel("a grant row was removed from a region with no rows",
                     region as UInt)
        return
    }
    MEMORIES[region].maps = MEMORIES[region].maps - 1
    memory_release_if_idle(region)
}

/// Give region `slot` back (its range to its pool, its slot to the slab) if and
/// only if nothing names it any more: no handle and no installed row (§2.5).
///
/// The two counts are independent and either may reach zero first:
///
///   - handles first: a mapped-but-unreferenced region is a husk. Its slot
///     stays out of the slab and its charge stays on its creator's ledger,
///     because a row is still granting its bytes to somebody. It is leaked
///     until the target process's teardown, which recycles it.
///   - rows first: the ordinary `Unmap` before a release, which frees at the
///     handle drop.
///
/// A pool root has a third count, `out_bytes`. A root whose own handles and
/// rows are gone still cannot be given away while pieces of it are on loan:
/// each piece carries a back-reference to this slot, and a slot handed to the
/// next `Split` would make those references name a stranger. The last piece to
/// come home releases the root through the tail call below, which is one level
/// deep by construction (a root's root is itself). This path is taken only when
/// a pool root is released while pieces of it are on loan.
public(package) func memory_release_if_idle(slot: Int) unsafe {
    match MEMORIES[slot].state {
        case Free -> { return },
        case Live -> {},
    }
    if MEMORIES[slot].refs != 0 {
        return
    }
    if MEMORIES[slot].maps != 0 {
        return
    }
    let root = MEMORIES[slot].root
    if root == slot {
        if MEMORIES[slot].out_bytes != 0 {
            return
        }
        pool_drop_nodes(slot)
    } else {
        // The row is already gone by the time the bytes move, and the order is
        // the contract: `remove_grant`/`clear_domain` take the row out of the
        // record before they drop this count, so a range can never be handed to
        // a new owner while a domain still grants it to the old one.
        pool_return(root, MEMORIES[slot].base, MEMORIES[slot].len)
    }
    let owner = MEMORIES[slot].process
    MEMORIES[slot] = MemorySlot(state: SlotState.Free, process: 0, base: 0,
                                len: 0, refs: 0, maps: 0, root: NO_MEMORY,
                                free_head: 0, out_bytes: 0, dropped: 0)
    credit_shared(owner, QuotaKind.Memory)
    if root != slot {
        memory_release_if_idle(root)
    }
}

/// Retire a Memory slot whose bytes have become a slab extent.
///
/// The sibling of `memory_release_if_idle`; the difference is the one call it
/// does not make. A released region gives its range back to its pool root's
/// free list; a donated region must never, because the kernel now keeps its own
/// object slots there and the next `Split` would hand them out. So this frees
/// the slot (the object is gone and nothing can name it) while the range stays
/// out of every pool forever.
///
/// A derived region's length stays counted in its root's `out_bytes`, so the
/// root still believes those bytes are on loan and can never itself be released
/// or re-served.
///
/// A pool root may be donated whole, and then its free-list nodes go back to
/// the node slab as `memory_release_if_idle` does it; the caller has already
/// checked `out_bytes == 0`, so nothing on loan is orphaned.
///
/// There is no `refs`/`maps` test here and there must not be: the caller
/// checked both, and reaching this function is the statement that the region is
/// the kernel's.
public(package) func memory_retire_donated(slot: Int) unsafe {
    let root = MEMORIES[slot].root
    if root == slot {
        pool_drop_nodes(slot)
    }
    let owner = MEMORIES[slot].process
    MEMORIES[slot] = MemorySlot(state: SlotState.Free, process: 0, base: 0,
                                len: 0, refs: 0, maps: 0, root: NO_MEMORY,
                                free_head: 0, out_bytes: 0, dropped: 0)
    credit_shared(owner, QuotaKind.Memory)
}

// =============================================================================
// The IoMemory slab (spec §2.5)
// =============================================================================
//
// An IoMemory is `{base, len}` plus the process it is charged to, like a
// Memory, but it is its own array rather than a flag because everything the
// shape is used for differs. The bytes it names are registers: nothing is
// placed in them or zeroed, and the range is never returned to anybody. Carving
// hands out a view and leaves the parent whole (§2.5: a fixed region may be
// handed out many times). The teardown reclaims the slot and touches no
// hardware.

/// One IoMemory object: a range of device registers, and whose it is.
public(package) struct IoMemorySlot {
    public(package) state: SlotState,
    /// The process charged for this window, or `NO_PROCESS` once that process
    /// has died and disowned it (spec §2.10).
    public(package) process: Int,
    public(package) base: UInt,
    public(package) len: UInt,
    /// How many handle entries name this window.
    public(package) refs: UInt16,
}

// Donated extents add slots, not device windows: the floor was chosen against
// the number of windows a board has, so donating buys a machine that carves one
// peripheral into many views, not one with more peripherals.
public(package) unsafe static var IOMEMORIES: Slab<IoMemorySlot, MAX_IOMEMORIES> = Slab<IoMemorySlot, MAX_IOMEMORIES>(
    inline: [IoMemorySlot(state: SlotState.Free, process: 0, base: 0, len: 0,
                          refs: 0); MAX_IOMEMORIES],
    ext_base: [0; MAX_SLAB_EXTENTS],
    ext_slots: [0; MAX_SLAB_EXTENTS],
    ext_side: [0; MAX_SLAB_EXTENTS],
    ext_count: 0,
    total: MAX_IOMEMORIES)

/// Take a free IoMemory slot, or `NO_IOMEMORY` when the slab is full.
public(package) func alloc_iomemory() unsafe -> Int {
    var i: Int = 0
    while i < IOMEMORIES.capacity() {
        match IOMEMORIES[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_IOMEMORY
}

// =============================================================================
// The Mapping slab (spec §2.5)
// =============================================================================
//
// A Mapping is an installed grant row, so a slot records which domain carries
// the row and which row it is (an index into the target's grant record, a field
// of its body) and nothing else. The row already holds base, length and access,
// and a copy would be a second place for them to disagree.
//
// The row index is the one index-sensitive fact in the system. `load_domain`
// replays rows by position, so unmapping row `i` compacts the record and every
// Mapping slot naming a later row of the same domain has to move with it.
// `compact_mapping_rows` is that fixup, a bounded scan of this slab rather than
// a back-pointer per row.
//
// A slot outlives its row. An `unmap`, and the death of the target process
// (whose whole domain goes with it), both end a row without ending the object,
// leaving the slot Live with `row == NO_ROW`, which a later `unmap` sees as
// `BadState`. Neither frees the slot: an op that freed a slab slot while a
// handle still named it would let the next occupant be reached through a stale
// word, and a generation (which lives in the handle entry) cannot cover that.
// The slot is freed when its last handle goes (`free_object`'s Mapping arm).

/// "This mapping has no row": unmapped, or its target process is gone.
///
/// A row index is a position in a bounded array, so a negative is unusable as
/// one and needs no reserved slot of its own.
public(package) static NO_ROW: Int = -1

/// One Mapping object: who owns the handle, whose domain holds the row, and
/// which row it is.
///
/// `process` is the owner, whose teardown reclaims this slot; `target` is the
/// process whose domain the row sits in. They are usually the same, and differ
/// when a launcher maps a region into a child it created. Both name records.
/// An `Unmap` and the target's teardown both leave a husk: `row` is `NO_ROW`
/// and `target` is `NO_PROCESS`, so a later process in the target's record or
/// body is not reachable through it. A Live slot names a target exactly while
/// it has a row, which the teardown's sweep checks.
public(package) struct MappingSlot {
    public(package) state: SlotState,
    public(package) process: Int,
    public(package) target: Int,
    public(package) row: Int,
    /// How many handle entries name this mapping.
    ///
    /// The row is not one of them. A Mapping owns its row, not the reverse, so
    /// a mapped-but-unreferenced Mapping is at zero and frees, leaving the row
    /// behind (§2.5's "permanent, safe-but-leaked").
    public(package) refs: UInt16,
}

// Donated extents let more mappings exist across processes; they do not let one
// process install more, because the rows are a per-domain hardware budget
// (`hal.GRANT_ROW_BUDGET`) that no donation touches.
public(package) unsafe static var MAPPINGS: Slab<MappingSlot, MAX_MAPPINGS> = Slab<MappingSlot, MAX_MAPPINGS>(
    inline: [MappingSlot(state: SlotState.Free, process: 0, target: 0,
                         row: NO_ROW, refs: 0); MAX_MAPPINGS],
    ext_base: [0; MAX_SLAB_EXTENTS],
    ext_slots: [0; MAX_SLAB_EXTENTS],
    ext_side: [0; MAX_SLAB_EXTENTS],
    ext_count: 0,
    total: MAX_MAPPINGS)

/// Take a free Mapping slot, or `NO_MAPPING` when the slab is full.
public(package) func alloc_mapping() unsafe -> Int {
    var i: Int = 0
    while i < MAPPINGS.capacity() {
        match MAPPINGS[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_MAPPING
}

/// A row was removed from process `target`'s grant record at index `removed`,
/// and the record compacted. Move every Mapping that named a later row down
/// with it.
///
/// This is the only index-sensitive fixup in the kernel: `load_domain` is the
/// one place a row's position means anything to the hardware, and this slab is
/// the one place a position is remembered across a syscall.
public(package) func compact_mapping_rows(target: Int, removed: Int) unsafe {
    var i: Int = 0
    while i < MAPPINGS.capacity() {
        match MAPPINGS[i].state {
            case Live -> {
                if MAPPINGS[i].target == target && MAPPINGS[i].row > removed {
                    MAPPINGS[i].row = MAPPINGS[i].row - 1
                }
            },
            case Free -> {},
        }
        i = i + 1
    }
}

// =============================================================================
// The Pipe slab: one connection, two counted kinds (spec §2.1)
// =============================================================================
//
// One slab, two reference columns. `ObjType.PipeInlet` and `ObjType.PipeOutlet`
// are two counted kinds that target the same row here, and which column a
// handle entry maintains is decided by its kind, which §3's order establishes
// before any right is read. "The writers went to zero" is therefore "the inlet
// column reached zero", with no second ledger and no rights-partitioned count.
//
// The slot frees when both columns are zero, and only then. One column reaching
// zero is the peer-gone transition (made mechanical in `kcore.refs`). A
// connection with a live outlet and no inlet still has messages to hand over,
// so the free cannot be per-endpoint.
//
// The staging is separate storage, not a field of the slot. A ring of
// `PIPE_INFLIGHT` slots at `PIPE_BODY_BYTES` each is kilobytes per connection,
// and a slot struct holding one would make every `PIPES[slot] = PipeSlot(...)`
// a multi-kilobyte memset inside a syscall. The slot carries the numbers that
// describe the ring, not the ring itself. The storage is an all-zero
// initializer and so lands in `.bss`, costing no image bytes.
//
// Nothing is allocated per message (§2.1's fixed body and in-flight budget): a
// post writes an existing slot and a take reads one.
//
// The slab sits below `process` as every slab does: ending a process frees what
// it owned, so the storage has to be reachable from the teardown.

/// Which `BootHandleKind` a given handle's `ObjType` is delivered as, or `None`
/// when the boot record has no spelling for it.
///
/// This is the one place the kernel-internal kind and the public one meet.
/// `ObjType` is renumberable bookkeeping and `BootHandleKind` crosses the trap
/// boundary, so neither is a cast of the other; this function is the
/// translation, and it is deliberately partial. The kinds it cannot spell are
/// the kinds that are never given: a Waiter, Interrupt, Clock or Timer handle
/// never reaches here, because the `Transfer` check refuses it first.
/// The partial arm means that when a kind becomes givable, the compiler asks
/// for its record spelling instead of letting it arrive mis-tagged.
///
/// It lives here, below `kcore.refs`, because both the give path and `refs`
/// (which translates a message's handle slots at every rendezvous) need it, and
/// `refs` sits below `dispatch`. A translation between two `sosabi` enums names
/// nothing this module does not already import.
public(package) func boot_kind_of(kind: ObjType) -> BootHandleKind? {
    match kind {
        case Memory -> BootHandleKind.Memory,
        case Process -> BootHandleKind.Process,
        case System -> BootHandleKind.System,
        // `iomemory_rights()` mints `Transfer`, so a window can travel and the
        // record needs a spelling for one. A Mapping stays in the `None` arm:
        // `mapping_rights()` withholds `Transfer`, so the `Transfer` check
        // refuses one first and a spelling would be dead surface.
        case IoMemory -> BootHandleKind.IoMemory,
        // `pipe_inlet_rights()` and `pipe_outlet_rights()` mint `Transfer`:
        // handing a child one end of a connection is what the pair is for (a
        // launcher creates the pair, gives the inlet to the client and the
        // outlet to the server).
        case PipeInlet -> BootHandleKind.PipeInlet,
        case PipeOutlet -> BootHandleKind.PipeOutlet,
        // `pipe_reply_rights()` and `pipe_request_rights()` mint `Transfer`:
        // §2.1 calls the one-shots the delegation primitive. A server moves its
        // obligation to a third party, who replies straight to the original
        // client without the payload transiting the middle process, so a give
        // must be able to carry one.
        case PipeReply -> BootHandleKind.PipeReply,
        case PipeRequest -> BootHandleKind.PipeRequest,
        // `event_rights()` mints `Transfer`, and an Event is a shared kind: it
        // outlives its owner while anything names it.
        case Event -> BootHandleKind.Event,
        // `thread_rights()` mints `Transfer`: a thread's creator hands the
        // handle to whoever joins it. A Thread is bound to its process, so a
        // handle that outlives the process reads `Exited` or `Revoked`.
        case Thread -> BootHandleKind.Thread,
        case _ -> None,
    }
}

/// Which `BootHandleKind` a handle may be delivered as in a message, or `None`
/// when a message cannot carry that kind at all.
///
/// This is `boot_kind_of` minus `Process` and `System`, a typed-surface fact
/// rather than a capability one. Both are givable (their rights mint `Transfer`
/// and the boot record spells both), but a message cannot tell the receiver
/// what arrived: the receiving vocabulary is `sos.pipe`'s `PipeHandle`, and
/// `Process` and `System` are declared in `sos.system`, which imports
/// `sos.pipe`, so a case for either would be an import cycle.
///
/// Refusing at the sender is the honest place. Delivering a word the receiver's
/// decode would have to panic on turns one process's mistake into another's
/// crash; instead the sender is told `BadArg`, a caller-checkable fault since
/// it chose the handle, and nothing crosses.
public(package) func msg_kind_of(kind: ObjType) -> BootHandleKind? {
    guard let spelled = boot_kind_of(kind) else {
        return None
    }
    match spelled {
        case Process -> None,
        case System -> None,
        case _ -> spelled,
    }
}

/// One Pipe connection: whose it is, what is staged, and how many handles name
/// each of its two ends.
///
/// `process` is the creator. The creator pays: whoever was charged gets the
/// quota row back when the connection frees, whichever process dropped the last
/// handle onto either end. A creator that dies first disowns the connection
/// (`process` becomes `NO_PROCESS`), and its free then credits nobody.
///
/// The two columns are the peer-gone state, and no flag beside them says so.
/// "The inlet side is gone" is `inlet_refs == 0`: a column can only fall to
/// zero and never rise again, because raising it needs a handle onto that end,
/// and a mint needs a source handle there is none of. The terminal level is a
/// fact about the count, not a bit somebody has to remember to set.
///
/// Occupancy is per ring slot (see `Exchange`), because exchanges settle in
/// whatever order their two holders act. The staged messages are a list
/// threaded through the exchanges; `staged` is its head, 1-based so that zero
/// is "nothing staged". There is no tail: appending walks at most
/// `PIPE_INFLIGHT` links, and a second index would be one more thing for two
/// paths to keep in step.
public(package) struct PipeSlot {
    public(package) state: SlotState,
    public(package) process: Int,
    /// The oldest staged (untaken) exchange's flat index (see `Exchange`), plus
    /// one. Zero is "nothing staged" (the list-link idiom the thread queues
    /// use).
    public(package) staged: Int,
    /// The attachment watching the client end's room-to-post level (slot + 1);
    /// 0 = unattached. One field per end, not per connection: the two ends are
    /// two waitables (a client waits for room, a server waits for a message),
    /// so §2.2's at-most-one-Waiter rule is per end, as `inlet_refs` and
    /// `outlet_refs` are.
    public(package) inlet_attachment: Int,
    /// The attachment watching the server end's readable level (slot + 1).
    public(package) outlet_attachment: Int,
    /// The client end's reference column: the handle entries naming it, plus
    /// its attachment. Each end kind counts on its own column.
    public(package) inlet_refs: UInt16,
    /// The server end's column, counted the same way.
    public(package) outlet_refs: UInt16,
}

/// `MAX_PIPES` is the inline extent; a `SlabKind.Pipes` donation adds
/// connections and the exchanges that belong to them (see `EXCHANGES` for why
/// the two chains cannot come apart).
public(package) unsafe static var PIPES: Slab<PipeSlot, MAX_PIPES> = Slab<PipeSlot, MAX_PIPES>(
    inline: [PipeSlot(state: SlotState.Free, process: 0, staged: 0,
                      inlet_attachment: 0, outlet_attachment: 0,
                      inlet_refs: 0, outlet_refs: 0);
             MAX_PIPES],
    ext_base: [0; MAX_SLAB_EXTENTS],
    ext_slots: [0; MAX_SLAB_EXTENTS],
    ext_side: [0; MAX_SLAB_EXTENTS],
    ext_count: 0,
    total: MAX_PIPES)

/// Ring slots the inline extent holds: one row per (connection, ring slot)
/// pair, which is what an exchange index names.
///
/// It is `EXCHANGES`' inline size, not the machine's exchange count; scans read
/// `EXCHANGES.capacity()`.
public(package) static PIPE_EXCHANGES: Int = MAX_PIPES * PIPE_INFLIGHT

// =============================================================================
// The one-shot pair: claim and obligation, as ring-slot state (spec §2.1)
// =============================================================================
//
// There is no third slab. A one-shot pair exists for exactly as long as one
// in-flight message does, and the reply body is pinned to the staging slot that
// carried the request, so the claim state lives with the slot, in the
// `Exchange` record below. It is zero-initialized and therefore `.bss`.
//
// The exchange index is the object's identity. `ObjType.PipeReply` and
// `ObjType.PipeRequest` both target the flat exchange index `connection *
// PIPE_INFLIGHT + ring slot` (`pipe_exchange_at`), where the end kinds target a
// connection. As with the ends, which column a handle counts on is decided by
// its kind, before any right is read.
//
// The two columns are the abandonment state, as the connection's two are the
// peer-gone state, and no flag beside them says so:
//
//   the claim column at zero          the client abandoned the exchange
//   `Taken` with the request column
//     at zero                         the server abandoned the obligation
//   `Staged` with the connection's
//     outlet column at zero           nobody can ever take it, so likewise
//
// The slot settles when nobody names it and nothing is owed. That is one
// predicate (`exchange_can_settle`): the counted-object rule plus one clause, a
// staged message is owed to a live outlet whatever became of the claim (§2.1's
// tell idiom: post, drop the claim, and the server still receives the message).

/// Where an exchange is in its life. The two abandonment answers are derived
/// from the columns rather than stored beside them.
///
/// `Free` is the slot nobody is using: the ring's own occupancy, which is what
/// `PipeInletOp.Post` scans for. A full ring therefore counts awaiting-reply
/// exchanges, not merely untaken messages.
public(package) enum ExchangeState: UInt8 {
    case Free = 0,
    /// A request body is in the slot and nobody has taken it. The obligation
    /// has not been minted, so its column is zero for a reason that is not
    /// abandonment — which is exactly why the state has to be recorded and the
    /// columns alone would not do.
    case Staged = 1,
    /// The obligation has been minted and the reply is owed.
    case Taken = 2,
    /// The reply body is in the slot and the claim may take it.
    case Replied = 3,
    /// The exchange is discharged. A reply delivered through a `Waiter.wait`
    /// hands the bytes over exactly as a `Resolve` does, but it does not travel
    /// through the claim's handle entry, so it cannot consume one. Without a
    /// state to move to, the slot would stay `Replied` and a later `Resolve`
    /// through the same claim would copy the answer out a second time, the
    /// duplicate §2.2's consume rule exists to make impossible.
    ///
    /// A delivered reply lands here, and it answers everything as a spent
    /// exchange should: a later `Resolve` is `PeerClosed` and consumes the
    /// claim, a `Reply` through the obligation's still-live entry is
    /// `PeerClosed` too, and the slot settles as soon as both columns are zero.
    /// This is the one state whose arrival is not an op, which is why the
    /// columns could not have derived it.
    case Settled = 4,
}

// =============================================================================
// The staged handle ledger (spec §2.1's rendezvous transfer)
// =============================================================================
//
// A handle leaves the sender at the post, and the kernel holds it until the
// receiver takes it. A validated send unbinds each of its handle entries and
// parks the reference those entries were holding in the ring note, so a staged
// message owns what it is carrying and nothing about it can go stale. A message
// that was accepted will deliver what it was carrying, whatever becomes of the
// sender.
//
// The note is typed refs, not words. A handle word is an index into a table the
// entry no longer occupies, so once the entry is unbound the word means
// nothing; what survives is the object the reference names and the rights the
// sender held it with. `StagedRef` is a handle entry with its table slot and
// generation left off, which is all a later mint or release needs.
//
// Nobody is charged for a staged handle, and the bound is why that is safe. The
// unbind credits the sender's `QuotaKind.Handle` row and the taker is charged
// at the mint, so between the two the entry is charged to nobody. It cannot be
// exploited into an unbounded hole: a connection holds at most
// `PIPE_INFLIGHT * PIPE_MSG_HANDLES` staged handles, the connection itself cost
// a `QuotaKind.Pipe` row, and the objects the refs name already occupy the slab
// slots they were charged for. The slab is still what refuses the next
// allocation; no staged handle can conjure one.
//
// The ledger is zero-initialized and therefore `.bss`: `PIPE_MSG_HANDLES`
// entries per exchange (`Exchange.held`).

/// One handle a message is carrying, held by the kernel between the post and
/// the rendezvous: a `HandleEntry` with the two table-only fields left off.
///
/// The rights travel with the reference. A reference names an object; a
/// capability is an object and a rights word, and the receiver is owed the
/// sender's rights verbatim. Carrying only `(obj_type, target)` would make the
/// taker's mint consult a default set, which is the amplification a transfer
/// must not do.
///
/// `obj_type == Unbound` is the empty slot, which is what zero-init means and
/// why the ledger needs no separate occupancy word.
public(package) struct StagedRef {
    public(package) obj_type: ObjType,
    public(package) rights: UInt32,
    public(package) target: Int,
}

/// A whole message's worth of them, collected out of the ledger: the value
/// `take_staged` answers with and the only thing a release or a mint reads.
///
/// Releasing a reference lives in `kcore.refs`, which is above this file, so an
/// unwind arm down here cannot release and must hand the batch upward. That is
/// collect-then-free across a module boundary: the ledger is consistent before
/// any release runs, so a cascade that re-enters this file never finds a
/// half-emptied exchange.
public(package) struct StagedRefs {
    public(package) slots: [StagedRef; PIPE_MSG_HANDLES],
}

/// The empty slot, written once so the zero value has a name.
public(package) func no_staged_ref() -> StagedRef {
    StagedRef(obj_type: ObjType.Unbound, rights: 0, target: 0)
}

// =============================================================================
// The exchange record
// =============================================================================
//
// An exchange's whole state is one record at one index, so `EXCHANGES` is a
// plain `Slab` like the other kinds. The flat index `x = c * PIPE_INFLIGHT + i`
// (and `c = x / PIPE_INFLIGHT`) means the same at every index, because
// `PIPE_INFLIGHT` is a compile-time constant that does not know where a
// connection lives. The exchange numbering is uniform across the chain.
//
// That is also what keeps the two chains from skewing. A `Pipes` donation
// appends `k` connections to `PIPES` and `k * PIPE_INFLIGHT` exchanges to
// `EXCHANGES`, in one function, having checked both first. So `PIPES` extent
// `e` holds connections `[S, S + k)` and `EXCHANGES` extent `e` holds exchanges
// `[S * PIPE_INFLIGHT, (S + k) * PIPE_INFLIGHT)`, exactly the set the flat
// arithmetic maps those connections to. Corresponding indices land in the same
// extent by the arithmetic, not by a shared table; skew would need one donation
// to succeed and the other to fail, which `slab_install` makes unreachable.
//
// The rendezvous paths (`pipe_post`, `pipe_take`, `pipe_resolve`,
// `pipe_reply_status`, `deliver_take`) do one bounds check on the flat `x`,
// with no division and no second lookup. Don't fold the exchanges into
// `PipeSlot` as an inline ring: every access would become
// `PIPES[x / PIPE_INFLIGHT].ex[x % PIPE_INFLIGHT]`, two bounds checks and a
// division on the hottest paths.
//
// Zero is the free exchange. `ExchangeState.Free` is 0 and `ObjType.Unbound` is
// 0, so a zeroed record is a free slot with an empty ledger. That lets
// `slab_donate` install a donated extent by zeroing it, and keeps the inline
// array in `.bss`.

/// One exchange: a ring slot's whole state, and what a `PipeReply` or a
/// `PipeRequest` handle targets.
public(package) struct Exchange {
    /// Where this exchange is in its life.
    public(package) state: ExchangeState,
    /// How long the message in this staging slot is and, once a reply has been
    /// written, how long that is. One number, because a slot holds one body at
    /// a time and the exchange's state says which body it is.
    public(package) len: UInt16,
    /// How many handle entries name this exchange's claim.
    public(package) reply_refs: UInt16,
    /// How many name its obligation.
    public(package) request_refs: UInt16,
    /// The attachment watching this exchange's claim (slot + 1); 0 =
    /// unattached.
    ///
    /// Two fields, because a claim and an obligation are two waitables: the
    /// reply-ready level belongs to the client, the request-abandoned level to
    /// the server. §2.2's at-most-one-Waiter rule holds per column, as the
    /// reference count does, and the two may be watched from two different
    /// processes at once.
    public(package) reply_attach: Int,
    /// The attachment watching this exchange's obligation (slot + 1).
    public(package) request_attach: Int,
    /// The thread parked in a fused `Call` on this exchange (thread slot + 1;
    /// 0 = none).
    ///
    /// This is a third way to name a claim, and the only one that is not a
    /// handle. A fused call mints no `PipeReply` into the caller's table (zero
    /// handle traffic and zero table rows on the fast path), so the claim it
    /// holds is kernel-internal and tied to the parked thread. A parked caller
    /// counts one on `reply_refs`, exactly as a handle entry or an attachment
    /// would, so nothing can settle the ring slot out from under it.
    ///
    /// Two directions, two fields: this one answers "who is waiting for this
    /// exchange" (what a settling reply needs, a load rather than a scan of the
    /// thread table); `ThreadSlot.call_claim` answers "what is this thread
    /// waiting for" (what the teardown needs when a process dies parked).
    /// Neither question can be answered from the other side without a walk.
    ///
    /// A parked caller is on no list, because a fused call involves no Waiter,
    /// so this field is the whole of how it is reachable. That is why
    /// `exchange_settle` asserts it is clear.
    public(package) caller: Int,
    /// The staged list's link: the next staged exchange in this connection,
    /// plus one, or zero at the end. Only ever appended at the tail and removed
    /// at the head (a take), or cleared whole (the outlet's zero-arm), so it is
    /// a strict FIFO and never needs a removal from the middle.
    public(package) next: Int,
    /// The references a post or a reply staged.
    ///
    /// One ledger serves both directions, because an exchange only ever has one
    /// message in flight: the request's handles leave at the take, the same
    /// moment the slot stops holding a request and can start holding a reply.
    /// The take collects what it minted, so a reply stages into slots that are
    /// provably empty.
    public(package) held: [StagedRef; PIPE_MSG_HANDLES],
    /// This staging slot's message bytes: the request, then the reply.
    ///
    /// The promise to callers is `PIPE_BODY_BYTES` contiguous writable bytes,
    /// reached through `body_addr`.
    public(package) body: [UInt8; PIPE_BODY_BYTES],
}

extension Exchange {
    /// This exchange's body bytes, as an address the copy movers can use.
    ///
    /// It is a method because `&var EXCHANGES[x].body` is not spellable: a
    /// `borrows` accessor lends a place, and Saw will not take a reference to a
    /// field of one (``can only take reference to a variable, field, or array
    /// element``). Inside a `&var self` method the receiver arrives by pointer,
    /// so `self.body` is an ordinary addressable field of the caller's storage.
    /// The address still comes out of the slot the slab lent, through the
    /// accessor and its one funnel.
    public(package) func body_addr(&var self) unsafe -> UInt {
        ((&var self.body) as UnsafePointer<UInt8>) as UInt
    }
}

/// Every exchange in the machine. A chain in lockstep with `PIPES`; see the
/// block header above for why "lockstep" is arithmetic rather than bookkeeping.
public(package) unsafe static var EXCHANGES: Slab<Exchange, PIPE_EXCHANGES> = Slab<Exchange, PIPE_EXCHANGES>(
    inline: [Exchange(state: ExchangeState.Free, len: 0, reply_refs: 0,
                      request_refs: 0, reply_attach: 0, request_attach: 0,
                      caller: 0, next: 0,
                      held: [StagedRef(obj_type: ObjType.Unbound, rights: 0,
                                       target: 0); PIPE_MSG_HANDLES],
                      body: [0; PIPE_BODY_BYTES]);
             PIPE_EXCHANGES],
    ext_base: [0; MAX_SLAB_EXTENTS],
    ext_slots: [0; MAX_SLAB_EXTENTS],
    ext_side: [0; MAX_SLAB_EXTENTS],
    ext_count: 0,
    total: PIPE_EXCHANGES)

/// How many references exchange `x` is holding.
///
/// A count, not a re-validation: the refs are the kernel's own, so staleness
/// cannot exist and the answer is a scan of `PIPE_MSG_HANDLES` tags. The
/// rendezvous pre-flights the taker's table against it.
public(package) func staged_count(x: Int) unsafe -> Int {
    var live: Int = 0
    var i: Int = 0
    while i < PIPE_MSG_HANDLES {
        match EXCHANGES[x].held[i].obj_type {
            case Unbound -> {},
            case _ -> { live = live + 1 },
        }
        i = i + 1
    }
    live
}

/// Take exchange `x`'s held references out of the ledger, leaving it empty.
///
/// This is the one way anything leaves the ledger, so every consumer (the
/// rendezvous that mints them onward and every unwind arm that drops them) goes
/// through one door and the ledger is consistent the instant it returns. The
/// caller must either mint each ref into a table or release each ref; doing
/// neither leaks a reference. Every call site is named in `kcore.refs`'
/// rendezvous header.
public(package) func take_staged(x: Int) unsafe -> StagedRefs {
    var out = StagedRefs(slots: [StagedRef(obj_type: ObjType.Unbound,
                                           rights: 0, target: 0);
                                 PIPE_MSG_HANDLES])
    var i: Int = 0
    while i < PIPE_MSG_HANDLES {
        out.slots[i] = EXCHANGES[x].held[i]
        EXCHANGES[x].held[i] = no_staged_ref()
        i = i + 1
    }
    out
}

/// "No exchange": the sentinel a full ring answers with.
public(package) static NO_EXCHANGE: Int = -1

/// Which connection exchange `x` belongs to.
public(package) func exchange_pipe(x: Int) -> Int {
    x / PIPE_INFLIGHT
}

/// Which ring slot of that connection it is.
public(package) func exchange_index(x: Int) -> Int {
    x % PIPE_INFLIGHT
}

/// The exchange index of connection `c`'s ring slot `i`: the flat arithmetic
/// every per-exchange access is indexed by, and the identity
/// `ObjType.PipeReply` and `ObjType.PipeRequest` handle entries carry.
public(package) func pipe_exchange_at(c: Int, i: Int) -> Int {
    c * PIPE_INFLIGHT + i
}

/// Take a free Pipe slot, or `NO_PIPE` when the slab is full.
public(package) func alloc_pipe() unsafe -> Int {
    var i: Int = 0
    while i < PIPES.capacity() {
        match PIPES[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_PIPE
}

/// The kernel address of exchange `x`'s body slot.
///
/// There is no new funnel here: this is the address of a field of the slot
/// `EXCHANGES[x]` lends, so it reaches donated memory through
/// `Slab.extent_addr` and nothing else. There is no second `phys_to_virt`,
/// because there is no second dereference of a stored physical base. A missed
/// conversion would be a hard fault on a translating profile and invisible on
/// an MPU one, so "no new funnel" has to be kept rather than assumed.
///
/// Confined to this small named helper so the callers stay ordinary code and
/// the pointer never leaves the expression.
///
/// One slot carries both bodies, one at a time: the request on the way in, then
/// the reply written over it. Nothing is owed to the request bytes once the
/// taker has copied them out.
public(package) func exchange_body_addr(x: Int) unsafe -> UInt {
    EXCHANGES[x].body_addr()
}

/// Take a free ring slot of connection `c`, or `NO_EXCHANGE` when every one of
/// them is in use.
///
/// This scan is the ring-full test. A slot is in use from the post that stages
/// a message until the exchange settles, so a full ring is `PIPE_INFLIGHT`
/// awaiting-reply exchanges rather than `PIPE_INFLIGHT` untaken messages, and
/// `PipeOutletOp.Take` frees nothing.
///
/// A scan rather than a cursor, as `alloc_pipe` is: exchanges settle in
/// whatever order their two holders act, so the free slots are not contiguous.
/// It is bounded by `PIPE_INFLIGHT`, which `kcore.limits`' audit note covers.
public(package) func alloc_exchange(c: Int) unsafe -> Int {
    var i: Int = 0
    while i < PIPE_INFLIGHT {
        let x = pipe_exchange_at(c, i)
        match EXCHANGES[x].state {
            case Free -> { return x },
            case _ -> {},
        }
        i = i + 1
    }
    NO_EXCHANGE
}

/// Whether there is room to post: the inlet's waitable level.
///
/// It is `alloc_exchange`'s scan asked as a question rather than a reservation.
/// Readiness must reserve nothing, because a level that took a slot to answer
/// would hand it to whoever asked instead of to whoever posts. The same bounded
/// walk with no side effect is §2.2's level-triggering implemented rather than
/// maintained, as in `waiter_ready_attachment`.
public(package) func pipe_has_room(c: Int) unsafe -> Bool {
    var i: Int = 0
    while i < PIPE_INFLIGHT {
        match EXCHANGES[pipe_exchange_at(c, i)].state {
            case Free -> { return true },
            case _ -> {},
        }
        i = i + 1
    }
    false
}

/// Append exchange `x` to its connection's staged list, the FIFO a take reads
/// from.
///
/// The walk to the tail is bounded by `PIPE_INFLIGHT` and buys the absence of a
/// tail index, which two paths would otherwise have to keep in step.
public(package) func stage_push(c: Int, x: Int) unsafe {
    EXCHANGES[x].next = 0
    if PIPES[c].staged == 0 {
        PIPES[c].staged = x + 1
        return
    }
    var cur = PIPES[c].staged - 1
    while EXCHANGES[cur].next != 0 {
        cur = EXCHANGES[cur].next - 1
    }
    EXCHANGES[cur].next = x + 1
}

/// The oldest staged exchange of connection `c`, or `NO_EXCHANGE` when nothing
/// is staged. Looks and does not remove: a take mints its obligation before it
/// consumes anything, so the refusal path must leave the list as it found it.
public(package) func stage_peek(c: Int) unsafe -> Int {
    if PIPES[c].staged == 0 {
        return NO_EXCHANGE
    }
    PIPES[c].staged - 1
}

/// Remove the oldest staged exchange from the list. Called only once the take
/// that asked for it can no longer be refused.
public(package) func stage_pop(c: Int) unsafe {
    let head = PIPES[c].staged
    if head == 0 {
        return
    }
    PIPES[c].staged = EXCHANGES[head - 1].next
    EXCHANGES[head - 1].next = 0
}

/// Is every ring slot of connection `c` free, with no exchange left in it?
///
/// The connection outlives its endpoints for exactly as long as an exchange
/// inside it does. A claim is a reference on a ring slot, and a ring slot lives
/// inside the `PIPES` row, so freeing the row while a claim is live would hand
/// that claim a recycled connection. This predicate stops it; it is a scan
/// rather than a third column for `alloc_pipe`'s reason (the same bounded walk,
/// and a maintained count would be one more thing to keep in step).
public(package) func pipe_idle(c: Int) unsafe -> Bool {
    var i: Int = 0
    while i < PIPE_INFLIGHT {
        match EXCHANGES[pipe_exchange_at(c, i)].state {
            case Free -> {},
            case _ -> { return false },
        }
        i = i + 1
    }
    true
}

/// Give connection `slot` back to the Pipe slab, and credit its creator.
///
/// One charge, one credit: `process` is who `PipeCreate` charged, and it is
/// credited here whichever process dropped the last handle onto whichever end,
/// unless its death disowned the connection first (`credit_shared`).
///
/// The precondition is both columns at zero and `pipe_idle`: no endpoint names
/// it and no exchange lives in it, so the ring slots are already `Free` and
/// there is nothing to unwind here.
public(package) func free_pipe(slot: Int) unsafe {
    // Neither end can be attached here. An attachment is a counted reference on
    // the end it watches, so a connection whose columns are both zero has no
    // watcher on either side; if this fires, the ledger and the wait machinery
    // disagreed and a Waiter would be watching a recycled slot (see
    // `free_object`).
    if PIPES[slot].inlet_attachment != 0 || PIPES[slot].outlet_attachment != 0 {
        fatal_kernel("a pipe reached zero references while attached",
                     slot as UInt)
    }
    let owner = PIPES[slot].process
    PIPES[slot] = PipeSlot(state: SlotState.Free, process: 0, staged: 0,
                           inlet_attachment: 0, outlet_attachment: 0,
                           inlet_refs: 0, outlet_refs: 0)
    credit_shared(owner, QuotaKind.Pipe)
}

/// Can exchange `x` be given back: does nobody name it and is nothing owed?
///
/// This is the counted-object rule with one extra clause. Both columns at zero
/// says no handle can ever act on this exchange again; the extra clause is that
/// a `Staged` message is still owed to a live outlet whatever became of the
/// claim (§2.1's tell idiom: post, drop the claim, and the server still
/// receives the message). Once the outlet column is zero nobody can ever take
/// it, so the message is owed to nobody and the slot may go.
public(package) func exchange_can_settle(x: Int) unsafe -> Bool {
    if EXCHANGES[x].reply_refs != 0 || EXCHANGES[x].request_refs != 0 {
        return false
    }
    match EXCHANGES[x].state {
        case Free -> false,
        case Staged -> PIPES[exchange_pipe(x)].outlet_refs == 0,
        case Taken -> true,
        case Replied -> true,
        // A discharged exchange owes nothing: the answer has already been
        // handed to somebody through a wait record, so only the columns are
        // holding the slot.
        case Settled -> true,
    }
}

/// Give exchange `x`'s ring slot back, and the connection with it if that was
/// the last thing keeping the row alive.
///
/// The cascade terminates because an exchange references its connection's
/// storage and a connection references no exchange, so the graph is a forest.
///
/// The bytes are not zeroed, as in `pipe_drop_staged`: a staged or replied body
/// is bytes that were copied, the slot is unreachable until a later post writes
/// it, and every read of one is bounded by the length that post recorded.
///
/// It answers with the handle references the exchange was still holding, and
/// the caller must release them. A settling exchange may still carry a message
/// nobody took, and those handles are the kernel's references, so forgetting
/// them would leak the objects. Releasing is `kcore.refs`' job and this file
/// sits below it, so the batch travels up: the ledger is emptied here, every
/// other line of the settle runs, and the release happens at the call site with
/// the exchange already `Free`. The ordering matters: a release can take a pipe
/// endpoint to zero and cascade back into this function, and by then there is
/// nothing left here to corrupt.
public(package) func exchange_settle(x: Int) unsafe -> StagedRefs {
    // Neither half can be attached here (`free_pipe`'s assert one level down):
    // an attachment is a counted reference on the column it watches, so both
    // columns at zero means nobody is watching either. If this fired, a Waiter
    // would be holding a level on a ring slot the next `Post` is about to
    // write.
    if EXCHANGES[x].reply_attach != 0 || EXCHANGES[x].request_attach != 0 {
        fatal_kernel("an exchange settled while attached", x as UInt)
    }
    // No thread can be parked on it either: a fused caller counts on the claim
    // column, so both columns at zero means nobody is parked. A parked caller
    // is on no list at all, so a settle that lost one would strand a thread
    // nothing could ever reach again.
    if EXCHANGES[x].caller != 0 {
        fatal_kernel("an exchange settled with a caller parked on it", x as UInt)
    }
    // The held references come out first and are released last: collected here
    // so the ledger is already empty for anything the caller's release cascades
    // into, handed back so the release happens where releases live.
    let held = take_staged(x)
    EXCHANGES[x].state = ExchangeState.Free
    EXCHANGES[x].reply_refs = 0
    EXCHANGES[x].request_refs = 0
    EXCHANGES[x].len = 0
    EXCHANGES[x].next = 0

    let c = exchange_pipe(x)
    match PIPES[c].state {
        case Free -> {},
        case Live -> {
            if (PIPES[c].inlet_refs == 0 && PIPES[c].outlet_refs == 0
                && pipe_idle(c)) {
                free_pipe(c)
            }
        },
    }
    held
}

// =============================================================================
// The boot-handle queues, one per process (spec §12)
// =============================================================================
//
// What somebody minted for a process before it ran and has not handed over yet.
// §12 keeps the boot set one handle wide at the entry register, so everything
// else a process is furnished with is collected rather than passed, and this is
// where it waits.
//
// The queue is per-process because there are two drainers: a launcher fills a
// child's set with `ProcessOp.Give`, and the child drains its own through its
// own Process handle exactly as root drains root's. The two producers are
// indistinguishable on purpose: the kernel is the giver nobody gave to, root's
// records are written at boot by the machinery a give uses, and their tags are
// region ordinals because that is what the config root and the build agreed on.
//
// The set, its count and its cursor are `ProcessBody.boot_handles` /
// `.boot_count` / `.boot_next`, three fields of the body beside `.handles`.
// `MAX_HANDLES` is the right bound: every record names a handle in that
// process's table, so a boot set larger than the table it fills could never be
// drained.
//
// It is a queue with a cursor and no removal: the cursor only ever advances, so
// a drained iterator stays drained and a delivered record can never be
// delivered twice. That is why the records are plain storage rather than a
// slab. The set freezes at `Start` (enforced by the give's own `BadState`
// refusal, one level up) and the drain has no deadline.

/// Is there room for one more record in process `p`'s set?
///
/// Asked before a give does anything, so a refusal leaves both tables
/// untouched. In practice it never answers `false`, since a record is queued
/// beside a mint into the same process's table and the handle table fills
/// first; the test is here because a silently dropped record is a capability a
/// child was given and can never collect.
public(package) func boot_handle_room(p: Int) unsafe -> Bool {
    PROCESSES[body_of(p)].boot_count < MAX_HANDLES
}

/// Does process `p`'s set already carry `tag`?
///
/// The duplicate-tag check scans rather than indexes: a tag is the giver's own
/// word and the kernel constrains it in no way, so there is nothing to index
/// by; the array is bounded by `MAX_HANDLES` and the walk runs once per give.
/// It looks at the whole set and not only the undelivered part, because the tag
/// is an identity for the process's whole boot set: a tag reused after the
/// child drained the first one would still name two handles.
public(package) func boot_tag_used(p: Int, tag: UInt) unsafe -> Bool {
    let b = body_of(p)
    let n = PROCESSES[b].boot_count
    var i: Int = 0
    while i < n {
        if PROCESSES[b].boot_handles[i].tag == tag {
            return true
        }
        i = i + 1
    }
    false
}

/// Take the handle word process `p`'s set carries under `tag`, or `NO_HANDLE`
/// when no record carries it.
///
/// This is `start(boot_tag:)`'s resolver, and it consumes. Putting the word in
/// the child's first argument register is the delivery, so the record is marked
/// spent and the drain skips it: a child is never handed one word twice, and a
/// two-owners-of-one-word hazard is unrepresentable.
///
/// A record already taken answers `NO_HANDLE` too, the same answer a tag nobody
/// gave gets: both mean "there is no word here to deliver", and the caller
/// turns either into the `BadArg` fault.
public(package) func boot_handle_take(p: Int, tag: UInt) unsafe -> UInt {
    let b = body_of(p)
    let n = PROCESSES[b].boot_count
    var i: Int = 0
    while i < n {
        // Read the record as one value rather than three place windows.
        // `BootHandleSlot` is trivially copyable, so the test, the mark and the
        // answer work on one loaded copy, which also keeps two place windows
        // out of a single `&&`.
        let rec = PROCESSES[b].boot_handles[i]
        if rec.tag == tag && not rec.taken {
            PROCESSES[b].boot_handles[i].taken = true
            return rec.handle
        }
        i = i + 1
    }
    NO_HANDLE
}

/// Queue one record for process `p`. The caller has already asked
/// `boot_handle_room`; this is the one producer, and both doors — the kernel's
/// boot minting and a launcher's `give` — come through it.
public(package) func queue_boot_handle(p: Int, tag: UInt, kind: BootHandleKind,
                                       handle: UInt) unsafe {
    let b = body_of(p)
    let n = PROCESSES[b].boot_count
    PROCESSES[b].boot_handles[n] = BootHandleSlot(tag: tag, kind: kind,
                                                  handle: handle,
                                                  taken: false)
    PROCESSES[b].boot_count = n + 1
}

/// Advance process `p`'s cursor past every record already delivered, and answer
/// where it now points.
///
/// The cursor only ever advances: a record `start(boot_tag:)` took is one the
/// drain steps over, as it steps over one it delivered itself. A drained
/// iterator stays drained, and no record is handed out twice however it left
/// the set.
public(package) func boot_handle_cursor(p: Int) unsafe -> Int {
    let b = body_of(p)
    let n = PROCESSES[b].boot_count
    var at = PROCESSES[b].boot_next
    while at < n && PROCESSES[b].boot_handles[at].taken {
        at = at + 1
    }
    PROCESSES[b].boot_next = at
    at
}

/// Forget process `p`'s set. Called by the teardown.
///
/// The records are bookkeeping and clear with the body. The handles they name
/// are entries in the dying process's own table, already unbound by the
/// close-all, so nothing is released here and nothing is leaked. The count and
/// the cursor must be reset because the body is reused, and its next process
/// would otherwise inherit a stranger's boot set.
public(package) func clear_boot_handles(p: Int) unsafe {
    let b = body_of(p)
    PROCESSES[b].boot_count = 0
    PROCESSES[b].boot_next = 0
}
