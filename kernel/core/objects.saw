/// A Memory handle the dispatch has VALIDATED, paired with its rights and the
/// region slot it names (spec §2.5; sawos design 2 D-2).
///
/// **ITS `allows` WAS BUILT BEFORE ANYTHING SPENT A `MemoryRight`, AND UNIT 4
/// IS WHAT IT WAS BUILT FOR.** Unit 2 wrote it with nothing calling it, because
/// the wrapper is what makes "this handle resolved to a Memory" a TYPE rather
/// than a comment — which is exactly the claim `process_create` needs about the
/// two regions it is handed, and that op still spends no right. `MemoryOp.Split`
/// and `MemoryOp.Map` are the callers it was waiting for.
public(package) struct MemoryObject {
    public(package) handle: MemoryHandle,
    public(package) rights: UInt32,
    public(package) slot: Int,
}

extension MemoryObject {
    public(package) func allows(&self, right: MemoryRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// An IoMemory handle the dispatch has VALIDATED, paired with its rights and
/// the window slot it names (spec §2.5; sawos design 6 D-1).
///
/// It is a SEPARATE wrapper from `MemoryObject` and not a flag on one, which is
/// the type-system half of D-1's ruling: a function that takes one of these can
/// only ever have been handed a device window, so "a Device region cannot
/// produce a cacheable mapping" is a fact about which `allows` compiles rather
/// than a check somebody runs.
public(package) struct IoMemoryObject {
    public(package) handle: IoMemoryHandle,
    public(package) rights: UInt32,
    public(package) slot: Int,
}

extension IoMemoryObject {
    public(package) func allows(&self, right: IoMemoryRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

