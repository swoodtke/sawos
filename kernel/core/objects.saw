//! Handles and the objects they name (spec §2, §3, §5.7): the process-indexed
//! handle table, and the validated wrapper each object kind gets out of it.
//!
//! This is the vocabulary the dispatch is written in, held below every table it
//! indexes into: a `HandleEntry` says which kind and which slot, and the typed
//! wrappers pair a kind with its rights word so testing one kind's right
//! against another's object is a compile error rather than a bit comparison.
//!
//! `SlotState` is here rather than beside any one slab because several of them
//! answer the same question with it.

import sosabi.{
    ObjType,
    SystemHandle,
    ProcessHandle,
    ThreadHandle,
    EventHandle,
    WaiterHandle,
    InterruptHandle,
    ClockHandle,
    TimerHandle,
    SystemRight,
    ProcessRight,
    ThreadRight,
    EventRight,
    WaiterRight,
    InterruptRight,
    ClockRight,
    TimerRight,
    MemoryHandle,
    MemoryRight,
    IoMemoryHandle,
    IoMemoryRight,
    MappingHandle,
    MappingRight,
    PipeInletHandle,
    PipeInletRight,
    PipeOutletHandle,
    PipeOutletRight,
    PipeReplyHandle,
    PipeReplyRight,
    PipeRequestHandle,
    PipeRequestRight,
    PIPE_BODY_BYTES,
    PIPE_MSG_HANDLES,
    BootHandleKind,
    SosStatus,
    NO_HANDLE,
    HANDLE_INDEX_BITS,
    HANDLE_INDEX_MASK,
    HANDLE_GENERATION_MODULUS,
}
import kcore.limits.{
    DEFAULT_QUOTA_EVENTS,
    DEFAULT_QUOTA_HANDLES,
    DEFAULT_QUOTA_INTERRUPTS,
    DEFAULT_QUOTA_IOMEMORIES,
    DEFAULT_QUOTA_MAPPINGS,
    DEFAULT_QUOTA_MEMORIES,
    DEFAULT_QUOTA_PIPES,
    DEFAULT_QUOTA_THREADS,
    DEFAULT_QUOTA_TIMERS,
    DEFAULT_QUOTA_WAITERS,
    MAX_EVENTS,
    MAX_FREE_RANGES,
    MAX_HANDLES,
    MAX_INTERRUPTS,
    MAX_IOMEMORIES,
    MAX_MAPPINGS,
    MAX_MEMORIES,
    MAX_PIPES,
    MAX_SLAB_EXTENTS,
    MAX_TIMERS,
    MAX_WAITERS,
    NO_FREE_RANGE,
    NO_IOMEMORY,
    NO_MAPPING,
    NO_MEMORY,
    NO_PIPE,
    NO_PROCESS,
    PIPE_INFLIGHT,
}
import kcore.diag.{fatal_kernel}
import kcore.slab.{Slab}
// The handle table and the boot-handle queue are fields of the process body
// (`PROCESSES`, reached through `body_of`) and the quota ledger of the process
// record (`PROCESS_RECORDS`). Both live below this file (in `pslot`) so these
// functions can reach them.
import kcore.pslot.{
    BootHandleSlot,
    HandleEntry,
    PROCESSES,
    PROCESS_RECORDS,
    QUOTA_KINDS,
    QuotaKind,
    body_of,
}

/// A System handle the dispatch has validated (§3).
///
/// The type pairs a handle kind with its rights word. The only way to get one
/// is through `dispatch`, after the table resolved the handle to a System
/// object, so the type carries the claim "validated as System" and `allows`
/// accepts a `SystemRight` and nothing else. The other `*Object` wrappers below
/// are the same construction with their own rights enums.
public(package) struct SystemObject {
    public(package) handle: SystemHandle,
    public(package) rights: UInt32,
}

extension SystemObject {
    /// Whether this holder may perform an op requiring `right`.
    ///
    /// The mask arithmetic lives here rather than at each call site, so there
    /// is one place to change when rights become a wider word.
    public(package) func allows(&self, right: SystemRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// A Process handle the dispatch has validated, paired with its rights and the
/// process record it names.
public(package) struct ProcessObject {
    public(package) handle: ProcessHandle,
    public(package) rights: UInt32,
    public(package) slot: Int,
}

extension ProcessObject {
    public(package) func allows(&self, right: ProcessRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

