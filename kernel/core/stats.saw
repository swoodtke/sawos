//! The shared stats region: the one storage the trap columns live in, and the
//! page a process maps to read them.
//!
//! The columns are rows of this region, and `ProcessOp.Stats` reads them from
//! here, so there is one storage and no mirror to keep in step.
//!
//! This module names `kcore.mem` (the alignment arithmetic), `kcore.diag` (the
//! kernel-bug report) and the HAL, and is named by the trap path, the stats op,
//! the process reset and the map op. Everything that writes a column is above
//! it and nothing it calls can reach back, the same test `mem` and `diag` pass.
//! That is why it sits down beside them rather than inside `pslot` (records, no
//! work) or `dispatch` (at the top, which would make the loader's boot-time
//! publish an upward reach).
//!
//! # Capacity
//!
//! The region has `PROT_DOMAIN_SLOTS` rows. A region sized to the compiled
//! floor would silently stop counting donated process slots, since a slot with
//! no row has nowhere to count. `alloc_process` scans to
//! `process_slots_usable()` =
//! `min(PROCESSES.capacity(), hal.PROT_DOMAIN_SLOTS)`, so `PROT_DOMAIN_SLOTS`
//! is a ceiling on the slot index the machine can ever hand out (donation
//! raises the capacity, not that). A region with that many rows therefore has a
//! row for every process that can ever exist on this build.
//!
//! The cost is `.bss` only: an all-zero static is zerofill, so the image
//! carries none of it.

import hal

import sosabi.{StatsRow, StatsRegionHeader, STATS_REGION_VERSION,
               PROCESS_STATS_RECORD_DOUBLEWORDS, PROCESS_STATS_SYSCALLS_SLOT,
               PROCESS_STATS_INTERRUPTS_SLOT, PROCESS_STATS_FAULTS_SLOT}

import kcore.mem.{align_up}
import kcore.diag.{fatal_kernel}

// =============================================================================
// The shape, in doublewords
// =============================================================================
//
// The backing is raw doublewords and the ABI is typed structs, pinned to each
// other by the asserts below. A reader overlays `sosabi`'s `StatsRegionHeader`
// / `StatsRow` and reads by field name, while the writer is the trap path,
// which must touch one doubleword per trap: a typed read-modify-write of a
// whole row would be three loads and three stores where one of each will do, on
// the hottest path in the kernel. So the write side indexes by the slot
// constants `sosabi` publishes for the copy-out record, the same names
// describing the same layout.

/// Bytes in a doubleword. Named because it appears in the offset arithmetic
/// below, and asserted rather than assumed.
static DOUBLEWORD_BYTES: Int = 8

static_assert(sizeof<UInt64>() == DOUBLEWORD_BYTES,
              "a doubleword must be eight bytes for the region arithmetic")

/// Doublewords in the published header.
static HEADER_DOUBLEWORDS: Int = 4

static_assert(sizeof<StatsRegionHeader>() == HEADER_DOUBLEWORDS * DOUBLEWORD_BYTES,
              "the header's doubleword count must match the struct sosabi publishes")

/// Where each header field sits, in doublewords from the region's base. The
/// order is `StatsRegionHeader`'s declaration order, which is its layout.
static HEADER_VERSION_SLOT: Int = 0
static HEADER_ROWS_SLOT: Int = 1
static HEADER_ROW_BYTES_SLOT: Int = 2
static HEADER_ROWS_OFFSET_SLOT: Int = 3

/// Doublewords in one row — `sosabi`'s own number, not a second one.
static ROW_DOUBLEWORDS: Int = PROCESS_STATS_RECORD_DOUBLEWORDS

static_assert(sizeof<StatsRow>() == ROW_DOUBLEWORDS * DOUBLEWORD_BYTES,
              "a row's doubleword count must match the struct sosabi publishes")

/// How many rows the region publishes: one per process slot this build can ever
/// hand out. See the capacity argument in the module header.
public(package) static STATS_ROWS: Int = hal.PROT_DOMAIN_SLOTS

/// The alignment and granularity the region is placed and sized at when it is
/// mapped, as a compile-time bound.
///
/// It is the coarsest `PROT_GRAIN` any target in this tree publishes, and a
/// constant because a storage size has to fold. The runtime arithmetic below
/// aligns to `hal.PROT_GRAIN`, so the region a caller maps is exactly as tight
/// as the hardware allows. This constant sizes the slack the static carries so
/// that an aligned base exists inside it at all; the assert below keeps it true
/// as targets are added.
static REGION_ALIGN: Int = 4096

static_assert(hal.PROT_GRAIN <= 4096,
              "the stats region's compiled slack must cover this profile's protection grain")

static_assert((REGION_ALIGN % DOUBLEWORD_BYTES) == 0,
              "the region's alignment must be a whole number of doublewords")

/// The published region's own size — header plus every row.
static LIVE_DOUBLEWORDS: Int = HEADER_DOUBLEWORDS + STATS_ROWS * ROW_DOUBLEWORDS
static LIVE_BYTES: Int = LIVE_DOUBLEWORDS * DOUBLEWORD_BYTES

/// The static's size: the mapped span rounded up to the coarsest grain, plus
/// one more grain so an aligned base is reachable wherever the linker lands the
/// array. A caller never sees a byte the kernel did not mean to publish: the
/// tail of the last granule is the region's own storage, so rounding the span
/// up leaks nothing. Written on one line because a `static` initializer may not
/// wrap after the `=`.
static STORAGE_BYTES: Int = ((LIVE_BYTES + REGION_ALIGN - 1) / REGION_ALIGN) * REGION_ALIGN + REGION_ALIGN
static STORAGE_DOUBLEWORDS: Int = STORAGE_BYTES / DOUBLEWORD_BYTES

/// The region itself. An `unsafe static var` rather than a `Once` or an
/// `Atomic`: it is compound state mutated throughout, its consistency spans
/// words, and spec §7's uniprocessor argument plus
/// interrupts-masked-in-the-kernel is what serializes it.
///
/// All-zero, so it is zerofill and costs the image nothing. The header is
/// written at boot by `stats_publish` rather than declared, which keeps that
/// true: a non-zero initializer would move the whole region out of `.bss`.
unsafe static var STATS_STORAGE: [UInt64; STORAGE_DOUBLEWORDS] = [0; STORAGE_DOUBLEWORDS]

// =============================================================================
// Where the published region starts
// =============================================================================

/// The doubleword index within `STATS_STORAGE` at which the published region
/// begins: the alignment slack, measured rather than assumed.
///
/// The array is `[UInt64; N]`, so its address is already doubleword-aligned,
/// and a `PROT_GRAIN` is a power of two, so the distance to the next boundary
/// is a whole number of doublewords whichever side of eight the granularity
/// falls on. A grain finer than a doubleword is already satisfied and the
/// distance is zero; a coarser one is a multiple of eight.
func stats_first() unsafe -> Int {
    let raw = ((&var STATS_STORAGE) as UnsafePointer<UInt64>) as UInt
    let aligned = align_up(raw, hal.PROT_GRAIN)
    ((aligned - raw) / (DOUBLEWORD_BYTES as UInt)) as Int
}

/// Where the region is to the kernel: the address the kernel's own loads and
/// stores use, aligned to this target's real protection granularity.
func stats_region_base() unsafe -> UInt {
    align_up(((&var STATS_STORAGE) as UnsafePointer<UInt64>) as UInt, hal.PROT_GRAIN)
}

/// Where the region is to the hardware: the physical base a protection row has
/// to name, which is what the map op grants.
///
/// The two are not the same address on every target. A kernel static is reached
/// through whatever address the kernel runs at, while a grant row's output
/// address is a frame. Where the kernel lives in the linear map the two differ
/// by a fixed offset, and handing the kernel's own address to a protection row
/// produces a descriptor whose output address is not memory, which the hardware
/// reports as an address-size fault on the first read rather than as a missing
/// mapping. `hal.virt_to_phys` is the identity where the two coincide, so this
/// is one spelling everywhere.
public(package) func stats_region_phys() unsafe -> UInt {
    hal.virt_to_phys(stats_region_base())
}

/// How much of it is granted: the published size rounded up to this target's
/// granularity, because a protection row is granular and a row that stopped
/// mid-granule is not expressible.
public(package) func stats_region_len() -> UInt {
    align_up(LIVE_BYTES as UInt, hal.PROT_GRAIN)
}

// =============================================================================
// The columns
// =============================================================================

/// Which doubleword of the storage a row's column sits at.
func column_at(first: Int, row: Int, column: Int) -> Int {
    first + HEADER_DOUBLEWORDS + row * ROW_DOUBLEWORDS + column
}

/// Is there a row for this slot? Structurally always (see the module header's
/// capacity argument), so `false` is the kernel disagreeing with its own wall:
/// a kernel bug, reported as one rather than absorbed. `fatal_kernel` stops the
/// machine and is not declared `-> Never`, so every caller exits its own scope
/// after it.
func row_ok(row: Int) -> Bool {
    if row < 0 || row >= STATS_ROWS {
        return false
    }
    true
}

/// Add one to a column of `row`. The trap path's whole contact with the region.
///
/// One load and one store, which is why the write side does not go through a
/// typed overlay (see the section header above).
public(package) func stats_bump(row: Int, column: Int) unsafe {
    if not row_ok(row) {
        fatal_kernel("a trap was charged to a process slot with no stats row",
                     row as UInt)
        return
    }
    let at = column_at(stats_first(), row, column)
    STATS_STORAGE[at] = STATS_STORAGE[at] + 1
}

/// Read `row`'s three columns out of the region: what `ProcessOp.Stats` answers
/// with, from the one storage rather than from a copy of it.
public(package) func stats_read(row: Int) unsafe -> StatsRow {
    if not row_ok(row) {
        fatal_kernel("stats were asked for a process slot with no row", row as UInt)
        return StatsRow(syscalls: 0, interrupts: 0, faults: 0)
    }
    let first = stats_first()
    StatsRow(syscalls: STATS_STORAGE[column_at(first, row, PROCESS_STATS_SYSCALLS_SLOT)],
             interrupts: STATS_STORAGE[column_at(first, row, PROCESS_STATS_INTERRUPTS_SLOT)],
             faults: STATS_STORAGE[column_at(first, row, PROCESS_STATS_FAULTS_SLOT)])
}

/// Zero `row`'s columns. A process create does this so a reused slot never
/// inherits its predecessor's traffic (the rule `sosabi`'s record block
/// states).
public(package) func stats_clear(row: Int) unsafe {
    if not row_ok(row) {
        fatal_kernel("stats were cleared for a process slot with no row", row as UInt)
        return
    }
    let first = stats_first()
    STATS_STORAGE[column_at(first, row, PROCESS_STATS_SYSCALLS_SLOT)] = 0
    STATS_STORAGE[column_at(first, row, PROCESS_STATS_INTERRUPTS_SLOT)] = 0
    STATS_STORAGE[column_at(first, row, PROCESS_STATS_FAULTS_SLOT)] = 0
}

// =============================================================================
// Publishing
// =============================================================================

/// Write the header, once, before anything can count.
///
/// A boot-time write rather than a static initializer, because an all-zero
/// static is zerofill and a non-zero one is not: declaring the version would
/// move the whole region, every row of it, out of `.bss` and into the image.
/// A few stores at boot buy that back.
public(package) func stats_publish() unsafe {
    let first = stats_first()
    STATS_STORAGE[first + HEADER_VERSION_SLOT] = STATS_REGION_VERSION
    STATS_STORAGE[first + HEADER_ROWS_SLOT] = STATS_ROWS as UInt64
    let row_bytes = ROW_DOUBLEWORDS * DOUBLEWORD_BYTES
    let rows_offset = HEADER_DOUBLEWORDS * DOUBLEWORD_BYTES
    STATS_STORAGE[first + HEADER_ROW_BYTES_SLOT] = row_bytes as UInt64
    STATS_STORAGE[first + HEADER_ROWS_OFFSET_SLOT] = rows_offset as UInt64
}
