//! The switch point, and process teardown.
//!
//! This module sits above `threads`, `objects`, `time` and `waitables` and
//! below `dispatch`. Choosing nothing to run parks the core in the idle poll
//! (`irq`); retiring the last thread of a process ends the process. The seam
//! that decides when to ask, `ktrap`'s user-return boundary, lives in
//! `dispatch`.
//!
//! `end_process` lives here rather than in `process` because ending a process
//! can reschedule, rescheduling can idle, and idle delivery reaches back
//! through `refs` into `process.copy_out`. Placing it in `process` would create
//! an import cycle. The process record and body (`pslot`), the grant-record
//! operations (`process`) and the slabs stay where they are; only the function
//! that frees them is here. Consequence: `process`'s copy routines report a bad
//! buffer instead of terminating, and the callers above the switch point
//! terminate on it.

import hal
import sosabi.{
    ObjType,
    FaultReason,
    ProcessStatusKind,
    SosStatus,
}
import kcore.limits.{
    MAX_ATTACHMENTS,
    MAX_EVENTS,
    MAX_HANDLES,
    MAX_INTERRUPTS,
    MAX_MAPPINGS,
    MAX_TIMERS,
    MAX_WAITERS,
    NO_BODY,
    NO_PROCESS,
    NO_THREAD,
    ROOT_PROCESS,
}
import kcore.result.{op_status, op_value, write_result}
import kcore.diag.{ExitCode, console, fatal_kernel}
import kcore.stats.{stats_read}
import kcore.pslot.{PROCESSES, PROCESS_RECORDS, ProcessState, QuotaKind,
                    body_of, has_body, unlink_body}
import kcore.objects.{
    MAPPINGS,
    MappingSlot,
    NO_ROW,
    ROW_TARGET_DIED,
    SlotState,
    clear_boot_handles,
    quota_clear,
    quota_credit,
    unbind_handle,
}
import kcore.refs.{free_object, notify_ready, reap_unreferenced, ref_object,
                   release_pending_calls, unref_object, unref_teardown,
                   unref_waitable_teardown}
import kcore.threads.{
    CURRENT_THREAD,
    LAST_PROT_PROCESS,
    NEED_RESCHED,
    SLICE_LEFT,
    SLICE_TICKS,
    THREADS,
    ThreadSlot,
    ThreadState,
    frame_slot,
    live_threads,
    ready_pop,
    ready_push,
    ready_remove_process,
    unjoin_process,
}
import kcore.time.{TIMERS, TimerSlot, reprogram_timer}
import kcore.waitables.{
    ATTACHMENTS,
    Attachment,
    INTERRUPTS,
    InterruptSlot,
    WAITERS,
    WaitableKind,
    WaiterSlot,
    set_waitable_attachment,
}
import kcore.process.{clear_domain, load_domain}

import kcore.irq.{has_external_wake_source, idle_until_runnable}

// =============================================================================
// The scheduler
// =============================================================================

/// Whether the currently running thread should be left running.
func stays_running(slot: Int) unsafe -> Bool {
    match THREADS[slot].state {
        case Running -> not NEED_RESCHED,
        case _ -> false,
    }
}

/// Make `next` the running thread, reloading its protection domain if the
/// domain in the hardware is somebody else's, and answer with its frame.
///
/// Switches within one process reload nothing. The domain is not shared across
/// processes: each process has its own protection record, which `load_domain`
/// (`kcore.process`) installs, replaying the rows or switching tables as the
/// HAL advertises. So there is no per-profile branch here.
///
/// This is one helper rather than two copies because a thread starts running
/// in two places, `pick_next` at the trap-return boundary and
/// `resume_after_death` after the running thread has ceased to exist. A reload
/// written in only one of them would be missing from the other.
func run_thread(next: Int) unsafe -> UInt {
    CURRENT_THREAD = next
    THREADS[next].state = ThreadState.Running
    SLICE_LEFT = SLICE_TICKS
    let np = THREADS[next].process
    if np != LAST_PROT_PROCESS {
        load_domain(np)
    }
    frame_slot(next)
}

/// Choose the thread to run next and return the frame to resume in.
///
/// This is the only switch point. `ktrap` returns whatever this returns, and
/// the HAL's trap entry resumes that frame, so every context switch is this
/// function picking a different slot. A kernel with no Thread objects (the
/// harness cases) never has a current thread and gets its own frame back.
///
/// Both early returns keep the same thread, so the protection domain cannot
/// have changed at either. That is why the reload lives at the tail, in
/// `run_thread`, and not at the top of this function.
public(package) func pick_next(current_frame: UInt) unsafe -> UInt {
    let cur = CURRENT_THREAD
    if cur == NO_THREAD {
        return current_frame
    }
    if stays_running(cur) {
        return current_frame
    }

    // A thread leaving the processor while still runnable goes to the tail
    // (round-robin). One that blocked or exited is already on the list it
    // belongs to, or on none.
    match THREADS[cur].state {
        case Running -> {
            THREADS[cur].state = ThreadState.Runnable
            ready_push(cur)
        },
        case _ -> {},
    }
    NEED_RESCHED = false

    var next = ready_pop()
    if next == NO_THREAD {
        // Nothing runnable. With a bound IRQ line or an armed Timer
        // (`has_external_wake_source`), readiness can still arrive from outside
        // the set of runnable threads, so the kernel waits for it in the idle
        // path. With neither, every thread is blocked on something no thread
        // can now deliver: a deadlock. The process whose thread just blocked
        // is the one that cannot proceed, so it is the one terminated, and the
        // machine reschedules. The cascade ends when root dies, which
        // stops the machine.
        if not has_external_wake_source() {
            fault_process(THREADS[cur].process, FaultReason.Deadlock)
        }
        idle_until_runnable()
        next = ready_pop()
    }

    run_thread(next)
}

/// Resume whatever should run now, after the thread that was running has
/// ceased to exist. Never returns.
///
/// This is `pick_next`'s tail without its head: there is no outgoing thread to
/// requeue, because the outgoing thread's process has just been torn down and
/// the thread with it: its slot is freed, or held, `Exited` or invalid, for the
/// handles still naming it.
///
/// The no-wake-source arm ends root, unlike `pick_next`, which ends the
/// current process. Here the process that was current is already gone, so
/// there is nobody to blame: every surviving process is blocked on something no
/// thread can now deliver. Ending root is a policy (root is init, and ending it
/// stops the machine), whoever else is in that set. A root parked on its
/// child's Process handle is woken by the death (`end_process` notifies before
/// tearing down), so `ready_pop` finds root and this arm is not reached. What
/// does reach it is a genuine deadlock.
func resume_after_death() unsafe -> Never {
    var next = ready_pop()
    if next == NO_THREAD {
        if not has_external_wake_source() {
            fault_process(ROOT_PROCESS, FaultReason.Deadlock)
        }
        idle_until_runnable()
        next = ready_pop()
    }
    hal.resume_frame(run_thread(next))
}

/// Retire the running thread with `code`, waking everything that joined it.
///
/// A joiner's return is written here, into its frame. A thread that blocks in a
/// syscall must not have its result written when it blocks, or the resume would
/// step over the trapping instruction twice on one profile and hand back a
/// value nobody computed on both. So `Join` writes nothing, and the wake
/// writes the result pair exactly once.
///
/// The slot stays `Exited`, holding the code for a late join, and keeps its
/// quota charge. It is not freed here: `ThreadOp.Exit` names the thread through
/// a handle, so its count is at least one. It is freed, and the charge given
/// back, when its last handle goes (`free_object`), or by its process's
/// teardown once nothing names it.
public(package) func exit_thread(slot: Int, code: UInt) unsafe {
    THREADS[slot].state = ThreadState.Exited
    THREADS[slot].exit_code = code

    var j = THREADS[slot].joiners
    THREADS[slot].joiners = 0
    while j != 0 {
        let waiter = j - 1
        j = THREADS[waiter].link
        write_result(frame_slot(waiter), op_value(code))
        THREADS[waiter].state = ThreadState.Runnable
        ready_push(waiter)
    }

    // The last thread out ends the process, carrying its own exit code (the
    // ordinary way a program finishes without `Process.Exit`). For root that
    // stops the machine; for a child `end_process` does not return here,
    // because it resumes whoever runs next.
    let p = THREADS[slot].process
    if live_threads(p) == 0 {
        end_process(p, ProcessStatusKind.Exited, code, code)
    }
    NEED_RESCHED = true
}

// =============================================================================
// Process teardown (spec §2.10: close all handles, free what it owned)
// =============================================================================

/// Invalidate thread `t` of dying process `p` (spec §2.10): it never runs
/// again, and its slot keeps nothing for a join.
///
/// Every thread parked joining it is woken with `Revoked`, written into its
/// frame as `exit_thread` writes a joiner's code; the object it waited on was
/// destroyed by somebody else. Those joiners are other processes' threads,
/// because the teardown took `p`'s own off every joiner list first
/// (`unjoin_process`). The charge comes back now, while `p`'s ledger is live.
///
/// The slot keeps its count and nothing else: `Invalid`, owned by nobody, so
/// that a later occupant of `p`'s record cannot match it, and on no list. The
/// caller frees it if the count is zero.
func invalidate_thread(t: Int, p: Int) unsafe {
    var j = THREADS[t].joiners
    while j != 0 {
        let waiter = j - 1
        j = THREADS[waiter].link
        write_result(frame_slot(waiter), op_status(SosStatus.Revoked))
        THREADS[waiter].state = ThreadState.Runnable
        ready_push(waiter)
    }
    quota_credit(p, QuotaKind.Thread)
    let refs = THREADS[t].refs
    THREADS[t] = ThreadSlot(state: ThreadState.Invalid, process: NO_PROCESS,
                            exit_code: 0, joiners: 0, link: 0, wait_buf: 0,
                            call_pipe: 0, call_claim: 0, call_src: 0,
                            call_len: 0, refs: refs)
}

/// End process `p`. Never returns.
///
/// Teardown is unconditional: every handle in the process's table is closed,
/// every thread it owns stops running, and every Waiter, Interrupt, Timer and
/// Mapping it held goes back to its slab. A thread that had not exited is
/// invalidated; one that had keeps its exit code. Either goes back to the pool
/// when nothing names it any more, and one still named elsewhere outlives the
/// process, disowned. An Event goes back when nothing names it any more; one
/// that is still named elsewhere outlives the process, disowned
/// (`reap_unreferenced`). Its trap counters are copied into its record, and its
/// body (the handle table, the boot set and the grant record) is freed for the
/// next create. The record stays, `Gone`, for as long as a reference names it.
/// Then:
///
///   - Process 0 (root, init) stops the machine. Its children die with it,
///     uncounted.
///   - A child reschedules. Its threads leave the ready queue by removal, its
///     body goes back, and the path ends in `resume_after_death`, so root is
///     simply the next thing picked. A supervisor parked on the child's Process
///     handle is woken by the `notify_ready` at the top of this function.
///
/// A record is never reclaimed before its own teardown has ended, because the
/// teardown writes it after the point where its last reference can go: the
/// notify can deliver a one-shot attachment holding that reference, and the
/// counters, the body link and the ledger are written further down. So the
/// teardown holds a reference of its own on the record, taken as the record
/// turns `Gone` and dropped by an ordinary `unref_object` at the end, which is
/// where a record nothing else names is reclaimed. Every other reclaim path
/// (a release, a detach, a delivery, the reap's process scan) then needs no
/// special case: each sees a count that cannot reach zero until that drop.
///
/// A `Gone` record has no body, and the teardown can run on one a second time:
/// a creation op through a `Gone` process's handle can still fault the named
/// process (spec §2.10's not-yet-enforced list). The body's steps are skipped
/// then, since the first teardown did them.
///
/// `code` is what a supervisor reads out of the spec §8 status word.
/// `machine_status` is what the emulator exits with, which for a fault is the
/// kernel's own vocabulary rather than anything the process chose. It is read
/// only on the process-0 arm.
///
/// There is no preemption point anywhere in the teardown. The scheduler is
/// dismantled across it (`CURRENT_THREAD` and the dying process's queue entries
/// are cleared before the scans), so IRQ-shared state is in flight for the
/// whole walk. It is bounded, and ends in a machine stop or a fresh schedule.
public(package) func end_process(p: Int, kind: ProcessStatusKind, code: UInt,
                 machine_status: UInt) unsafe -> Never {
    PROCESS_RECORDS[p].state = ProcessState.Gone
    PROCESS_RECORDS[p].exit_kind = kind
    PROCESS_RECORDS[p].exit_code = code
    // The teardown's own reference, dropped at the end (see above). It is taken
    // before the notify, which is the first thing that can drop another.
    ref_object(ObjType.Process, p)
    let body = if has_body(p) { body_of(p) } else { NO_BODY }

    // A parked supervisor is told here, the earliest point at which the wait
    // record (the three fields above) is honest. The wake only queues:
    // `notify_ready` reaches `wake_one_waiter`, which writes the record into
    // the supervisor's memory and pushes its thread onto the ready queue
    // without switching. The whole teardown below runs to completion first and
    // the woken thread is picked up by `resume_after_death`, so no observer
    // sees a half-dead process. The call is unconditional, root included:
    // root's record can only be attached by root, and root's death stops the
    // machine.
    notify_ready(WaitableKind.Process, p)

    // A child's clean exit is reported on its own line. A child that was
    // donated its own Process handle exits with a code, and that code is the
    // only thing it can say: nobody holds a status word to read and it has no
    // console handle. This stays a separate line, not a field on the teardown
    // line below, so the teardown line is identical for every process. The
    // fault half is reported by `fault_process`.
    if p != ROOT_PROCESS {
        match kind {
            case Exited -> {
                let out = console()
                out.write_str("SOS: process exit: code=")
                out.write_hex(code)
                out.write_str(" process=")
                out.write_hex(p as UInt)
                out.write_str("\n")
            },
            case _ -> {},
        }
    }

    // Orphaned claims go first. A thread parked in a fused `PipeInletOp.Call`
    // holds its exchange's claim column open without a handle entry, so the
    // close-all below cannot reach it, and the thread sweep further down would
    // invalidate the thread while `Exchange.caller` still named it. Dropping
    // the claim abandons the call: the column falls to zero, and the server's
    // later `reply` reads that as abandoned-by-client and answers
    // `Err(PeerClosed)`.
    //
    // This must run before the close-all, because the close-all drops endpoint
    // columns, every such transition notifies, and a notification must never
    // find a thread of the process being torn down. `release_pending_calls`
    // carries the two-pass argument for why its own unrefs cannot either.
    release_pending_calls(p)

    // The dying process's threads come off every list a thread parks on, here,
    // before the close-all. The close-all drops references, a dropped reference
    // can deliver (a settle frees ring room, a resumed fused call stages a
    // message, and an outlet attachment takes it), and a delivery to a thread
    // of this process would mint into a table the close-all has already
    // passed: the body would go back with that entry bound. Off every list, no
    // wake can find one of these threads:
    //
    //   - The ready queue is edited, not emptied: other processes' runnable
    //     threads stay.
    //   - Every joiner list, so that an invalidation's wake reaches only other
    //     processes' joiners and no surviving thread names one of these.
    //   - Its own Waiters' blocked lists, emptied whole. A Waiter's handles
    //     stay in its owner's table (`waiter_rights()` withholds `Transfer`,
    //     and `WaiterCreate` mints into the named process's table), so only
    //     the owner's threads park on one, and the Waiter sweep below frees it
    //     without walking the list.
    //
    // Each walk reads `process`, which the thread sweep rewrites, so this also
    // has to come before that.
    ready_remove_process(p)
    unjoin_process(p)
    var wb: Int = 0
    while wb < WAITERS.capacity() {
        match WAITERS[wb].state {
            case Free -> {},
            case Live -> {
                if WAITERS[wb].process == p {
                    WAITERS[wb].blocked = 0
                }
            },
        }
        wb = wb + 1
    }

    // The close-all goes through `unbind_handle`, so teardown and release do
    // the same thing to a slot: zero the binding and bump the generation. The
    // bump matters because the body is freed below, so these entries can be
    // minted into again, and a word from the dead process's life must not
    // resolve in the next one's. It touches only the entry, never the object.
    //
    // Each entry is also one reference fewer, and objects another process owns
    // must see that (a region a launcher gave a child, for example). The
    // decrement is `unref_teardown`, which deliberately does not free at zero:
    // the sweeps below free what this process owned, by ownership, and count
    // what they freed for the report. Freeing by reference here would collapse
    // those counts. `unref_teardown`'s docstring carries the argument.
    var closed: UInt = 0
    var h: Int = 0
    while body != NO_BODY && h < MAX_HANDLES {
        let entry = PROCESSES[body].handles[h]
        match entry.obj_type {
            case Unbound -> {},
            case _ -> {
                unref_teardown(entry.obj_type, entry.target)
                unbind_handle(p, h)
                closed = closed + 1
            },
        }
        h = h + 1
    }

    // The thread sweep (spec §2.10). The close-all above has already dropped
    // every reference this process held, so a count here is names held
    // elsewhere: another process's table or a staged message.
    //
    //   - A thread of this process that has not exited is invalidated
    //     (`invalidate_thread`), the running one included unless its own exit
    //     is what ended the process.
    //   - One that exited keeps its exit code for a late join, `Exited` wins,
    //     and is disowned, so that its free credits nobody.
    //   - Either is freed now if nothing names it, and counted for the
    //     teardown line. One still named survives, owned by nobody, until its
    //     last handle goes. The frees go through `free_object`, which gives an
    //     `Exited` thread's charge back.
    //   - Another process's `Exited` or `Invalid` thread whose last name was
    //     in this process's table is freed too, uncounted: the close-all
    //     counts without freeing (`unref_teardown`).
    var freed: UInt = 0
    var t: Int = 0
    while t < THREADS.capacity() {
        match THREADS[t].state {
            case Free -> {},
            case Exited -> {
                if THREADS[t].refs == 0 {
                    if THREADS[t].process == p {
                        freed = freed + 1
                    }
                    free_object(ObjType.Thread, t)
                } else if THREADS[t].process == p {
                    THREADS[t].process = NO_PROCESS
                }
            },
            case Invalid -> {
                if THREADS[t].refs == 0 {
                    free_object(ObjType.Thread, t)
                }
            },
            case _ -> {
                if THREADS[t].process == p {
                    invalidate_thread(t, p)
                    if THREADS[t].refs == 0 {
                        free_object(ObjType.Thread, t)
                        freed = freed + 1
                    }
                }
            },
        }
        t = t + 1
    }
    // This assumes the dying process is the caller, so the running thread was
    // one of the slots just swept (invalidated, or `Exited` when its own exit
    // ended the process) and nothing is current any more. A
    // path that ends some other process while a caller runs (a creation op
    // through another process's handle faulting that process, spec §2.7)
    // strands that caller: its thread stays `Running`, on no list, and is never
    // scheduled again. Its process does not end on that account, since the
    // stranded thread never exits.
    CURRENT_THREAD = NO_THREAD

    // Interrupts go back first. Masking each line is not just bookkeeping: a
    // device the dead process was driving may still be asserting, and an
    // unmasked line with no object behind it would be taken, reported and
    // masked once per fire forever. Spec §9 masks on fire and unmasks on ack;
    // here the mask happens with no ack coming.
    var irqs_freed: UInt = 0
    var q: Int = 0
    while q < INTERRUPTS.capacity() {
        if INTERRUPTS[q].process == p {
            match INTERRUPTS[q].state {
                case Free -> {},
                case Live -> {
                    hal.irq_mask(INTERRUPTS[q].line)
                    INTERRUPTS[q] = InterruptSlot(state: SlotState.Free,
                                                  process: 0, line: 0,
                                                  pending: false, attachment: 0,
                                                  refs: 0)
                    irqs_freed = irqs_freed + 1
                },
            }
        }
        q = q + 1
    }

    // Attachments belong to a Waiter, so they are reclaimed by walking the
    // process's waiters: an attachment is a row in a Waiter's table and dies
    // with it. Each is also unhooked from the far end, because a supervisor's
    // Waiter can attach to a child's process record, and that pair spans two
    // processes:
    //
    //   - Clear the back pointer, or the waitable's `attachment` field would
    //     name a slot this loop has just freed. For a same-process waitable the
    //     per-slab sweeps below zero it anyway; for a Process record another
    //     process owns, this stops a later death from notifying through a
    //     stale index.
    //   - Count without freeing (`unref_waitable_teardown`), for the same
    //     reason as the handle close-all above: an object another process owns
    //     must see the reference go, and freeing is the per-slab sweeps' job.
    //
    // Reachable when a supervisor dies before what it watches.
    var a: Int = 0
    while a < ATTACHMENTS.capacity() {
        match ATTACHMENTS[a].state {
            case Free -> {},
            case Live -> {
                if WAITERS[ATTACHMENTS[a].waiter].process == p {
                    let watched = ATTACHMENTS[a].kind
                    let watched_slot = ATTACHMENTS[a].target
                    ATTACHMENTS[a] = Attachment(state: SlotState.Free,
                                                kind: WaitableKind.Event,
                                                target: 0, waiter: 0, key: 0,
                                                oneshot: false, owns: false,
                                                link: 0)
                    set_waitable_attachment(watched, watched_slot, 0)
                    unref_waitable_teardown(watched, watched_slot)
                }
            },
        }
        a = a + 1
    }

    // Waiters go back to their slabs whole (spec §2.7). No unlinking is needed
    // first: the attachment loop above has already unhooked every attachment of
    // this process's waiters, and their blocked lists were emptied before the
    // thread sweep. Events are not swept here: an Event is a shared kind, freed
    // or disowned by `reap_unreferenced` below.
    var waiters_freed: UInt = 0
    var w: Int = 0
    while w < WAITERS.capacity() {
        if WAITERS[w].process == p {
            match WAITERS[w].state {
                case Free -> {},
                case Live -> {
                    WAITERS[w] = WaiterSlot(state: SlotState.Free, process: 0,
                                            attached: 0, blocked: 0, refs: 0)
                    waiters_freed = waiters_freed + 1
                },
            }
        }
        w = w + 1
    }

    // No Clock is reclaimed here. A Clock is kernel-eternal and owned by
    // nobody; the process's clock handle was unbound by the close-all above,
    // which touches only the table entry. Freeing the clock's slot would take
    // the monotonic clock away from everybody else.
    //
    // Timers go back for the same reason as interrupts: a dead process's armed
    // deadline is one the kernel would otherwise keep waking itself for, with
    // nobody left to tell. Freeing them and reprogramming takes the comparator
    // back.
    var timers_freed: UInt = 0
    var tm: Int = 0
    while tm < TIMERS.capacity() {
        if TIMERS[tm].process == p {
            match TIMERS[tm].state {
                case Free -> {},
                case Live -> {
                    TIMERS[tm] = TimerSlot(state: SlotState.Free, process: 0,
                                           clock: 0, armed: false,
                                           deadline_ns: 0, interval_ns: 0,
                                           fires: 0, attachment: 0, refs: 0)
                    timers_freed = timers_freed + 1
                },
            }
        }
        tm = tm + 1
    }
    reprogram_timer()

    // Counted kinds that other processes may still reference (memory regions,
    // IO windows, pipe connections, Events) are not force-freed by their
    // creator's death. References govern lifetime: a slot outlives its creator
    // for as long as anybody holds a reference. A forced free would pull a
    // connection out from under a peer that still holds an end, staged
    // messages and all.
    // Don't force-free by `process` field: a give does not move a slot's
    // `process` field, so a region a launcher gave a child is not the dying
    // process's to free. What the dying process was charged for is written off
    // by `quota_clear` below.
    //
    // `reap_unreferenced` gives back what nobody names. It must exist because
    // the close-all above counts without freeing, so a slot whose last handle
    // the dying process held would otherwise be stranded. The free goes through
    // `free_object`, so each kind's quota credit runs, onto this ledger for
    // what this process was charged for. Whatever survives and is charged to
    // this process is disowned in the same scans: it is charged to nobody from
    // here on, and its eventual free credits nobody rather than whichever
    // process occupies this record by then (spec §2.10).
    //
    // Whether either arm does anything is a property of the wiring, not of the
    // table: the reap frees only what the dying process was the last to name,
    // and disowns only what it was charged for and something else still
    // names.
    //
    // The reap also reclaims any other `Gone` process record whose last
    // reference the close-all or the attachment sweep just dropped; this
    // process's own record waits for the teardown's drop below.
    //
    // Events are freed or disowned by the reap, which answers the count the
    // teardown line reports. Threads were swept above: invalidated or disowned
    // by ownership, freed by count. Waiters, Interrupts and Timers are counted
    // for the teardown line and swept by ownership. Mappings are swept
    // below: a Mapping is not subject to the hazard above because
    // `mapping_rights()` withholds `Transfer`, so its handle cannot leave the
    // owning process.
    let events_freed = reap_unreferenced(p)

    // Mappings come apart from both ends, which is why this loop has two arms.
    // A Mapping names two processes: the owner, whose handle it is, and the
    // target, whose domain carries the row.
    //
    //   - The owner dying frees the slot. The row is not touched: a mapping
    //     dropped without an unmap is permanent, safe-but-leaked (spec §2.5),
    //     bounded here by the target's own death.
    //   - The target dying takes the row, because `clear_domain` below drops
    //     the whole grant record. The slot stays live and its owner keeps the
    //     handle, now naming a husk with nothing installed (`unmap` and
    //     `base` answer `Revoked`, spec §2.10). It must not be freed here:
    //     the owner's word still names this slot, and a reused slot would be
    //     reachable through it. Its `target` is disowned (spec §2.10), so the
    //     husk names nobody and no later process in this record or this body
    //     is reachable through it.
    //
    // A Mapping names its target only while it has a row there: `Unmap` and
    // this sweep each clear both together. So one naming the dying record
    // with no row (`NO_ROW` or `ROW_TARGET_DIED`) is a husk an earlier life of
    // this record left undisowned, which is a kernel bug, and it stops the
    // machine.
    var mp: Int = 0
    while mp < MAPPINGS.capacity() {
        match MAPPINGS[mp].state {
            case Free -> {},
            case Live -> {
                if MAPPINGS[mp].process == p {
                    MAPPINGS[mp] = MappingSlot(state: SlotState.Free, process: 0,
                                               target: 0, row: NO_ROW,
                                               refs: 0)
                } else if MAPPINGS[mp].target == p {
                    let row = MAPPINGS[mp].row
                    if row == NO_ROW || row == ROW_TARGET_DIED {
                        fatal_kernel("a husk still named a reused process record",
                                     mp as UInt)
                    }
                    MAPPINGS[mp].row = ROW_TARGET_DIED
                    MAPPINGS[mp].target = NO_PROCESS
                }
            },
        }
        mp = mp + 1
    }

    // The body's own parts go last, in spec §2.10's order, once every step
    // that can drop a reference or credit the ledger is behind them. A body
    // that is already gone was handled by this process's first teardown.
    if body != NO_BODY {
        // The counters first: nothing is charged to a process once its
        // teardown has begun (`ktrap` attributes to the current thread, and
        // this process has none left), so the copy is final. The row itself
        // stays as it is until a create reuses the body and clears it.
        PROCESS_RECORDS[p].final_stats = stats_read(body)

        // The protection rows go with the body, and `LAST_PROT_PROCESS` is
        // invalidated with them, so a later process landing in this record or
        // this body cannot compare equal to a domain that is no longer
        // installed.
        clear_domain(p)

        // The boot set, undrained records included. Every record names a
        // handle in the table the close-all already emptied, so what remains is
        // a count and a cursor. It must be reset because the body is reused,
        // and the next process in it would otherwise drain handles that are
        // not its own.
        clear_boot_handles(p)
    }

    // The quota ledger dies with the process. The charge of an object a peer
    // still references, which the reap above disowned, is written off here
    // with the rest. The books balance because quota <= wall (the slab refuses
    // the next allocation). No credit is owed to this row once it is cleared,
    // so `quota_credit`'s zero test is only a defence against an underflow.
    // The limits are cleared with the used counts so the next occupant of the
    // record does not inherit an allowance. A mapping row in another process's
    // domain is credited to that target when its row goes (its own `Unmap` or
    // teardown).
    quota_clear(p)

    // The body goes back for the next create, and the record stops naming it
    // (spec §2.10's disown of the record's own link). A create takes a reused
    // body's table as empty, so an entry still bound here would hand the next
    // process a capability it was never given. Nothing mints into a dying
    // table after the close-all, because no thread of this process is left on
    // a list a delivery reads; this checks that rather than trusting it.
    if body != NO_BODY {
        var e: Int = 0
        while e < MAX_HANDLES {
            match PROCESSES[body].handles[e].obj_type {
                case Unbound -> {},
                case _ -> {
                    fatal_kernel("a body went back with a bound handle entry",
                                 e as UInt)
                },
            }
            e = e + 1
        }
        PROCESSES[body].live = false
        unlink_body(p)
    }

    // The teardown's own reference goes, which reclaims the record if nothing
    // else names it: a process that held the last handle onto its own record
    // frees it here rather than leaving a `Gone` record nothing can reach. The
    // usual case is the opposite: a creator's handle onto its dead child
    // survives (keeping the spec §8 status word readable), and the creator's
    // release frees the record later.
    unref_object(ObjType.Process, p)

    let uart = console()
    uart.write_str("SOS: process teardown handles=")
    uart.write_hex(closed)
    uart.write_str(" threads=")
    uart.write_hex(freed)
    uart.write_str(" events=")
    uart.write_hex(events_freed)
    uart.write_str(" waiters=")
    uart.write_hex(waiters_freed)
    uart.write_str(" interrupts=")
    uart.write_hex(irqs_freed)
    // No `clocks=` field: this line counts what the process owned, and a Clock
    // is owned by nobody.
    uart.write_str(" timers=")
    uart.write_hex(timers_freed)
    // The process number (the record's index) comes last, so the fields before
    // it keep their positions.
    uart.write_str(" process=")
    uart.write_hex(p as UInt)
    uart.write_str("\n")

    if p != ROOT_PROCESS {
        // A child's death is a scheduling event: the machine has work left, so
        // this path never touches `machine_status` and never stops.
        resume_after_death()
    }

    if machine_status == 0 {
        hal.exit_pass()
    } else {
        hal.exit_fail(machine_status)
    }
    while { }
}

/// Terminate a process for a caller error it could have checked: an invalid
/// handle, an unknown op, a missing right, or an op aimed at the wrong thread.
///
/// This is not a status the process receives: the process is the thing that was
/// wrong, so it ends, and the kernel stays up to say so. Never returns: into a
/// stopped machine when root is the one that was wrong, and into whatever runs
/// next when it was a child.
public(package) func fault_process(p: Int, reason: FaultReason) unsafe -> Never {
    let uart = console()
    uart.write_str("SOS: process fault: ")
    uart.write_str(reason.describe())
    // The process number is appended so the reason reads first.
    uart.write_str(" process=")
    uart.write_hex(p as UInt)
    uart.write_str("\n")
    end_process(p, ProcessStatusKind.Faulted, (reason as UInt8) as UInt,
                ExitCode.ProcessFault as UInt)
}

/// The same termination, reached from a hardware fault rather than a syscall
/// (spec §8: a thread fault kills its process). The harness reads the report's
/// wording and shape, so keep them; which process it was is in the teardown
/// line that follows.
public(package) func fault_trap(tag: String, cause: UInt, epc: UInt, tval: UInt) unsafe -> Never {
    let uart = console()
    uart.write_str("SOS: fault ")
    uart.write_str(tag)
    uart.write_str(" cause=")
    uart.write_hex(cause)
    uart.write_str(" epc=")
    uart.write_hex(epc)
    uart.write_str(" tval=")
    uart.write_hex(tval)
    uart.write_str("\n")
    if CURRENT_THREAD != NO_THREAD {
        end_process(THREADS[CURRENT_THREAD].process, ProcessStatusKind.Faulted, 0,
                    ExitCode.UmodeFault as UInt)
    }
    // No process object yet: the harness kernels that enter user mode directly.
    hal.exit_fail(ExitCode.UmodeFault as UInt)
    while { }
}
