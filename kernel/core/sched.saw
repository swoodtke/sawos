import kcore.irq.{has_external_wake_source, idle_until_runnable}

// =============================================================================
// The scheduler
// =============================================================================

/// Whether the currently running thread should be left running.
func stays_running(slot: Int) unsafe -> Bool {
    match THREADS[slot].state {
        case Running -> not NEED_RESCHED,
        case _ -> false,
    }
}

/// Make `next` the running thread, reloading its protection domain if the
/// domain in the hardware is somebody else's, and answer with its frame.
///
/// Switches within one process reload nothing. The domain is not shared across
/// processes: each process has its own protection record, which `load_domain`
/// (`kcore.process`) installs, replaying the rows or switching tables as the
/// HAL advertises. So there is no per-profile branch here.
///
/// The incoming thread's floating-point state is installed here too
/// (`hal.fp_switch_in`), after the domain: it reads the thread's own frame, and
/// `pick_next` has already had the outgoing thread's saved by
/// `hal.fp_switch_out`.
///
/// This is one helper rather than two copies because a thread starts running
/// in two places, `pick_next` at the trap-return boundary and
/// `resume_after_death` after the running thread has ceased to exist. A reload
/// written in only one of them would be missing from the other.
func run_thread(next: Int) unsafe -> UInt {
    CURRENT_THREAD = next
    THREADS[next].state = ThreadState.Running
    SLICE_LEFT = SLICE_TICKS
    let np = THREADS[next].process
    if np != LAST_PROT_PROCESS {
        load_domain(np)
    }
    let frame = frame_slot(next)
    hal.fp_switch_in(frame)
    frame
}

/// Choose the thread to run next and return the frame to resume in.
///
/// This is the only switch point. `ktrap` returns whatever this returns, and
/// the HAL's trap entry resumes that frame, so every context switch is this
/// function picking a different slot. A kernel with no Thread objects (the
/// harness cases) never has a current thread and gets its own frame back.
///
/// Both early returns keep the same thread, so the protection domain cannot
/// have changed at either. That is why the reload lives at the tail, in
/// `run_thread`, and not at the top of this function.
public(package) func pick_next(current_frame: UInt) unsafe -> UInt {
    // First, so that what the trap just did is whole before anything is
    // chosen: a `Created` process whose last name it dropped is gone by the
    // time the caller, or anyone, runs again (`drain_unstarted`).
    drain_unstarted()
    let cur = CURRENT_THREAD
    if cur == NO_THREAD {
        return current_frame
    }
    if stays_running(cur) {
        return current_frame
    }

    // A thread leaving the processor while still runnable goes to the tail
    // (round-robin). One that blocked or exited is already on the list it
    // belongs to, or on none.
    match THREADS[cur].state {
        case Running -> {
            THREADS[cur].state = ThreadState.Runnable
            ready_push(cur)
        },
        case _ -> {},
    }
    NEED_RESCHED = false

    var next = ready_pop()
    if next == NO_THREAD {
        // Nothing runnable. With a bound IRQ line or an armed Timer
        // (`has_external_wake_source`), readiness can still arrive from outside
        // the set of runnable threads, so the kernel waits for it in the idle
        // path. With neither, every thread is blocked on something no thread
        // can now deliver: a deadlock. The process whose thread just blocked
        // is the one that cannot proceed, so it is the one terminated, and the
        // machine reschedules. The cascade ends when root dies, which
        // stops the machine.
        if not has_external_wake_source() {
            fault_process(THREADS[cur].process, FaultReason.Deadlock)
        }
        idle_until_runnable()
        next = ready_pop()
    }

    // The outgoing thread's floating-point state is saved while its slot is
    // still live, so a freed slot's frame is never written.
    hal.fp_switch_out(current_frame)

    // The outgoing thread is not read past this point. An exited thread that
    // nothing names goes now (`PENDING_FREE`).
    if PENDING_FREE != NO_THREAD {
        let gone = PENDING_FREE
        PENDING_FREE = NO_THREAD
        free_object(ObjType.Thread, gone)
    }

    run_thread(next)
}

/// Resume whatever should run now, after the thread that was running has
/// ceased to exist. Never returns.
///
/// This is `pick_next`'s tail without its head: there is no outgoing thread to
/// requeue, because the outgoing thread's process has just been torn down and
/// the thread with it: its slot is freed, or held, `Exited` or invalid, for the
/// handles still naming it.
///
/// The no-wake-source arm ends root, unlike `pick_next`, which ends the
/// current process. Here the process that was current is already gone, so
/// there is nobody to blame: every surviving process is blocked on something no
/// thread can now deliver. Ending root is a policy (root is init, and ending it
/// stops the machine), whoever else is in that set. A root parked on its
/// child's Process handle is woken by the death (`end_process` notifies before
/// tearing down), so `ready_pop` finds root and this arm is not reached. What
/// does reach it is a genuine deadlock.
func resume_after_death() unsafe -> Never {
    var next = ready_pop()
    if next == NO_THREAD {
        if not has_external_wake_source() {
            fault_process(ROOT_PROCESS, FaultReason.Deadlock)
        }
        idle_until_runnable()
        next = ready_pop()
    }
    hal.resume_frame(run_thread(next))
}

/// Retire the running thread with `code`, waking everything that joined it, and
/// release `handle`, the word the exit was invoked through.
///
/// A joiner's return is written here, into its frame. A thread that blocks in a
/// syscall must not have its result written when it blocks, or the resume would
/// step over the trapping instruction twice on one profile and hand back a
/// value nobody computed on both. So `Join` writes nothing, and the wake
/// writes the result pair exactly once.
///
/// The slot stays `Exited`, holding the code for a late join through any other
/// handle, and keeps its quota charge until its last reference goes. The
/// handle is unbound and its reference dropped here, after the thread is
/// marked `Exited`, because a drop to zero frees only an `Exited` or `Invalid`
/// slot. If that was the last reference the free is deferred to `pick_next`
/// (`PENDING_FREE`): this thread is still the running one until the switch,
/// and the switch reads its slot. The handle is unbound before the process can
/// end, so the teardown's close-all never drops it a second time.
///
/// When this was the process's last thread the process ends here, carrying the
/// code, and the teardown frees the slot if nothing names it.
public(package) func exit_thread(slot: Int, code: UInt, handle: UInt) unsafe {
    THREADS[slot].state = ThreadState.Exited
    THREADS[slot].exit_code = code

    var j = THREADS[slot].joiners
    THREADS[slot].joiners = 0
    while j != 0 {
        let waiter = j - 1
        j = THREADS[waiter].link
        write_result(frame_slot(waiter), op_value(code))
        THREADS[waiter].state = ThreadState.Runnable
        ready_push(waiter)
    }

    // The process is read once, here: the slot may be freed before the switch.
    let p = THREADS[slot].process
    unbind_handle(p, handle_word_index(handle))
    let _ = drop_reference(ObjType.Thread, slot)

    // The last thread out ends the process, carrying its own exit code (the
    // ordinary way a program finishes without `Process.Exit`). For root that
    // stops the machine; for a child `end_process` does not return here,
    // because it resumes whoever runs next.
    if live_threads(p) == 0 {
        end_process(p, ProcessStatusKind.Exited, code, code)
    }
    if THREADS[slot].refs == 0 {
        PENDING_FREE = slot
    }
    NEED_RESCHED = true
}

// =============================================================================
// Process teardown (spec §2.10: invalidate what it owned, release its table)
// =============================================================================

/// Invalidate thread `t` of dying process `p` (spec §2.10): it never runs
/// again, and its slot keeps nothing for a join.
///
/// Every thread parked joining it is woken with `Revoked`, written into its
/// frame as `exit_thread` writes a joiner's code; the object it waited on was
/// destroyed by somebody else. Those joiners are other processes' threads,
/// because the teardown took `p`'s own off every joiner list first
/// (`unjoin_process`). The charge comes back now, while `p`'s ledger is live.
///
/// The slot keeps its count and its owner and nothing else: `Invalid`, on no
/// list. The owner stays until the teardown disowns what survives its release,
/// so that the release can tell `p`'s own threads from others' when it counts
/// what it freed. The caller frees the slot if the count is zero.
func invalidate_thread(t: Int, p: Int) unsafe {
    var j = THREADS[t].joiners
    while j != 0 {
        let waiter = j - 1
        j = THREADS[waiter].link
        write_result(frame_slot(waiter), op_status(SosStatus.Revoked))
        THREADS[waiter].state = ThreadState.Runnable
        ready_push(waiter)
    }
    quota_credit(p, QuotaKind.Thread)
    let refs = THREADS[t].refs
    THREADS[t] = ThreadSlot(state: ThreadState.Invalid, process: p,
                            exit_code: 0, joiners: 0, link: 0, wait_buf: 0,
                            call_pipe: 0, call_claim: 0, call_src: 0,
                            call_len: 0, refs: refs)
}

/// Invalidate Waiter `w` of dying process `p` (spec §2.10): it stays, for the
/// handles that still name it, and does nothing more.
///
/// The threads parked on it were woken with `Revoked` before this runs
/// (`revoke_blocked`, for every Waiter of `p` at once). What is left is the
/// charge, which comes back now while `p`'s ledger is live, and the attachment
/// list, which is taken apart here. Each row is unhooked from the far end and
/// its reference released (`release_held`), so a waitable this Waiter was the
/// last to name is freed here. A Waiter can watch an object another process
/// owns (a supervisor's Waiter attached to a child's process record, or
/// anything a holder of a given Waiter attached), and that object must see the
/// reference go. The back pointer is cleared before the release, so the
/// waitable's `attachment` field never names a freed row and a release of an
/// Interrupt reads the drop as the attachment going (`interrupt_names`).
///
/// The slot is `Invalid` before the walk begins and the list head is cleared,
/// both for the walk's own cascade. A release can deliver, and with every
/// blocked list of `p`'s Waiters empty the delivery finds nobody. And a release
/// can free this very Waiter, when a message the cascade drops held its last
/// handle: its free then walks an empty list and credits nothing, and this
/// function writes nothing to the slot afterwards.
///
/// The slot keeps its count and its owner, both lists empty, until the
/// teardown's release frees it or its disown leaves it owned by nobody. Every
/// later op through a handle onto it answers `Revoked`, and its last handle
/// frees it.
func invalidate_waiter(w: Int, p: Int, is_caller: Bool,
                       counts: &var TeardownCounts) unsafe {
    quota_credit(p, QuotaKind.Waiter)
    WAITERS[w].state = WaiterState.Invalid
    var cur = WAITERS[w].attached
    WAITERS[w].attached = 0
    while cur != 0 {
        let a = cur - 1
        let next = ATTACHMENTS[a].link
        let watched = ATTACHMENTS[a].kind
        let watched_slot = ATTACHMENTS[a].target
        ATTACHMENTS[a] = Attachment(state: SlotState.Free,
                                    kind: WaitableKind.Event, target: 0,
                                    waiter: 0, key: 0, oneshot: false,
                                    owns: false, link: 0)
        set_waitable_attachment(watched, watched_slot, 0)
        release_held(waitable_obj_type(watched), watched_slot, p, is_caller,
                     &var counts)
        cur = next
    }
}

/// Invalidate Timer `t` of dying process `p` (spec §2.10): it never fires
/// again, and an attachment on it fires now.
///
/// The disarm clears the schedule and the fire count; the caller reprograms the
/// comparator once its pass is done. The charge comes back while `p`'s ledger
/// is live. Then the attachment, if any, is notified: the Timer is now ready
/// for good (`waitable_ready`), and the record is its ordinary one with a count
/// of zero. The attachment is on another process's Waiter, because `p`'s own
/// were taken apart by their invalidation just before, so the wake reaches
/// another process's thread. A one-shot attachment detaches at that delivery
/// and may drop the Timer's last reference, freeing it here; the free credits
/// nothing, the Timer being invalid.
///
/// The Timer keeps its owner until the teardown's disown, as an invalidated
/// thread does, and for the same reason.
func invalidate_timer(t: Int, p: Int) unsafe {
    TIMERS[t].disarm()
    quota_credit(p, QuotaKind.Timer)
    TIMERS[t].state = TimerState.Invalid
    notify_ready(WaitableKind.Timer, t)
}

/// What a teardown counted, for the report line.
struct TeardownCounts {
    closed: UInt,
    threads: UInt,
    events: UInt,
    waiters: UInt,
    interrupts: UInt,
    timers: UInt,
}

extension TeardownCounts {
    /// Count one freed object of `kind` that was the dying process's own. The
    /// line has a field for four kinds; a free of any other is not counted.
    func count_freed(&var self, kind: ObjType) {
        match kind {
            case Thread -> { self.threads = self.threads + 1 },
            case Event -> { self.events = self.events + 1 },
            case Waiter -> { self.waiters = self.waiters + 1 },
            case Timer -> { self.timers = self.timers + 1 },
            case _ -> {},
        }
    }
}

/// The process object `slot` of `kind` names as its owner, for the four kinds
/// the teardown line counts, and `NO_PROCESS` for any other kind.
func counted_owner(kind: ObjType, slot: Int) unsafe -> Int {
    match kind {
        case Thread -> THREADS[slot].process,
        case Event -> EVENTS[slot].process,
        case Waiter -> WAITERS[slot].process,
        case Timer -> TIMERS[slot].process,
        case _ -> NO_PROCESS,
    }
}

/// Release one reference dying process `p` held on object `slot` of `kind`: a
/// handle entry in its table, or an attachment row on one of its Waiters.
///
/// The release is an ordinary one: a count reaching zero frees, with the
/// kind's last rites, and anything the free cascades into happens here too.
/// When the object freed was one of `p`'s own, it is counted for the teardown
/// line. Its owner is read before the drop, since the free clears the slot,
/// and an object `p` owned still names `p` here even when it is invalid,
/// because the disown comes after the release. Only this function's own free
/// is counted, never one inside the cascade: what that frees had its last
/// reference somewhere other than `p`'s table or `p`'s Waiters.
///
/// When `p` is not the caller, a thread slot the caller is still using is not
/// freed (`spared`), as everywhere in the teardown.
func release_held(kind: ObjType, slot: Int, p: Int, is_caller: Bool,
                  counts: &var TeardownCounts) unsafe {
    let owned = counted_owner(kind, slot) == p
    if not drop_reference(kind, slot) {
        return
    }
    match kind {
        case Thread -> {
            if spared(slot, is_caller) {
                return
            }
            // A thread that has not exited is not freed by losing its last
            // handle (`free_object`'s Thread arm), so there is nothing to
            // count.
            match THREADS[slot].state {
                case Exited -> {},
                case Invalid -> {},
                case _ -> { return },
            }
        },
        case _ -> {},
    }
    free_object(kind, slot)
    if owned {
        counts.count_freed(kind)
    }
}

/// Disown every bound object of dying process `p` that survived its release
/// (spec §2.10), so that no later occupant of `p`'s record can match it in an
/// owner sweep or be credited by its free.
///
///   - A thread of `p`, `Exited` or invalid, still named elsewhere. An
///     `Exited` one's free credits nobody from here on.
///   - An invalid Waiter or Timer of `p` still named elsewhere.
///   - A Mapping whose target is `p`, invalidated earlier in the teardown: its
///     row went with the domain's death, and its target is now nobody, so the
///     husk names no record and no later process is reachable through it.
///
/// A Mapping `p` held cannot survive: `mapping_rights()` withholds `Transfer`,
/// so every handle onto one is in `p`'s own table, and the release has freed
/// them all. One still naming `p` as its holder is a kernel bug, and it stops
/// the machine.
func disown_bound(p: Int) unsafe {
    var t: Int = 0
    while t < THREADS.capacity() {
        match THREADS[t].state {
            case Exited -> {
                if THREADS[t].process == p {
                    THREADS[t].process = NO_PROCESS
                }
            },
            case Invalid -> {
                if THREADS[t].process == p {
                    THREADS[t].process = NO_PROCESS
                }
            },
            case _ -> {},
        }
        t = t + 1
    }
    var w: Int = 0
    while w < WAITERS.capacity() {
        match WAITERS[w].state {
            case Invalid -> {
                if WAITERS[w].process == p {
                    WAITERS[w].process = NO_PROCESS
                }
            },
            case _ -> {},
        }
        w = w + 1
    }
    var tm: Int = 0
    while tm < TIMERS.capacity() {
        match TIMERS[tm].state {
            case Invalid -> {
                if TIMERS[tm].process == p {
                    TIMERS[tm].process = NO_PROCESS
                }
            },
            case _ -> {},
        }
        tm = tm + 1
    }
    var mp: Int = 0
    while mp < MAPPINGS.capacity() {
        match MAPPINGS[mp].state {
            case Free -> {},
            case Live -> {
                if MAPPINGS[mp].process == p {
                    fatal_kernel("a mapping outlived its holder's close-all",
                                 mp as UInt)
                }
                if MAPPINGS[mp].target == p {
                    MAPPINGS[mp].target = NO_PROCESS
                }
            },
        }
        mp = mp + 1
    }
}

/// Tear down process `p`: the whole of ending it except what follows the
/// teardown (the report, and the reschedule or the machine stop).
///
/// Teardown is unconditional, and runs spec §2.10's four steps in order:
///
///   1. Invalidate every bound object `p` owns. A thread that has not exited
///      is invalidated and one that has keeps its exit code; a Waiter is
///      invalidated with its attachments released, and a Timer with its
///      deadline cancelled; a Mapping whose row is in `p`'s domain becomes an
///      invalid husk. Each charge comes back here. A thread nothing names is
///      freed at once.
///   2. Release the handle table (the close-all): each entry is unbound and
///      its reference dropped by an ordinary release, so whatever `p` was the
///      last to name is freed here. An Interrupt it held is destroyed (its line
///      is masked and bindable again), and a Mapping it held is freed.
///   3. Disown what survives and still names `p`: its bound objects still
///      named elsewhere (`disown_bound`) and the shared objects it was charged
///      for (`disown_shared`).
///   4. Copy its trap counters into its record, clear its domain, drop its
///      boot set, clear its ledger and free its body (the handle table, the
///      boot set and the grant record) for the next create.
///
/// The record stays, `Gone`, for as long as a reference names it.
///
/// `is_caller` says whether `p` owns the running thread or no thread is
/// running (a fault or an exit is on the caller, spec §2.7, and the deadlock
/// that ends root is reached with nothing current). Then the running thread is
/// one of the slots step 1 touches, so nothing is current any more and
/// `CURRENT_THREAD` and `PENDING_FREE` are cleared. Otherwise `p` is a
/// `Created` process that nothing names (`end_unstarted`): it has no thread
/// that ever ran, the caller's thread stays current and `Running`, and the
/// teardown leaves the caller's slots alone (`spared`). Clearing
/// `CURRENT_THREAD` for it would leave the caller's thread on no list and
/// never scheduled.
///
/// A record is never reclaimed before its own teardown has ended, because the
/// teardown writes it after the point where its last reference can go: the
/// notify can deliver a one-shot attachment holding that reference, and the
/// counters, the body link and the ledger are written further down. So the
/// teardown holds a reference of its own on the record, taken as the record
/// turns `Gone` and dropped by an ordinary `unref_object` at the end, which is
/// where a record nothing else names is reclaimed. Every other reclaim path
/// (a release, a detach, a delivery) then needs no special case: each sees a
/// count that cannot reach zero until that drop.
///
/// The body's steps run only for a process that still has its body
/// (`has_body`); a `Gone` record has none, and a teardown that met one would
/// skip them.
///
/// `code` is what a supervisor reads out of the spec §8 status word.
///
/// There is no preemption point anywhere in the teardown. For a caller the
/// scheduler is dismantled across it (`CURRENT_THREAD` and the dying process's
/// queue entries are cleared before the scans), so IRQ-shared state is in
/// flight for the whole walk. It is bounded.
///
/// It never runs another teardown: a reference it drops from a `Created`
/// process's count to zero only raises `UNSTARTED_PENDING`
/// (`reclaim_process_record`), and `drain_unstarted` runs those teardowns one
/// after another, never inside one.
func teardown_process(p: Int, kind: ProcessStatusKind, code: UInt,
                      is_caller: Bool) unsafe -> TeardownCounts {
    PROCESS_RECORDS[p].state = ProcessState.Gone
    PROCESS_RECORDS[p].exit_kind = kind
    PROCESS_RECORDS[p].exit_code = code
    // The teardown's own reference, dropped at the end (see above). It is taken
    // before the notify, which is the first thing that can drop another.
    ref_object(ObjType.Process, p)
    let body = if has_body(p) { body_of(p) } else { NO_BODY }
    var counts = TeardownCounts(closed: 0, threads: 0, events: 0, waiters: 0,
                                interrupts: 0, timers: 0)

    // A parked supervisor is told here, the earliest point at which the wait
    // record (the three fields above) is honest. The wake only queues:
    // `notify_ready` reaches `wake_one_waiter`, which writes the record into
    // the supervisor's memory and pushes its thread onto the ready queue
    // without switching. The whole teardown below runs to completion first and
    // the woken thread is picked up by `resume_after_death`, so no observer
    // sees a half-dead process. The call is unconditional, root included:
    // root's record can only be attached by root, and root's death stops the
    // machine.
    notify_ready(WaitableKind.Process, p)

    // A child's clean exit is reported on its own line. A child that was
    // donated its own Process handle exits with a code, and that code is the
    // only thing it can say: nobody holds a status word to read and it has no
    // console handle. This stays a separate line, not a field on the teardown
    // line below, so the teardown line is identical for every process. The
    // fault half is reported by `fault_process`. A process that never ran did
    // not exit, so it reports no code.
    if is_caller && p != ROOT_PROCESS {
        match kind {
            case Exited -> {
                let out = console()
                out.write_str("SOS: process exit: code=")
                out.write_hex(code)
                out.write_str(" process=")
                out.write_hex(p as UInt)
                out.write_str("\n")
            },
            case _ -> {},
        }
    }

    // ---- Step 1: invalidate every bound object `p` owns. ----
    //
    // Its threads stop first, in three moves, before anything drops a
    // reference: every later move (a Waiter's detach, a Timer's notify, the
    // close-all) can deliver, and a notification must never find a thread of
    // the process being torn down. A delivery to one would mint into a table
    // the close-all is about to pass, and the body would go back with that
    // entry bound.
    //
    // Orphaned claims go first. A thread parked in a fused `PipeInletOp.Call`
    // holds its exchange's claim column open without a handle entry, so the
    // close-all cannot reach it, and the thread's invalidation below would
    // leave `Exchange.caller` naming it. Dropping the claim abandons the call:
    // the column falls to zero, and the server's later `reply` reads that as
    // abandoned-by-client and answers `Err(PeerClosed)`.
    // `release_pending_calls` carries the two-pass argument for why its own
    // unrefs cannot find a thread of this process either.
    release_pending_calls(p)

    // Then the dying process's threads come off every list a thread parks on,
    // so no wake can find one of them:
    //
    //   - The ready queue is edited, not emptied: other processes' runnable
    //     threads stay.
    //   - Every joiner list, so that an invalidation's wake reaches only other
    //     processes' joiners and no surviving thread names one of these.
    //   - Every Waiter's blocked list, whoever owns the Waiter: a Waiter can be
    //     given, so these threads may be parked on another process's Waiter.
    ready_remove_process(p)
    unjoin_process(p)
    unblock_process(p)

    // Then the other processes' threads parked on this process's Waiters are
    // answered, with `Revoked`, for every one of these Waiters before any of
    // them is taken apart: each is invalidated below. A Waiter's detach and the
    // close-all both drop references, a dropped reference can raise the level
    // of a waitable another row of the same Waiter watches, and the
    // notification reaches `wake_one_waiter` for it. With a thread still
    // parked, that delivery would run while the invalidation is taking the
    // list apart: a one-shot row's `detach_attachment` would walk from a head
    // the invalidation has cleared, miss its row and drop its reference, and
    // the walk would drop it again. With every list empty, such a wake finds
    // nobody and delivers nothing.
    var wr: Int = 0
    while wr < WAITERS.capacity() {
        match WAITERS[wr].state {
            case Live -> {
                if WAITERS[wr].process == p {
                    revoke_blocked(wr)
                }
            },
            case Invalid -> {},
            case Free -> {},
        }
        wr = wr + 1
    }

    // The threads. The close-all has not run, so a count here is every name
    // the thread still has.
    //
    //   - A thread of this process that has not exited is invalidated
    //     (`invalidate_thread`), the running one included unless its own exit
    //     is what ended the process.
    //   - One that exited keeps its exit code for a late join: `Exited` wins.
    //   - Either is freed now if nothing names it, and counted for the
    //     teardown line. That includes the running thread whose own exit ended
    //     the process, since `exit_thread` released its handle before ending
    //     it. One still named waits for the close-all, or survives it.
    //   - The frees go through `free_object`, which gives an `Exited` thread's
    //     charge back. When `p` is not the caller, the running thread's slot
    //     and the one waiting in `PENDING_FREE` are left to `pick_next`
    //     (`spared`): the caller is still using the first and has promised the
    //     second to the switch.
    var t: Int = 0
    while t < THREADS.capacity() {
        if THREADS[t].process == p {
            match THREADS[t].state {
                case Free -> {},
                case Invalid -> {},
                case Exited -> {
                    if THREADS[t].refs == 0 && not spared(t, is_caller) {
                        free_object(ObjType.Thread, t)
                        counts.count_freed(ObjType.Thread)
                    }
                },
                case _ -> {
                    invalidate_thread(t, p)
                    if THREADS[t].refs == 0 {
                        free_object(ObjType.Thread, t)
                        counts.count_freed(ObjType.Thread)
                    }
                },
            }
        }
        t = t + 1
    }
    // For the caller's own process the running thread was one of the slots
    // just invalidated or freed (`Exited` when its own exit ended the process)
    // and nothing is current any more. For any other process the caller's
    // thread is not one of them and stays current: clearing it here would
    // leave it `Running`, on no list, and never scheduled.
    if is_caller {
        CURRENT_THREAD = NO_THREAD
        PENDING_FREE = NO_THREAD
    }

    // The Waiters: each is invalidated, its charge refunded and its attachment
    // list taken apart, with every reference a row held released
    // (`invalidate_waiter`). The Waiter itself is freed when its last handle
    // goes, in the close-all below if this process held it.
    var w: Int = 0
    while w < WAITERS.capacity() {
        match WAITERS[w].state {
            case Live -> {
                if WAITERS[w].process == p {
                    invalidate_waiter(w, p, is_caller, &var counts)
                }
            },
            case Invalid -> {},
            case Free -> {},
        }
        w = w + 1
    }

    // The Timers, after the Waiters, so that an invalidated Timer's
    // notification reaches only another process's Waiter. This process's
    // deadlines stop: a dead process's armed deadline is one the kernel would
    // otherwise keep waking itself for, with nobody left to tell, and the
    // reprogram after the pass takes the comparator back.
    var tm: Int = 0
    while tm < TIMERS.capacity() {
        match TIMERS[tm].state {
            case Live -> {
                if TIMERS[tm].process == p {
                    invalidate_timer(tm, p)
                }
            },
            case Invalid -> {},
            case Free -> {},
        }
        tm = tm + 1
    }
    reprogram_timer()

    // The Mappings whose row is in this process's domain: the domain goes with
    // the body below (`clear_domain` drops the whole grant record), so each is
    // invalid from here, a husk with nothing installed (`unmap` and `base`
    // answer `Revoked`, spec §2.10). The slot is not freed: its holder's word
    // still names it, and a reused slot would be reachable through it. Its
    // target is disowned with the rest in step 3.
    //
    // A Mapping names its target only while it has a row there: `Unmap` clears
    // both together, and a teardown clears the row here and the target once
    // its release is done. So one naming the dying record with no row
    // (`NO_ROW` or `ROW_TARGET_DIED`) is a husk an earlier life of this record
    // left undisowned, which is a kernel bug, and it stops the machine.
    var mp: Int = 0
    while mp < MAPPINGS.capacity() {
        match MAPPINGS[mp].state {
            case Free -> {},
            case Live -> {
                if MAPPINGS[mp].target == p {
                    let row = MAPPINGS[mp].row
                    if row == NO_ROW || row == ROW_TARGET_DIED {
                        fatal_kernel("a husk still named a reused process record",
                                     mp as UInt)
                    }
                    MAPPINGS[mp].row = ROW_TARGET_DIED
                }
            },
        }
        mp = mp + 1
    }

    // No Clock is touched anywhere here. A Clock is kernel-eternal and owned
    // by nobody; the process's clock handle is unbound by the close-all below,
    // and a release of a Clock drops nothing.

    // ---- Step 2: release the handle table (the close-all). ----
    //
    // Each entry goes through `unbind_handle`, so teardown and release do the
    // same thing to a slot: zero the binding and bump the generation. The bump
    // matters because the body is freed below, so these entries can be minted
    // into again, and a word from the dead process's life must not resolve in
    // the next one's. The entry is unbound before its reference is dropped, as
    // a release does, so nothing in the cascade can find it.
    //
    // Each entry is also one reference fewer, released as any release is
    // (`release_held`): an object whose last name this was is freed now, with
    // its last rites, and a free of one of this process's own Threads, Events,
    // Waiters or Timers is counted for the teardown line. Objects another
    // process owns see the reference go (a region a launcher gave a child, for
    // example), and a `Gone` record whose last reference this was is
    // reclaimed.
    //
    // An Interrupt is destroyed by this drop (`drop_reference`): its one name
    // is the handle in this table, so the line is masked and bindable again
    // here, and an attachment on another process's Waiter fires. The count of
    // those is the teardown line's `interrupts=`.
    var h: Int = 0
    while body != NO_BODY && h < MAX_HANDLES {
        let entry = PROCESSES[body].handles[h]
        match entry.obj_type {
            case Unbound -> {},
            case _ -> {
                unbind_handle(p, h)
                counts.closed = counts.closed + 1
                match entry.obj_type {
                    case Interrupt -> {
                        counts.interrupts = counts.interrupts + 1
                    },
                    case _ -> {},
                }
                release_held(entry.obj_type, entry.target, p, is_caller,
                             &var counts)
            },
        }
        h = h + 1
    }

    // ---- Step 3: disown what survives (spec §2.10). ----
    //
    // Nothing is freed by force: a counted kind other processes may still
    // reference outlives its creator for as long as anybody holds a reference,
    // and a forced free would pull a connection out from under a peer that
    // still holds an end, staged messages and all. What survives and still
    // names this record is disowned instead: its bound objects named elsewhere
    // (`disown_bound`) and the shared objects charged to it (`disown_shared`).
    // An object freed above credited this ledger as any free does; one freed
    // from here on credits nobody, and the ledger is cleared below either way.
    // The disown comes before the domain clear, which drops the grant rows'
    // references and can free a region, so that free finds the region already
    // disowned.
    disown_bound(p)
    disown_shared(p)

    // ---- Step 4: the body's own parts, and the ledger. ----
    //
    // These go last, in spec §2.10's order, once every step that can drop a
    // reference or credit the ledger is behind them. A body that is already
    // gone was handled by this process's first teardown.
    if body != NO_BODY {
        // The counters first: nothing is charged to a process once its
        // teardown has begun (`ktrap` attributes to the current thread, and
        // this process has none left), so the copy is final. The row itself
        // stays as it is until a create reuses the body and clears it.
        PROCESS_RECORDS[p].final_stats = stats_read(body)

        // The protection rows go with the body, and `LAST_PROT_PROCESS` is
        // invalidated with them, so a later process landing in this record or
        // this body cannot compare equal to a domain that is no longer
        // installed.
        clear_domain(p)

        // The boot set, undrained records included. Every record names a
        // handle in the table the close-all already emptied, so what remains is
        // a count and a cursor. It must be reset because the body is reused,
        // and the next process in it would otherwise drain handles that are
        // not its own.
        clear_boot_handles(p)
    }

    // The quota ledger dies with the process. The charge of an object a peer
    // still references, which the disown above left owned by nobody, is
    // written off here with the rest. The books balance because quota <= wall
    // (the slab refuses the next allocation). No credit is owed to this row
    // once it is cleared, so `quota_credit`'s zero test is only a defence
    // against an underflow. The limits are cleared with the used counts so the
    // next occupant of the record does not inherit an allowance. A mapping row
    // in another process's domain is credited to that target when its row goes
    // (its own `Unmap` or teardown).
    quota_clear(p)

    // The body goes back for the next create, and the record stops naming it
    // (spec §2.10's disown of the record's own link). A create takes a reused
    // body's table as empty, so an entry still bound here would hand the next
    // process a capability it was never given. Nothing mints into a dying
    // table after the close-all, because no thread of this process is left on
    // a list a delivery reads; this checks that rather than trusting it.
    if body != NO_BODY {
        var e: Int = 0
        while e < MAX_HANDLES {
            match PROCESSES[body].handles[e].obj_type {
                case Unbound -> {},
                case _ -> {
                    fatal_kernel("a body went back with a bound handle entry",
                                 e as UInt)
                },
            }
            e = e + 1
        }
        PROCESSES[body].live = false
        unlink_body(p)
    }

    // The teardown's own reference goes, which reclaims the record if nothing
    // else names it: a process that held the last handle onto its own record
    // frees it here rather than leaving a `Gone` record nothing can reach. The
    // usual case is the opposite: a creator's handle onto its dead child
    // survives (keeping the spec §8 status word readable), and the creator's
    // release frees the record later. A process that never ran is torn down at
    // a count of zero, so its record is reclaimed here every time.
    unref_object(ObjType.Process, p)

    counts
}

/// Whether thread slot `t` is the caller's, and so must not be freed by the
/// teardown of some other process (`teardown_process`'s `is_caller`).
func spared(t: Int, is_caller: Bool) unsafe -> Bool {
    not is_caller && (t == CURRENT_THREAD || t == PENDING_FREE)
}

/// Print the teardown line for process `p`.
func report_teardown(counts: TeardownCounts, p: Int) unsafe {
    let uart = console()
    uart.write_str("SOS: process teardown handles=")
    uart.write_hex(counts.closed)
    uart.write_str(" threads=")
    uart.write_hex(counts.threads)
    uart.write_str(" events=")
    uart.write_hex(counts.events)
    uart.write_str(" waiters=")
    uart.write_hex(counts.waiters)
    uart.write_str(" interrupts=")
    uart.write_hex(counts.interrupts)
    // No `clocks=` field: this line counts what the process owned or held, and
    // a Clock is owned by nobody and not counted.
    uart.write_str(" timers=")
    uart.write_hex(counts.timers)
    // The process number (the record's index) comes last, so the fields before
    // it keep their positions.
    uart.write_str(" process=")
    uart.write_hex(p as UInt)
    uart.write_str("\n")
}

/// End process `p`, which owns the running thread or has none running (a fault
/// or an exit is on the caller). Never returns.
///
/// `teardown_process` does the work; then:
///
///   - Process 0 (root, init) stops the machine. Its children die with it,
///     uncounted, and a `Created` process nothing names any more is not torn
///     down first.
///   - A child reschedules. Its threads leave the ready queue by removal, its
///     body goes back, and the path ends in `resume_after_death`, so root is
///     simply the next thing picked. A supervisor parked on the child's Process
///     handle is woken by the `notify_ready` at the top of the teardown. The
///     `Created` processes whose last name the teardown dropped are torn down
///     before the reschedule (`drain_unstarted`), after this process's own
///     report.
///
/// `code` is what a supervisor reads out of the spec §8 status word.
/// `machine_status` is what the emulator exits with, which for a fault is the
/// kernel's own vocabulary rather than anything the process chose. It is read
/// only on the process-0 arm.
public(package) func end_process(p: Int, kind: ProcessStatusKind, code: UInt,
                 machine_status: UInt) unsafe -> Never {
    let counts = teardown_process(p, kind, code, true)
    report_teardown(counts, p)

    if p != ROOT_PROCESS {
        // A child's death is a scheduling event: the machine has work left, so
        // this path never touches `machine_status` and never stops.
        drain_unstarted()
        resume_after_death()
    }

    if machine_status == 0 {
        hal.exit_pass()
    } else {
        hal.exit_fail(machine_status)
    }
    while { }
}

/// Tear down `Created` process `p`, whose last reference is gone, as if it had
/// exited. `p` is not the caller.
///
/// The process never ran, so there is nothing to reschedule: its inert threads
/// (made through its handle) are invalidated, everything it holds is released
/// by the close-all (its boot set included), its body goes back and its record
/// is reclaimed, all in `teardown_process`. The caller's
/// thread keeps running and `CURRENT_THREAD` is not touched.
///
/// The status word is `Exited` with code zero, written because the teardown
/// writes one. No reader can exist: the count is zero, so there is no handle or
/// attachment to read it through, and the record is `Free` again when this
/// returns.
func end_unstarted(p: Int) unsafe {
    let counts = teardown_process(p, ProcessStatusKind.Exited, 0, false)
    report_teardown(counts, p)
}

/// Tear down every `Created` process whose count has reached zero, until none
/// is left. Called from `pick_next`, which every syscall and interrupt return
/// passes through, and from `end_process` before it reschedules.
///
/// `reclaim_process_record` raises `UNSTARTED_PENDING` on each such zero,
/// wherever the last reference went (a release, a detach, a delivery, or a
/// teardown's Waiter invalidation or close-all), because `refs` cannot call
/// up into this module. The flag is cleared before each pass: a teardown here
/// can drop the last reference to another `Created` process (a launcher whose
/// child held the only handle to its own never-started child), which raises it
/// again and is handled by the next pass, not by recursion. So a teardown is
/// never nested in another, and every one runs with the caller's state whole.
public(package) func drain_unstarted() unsafe {
    while UNSTARTED_PENDING {
        UNSTARTED_PENDING = false
        var r: Int = 0
        while r < PROCESS_RECORDS.capacity() {
            match PROCESS_RECORDS[r].state {
                case Created -> {
                    if PROCESS_RECORDS[r].refs == 0 {
                        end_unstarted(r)
                    }
                },
                case _ -> {},
            }
            r = r + 1
        }
    }
}

/// Terminate a process for a caller error it could have checked: an invalid
/// handle, an unknown op, a missing right, or an op aimed at the wrong thread.
///
/// This is not a status the process receives: the process is the thing that was
/// wrong, so it ends, and the kernel stays up to say so. Never returns: into a
/// stopped machine when root is the one that was wrong, and into whatever runs
/// next when it was a child.
public(package) func fault_process(p: Int, reason: FaultReason) unsafe -> Never {
    let uart = console()
    uart.write_str("SOS: process fault: ")
    uart.write_str(reason.describe())
    // The process number is appended so the reason reads first.
    uart.write_str(" process=")
    uart.write_hex(p as UInt)
    uart.write_str("\n")
    end_process(p, ProcessStatusKind.Faulted, (reason as UInt8) as UInt,
                ExitCode.ProcessFault as UInt)
}

/// The same termination, reached from a hardware fault rather than a syscall
/// (spec §8: a thread fault kills its process). The harness reads the report's
/// wording and shape, so keep them; which process it was is in the teardown
/// line that follows.
public(package) func fault_trap(tag: String, cause: UInt, epc: UInt, tval: UInt) unsafe -> Never {
    let uart = console()
    uart.write_str("SOS: fault ")
    uart.write_str(tag)
    uart.write_str(" cause=")
    uart.write_hex(cause)
    uart.write_str(" epc=")
    uart.write_hex(epc)
    uart.write_str(" tval=")
    uart.write_hex(tval)
    uart.write_str("\n")
    if CURRENT_THREAD != NO_THREAD {
        end_process(THREADS[CURRENT_THREAD].process, ProcessStatusKind.Faulted, 0,
                    ExitCode.UmodeFault as UInt)
    }
    // No process object yet: the harness kernels that enter user mode directly.
    hal.exit_fail(ExitCode.UmodeFault as UInt)
    while { }
}
