//! Clocks, timers, and the one hardware comparator (spec §2.6): the slabs, a
//! Timer's own verbs, and the funnel that programs the machine.
//!
//! What comes due is not here. Expiring a deadline wakes a waiter, so it sits
//! above the wait machinery in `irq`. What is left here is everything that can
//! be said about a schedule without delivering anything, which is also why the
//! teardown in `sched` can reprogram the comparator without importing the
//! interrupt path.

import hal
import sosabi.{ClockType}
import kcore.limits.{CLOCK_KINDS, MAX_SLAB_EXTENTS, MAX_TIMERS, NO_TIMER}
import kcore.slab.{Slab}

/// One Clock (spec §2.6): a granted time source, and a kernel-eternal one.
///
/// It holds no time and no owner. The machine's counter is the clock
/// (`hal.timer_now_ns`) and this slot records only which domain it names, so
/// two processes' Clocks cannot drift apart. The object outlives every process:
/// a slot with no per-process state has nothing a teardown could reclaim, and
/// one object per domain stops two objects existing for one counter.
///
/// Several handles onto it are fine: `ClockGet` mints on every ask. §3's
/// no-duplicate rule is about amplification, not about how many names an object
/// has; what this slot guarantees is that the object is single.
///
/// The object is still the capability: a process never granted a handle cannot
/// read the counter at all, so handing a child a virtual clock is a
/// substitution rather than a redesign. A virtual clock would be created,
/// stateful and owned, and would get its own slab.
///
/// `kind` is also the slot's index, and is stored anyway because `clock_now`
/// dispatches on it: the domain decides what reading the object answers with,
/// and a second domain should fail to compile until somebody says what its
/// reading is.
public(package) struct ClockSlot {
    /// The domain this clock answers in, for the life of the machine.
    /// `public(package)` because `Clock.Now` dispatches on it from another
    /// module.
    public(package) kind: ClockType,
}

/// Where a Timer is in its life (spec §2.10).
///
/// A Timer is bound to the process that created it. `Invalid` is a Timer whose
/// owner died while a handle or an attachment elsewhere still named it: it is
/// disarmed and never fires again, an attachment on it reports a terminal
/// level, every `Arm` or `Disarm` answers `Revoked`, and the slot is held only
/// for its remaining references. Its own enum for the reason `WaiterState`
/// gives.
public(package) enum TimerState: UInt8 {
    case Free = 0,
    case Live = 1,
    case Invalid = 2,
}

/// One Timer (spec §2.6): a deadline on a Clock.
///
/// `fires` is the object, as an Event's word and an Interrupt's `pending` are:
/// for a live Timer, non-zero means ready, and that is the whole of what a
/// Waiter looks at. An invalid Timer is ready whatever its count, which its
/// invalidation zeroed (`waitable_ready`). Readiness is level-triggered:
/// nothing records that a waiter has been told, so the count is there until a
/// wait consumes it.
///
/// `deadline_ns` is the next fire, not the last one, which makes the re-arm
/// drift-free: `fire_timer` advances it by whole intervals from itself rather
/// than from the clock, so a fire the kernel was late for shortens the next gap
/// instead of pushing every later one out (the timerfd model).
///
/// `clock` binds the Timer to the Clock that made it, for the object's whole
/// life. It exists because a second domain or a virtual clock would make
/// "which time is this deadline measured in" a real question, and a
/// re-pointable Timer would answer it differently over its life.
///
/// What you can do to a Timer lives in this type's extension, beside the ops
/// that call it: `arm`, `disarm`, `is_due`, `sooner_of`, `fire`. Those are safe
/// functions; the `unsafe` on the ops around them is the slab's, not the
/// timer's.
public(package) struct TimerSlot {
    public(package) state: TimerState,
    /// The process that created this Timer and is charged for it, or
    /// `NO_PROCESS` once it is invalid. Test for that before using it as an
    /// index.
    public(package) process: Int,
    /// The Clock slot this timer measures against, for its life.
    public(package) clock: Int,
    /// Whether a deadline is scheduled. A one-shot clears this when it fires.
    public(package) armed: Bool,
    /// The absolute deadline of the next fire, in the clock's nanoseconds.
    public(package) deadline_ns: UInt64,
    /// The re-arm period; 0 is a one-shot.
    public(package) interval_ns: UInt64,
    /// Fires not yet delivered to a waiter. Non-zero = ready. Saturates.
    ///
    /// `public(package)` because readiness is asked from the wait side: the
    /// per-kind matrix in `waitables` reads this to answer "is this waitable
    /// ready" and "what does its record say".
    public(package) fires: UInt,
    /// The attachment naming this timer (slot + 1); 0 = unattached.
    ///
    /// `public(package)` to the same reader: who is watching is one of the
    /// matrix's questions, and it both reads and clears this.
    public(package) attachment: Int,
    /// Handle entries naming this timer, plus its attachment, plus the staged
    /// messages that carry it. Reaching zero returns the slot and reprograms
    /// the comparator (the kernel takes the deadline back, as the teardown
    /// does), so a dropped timer stops waking the machine when it is dropped
    /// rather than at its owner's death.
    public(package) refs: UInt16,
}

/// The machine's clocks, one per domain, live from boot. There is no `Free`
/// state and no allocation step: the table is the domain list, and `clock_slot`
/// is the only thing that indexes it.
public(package) unsafe static var CLOCKS: [ClockSlot; CLOCK_KINDS] = [
    ClockSlot(kind: ClockType.Monotonic); CLOCK_KINDS]

/// The slot naming `kind`'s clock. The slot is the ordinal: `ClockType`'s raw
/// values start at zero and are dense, so the domain and its row are one fact
/// rather than two kept in step.
public(package) func clock_slot(kind: ClockType) -> Int {
    (kind as UInt) as Int
}

// An extent chain: `MAX_TIMERS` is extent 0's length and the compiled floor;
// `capacity()` is what every scan reads. `CLOCKS` above is deliberately not
// one: it is a census of domains rather than a slab (nothing is allocated in it
// and the slot is the ordinal), so there is no shortage for a donation to
// relieve.
public(package) unsafe static var TIMERS: Slab<TimerSlot, MAX_TIMERS> = Slab<TimerSlot, MAX_TIMERS>(
    inline: [TimerSlot(state: TimerState.Free, process: 0, clock: 0, armed: false,
                       deadline_ns: 0, interval_ns: 0, fires: 0,
                       attachment: 0, refs: 0); MAX_TIMERS],
    ext_base: [0; MAX_SLAB_EXTENTS],
    ext_slots: [0; MAX_SLAB_EXTENTS],
    ext_side: [0; MAX_SLAB_EXTENTS],
    ext_count: 0,
    total: MAX_TIMERS)

// No function allocates a Clock. A Clock is kernel-eternal and its slot is its
// domain's ordinal (`clock_slot`), so there is nothing to take and nothing to
// run out of; `System.ClockGet` mints a handle and never an object.

/// Take a free timer slot, or `NO_TIMER` when the slab is empty.
public(package) func alloc_timer() unsafe -> Int {
    var i: Int = 0
    while i < TIMERS.capacity() {
        match TIMERS[i].state {
            case Free -> { return i },
            case Live -> {},
            case Invalid -> {},
        }
        i = i + 1
    }
    NO_TIMER
}

/// Add without ever rolling through zero (§2.4's counting rule); the Timer's
/// fire count uses the same one.
///
/// Shared because the reason is the same in both places: zero means "not ready"
/// to a Waiter, so a count that wrapped would make a saturated Event or a busy
/// Timer go quiet, the one failure a level-triggered notification must not
/// have. `&+` is the wrapping add (overflow checks are always on, so a plain
/// `+` would panic in the kernel), and the comparison after it is the carry.
public(package) func saturating_add(a: UInt, b: UInt) -> UInt {
    let sum = a &+ b
    if sum < a { UInt.max } else { sum }
}

/// Narrow a 64-bit fire count to a machine word, saturating rather than
/// panicking.
///
/// A checked `as` would be a panic edge in the kernel on a number a process
/// chose: arm a one-nanosecond interval, wait long enough, and the coalesced
/// count exceeds a 32-bit word. Saturating is the answer the count already
/// gives at its own ceiling.
func fires_word(n: UInt64) -> UInt {
    if n > (UInt.max as UInt64) { UInt.max } else { n as UInt }
}

// -----------------------------------------------------------------------------
// A timer's own verbs
// -----------------------------------------------------------------------------
//
// Every multi-field operation on a timer is a method on the slot, and the ops
// below index the slab and call one (`TIMERS[slot].fire(now)`).
//
// The `unsafe` effect retreats to the call sites. `TIMERS` is an `unsafe static
// var`, so every function that names it is `unsafe`, but `TimerSlot` is an
// ordinary safe type, so a body working through `self` is a safe function. What
// is left inside an unsafe body is the indexing, which is where the compound
// global state is.
//
// A single field access is left alone (`TIMERS[t].armed` in the idle rule, the
// whole-slot writes in `timer_create` and teardown): wrapping one load in a
// method adds a name for nothing.

extension TimerSlot {
    /// Replace this timer's whole schedule: fire at `deadline`, then every
    /// `interval` nanoseconds (0 being a one-shot).
    ///
    /// Arming replaces, and is not an error. Arming an armed timer discards the
    /// old schedule wholesale (new deadline, new interval) and clears the fire
    /// count, because a count carried forward would be owed against a schedule
    /// the caller just threw away. Re-arming a running timer is the ordinary
    /// way to change a timeout, so refusing it would make the common idiom
    /// unwritable.
    public(package) func arm(&var self, deadline: UInt64, interval: UInt64) {
        self.armed = true
        self.deadline_ns = deadline
        self.interval_ns = interval
        self.fires = 0
    }

    /// This timer is off and owes nothing.
    ///
    /// It clears the fire count as well as the schedule, which makes it a clean
    /// cancel: a caller who wants the fires reads them with a wait first. Why
    /// disarming an unarmed timer is a no-op rather than a fault is
    /// `timer_disarm`'s business, since that is the question the op answers.
    public(package) func disarm(&var self) {
        // The `u64` suffixes work around a compiler gap: a bare literal does
        // not adopt the expected fixed-width type in plain assignment position
        // (it does in an annotation, a struct literal and a compound
        // assignment), and on a 32-bit target the mismatch is an internal
        // compiler error rather than a diagnostic. They can come off once the
        // compiler accepts the bare literal here.
        self.armed = false
        self.deadline_ns = 0u64
        self.interval_ns = 0u64
        self.fires = 0
    }

    /// Has this timer come due by `now`? An unarmed one never has.
    public(package) func is_due(&self, now: UInt64) -> Bool {
        self.armed && self.deadline_ns <= now
    }

    /// The sooner of `deadline` and this timer's own, the fold
    /// `earliest_timer_deadline` is written as. An unarmed timer answers
    /// `deadline` unchanged, because a schedule nobody wrote is not a deadline
    /// the hardware has to be programmed for.
    func sooner_of(&self, deadline: UInt64) -> UInt64 {
        if self.armed && self.deadline_ns < deadline { self.deadline_ns } else { deadline }
    }

    /// This timer came due: count the fire, and re-arm it if it is periodic.
    ///
    /// Drift-free: the next deadline is measured from this deadline, never from
    /// `now`, so a fire the kernel was late for shortens the next gap instead
    /// of pushing every later one out. That is the opposite of the scheduler
    /// tick's rule (`on_timer_interrupt` measures from now): a timeslice has no
    /// history to be faithful to, and an interval does.
    ///
    /// Missed fires coalesce, by division rather than by a loop. A consumer
    /// that was descheduled across several periods gets one wake carrying how
    /// many, rather than falling behind a queue of fires or losing them.
    /// Computing the count with a division keeps this bounded: an interval far
    /// shorter than the machine can serve costs one divide, not a spin, so
    /// there is no long loop here and no minimum interval to invent.
    public(package) func fire(&var self, now: UInt64) {
        let interval = self.interval_ns
        if interval == 0 {
            // A one-shot disarms itself. There is no schedule left, so the
            // object goes quiet after one fire and a later `disarm` finds
            // nothing to do (the race `timer_disarm` documents).
            self.armed = false
            self.fires = saturating_add(self.fires, 1)
        } else {
            let late = now - self.deadline_ns
            let missed = (late / interval) + 1
            // The product cannot overflow: when `interval` exceeds `late`,
            // `missed` is 1 and the product is the interval itself; otherwise
            // `missed` is bounded by `late / interval`, so the product is at
            // most `late + interval`, with both terms real times.
            let step = missed * interval
            // The sum can overflow, and a process chose the number that makes
            // it (an interval near the end of time). Overflow checks are always
            // on, so an unguarded `+` would panic the kernel on a value
            // userspace picked. Saturating is also the honest answer: a
            // deadline past the end of time is one nothing will see fire.
            let base = self.deadline_ns
            self.deadline_ns = if step > NEVER_NS - base { NEVER_NS } else { base + step }
            self.fires = saturating_add(self.fires, fires_word(missed))
        }
    }
}

/// The earliest deadline any armed Timer is waiting on, or `soonest` if none is
/// sooner. The Timer half of `reprogram_timer`'s question.
func earliest_timer_deadline(soonest: UInt64) unsafe -> UInt64 {
    var next = soonest
    var i: Int = 0
    while i < TIMERS.capacity() {
        match TIMERS[i].state {
            case Live -> { next = TIMERS[i].sooner_of(next) },
            // Disarmed by its invalidation, so it owes no deadline.
            case Invalid -> {},
            case Free -> {},
        }
        i = i + 1
    }
    next
}

// -----------------------------------------------------------------------------
// One hardware timer, two customers
// -----------------------------------------------------------------------------
//
// The machine has one comparator, and two things want it: the scheduler tick
// (spec §7's timeslice) and the Timer objects (spec §2.6) a process arms. The
// composition is arch-free:
//
//   the kernel keeps every deadline it owes in nanoseconds (the next tick in
//   `NEXT_TICK_NS`, each armed Timer's in its own slot) and programs the
//   hardware with the earliest of them. A fire means "something may be due":
//   the handler asks what actually is, services it, and programs the next
//   earliest. Nothing else touches the comparator.
//
// The tick is inviolate. A Timer deadline can only move the hardware earlier
// than the tick, never later, so the tick's cadence is unchanged by any number
// of Timers. A fire that turns out to be a Timer's still checks the tick, and a
// tick that comes due while a Timer is being serviced is taken in the same
// pass; both are read out of the same `now`, so there is no ordering to get
// wrong.
//
// The HAL seam is `timer_now_ns()` + `timer_set_deadline_ns(at)`, hardware and
// nothing else. The tick's period is scheduler policy and lives here.

/// Nanoseconds in a microsecond: the unit `start_tick` is written in and the
/// unit `Clock`/`Timer` speak.
static NS_PER_US: UInt64 = 1000

/// The deadline that means "nothing is due": far enough out that no machine
/// this kernel runs on reaches it. It is a value rather than an absence so that
/// `reprogram_timer` has one code path: an empty schedule programs `never`,
/// which stops a level-triggered comparator left in the past from re-firing
/// forever.
public(package) static NEVER_NS: UInt64 = UInt64.max

/// How far ahead of now the hardware is ever programmed.
///
/// This turns a too-fast schedule into coalescing instead of a livelock. A
/// process may arm a one-nanosecond interval; without a floor the comparator
/// would be due again before the trap returned, and the machine would live in
/// the trap handler making no user-mode progress. With one, the fire arrives at
/// most this often and the intervening expiries coalesce into the fire count,
/// so nothing is refused and no minimum interval is invented.
///
/// The logical schedule is untouched: a Timer's next deadline is still
/// `previous + interval`, so lateness never accumulates and a one-shot still
/// reports exactly one fire. The floor bounds only the resolution, and 50
/// microseconds is two orders of magnitude below the millisecond scheduler
/// tick, so §7's cadence never notices it.
static TIMER_MIN_LEAD_NS: UInt64 = 50_000

/// The scheduler tick's period in nanoseconds; 0 means no periodic tick.
///
/// Zero means no tick: the scheduler works without one, and a tick would
/// narrate over the process for its first few ticks (see `Console`'s handover
/// protocol). The composition has to carry it, because a kernel with no tick
/// and one armed Timer is the shape a sleeping process makes.
public(package) unsafe static var TICK_PERIOD_NS: UInt64 = 0

/// When the next scheduler tick is due, on the same clock every deadline uses.
public(package) unsafe static var NEXT_TICK_NS: UInt64 = 0

/// Start the periodic scheduler tick (spec §7's fixed timeslice).
///
/// The period is scheduler policy and belongs beside the scheduler; the
/// hardware (a counter and a comparator) is all the HAL owns. Harness kernels
/// that want a preemptive machine call this.
public func start_tick(period_us: UInt) unsafe {
    TICK_PERIOD_NS = (period_us as UInt64) * NS_PER_US
    NEXT_TICK_NS = hal.timer_now_ns() + TICK_PERIOD_NS
    reprogram_timer()
}

/// The one place the hardware comparator is programmed.
///
/// Its callers include:
///
///   - `start_tick`, when a kernel decides to be preemptive;
///   - `on_timer_interrupt`, after servicing whatever came due;
///   - `timer_arm` and `timer_disarm`, when a process changes what it owes;
///   - `free_object`'s Timer arm, when the last reference to a Timer goes;
///   - `end_process`, whose teardown frees or invalidates a dying process's
///     Timers.
///
/// A funnel rather than a rule repeated per caller, because the question it
/// answers (what is the earliest thing this kernel owes anybody) has to be
/// asked over the whole schedule every time, and a caller that programmed only
/// its own deadline would silently push somebody else's out.
public(package) func reprogram_timer() unsafe {
    var next = NEVER_NS
    if TICK_PERIOD_NS != 0 && NEXT_TICK_NS < next {
        next = NEXT_TICK_NS
    }
    next = earliest_timer_deadline(next)

    if next == NEVER_NS {
        hal.timer_set_deadline_ns(NEVER_NS)
        return
    }
    let floor = hal.timer_now_ns() + TIMER_MIN_LEAD_NS
    hal.timer_set_deadline_ns(if next < floor { floor } else { next })
}
