//! The product's process that only prints, written with `main`: it prints
//! its greeting (the input `greeting`). Its image names a console, the UART
//! driver's serve, so the line goes to that driver; `main` returning ends the
//! process with status 0 once the line is out.

import greeting.{text}
import sosmain

func main() {
    print("greeter: {}", text())
}
