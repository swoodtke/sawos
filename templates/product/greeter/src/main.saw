//! The product's process for a board with no UART driver, written with
//! `main`: it prints its greeting (the input `greeting`). Its image names a
//! console, the console driver's serve, so the line goes to that driver;
//! `main` returning ends the process with status 0 once the line is out.

import greeting.{text}
import sosmain

func main() {
    print("greeter: {}", text())
}
