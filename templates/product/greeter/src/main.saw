//! The product's process for a board with no UART driver: it prints its
//! greeting (the input `greeting`) through its System handle and exits
//! with 0.

import sos.{System}
import greeting.{text}

static EXIT_OK: UInt = 0

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)
    let proc = try system.process_self() catch {
        let _ = system.debug_print("greeter: no process handle\n")
        return
    }
    print("greeter: {}", text())
    let _ = proc.exit(EXIT_OK)
}
