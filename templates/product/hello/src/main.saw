//! The product's own process, written with `main`. It writes its greeting
//! (the input `greeting`) through the UART driver it is a client of, waits
//! until the driver has written it, and says so with `print`.
//!
//! It reaches the driver by two routes. Its own client record, which
//! `process.toml` declares and its image connects, is `main`'s to take from
//! the boot set; `main` speaks `uartproto` over it with the typed client,
//! which can also read, `Sync` and anything else the protocol has. Its image
//! names the same driver's serve as the console, so the builder gives it the
//! console's record too, which the runtime takes before `main` runs: `print`
//! writes through that one.
//!
//! `main` returning ends the process with status 0, once every line it
//! printed is out. A request the driver refuses, or a driver that is gone, is
//! returned as the error, which the runtime writes as `error: ...` before it
//! ends the process with status 1.

import uartproto.{UartError}
import uartpipe.{uart}
import greeting.{text}
import sosmain

/// The client end of the driver's connection, as `process.toml` declares it.
static TAG_UART: UInt = 2

func main() -> Result<Void, UartError> {
    var set = sosmain.take_boot_set()
    // The stock root gives what the declaration names; a record missing or of
    // another kind is a skew, and `!` panics there (`force unwrap of None`).
    var record = set.take(TAG_UART)!
    var driver = uart(record.take_inlet()!)
    try driver.write("{text()}\n")
    // The driver answers a `Sync` once it has served every request sent
    // before it, so the greeting is written.
    try driver.sync()
    print("hello: the driver has written the greeting")
    return
}
