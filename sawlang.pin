# The sawlang toolchain this repository builds against.
# `tools/toolchain.py` resolves in order: env overrides (SAWLANG_ROOT / SAWC /
# BLADE), a `sawc` on $PATH (whose --version must match `version`; a mismatch
# is refused, not skipped), then a cached fetch of `sha`. Bump both lines
# together, rigorously: a $PATH sawc is checked by version only, so a version
# that lies about its sha defeats the check.
version = "0.21.0"
sha = "a79ea78c58b1188eb1f15eb8ddbc8f61273a48c7"
