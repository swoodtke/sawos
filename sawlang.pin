# The sawlang toolchain this repository builds against (design sawlang#238).
# `tools/toolchain.py` resolves in order: env overrides (SAWLANG_ROOT / SAWC /
# BLADE), a `sawc` on $PATH whose --version matches `version`, then a cached
# fetch of `sha`. Bump both lines together, rigorously (D-b2: the check is
# version-only, so a version that lies about its sha defeats it).
version = "0.8.0"
sha = "449d2485cbdcbddf618b12bbd677e8fb938647e5"
