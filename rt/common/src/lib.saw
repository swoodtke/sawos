//! `sosrt`, the SOS runtime: arch-free, role-free Saw.
//!
//! Two halves, one module: the kernel and every SOS process need exactly these,
//! and differ only in where a byte ends up.
//!
//!   - The diagnostic helpers (the public surface, first below): turning a
//!     machine word into hex, a Unicode scalar into a console byte, the
//!     `ConsoleSink` trait with the one write loop over it, and the
//!     abort-status promotion. What stays with the side that owns the device is
//!     only the device: two register touches per HAL, and the mechanism that
//!     stops the machine.
//!   - The runtime proper (second below): the frozen `__saw_rt_*` seams that
//!     compiled Saw code and std reach (write, write-line, last raw code,
//!     panic, alloc and dealloc, spelled out in sawlang's `runtime/ABI.md`)
//!     plus the bump arena behind the last two. The compiler and std make the
//!     calls; this module answers them.
//!
//! All of it rests on two per-side hooks and nothing else, where a byte goes
//! and how the machine stops:
//!
//!     sos_rt_write(ptr, len)      // supplied per side
//!     sos_rt_abort(code)          // supplied per side, does not return
//!
//! The kernel HAL answers "the UART" and "the board's stop" (each board's
//! `hal/*/kernel/lib.saw`); a process answers "a System op" to both
//! (`kernel/sysapi/`). That second answer keeps the kernel/user split real: a
//! `panic()` in userspace cannot reach a UART.
//!
//! Nothing here suspends and nothing names a target. No code here calls an
//! allocator either: the arena below is the one, and it hands out a fixed
//! region it was given at link time.

/// Hex digits in a machine word on this target: eight on a 32-bit profile,
/// sixteen on a 64-bit one (spec §5b).
///
/// A function rather than a `static` because a static initializer takes plain
/// literals only, and a literal here would be wrong on one profile: a
/// hard-coded `8` makes every `write_hex` on arm64 print the low half of the
/// word with no sign that the top half exists. `sizeof<UInt>()` is the fact
/// being asked for, so it is what the code asks.
public func hex_digits_per_word() -> Int {
    sizeof<UInt>() * HEX_DIGITS_PER_BYTE
}

static HEX_DIGITS_PER_BYTE: Int = 2
static BITS_PER_HEX_DIGIT: Int = 4
static HEX_NIBBLE_MASK: UInt = 0xF
static HEX_DECIMAL_LIMIT: UInt = 10
static ASCII_ZERO: UInt = 48
static ASCII_LOWER_A_MINUS_TEN: UInt = 87
static ASCII_MAX: Int = 0x7F
static ASCII_SUBSTITUTE: UInt8 = 0x3Fu8      // '?'

/// One hex digit, lowercase.
public func hex_digit(nibble: UInt) -> UInt8 {
    let nib = nibble & HEX_NIBBLE_MASK
    if nib < HEX_DECIMAL_LIMIT {
        (ASCII_ZERO + nib) as UInt8
    } else {
        (ASCII_LOWER_A_MINUS_TEN + nib) as UInt8
    }
}

/// The `index`-th hex digit of `value`, most significant first, so a caller
/// prints `0..hex_digits_per_word()` in order and gets a full-width word with
/// no reversal buffer and no allocation.
public func hex_digit_of(value: UInt, index: Int) -> UInt8 {
    let shift = (hex_digits_per_word() - 1 - index) * BITS_PER_HEX_DIGIT
    hex_digit(value >> shift)
}

/// A Unicode scalar as a console byte.
///
/// `String.scalars()` yields scalars and the console surfaces on both sides are
/// byte-oriented, so a non-ASCII scalar has to become something. It becomes
/// `'?'` rather than a silent truncation to a plausible-looking wrong
/// character; the rule is stated once, here, instead of being re-decided by
/// each caller.
public func ascii_byte(scalar: Scalar) -> UInt8 {
    let v = scalar.value()
    if v < 0 || v > ASCII_MAX {
        ASCII_SUBSTITUTE
    } else {
        v as UInt8
    }
}

// =============================================================================
// The console sink, and the one write loop over it
// =============================================================================
//
// Only the device differs between HALs: a 16550 polls LSR bit 5 for "TX holding
// register empty", a PL011 polls FR bit 5 for "transmit FIFO full", and the
// ESP32-C3's UART compares a FIFO count against its depth. That is the only
// thing that belongs in a HAL. So the device is a trait and the loop is written
// once, generic over it. The bound is static: `console_write<S: ConsoleSink>`
// monomorphizes per sink (`Uart16550`, `Pl011`, `EspUart`), with no vtable, no
// existential and no indirect call anywhere on the panic path.
//
// The panic reporter runs while a panic is being reported, so a bounds check or
// an overflow check that tripped here would re-enter `__saw_rt_panic` and
// either hang or garble the one diagnostic that matters. The loop must stay
// check-free: raw `UnsafeMemory` reads rather than indexing, no allocation, no
// `String`, and a cursor that advances with `&+` / `&-` so even a nonsensical
// length cannot raise an overflow trap.
//
// Generic-ness does not weaken this. In each kernel's `-Oz` machine code (the
// disassembled object, not `--emit-ll`'s IR, which is pre-optimisation),
// `sos_rt_write` is a byte loop calling the sink's `write_byte`, and each
// `write_byte` is the status load, a mask test, a branch back and the data
// store: no overflow check, no bounds check, no trap and no call to a failure
// routine or `__saw_rt_panic`. The pre-optimisation IR still carries checks
// that `-Oz` folds away (a shift-amount check in the ESP32-C3's `can_write`),
// so judge the machine code. Re-read the disassembly of every instantiation if
// you touch this loop or a sink.

/// A byte-oriented console the kernel can reach with no allocator, no
/// interrupts and no driver state beyond the register block itself.
///
/// Two requirements, because two is what a polled transmitter is: ask whether
/// the device will take a byte, and give it one. Splitting them lets the
/// waiting live here, once, instead of in each HAL.
public trait ConsoleSink {
    /// Can the device accept a byte right now?
    func can_write(&self) -> Bool

    /// Place one byte. Called only when `can_write()` has answered true.
    func put(&self, b: UInt8)

    /// Spin until the device is ready, then place one byte.
    ///
    /// A default body rather than a requirement: every polled transmitter waits
    /// the same way, and a HAL that overrode this would be saying something
    /// about its device that `can_write` should have said instead.
    ///
    /// There is no preemption point in the ready spin or in `console_write`'s
    /// loop below. Both are bounded by the device drain, which is accepted
    /// masked latency, and `sosrt` is below the kernel so it could not reach a
    /// point in any case. The panic path runs through here, which is the
    /// strongest argument against delivering an interrupt from inside it.
    func write_byte(&self, b: UInt8) {
        while not self.can_write() {
        }
        self.put(b)
    }
}

/// Write `len` bytes at `ptr` to `sink`. This is the panic path's write loop.
///
/// Check-free by construction; see the section header for what that means and
/// how it is verified.
public func console_write<S: ConsoleSink>(sink: &S, ptr: UnsafePointer<Int8>,
                                          len: UInt) unsafe {
    var addr = ptr as UInt
    var left = len
    while left != 0 {
        sink.write_byte(UnsafeMemory<UInt8, Normal>(addr).read())
        addr = addr &+ 1
        left = left &- 1
    }
}

// A failing exit must never read as a passing one.
static ABORT_CODE_MASK: UInt = 0xFF
static ABORT_CODE_MIN: UInt = 1

/// The exit status a failing abort actually carries: `code` narrowed to the
/// byte an exit status is, with zero promoted.
///
/// The promotion is the point. A machine-stop mechanism reports one byte, and
/// `0` is what "the run passed" looks like, so an abort raised with a code that
/// is zero, or whose low byte is, would exit clean and turn a failure into a
/// green run. Deciding that once keeps the HALs from drifting on it.
///
/// The mechanism stays per-arch: this says what status, not how to stop.
public func abort_status(code: UInt) -> UInt {
    let masked = code & ABORT_CODE_MASK
    if masked == 0 {
        return ABORT_CODE_MIN
    }
    masked
}

// =============================================================================
// The runtime seams
// =============================================================================
//
// These `@export`s are the SOS runtime. Sawlang's `runtime/ABI.md` freezes the
// seams compiled Saw code and std call; the compiler and std make the calls
// under every profile and the environment supplies the bodies, here.
//
// The ABI freezes `__saw_rt_panic` as `noreturn`. A conditionless `while { }`
// with no `break` types `Never`, so a Saw body can satisfy that signature on
// its own: `sos_rt_abort` below is declared `-> Never`, and the type system
// carries the promise.
//
// `@export`ing a `__saw_rt_*` name is refused unless the compile declares
// itself a runtime provider: the kernel builds pass `--runtime-provider` from
// `tools/sos_runner.py`, and a process image gets it from
// `[package] runtime = true` in its own manifest, because the image's compile
// is where these definitions land. A compile that forgets it gets a clean error
// naming the frozen set; a link that never compiled this module gets an
// undefined `__saw_rt_write`. Neither failure is quiet.
//
// The signatures are machine-checked against `runtime/ABI.md` (arity and
// machine width), so editing one here without editing that document is a
// compile error. Sizes and lengths are `UInt` rather than `Int`: same machine
// word, and the unsigned reading is the one the bounds arithmetic wants.
//
// Not implemented here:
//
//   - `__saw_rt_last_syserror`. This runtime has no OS-op family to stamp, and
//     nothing an SOS image links calls it, so it needs no body. If SOS grows
//     an OS-op family, the raw code is its native status word, which
//     numerically coincides with the SysError tag because the status half of
//     the `(status, value)` syscall ABI is that tag space (spec.md §5.7). Store
//     no second copy of the number.
//   - `__saw_rt_thread_detach`, `__saw_rt_thread_spawn` and
//     `__saw_rt_thread_join`. This runtime has no thread surface, and a
//     `Thread.spawn` in an SOS image fails at link with the spawn seam missing,
//     long before a `detach` could be reached. If a detach is ever added it
//     must refuse, never no-op: a silent no-op would tell a caller its thread
//     was detached when no thread exists, and would leak the control block of
//     every one.

// Where a byte goes, and how the machine stops. Everything below is written
// against these two and nothing else. See the module header for who answers.
// (A plain comment, not `///`: an `extern` block is a container, and a doc
// block attaches to a declaration.)
extern "C" {
    func sos_rt_write(ptr: UnsafePointer<Int8>, len: UInt)
    func sos_rt_abort(code: UInt32) -> Never
}

// Where the arena is, and how big (see the bump-arena section below). Not a
// per-side hook like the two above: there is exactly one answer, in the one C
// file both sides link (`rt/common_c/support.c`), because the numbers come from
// the linker and Saw cannot name a linker symbol.
extern "C" {
    func sos_arena_base() -> UInt
    func sos_arena_size() -> UInt
}

// Abort codes the runtime raises on its own behalf. A side's own exit codes
// live with that side; these two are ours, and they stay distinct so a
// transcript can tell "the program panicked" from "the arena ran dry".
//
// A backed enum, on the same terms as the kernel's `ExitCode`; the backing is
// the width `sos_rt_abort` takes, so the projection at the call is one `as`.
enum AbortCode: UInt32 {
    case Panic = 64,
    case NoMemory = 65
}

/// `print`'s output primitive: `len` bytes at `ptr`, to whatever this side
/// calls a console.
@export("__saw_rt_write")
func rt_write(ptr: UnsafePointer<Int8>, len: UInt) unsafe -> Int {
    sos_rt_write(ptr, len)
    0
}

/// `print`'s line primitive: `count` `{ptr, len}` records, each two target
/// words, written in order and followed by a newline. Always succeeds.
@export("__saw_rt_write_line")
func rt_write_line(parts: UnsafePointer<Int8>, count: UInt) unsafe -> Int {
    let WORD = sizeof<UInt>() as UInt
    var i: UInt = 0
    let words = parts as UInt
    while i < count {
        let rec = words &+ (i &* 2 &* WORD)
        let p = UnsafeMemory<UInt, Normal>(rec).read()
        let n = UnsafeMemory<UInt, Normal>(rec &+ WORD).read()
        sos_rt_write(p as UnsafePointer<Int8>, n)
        i = i &+ 1
    }
    let nl = "\n"
    sos_rt_write(nl.c_string()!, 1)
    0
}

/// Has a body because compiled code references it: the compiler emits calls to
/// it, and std's `systemerror`, `net`, `thread` and `taskgroup` call it. It
/// answers 0 because nothing is stamped: SOS keeps no errno.
@export("__saw_rt_last_raw_code")
func rt_last_raw_code() -> Int {
    0
}

/// The panic sink: report, then stop.
///
/// Check-free by construction, like the writers under it: it does no arithmetic
/// at all, so there is nothing here that could raise the panic it is in the
/// middle of reporting.
@export("__saw_rt_panic")
func rt_panic(ptr: UnsafePointer<Int8>, len: UInt) unsafe -> Never {
    sos_rt_write(ptr, len)
    sos_rt_abort(AbortCode.Panic as UInt32)
}

// -----------------------------------------------------------------------------
// The bump arena
// -----------------------------------------------------------------------------
//
// SOS allocates nothing on the steady path: the kernel's diagnostics and
// root's banner are string literals walked byte by byte, and every kernel
// source builds under `--no-hidden-alloc`. The arena exists because the
// compiler's panic path can allocate, and an unbacked seam would turn a
// diagnosable panic into a wild jump.
//
// No reclamation: `__saw_rt_dealloc` is a no-op.
//
// The region is the linker's, not this module's. `sosrt` is shared, so a
// `static` here would be one compile-time size for every image in the system.
// This toolchain has no conditional compilation, and a module-level `static`
// carries no module identity a build profile could override, so the only seam
// is the link. The linker scripts reserve `[_arena_start, _arena_end)` inside
// `.bss` under a `PROVIDE`d `ARENA_SIZE` (the default unless a package's own
// script says otherwise, as `tests/arena-small/` does), and the two accessors
// above read it back. The region is `.bss`-resident, so it costs the image no
// bytes and the process's region all of them.

/// The cursor over the region. Nothing serializes the bound check against the
/// cursor store, so the bump is safe only while no involuntary switch can land
/// between them. In the kernel that is guaranteed: SOS is a uniprocessor kernel
/// (spec §7) and the kernel runs with interrupts masked. In a user process with
/// more than one thread it holds only while nothing preempts. The kernel
/// switches threads involuntarily only on a scheduler tick, which
/// `kernel/main.saw` does not arm (the preemption harness kernels do, through
/// `kcore.time.start_tick`). Once a tick is armed, two threads of one process
/// that both allocate can be handed overlapping blocks, and the cursor needs a
/// lock.
///
/// It is the only arena state in this module. The extent is a link-time
/// constant and only the offset moves.
unsafe static var ARENA_NEXT: UInt = 0

/// Hand out `size` bytes aligned to `align`, or stop the machine.
///
/// Alignment is applied to the absolute address, not to the offset. Rounding
/// the offset only satisfies the caller if the region itself is at least as
/// aligned as anything asked of it. Rounding the address the caller receives is
/// correct wherever the region is placed; the linker scripts' `. = ALIGN(16)`
/// is a courtesy, not a precondition.
///
/// The bound is checked as a subtraction so a hostile `size` cannot wrap past
/// it. The padding step uses `&-` because a checked one would put a panic
/// branch inside the allocator for a subtraction that cannot go negative (`rem`
/// is a remainder of `step`, so `rem < step` always). The compiler cannot see
/// that, and the allocator is not a place to spend a trap.
@export("__saw_rt_alloc")
func rt_alloc(size: UInt, align: UInt) unsafe -> UnsafePointer<Int8> {
    var step = align
    if step < 1 {
        step = 1
    }
    let base = sos_arena_base()
    let capacity = sos_arena_size()
    var offset = ARENA_NEXT
    let rem = (base &+ offset) % step
    if rem != 0 {
        offset = offset &+ (step &- rem)
    }
    if size > capacity || offset > capacity - size {
        let msg = "sos: out of arena memory\n"
        sos_rt_write(msg.c_string()!, UInt.from(truncating: msg.len()))
        sos_rt_abort(AbortCode.NoMemory as UInt32)
    }
    ARENA_NEXT = offset &+ size
    (base &+ offset) as UnsafePointer<Int8>
}

/// Free a block. A bump arena reclaims nothing, so this is deliberately
/// empty.
@export("__saw_rt_dealloc")
func rt_dealloc(ptr: UnsafePointer<Int8>, size: UInt, align: UInt) unsafe {
}
