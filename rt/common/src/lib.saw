//! `sosrt`, the SOS runtime: arch-free, role-free Saw.
//!
//! Two halves, one module: the kernel and every SOS process need exactly these,
//! and differ only in where a byte ends up.
//!
//!   - The diagnostic helpers (the public surface, first below): turning a
//!     machine word into hex, a Unicode scalar into a console byte, the
//!     `ConsoleSink` trait with the one write loop over it, and the
//!     abort-status promotion. What stays with the side that owns the device is
//!     only the device: two register touches per HAL, and the mechanism that
//!     stops the machine.
//!   - The runtime proper (second below): the frozen `__saw_rt_*` seams that
//!     compiled Saw code and std reach (write, write-line, write-error, the
//!     output lock, last raw code, panic, lock owner, alloc and dealloc, in
//!     sawlang's `runtime/ABI.md`) plus the heaps behind the last two: the
//!     arena, and the pool heaps (last below). Compiled code makes the calls.
//!
//! All of it rests on per-side hooks and nothing else: where a byte goes, how
//! a run ends with a text, and (with the arena and the output lock, below)
//! which thread is asking and how a waiting thread gives the processor up:
//!
//!     sos_rt_write(ptr, len)          // supplied per side
//!     sos_rt_abort(ptr, len, code)    // supplied per side, does not return
//!
//! The kernel HAL answers "the UART" and "write the text there, stop the
//! board" (each board's `hal/*/kernel/lib.saw`); a process answers a System op
//! and the kernel's panic op (`kernel/sysapi/`), which puts the text on the
//! kernel's fault line. So a `panic()` in userspace cannot reach a UART.
//!
//! Nothing here suspends and nothing names a target. No code here calls an
//! allocator either: the heaps below are the ones, over the region the link
//! gave and the pools a growth hook (below) maps.

/// Hex digits in a machine word on this target: eight on a 32-bit profile,
/// sixteen on a 64-bit one (spec §5b).
///
/// A function rather than a `static` because a static initializer takes plain
/// literals only, and a literal here would be wrong on one profile: a
/// hard-coded `8` makes every `write_hex` on arm64 print the low half of the
/// word with no sign that the top half exists. `sizeof<UInt>()` is the fact
/// being asked for, so it is what the code asks.
public func hex_digits_per_word() -> Int {
    sizeof<UInt>() * HEX_DIGITS_PER_BYTE
}

static HEX_DIGITS_PER_BYTE: Int = 2
static BITS_PER_HEX_DIGIT: Int = 4
static HEX_NIBBLE_MASK: UInt = 0xF
static HEX_DECIMAL_LIMIT: UInt = 10
static ASCII_ZERO: UInt = 48
static ASCII_LOWER_A_MINUS_TEN: UInt = 87
static ASCII_MAX: Int = 0x7F
static ASCII_SUBSTITUTE: UInt8 = 0x3Fu8      // '?'

/// One hex digit, lowercase.
public func hex_digit(nibble: UInt) -> UInt8 {
    let nib = nibble & HEX_NIBBLE_MASK
    if nib < HEX_DECIMAL_LIMIT {
        (ASCII_ZERO + nib) as UInt8
    } else {
        (ASCII_LOWER_A_MINUS_TEN + nib) as UInt8
    }
}

/// The `index`-th hex digit of `value`, most significant first, so a caller
/// prints `0..hex_digits_per_word()` in order and gets a full-width word with
/// no reversal buffer and no allocation.
public func hex_digit_of(value: UInt, index: Int) -> UInt8 {
    let shift = (hex_digits_per_word() - 1 - index) * BITS_PER_HEX_DIGIT
    hex_digit(value >> shift)
}

/// A Unicode scalar as a console byte.
///
/// `String.scalars()` yields scalars and the console surfaces on both sides are
/// byte-oriented, so a non-ASCII scalar has to become something. It becomes
/// `'?'` rather than a silent truncation to a plausible-looking wrong
/// character; the rule is stated once, here, instead of being re-decided by
/// each caller.
public func ascii_byte(scalar: Scalar) -> UInt8 {
    let v = scalar.value()
    if v < 0 || v > ASCII_MAX {
        ASCII_SUBSTITUTE
    } else {
        v as UInt8
    }
}

// =============================================================================
// The console sink, and the one write loop over it
// =============================================================================
//
// Only the device differs between HALs: a 16550 polls LSR bit 5 for "TX holding
// register empty", a PL011 polls FR bit 5 for "transmit FIFO full", and the
// ESP32-C3's UART compares a FIFO count against its depth. That is the only
// thing that belongs in a HAL. So the device is a trait and the loop is written
// once, generic over it. The bound is static: `console_write<S: ConsoleSink>`
// monomorphizes per sink (`Uart16550`, `Pl011`, `EspUart`), with no vtable, no
// existential and no indirect call anywhere on the panic path.
//
// The panic reporter runs while a panic is being reported, so a bounds check or
// an overflow check that tripped here would re-enter `__saw_rt_panic` and
// either hang or garble the one diagnostic that matters. The loop must stay
// check-free: raw `UnsafeMemory` reads rather than indexing, no allocation, no
// `String`, and a cursor that advances with `&+` / `&-` so even a nonsensical
// length cannot raise an overflow trap.
//
// Generic-ness does not weaken this. In each kernel's `-Oz` machine code (the
// disassembled object, not `--emit-ll`'s IR, which is pre-optimisation),
// `sos_rt_write` is a byte loop calling the sink's `write_byte`, and each
// `write_byte` is the status load, a mask test, a branch back and the data
// store: no overflow check, no bounds check, no trap and no call to a failure
// routine or `__saw_rt_panic`. The pre-optimisation IR still carries checks
// that `-Oz` folds away (a shift-amount check in the ESP32-C3's `can_write`),
// so judge the machine code. Re-read the disassembly of every instantiation if
// you touch this loop or a sink.

/// A byte-oriented console the kernel can reach with no allocator, no
/// interrupts and no driver state beyond the register block itself.
///
/// Two requirements, because two is what a polled transmitter is: ask whether
/// the device will take a byte, and give it one. Splitting them lets the
/// waiting live here, once, instead of in each HAL.
public trait ConsoleSink {
    /// Can the device accept a byte right now?
    func can_write(&self) -> Bool

    /// Place one byte. Called only when `can_write()` has answered true.
    func put(&self, b: UInt8)

    /// Spin until the device is ready, then place one byte.
    ///
    /// A default body rather than a requirement: every polled transmitter waits
    /// the same way, and a HAL that overrode this would be saying something
    /// about its device that `can_write` should have said instead.
    ///
    /// There is no preemption point in the ready spin or in `console_write`'s
    /// loop below. Both are bounded by the device drain, which is accepted
    /// masked latency, and `sosrt` is below the kernel so it could not reach a
    /// point in any case. The panic path runs through here, which is the
    /// strongest argument against delivering an interrupt from inside it.
    func write_byte(&self, b: UInt8) {
        while not self.can_write() {
        }
        self.put(b)
    }
}

/// Write `len` bytes at `ptr` to `sink`. This is the panic path's write loop.
///
/// Check-free by construction; see the section header for what that means and
/// how it is verified.
public func console_write<S: ConsoleSink>(sink: &S, ptr: UnsafePointer<Int8>,
                                          len: UInt) unsafe {
    var addr = ptr as UInt
    var left = len
    while left != 0 {
        sink.write_byte(UnsafeMemory<UInt8, Normal>(addr).read())
        addr = addr &+ 1
        left = left &- 1
    }
}

// A failing exit must never read as a passing one.
static ABORT_CODE_MASK: UInt = 0xFF
static ABORT_CODE_MIN: UInt = 1

/// The exit status a failing abort actually carries: `code` narrowed to the
/// byte an exit status is, with zero promoted.
///
/// The promotion is the point. A machine-stop mechanism reports one byte, and
/// `0` is what "the run passed" looks like, so an abort raised with a code that
/// is zero, or whose low byte is, would exit clean and turn a failure into a
/// green run. Deciding that once keeps the HALs from drifting on it.
///
/// The mechanism stays per-arch: this says what status, not how to stop.
public func abort_status(code: UInt) -> UInt {
    let masked = code & ABORT_CODE_MASK
    if masked == 0 {
        return ABORT_CODE_MIN
    }
    masked
}

// =============================================================================
// The runtime seams
// =============================================================================
//
// These `@export`s are the SOS runtime. Sawlang's `runtime/ABI.md` freezes the
// seams compiled Saw code and std call; the compiler and std make the calls
// under every profile and the environment supplies the bodies, here.
//
// The ABI freezes `__saw_rt_panic` as `noreturn`. A conditionless `while { }`
// with no `break` types `Never`, so a Saw body can satisfy that signature on
// its own: `sos_rt_abort` below is declared `-> Never`, and the type system
// carries the promise.
//
// `@export`ing a `__saw_rt_*` name is refused unless the compile declares
// itself a runtime provider: the kernel builds pass `--runtime-provider` from
// `tools/sos_runner.py`, and a process image gets it from
// `[package] runtime = true` in its own manifest, because the image's compile
// is where these definitions land. A compile that forgets it gets a clean error
// naming the frozen set; a link that never compiled this module gets an
// undefined `__saw_rt_write`. Neither failure is quiet.
//
// The signatures are machine-checked against `runtime/ABI.md` (arity and
// machine width), so editing one here without editing that document is a
// compile error. Sizes and lengths are `UInt` rather than `Int`: same machine
// word, and the unsigned reading is the one the bounds arithmetic wants.
//
// Not implemented here:
//
//   - `__saw_rt_last_syserror`. This runtime has no OS-op family to stamp, and
//     nothing an SOS image links calls it, so it needs no body. If SOS grows
//     an OS-op family, the raw code is its native status word, which
//     numerically coincides with the SysError tag because the status half of
//     the `(status, value)` syscall ABI is that tag space (spec.md §5.7). Store
//     no second copy of the number.
//   - `__saw_rt_thread_detach`, `__saw_rt_thread_spawn` and
//     `__saw_rt_thread_join`. This runtime has no thread surface, and a
//     `Thread.spawn` in an SOS image fails at link with the spawn seam missing,
//     long before a `detach` could be reached. If a detach is ever added it
//     must refuse, never no-op: a silent no-op would tell a caller its thread
//     was detached when no thread exists, and would leak the control block of
//     every one.

// Where a byte goes, and how a run ends with a text. Everything below is
// written against these two and nothing else. See the module header for who
// answers. (A plain comment, not `///`: an `extern` block is a container, and
// a doc block attaches to a declaration.)
extern "C" {
    func sos_rt_write(ptr: UnsafePointer<Int8>, len: UInt)
    func sos_rt_abort(ptr: UnsafePointer<Int8>, len: UInt,
                      code: UInt32) -> Never
}

// Where the arena is, and how big (see the arena section below). Not a
// per-side hook like the two above: there is exactly one answer, in the one C
// file both sides link (`rt/common_c/support.c`), because the numbers come from
// the linker and Saw cannot name a linker symbol.
extern "C" {
    func sos_arena_base() -> UInt
    func sos_arena_size() -> UInt
}

// Abort codes the runtime raises on its own behalf: the panic's. The kernel's
// hook stops the machine with it, and a process's hook reads none. `Panic` is
// also the kernel's `ExitCode.Panic`, held equal there.
//
// A backed enum, on the same terms as the kernel's `ExitCode`; the backing is
// the width `sos_rt_abort` takes, so the projection at the call is one `as`.
public enum AbortCode: UInt32 {
    case Panic = 64,
}

/// `print`'s output primitive: `len` bytes at `ptr`, to whatever this side
/// calls a console, under the output lock.
@export("__saw_rt_write")
func rt_write(ptr: UnsafePointer<Int8>, len: UInt) unsafe -> Int {
    rt_output_lock()
    sos_rt_write(ptr, len)
    rt_output_unlock()
    0
}

/// `print`'s line primitive: `count` `{ptr, len}` records, each two target
/// words, written in order and followed by a newline, all under the output
/// lock. Always succeeds.
///
/// The line is gathered on this stack and handed to `sos_rt_write` in pieces
/// of `LINE_CHUNK` bytes, the last one shorter: a line that fits, its newline
/// included, is one piece, and a process sends a piece as one console
/// message. The buffer is the calling thread's, so two threads that print
/// share none.
///
/// Check-free by construction, on `console_write`'s terms.
@export("__saw_rt_write_line")
func rt_write_line(parts: UnsafePointer<Int8>, count: UInt) unsafe -> Int {
    rt_output_lock()
    var line: [UInt8; LINE_CHUNK] = [0; LINE_CHUNK]
    let buf = ((&var line) as UnsafePointer<UInt8>) as UInt
    let WORD = sizeof<UInt>() as UInt
    var fill: UInt = 0
    var i: UInt = 0
    let words = parts as UInt
    while i < count {
        let rec = words &+ (i &* 2 &* WORD)
        let p = UnsafeMemory<UInt, Normal>(rec).read()
        let n = UnsafeMemory<UInt, Normal>(rec &+ WORD).read()
        var k: UInt = 0
        while k != n {
            fill = line_put(buf, fill, UnsafeMemory<UInt8, Normal>(p &+ k).read())
            k = k &+ 1
        }
        i = i &+ 1
    }
    fill = line_put(buf, fill, NEWLINE)
    sos_rt_write(buf as UnsafePointer<Int8>, fill)
    rt_output_unlock()
    0
}

/// The error stream: `len` bytes at `ptr`, unbuffered and with no lock, to
/// the same console `print` writes. A panic report and `main`'s `error:` line
/// come here, each under the output lock its caller already holds.
@export("__saw_rt_write_error")
func rt_write_error(ptr: UnsafePointer<Int8>, len: UInt) unsafe {
    sos_rt_write(ptr, len)
}

/// Has a body because compiled code references it: the compiler emits calls to
/// it, and std's `systemerror`, `net`, `thread` and `taskgroup` call it. It
/// answers 0 because nothing is stamped: SOS keeps no errno.
@export("__saw_rt_last_raw_code")
func rt_last_raw_code() -> Int {
    0
}

/// The panic sink: claim the output lock, and hand the text to this side's
/// end. The lock is never given back, so no other thread's line is written
/// after the panic began; a line another thread is writing is finished first.
///
/// Check-free by construction, like the hooks under it: it does no arithmetic
/// at all, so there is nothing here that could raise the panic it is in the
/// middle of reporting.
@export("__saw_rt_panic")
func rt_panic(ptr: UnsafePointer<Int8>, len: UInt) unsafe -> Never {
    rt_output_lock()
    sos_rt_abort(ptr, len, AbortCode.Panic as UInt32)
}

// -----------------------------------------------------------------------------
// The arena
// -----------------------------------------------------------------------------
//
// SOS allocates nothing on the steady path: the kernel's diagnostics and
// root's banner are string literals walked byte by byte, and every kernel
// source builds under `--no-hidden-alloc`, so a kernel never calls the seams
// below, though its link keeps them: std's `StringBuilder` and `String` drop
// glue reach them. A process allocates wherever its program does (an
// interpolated string, a `String` or a growing `Vector`; a `print` with `{}`
// arguments renders on the stack), and a block it frees is served again.
//
// The region is the linker's, not this module's. `sosrt` is shared, so a
// `static` here would be one compile-time size for every image in the system.
// This toolchain has no conditional compilation, and a module-level `static`
// carries no module identity a build profile could override, so the only seam
// is the link. The linker scripts reserve `[_arena_start, _arena_end)` inside
// `.bss` under a `PROVIDE`d `ARENA_SIZE` (the default unless a package's own
// script says otherwise, as `tests/arena-small/` does), and the two accessors
// above read it back. The region is `.bss`-resident, so it costs the image no
// bytes and the process's region all of them.
//
// The heap over it is `sosrt.heap`'s: a free takes constant time, and so does
// a request but for the one list it walks before refusing; a freed block
// merges with both neighbours; and the heap's control block sits at the front
// of the region. A block is the request plus a one-word header, rounded up to
// a multiple of two words and four words at least.

import sosrt.heap.{UnsafeHeap, front_bytes, block_bytes}
import std.spinlock.{SpinLock}

// Which thread is asking: the third per-side hook, beside the two above, and
// what std's `SpinLock` records as a lock's owner. The kernel answers one
// constant, being one context (`kcore.sched`); a process answers from its
// thread register (`kernel/sysapi/src/rt.saw`).
extern "C" {
    func sos_rt_lock_owner() -> Int
}

/// The arena's heap, behind std's `SpinLock`: one thread at a time is inside
/// it.
///
/// The lock guards the heap's descriptor, zero until the first allocation
/// fills it from the linker's bounds, and holding it is what entitles a thread
/// to the region the descriptor names: the control block and every block in
/// it. A thread that finds it held spins until the holder runs again and gives
/// it back. The loop is std's and spins without yielding. Under one
/// round-robin level, as the scheduler runs today, the holder runs once the
/// spinner's slice ends. Under the fixed-priority levels the spec gives, a
/// spinner above a preempted holder spins for good, and a yield that returns
/// the spinner to its own level does not change that.
///
/// Nothing in the window can panic or allocate: the heap is check-free and the
/// window calls nothing else, so the panic path never meets the lock held by
/// its own thread.
static ARENA: SpinLock<UnsafeHeap>

/// How many times a thread reached the arena's lock while another held it:
/// the arena's contended acquisitions, counted from the process's start.
static ARENA_CONTENDED: Atomic<Int>

/// The arena's contended acquisitions so far. A count above zero says two
/// threads were inside the arena's allocation path at once, and the lock
/// kept them apart. It only grows, and a stalled host cannot lower it.
@export("sos_arena_contended")
public func arena_contended() -> Int {
    ARENA_CONTENDED.load()
}

/// Count an arrival at the arena's lock that finds it held. It runs before
/// every acquisition of that lock, so the lock is taken one way only.
func arena_arrive() unsafe {
    if ARENA.is_locked() {
        let _ = ARENA_CONTENDED.fetch_add(1)
    }
}

func arena() unsafe -> UnsafeHeap {
    let size = sos_arena_size()
    UnsafeHeap(base: sos_arena_base(), size: size, largest: size)
}

/// `SpinLock`'s owner seam: the calling thread's identity, from this side's
/// hook. Nonzero, and it neither allocates nor panics, as a lock's panic path
/// needs.
@export("__saw_rt_lock_owner")
func rt_lock_owner() -> Int {
    sos_rt_lock_owner()
}

/// Hand out `size` bytes aligned to `align`: from the default heap, growing
/// it as it needs, and then from the arena; or a null pointer when neither
/// holds such a block. Each heap's lock is given back before the next is
/// taken.
///
/// A refusal is the caller's to handle, as sawlang's allocator ABI has it: the
/// seam never panics or aborts on one, and std turns the null pointer into
/// an `AllocError`, each allocating operation all-or-nothing on it.
@export("__saw_rt_alloc")
func rt_alloc(size: UInt, align: UInt) unsafe -> UnsafePointer<Int8> {
    var block = heap_alloc(DEFAULT_HEAP, size, align)
    if block == 0 {
        arena_arrive()
        block = borrow var heap = ARENA.lock() {
            if heap.size == 0 {
                heap = arena()
            }
            heap.alloc(size, align)
        }
    }
    block as UnsafePointer<Int8>
}

/// Free a block `rt_alloc` returned, or panic. A null `ptr` is no block. The
/// block's header holds its size, so `size` and `align` are not read. A block
/// inside the arena's linker bounds goes to the arena, and any other to the
/// default heap.
///
/// A free the heap can tell is bad (`UnsafeHeap.holds` says which: a block
/// freed twice while its header still marks it free, a pointer outside the
/// heap, before its first block or off the granule, one whose preceding word
/// is no plausible header) panics, naming the address, through the ordinary
/// panic path, the lock given back first; it ends the process as any panic
/// does. One it cannot tell (a second free after the block was served again,
/// a pointer into a live block past a word that reads as a header, a pointer
/// into a freed block past a stale size) corrupts the heap.
@export("__saw_rt_dealloc")
func rt_dealloc(ptr: UnsafePointer<Int8>, size: UInt, align: UInt) unsafe {
    let block = ptr as UInt
    if block == 0 {
        return
    }
    let held = if in_arena(block) {
        arena_arrive()
        borrow var heap = ARENA.lock() {
            let live = heap.holds(block)
            if live {
                heap.free(block)
            }
            live
        }
    } else {
        heap_free(DEFAULT_HEAP, block)
    }
    if not held {
        panic("bad free at {}", block)
    }
}

// -----------------------------------------------------------------------------
// The output lock
// -----------------------------------------------------------------------------
//
// One process-wide lock over everything written to the console, as the ABI
// states it: recursive, taken and given back by two separate calls, and taken
// by the panic sink, which never gives it back. `print`'s line and a task dump
// are each written whole under it, so no other thread's output lands inside
// them.
//
// std's `SpinLock` cannot be the lock itself: its window is one block, so it
// cannot be taken in one call and given back in another; it is not reentrant,
// and a panic report takes the lock its own thread already holds; and its
// window always gives the lock back, where the panic sink keeps it. So the
// `SpinLock` guards the lock's state, an owner and a depth, for a few compares
// and stores, and the recursion is this module's.
//
// A thread that finds the lock held by another gives the `SpinLock` back and
// yields through the fourth per-side hook before it tries again: the holder
// may be parked, and only giving the processor up lets it run. The kernel
// answers the hook with nothing, being one context that never waits; a
// process yields through the calling thread's own Thread handle
// (`kernel/sysapi/src/rt.saw`). That relies on the scheduler's one ready
// list: a waiter in a higher priority band than the holder would never let
// it run.
//
// The ABI's claim priority (a claim is served before plain writes) and its
// bound on a claim's wait are not kept: the only claimer is the panic sink,
// and it waits only for a line already being written.

extern "C" {
    func sos_rt_yield()
}

/// Who holds the output lock, and how many times over: an owner of zero and a
/// depth of zero is a free lock.
struct OutputState {
    owner: Int
    depth: UInt
}

/// The output lock's state, behind std's `SpinLock`. Nothing in its window can
/// panic, allocate or trap, so the window is never re-entered, and a thread
/// loses the processor inside it only to a tick.
static OUTPUT: SpinLock<OutputState>

/// Take the output lock, waiting while another thread holds it. A thread that
/// holds it already takes it again.
@export("__saw_rt_output_lock")
public func rt_output_lock() {
    let me = sos_rt_lock_owner()
    while not output_take(me) {
        sos_rt_yield()
    }
}

/// Give the output lock back once: the last give of a holder frees it. A give
/// with the lock free changes nothing.
@export("__saw_rt_output_unlock")
public func rt_output_unlock() {
    borrow var state = OUTPUT.lock() {
        if state.depth != 0 {
            state.depth = state.depth &- 1
            if state.depth == 0 {
                state.owner = 0
            }
        }
    }
}

/// Take the output lock for `me` if it is free or `me` holds it already.
func output_take(me: Int) -> Bool {
    borrow var state = OUTPUT.lock() {
        if state.depth == 0 || state.owner == me {
            state.owner = me
            state.depth = state.depth &+ 1
            true
        } else {
            false
        }
    }
}

// -----------------------------------------------------------------------------
// The section word
// -----------------------------------------------------------------------------
//
// A process's critical section against its own threads (spec §7): two machine
// words the kernel reads, a depth this side writes and a pending flag the
// kernel writes. Once the kernel has the pair's address
// (`ProcessOp.SectionWord`, which `sos`'s `Process.section_register()` makes),
// no other thread of the process runs while the depth is nonzero, and the
// kernel sets the flag when that held a thread back. Entering and leaving are
// an add each, with no trap; leaving yields through the fourth per-side hook
// when the depth reaches zero with the flag set, so the thread held back runs
// at once.
//
// The pair is the runtime's, one per process, so a program and the runtime
// under it share one section, and entering nests as a depth.
//
// Each add is an atomic read-modify-write, for its ordering and not for
// another processor: no access the section guards moves before the enter or
// after the leave. The kernel reads the depth only inside a trap, so the
// plain word it reads is the one these adds wrote.
//
// A thread with no block cannot yield (`kernel/sysapi/src/rt.saw`), so its
// leave does not: the thread it held back runs at the next switch, a tick or
// the leaver's next park.

/// The depth, then the pending flag.
static SECTION: [Atomic<Int>; 2]

/// Nonzero once the kernel has taken the pair's address.
static SECTION_REGISTERED: Atomic<Int>

static SECTION_DEPTH: Int = 0
static SECTION_PENDING: Int = 1

/// The pair's address, which `ProcessOp.SectionWord` takes.
public func section_word() unsafe -> UInt {
    ((&SECTION) as UnsafePointer<Atomic<Int>>) as UInt
}

/// Record that the kernel took the pair: the registration's last step.
public func section_registered() {
    SECTION_REGISTERED.store(1)
}

/// Enter the section, or enter it once more. A section the kernel was never
/// given would hold nothing back, so entering one panics.
public func section_enter() {
    if SECTION_REGISTERED.load() == 0 {
        panic("sos: Section.enter: the section word is not registered; Process.section_register() registers it")
    }
    let _ = SECTION[SECTION_DEPTH].fetch_add(1)
}

/// Leave the section once. The last leave yields when the kernel held a
/// thread back while the section was held. A leave with the section not held
/// panics: the depth would go below zero, which reads as held for good.
public func section_leave() {
    if SECTION[SECTION_DEPTH].load() <= 0 {
        panic("sos: Section.leave: the section is not held")
    }
    let before = SECTION[SECTION_DEPTH].fetch_add(-1)
    if before == 1 && SECTION[SECTION_PENDING].load() != 0 {
        sos_rt_yield()
    }
}

/// Whether the kernel held a thread back since it last found the section
/// left: the flag the last leave reads.
public func section_pending() -> Bool {
    SECTION[SECTION_PENDING].load() != 0
}

// -----------------------------------------------------------------------------
// The line
// -----------------------------------------------------------------------------

/// The most bytes of a line `rt_write_line` hands this side's writer at once.
///
/// A process's writer sends each piece as one console message whose first
/// byte is the op, so this is a pipe body less that byte: `sos.rt` holds it
/// to the kernel's body, and `sosmain` to the console protocol's payload.
public static LINE_CHUNK: Int = 127

static NEWLINE: UInt8 = 0x0Au8

/// Put `byte` at `fill` in the line buffer at `buf`, handing the buffer to
/// this side's writer first when it holds a whole piece, and answer the new
/// fill.
func line_put(buf: UInt, fill: UInt, byte: UInt8) unsafe -> UInt {
    var at = fill
    if at == UInt.from(truncating: LINE_CHUNK) {
        sos_rt_write(buf as UnsafePointer<Int8>, at)
        at = 0
    }
    UnsafeMemory<UInt8, Normal>(buf &+ at).write(byte)
    at &+ 1
}

// -----------------------------------------------------------------------------
// The pool heaps
// -----------------------------------------------------------------------------
//
// Beside the arena a process may have heaps over pools its launcher gives it:
// the default heap, slot `DEFAULT_HEAP`, which the global allocator asks
// before the arena, and named heaps a program asks by slot. A heap is adopted
// with no memory (`adopt_heap`, from the drain of the boot set); its first
// growth cuts the front of its pool and maps it, and every later growth
// extends that one allocation and its one row in place, so a heap is one
// region whatever its size. It only grows, and keeps its memory for the
// process's life.
//
// The kernel ops a growth makes are the fifth per-side hook:
//
//     sos_rt_grow(heap, by)    // supplied per side
//
// `heap` is the address of the slot's `PoolHeap`, which the hook reads for its
// handles and writes with what it made or why it refused, and `by` the bytes
// to grow by. It answers nonzero when the heap's region may grow by them. A
// process answers with its pool's, its `Memory`'s and its `Mapping`'s ops
// (`kernel/sysapi/src/rt.saw`); the kernel, which adopts no heap, answers no.
//
// Each slot has a lock of its own, so two heaps never contend, and no path
// holds two locks. A growth runs inside its heap's lock: every op it makes
// answers at once or ends the process inside the kernel, none suspends, and
// none allocates, so nothing in the window can panic, allocate or re-enter
// the lock. The lock is what the table's safety rests on, not a single
// thread: a program may make threads before it drains its boot set.

extern "C" {
    func sos_rt_grow(heap: UInt, by: UInt) -> UInt
}

/// How many pool heaps a process can have: slot 0 is the default heap and
/// the rest are named. `bootplan`'s `MAX_HEAPS` is held equal to it in `sos`.
public static HEAP_SLOTS: Int = 4

/// The default heap's slot.
public static DEFAULT_HEAP: Int = 0

/// The fewest bytes a growth takes, unless the pool's grain is larger: a
/// program that allocates in small steps then makes no pair of kernel ops per
/// allocation.
static MIN_GROWTH: UInt = 1024

/// Why a pool heap last refused to grow: what `Heap.info()` reports.
public enum GrowRefusal: UInt {
    /// No growth has been refused.
    case Never = 0,
    /// The pool has no bytes after the heap's front: the back side or the
    /// pool's end is there, or the heap has no pool.
    case Spent = 1,
    /// A quota row refused an object the growth makes; `PoolHeap.quota` names
    /// the kind.
    case Quota = 2,
    /// The kernel had no room for an object or for the row's addresses.
    case NoResource = 3,
    /// A handle the growth made lacks a right the heap spends.
    case Rights = 4,
}

/// A pool heap: its region, the handles it grows through, and why it last
/// refused. Zero is a slot with no pool.
///
/// `heap.size` is zero until the first growth and then the bytes the row
/// grants. `memory` and `mapping` are `NO_HANDLE` (zero) until the first
/// growth makes them; `base` is where the row landed.
public struct PoolHeap {
    heap: UnsafeHeap,
    /// The pool's handle, adopted.
    pool: UInt,
    /// A sibling of the process's own handle, through which the row is
    /// mapped.
    process: UInt,
    memory: UInt,
    mapping: UInt,
    base: UInt,
    /// The pool's free bytes at adoption, which size the class table.
    total: UInt,
    /// The pool's grain, the unit a growth is made of.
    grain: UInt,
    adopted: Bool,
    /// Set by a refusal that leaves the heap unable to grow again.
    spent: Bool,
    refusal: GrowRefusal,
    /// The `QuotaKind` number a `Quota` refusal names.
    quota: UInt,
}

/// One lock per slot.
static HEAPS: [SpinLock<PoolHeap>; HEAP_SLOTS]

/// How many times a thread reached a pool heap's lock while another held it,
/// across every slot.
static HEAP_CONTENDED: Atomic<Int>

/// Count an arrival at `slot`'s lock that finds it held. It runs before every
/// acquisition of a slot's lock.
func heap_arrive(slot: Int) unsafe {
    if HEAPS[slot].is_locked() {
        let _ = HEAP_CONTENDED.fetch_add(1)
    }
}

/// The pool heaps' contended acquisitions so far, as `arena_contended` counts
/// the arena's.
@export("sos_heap_contended")
public func heap_contended() -> Int {
    HEAP_CONTENDED.load()
}

/// Whether each slot has a pool, set once its heap is installed and never
/// cleared: the global allocator asks a process with no default heap's arena
/// without taking a lock it would find empty.
static ADOPTED: [Atomic<Int>; HEAP_SLOTS]

/// What `Heap.info()` reads of a slot.
public struct HeapState {
    size: UInt,
    total: UInt,
    adopted: Bool,
    refusal: GrowRefusal,
    quota: UInt,
}

/// Whether `block` lies inside the arena's linker bounds.
func in_arena(block: UInt) unsafe -> Bool {
    let base = sos_arena_base()
    block >= base && block &- base < sos_arena_size()
}

/// Make `slot` the heap over `pool`, mapped through `process`: adoption's
/// last step. `total` is the pool's free bytes and `grain` its grain. It maps
/// nothing: the first allocation the heap cannot serve grows it.
public func adopt_heap(slot: Int, pool: UInt, process: UInt, total: UInt,
                       grain: UInt) {
    heap_arrive(slot)
    borrow var h = HEAPS[slot].lock() {
        h.pool = pool
        h.process = process
        h.total = total
        h.grain = grain
        h.adopted = true
    }
    ADOPTED[slot].store(1)
}

/// `size` bytes aligned to `align` from `slot`'s heap, growing it when it
/// cannot serve them, or 0. A slot with no pool answers 0 at once, without
/// its lock.
public func heap_alloc(slot: Int, size: UInt, align: UInt) unsafe -> UInt {
    if ADOPTED[slot].load() == 0 {
        return 0
    }
    heap_arrive(slot)
    borrow var h = HEAPS[slot].lock() {
        if h.adopted { serve(&var h, size, align) } else { 0 }
    }
}

/// Free `block` to `slot`'s heap when the heap holds it as a live block, and
/// answer whether it did.
public func heap_free(slot: Int, block: UInt) unsafe -> Bool {
    heap_arrive(slot)
    borrow var h = HEAPS[slot].lock() {
        let live = h.heap.size != 0 && h.heap.holds(block)
        if live {
            h.heap.free(block)
        }
        live
    }
}

/// `slot`'s size, adoption total and last refusal.
public func heap_state(slot: Int) unsafe -> HeapState {
    heap_arrive(slot)
    borrow var h = HEAPS[slot].lock() {
        HeapState(size: h.heap.size, total: h.total, adopted: h.adopted,
                  refusal: h.refusal, quota: h.quota)
    }
}

/// `slot`'s pool handle and grain, for a share. The pool's word is written
/// once, at adoption, and the share's allocation is made with the lock given
/// back. A slot with no pool answers `NO_HANDLE`, zero.
public func heap_pool(slot: Int) unsafe -> (UInt, UInt) {
    heap_arrive(slot)
    borrow var h = HEAPS[slot].lock() {
        (h.pool, h.grain)
    }
}

/// Serve from `h`, growing it once when it cannot.
func serve(h: &var PoolHeap, size: UInt, align: UInt) unsafe -> UInt {
    if h.heap.size != 0 {
        let block = h.heap.alloc(size, align)
        if block != 0 {
            return block
        }
    }
    if not grow(&var h, size, align) {
        return 0
    }
    h.heap.alloc(size, align)
}

/// Grow `h` by enough to serve `size` bytes aligned to `align`: the block,
/// and the heap's front the first time, rounded up to the pool's grain, and
/// at least `MIN_GROWTH` or one grain. The new bytes are a free block after
/// the last one, merged with it when it is free.
func grow(h: &var PoolHeap, size: UInt, align: UInt) unsafe -> Bool {
    if h.spent {
        return false
    }
    let block = block_bytes(size, align)
    if block == 0 {
        h.refusal = GrowRefusal.Spent
        return false
    }
    let first = h.heap.size == 0
    var by = block
    if first {
        by = by &+ front_bytes(h.total)
    }
    by = (by &+ h.grain &- 1) & ~(h.grain &- 1)
    let least = if h.grain > MIN_GROWTH { h.grain } else { MIN_GROWTH }
    if by < least {
        by = least
    }
    if sos_rt_grow(((&var h) as UnsafePointer<PoolHeap>) as UInt, by) == 0 {
        return false
    }
    if first {
        // The heap trusts its control block's first word to read zero until
        // it makes the block, and a pool's bytes hold whatever they last held.
        UnsafeMemory<UInt, Normal>(h.base).write(0)
        h.heap = UnsafeHeap(base: h.base, size: by, largest: h.total)
    } else {
        h.heap.extend(by: by)
    }
    true
}
